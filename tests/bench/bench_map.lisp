;maps and sets: a thing put in, found and taken out, of each kind there is,
;with a symbol for a key and with a str
(defq bm_n 1000000 bm_keys (map (# (sym (cat "bm_key_" (str %0)))) (range 0 64))
	bm_strs (map (# (cat "bm_str_" (str %0))) (range 0 64))
	bm_key (elem-get bm_keys 37) bm_str (elem-get bm_strs 37)
	bm_fmap (Fmap 31) bm_emap (Emap 31) bm_lmap (Lmap) bm_fset (Fset 31)
	bm_pmap (pmap) bm_env (env 31))
(each (# (. bm_fmap :insert %0 (!)) (. bm_emap :insert %0 (!)) (. bm_fset :insert %0)
	(pinsert bm_pmap %0 (!)) (def bm_env %0 (!))) bm_keys)
(each! (# (. bm_lmap :insert %0 (!))) (list bm_keys) 30 40)
(defq bm_smap (Fmap 31))
(each (# (. bm_smap :insert %0 (!))) bm_strs)

(bench "(. fmap :find sym), 64 in it" bm_n (times bm_n (. bm_fmap :find bm_key)))
(bench "(. fmap :find str), 64 in it" bm_n (times bm_n (. bm_smap :find bm_str)))
(bench "(. emap :find sym), 64 in it" bm_n (times bm_n (. bm_emap :find bm_key)))
(bench "(. lmap :find sym), 10 in it" bm_n (times bm_n (. bm_lmap :find bm_key)))
(bench "(. fset :find sym), 64 in it" bm_n (times bm_n (. bm_fset :find bm_key)))
(bench "(pfind pmap sym), 64 in it" bm_n (times bm_n (pfind bm_pmap bm_key)))
(bench "(get sym env), 64 in it" bm_n (times bm_n (get bm_key bm_env)))
(bench "(. fmap :insert sym num), one that is there" bm_n (times bm_n (. bm_fmap :insert bm_key 1)))
(bench "(pinsert pmap sym num), one that is there" bm_n (times bm_n (pinsert bm_pmap bm_key 1)))
(bench "(def env sym num), one that is there" bm_n (times bm_n (def bm_env bm_key 1)))
(bench "an Fmap made, 64 put in it, each" (* 64 10000)
	(times 10000 (defq m (Fmap 31)) (each (# (. m :insert %0 1)) bm_keys)))
(bench "(. fmap :each), 64 in it, each" (* 64 20000)
	(times 20000 (. bm_fmap :each (lambda (k v)))))
