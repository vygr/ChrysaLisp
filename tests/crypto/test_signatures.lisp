(report-header "Crypto: ECDSA on P-256 and P-384, RSA by PKCS #1 v1.5 and PSS, signatures made by OpenSSL")

(import "lib/crypto/ecdsa.inc")
(import "lib/crypto/rsa.inc")

;signed by openssl dgst, the keys and signatures taken apart by Python
(defq ts_msg "the quick brown fox")

(defq ts_pub256 (hex-decode "0421E961B995369C767E93869B516209AFF15A030C3498AD03475DBDCC53E58945F6ED589B44EFB50BE876C8BBDC1D12495A613BCB2456E84BFE9DC6B812AD13F3")
	ts_r256 (hex-decode "E6FF3B49344A467BDB3DECCC1A91FD62BBC6DFD8387B35D8F300A29EE5E09B56")
	ts_s256 (hex-decode "159E3E2DBECA04EC8B17E83DD61BABC3D7F6B78D22F1AA90ADBE3FF520F6C525"))
(assert-true "ECDSA, P-256 and SHA-256" (ecdsa-verify *ecdsa_p256* ts_pub256 (sha256 ts_msg) ts_r256 ts_s256))
(assert-true "not of another message" (not (ecdsa-verify *ecdsa_p256* ts_pub256 (sha256 "the quick brown fix") ts_r256 ts_s256)))
(assert-true "nor with r changed" (not (ecdsa-verify *ecdsa_p256* ts_pub256 (sha256 ts_msg) (hex-decode "E6FF3B49344A467BDB3DECCC1A91FD62BBC6DFD8387B35D8F300A29EE5E09B57") ts_s256)))
(assert-true "nor with s as r" (not (ecdsa-verify *ecdsa_p256* ts_pub256 (sha256 ts_msg) ts_s256 ts_s256)))

(defq ts_pub384 (hex-decode "040ABC665BBA4C1D154D1DEC7471F08687C33131BA5202CD159D30311FCE52FD411CB41AFACCFC9330E272DDAD39F9D71D21AE3B6506FA6B0F12B71116D099DE77AE9D90C311EF02B486A9C1A500859C78F249555D058E347A7C6065E5A6E8A702")
	ts_r384 (hex-decode "09EC2E516D3FD425912D969ECDCDC5F727E7614DD54FB33DCF9622DC534BF5021C36CD619C13DA678A178EAC3DBF1D00")
	ts_s384 (hex-decode "2D758778C834E7E1B52AA7BB3F7BE548505327190E756BD1C688BC54C938DA1E87E551E31BB3C83C04A4F89E8F2AFF37"))
(assert-true "ECDSA, P-384 and SHA-384" (ecdsa-verify *ecdsa_p384* ts_pub384 (sha384 ts_msg) ts_r384 ts_s384))
(assert-true "not of another message" (not (ecdsa-verify *ecdsa_p384* ts_pub384 (sha384 "the quick brown fix") ts_r384 ts_s384)))
(assert-true "nor with r changed" (not (ecdsa-verify *ecdsa_p384* ts_pub384 (sha384 ts_msg) (hex-decode "09EC2E516D3FD425912D969ECDCDC5F727E7614DD54FB33DCF9622DC534BF5021C36CD619C13DA678A178EAC3DBF1D01") ts_s384)))
(assert-true "nor with s as r" (not (ecdsa-verify *ecdsa_p384* ts_pub384 (sha384 ts_msg) ts_s384 ts_s384)))

(assert-true "nor a point that is not on the curve" (not (ecdsa-verify *ecdsa_p256* (hex-decode "0421E961B995369C767E93869B516209AFF15A030C3498AD03475DBDCC53E58945F6ED589B44EFB50BE876C8BBDC1D12495A613BCB2456E84BFE9DC6B812AD13F2") (sha256 ts_msg) ts_r256 ts_s256)))

(defq ts_n (hex-decode "")
	ts_e (hex-decode "010001")
	ts_pkcs1 (hex-decode "")
	ts_pss (hex-decode ""))
(assert-true "RSA 2048, PKCS #1 v1.5, SHA-256" (rsa-verify-pkcs1 ts_n ts_e :sha256 (sha256 ts_msg) ts_pkcs1))
(assert-true "not of another message" (not (rsa-verify-pkcs1 ts_n ts_e :sha256 (sha256 "the quick brown fix") ts_pkcs1)))
(assert-true "nor said to be of another hash" (not (rsa-verify-pkcs1 ts_n ts_e :sha384 (sha384 ts_msg) ts_pkcs1)))
(assert-true "nor with a bit of it changed" (not (rsa-verify-pkcs1 ts_n ts_e :sha256 (sha256 ts_msg) (hex-decode ""))))
(assert-true "RSA 2048, PSS, SHA-256, a salt as long as the hash" (rsa-verify-pss ts_n ts_e :sha256 (sha256 ts_msg) ts_pss))
(assert-true "not of another message" (not (rsa-verify-pss ts_n ts_e :sha256 (sha256 "the quick brown fix") ts_pss)))
(assert-true "nor the one way taken for the other" (not (rsa-verify-pss ts_n ts_e :sha256 (sha256 ts_msg) ts_pkcs1)))
(assert-true "nor a signature as long as n and more than it" (not (rsa-verify-pkcs1 ts_n ts_e :sha256 (sha256 ts_msg) (apply (const cat) (map (lambda (&) (char 0xff)) (range 0 256))))))

(assert-eq "SHA-384 of abc, FIPS 180-2" "CB00753F45A35E8BB5A03D699AC65007272C32AB0EDED1631A8B605A43FF5BED8086072BA1E7CC2358BAECA134C825A7" (hex-encode (sha384 "abc")))

;ECDH on P-256, the example of RFC 5903 8.1, checked by Python
(defq ts_i (hex-decode "C88F01F510D9AC3F70A292DAA2316DE544E9AAB8AFE84049C62A9C57862D1433")
	ts_r (hex-decode "C6EF9C5D78AE012A011164ACB397CE2088685D8F06BF9BE0B283AB46476BEE53")
	ts_gi (ecdh-public *ecdsa_p256* ts_i) ts_gr (ecdh-public *ecdsa_p256* ts_r))
(assert-eq "ECDH, P-256, a point of a secret"
	"04DAD0B65394221CF9B051E1FECA5787D098DFE637FC90B9EF945D0C37725811805271A0461CDB8252D61F1C456FA3E59AB1F45B33ACCF5F58389E0577B8990BB3"
	(hex-encode ts_gi))
(assert-eq "and the secret both sides have"
	"D6840F6B42F6EDAFD13116E0E12565202FEF8E9ECE7DCE03812464D04B9442DE" (hex-encode (ecdh-shared *ecdsa_p256* ts_i ts_gr)))
(assert-eq "the same from the other side" (ecdh-shared *ecdsa_p256* ts_i ts_gr) (ecdh-shared *ecdsa_p256* ts_r ts_gi))
(assert-eq "a point not on the curve is not taken" :nil
	(ecdh-shared *ecdsa_p256* ts_i (cat (slice ts_gr 0 -2) (char (logxor (code ts_gr 1 64) 1)))))
