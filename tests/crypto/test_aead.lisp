;more than the native code is given at once
(defq ae_big (apply (const cat) (map (# (char (logand (+ (* %0 23) 11) 0xff))) (range 0 100001)))
	ae_big_sealed (aead-seal ae_key ae_nonce ae_aad ae_big))
(assert-eq "100,001 bytes" "2c6b45d0f49ab61beb1d3eeee5813b0bca69bf2367f0281eed7725b44fe58cd5" (cr-hex (sha256 ae_big_sealed)))
(assert-eq "100,001 bytes, opened" (sha256 ae_big) (sha256 (aead-open ae_key ae_nonce ae_aad ae_big_sealed)))

;anything that is not as it was sealed, and it does not open
(defun ae-flip (text at)
	;a str with one bit of one byte changed
	(cat (slice text 0 at) (char (logxor (code (elem-get text at)) 1)) (slice text (inc at) -1)))
(each (# (assert-eq (cat "a bit of byte " (str %0) " of what was sealed changed") :nil
		(aead-open ae_key ae_nonce ae_aad (ae-flip ae_sealed %0))))
	(list 0 1 63 64 113 114 (- (length ae_sealed) 16) (- (length ae_sealed) 1)))
(assert-eq "a bit of the aad changed" :nil (aead-open ae_key ae_nonce (ae-flip ae_aad 3) ae_sealed))
(assert-eq "no aad where there was" :nil (aead-open ae_key ae_nonce "" ae_sealed))
(assert-eq "a bit of the key changed" :nil (aead-open (ae-flip ae_key 31) ae_nonce ae_aad ae_sealed))
(assert-eq "a bit of the nonce changed" :nil (aead-open ae_key (ae-flip ae_nonce 0) ae_aad ae_sealed))
(assert-eq "the last byte missing" :nil (aead-open ae_key ae_nonce ae_aad (slice ae_sealed 0 -2)))
(assert-eq "a byte too many" :nil (aead-open ae_key ae_nonce ae_aad (cat ae_sealed "!")))
(assert-eq "shorter than a tag" :nil (aead-open ae_key ae_nonce ae_aad "too short"))
(assert-eq "nothing at all" :nil (aead-open ae_key ae_nonce ae_aad ""))
(assert-eq "nothing sealed, opened" "" (aead-open ae_key ae_nonce "" (aead-seal ae_key ae_nonce "" "")))

;what is hidden is not what went in, and another nonce hides it another way
(assert-true "hidden" (not (eql ae_plain (slice ae_sealed 0 -17))))
(assert-true "another nonce"
	(not (eql ae_sealed (aead-seal ae_key (ae-flip ae_nonce 5) ae_aad ae_plain))))
