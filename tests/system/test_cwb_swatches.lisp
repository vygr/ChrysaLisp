(report-header "Whiteboard swatches: the colours of a custom ink, a menu on the board that any device taps")

(import "usr/env.inc")
(import "gui/lisp.inc")
(import "lib/cwb/swatches.inc")

(defun sw-tap (board id kind buttons at)
	;a pointer down and up at a point
	(bind '(x y) at)
	(. board :pointers (list (ptr-event id kind buttons x y)))
	(. board :pointers (list (ptr-event id kind 0 x y))))

(defq sw_colors (swatch-colors))
(assert-eq "twelve hues in five shades and the greys" 72 (length sw_colors))
(assert-list-eq "the middle row the pure hues from red, a hue each 30 degrees"
	'(0xffff0000 0xffff7f00 0xffffff00 0xff7fff00 0xff00ff00 0xff00ff7f)
	(slice sw_colors 24 30))
(assert-list-eq "the greys from black to white" '(0xff000000 0xffffffff)
	(list (elem-get sw_colors 60) (elem-get sw_colors 71)))

;inks, how see through, none and the cross. A tap is the board's to do,
;(. board :pick), for the pen the button that tapped holds
(defq sw_board (Board (cwb-doc 800 600)) sw_pens (list 0xff000000 0xffffffff))
(def sw_board :pens sw_pens :pen 0)
(defq sw (Swatches sw_board 400 300))
(. (. sw_board :get_stage) :add sw)
(sw-tap sw_board 0x2000000 :pen +pev_right (. sw :where :ink 0xffff0000))
(assert-eq "a tap of a pen's barrel on red fills the pen it holds, the board's first" 0xffff0000 (first sw_pens))
(sw-tap sw_board 0 :mouse +pev_left (. sw :where :alpha 0x40))
(assert-eq "a quarter see through keeps its colour" 0x40ff0000 (first sw_pens))
(sw-tap sw_board 0 :mouse +pev_left (. sw :where :ink 0xff0000ff))
(assert-eq "and a colour keeps how see through it is" 0x400000ff (first sw_pens))
(sw-tap sw_board 0x1000002 :touch 1 (. sw :where :none))
(assert-eq "none from a finger, and it stays open for each" "(0 1)" (str (list (first sw_pens) (length (swatches-on sw_board)))))
(. sw_board :pointers (list (ptr-event 0 :mouse +pev_left 400 300)))
(bind '(sw_x sw_y) (. sw :where :ink 0xff000000))
(. sw_board :pointers (list (ptr-event 0 :mouse 0 (+ sw_x 300.0) sw_y)))
(assert-eq "down on one and up off it, nothing" 0 (first sw_pens))
(defq sw2 (Swatches sw_board 100 100))
(. (. sw_board :get_stage) :add sw2)
(assert-eq "as many as are wanted, as floating menus, one for each pupil" 2 (length (swatches-on sw_board)))
(. sw2 :close)
;the first cell's middle, and above it the edge of the menu
(bind '(sw_x sw_y) (. sw :where :ink (first sw_colors)))
(. sw_board :pointers (list (ptr-event 0 :mouse +pev_left sw_x (- sw_y 13.0))))
(. sw_board :pointers (list (ptr-event 0 :mouse +pev_left (+ sw_x 50.0) (- sw_y 13.0))))
(. sw_board :pointers (list (ptr-event 0 :mouse 0 (+ sw_x 50.0) (- sw_y 13.0))))
(assert-list-eq "dragged by its edge it moves, and nothing is picked" (list 450 300 0)
	(list (n2i (first (get :origin sw))) (n2i (second (get :origin sw))) (first sw_pens)))
(defq sw_c (Canvas 800 600 1))
(. sw_c :fill 0)
(assert-true "it draws" (catch (progn (. sw :draw sw_c (Mat3x2-translate 0 0)) :t) :nil))
(sw-tap sw_board 0 :mouse +pev_left (. sw :where :close))
(assert-eq "its cross puts it away" 0 (length (swatches-on sw_board)))
(assert-list-eq "the opacity cells say how much, the tip says what"
	'("100%" "75%" "50%" "25%" "opacity 50%" "none" "close" :nil :nil)
	(cat (map (# (swatch-tip :alpha %0)) '(0xff 0xc0 0x80 0x40))
		(list (swatch-tip :alpha 0x80 :t) (swatch-tip :none 0 :t) (swatch-tip :close :nil :t) (swatch-tip :none 0) (swatch-tip :color 0xff000000 :t))))
(defq sw (Swatches sw_board 400 300))
(. (. sw_board :get_stage) :add sw)
(. sw_board :pointers (list (apply (const ptr-event) (cat '(0 :mouse 0) (. sw :where :alpha 0x80)))))
(assert-true "a pointer over an opacity cell, it and its tip are drawn"
	(and (eql (elem-get (get :hover sw) +cell_what) :alpha)
		(catch (progn (. sw :draw sw_c (Mat3x2-translate 0 0)) :t) :nil)))
;the bar across the top drags it
(bind '(sw_x sw_y) (get :origin sw))
(bind '(& sw_h) (get :size sw))
(defq sw_top (+ sw_y (* -0.5 sw_h) 8.0))
(. sw_board :pointers (list (ptr-event 0 :mouse +pev_left sw_x sw_top)))
(assert-eq "a pointer on its bar is on the bar" :bar (get :hover sw))
(. sw_board :pointers (list (ptr-event 0 :mouse +pev_left (- sw_x 60.0) (+ sw_top 20.0))))
(. sw_board :pointers (list (ptr-event 0 :mouse 0 (- sw_x 60.0) (+ sw_top 20.0))))
(assert-list-eq "dragged by its bar it moves" (list (n2i (- sw_x 60.0)) (n2i (+ sw_y 20.0)))
	(map (const n2i) (get :origin sw)))
