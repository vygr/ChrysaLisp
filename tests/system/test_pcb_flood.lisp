(report-header "System: the Pcb router's native flood, against its Lisp, apps/science/pcb/router.inc")

;a board with some of its nets routed, by the router itself, and some of
;its nodes marked as a flood has them: what (flood-near) finds round a
;node, the moves on a layer and the vias, is what the Lisp finds, in the
;same order
(defq *app_root* "apps/science/pcb/")
(import "apps/science/pcb/app.inc")
(import "apps/science/pcb/reader.inc")
(import "apps/science/pcb/router.inc")

(defq pf_list (pcb-read (load "apps/science/pcb/data/test1.pcb")))
(bind '(pf_w pf_h pf_d) (first pf_list))
(defq pcb (Pcb pf_w pf_h pf_d 1 0 0 2 1 1))
(each! (lambda ((id track_radius via_radius track_gap pads wires &optional paths))
		(setq pads (map (lambda ((radius gap pos shape)) (Pad radius gap pos shape)) pads))
		(. pcb :add_track (Track id track_radius via_radius track_gap pads '())))
	(list pf_list) 1)
(defq pf_routed (reduce! (# (if (. %1 :route) (inc %0) %0)) (list (get :netlist pcb)) 0 0 8))
(assert-true "some nets are routed, so there are tracks to short with" (> pf_routed 0))

(defq pf_n (* pf_w pf_h pf_d) pf_nodes (get :nodes pcb))
(times (/ pf_n 5) (elem-set pf_nodes (random pf_n) (inc (random 9))))
(defq pf_via (list (list (nums 0 0 -1) (nums 0 0 1)) (list (nums 0 0 -1) (nums 0 0 1)))
	pf_ctx (. pcb :flood_ctx) pf_same 0 pf_asked 0 pf_found 0)
(each! (lambda (net)
		(defq r (get :radius net) g (get :gap net) v (get :via net) i 0)
		(while (< i pf_n)
			(defq node (nums (% i pf_w) (% (/ i pf_w) pf_h) (/ i (* pf_w pf_h)))
				a_n (list) a_v (list) b_n (list) b_v (list))
			(flood-near pf_ctx node (get :flood_vectors pcb) pf_via r g v a_n a_v)
			(. pcb :flood_near_lisp node r g v b_n b_v)
			(++ pf_asked)
			(setq pf_found (+ pf_found (length a_n) (length a_v)))
			(and (eql (str a_n) (str b_n)) (eql (str a_v) (str b_v)) (++ pf_same))
			(setq i (+ i 7))))
	(list (get :netlist pcb)) 0 2)
(assert-eq "every node asked, the same moves as the Lisp" pf_asked pf_same)
(assert-true "and moves are found" (> pf_found 0))
(. pcb :unmark_distances)

;the negotiating router's flood: routed tracks soft, a move that shorts
;with them taken at a cost, more where it has before. (flood-cost) finds
;the moves and their delays the Lisp finds
(defq pcb (Pcb pf_w pf_h pf_d 1 0 0 2 1 1))
(each! (lambda ((id track_radius via_radius track_gap pads wires &optional paths))
		(setq pads (map (lambda ((radius gap pos shape)) (Pad radius gap pos shape)) pads))
		(. pcb :add_track (Track id track_radius via_radius track_gap pads '())))
	(list pf_list) 1)
(. pcb :remove_netlist)
(set pcb :negotiating :t)
(defq pf_soft (reduce! (# (if (. %1 :route) (inc %0) %0)) (list (get :netlist pcb)) 0 0 12))
(assert-true "nets routed soft" (> pf_soft 0))
(defq pf_hist (get :hist pcb))
(times (/ pf_n 4) (elem-set pf_hist (random pf_n) (random 4)))
(elem-set (get :pf pcb) 0 1.5)
(defq pf_ctx (. pcb :flood_ctx) pf_same 0 pf_asked 0 pf_costly 0)
(each! (lambda (net)
		(defq r (get :radius net) g (get :gap net) v (get :via net) i 0)
		(while (< i pf_n)
			(defq node (nums (% i pf_w) (% (/ i pf_w) pf_h) (/ i (* pf_w pf_h)))
				a_n (list) a_v (list) a_nd (nums) a_vd (nums) b_n (list) b_v (list) b_nd (list) b_vd (list))
			(flood-cost pf_ctx node (get :flood_vectors pcb) pf_via r g v a_n a_v a_nd a_vd)
			(. pcb :flood_cost_lisp node r g v b_n b_v b_nd b_vd)
			(++ pf_asked)
			(setq pf_costly (+ pf_costly (length (filter (# (> %0 0)) a_nd))))
			(and (eql (str a_n) (str b_n)) (eql (str a_v) (str b_v))
				(eql (str (map (const identity) a_nd)) (str b_nd))
				(eql (str (map (const identity) a_vd)) (str b_vd))
				(++ pf_same))
			(setq i (+ i 7))))
	(list (get :netlist pcb)) 12 14)
(assert-eq "every node asked, the same moves and delays as the Lisp" pf_asked pf_same)
(assert-true "and some moves cost more" (> pf_costly 0))

;the whole flood in one call, (flood-wave), marks the board as the Lisp
;of it does, a front at a time, (. pcb :mark_distances_lisp): on the board
;as it is, and negotiating, with routed tracks soft and some history
(defun pf-waves (pcb)
	(defq same 0 asked 0 nodes (get :nodes pcb))
	(each! (lambda (net)
			(defq ends (get :pad_end_nodes net))
			(when (> (length ends) 1)
				(defq starts (. (get :wire_nodes net) :copy))
				(each (# (. starts :insert %0)) (first ends))
				(. net :sub_pad_lines) (. net :sub_wire_lines)
				(. pcb :mark_distances_lisp starts (second ends) (get :radius net) (get :gap net) (get :via net))
				(defq a (cat nodes))
				(. pcb :unmark_distances)
				(. pcb :mark_distances starts (second ends) (get :radius net) (get :gap net) (get :via net))
				(defq b (cat nodes))
				(. pcb :unmark_distances)
				(. net :add_pad_lines) (. net :add_wire_lines)
				(++ asked)
				(if (eql (str a) (str b)) (++ same))))
		(list (get :netlist pcb)) 0 6)
	(list asked same))
(defun pf-board (negotiating)
	(defq pcb (Pcb pf_w pf_h pf_d 1 0 2 2 1 1))
	(each! (lambda ((id track_radius via_radius track_gap pads wires &optional paths))
			(setq pads (map (lambda ((radius gap pos shape)) (Pad radius gap pos shape)) pads))
			(. pcb :add_track (Track id track_radius via_radius track_gap pads '())))
		(list pf_list) 1)
	(. pcb :remove_netlist)
	(set pcb :negotiating negotiating)
	(each! (# (. %0 :route)) (list (get :netlist pcb)) 6 18)
	pcb)
(bind '(pf_asked pf_same) (pf-waves (pf-board :nil)))
(assert-true "floods asked" (> pf_asked 0))
(assert-eq "the native flood marks the board as the Lisp, a via cost 2" pf_asked pf_same)
(defq pcb (pf-board :t) pf_hist (get :hist pcb))
(times (/ (length pf_hist) 4) (elem-set pf_hist (random (length pf_hist)) (random 4)))
(elem-set (get :pf pcb) 0 1.5)
(bind '(pf_asked pf_same) (pf-waves pcb))
(assert-eq "and negotiating, delays and history" pf_asked pf_same)
