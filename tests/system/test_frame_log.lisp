(report-header "Frame log")

(import "lib/debug/frame_log.inc")

;a log to a file of this run's own, its parts timed, its counts, how the
;view turned, a line a second, its counts let go after
(defq fl_path (cat "tests/scratch/frame_log_" (str (pii-pid)) ".log")
	fl_log (FrameLog fl_path '("eye" "draws")))
(times 3 (. (. (. fl_log :frame) :mark 0) :mark 1))
(assert-eq "frames counted" 3 (get :frames fl_log))
(. fl_log :add :rocks 5)
(. fl_log :add :rocks)
(assert-eq "a count added to" 6 (. fl_log :got :rocks))
(assert-eq "a count not added to" 0 (. fl_log :got :stucks))
(defq fl_up (doubles +double_0 +double_1 +double_0))
(. fl_log :turn (doubles +double_0 +double_0 +double_-1) fl_up)
(. fl_log :turn (doubles +double_0 (n2d 0.1) +double_-1) fl_up)
(. fl_log :turn (doubles +double_0 (n2d -0.1) +double_-1) fl_up)
(assert-eq "a nod, up then down" 1 (. fl_log :got :nods))
(. fl_log :turn (doubles +double_0 +double_0 +double_-1) (doubles +double_0 +double_-1 +double_0))
(assert-eq "upside down" 1 (. fl_log :got :upsides))
(assert-eq "milliseconds a frame" "1.0" (. fl_log :ms 3000))
(. fl_log :line 0 60 (list (list "detail" 2)) (list (list "rocks" (. fl_log :got :rocks)) "|" (list "nods" 1)))
(. fl_log :line 1000000 59 '() '())
(assert-eq "its counts let go" 0 (. fl_log :got :rocks))
(. fl_log :quit "done")
(setq fl_log :nil)
(defq fl_lines (list))
(lines! (# (push fl_lines %0) :nil) (file-stream fl_path))
(assert-eq "a line a second, and the last" 3 (length fl_lines))
(assert-true "the first, its fields, parts and counts"
	(and (starts-with "0s 60 fps detail 2 | eye " (first fl_lines)) (found? (first fl_lines) "rocks 6 | nods 1")))
(assert-true "a second on" (starts-with "1s 59 fps | eye 0.0 draws 0.0" (second fl_lines)))
(assert-eq "quit, and why" "QUIT done" (third fl_lines))
(pii-remove fl_path)
