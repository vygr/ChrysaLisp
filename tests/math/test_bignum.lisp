(report-header "Math: big numbers, against the same worked by Python")

(import "lib/math/bignum.inc")

(defun tb-n (s) (bn-from-bytes (hex-decode s)))
(defun tb-x (a) (hex-encode (bn-bytes a (max 1 (/ (+ (bn-bits a) 7) 8)))))

(assert-eq "bytes and back" "0123456789ABCDEF0011" (hex-encode (bn-bytes (tb-n "0123456789ABCDEF0011") 10)))
(assert-eq "0s in front" "0000FF" (hex-encode (bn-bytes (tb-n "FF") 3)))
(assert-eq "how many bits" 65 (bn-bits (tb-n "010000000000000000")))
(assert-eq "less" -1 (bn-cmp (tb-n "00FF") (tb-n "0100")))
(assert-eq "the same with 0s in front" 0 (bn-cmp (tb-n "0000FF") (tb-n "FF")))
(assert-eq "a sum, 40 bits" "01577984C16F" (tb-x (bn-add (tb-n "F252E6B438") (tb-n "65269E0D37"))))
(assert-eq "a difference, 40 bits" "8D2C48A701" (tb-x (bn-sub (tb-n "F252E6B438") (tb-n "65269E0D37"))))
(assert-eq "a product, 40 bits" "5FBF42EF058111479008" (tb-x (bn-mul (tb-n "F252E6B438") (tb-n "65269E0D37"))))
(assert-eq "mod, 40 bits" "050E88E5DB" (tb-x (bn-mod (tb-n "892FD23F0824128B2F33") (bn-modulus (tb-n "8CA6A3A451")))))
(assert-eq "a power mod, 40 bits" "5D988FE0E5" (tb-x (bn-powmod (tb-n "F252E6B438") (tb-n "5D1818E811") (bn-modulus (tb-n "8CA6A3A451")))))
(assert-eq "a sum, 256 bits" "01C2AFFC092522811076469AFEC407E49A992046CF267E74B820BB1005003EECF8" (tb-x (bn-add (tb-n "EF03675A1600A35A099950D836F675CC81E74EF5E8E25D940ED904759531985D") (tb-n "D3AC94AF0F21DDB66CAD4A268D116ECE1738F7D93D9C172411E20B8F6B0D549B"))))
(assert-eq "a difference, 256 bits" "1B56D2AB06DEC5A39CEC06B1A9E506FE6AAE571CAB46466FFCF6F8E62A2443C2" (tb-x (bn-sub (tb-n "EF03675A1600A35A099950D836F675CC81E74EF5E8E25D940ED904759531985D") (tb-n "D3AC94AF0F21DDB66CAD4A268D116ECE1738F7D93D9C172411E20B8F6B0D549B"))))
(assert-eq "a product, 256 bits" "C5A0EF4A19DDDBDD3B49E191130114BD3712F67917078E2A74331E32ACA02D6909080817220E7BECBED82225C1A71C12EC74E56FB8F30778B98AB14C36BEC44F" (tb-x (bn-mul (tb-n "EF03675A1600A35A099950D836F675CC81E74EF5E8E25D940ED904759531985D") (tb-n "D3AC94AF0F21DDB66CAD4A268D116ECE1738F7D93D9C172411E20B8F6B0D549B"))))
(assert-eq "mod, 256 bits" "83FBD39EEB26098F04EE7B52939B3BA825FF5BCA336ED347D88E4D2CCA2FC2D6" (tb-x (bn-mod (tb-n "1E27A1C08A6A63EC24EDE6A46B4CB2424A23D5962217BEADDBC496CB8E81973E0BECD7B03898D190F9EBDACC0CB1E29C658CDA1495E60AF593BD04CF0FD630F1") (bn-modulus (tb-n "F29D0DA9953F48F1A09F76B5A170B33839263059F28C105D1FB17C2390C192CF")))))
(assert-eq "a power mod, 256 bits" "77919013FE0057B8A8DAD32E90D115D2AD931517E8E81886CF681B211E86967F" (tb-x (bn-powmod (tb-n "EF03675A1600A35A099950D836F675CC81E74EF5E8E25D940ED904759531985D") (tb-n "4EF8AA3892276658") (bn-modulus (tb-n "F29D0DA9953F48F1A09F76B5A170B33839263059F28C105D1FB17C2390C192CF")))))
(assert-eq "a sum, 384 bits" "DCA4EE18DFE9ACEACCCC2281B837222851BE869C114F788DC99D7570B8D945933D861B403F122B57E100986745B9E97B" (tb-x (bn-add (tb-n "8C38FB2918F135D25F557203301850C5A38FD547923A736994E3BF911A61DBE22E44158BAE97BA94D0EDA82F8F6D0558") (tb-n "506BF2EFC6F877186D76B07E881ED162AE2EB1547F15052434B9B5DF9E7769B10F4205B4907A70C31012F037B64CE423"))))
(assert-eq "a difference, 384 bits" "3BCD083951F8BEB9F1DEC184A7F97F62F56123F313256E45602A09B17BEA72311F020FD71E1D49D1C0DAB7F7D9202135" (tb-x (bn-sub (tb-n "8C38FB2918F135D25F557203301850C5A38FD547923A736994E3BF911A61DBE22E44158BAE97BA94D0EDA82F8F6D0558") (tb-n "506BF2EFC6F877186D76B07E881ED162AE2EB1547F15052434B9B5DF9E7769B10F4205B4907A70C31012F037B64CE423"))))
(assert-eq "a product, 384 bits" "2C0CEF5F05944D4681F24F7D7CEAA81C4EB0A2A1F5901553CCD79A61959555C689B860EB1527D3AC78A3F6FCFDF41C83A70B9156F4B6E5FEEBD75AC2782FD2E9266C55E91616E515DDD0340A38FCCCCF5F874429ACFE3941DDFD164FDACA1B08" (tb-x (bn-mul (tb-n "8C38FB2918F135D25F557203301850C5A38FD547923A736994E3BF911A61DBE22E44158BAE97BA94D0EDA82F8F6D0558") (tb-n "506BF2EFC6F877186D76B07E881ED162AE2EB1547F15052434B9B5DF9E7769B10F4205B4907A70C31012F037B64CE423"))))
(assert-eq "mod, 384 bits" "59DB41ADB0EFF57DA09C01EE91E5064E622F49DE9DC1BAEAE741ABA478598B6C1DBF4A47C45A70CBEE599B55578171B8" (tb-x (bn-mod (tb-n "0A097C976BF46C697D2CAF82EEEACBE226E875555790F82EC1D3FCFF2A3AF4D46B0A18E8830E07BC1E398F1012BD4ACEFAECBD389BE4BCFC49B64A0872E6CC3ABABCED2057EE05CDE00902C77EBFF206867347214CDD2055930D6EAF14F4733F") (bn-modulus (tb-n "BE7D1BFBC7A2EA20B2F14C942E05319ACB5C74273F98E2774CBD87AD5C90A9587403E430EC66A78795E761D17731AF11")))))
(assert-eq "a power mod, 384 bits" "5A02F426B099D55773C5EEF188A6AF2EF1822BE800D27052A36ECCECB06F97A6CFB7B477D1D056BE0D486BE16F72189D" (tb-x (bn-powmod (tb-n "8C38FB2918F135D25F557203301850C5A38FD547923A736994E3BF911A61DBE22E44158BAE97BA94D0EDA82F8F6D0558") (tb-n "AB1031D0F646E1F4") (bn-modulus (tb-n "BE7D1BFBC7A2EA20B2F14C942E05319ACB5C74273F98E2774CBD87AD5C90A9587403E430EC66A78795E761D17731AF11")))))
(assert-eq "a sum, 2048 bits" "" (tb-x (bn-add (tb-n "") (tb-n ""))))
(assert-eq "a difference, 2048 bits" "" (tb-x (bn-sub (tb-n "") (tb-n ""))))
(assert-eq "a product, 2048 bits" "" (tb-x (bn-mul (tb-n "") (tb-n ""))))
(assert-eq "mod, 2048 bits" "" (tb-x (bn-mod (tb-n "") (bn-modulus (tb-n "")))))
(assert-eq "a power mod, 2048 bits" "" (tb-x (bn-powmod (tb-n "") (tb-n "E7A46309973F7986") (bn-modulus (tb-n "")))))
(assert-eq "mod, a modulus with a small top" "169C1620B839BC" (tb-x (bn-mod (tb-n "CCA2A903A56CC1057A40B22188287E8C5C715F8C74FC1E27E9E06F59B44E92EFFDDEEAA842BC19796F74ADFAF55496988AF3FBD39630D69C9011EF256BADF9A7E6529BCE76E9F477216E9E") (bn-modulus (tb-n "20000000000005")))))
(assert-eq "mod, a modulus with a small top" "2AD0885B2508E8089F9758235A4CED0E4C2E09EE85C69F9BECFAA09DA812A3BE" (tb-x (bn-mod (tb-n "4AFFDC3678BC8D40783F0A072A98D23606DEFCDFB85C0DD37EE91531DEC4F4DF2A8B79FC8E80B36F0E228923A5EF88EF02090BBFDEFC1586CE03F91A4F44F9A6511445B9F3635CF88C422B") (bn-modulus (tb-n "FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF")))))
(assert-eq "mod, a modulus with a small top" "01" (tb-x (bn-mod (tb-n "D0A6EC9556585EA997F351754A09CDE5CFEDFA5A9196F0BD6B881AE8F6E0BD0F977044218E0B7BD58DCDB46B4468068B5AB3EE4265BB31537409029620BF0DC38084A03D93FD4C804C25D6") (bn-modulus (tb-n "03")))))
(assert-eq "1 over, mod a prime" "7A5C2D04712FF5CF3BE85C9709B66858B7B5978ECA61E636FC7A405E7F480314" (tb-x (bn-invmod (tb-n "85E6CD806C10B5E0CFAB4CEAEFC4D2D3BF6D016BAE4B5B844A7034E77FFE48") (bn-modulus (tb-n "7FFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFED")))))
(assert-eq "a mod less than the modulus is itself" "05" (tb-x (bn-mod (tb-n "05") (bn-modulus (tb-n "07")))))
(assert-eq "0 mod" "00" (tb-x (bn-mod (tb-n "00") (bn-modulus (tb-n "07")))))
