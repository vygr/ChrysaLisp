(report-header "Neural networks: a model from a description, forward, and its gradients")

(import "lib/nn/model.inc")

;the layout of a model
(defq nn_mnist (nn-model '((:input 784) (:dense 128 :relu) (:dense 10 :softmax))))
(assert-eq "how many numbers" 101770 (nn-params nn_mnist))
(assert-eq "ins" 784 (nn-ins nn_mnist))
(assert-eq "outs" 10 (nn-outs nn_mnist))
(assert-list-eq "the first layer" '(:dense 784 128 :relu "0" 0 100352 :nil) (first (nn-layers nn_mnist)))
(assert-list-eq "the second, after the first's biases" '(:dense 128 10 :softmax "1" 100480 101760 :nil)
	(second (nn-layers nn_mnist)))
(assert-eq "a name given" "fc1"
	(elem-get (first (nn-layers (nn-model '((:input 2) (:dense 3 :softmax "fc1"))))) +nn_layer_name))
(assert-eq "params at random, as many as it has" 101770 (length (nn-init nn_mnist)))
(defq nn_p (nn-init nn_mnist))
(assert-eq "the net of them back as they were" nn_p (nn-flat (nn-net nn_mnist nn_p)))

;a small model of every activation, its gradients against the slope of
;its loss found by moving each number a little either way
(defq nn_small (nn-model '((:input 5) (:dense 4 :tanh) (:dense 4 :sigmoid) (:dense 3 :relu) (:dense 3 :softmax)))
	nn_x (doubles (n2d 0.5) (n2d -0.25) (n2d 0.75) (n2d 0.1) (n2d -0.6)) nn_label 1
	nn_params (nn-init nn_small) nn_scratch (nn-scratch nn_small))
;biases not 0, so a ReLU is not at its corner for every unit
(each (lambda ((kind ins outs act name w b &ignore))
		(each! (lambda () (elem-set nn_params (+ b (!)) (const (n2d 0.05)))) '() 0 outs))
	(nn-layers nn_small))

(defun nn-loss-at (params)
	(defq p (nn-forward nn_small (nn-net nn_small params) nn_x nn_scratch))
	(neg (log (elem-get p nn_label))))

(defq nn_grads (nn-zeros nn_small) nn_net (nn-net nn_small nn_params))
(nn-forward nn_small nn_net nn_x nn_scratch)
(defq nn_loss (nn-backward nn_small nn_net nn_grads nn_x nn_scratch nn_label)
	nn_flat (nn-flat nn_grads) nn_h (str-to-double "1e-6") nn_worst (n2d 0))
(assert-true "the loss it gives is the loss" (< (abs (- nn_loss (nn-loss-at nn_params))) (str-to-double "1e-12")))
(each! (lambda ()
		(defq up (cat nn_params) down (cat nn_params) i (!))
		(elem-set up i (+ (elem-get nn_params i) nn_h))
		(elem-set down i (- (elem-get nn_params i) nn_h))
		(defq slope (/ (- (nn-loss-at up) (nn-loss-at down)) (* (const (n2d 2)) nn_h)))
		(setq nn_worst (max nn_worst (abs (- slope (elem-get nn_flat i))))))
	'() 0 (nn-params nn_small))
(assert-true "every gradient is the slope of the loss" (< nn_worst (str-to-double "1e-6")))

;the outputs of softmax are chances
(defq nn_p (nn-forward nn_small nn_net nn_x nn_scratch))
(assert-true "softmax adds up to 1" (< (abs (- (nums-sum nn_p) (n2d 1))) (str-to-double "1e-12")))
(assert-eq "the guess is the biggest" (nn-guess (doubles (n2d 0.1) (n2d 0.7) (n2d 0.2))) 1)

;bytes as doubles, native, as the sum of each in Lisp
(defq nn_bytes (apply (const cat) (map! (# (char (* (!) 17))) '() 0 15)) nn_k (/ (n2d 1) (n2d 255))
	nn_out (fill (doubles) 20 (n2d -1)))
(nn-scale-bytes nn_bytes nn_k nn_out)
(assert-eq "bytes times a scale" (apply (const doubles) (map! (# (* (n2d (* (!) 17)) nn_k)) '() 0 15))
	(slice nn_out 0 15))
(assert-eq "no further than there are bytes" (n2d -1) (elem-get nn_out 15))
(assert-eq "no further than there are doubles" 3
	(length (nn-scale-bytes nn_bytes nn_k (fill (doubles) 3 (n2d 0)))))
;and as floats, each the nearest float of the double sum
(defq nn_fout (fill (floats) 20 (n2f -1)))
(nn-scale-bytes nn_bytes nn_k nn_fout)
(assert-eq "bytes times a scale into floats" (apply (const floats) (map! (# (n2f (* (n2d (* (!) 17)) nn_k))) '() 0 15))
	(slice nn_fout 0 15))
(assert-eq "no further than there are bytes, floats" (n2f -1) (elem-get nn_fout 15))
(assert-error "nothing else that comes of a doubles" (nn-scale-bytes nn_bytes nn_k (nums 1 2)) {(nn-scale-bytes bytes scale out) wrong_types})

;a model of floats does the sums of one of doubles, to a float's precision
(defq nn_fsmall (nn-model '((:input 5) (:dense 4 :tanh) (:dense 4 :sigmoid) (:dense 3 :relu) (:dense 3 :softmax)) :floats)
	nn_fparams (nums-convert nn_params (floats)) nn_fnet (nn-net nn_fsmall nn_fparams)
	nn_fscratch (nn-scratch nn_fsmall) nn_fx (nums-convert nn_x (floats)) nn_fgrads (nn-zeros nn_fsmall))
(assert-eq "its params are floats" :floats (nn-kind nn_fsmall))
(assert-true "and so is every vector of it" (floats? (first (first (nn-scratch nn_fsmall)))))
(defq nn_fp (nn-forward nn_fsmall nn_fnet nn_fx nn_fscratch))
(assert-true "its outputs those of doubles"
	(every (# (< (abs (- (n2d %0) %1)) (str-to-double "1e-6"))) nn_fp nn_p))
(defq nn_floss (nn-backward nn_fsmall nn_fnet nn_fgrads nn_fx nn_fscratch nn_label))
(assert-true "its loss a double, that of doubles" (and (double?? nn_floss) (< (abs (- nn_floss nn_loss)) (str-to-double "1e-5"))))
(assert-true "its gradients those of doubles"
	(every (# (< (abs (- (n2d %0) %1)) (str-to-double "1e-5"))) (nn-flat nn_fgrads) nn_flat))

;a matrix times a matrix, native, as the sums of it in Lisp, in the same
;order, so to the bit: each way round of a and b, added to c or not, with
;a bias or not, of doubles and of floats
(defun nn-gemm-sums (c a b m n k flags bias)
	(defq ta (/= 0 (logand flags 1)) tb (/= 0 (logand flags 2)) acc (/= 0 (logand flags 4))
		out (slice c 0 -1) zero (first (nn-consts c)))
	(each! (lambda ()
			(defq i (!))
			(each! (lambda ()
					(defq j (!) v (cond (acc (elem-get c (+ (* i n) j))) (bias (elem-get bias i)) (zero)))
					(each! (lambda ()
							(defq p (!))
							(setq v (+ v (* (elem-get a (if ta (+ (* p m) i) (+ (* i k) p)))
								(elem-get b (if tb (+ (* j k) p) (+ (* p n) j)))))))
						'() 0 k)
					(elem-set out (+ (* i n) j) v))
				'() 0 n))
		'() 0 m)
	out)
(defun nn-gemm-rand (vec len)
	(each! (lambda () (push vec (n2d (- (random 2000) 1000)))) '() 0 len)
	(defq scale (/ (const (n2d 1)) (const (n2d 1000))))
	(nums-scale vec (if (floats? vec) (n2f scale) scale) vec))
(each (lambda (kind)
		(defq m 5 n 7 k 3 vec (if (eql kind :floats) (floats) (doubles))
			a (nn-gemm-rand (slice vec 0 0) (* m k)) b (nn-gemm-rand (slice vec 0 0) (* k n))
			bias (nn-gemm-rand (slice vec 0 0) m) bad :nil)
		(each! (lambda ()
				(defq flags (!))
				(each (lambda (bs)
						(defq c (nn-gemm-rand (slice vec 0 0) (* m n)) want (nn-gemm-sums c a b m n k flags bs))
						(if bs (nn-gemm c a b m n k flags bs) (nn-gemm c a b m n k flags))
						(unless (eql c want) (setq bad (list flags (not (not bs))))))
					(list :nil bias)))
			'() 0 8)
		(assert-eq (cat "a matrix times a matrix, every way, of " kind) :nil bad))
	'(:doubles :floats))
(assert-true "a gemm of no rows, or no columns, leaves c"
	(and (eql (nn-gemm (doubles (n2d 9)) (doubles) (doubles) 0 1 0 0) (doubles (n2d 9)))
		(eql (nn-gemm (doubles (n2d 9)) (doubles +double_1 +double_1 +double_1) (doubles) 1 0 3 0) (doubles (n2d 9)))))
(assert-eq "and of no k, c is the bias" (doubles +double_2 +double_3)
	(nn-gemm (doubles +double_0 +double_0) (doubles) (doubles) 2 1 0 0 (doubles +double_2 +double_3)))
(assert-error "a gemm of one kind: its b not of its out's"
	(nn-gemm (doubles +double_0) (floats (n2f 1)) (doubles +double_1) 1 1 1 0) {(nn-gemm c a b m n k flags [bias]) wrong_types})
(assert-error "no less than its shape: an out of 4 with a b of 1 for 2 by 2"
	(nn-gemm (fill (doubles) 4 +double_0) (doubles +double_1) (doubles +double_1) 2 2 1 0) {(nn-gemm c a b m n k flags [bias]) wrong_types})
(assert-error "its bias of its kind too"
	(nn-gemm (doubles +double_0) (doubles +double_1) (doubles +double_1) 1 1 1 0 (floats (n2f 1))) {(nn-gemm c a b m n k flags [bias]) wrong_types})
(assert-error "and that a doubles or a floats, not a nums"
	(nn-gemm (nums 0) (nums 1) (nums 1) 1 1 1 0) {(nn-gemm c a b m n k flags [bias]) wrong_types})
(assert-error "a size less than 0"
	(nn-gemm (doubles +double_0) (doubles +double_1) (doubles +double_1) 1 1 -1 0) {(nn-gemm c a b m n k flags [bias]) wrong_types})

;patches of planes, native, as Lisp's, and back, and the averages of
;blocks and back, to the bit: of strides, pads, edges left over, of doubles
;and floats; and the patches back the patches turned, a dot of each the same
(defun cp-rand (vec len)
	(each! (lambda () (push vec (n2d (- (random 2000) 1000)))) '() 0 len)
	(defq scale (/ (const (n2d 1)) (const (n2d 1000))))
	(nums-scale vec (if (floats? vec) (n2f scale) scale) vec))
(defun cp-zero (vec) (first (nn-consts vec)))
(defun cp-im2col (x c h w k s pad)
	(defq oh (inc (/ (- (+ h pad pad) k) s)) ow (inc (/ (- (+ w pad pad) k) s)) out (slice x 0 0))
	(each! (lambda () (defq ch (!))
		(each! (lambda () (defq ky (!))
			(each! (lambda () (defq kx (!))
				(each! (lambda () (defq iy (- (+ (* (!) s) ky) pad))
					(each! (lambda () (defq ix (- (+ (* (!) s) kx) pad))
						(push out (if (and (>= iy 0) (< iy h) (>= ix 0) (< ix w))
							(elem-get x (+ (* ch h w) (* iy w) ix)) (cp-zero x))))
						'() 0 ow)) '() 0 oh)) '() 0 k)) '() 0 k)) '() 0 c)
	out)
(defun cp-col2im (p c h w k s pad)
	(defq oh (inc (/ (- (+ h pad pad) k) s)) ow (inc (/ (- (+ w pad pad) k) s))
		out (fill (slice p 0 0) (* c h w) (cp-zero p)) at 0)
	(each! (lambda () (defq ch (!))
		(each! (lambda () (defq ky (!))
			(each! (lambda () (defq kx (!))
				(each! (lambda () (defq iy (- (+ (* (!) s) ky) pad))
					(each! (lambda () (defq ix (- (+ (* (!) s) kx) pad))
						(and (>= iy 0) (< iy h) (>= ix 0) (< ix w)
							(elem-set out (defq o (+ (* ch h w) (* iy w) ix)) (+ (elem-get p at) (elem-get out o))))
						(++ at))
						'() 0 ow)) '() 0 oh)) '() 0 k)) '() 0 k)) '() 0 c)
	out)
(defun cp-inv (v q) (defq i (/ (const (n2d 1)) (n2d (* q q)))) (if (floats? v) (n2f i) i))
(defun cp-pool (x c h w q)
	(defq oh (/ h q) ow (/ w q) out (slice x 0 0) inv (cp-inv x q))
	(each! (lambda () (defq ch (!))
		(each! (lambda () (defq oy (!))
			(each! (lambda () (defq ox (!)) (defq sum (cp-zero x))
				(each! (lambda () (defq qy (!))
					(each! (lambda ()
						(setq sum (+ (elem-get x (+ (* ch h w) (* (+ (* oy q) qy) w) (* ox q) (!))) sum)))
						'() 0 q)) '() 0 q)
				(push out (* sum inv)))
				'() 0 ow)) '() 0 oh)) '() 0 c)
	out)
(defun cp-pool-back (d c h w q)
	(defq oh (/ h q) ow (/ w q) out (fill (slice d 0 0) (* c h w) (cp-zero d)) inv (cp-inv d q) at 0)
	(each! (lambda () (defq ch (!))
		(each! (lambda () (defq oy (!))
			(each! (lambda () (defq ox (!)) (defq v (* (elem-get d at) inv)) (++ at)
				(each! (lambda () (defq qy (!))
					(each! (lambda ()
						(elem-set out (+ (* ch h w) (* (+ (* oy q) qy) w) (* ox q) (!)) v))
						'() 0 q)) '() 0 q))
				'() 0 ow)) '() 0 oh)) '() 0 c)
	out)
(each (lambda (kind)
		(defq v (if (eql kind :floats) (floats) (doubles)) bad (list))
		(each (lambda ((c h w k s pad))
				(defq x (cp-rand (slice v 0 0) (* c h w)) want (cp-im2col x c h w k s pad)
					got (fill (slice v 0 0) (length want) (cp-zero v)))
				(nn-im2col x c h w k s pad got)
				(unless (eql got want) (push bad (list :im2col c h w k s pad)))
				(defq p (cp-rand (slice v 0 0) (length want)) back (fill (slice v 0 0) (* c h w) (const (n2d 7))))
				(if (floats? v) (setq back (fill (slice v 0 0) (* c h w) (const (n2f 7)))))
				(nn-col2im p c h w k s pad back)
				(unless (eql back (cp-col2im p c h w k s pad)) (push bad (list :col2im c h w k s pad)))
				;the one the other turned
				(defq l (n2d (nums-dot got p)) r (n2d (nums-dot x back)))
				(unless (< (abs (- l r)) (str-to-double "1e-4")) (push bad (list :adjoint c h w k s pad l r))))
			'((2 5 4 3 1 0) (2 5 4 3 1 1) (1 7 6 3 2 1) (3 6 6 5 1 2) (1 4 4 1 1 0) (2 3 5 3 2 2)))
		;nothing written past what the shape says, a 7 one past the planes
		(defq seven (if (floats? v) (const (n2f 7)) (const (n2d 7))) x (cp-rand (slice v 0 0) 40))
		(each (lambda (f)
				(defq out (fill (slice v 0 0) 41 seven))
				(f out)
				(unless (= (elem-get out 40) seven) (push bad (list :past (!)))))
			(list (# (nn-col2im (cp-rand (slice v 0 0) 108) 2 5 4 3 1 0 %0))
				(# (nn-pool-back (cp-rand (slice v 0 0) 8) 2 5 4 2 %0))
				(# (nn-im2col x 2 5 4 1 1 0 %0))))
		(each (lambda ((c h w q))
				(defq x (cp-rand (slice v 0 0) (* c h w)) want (cp-pool x c h w q)
					got (fill (slice v 0 0) (length want) (cp-zero v)))
				(nn-pool x c h w q got)
				(unless (eql got want) (push bad (list :pool c h w q)))
				(defq d (cp-rand (slice v 0 0) (length want)) back (fill (slice v 0 0) (* c h w) (cp-zero v)))
				(nn-pool-back d c h w q back)
				(unless (eql back (cp-pool-back d c h w q)) (push bad (list :pool-back c h w q))))
			'((2 4 4 2) (2 5 4 2) (3 6 7 3) (1 3 3 1)))
		(assert-eq (cat "patches and pools of " kind) '() bad))
	'(:doubles :floats))

;LeNet-5 as it is made today, 28 by 28 padded by 2, average pools, tanh,
;and its numbers as the papers count them
(defq nn_lenet (nn-model '((:input 1 28 28) (:conv 6 5 :tanh :pad 2) (:pool 2)
		(:conv 16 5 :tanh) (:pool 2) (:dense 120 :tanh) (:dense 84 :tanh) (:dense 10 :softmax))))
(assert-eq "LeNet-5's numbers" 61706 (nn-params nn_lenet))
(assert-list-eq "its planes, layer by layer" '(4704 1176 1600 400 120 84 10)
	(map (# (elem-get %0 +nn_layer_outs)) (nn-layers nn_lenet)))
(assert-list-eq "a conv layer, its shape" '(:conv 784 4704 :tanh "0" 0 150 (1 28 28 5 1 2 6 28 28))
	(first (nn-layers nn_lenet)))
(assert-error "a filter bigger than its planes refused" (nn-model '((:input 1 4 4) (:conv 2 5))) {A filter bigger than its planes !})
;a description is held to what there is: an activation that is one, softmax
;the last layer's and no other's, a block no wider than its planes
(assert-error "no such activation" (nn-model '((:input 4) (:dense 3 :rleu) (:dense 2 :softmax))) {No such activation !})
(assert-error "a name where the activation is" (nn-model '((:input 4) (:dense 3 "fc1") (:dense 2 :softmax))) {No such activation !})
(assert-error "softmax before the last layer" (nn-model '((:input 4) (:dense 3 :softmax) (:dense 2 :softmax))) {Softmax is of the last layer, and only of it !})
(assert-error "a last layer that is not softmax" (nn-model '((:input 4) (:dense 3 :relu) (:dense 2))) {Softmax is of the last layer, and only of it !})
(assert-error "a block wider than its planes" (nn-model '((:input 1 4 1) (:pool 2) (:dense 2 :softmax))) {A block bigger than its planes !})
(assert-error "a stride of none" (nn-model '((:input 1 4 4) (:conv 2 3 :tanh :stride 0) (:dense 2 :softmax))) {A filter of no size, stride or padding !})
(assert-error "no layers" (nn-model '((:input 4))) {No layers !})

;the gradients of conv and pool layers against the slope of the loss:
;padding, a pool, a conv of what a pool gave, and a dense after; then a
;stride of 2, and a pool with an edge left over
(defun nn-grad-worst (model x label)
	; the worst a gradient is from the slope of the loss
	(defq params (nn-init model) scratch (nn-scratch model) grads (nn-zeros model) h (str-to-double "1e-6")
		loss-at (lambda (params) (neg (log (elem-get (nn-forward model (nn-net model params) x scratch) label)))))
	(each (lambda ((kind ins outs act name w b &ignore))
			(each! (lambda () (elem-set params (+ b (!)) (const (n2d 0.05)))) '() 0 (- (nn-params model) b)))
		(list (last (nn-layers model))))
	(nn-forward model (nn-net model params) x scratch)
	(nn-backward model (nn-net model params) grads x scratch label)
	(defq flat (nn-flat grads) worst (const (n2d 0)))
	(each! (lambda ()
			(defq up (cat params) down (cat params) i (!))
			(elem-set up i (+ (elem-get params i) h))
			(elem-set down i (- (elem-get params i) h))
			(setq worst (max worst (abs (- (/ (- (loss-at up) (loss-at down)) (* (const (n2d 2)) h)) (elem-get flat i))))))
		'() 0 (nn-params model))
	worst)
(defq nn_conv (nn-model '((:input 2 5 5) (:conv 3 3 :tanh :pad 1) (:pool 2) (:conv 2 2 :sigmoid) (:dense 3 :softmax)))
	nn_cx (apply (const doubles) (map! (# (n2d (/ (n2d (- (% (* (!) 37) 19) 9)) (const (n2d 10))))) '() 0 50)))
(assert-true "the gradients of conv and pool layers are the slope of the loss"
	(< (nn-grad-worst nn_conv nn_cx 2) (str-to-double "1e-6")))
(defq nn_stride (nn-model '((:input 1 7 7) (:conv 2 3 :tanh :stride 2 :pad 1) (:pool 3) (:dense 2 :softmax))))
(assert-true "and of a stride, and a pool with an edge left over"
	(< (nn-grad-worst nn_stride (slice nn_cx 0 49) 1) (str-to-double "1e-6")))

;of floats, conv and pool as of doubles, to a float's precision
(defq nn_cparams (nn-init nn_conv) nn_fconv (nn-model '((:input 2 5 5) (:conv 3 3 :tanh :pad 1) (:pool 2)
		(:conv 2 2 :sigmoid) (:dense 3 :softmax)) :floats)
	nn_cd (nn-forward nn_conv (nn-net nn_conv nn_cparams) nn_cx (nn-scratch nn_conv))
	nn_cf (nn-forward nn_fconv (nn-net nn_fconv (nums-convert nn_cparams (floats))) (nums-convert nn_cx (floats))
		(nn-scratch nn_fconv)))
(assert-true "a conv net of floats gives what one of doubles does"
	(every (# (< (abs (- (n2d %0) %1)) (str-to-double "1e-6"))) nn_cf nn_cd))

;the activations and their slopes native, as their sums in Lisp, to the
;bit, of doubles and floats
(defun nn-act-lisp (act a)
	(bind '(zero one &ignore) (nn-consts a))
	(case act
		(:relu (each (# (if (< %0 zero) (elem-set a (!) zero))) a))
		(:sigmoid (each (# (elem-set a (!) (/ one (+ one (exp (neg %0)))))) a))
		(:tanh (each (# (elem-set a (!) (tanh %0))) a)))
	a)
(defun nn-slope-lisp (act a d)
	(bind '(zero one &ignore) (nn-consts a))
	(case act
		(:relu (each (# (if (<= %0 zero) (elem-set d (!) zero))) a))
		(:sigmoid (each (# (elem-set d (!) (* %1 %0 (- one %0)))) a d))
		(:tanh (each (# (elem-set d (!) (* %1 (- one (* %0 %0))))) a d)))
	d)
(each (lambda (kind)
		(defq v (if (eql kind :floats) (floats) (doubles))
			xs (apply (const doubles) (map! (# (/ (n2d (- (!) 40)) (const (n2d 7)))) '() 0 81))
			x (nums-convert xs (slice v 0 0)) bad (list))
		(each (lambda (act)
				(unless (eql (nn-activate act (cat x)) (nn-act-lisp act (cat x))) (push bad (list act)))
				(defq a (nn-act-lisp act (cat x)) d (nums-convert (nums-scale (cat xs) (const (n2d 0.3)) (cat xs)) (slice v 0 0)))
				(unless (eql (nn-slope act a (cat d)) (nn-slope-lisp act a (cat d))) (push bad (list act :slope))))
			'(:relu :sigmoid :tanh))
		(assert-eq (cat "activations and slopes native, of " kind) '() bad))
	'(:doubles :floats))
(assert-error "an activation of one kind only" (nn-act-slope 3 (doubles +double_1) (floats +float_1)) {(nn-act-slope code a d) wrong_types})

;a net's gradients made 0 again, a pool layer's empty vectors passed by
(defq nn_cg (nn-zeros nn_conv))
(nn-forward nn_conv (nn-net nn_conv nn_cparams) nn_cx (nn-scratch nn_conv))
(nn-backward nn_conv (nn-net nn_conv nn_cparams) nn_cg nn_cx (nn-scratch nn_conv) 1)
(assert-true "nn-clear makes every gradient 0, of a net with a pool"
;by its size, a negative one scaled by 0 is -0.0
	(every (# (= (abs %0) +double_0)) (nn-flat (nn-clear nn_cg))))
