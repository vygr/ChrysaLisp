#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer Src { float src[]; };
layout(set = 1, binding = 0) buffer Dst { float dst[]; };
layout(set = 2, binding = 0) uniform Block { float scale; float add; };
void main() { uint i = gl_GlobalInvocationID.x; dst[i] = src[i] * scale + add; }
