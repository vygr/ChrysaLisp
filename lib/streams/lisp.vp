(include "lib/asm/func.inc")
(include "class/stream/class.inc")
(include "class/nums/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(defmacro read-uint32 (src dst)
	`(progn
		(vp-rdef (buf mask i val t))
		(assign (cat ,src '(0)) `(,buf ,mask ,i ,val))
		(times 4
			(vp-and-rr mask i)
			(vp-cpy-dr-ub buf i t)
			(if (/= (!) 3) (vp-add-cr 1 i))
			(if (/= (!) 0) (vp-shl-cr (* (!) 8) t))
			(vp-add-rr t val))
		(assign `(,val) ,dst)))

(defmacro subroutine (addr)
	(defq ret_label (gensym))
	`(progn
		(assign (vpx ($ ,ret_label)) (vpx ret_adr))
		(vp-jmp ',addr)
	(vp-label ',ret_label)))

(def-func (path-to-absolute "./lz4_encode"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(ptr this args tok_buf hash_table ret_adr)
		(pubyte buf chunk t)
		(long pos m_pos anchor)
		(uint c_len cap mask i end_limit match_limit val m_val m_len lit_len t_pos offset hmul)
		(ubyte match_nibble))

	(vp-rdef (this args))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 4)

	(push-scope)
	(assign `(,this ,args) (vpx this args))

	(vp-rdef (buf pos chunk hash_table))
	(list-bind-args :r1 `(,buf ,pos ,chunk ,hash_table) '(:obj :num :obj :obj))
	(assign `(,buf ,pos ,chunk ,hash_table) (vpx buf pos chunk hash_table))

	(assign (vpx (.> buf +str_length) (.> chunk +str_length)) (vpx cap c_len))
	(assign (vpx (- cap 1) (& (.> buf +str_data)) (& (.> chunk +str_data)) (.> hash_table +array_begin))
		(vpx mask buf chunk hash_table))

	; --- 1. Write chunk into logical ring buffer ---
	(call :sys_mem :copy_to_ring (vpx chunk (+ buf (& pos mask)) c_len cap buf))

	; --- 2. Allocate token buffer (Worst-case LZ4 expansion size) ---
	(call :str :create_from_buffer (vpx 0 (+ (/ c_len 255) c_len 32)) (vpx tok_buf))
	(assign (vpx (& (.> tok_buf +str_data)) 0) (vpx t t_pos))

	; --- 3. Encode Loop ---
	(assign (vpx pos pos 2654435761) (vpx i anchor hmul))
	(vpif (vpx (>= c_len 12)))
		(assign (vpx (- (+ pos c_len) 12) (- (+ pos c_len) 5)) (vpx end_limit match_limit))
	(else)
		(assign (vpx pos pos) (vpx end_limit match_limit))
	(endif)

	(loop-while (vpx (< i end_limit)) 'next)
		;read 32-bit unaligned across ring buffer
		(read-uint32 (vpx buf mask i) (vpx val))

		;hash lookup (absolute logical position avoids ever needing to slide/clear the hash table!)
		(vp-rdef (m_pos i hptr))
		(assign (vpx (+ hash_table (* (& (>> (* val hmul) 19) 8191) +long_size)) i) `(,hptr ,i))
		(assign `((,hptr 0)) `(,m_pos))
		(assign `(,i) `((,hptr 0)))
		(vp-sub-rr m_pos i)
		(assign `(,m_pos ,i) (vpx m_pos offset))
		(vpif `(,i <= 65535))
			;read 32-bit unaligned across ring buffer
			(read-uint32 (vpx buf mask m_pos) (vpx m_val))

			(vpif (vpx (= val m_val)))
				;match found
				(vp-rdef (buf mask ptr_i ptr_m match_limit v1 v2 i m_pos match_limit buf mask anchor))
				(assign (vpx i m_pos match_limit anchor)
					`(,i ,m_pos ,match_limit ,anchor))
				(vp-simd vp-lea-i `(,i ,m_pos) '(4) `(,ptr_i ,ptr_m))
				(vpif `(,ptr_i < ,match_limit))
					(assign (vpx buf mask) `(,buf ,mask))
					(loop-start)
						(vp-simd vp-cpy-rr `(,ptr_m ,ptr_i) `(,v2 ,v1))
						(vp-simd vp-and-rr `(,mask) `(,v2 ,v1))
						(vp-simd vp-cpy-dr-ub `(,buf) `(,v2 ,v1) `(,v2 ,v1))
						(breakif `(,v1 /= ,v2))
						(vp-simd vp-add-cr '(1) `(,ptr_m ,ptr_i))
					(loop-until `(,ptr_i = ,match_limit))
				(endif)
				(assign `(,i) (vpx i))
				(vp-sub-rr i ptr_i)
				(vp-sub-rr anchor i)
				(assign `(,ptr_i ,i) (vpx m_len lit_len))

				;subroutine call while keeping stack context !
				(subroutine literals)

				(assign (vpx (=> (+ i m_len) anchor)) (vpx i))
				(continue 'next)
			(endif)
		(endif)
		(assign (vpx (+ i 1)) (vpx i))
	(loop-end)

	; --- Final Literals ---
	(assign (vpx (- (+ pos c_len) anchor) 0 0) (vpx lit_len match_nibble offset))

	;subroutine call while keeping stack context !
	(subroutine literals)

	;truncate buffer size
	(assign (vpx t_pos) (vpx (.> tok_buf +str_length)))

	(call :num :create (vpx (+ pos c_len)) (vpx ret_adr))
	(call :list :create :nil (vpx args))
	(call :list :push_back2 (vpx args tok_buf ret_adr))

	(exit (vpx this args))
	(return)

(vp-label 'literals)
	(vp-rdef (lit_len v t_pos t c lit_nibble match_nibble offset m_len))
	(assign (vpx lit_len offset m_len t t_pos match_nibble)
		`(,lit_len ,offset ,m_len ,t ,t_pos ,match_nibble))
	(vp-add-rr t t_pos)

	(vp-cpy-rr lit_len lit_nibble)
	(vp-min-cr 15 lit_nibble)
	(vpif `(,offset > 0))
		(vp-lea-i m_len -4 match_nibble)
		(vp-min-cr 15 match_nibble)
	(endif)
	(vp-shl-cr 4 lit_nibble)
	(vp-or-rr match_nibble lit_nibble)
	(vp-cpy-ri-b lit_nibble t_pos 0)
	(vp-add-cr 1 t_pos)

	(vpif `(,lit_len >= 15))
		(vp-lea-i lit_len -15 v)
		(vp-cpy-cr 255 c)
		(loop-while `(,v >= ,c))
			(vp-cpy-ri-b c t_pos 0)
			(vp-add-cr 1 t_pos)
			(vp-sub-rr c v)
		(loop-end)
		(vp-cpy-ri-b v t_pos 0)
		(vp-add-cr 1 t_pos)
	(endif)

	(vp-sub-rr t t_pos)
	(assign `(,t_pos) (vpx t_pos))

	(vpif (vpx (> lit_len 0)))
		(call :sys_mem :copy_from_ring (vpx (+ buf (& anchor mask)) (+ t t_pos) lit_len cap buf))
		(assign (vpx (+ t_pos lit_len)) (vpx t_pos))
	(endif)

	(vp-rdef (offset m_len t_pos t v c t1 t2))
	(assign (vpx offset) `(,offset))
	(vpif `(,offset > 0))
		(assign (vpx m_len t_pos t 255) `(,m_len ,t_pos ,t ,c))
		(vp-add-rr t t_pos)
		(vp-simd vp-cpy-rr `(,offset) `(,t1 ,t2))
		(vp-and-rr c t1)
		(vp-shr-cr 8 t2)
		(vp-simd vp-cpy-ri-b `(,t1 ,t2) `(,t_pos) '(0 1))
		(vp-add-cr 2 t_pos)
		(vpif `(,m_len >= 19))
			(vp-lea-i m_len -19 v)
			(loop-while `(,v >= ,c))
				(vp-cpy-ri-b c t_pos 0)
				(vp-add-cr 1 t_pos)
				(vp-sub-rr c v)
			(loop-end)
			(vp-cpy-ri-b v t_pos 0)
			(vp-add-cr 1 t_pos)
		(endif)
		(vp-sub-rr t t_pos)
		(assign `(,t_pos ,m_len) (vpx t_pos m_len))
	(endif)

	(assign (vpx ret_adr) '(:r0))
	(vp-jmp-r :r0)

	(pop-scope-syms)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(lz4-encode buf pos chunk hash_table)" +error_msg_wrong_types))
	(signature '(:str :NUM :str :NUMS)))

(def-func-end)

(def-func (path-to-absolute "./lz4_decode"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr saved_this saved_args))

	(vp-rdef (this args))
	;persistent state: survives ALL calls (requires :r9 to :r14)
	(vp-rdef (buf pos chunk c_pos c_len mask) '(:r9 :r10 :r11 :r12 :r13 :r14))
	;semi-persistent state: survives copy_to_ring, dead before copy_in_ring (:r6 to :r8)
	(vp-rdef (token offset match_len) '(:r6 :r7 :r8))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 3)

	(push-scope)
	;spill this and args to the stack of locals
	(assign `(,this ,args) (vpx saved_this saved_args))

	(list-bind-args args `(,buf ,pos ,chunk) '(:obj :num :obj))
	(assign `((,chunk +str_length) (,buf +str_length) (& ,chunk +str_data) (& ,buf +str_data))
		`(,c_len ,mask ,chunk ,buf))
	(vp-sub-cr 1 mask)
	(vp-xor-rr c_pos c_pos)

	(loop-while `(,c_pos < ,c_len))
		;token
		(vp-cpy-dr-ub chunk c_pos token)
		(vp-add-cr 1 c_pos)

		;literals
		(vp-rdef (lit_len) '(:r5)) ;safe to use :r5 here, volatile but untouched until call
		(vp-cpy-rr token lit_len)
		(vp-shr-cr 4 lit_len)
		(vpif `(,lit_len = 15))
			(vp-rdef (v) '(:r0))
			(loop-while `(,c_pos < ,c_len))
				(vp-cpy-dr-ub chunk c_pos v)
				(vp-add-cr 1 c_pos)
				(vp-add-rr v lit_len)
			(loop-until `(,v /= 255))
		(endif)

		;guard against buffer overflow
		(vp-rdef (t1) '(:r0))
		(vp-cpy-rr c_len t1)
		(vp-sub-rr c_pos t1)
		(vpif `(,lit_len > ,t1))
			(vp-cpy-rr t1 lit_len)
		(endif)

		(vpif `(,lit_len > 0))
			;extract correct registers for call mapping (volatile :r0-:r4)
			(vp-rdef (cp_src cp_dst cp_len cp_cap cp_buf)
				(method-input :sys_mem :copy_to_ring))

			;setup call arguments in volatiles
			(assign `(,c_pos ,pos ,mask ,buf ,lit_len)
				`(,cp_src ,cp_dst ,cp_cap ,cp_buf ,cp_len))
			(vp-add-rr chunk cp_src)	  ; cp_src = chunk + c_pos
			(vp-and-rr mask cp_dst)
			(vp-add-rr buf cp_dst)		  ; cp_dst = buf + (pos & mask)
			(vp-add-cr 1 cp_cap)		  ; cp_cap = mask + 1

			;advance loop positions BEFORE the sys_mem call trashes lit_len!
			(vp-simd vp-add-rr `(,lit_len) `(,c_pos ,pos))
			(call :sys_mem :copy_to_ring `(,cp_src ,cp_dst ,cp_len ,cp_cap ,cp_buf))
		(endif)

		(breakif `(,c_pos >= ,c_len))

		;match
		(vp-add-cr 1 c_pos)
		(breakif `(,c_pos >= ,c_len))

		;read 16-bit little-endian offset securely
		(vp-rdef (t1) '(:r0))
		(vp-cpy-dr-ub chunk c_pos t1)
		(vp-sub-cr 1 c_pos)
		(vp-cpy-dr-ub chunk c_pos offset)
		(vp-shl-cr 8 t1)
		(vp-or-rr t1 offset)
		(vp-add-cr 2 c_pos)

		(vp-cpy-rr token match_len)
		(vp-and-cr 15 match_len)
		(vp-add-cr 4 match_len)
		(vpif `(,match_len = 19))
			(vp-rdef (v) '(:r0))
			(loop-while `(,c_pos < ,c_len))
				(vp-cpy-dr-ub chunk c_pos v)
				(vp-add-cr 1 c_pos)
				(vp-add-rr v match_len)
			(loop-until `(,v /= 255))
		(endif)

		(vpif `(,offset >= ,match_len))
			;bulk copy
			(vp-rdef (cp_src cp_dst cp_len cp_cap cp_buf)
				(method-input :sys_mem :copy_in_ring))

			(vp-rdef (m_pos) '(:r0))
			(vp-cpy-rr pos m_pos)
			(vp-sub-rr offset m_pos)
			(assign `(,m_pos ,pos ,match_len ,mask ,buf)
				`(,cp_src ,cp_dst ,cp_len ,cp_cap ,cp_buf))
			(vp-add-cr 1 cp_cap)
			(vp-simd vp-and-rr `(,mask) `(,cp_src ,cp_dst))
			(vp-simd vp-add-rr `(,buf) `(,cp_src ,cp_dst))

			;advance pos BEFORE call trashes match_len
			(vp-add-rr match_len pos)
			(call :sys_mem :copy_in_ring `(,cp_src ,cp_dst ,cp_len ,cp_cap ,cp_buf))
		(else)
			;byte-by-byte (RLE overlap replication)
			(vp-rdef (m_pos v t2))
			(vp-cpy-rr pos m_pos)
			(vp-sub-rr offset m_pos)
			(loop-start)
				(vp-simd vp-cpy-rr `(,m_pos ,pos) `(,v ,t2))
				(vp-simd vp-and-rr `(,mask) `(,v ,t2))
				(vp-cpy-dr-ub buf v v)
				(vp-simd vp-add-cr '(1) `(,m_pos ,pos))
				(vp-sub-cr 1 match_len)
				(vp-cpy-rd-b v buf t2)
			(loop-until `(,match_len = 0))
		(endif)
	(loop-end)
	(call :num :create `(,pos) `(,args))

	(assign (vpx saved_this) `(,this))
	(exit `(,this ,args))
	(pop-scope)
	(return)

(errorcase
(vp-label 'error)
	;error path didn't trash `this` or `args`, or create a scope
	(jump :lisp :repl_error `(,args "(lz4-decode buf pos chunk)" +error_msg_wrong_types))
	(signature '(:str :NUM :str)))

(def-func-end)

(def-func (path-to-absolute "./lz4_read"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15

	(def-vars
		(ptr this args stm)
		(pubyte buf)
		(long pos)
		(uint in_len cap start space))

	(vp-rdef (this args))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 4)

	(push-scope)
	(assign `(,this ,args) (vpx this args))

	(vp-rdef (buf pos stm in_len))
	(list-bind-args args `(,buf ,pos ,stm ,in_len) '(:obj :num :stream :num))
	(assign `(,buf ,pos ,stm ,in_len) (vpx buf pos stm in_len))

	(assign (vpx (.> buf +str_length) (& (.> buf +str_data))) (vpx cap buf))
	(assign (vpx (& pos (- cap 1))) (vpx start))
	(assign (vpx (- cap start)) (vpx space))

	(vpif (vpx (<= in_len space)))
		(call :stream :read (vpx stm (+ buf start) in_len))
	(else)
		(call :stream :read (vpx stm (+ buf start) space))
		(call :stream :read (vpx stm buf (- in_len space)))
	(endif)

	(call :num :create (vpx (+ pos in_len)) (vpx args))

	(exit (vpx this args))
	(return)

	(pop-scope-syms)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(lz4-read buf pos stream in_len)" +error_msg_wrong_types))
	(signature '(:str :NUM :stream :NUM)))

(def-func-end)

(def-func (path-to-absolute "./lz4_write"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15

	(def-vars
		(ptr this args stm)
		(pubyte buf)
		(long pos)
		(uint out_len cap start space))

	(vp-rdef (this args))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 4)

	(push-scope)
	(assign `(,this ,args) (vpx this args))

	(vp-rdef (buf pos stm out_len))
	(list-bind-args args `(,buf ,pos ,stm ,out_len) '(:obj :num :stream :num))
	(assign `(,buf ,pos ,stm ,out_len) (vpx buf pos stm out_len))

	(assign (vpx (.> buf +str_length) (& (.> buf +str_data))) (vpx cap buf))
	(assign (vpx (& (- pos out_len) (- cap 1))) (vpx start))
	(assign (vpx (- cap start)) (vpx space))
	(vpif (vpx (<= out_len space)))
		(call :stream :write (vpx stm (+ buf start) out_len))
	(else)
		(call :stream :write (vpx stm (+ buf start) space))
		(call :stream :write (vpx stm buf (- out_len space)))
	(endif)

	(call :num :create (vpx pos) (vpx args))

	(exit (vpx this args))
	(return)

	(pop-scope-syms)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(lz4-write buf pos stream out_len)" +error_msg_wrong_types))
	(signature '(:str :NUM :stream :NUM)))

(def-func-end)

;;;;;;;;;
; inflate
;;;;;;;;;

(defmacro inflate-bits (n dst)
	;n bits of the stream into dst, -1 at its end
	`(call :stream :read_bits (vpx in ,n pool psize) (vpx _ ,dst pool psize)))

(defmacro inflate-symbol (counts syms most)
	;the next symbol of a code into sym, -1 if the bits are no code, as
	;huffman-symbol has it: the codes of a length one after the other
	;huffman-symbol has it: the codes of a length one after the other. A
	;(vpif) is a block of its own, a (break) in one leaves it, not the loop:
	;a loop is named to be left from inside one, (break 'name), or gone
	;round again, (continue 'name)
	`(progn
		(assign (vpx 0 0 0 1 -1) (vpx code first index len sym))
		(loop-while (vpx (<= len ,most)))
			(inflate-bits 1 bit)
			(breakif (vpx (= bit -1)))
			(assign (vpx (+ code bit) (elem ,counts (* len +long_size))) (vpx code count))
			(breakif (vpx (< (- code first) count)))
			(assign (vpx (+ index count) (<< (+ first count) 1) (<< code 1) (+ len 1)) (vpx index first code len))
		(loop-end)
		(vpif (vpx (/= bit -1)))
			(vpif (vpx (<= len ,most)))
				(assign (vpx (elem ,syms (* (+ index (- code first)) +long_size))) (vpx sym))
			(endif)
		(endif)))

(defmacro inflate-flush ()
	;what is in the ring and not yet written, to the out stream
	`(progn
		(assign (vpx (& flushed mask) (- at flushed)) (vpx start n))
		(vpif (vpx (> n 0)))
			(vpif (vpx (<= (+ start n) (+ mask 1))))
				(call :stream :write (vpx out (+ ring start) n))
			(else)
				(call :stream :write (vpx out (+ ring start) (- (+ mask 1) start)))
				(call :stream :write (vpx out ring (- n (- (+ mask 1) start))))
			(endif)
			(assign (vpx at) (vpx flushed))
		(endif)))

(def-func (path-to-absolute "./inflate_codes"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15
	;info
	;(inflate-codes in bits codes ring at out) -> at | -1, a block of
	;DEFLATE coded by its two codes, to its end. codes is (lcounts lsyms
	;dcounts dsyms lbase lextra dbase dextra), the two codes as huffman-table
	;makes them and the bases and extra bits of the lengths and distances.
	;ring a str of 2^n, at the number of bytes made so far, all written to
	;out by the end. -1 if the stream ends, or the bits are not a block

	(def-vars
		(ptr this args in out bits codes lco lso dco dso lbo leo dbo deo)
		(plong cp lcounts lsyms dcounts dsyms lbase lext dbase dext bitsp)
		(pubyte ring)
		(long pool at flushed sym bit)
		(uint psize mask lmost dmost code first index len count n start back d i mlen))

	(push-scope)
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(assign '(:r0 :r1) (vpx this args))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5) '(:obj :obj :obj :obj :num :obj))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5) (vpx in bits codes ring at out))
	(assign (vpx (.> bits +array_begin) (- (.> ring +str_length) 1) at) (vpx bitsp mask flushed))
	(assign (vpx (& (.> ring +str_data))) (vpx ring))
	(assign (vpx (elem bitsp 0) (elem bitsp +long_size)) (vpx pool psize))
	;the eight of codes, each a nums, and where the elements of each begin
	(assign (vpx (.> codes +array_begin)) (vpx cp))
	(assign (vpx (elem cp 0) (elem cp +ptr_size) (elem cp (* 2 +ptr_size)) (elem cp (* 3 +ptr_size)))
		(vpx lco lso dco dso))
	(assign (vpx (elem cp (* 4 +ptr_size)) (elem cp (* 5 +ptr_size)) (elem cp (* 6 +ptr_size)) (elem cp (* 7 +ptr_size)))
		(vpx lbo leo dbo deo))
	(assign (vpx (- (.> lco +array_length) 1) (- (.> dco +array_length) 1)) (vpx lmost dmost))
	(assign (vpx (.> lco +array_begin) (.> lso +array_begin) (.> dco +array_begin) (.> dso +array_begin))
		(vpx lcounts lsyms dcounts dsyms))
	(assign (vpx (.> lbo +array_begin) (.> leo +array_begin) (.> dbo +array_begin) (.> deo +array_begin))
		(vpx lbase lext dbase dext))

	(loop-start)
		(inflate-symbol lcounts lsyms lmost)
		(breakif (vpx (= sym -1)))
		(breakif (vpx (= sym 256)))
		(vpif (vpx (< sym 256)))
			(assign (vpx sym) (vpx (elem ring (& at mask))))
			(assign (vpx (+ at 1)) (vpx at))
		(elseif (vpx (>= sym 286)))
			(assign (vpx -1) (vpx sym))
		(else)
			;a length and a distance back, both with their extra bits
			(assign (vpx (- sym 257)) (vpx sym))
			(assign (vpx (elem lext (* sym +long_size))) (vpx n))
			(inflate-bits n bit)
			(assign (vpx (+ (elem lbase (* sym +long_size)) bit)) (vpx mlen))
			(vpif (vpx (= bit -1)))
				(assign (vpx -1) (vpx sym))
			(else)
				(inflate-symbol dcounts dsyms dmost)
				(vpif (vpx (= sym -1)))
				(elseif (vpx (>= sym 30)))
					(assign (vpx -1) (vpx sym))
				(else)
					(assign (vpx sym (elem dext (* sym +long_size))) (vpx d n))
					(inflate-bits n bit)
					(assign (vpx (+ (elem dbase (* d +long_size)) bit)) (vpx back))
					;not from before the start, nor further back than the ring
					(vpif (vpx (= bit -1)))
						(assign (vpx -1) (vpx sym))
					(elseif (vpx (> back at)))
						(assign (vpx -1) (vpx sym))
					(elseif (vpx (> back mask)))
						(assign (vpx -1) (vpx sym))
					(else)
						(assign (vpx 0) (vpx i))
						(loop-while (vpx (< i mlen)))
							(assign (vpx (elem ring (& (- at back) mask))) (vpx (elem ring (& at mask))))
							(assign (vpx (+ at 1) (+ i 1)) (vpx at i))
						(loop-end)
					(endif)
				(endif)
			(endif)
		(endif)
		(breakif (vpx (= sym -1)))
		;written out before it can be written over
		(vpif (vpx (>= (- at flushed) 16384)))
			(inflate-flush)
		(endif)
	(loop-end)
	(inflate-flush)

	(assign (vpx pool psize) (vpx (elem bitsp 0) (elem bitsp +long_size)))
	(vpif (vpx (= sym -1)))
		(assign (vpx -1) (vpx at))
	(endif)
	(call :num :create (vpx at) (vpx args))
	(assign (vpx this args) '(:r0 :r1))
	(exit '(:r0 :r1))
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(inflate-codes in bits codes ring at out)" +error_msg_wrong_types))
	(signature '(:stream :array :list :str :NUM :stream)))

	(pop-scope-syms)

(def-func-end)

(def-func (path-to-absolute "./huffman_symbol"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15
	;info
	;(huffman-symbol in bits table) -> symbol | -1, the next symbol of a
	;code, table (counts symbols) as huffman-table makes it, -1 at the end
	;of the stream or if the bits are no code

	(def-vars
		(ptr this args in bits table)
		(pptr tp)
		(plong counts syms bitsp)
		(long pool sym bit)
		(uint psize most code first index len count))

	(push-scope)
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(assign '(:r0 :r1) (vpx this args))
	(list-bind-args :r1 '(:r0 :r1 :r2) '(:obj :obj :obj))
	(assign '(:r0 :r1 :r2) (vpx in bits table))
	(assign (vpx (.> bits +array_begin) (.> table +array_begin)) (vpx bitsp tp))
	(assign (vpx (elem bitsp 0) (elem bitsp +long_size)) (vpx pool psize))
	(assign (vpx (- (.> (elem tp 0) +array_length) 1) (.> (elem tp 0) +array_begin) (.> (elem tp +ptr_size) +array_begin))
		(vpx most counts syms))
	(inflate-symbol counts syms most)
	(assign (vpx pool psize) (vpx (elem bitsp 0) (elem bitsp +long_size)))

	(call :num :create (vpx sym) (vpx args))
	(assign (vpx this args) '(:r0 :r1))
	(exit '(:r0 :r1))
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(huffman-symbol in bits table)" +error_msg_wrong_types))
	(signature '(:stream :array :list)))

	(pop-scope-syms)

(def-func-end)
