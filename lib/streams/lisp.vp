(include "lib/asm/func.inc")
(include "class/stream/class.inc")
(include "class/nums/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(defmacro read-uint32 (src dst)
	`(progn
		(vp-rdef (buf mask i val t))
		(assign (cat ,src '(0)) `(,buf ,mask ,i ,val))
		(times 4
			(vp-and-rr mask i)
			(vp-load-rrr-ub buf i t)
			(if (/= (!) 3) (vp-add-cr 1 i))
			(if (/= (!) 0) (vp-shl-cr (* (!) 8) t))
			(vp-add-rr t val))
		(assign `(,val) ,dst)))

(defmacro subroutine (addr)
	(defq ret_label (gensym))
	`(progn
		(assign (vpx ($ ,ret_label)) (vpx ret_adr))
		(vp-jmp ',addr)
	(vp-label ',ret_label)))

(def-func (path-to-absolute "./lz4_encode"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r0-:r14, :d0-:d15

	(def-vars
		(ptr this args tok_buf hash_table ret_adr)
		(pubyte buf chunk t)
		(long pos m_pos anchor)
		(uint c_len cap mask i end_limit match_limit val m_val m_len lit_len t_pos offset hmul)
		(ubyte match_nibble))

	(vp-rdef (this args))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 4)

	(push-scope)
	(assign `(,this ,args) (vpx this args))

	(vp-rdef (buf pos chunk hash_table))
	(list-bind-args :r1 `(,buf ,pos ,chunk ,hash_table) '(:obj :num :obj :obj))
	(assign `(,buf ,pos ,chunk ,hash_table) (vpx buf pos chunk hash_table))

	(assign (vpx (.> buf +str_length) (.> chunk +str_length)) (vpx cap c_len))
	(assign (vpx (- cap 1) (& (.> buf +str_data)) (& (.> chunk +str_data)) (.> hash_table +array_begin))
		(vpx mask buf chunk hash_table))

	; --- 1. Write chunk into logical ring buffer ---
	(call :sys_mem :copy_to_ring (vpx chunk (+ buf (& pos mask)) c_len cap buf))

	; --- 2. Allocate token buffer (Worst-case LZ4 expansion size) ---
	(call :str :create_from_buffer (vpx 0 (+ (/ c_len 255) c_len 32)) (vpx tok_buf))
	(assign (vpx (& (.> tok_buf +str_data)) 0) (vpx t t_pos))

	; --- 3. Encode Loop ---
	(assign (vpx pos pos 2654435761) (vpx i anchor hmul))
	(vpif (vpx (>= c_len 12)))
		(assign (vpx (- (+ pos c_len) 12) (- (+ pos c_len) 5)) (vpx end_limit match_limit))
	(else)
		(assign (vpx pos pos) (vpx end_limit match_limit))
	(endif)

	(loop-while (vpx (< i end_limit)) 'next)
		;read 32-bit unaligned across ring buffer
		(read-uint32 (vpx buf mask i) (vpx val))

		;hash lookup (absolute logical position avoids ever needing to slide/clear the hash table!)
		(vp-rdef (m_pos i hptr))
		(assign (vpx (+ hash_table (* (& (>> (* val hmul) 19) 8191) +long_size)) i) `(,hptr ,i))
		(assign `((,hptr 0)) `(,m_pos))
		(assign `(,i) `((,hptr 0)))
		(vp-sub-rr m_pos i)
		(assign `(,m_pos ,i) (vpx m_pos offset))
		(vpif `(,i <= 65535))
			;read 32-bit unaligned across ring buffer
			(read-uint32 (vpx buf mask m_pos) (vpx m_val))

			(vpif (vpx (= val m_val)))
				;match found
				(vp-rdef (buf mask ptr_i ptr_m match_limit v1 v2 i m_pos match_limit buf mask anchor))
				(assign (vpx i m_pos match_limit anchor)
					`(,i ,m_pos ,match_limit ,anchor))
				(vp-simd vp-lea-rcr `(,i ,m_pos) '(4) `(,ptr_i ,ptr_m))
				(vpif `(,ptr_i < ,match_limit))
					(assign (vpx buf mask) `(,buf ,mask))
					(loop-start)
						(vp-simd vp-cpy-rr `(,ptr_m ,ptr_i) `(,v2 ,v1))
						(vp-simd vp-and-rr `(,mask) `(,v2 ,v1))
						(vp-simd vp-load-rrr-ub `(,buf) `(,v2 ,v1) `(,v2 ,v1))
						(breakif `(,v1 /= ,v2))
						(vp-simd vp-add-cr '(1) `(,ptr_m ,ptr_i))
					(loop-until `(,ptr_i = ,match_limit))
				(endif)
				(assign `(,i) (vpx i))
				(vp-sub-rr i ptr_i)
				(vp-sub-rr anchor i)
				(assign `(,ptr_i ,i) (vpx m_len lit_len))

				;subroutine call while keeping stack context !
				(subroutine literals)

				(assign (vpx (=> (+ i m_len) anchor)) (vpx i))
				(continue 'next)
			(endif)
		(endif)
		(assign (vpx (+ i 1)) (vpx i))
	(loop-end)

	; --- Final Literals ---
	(assign (vpx (- (+ pos c_len) anchor) 0 0) (vpx lit_len match_nibble offset))

	;subroutine call while keeping stack context !
	(subroutine literals)

	;truncate buffer size
	(assign (vpx t_pos) (vpx (.> tok_buf +str_length)))

	(call :num :create (vpx (+ pos c_len)) (vpx ret_adr))
	(call :list :create :nil (vpx args))
	(call :list :push_back2 (vpx args tok_buf ret_adr))

	(exit (vpx this args))
	(return)

(vp-label 'literals)
	(vp-rdef (lit_len v t_pos t c lit_nibble match_nibble offset m_len))
	(assign (vpx lit_len offset m_len t t_pos match_nibble)
		`(,lit_len ,offset ,m_len ,t ,t_pos ,match_nibble))
	(vp-add-rr t t_pos)

	(vp-cpy-rr lit_len lit_nibble)
	(vp-min-cr 15 lit_nibble)
	(vpif `(,offset > 0))
		(vp-lea-rcr m_len -4 match_nibble)
		(vp-min-cr 15 match_nibble)
	(endif)
	(vp-shl-cr 4 lit_nibble)
	(vp-or-rr match_nibble lit_nibble)
	(vp-store-rrc-b lit_nibble t_pos 0)
	(vp-add-cr 1 t_pos)

	(vpif `(,lit_len >= 15))
		(vp-lea-rcr lit_len -15 v)
		(vp-cpy-cr 255 c)
		(loop-while `(,v >= ,c))
			(vp-store-rrc-b c t_pos 0)
			(vp-add-cr 1 t_pos)
			(vp-sub-rr c v)
		(loop-end)
		(vp-store-rrc-b v t_pos 0)
		(vp-add-cr 1 t_pos)
	(endif)

	(vp-sub-rr t t_pos)
	(assign `(,t_pos) (vpx t_pos))

	(vpif (vpx (> lit_len 0)))
		(call :sys_mem :copy_from_ring (vpx (+ buf (& anchor mask)) (+ t t_pos) lit_len cap buf))
		(assign (vpx (+ t_pos lit_len)) (vpx t_pos))
	(endif)

	(vp-rdef (offset m_len t_pos t v c t1 t2))
	(assign (vpx offset) `(,offset))
	(vpif `(,offset > 0))
		(assign (vpx m_len t_pos t 255) `(,m_len ,t_pos ,t ,c))
		(vp-add-rr t t_pos)
		(vp-simd vp-cpy-rr `(,offset) `(,t1 ,t2))
		(vp-and-rr c t1)
		(vp-shr-cr 8 t2)
		(vp-simd vp-store-rrc-b `(,t1 ,t2) `(,t_pos) '(0 1))
		(vp-add-cr 2 t_pos)
		(vpif `(,m_len >= 19))
			(vp-lea-rcr m_len -19 v)
			(loop-while `(,v >= ,c))
				(vp-store-rrc-b c t_pos 0)
				(vp-add-cr 1 t_pos)
				(vp-sub-rr c v)
			(loop-end)
			(vp-store-rrc-b v t_pos 0)
			(vp-add-cr 1 t_pos)
		(endif)
		(vp-sub-rr t t_pos)
		(assign `(,t_pos ,m_len) (vpx t_pos m_len))
	(endif)

	(assign (vpx ret_adr) '(:r0))
	(vp-jmp-r :r0)

	(pop-scope-syms)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(lz4-encode buf pos chunk hash_table)" +error_msg_wrong_types))
	(signature '(:str :NUM :str :NUMS))

(def-func-end)

(def-func (path-to-absolute "./lz4_decode"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr saved_this))

	(vp-rdef (this args))
	;persistent state: survives ALL calls (requires :r9 to :r14)
	(vp-rdef (buf pos chunk c_pos c_len mask) '(:r9 :r10 :r11 :r12 :r13 :r14))
	;semi-persistent state: survives copy_to_ring, dead before copy_in_ring (:r6 to :r8)
	(vp-rdef (token offset match_len) '(:r6 :r7 :r8))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 3)

	(vp-alloc slot_size)
	;this to the frame, it is wanted at the end
	(assign `(,this) '((:rsp slot_saved_this)))

	(list-bind-args args `(,buf ,pos ,chunk) '(:obj :num :obj))
	(assign `((,chunk +str_length) (,buf +str_length) (& ,chunk +str_data) (& ,buf +str_data))
		`(,c_len ,mask ,chunk ,buf))
	(vp-sub-cr 1 mask)
	(vp-xor-rr c_pos c_pos)

	(loop-while `(,c_pos < ,c_len))
		;token
		(vp-load-rrr-ub chunk c_pos token)
		(vp-add-cr 1 c_pos)

		;literals
		(vp-rdef (lit_len) '(:r5)) ;safe to use :r5 here, volatile but untouched until call
		(vp-cpy-rr token lit_len)
		(vp-shr-cr 4 lit_len)
		(vpif `(,lit_len = 15))
			(vp-rdef (v) '(:r0))
			(loop-while `(,c_pos < ,c_len))
				(vp-load-rrr-ub chunk c_pos v)
				(vp-add-cr 1 c_pos)
				(vp-add-rr v lit_len)
			(loop-until `(,v /= 255))
		(endif)

		;guard against buffer overflow
		(vp-rdef (t1) '(:r0))
		(vp-cpy-rr c_len t1)
		(vp-sub-rr c_pos t1)
		(vpif `(,lit_len > ,t1))
			(vp-cpy-rr t1 lit_len)
		(endif)

		(vpif `(,lit_len > 0))
			;extract correct registers for call mapping (volatile :r0-:r4)
			(vp-rdef (cp_src cp_dst cp_len cp_cap cp_buf)
				(method-input :sys_mem :copy_to_ring))

			;setup call arguments in volatiles
			(assign `(,c_pos ,pos ,mask ,buf ,lit_len)
				`(,cp_src ,cp_dst ,cp_cap ,cp_buf ,cp_len))
			(vp-add-rr chunk cp_src)	  ; cp_src = chunk + c_pos
			(vp-and-rr mask cp_dst)
			(vp-add-rr buf cp_dst)		  ; cp_dst = buf + (pos & mask)
			(vp-add-cr 1 cp_cap)		  ; cp_cap = mask + 1

			;advance loop positions BEFORE the sys_mem call trashes lit_len!
			(vp-simd vp-add-rr `(,lit_len) `(,c_pos ,pos))
			(call :sys_mem :copy_to_ring `(,cp_src ,cp_dst ,cp_len ,cp_cap ,cp_buf))
		(endif)

		(breakif `(,c_pos >= ,c_len))

		;match
		(vp-add-cr 1 c_pos)
		(breakif `(,c_pos >= ,c_len))

		;read 16-bit little-endian offset securely
		(vp-rdef (t1) '(:r0))
		(vp-load-rrr-ub chunk c_pos t1)
		(vp-sub-cr 1 c_pos)
		(vp-load-rrr-ub chunk c_pos offset)
		(vp-shl-cr 8 t1)
		(vp-or-rr t1 offset)
		(vp-add-cr 2 c_pos)

		(vp-cpy-rr token match_len)
		(vp-and-cr 15 match_len)
		(vp-add-cr 4 match_len)
		(vpif `(,match_len = 19))
			(vp-rdef (v) '(:r0))
			(loop-while `(,c_pos < ,c_len))
				(vp-load-rrr-ub chunk c_pos v)
				(vp-add-cr 1 c_pos)
				(vp-add-rr v match_len)
			(loop-until `(,v /= 255))
		(endif)

		(vpif `(,offset >= ,match_len))
			;bulk copy
			(vp-rdef (cp_src cp_dst cp_len cp_cap cp_buf)
				(method-input :sys_mem :copy_in_ring))

			(vp-rdef (m_pos) '(:r0))
			(vp-cpy-rr pos m_pos)
			(vp-sub-rr offset m_pos)
			(assign `(,m_pos ,pos ,match_len ,mask ,buf)
				`(,cp_src ,cp_dst ,cp_len ,cp_cap ,cp_buf))
			(vp-add-cr 1 cp_cap)
			(vp-simd vp-and-rr `(,mask) `(,cp_src ,cp_dst))
			(vp-simd vp-add-rr `(,buf) `(,cp_src ,cp_dst))

			;advance pos BEFORE call trashes match_len
			(vp-add-rr match_len pos)
			(call :sys_mem :copy_in_ring `(,cp_src ,cp_dst ,cp_len ,cp_cap ,cp_buf))
		(else)
			;byte-by-byte (RLE overlap replication)
			(vp-rdef (m_pos v t2))
			(vp-cpy-rr pos m_pos)
			(vp-sub-rr offset m_pos)
			(loop-start)
				(vp-simd vp-cpy-rr `(,m_pos ,pos) `(,v ,t2))
				(vp-simd vp-and-rr `(,mask) `(,v ,t2))
				(vp-load-rrr-ub buf v v)
				(vp-simd vp-add-cr '(1) `(,m_pos ,pos))
				(vp-sub-cr 1 match_len)
				(vp-store-rrr-b v buf t2)
			(loop-until `(,match_len = 0))
		(endif)
	(loop-end)
	(call :num :create `(,pos) `(,args))

	(exit `((:rsp slot_saved_this) ,args))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	;error path didn't trash `this` or `args`, or make the frame
	(jump :lisp :repl_error `(,args "(lz4-decode buf pos chunk)" +error_msg_wrong_types))
	(signature '(:str :NUM :str))

(def-func-end)

(def-func (path-to-absolute "./lz4_read"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15

	(structure slot 0
		(ptr this stm)
		(pubyte buf)
		(long pos)
		(uint in_len space))

	(vp-rdef (this args))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(assign `(,this) '((:rsp slot_this)))

	(vp-rdef (buf pos stm in_len))
	(list-bind-args args `(,buf ,pos ,stm ,in_len) '(:obj :num :stream :num))
	(save-fields :rsp '(slot_pos slot_stm slot_in_len) `(,pos ,stm ,in_len))

	;the ring is the str, a power of 2 long, in_len bytes read into it at
	;pos, in two parts if they go round its end
	(assign `((,buf +str_length)) '(:r4))
	(vp-add-cr +str_data buf)
	(vp-cpy-rr :r4 :r5)
	(vp-sub-cr 1 :r5)
	(vp-and-rr pos :r5)
	(vp-sub-rr :r5 :r4)
	(vpif `(,in_len <= :r4))
		(vp-add-rr :r5 buf)
		(call :stream :read `(,stm ,buf ,in_len))
	(else)
		(save-fields :rsp '(slot_buf slot_space) `(,buf :r4))
		(vp-add-rr :r5 buf)
		(call :stream :read `(,stm ,buf :r4))
		(load-fields :rsp '(slot_stm slot_buf slot_in_len slot_space) '(:r0 :r1 :r2 :r3))
		(vp-sub-rr :r3 :r2)
		(call :stream :read '(:r0 :r1 :r2))
	(endif)

	(load-fields :rsp '(slot_pos slot_in_len) '(:r0 :r1))
	(vp-add-rr :r1 :r0)
	(call :num :create '(:r0) '(:r1))

	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(lz4-read buf pos stream in_len)" +error_msg_wrong_types))
	(signature '(:str :NUM :stream :NUM))

(def-func-end)

(def-func (path-to-absolute "./lz4_write"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15

	(structure slot 0
		(ptr this stm)
		(pubyte buf)
		(long pos)
		(uint out_len space))

	(vp-rdef (this args))

	(entry `(,this ,args))
	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(assign `(,this) '((:rsp slot_this)))

	(vp-rdef (buf pos stm out_len))
	(list-bind-args args `(,buf ,pos ,stm ,out_len) '(:obj :num :stream :num))
	(save-fields :rsp '(slot_pos slot_stm slot_out_len) `(,pos ,stm ,out_len))

	;the ring is the str, a power of 2 long, out_len bytes before pos
	;written, in two parts if they go round its end
	(assign `((,buf +str_length)) '(:r4))
	(vp-add-cr +str_data buf)
	(vp-cpy-rr pos :r5)
	(vp-sub-rr out_len :r5)
	(vp-cpy-rr :r4 :r6)
	(vp-sub-cr 1 :r6)
	(vp-and-rr :r6 :r5)
	(vp-sub-rr :r5 :r4)
	(vpif `(,out_len <= :r4))
		(vp-add-rr :r5 buf)
		(call :stream :write `(,stm ,buf ,out_len))
	(else)
		(save-fields :rsp '(slot_buf slot_space) `(,buf :r4))
		(vp-add-rr :r5 buf)
		(call :stream :write `(,stm ,buf :r4))
		(load-fields :rsp '(slot_stm slot_buf slot_out_len slot_space) '(:r0 :r1 :r2 :r3))
		(vp-sub-rr :r3 :r2)
		(call :stream :write '(:r0 :r1 :r2))
	(endif)

	(call :num :create '((:rsp slot_pos)) '(:r1))
	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)


(vp-label 'error)
	(jump :lisp :repl_error `(,args "(lz4-write buf pos stream out_len)" +error_msg_wrong_types))
	(signature '(:str :NUM :stream :NUM))

(def-func-end)

;;;;;;;;;
; inflate
;;;;;;;;;

(defun inflate-bits (n dst)
	;n bits of the stream into dst, -1 at its end: the stream in :r11, the
	;pool and its size in :r2 and :r3, where read_bits takes and gives them,
	;:r0 :r1 :r4 trashed
	(call :stream :read_bits `(:r11 ,n :r2 :r3) `(_ ,dst :r2 :r3)))

(defun inflate-symbol (counts syms most)
	;the next symbol of a code into :r5, -1 if the bits are no code, as
	;huffman-symbol has it: the codes of a length one after the other. The
	;code's counts, syms and most are slots, :r6 to :r10 trashed: :r7 code,
	;:r8 first, :r9 index, :r10 len, :r6 count
	(defq l (gensym))
	(vp-xor-rr :r7 :r7)
	(vp-xor-rr :r8 :r8)
	(vp-xor-rr :r9 :r9)
	(vp-cpy-cr 1 :r10)
	(vp-cpy-cr -1 :r5)
	(loop-start l)
		(assign `((:rsp ,most)) '(:r6))
		(breakif '(:r10 > :r6) l)
		(inflate-bits 1 :r1)
		(breakif '(:r1 = -1) l)
		(vp-add-rr :r1 :r7)
		(assign `((:rsp ,counts)) '(:r6))
		(vp-cpy-rr :r10 :r1)
		(vp-shl-cr 3 :r1)
		(vp-load-rrr :r6 :r1 :r6)
		(vp-cpy-rr :r7 :r1)
		(vp-sub-rr :r8 :r1)
		(vpif '(:r1 < :r6))
			(assign `((:rsp ,syms)) '(:r6))
			(vp-add-rr :r9 :r1)
			(vp-shl-cr 3 :r1)
			(vp-load-rrr :r6 :r1 :r5)
			(break l)
		(endif)
		(vp-add-rr :r6 :r9)
		(vp-add-rr :r6 :r8)
		(vp-shl-cr 1 :r8)
		(vp-shl-cr 1 :r7)
		(vp-add-cr 1 :r10)
	(loop-end))

(defun inflate-flush ()
	;what is in the ring and not yet written, to the out stream: at in :r12,
	;the mask :r13, the ring :r14, the pool kept in its slots across the
	;writes, :r0 :r1 :r4 :r5 :r6 :r7 :r8 trashed
	(assign '((:rsp slot_flushed)) '(:r6))
	(vp-cpy-rr :r12 :r7)
	(vp-sub-rr :r6 :r7)
	(vpif '(:r7 > 0))
		(save-fields :rsp '(slot_pool slot_psize) '(:r2 :r3))
		(vp-and-rr :r13 :r6)
		(vp-lea-rcr :r13 1 :r8)
		(vp-sub-rr :r6 :r8)
		(vp-lea-rrr :r14 :r6 :r1)
		(vpif '(:r7 <= :r8))
			(call :stream :write '((:rsp slot_out) :r1 :r7))
		(else)
			(call :stream :write '((:rsp slot_out) :r1 :r8))
			(vp-sub-rr :r8 :r7)
			(call :stream :write '((:rsp slot_out) :r14 :r7))
		(endif)
		(assign '(:r12) '((:rsp slot_flushed)))
		(load-fields :rsp '(slot_pool slot_psize) '(:r2 :r3))
	(endif))

(def-func (path-to-absolute "./inflate_codes"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d15
	;info
	;(inflate-codes in bits codes ring at out) -> at | -1, a block of
	;DEFLATE coded by its two codes, to its end. codes is (lcounts lsyms
	;dcounts dsyms lbase lextra dbase dextra), the two codes as huffman-table
	;makes them and the bases and extra bits of the lengths and distances.
	;ring a str of 2^n, at the number of bytes made so far, all written to
	;out by the end. -1 if the stream ends, or the bits are not a block

	(structure slot 0
		(ptr this args out)
		(plong bitsp lcounts lsyms dcounts dsyms lbase lext dbase dext)
		(long flushed pool psize sym r7 r8 r9 r10 r11 r12 r13 r14)
		(uint lmost dmost mlen))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	;:r7 to :r14 kept in the frame. The bit pool in :r2 :r3, the stream
	;:r11, at :r12, the ring's mask :r13 and its bytes :r14
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5) '(:obj :obj :obj :obj :num :obj))
	(vp-cpy-rr :r0 :r11)
	(vp-cpy-rr :r4 :r12)
	(assign '((:r1 +array_begin) (:r3 +str_length)) '(:r1 :r13))
	(vp-sub-cr 1 :r13)
	(vp-lea-rcr :r3 +str_data :r14)
	(save-fields :rsp '(slot_out slot_bitsp slot_flushed) '(:r5 :r1 :r12))
	;the eight of codes, each a nums, and where the elements of each begin
	(assign '((:r2 +array_begin)) '(:r2))
	(load-fields :r2 (list 0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r4 :r5 :r6 :r7))
	(assign '((:r4 +array_length) (:r6 +array_length)) '(:r8 :r9))
	(vp-sub-cr 1 :r8)
	(vp-sub-cr 1 :r9)
	(assign '((:r4 +array_begin) (:r5 +array_begin) (:r6 +array_begin) (:r7 +array_begin)) '(:r4 :r5 :r6 :r7))
	(save-fields :rsp '(slot_lcounts slot_lsyms slot_dcounts slot_dsyms slot_lmost slot_dmost) '(:r4 :r5 :r6 :r7 :r8 :r9))
	(load-fields :r2 (list (* 4 +ptr_size) (* 5 +ptr_size) (* 6 +ptr_size) (* 7 +ptr_size)) '(:r4 :r5 :r6 :r7))
	(assign '((:r4 +array_begin) (:r5 +array_begin) (:r6 +array_begin) (:r7 +array_begin)) '(:r4 :r5 :r6 :r7))
	(save-fields :rsp '(slot_lbase slot_lext slot_dbase slot_dext) '(:r4 :r5 :r6 :r7))
	(load-fields :r1 (list 0 +long_size) '(:r2 :r3))

	(loop-start)
		(inflate-symbol 'slot_lcounts 'slot_lsyms 'slot_lmost)
		(breakif '(:r5 = -1) '(:r5 = 256))
		(vpif '(:r5 < 256))
			(vp-cpy-rr :r12 :r6)
			(vp-and-rr :r13 :r6)
			(vp-store-rrr-b :r5 :r14 :r6)
			(vp-add-cr 1 :r12)
		(elseif '(:r5 >= 286))
			(vp-cpy-cr -1 :r5)
		(else)
			;a length and a distance back, both with their extra bits
			(vp-sub-cr 257 :r5)
			(vp-shl-cr 3 :r5)
			(assign '((:rsp slot_lext)) '(:r6))
			(vp-load-rrr :r6 :r5 :r1)
			(inflate-bits :r1 :r1)
			(vpif '(:r1 = -1))
				(vp-cpy-cr -1 :r5)
			(else)
				(assign '((:rsp slot_lbase)) '(:r6))
				(vp-load-rrr :r6 :r5 :r6)
				(vp-add-rr :r1 :r6)
				(assign '(:r6) '((:rsp slot_mlen)))
				(inflate-symbol 'slot_dcounts 'slot_dsyms 'slot_dmost)
				(vpif '(:r5 = -1))
				(elseif '(:r5 >= 30))
					(vp-cpy-cr -1 :r5)
				(else)
					(vp-shl-cr 3 :r5)
					(assign '((:rsp slot_dext)) '(:r6))
					(vp-load-rrr :r6 :r5 :r1)
					(inflate-bits :r1 :r1)
					;not from before the start, nor further back than the ring,
					;32768 the most, the byte read before it is written over
					(vpif '(:r1 = -1))
						(vp-cpy-cr -1 :r5)
					(else)
						(assign '((:rsp slot_dbase)) '(:r6))
						(vp-load-rrr :r6 :r5 :r6)
						(vp-add-rr :r1 :r6)
						(vp-lea-rcr :r13 1 :r7)
						(vpif '(:r6 > :r12))
							(vp-cpy-cr -1 :r5)
						(elseif '(:r6 > :r7))
							(vp-cpy-cr -1 :r5)
						(else)
							(assign '((:rsp slot_mlen)) '(:r7))
							(vpif '(:r7 > 0))
								(vp-cpy-rr :r12 :r8)
								(vp-sub-rr :r6 :r8)
								(loop-start)
									(vp-cpy-rr :r8 :r9)
									(vp-and-rr :r13 :r9)
									(vp-load-rrr-ub :r14 :r9 :r9)
									(vp-cpy-rr :r12 :r10)
									(vp-and-rr :r13 :r10)
									(vp-store-rrr-b :r9 :r14 :r10)
									(vp-add-cr 1 :r8)
									(vp-add-cr 1 :r12)
									(vp-sub-cr 1 :r7)
								(loop-until '(:r7 = 0))
							(endif)
						(endif)
					(endif)
				(endif)
			(endif)
		(endif)
		(breakif '(:r5 = -1))
		;written out before it can be written over
		(assign '((:rsp slot_flushed)) '(:r6))
		(vp-cpy-rr :r12 :r7)
		(vp-sub-rr :r6 :r7)
		(vpif '(:r7 >= 16384))
			(inflate-flush)
		(endif)
	(loop-end)
	(assign '(:r5) '((:rsp slot_sym)))
	(inflate-flush)

	(assign '((:rsp slot_bitsp)) '(:r1))
	(save-fields :r1 (list 0 +long_size) '(:r2 :r3))
	(assign '((:rsp slot_sym)) '(:r5))
	(vpif '(:r5 = -1))
		(vp-cpy-cr -1 :r12)
	(endif)
	(call :num :create '(:r12) '(:r1))
	(load-fields :rsp '(slot_this slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(inflate-codes in bits codes ring at out)" +error_msg_wrong_types))
	(signature '(:stream :array :list :str :NUM :stream))

(def-func-end)

(def-func (path-to-absolute "./huffman_symbol"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15
	;info
	;(huffman-symbol in bits table) -> symbol | -1, the next symbol of a
	;code, table (counts symbols) as huffman-table makes it, -1 at the end
	;of the stream or if the bits are no code

	(structure slot 0
		(ptr this args)
		(plong counts syms bitsp)
		(long r7 r8 r9 r10 r11)
		(uint most))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	;:r7 to :r11 kept in the frame, the bit pool in :r2 :r3, the stream :r11
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r7 slot_r8 slot_r9 slot_r10 slot_r11)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11))
	(list-bind-args :r1 '(:r0 :r1 :r2) '(:obj :obj :obj))
	(vp-cpy-rr :r0 :r11)
	(assign '((:r1 +array_begin) (:r2 +array_begin)) '(:r1 :r2))
	(load-fields :r2 (list 0 +ptr_size) '(:r4 :r5))
	(assign '((:r4 +array_length) (:r4 +array_begin) (:r5 +array_begin)) '(:r6 :r4 :r5))
	(vp-sub-cr 1 :r6)
	(save-fields :rsp '(slot_counts slot_syms slot_bitsp slot_most) '(:r4 :r5 :r1 :r6))
	(load-fields :r1 (list 0 +long_size) '(:r2 :r3))
	(inflate-symbol 'slot_counts 'slot_syms 'slot_most)
	(assign '((:rsp slot_bitsp)) '(:r1))
	(save-fields :r1 (list 0 +long_size) '(:r2 :r3))

	(call :num :create '(:r5) '(:r1))
	(load-fields :rsp '(slot_this slot_r7 slot_r8 slot_r9 slot_r10 slot_r11) '(:r0 :r7 :r8 :r9 :r10 :r11))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(huffman-symbol in bits table)" +error_msg_wrong_types))
	(signature '(:stream :array :list))

(def-func-end)

;;;;;;;;;
; deflate
;;;;;;;;;

(defun deflate-put (code n)
	;n bits of code to the out stream, the low first: the stream in :r11,
	;the pool and its size in :r12 :r13, :r0-:r4 trashed
	(call :stream :write_bits `(:r11 ,code ,n :r12 :r13) '(_ :r12 :r13)))

(def-func (path-to-absolute "./deflate_fixed"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :r14, :d0-:d15
	;info
	;(deflate-block ring pos chunk hash bits out last tables) -> pos, chunk
	;as a block of DEFLATE of the fixed codes, last 1 if it is the last. It
	;is put in the ring, a str of 2^n twice the window at the least, at
	;pos, the bytes so far, and a match is looked for back in it by the
	;hash of the 3 bytes from each place, hash a nums of 8192 of where each
	;was last, -65536 for none. tables is (lcodes llens dcodes dlens lbase
	;lextra dbase dextra), the codes each the other way round, to be written

	(structure slot 0
		(ptr this args)
		(plong ht bitsp lcodes llens dcodes dlens lbase lext dbase dext)
		(long last r8 r9 r10 r11 r12 r13))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 8)

	;:r8 to :r13 kept in the frame: :r8 end, :r9 i, :r10 the ring's mask,
	;:r14 its bytes, :r11 out, the bit pool in :r12 :r13
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13)
		'(:r0 :r1 :r8 :r9 :r10 :r11 :r12 :r13))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7) '(:obj :num :obj :obj :obj :obj :num :obj))
	(vp-cpy-rr :r5 :r11)
	(vp-cpy-rr :r1 :r9)
	(assign '((:r2 +str_length) (:r0 +str_length)) '(:r8 :r10))
	(vp-add-rr :r9 :r8)
	(assign '((:r3 +array_begin) (:r4 +array_begin) (:r7 +array_begin)) '(:r3 :r4 :r7))
	(save-fields :rsp '(slot_ht slot_bitsp slot_last) '(:r3 :r4 :r6))
	(load-fields :r4 (list 0 +long_size) '(:r12 :r13))
	(load-fields :r7 (list 0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r3 :r4 :r5 :r6))
	(assign '((:r3 +array_begin) (:r4 +array_begin) (:r5 +array_begin) (:r6 +array_begin)) '(:r3 :r4 :r5 :r6))
	(save-fields :rsp '(slot_lcodes slot_llens slot_dcodes slot_dlens) '(:r3 :r4 :r5 :r6))
	(load-fields :r7 (list (* 4 +ptr_size) (* 5 +ptr_size) (* 6 +ptr_size) (* 7 +ptr_size)) '(:r3 :r4 :r5 :r6))
	(assign '((:r3 +array_begin) (:r4 +array_begin) (:r5 +array_begin) (:r6 +array_begin)) '(:r3 :r4 :r5 :r6))
	(save-fields :rsp '(slot_lbase slot_lext slot_dbase slot_dext) '(:r3 :r4 :r5 :r6))

	;the chunk into the ring
	(vp-lea-rcr :r0 +str_data :r14)
	(vp-cpy-rr :r8 :r5)
	(vp-sub-rr :r9 :r5)
	(vp-lea-rcr :r2 +str_data :r0)
	(vp-cpy-rr :r10 :r6)
	(vp-sub-cr 1 :r6)
	(vp-cpy-rr :r9 :r1)
	(vp-and-rr :r6 :r1)
	(vp-add-rr :r14 :r1)
	(assign '(:r5 :r10 :r14 :r6) '(:r2 :r3 :r4 :r10))
	(call :sys_mem :copy_to_ring '(:r0 :r1 :r2 :r3 :r4))

	;the head of the block, last and fixed codes, 1
	(assign '((:rsp slot_last)) '(:r0))
	(vp-add-cr 2 :r0)
	(deflate-put :r0 3)
	(vpif '(:r9 < :r8))
		(loop-start)
			;:r7 len, :r6 dist, :r5 the place of a base
			(vp-xor-rr :r7 :r7)
			(vp-cpy-rr :r8 :r0)
			(vp-sub-rr :r9 :r0)
			(vpif '(:r0 >= 3))
				;the hash of the 3 bytes from i, the multiplier of more than 31
				;bits in a register, an x64 instruction takes no more
				(vp-cpy-rr :r9 :r1)
				(vp-and-rr :r10 :r1)
				(vp-load-rrr-ub :r14 :r1 :r0)
				(vp-shl-cr 16 :r0)
				(vp-lea-rcr :r9 1 :r1)
				(vp-and-rr :r10 :r1)
				(vp-load-rrr-ub :r14 :r1 :r2)
				(vp-shl-cr 8 :r2)
				(vp-or-rr :r2 :r0)
				(vp-lea-rcr :r9 2 :r1)
				(vp-and-rr :r10 :r1)
				(vp-load-rrr-ub :r14 :r1 :r2)
				(vp-or-rr :r2 :r0)
				(assign '(2654435761) '(:r1))
				(vp-mul-rr :r1 :r0)
				(vp-shr-cr 19 :r0)
				(vp-and-cr 8191 :r0)
				(vp-shl-cr 3 :r0)
				(assign '((:rsp slot_ht)) '(:r1))
				(vp-load-rrr :r1 :r0 :r2)
				(vp-store-rrr :r9 :r1 :r0)
				(vp-cpy-rr :r9 :r6)
				(vp-sub-rr :r2 :r6)
				(vpif '(:r6 > 0) '(:r6 <= 32768))
					(vp-cpy-rr :r8 :r3)
					(vp-sub-rr :r9 :r3)
					(vp-min-cr 258 :r3)
					(loop-start 'match)
						(vp-lea-rrr :r2 :r7 :r0)
						(vp-and-rr :r10 :r0)
						(vp-load-rrr-ub :r14 :r0 :r0)
						(vp-lea-rrr :r9 :r7 :r1)
						(vp-and-rr :r10 :r1)
						(vp-load-rrr-ub :r14 :r1 :r1)
						(breakif '(:r0 /= :r1) 'match)
						(vp-add-cr 1 :r7)
					(loop-until '(:r7 = :r3))
				(endif)
			(endif)
			(vpif '(:r7 >= 3))
				;a length, the last of the bases it is at least, and its extra bits
				(assign '((:rsp slot_lbase)) '(:r1))
				(vp-cpy-cr (* 28 +long_size) :r5)
				(loop-start)
					(vp-load-rrr :r1 :r5 :r0)
					(breakif '(:r0 <= :r7))
					(vp-sub-cr +long_size :r5)
				(loop-end)
				(load-fields :rsp '(slot_lcodes slot_llens) '(:r0 :r1))
				(vp-lea-rcr :r5 (* 257 +long_size) :r4)
				(vp-load-rrr :r0 :r4 :r0)
				(vp-load-rrr :r1 :r4 :r1)
				(deflate-put :r0 :r1)
				(load-fields :rsp '(slot_lbase slot_lext) '(:r0 :r1))
				(vp-load-rrr :r0 :r5 :r0)
				(vp-load-rrr :r1 :r5 :r1)
				(vp-cpy-rr :r7 :r3)
				(vp-sub-rr :r0 :r3)
				(deflate-put :r3 :r1)
				;a distance, the same
				(assign '((:rsp slot_dbase)) '(:r1))
				(vp-cpy-cr (* 29 +long_size) :r5)
				(loop-start)
					(vp-load-rrr :r1 :r5 :r0)
					(breakif '(:r0 <= :r6))
					(vp-sub-cr +long_size :r5)
				(loop-end)
				(load-fields :rsp '(slot_dcodes slot_dlens) '(:r0 :r1))
				(vp-load-rrr :r0 :r5 :r0)
				(vp-load-rrr :r1 :r5 :r1)
				(deflate-put :r0 :r1)
				(load-fields :rsp '(slot_dbase slot_dext) '(:r0 :r1))
				(vp-load-rrr :r0 :r5 :r0)
				(vp-load-rrr :r1 :r5 :r1)
				(vp-cpy-rr :r6 :r3)
				(vp-sub-rr :r0 :r3)
				(deflate-put :r3 :r1)
				(vp-add-rr :r7 :r9)
			(else)
				(vp-cpy-rr :r9 :r5)
				(vp-and-rr :r10 :r5)
				(vp-load-rrr-ub :r14 :r5 :r5)
				(vp-shl-cr 3 :r5)
				(load-fields :rsp '(slot_lcodes slot_llens) '(:r0 :r1))
				(vp-load-rrr :r0 :r5 :r0)
				(vp-load-rrr :r1 :r5 :r1)
				(deflate-put :r0 :r1)
				(vp-add-cr 1 :r9)
			(endif)
		(loop-until '(:r9 >= :r8))
	(endif)
	;the end of the block
	(load-fields :rsp '(slot_lcodes slot_llens) '(:r0 :r1))
	(assign `((:r0 ,(* 256 +long_size)) (:r1 ,(* 256 +long_size))) '(:r0 :r1))
	(deflate-put :r0 :r1)

	(assign '((:rsp slot_bitsp)) '(:r1))
	(save-fields :r1 (list 0 +long_size) '(:r12 :r13))
	(call :num :create '(:r8) '(:r1))
	(load-fields :rsp '(slot_this slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13) '(:r0 :r8 :r9 :r10 :r11 :r12 :r13))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(deflate-block ring pos chunk hash bits out last tables)" +error_msg_wrong_types))
	(signature '(:str :NUM :str :nums :array :stream :NUM :list))

(def-func-end)
