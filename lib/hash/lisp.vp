(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./crc32"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15
	;info
	;(crc32 data crc) -> crc, the CRC-32 of PNG, zip and gzip, the low bit
	;first, of the polynomial 0xEDB88320, crc what it was before data, 0 to
	;begin with

	(structure slot 0
		(ptr this))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:obj :num))
	;the constants of more than 31 bits in registers, an x64 instruction takes no more
	(assign '(0xffffffff 0xEDB88320 (:r0 +str_length)) '(:r6 :r14 :r2))
	(vp-add-cr +str_data :r0)
	(vp-add-rr :r0 :r2)
	(vp-and-rr :r6 :r1)
	(vp-xor-rr :r6 :r1)
	(vpif '(:r0 /= :r2))
		(loop-start)
			(vp-load-rcr-ub :r0 0 :r3)
			(vp-add-cr +byte_size :r0)
			(vp-xor-rr :r3 :r1)
			(vp-cpy-cr 8 :r4)
			(loop-start)
				(vp-cpy-rr :r1 :r5)
				(vp-shr-cr 1 :r1)
				(vp-and-cr 1 :r5)
				(vpif '(:r5 /= 0))
					(vp-xor-rr :r14 :r1)
				(endif)
				(vp-sub-cr 1 :r4)
			(loop-until '(:r4 = 0))
		(loop-until '(:r0 = :r2))
	(endif)
	(vp-xor-rr :r6 :r1)

	(call :num :create '(:r1) '(:r1))
	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(crc32 data crc)" +error_msg_wrong_types))
	(signature '(:str :NUM))


(def-func-end)

(def-func (path-to-absolute "./adler32"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15
	;info
	;(adler32 data adler) -> adler, the Adler-32 of zlib, adler what it was
	;before data, 1 to begin with. The sums are taken mod 65521 each 5552
	;bytes, the most that cannot pass 2^32 between

	(structure slot 0
		(ptr this))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:obj :num))
	;a and b from adler, the constant of more than 31 bits in a register
	(assign '(0xffffffff (:r0 +str_length)) '(:r6 :r2))
	(vp-add-cr +str_data :r0)
	(vp-add-rr :r0 :r2)
	(vp-and-rr :r6 :r1)
	(vp-cpy-rr :r1 :r3)
	(vp-shr-cr 16 :r3)
	(vp-and-cr 0xffff :r1)
	(assign '(65521) '(:r6))
	(vpif '(:r0 /= :r2))
		(loop-start)
			(vp-lea-rcr :r0 5552 :r4)
			(vp-min-rr :r2 :r4)
			(loop-start)
				(vp-load-rcr-ub :r0 0 :r5)
				(vp-add-cr +byte_size :r0)
				(vp-add-rr :r5 :r1)
				(vp-add-rr :r1 :r3)
			(loop-until '(:r0 = :r4))
			(vp-rem-rr-u :r6 :r1)
			(vp-rem-rr-u :r6 :r3)
		(loop-until '(:r0 = :r2))
	(endif)
	(vp-shl-cr 16 :r3)
	(vp-or-rr :r3 :r1)

	(call :num :create '(:r1) '(:r1))
	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(adler32 data adler)" +error_msg_wrong_types))
	(signature '(:str :NUM))

(def-func-end)
