(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "././asm/ops.inc")
(include "./trans_ops.inc")
(include "./trans.inc")

;A function's VP as text, the entry of a bundle in obj/vp/, to the records a
;translator works on, lib/trans/trans.inc: each translator calls it, and
;it needs no Lisp, the loader's translation of a function is one of bytes.
;Text may be from another node, so nothing is read past its end, and what
;is not of the VP text, docs/vm/vp_vm.md, A bundle of VP, it says so for.
;
;("name"
;((op operand ...)
;...)
;...)
;
;An operand is a register, :r0 to :r14 :rsp :d0 to :d15 :f0 to :f15, a name, a keyword
;that is not a register, a number, a string, a label, _0 _1 ..., quoted or
;not, or (- a b) of two labels or a label and *pc*. What is after the
;instructions, its locals and the like, is no translator's.
;
;Every part is in line, nothing is called once the text is begun, so what
;is not VP text goes to 'fail from anywhere with the stack as it came.
;
;:r14 the state, :r13 the end, :r12 where it is, :r11 the record, :r10 the
;operand, :r9 how many of them, :r8 how many labels, :r7 where strings go

;the ops by a hash of their names, each slot the op, the length of its name
;and where the name is in the names after them, a slot of length 0 empty
(defq +ph_size 512)

(defun ph-hash (s)
	;h * 33 + c, of which (p-op), and the table, use the low bits alone, the
	;same whatever the width it is worked out in
	(reduce (# (logand (+ (* %0 33) (code %1)) 0xffffffff)) s 0))

(defun ph-table ()
	(defq slots (map (lambda (_) :nil) (range 0 +ph_size)))
	(each (lambda (op)
			(defq name (str op) i (logand (ph-hash name) (dec +ph_size)))
			(while (elem-get slots i) (setq i (logand (inc i) (dec +ph_size))))
			(elem-set slots i (list (!) name)))
		+vp_emit_ops)
	slots)

(defun p-getc ()
	;the next char to :r0
	(gotoif '(:r12 >= :r13) 'fail)
	(vp-load-rcr-ub :r12 0 :r0)
	(vp-add-cr 1 :r12))

(defun p-expect (c)
	;the next char is c, trashes :r0
	(p-getc)
	(gotoif `(:r0 /= ,(ascii-code c)) 'fail))

(defun p-ws ()
	;past any white space, trashes :r0
	(vpif '(:r12 < :r13))
		(loop-start)
			(vp-load-rcr-ub :r12 0 :r0)
			(breakif `(:r0 > ,(ascii-code " ")))
			(vp-add-cr 1 :r12)
		(loop-until '(:r12 >= :r13))
	(endif))

(defun p-digits ()
	;a number of one or more digits to :r1, trashes :r0 :r2
	(vp-xor-rr :r1 :r1)
	(vp-cpy-rr :r12 :r2)
	(gotoif '(:r12 >= :r13) 'fail)
	(loop-start)
		(vp-load-rcr-ub :r12 0 :r0)
		(vp-sub-cr (ascii-code "0") :r0)
		(breakif '(:r0 < 0) '(:r0 > 9))
		(vp-mul-cr 10 :r1)
		(vp-add-rr :r0 :r1)
		(vp-add-cr 1 :r12)
	(loop-until '(:r12 >= :r13))
	(gotoif '(:r12 = :r2) 'fail))

(defun p-label ()
	;a label's number to :r1, below an instruction a (, and :r8 the most of
	;them, trashes :r0 :r2
	(p-digits)
	(assign '((:r14 +trs_ninsts)) '(:r0))
	(gotoif '(:r1 >= :r0) 'fail)
	(vp-lea-rcr :r1 1 :r0)
	(vpif '(:r0 > :r8))
		(vp-cpy-rr :r0 :r8)
	(endif))

(defun p-pc-or-label ()
	;*pc* or a label, to :r1, :r2 = 0 if a label else 1, trashes :r0
	(p-getc)
	(vpif `(:r0 = ,(ascii-code "_")))
		(p-label)
		(vp-xor-rr :r2 :r2)
	(else)
		(gotoif `(:r0 /= ,(ascii-code "*")) 'fail)
		(each p-expect '("p" "c" "*"))
		(vp-cpy-cr 1 :r2)
	(endif))

(defun p-set (kind a &optional b)
	;the operand's record, its value a register's by the CPU's map, else a,
	;but a label's, which the passes work out, and its instruction marked
	;as having one, trashes :r0 :r2 :r3
	(vp-cpy-cr kind :r0)
	(unless b (vp-xor-rr :r3 :r3) (setq b :r3))
	(cond
		((eql kind +trk_reg)
			(assign '((:r14 +trs_rmap)) '(:r2))
			(vp-load-rrr-ub :r2 a :r2)
			(save-fields :r10 '(+tro_kind +tro_a +tro_b +tro_v) `(:r0 ,a ,b :r2)))
		((find kind (list +trk_label +trk_label_pc +trk_label_diff +trk_pc_label))
			(save-fields :r10 '(+tro_kind +tro_a +tro_b) `(:r0 ,a ,b))
			(vp-cpy-cr 1 :r0)
			(assign '(:r0) '((:r11 +tri_lab))))
		(:t (save-fields :r10 '(+tro_kind +tro_a +tro_b +tro_v) `(:r0 ,a ,b ,a)))))

(defun p-op ()
	;an op's name, to its number in :r1, trashes :r0 :r2-:r6 :r9
	(vp-cpy-rr :r12 :r2)
	(vp-xor-rr :r3 :r3)
	(loop-start)
		(gotoif '(:r12 >= :r13) 'fail)
		(vp-load-rcr-ub :r12 0 :r0)
		(breakif `(:r0 = ,(ascii-code " ")) `(:r0 = ,(ascii-code ")")))
		(vp-mul-cr 33 :r3)
		(vp-add-rr :r0 :r3)
		(vp-add-cr 1 :r12)
	(loop-end)
	;:r2 = the name, :r4 = its length, the slots from where it hashes to
	(vp-cpy-rr :r12 :r4)
	(vp-sub-rr :r2 :r4)
	(vp-lea-pr 'op_hash :r5)
	(loop-start 'probe)
		(vp-and-cr (dec +ph_size) :r3)
		(vp-cpy-rr :r3 :r6)
		(vp-shl-cr 3 :r6)
		(vp-add-rr :r5 :r6)
		(vp-load-rcr-us :r6 2 :r0)
		(gotoif '(:r0 = 0) 'fail)
		(vpif '(:r0 = :r4))
			;the same name ?
			(vp-load-rcr-ui :r6 4 :r1)
			(vp-add-rr :r5 :r1)
			(vp-xor-rr :r0 :r0)
			(loop-start)
				(vp-load-rrr-ub :r1 :r0 :r6)
				(vp-load-rrr-ub :r2 :r0 :r9)
				(breakif '(:r6 /= :r9))
				(vp-add-cr 1 :r0)
			(loop-until '(:r0 = :r4))
			(breakif '(:r0 = :r4) 'probe)
		(endif)
		(vp-add-cr 1 :r3)
	(loop-end)
	(vp-shl-cr 3 :r3)
	(vp-add-rr :r5 :r3)
	(vp-load-rcr-us :r3 0 :r1))

(defun p-operand ()
	;an operand to its record at :r10, trashes :r0-:r6
	(gotoif '(:r12 >= :r13) 'fail)
	(vp-load-rcr-ub :r12 0 :r0)
	(vpif `(:r0 = ,(ascii-code ":")))
		;a register, else a name, the whole of it
		(vp-cpy-rr :r12 :r4)
		(loop-start)
			(vp-add-cr 1 :r12)
			(gotoif '(:r12 >= :r13) 'fail)
			(vp-load-rcr-ub :r12 0 :r0)
			(breakif `(:r0 = ,(ascii-code " ")) `(:r0 = ,(ascii-code ")")))
		(loop-end)
		(vp-cpy-rr :r12 :r5)
		(vp-sub-rr :r4 :r5)
		(vp-load-rcr-ub :r4 1 :r0)
		(vp-xor-rr :r6 :r6)
		(vpif `(:r0 = ,(ascii-code "r")))
			(vpif '(:r5 = 4))
				(vp-load-rcr-us :r4 2 :r1)
				(vpif `(:r1 = ,(+ (ascii-code "s") (<< (ascii-code "p") 8))))
					(vp-cpy-cr +rsp :r1)
					(vp-jmp 'p_reg)
				(endif)
			(endif)
			(vp-cpy-cr 15 :r6)
		(elseif `(:r0 = ,(ascii-code "d")))
			(vp-cpy-cr 16 :r6)
		(elseif `(:r0 = ,(ascii-code "f")))
			(vp-cpy-cr 16 :r6)
		(endif)
		;:r1 = the number after :r, :d or :f, of 1 or 2 digits and no 0 first of
		;2, below 15 of :r and 16 of :d and :f, a single the register of its
		;double
		(gotoif '(:r6 = 0) 'p_name)
		(vpif '(:r5 = 3))
			(vp-load-rcr-ub :r4 2 :r1)
			(vp-sub-cr (ascii-code "0") :r1)
			(gotoif '(:r1 < 0) 'p_name)
			(gotoif '(:r1 > 9) 'p_name)
		(elseif '(:r5 = 4))
			(vp-load-rcr-ub :r4 2 :r1)
			(vp-sub-cr (ascii-code "1") :r1)
			(gotoif '(:r1 < 0) 'p_name)
			(gotoif '(:r1 > 8) 'p_name)
			(vp-add-cr 1 :r1)
			(vp-load-rcr-ub :r4 3 :r0)
			(vp-sub-cr (ascii-code "0") :r0)
			(gotoif '(:r0 < 0) 'p_name)
			(gotoif '(:r0 > 9) 'p_name)
			(vp-mul-cr 10 :r1)
			(vp-add-rr :r0 :r1)
		(else)
			(vp-jmp 'p_name)
		(endif)
		(gotoif '(:r1 >= :r6) 'p_name)
		(vpif '(:r6 = 16))
			(vp-add-cr 16 :r1)
		(endif)
	(vp-label 'p_reg)
		(p-set +trk_reg :r1)
		(vp-jmp 'p_done)
	(vp-label 'p_name)
		(p-set +trk_name :r4 :r5)
	(elseif `(:r0 = ,(ascii-code "'")))
		(vp-add-cr 1 :r12)
		(p-expect "_")
		(p-label)
		(p-set +trk_label :r1)
	(elseif `(:r0 = ,(ascii-code "_")))
		(vp-add-cr 1 :r12)
		(p-label)
		(p-set +trk_label :r1)
	(elseif `(:r0 = ,(ascii-code "(")))
		;(- a b), of two labels, or a label and *pc*
		(vp-add-cr 1 :r12)
		(p-expect "-")
		(p-expect " ")
		(p-pc-or-label)
		(vp-cpy-rr :r1 :r4)
		(vp-cpy-rr :r2 :r5)
		(p-expect " ")
		(p-pc-or-label)
		(p-expect ")")
		;:r4 :r5 = the first, :r1 :r2 = the second
		(vpif '(:r5 = 0))
			(vpif '(:r2 = 0))
				(p-set +trk_label_diff :r4 :r1)
			(else)
				(p-set +trk_label_pc :r4)
			(endif)
		(else)
			(gotoif '(:r2 /= 0) 'fail)
			(p-set +trk_pc_label :r1)
		(endif)
	(elseif `(:r0 = ,(ascii-code "\q")))
		;a string, its escapes undone, to :r7
		(vp-add-cr 1 :r12)
		(vp-cpy-rr :r7 :r4)
		(loop-start)
			(p-getc)
			(breakif `(:r0 = ,(ascii-code "\q")))
			(vpif `(:r0 = ,(ascii-code "\\")))
				(p-getc)
				(vp-lea-pr 'esc_chars :r1)
				(vp-xor-rr :r2 :r2)
				(loop-start)
					(vp-load-rrr-ub :r1 :r2 :r3)
					(gotoif '(:r3 = 0) 'fail)
					(breakif '(:r3 = :r0))
					(vp-add-cr 1 :r2)
				(loop-end)
				(vp-lea-pr 'esc_codes :r1)
				(vp-load-rrr-ub :r1 :r2 :r0)
			(endif)
			(vp-store-rrc-b :r0 :r7 0)
			(vp-add-cr 1 :r7)
		(loop-end)
		(vp-cpy-rr :r7 :r5)
		(vp-sub-rr :r4 :r5)
		(p-set +trk_string :r4 :r5)
	(else)
		;a number, signed
		(vp-xor-rr :r4 :r4)
		(vpif `(:r0 = ,(ascii-code "-")))
			(vp-add-cr 1 :r12)
			(vp-cpy-cr 1 :r4)
		(endif)
		(p-digits)
		(vpif '(:r4 /= 0))
			(vp-mul-cr -1 :r1)
		(endif)
		(p-set +trk_num :r1)
	(endif)
(vp-label 'p_done))

(def-func (path-to-absolute "./vp_parse"))
	;inputs
	;:r0 = text (pubyte)
	;:r1 = text length (uint)
	;:r14 = translator state (ptr)
	;outputs
	;:r0 = 0 if parsed, else 1
	;trashes
	;:r0-:r13, :d0-:d15
	;info
	;its recs, ops, free, labels, prev, adj and strs made, for 'done of the
	;translator to free, and ninsts and nlabels of them

	(vp-cpy-rr :r0 :r12)
	(vp-cpy-rr :r0 :r13)
	(vp-add-rr :r1 :r13)

	;at most an instruction in 10 bytes, (ret), and an operand in 2, and
	;the most a prepass makes, 4 operands an instruction, and 3 past the last,
	;as a routine is given the values of 4. None of it is made 0 or looked at
	;here, what is read of it is written, the record past the last is 0
	(vp-cpy-rr :r1 :r2)
	(vp-cpy-cr 10 :r0)
	(vp-div-rr-u :r0 :r2)
	(vp-cpy-rr :r1 :r3)
	(vp-shr-cr 1 :r3)
	(vp-add-cr 1 :r2)
	(vp-push :r12 :r13 :r2 :r3)
	(vp-cpy-rr :r2 :r0)
	(vp-mul-cr +tri_size :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(assign '(:r0 (:rsp 0) (:rsp 8)) '((:r14 +trs_recs) :r3 :r2))
	(vp-shl-cr 2 :r2)
	(vp-add-rr :r2 :r3)
	(vp-add-cr 4 :r3)
	(vp-cpy-rr :r3 :r0)
	(vp-mul-cr +tro_size :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(assign '(:r0) '((:r14 +trs_ops)))
	(vp-load-rcr :rsp 8 :r0)
	(vp-shl-cr 3 :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(assign '(:r0 (:rsp 16) (:rsp 24)) '((:r14 +trs_adj) :r13 :r12))
	(vp-cpy-rr :r13 :r0)
	(vp-sub-rr :r12 :r0)
	(vp-add-cr 1 :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(assign '(:r0) '((:r14 +trs_strs)))
	(vp-pop :r12 :r13 :r2 :r3)
	(assign '(:r2) '((:r14 +trs_ninsts)))
	(load-fields :r14 '(+trs_recs +trs_ops +trs_strs) '(:r11 :r10 :r7))
	(vp-xor-rr :r8 :r8)

	;("name" (
	(p-ws)
	(p-expect "(")
	(p-expect "\q")
	(loop-start)
		(p-getc)
	(loop-until `(:r0 = ,(ascii-code "\q")))
	(p-ws)
	(p-expect "(")

	;each instruction
	(loop-start)
		(p-ws)
		(p-getc)
		(breakif `(:r0 = ,(ascii-code ")")))
		(gotoif `(:r0 /= ,(ascii-code "(")) 'fail)
		(p-op)
		(vp-xor-rr :r9 :r9)
		(save-fields :r11 '(+tri_op +tri_ops +tri_m +tri_lab) '(:r1 :r10 :r9 :r9))
		(loop-start)
			(p-getc)
			(breakif `(:r0 = ,(ascii-code ")")))
			(gotoif `(:r0 /= ,(ascii-code " ")) 'fail)
			(p-operand)
			(vp-add-cr +tro_size :r10)
			(vp-add-cr 1 :r9)
		(loop-end)
		(assign '(:r9) '((:r11 +tri_cnt)))
		(vp-add-cr +tri_size :r11)
	(loop-end)

	;how many, and the labels
	(vp-xor-rr :r0 :r0)
	(save-fields :r11 '(+tri_op +tri_cnt +tri_ops +tri_m +tri_lab) '(:r0 :r0 :r0 :r0 :r0))
	(assign '((:r14 +trs_recs)) '(:r0))
	(vp-sub-rr :r0 :r11)
	(vp-cpy-cr +tri_size :r0)
	(vp-div-rr-u :r0 :r11)
	(save-fields :r14 '(+trs_ninsts +trs_free +trs_nlabels +trs_oend) '(:r11 :r10 :r8 :r10))
	(vp-cpy-rr :r8 :r0)
	(vp-shl-cr 3 :r0)
	(vp-add-cr +long_size :r0)
	(vp-call 'alloc0)
	(assign '(:r0 (:r14 +trs_nlabels)) '((:r14 +trs_labels) :r0))
	(vp-shl-cr 3 :r0)
	(vp-add-cr +long_size :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(assign '(:r0) '((:r14 +trs_prev)))
	(vp-xor-rr :r0 :r0)
	(vp-ret)

(vp-label 'fail)
	(vp-cpy-cr 1 :r0)
	(vp-ret)

(vp-label 'alloc0)
	;:r0 = size, -> :r0 = a block of it all 0, trashes :r1-:r3
	(vp-push :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(vp-pop :r2)
	(vp-push :r0)
	(call :sys_mem :fill '(:r0 :r2 0) '(_))
	(vp-pop :r0)
	(vp-ret)

;the escapes a str prints with, class/str/class.vp, and what each is
(vp-label 'esc_chars)
	(vp-string "rfvntqb\\") (vp-byte 0)
(vp-label 'esc_codes)
	(vp-byte +char_cr +char_ff +char_vt +char_lf
		+char_tab +char_double_quote +char_backspace +char_backslash)

	(vp-align 8)
(vp-label 'op_hash)
	(defq slots (ph-table) at (* 8 +ph_size))
	(each (lambda (s)
			(cond
				(s (vp-short (first s) (length (second s))) (vp-int at)
					(setq at (+ at (length (second s)))))
				(:t (vp-short 0 0) (vp-int 0))))
		slots)
	(each (# (if %0 (vp-string (second %0)))) slots)

(def-func-end)
