;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; VP binary translators, what each CPU's has the same
;
; A translator is a .vp of lib/trans/ of one function: VP binary in,
; lib/trans/vpb.inc, native out. It calls (vpb-driver) first, then has a
; routine for each op it knows, given to (handler), then (vpb-helpers),
; (vpb-tables) and its own data, a reg_map of the VP's registers in its
; own numbers among them, and its prepass, the routine 'prepass.
;
; A routine of an op is called with :r0 :r1 :r2 :r3 its first operands'
; values, :r4 all of them, :r5 how many, :r6 the operands as decoded and
; :r7 its record, whose +vpbr_m is the most a branch has had to reach.
; It may trash :r0 to :r13, never :r14,
; the state, with +vpbt_pc where the output is and +vpbt_pass the pass.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(structure +vpbt 0
	(ptr buf labels prev recs ops args adj free)
	(long pc err nlabels ninsts pass pi pend pend_op nadj lim)
	(ptr next b1 d1 d2 fs)
	(long fj plim s0 s1 s2 s3))

;an instruction, and an operand of one
(structure +vpbr 0
	(long op cnt ops m))
(structure +vpbo 0
	(long kind a b))

(enums +vpbk 0
	(enum reg num label label_pc label_diff string name pc_label))

(defq +max_args 256
	+op_label (find 'emit-label +vpb_all_ops)
	+op_nop (find 'emit-nop +vpb_all_ops)
	+op_cpy_rr (find 'emit-cpy-rr +vpb_all_ops)
	+op_lea_i (find 'emit-lea-i +vpb_all_ops)
	+rsp 15
	*vpb_handlers* (list))

(defun handler (op label)
	;the routine of an op, in the table the passes go by
	(push *vpb_handlers* (list op label)))

(defun vpb-emit (label &rest parts)
	;the parts added up, to the output by the routine of label, emit8 to
	;emit64: a part is a number, or (reg shift [mask]), (<< (logand reg mask)
	;shift), a shift below 0 a shr. :r12 and :r13 are used, a reg is not them
	(defq k 0 fields (list))
	(each (# (if (num? %0) (setq k (+ k %0)) (push fields %0))) parts)
	(vp-cpy-cr k :r13)
	(each (lambda (f)
			(defq r (first f) s (second f) m (if (> (length f) 2) (third f)))
			(vp-cpy-rr r :r12)
			(if m (vp-and-cr m :r12))
			(cond ((> s 0) (vp-shl-cr s :r12)) ((< s 0) (vp-shr-cr (neg s) :r12)))
			(vp-add-rr :r12 :r13))
		fields)
	(vp-call label))

(defun range? (r lo hi l)
	;goto l if r is not lo to hi
	(vpif `(,r < ,lo)) (vp-jmp l) (endif)
	(vpif `(,r > ,hi)) (vp-jmp l) (endif))

(defun vpb-driver ()
	;the entry, the decode, the passes and the output, and the data
	(setq *vpb_handlers* (list))
		(entry '(:r0 :r1))
		(errorif-lisp-args-sig 'error :r1 1)
		(list-bind-args :r1 '(:r2) '(:obj))
		(vp-push :r0)
		(assign '((:r2 +str_length)) '(:r1))
		(vp-lea-i :r2 +str_data :r0)
		(vp-call 'translate)
		;:r0 = 0 else str
		(vpif '(:r0 = 0))
			(vp-pop :r0)
			(assign '((:r0 +lisp_sym_nil)) '(:r1))
			(class/obj/ref :r1 :r2)
		(else)
			(vp-cpy-rr :r0 :r1)
			(vp-pop :r0)
		(endif)
		(exit '(:r0 :r1))
		(vp-ret)

	;;;;;;;;;;;;;;;;;;;;;;
	; decode and the passes
	;;;;;;;;;;;;;;;;;;;;;;

	(vp-label 'rd_uint)
		;:r0 = at, -> :r0 = past, :r1 = the number, trashes :r2-:r4
		(vp-xor-rr :r1 :r1)
		(vp-xor-rr :r3 :r3)
		(loop-start)
			(vp-cpy-ir-ub :r0 0 :r2)
			(vp-add-cr 1 :r0)
			(vp-cpy-rr :r2 :r4)
			(vp-and-cr 0x7f :r4)
			(vp-shl-rr :r3 :r4)
			(vp-or-rr :r4 :r1)
			(vp-add-cr 7 :r3)
		(loop-until '(:r2 < 0x80))
		(vp-ret)

	(vp-label 'alloc0)
		;:r0 = size, -> :r0 = a block of it all 0, trashes :r1-:r3
		(vp-push :r0)
		(call :sys_mem :alloc '(:r0) '(:r0 _))
		(vp-pop :r2)
		(vp-push :r0)
		(call :sys_mem :fill '(:r0 :r2 0) '(_))
		(vp-pop :r0)
		(vp-ret)

	(vp-label 'alloc1)
		;:r0 = size, -> :r0 = a block of it as it comes, trashes :r1-:r2
		(call :sys_mem :alloc '(:r0) '(:r0 _))
		(vp-ret)

	(vp-label 'translate)
		;:r0 = data, :r1 = length, -> :r0 = 0 else the str of the native
		(vp-push :r14 :r0 :r1)
		(vp-cpy-cr +vpbt_size :r0)
		(vp-call 'alloc0)
		(vp-cpy-rr :r0 :r14)
		;the buffer, room for all an instruction can make
		(vp-cpy-ir :rsp 0 :r0)
		(vp-shl-cr 5 :r0)
		(vp-add-cr 65536 :r0)
		(vp-call 'alloc1)
		(assign '(:r0) '((:r14 +vpbt_buf)))
		(vp-cpy-cr (* +max_args +long_size) :r0)
		(vp-call 'alloc1)
		(assign '(:r0) '((:r14 +vpbt_args)))
		;the name, passed over
		(vp-cpy-ir :rsp +ptr_size :r0)
		(vp-call 'rd_uint)
		(vp-add-rr :r1 :r0)
		(vp-call 'rd_uint)
		(assign '(:r1) '((:r14 +vpbt_nlabels)))
		(vp-call 'rd_uint)
		(assign '(:r1) '((:r14 +vpbt_ninsts)))
		(vp-cpy-ri :r0 :rsp +ptr_size)
		(assign '((:r14 +vpbt_nlabels)) '(:r0))
		(vp-shl-cr 3 :r0)
		(vp-add-cr +long_size :r0)
		(vp-call 'alloc0)
		(assign '(:r0) '((:r14 +vpbt_labels)))
		(assign '((:r14 +vpbt_nlabels)) '(:r0))
		(vp-shl-cr 3 :r0)
		(vp-add-cr +long_size :r0)
		(vp-call 'alloc1)
		(assign '(:r0) '((:r14 +vpbt_prev)))
		(assign '((:r14 +vpbt_ninsts)) '(:r0))
		(vp-mul-cr +vpbr_size :r0)
		(vp-add-cr +vpbr_size :r0)
		(vp-call 'alloc0)
		(assign '(:r0) '((:r14 +vpbt_recs)))
		;an operand is two bytes at the least, and the prepass makes 4 at most
		;an instruction
		(vp-cpy-ir :rsp 0 :r0)
		(vp-mul-cr (/ +vpbo_size 2) :r0)
		(assign '((:r14 +vpbt_ninsts)) '(:r1))
		(vp-mul-cr (* 4 +vpbo_size) :r1)
		(vp-add-rr :r1 :r0)
		(vp-add-cr +vpbo_size :r0)
		(vp-call 'alloc0)
		(assign '(:r0) '((:r14 +vpbt_ops)))
		(assign '((:r14 +vpbt_ninsts)) '(:r0))
		(vp-shl-cr 3 :r0)
		(vp-add-cr +long_size :r0)
		(vp-call 'alloc1)
		(assign '(:r0) '((:r14 +vpbt_adj)))

		;each instruction to a record, each operand to one
		(vp-cpy-ir :rsp +ptr_size :r0)
		(assign '((:r14 +vpbt_recs) (:r14 +vpbt_ops)) '(:r8 :r9))
		(assign '((:r14 +vpbt_ninsts)) '(:r10))
		(vpif '(:r10 /= 0))
		(loop-start)
			(vp-cpy-ir-ub :r0 0 :r1)
			(vp-add-cr 1 :r0)
			(assign '(:r1) '((:r8 +vpbr_op)))
			(vp-call 'rd_uint)
			(assign '(:r1 :r9) '((:r8 +vpbr_cnt) (:r8 +vpbr_ops)))
			(vp-cpy-rr :r1 :r7)
			(vpif '(:r7 /= 0))
			(loop-start)
				(vp-cpy-ir-ub :r0 0 :r5)
				(vp-add-cr 1 :r0)
				(assign '(:r5) '((:r9 +vpbo_kind)))
				(vpif '(:r5 = +vpbk_reg))
					(vp-cpy-ir-ub :r0 0 :r1)
					(vp-add-cr 1 :r0)
				(elseif '(:r5 = +vpbk_num))
					(vp-call 'rd_uint)
					(vp-cpy-rr :r1 :r2)
					(vp-shr-cr 1 :r1)
					(vp-and-cr 1 :r2)
					(vp-mul-cr -1 :r2)
					(vp-xor-rr :r2 :r1)
				(elseif '(:r5 = +vpbk_label_diff))
					(vp-call 'rd_uint)
					(vp-push :r1)
					(vp-call 'rd_uint)
					(assign '(:r1) '((:r9 +vpbo_b)))
					(vp-pop :r1)
				(elseif '(:r5 = +vpbk_string))
					(vp-call 'rd_uint)
					(assign '(:r1) '((:r9 +vpbo_b)))
					(vp-cpy-rr :r0 :r2)
					(vp-add-rr :r1 :r0)
					(vp-cpy-rr :r2 :r1)
				(elseif '(:r5 = +vpbk_name))
					(vp-call 'rd_uint)
					(assign '(:r1) '((:r9 +vpbo_b)))
					(vp-cpy-rr :r0 :r2)
					(vp-add-rr :r1 :r0)
					(vp-cpy-rr :r2 :r1)
				(else)
					(vp-call 'rd_uint)
				(endif)
				(assign '(:r1) '((:r9 +vpbo_a)))
				(vp-add-cr +vpbo_size :r9)
				(vp-sub-cr 1 :r7)
			(loop-until '(:r7 = 0))
			(endif)
			(vp-add-cr +vpbr_size :r8)
			(vp-sub-cr 1 :r10)
		(loop-until '(:r10 = 0))
		(endif)
		(assign '(:r9) '((:r14 +vpbt_free)))

		(vp-call 'prepass)
		(assign '((:r14 +vpbt_err)) '(:r0))
		(vpif '(:r0 /= 0))
			(vp-jmp 'fail)
		(endif)

		;the passes, till the labels are where they were the pass before
		(loop-start)
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:r14 +vpbt_pc)))
			(assign '((:r14 +vpbt_recs) (:r14 +vpbt_ninsts)) '(:r8 :r10))
			(vpif '(:r10 /= 0))
			(loop-start)
				(vp-push :r8 :r10)
				(assign '((:r8 +vpbr_op) (:r8 +vpbr_cnt) (:r8 +vpbr_ops)) '(:r7 :r5 :r6))
				(vpif `(:r7 = ,+op_label))
					(assign '((:r6 +vpbo_a) (:r14 +vpbt_labels) (:r14 +vpbt_pc)) '(:r0 :r1 :r2))
					(vp-shl-cr 3 :r0)
					(vp-cpy-rd :r2 :r1 :r0)
				(else)
					;each operand's value, as of the pc where it starts
					(vpif `(:r5 > ,+max_args))
						(vp-jmp 'fail_pop)
					(endif)
					(assign '((:r14 +vpbt_args) (:r14 +vpbt_labels) (:r14 +vpbt_pc)) '(:r4 :r9 :r10))
					(vp-cpy-rr :r6 :r0)
					(vp-cpy-rr :r4 :r1)
					(vp-cpy-rr :r5 :r2)
					(vpif '(:r2 /= 0))
					(loop-start)
						(assign '((:r0 +vpbo_kind) (:r0 +vpbo_a)) '(:r3 :r11))
						(vpif '(:r3 = +vpbk_reg))
							(vp-lea-p 'reg_map :r12)
							(vp-cpy-dr-ub :r12 :r11 :r11)
						(elseif '(:r3 = +vpbk_label))
							(vp-shl-cr 3 :r11)
							(vp-cpy-dr :r9 :r11 :r11)
						(elseif '(:r3 = +vpbk_label_pc))
							(vp-shl-cr 3 :r11)
							(vp-cpy-dr :r9 :r11 :r11)
							(vp-sub-rr :r10 :r11)
						(elseif '(:r3 = +vpbk_pc_label))
							(vp-shl-cr 3 :r11)
							(vp-cpy-dr :r9 :r11 :r11)
							(vp-sub-rr :r10 :r11)
							(vp-mul-cr -1 :r11)
						(elseif '(:r3 = +vpbk_label_diff))
							(vp-shl-cr 3 :r11)
							(vp-cpy-dr :r9 :r11 :r11)
							(assign '((:r0 +vpbo_b)) '(:r12))
							(vp-shl-cr 3 :r12)
							(vp-cpy-dr :r9 :r12 :r12)
							(vp-sub-rr :r12 :r11)
						(endif)
						(vp-cpy-ri :r11 :r1 0)
						(vp-add-cr +vpbo_size :r0)
						(vp-add-cr +long_size :r1)
						(vp-sub-cr 1 :r2)
					(loop-until '(:r2 = 0))
					(endif)
					(assign '((:r4 0) (:r4 8) (:r4 16) (:r4 24)) '(:r0 :r1 :r2 :r3))
					(vp-lea-p 'op_table :r9)
					(vp-cpy-rr :r7 :r10)
					(vp-shl-cr 3 :r10)
					(vp-cpy-dr :r9 :r10 :r10)
					(vp-add-rr :r9 :r10)
					(vp-cpy-rr :r8 :r7)
					(vp-call-r :r10)
					(assign '((:r14 +vpbt_err)) '(:r0))
					(vpif '(:r0 /= 0))
						(vp-jmp 'fail_pop)
					(endif)
				(endif)
				(vp-pop :r8 :r10)
				(vp-add-cr +vpbr_size :r8)
				(vp-sub-cr 1 :r10)
			(loop-until '(:r10 = 0))
			(endif)
			;the labels as the pass before had them ?
			(assign '((:r14 +vpbt_labels) (:r14 +vpbt_prev) (:r14 +vpbt_nlabels)) '(:r0 :r1 :r2))
			(vp-cpy-cr 1 :r3)
			(vpif '(:r2 /= 0))
			(loop-start)
				(vp-cpy-ir :r0 0 :r4)
				(vp-cpy-ir :r1 0 :r5)
				(vpif '(:r4 /= :r5))
					(vp-xor-rr :r3 :r3)
				(endif)
				(vp-cpy-ri :r4 :r1 0)
				(vp-add-cr +long_size :r0)
				(vp-add-cr +long_size :r1)
				(vp-sub-cr 1 :r2)
			(loop-until '(:r2 = 0))
			(endif)
			(assign '((:r14 +vpbt_pass)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:r14 +vpbt_pass)))
			(vpif '(:r0 > 1000))
				(vp-jmp 'fail)
			(endif)
			(vpif '(:r0 < 2))
				(vp-xor-rr :r3 :r3)
			(endif)
		(loop-until '(:r3 /= 0))

		;the native, a str of it
		(assign '((:r14 +vpbt_pc)) '(:r1))
		(call :str :create_from_buffer '(0 :r1) '(:r0))
		(vp-push :r0)
		(vp-lea-i :r0 +str_data :r1)
		(assign '((:r14 +vpbt_buf) (:r14 +vpbt_pc)) '(:r0 :r2))
		(call :sys_mem :copy '(:r0 :r1 :r2) '(_ _))
		(vp-pop :r0)
		(vp-jmp 'done)

	(vp-label 'fail_pop)
		(vp-pop :r8 :r10)
	(vp-label 'fail)
		(vp-xor-rr :r0 :r0)
	(vp-label 'done)
		;all let go of, but the str
		(vp-push :r0)
		(assign '((:r14 +vpbt_buf)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +vpbt_args)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +vpbt_labels)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +vpbt_prev)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +vpbt_recs)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +vpbt_ops)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +vpbt_adj)) '(:r0))
		(call :sys_mem :free '(:r0))
		(call :sys_mem :free '(:r14))
		(vp-pop :r0)
		(vp-free (* 2 +ptr_size))
		(vp-pop :r14)
		(vp-ret)

	;;;;;;;;;;;;;;;;;;;;;;;;;
	; output, and what is not
	;;;;;;;;;;;;;;;;;;;;;;;;;

	(vp-label 'emit32)
		;:r13 = int, trashes :r11 :r12
		(assign '((:r14 +vpbt_buf) (:r14 +vpbt_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-cpy-ri-i :r13 :r11 0)
		(vp-add-cr 4 :r12)
		(assign '(:r12) '((:r14 +vpbt_pc)))
		(vp-ret)

	(vp-label 'emit8)
		;:r13 = byte, trashes :r11 :r12
		(assign '((:r14 +vpbt_buf) (:r14 +vpbt_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-cpy-ri-b :r13 :r11 0)
		(vp-add-cr 1 :r12)
		(assign '(:r12) '((:r14 +vpbt_pc)))
		(vp-ret)

	(vp-label 'emit16)
		(assign '((:r14 +vpbt_buf) (:r14 +vpbt_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-cpy-ri-s :r13 :r11 0)
		(vp-add-cr 2 :r12)
		(assign '(:r12) '((:r14 +vpbt_pc)))
		(vp-ret)

	(vp-label 'emit64)
		(assign '((:r14 +vpbt_buf) (:r14 +vpbt_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-cpy-ri :r13 :r11 0)
		(vp-add-cr 8 :r12)
		(assign '(:r12) '((:r14 +vpbt_pc)))
		(vp-ret)

	(vp-label 'h_none)
		;an op this has no routine for, or a range it can not reach
		(vp-cpy-cr 1 :r0)
		(assign '(:r0) '((:r14 +vpbt_err)))
		(vp-ret)

	(vp-label 'h_nop)
		(vp-ret)
	(handler 'emit-nop 'h_nop)
	(handler 'emit-trash 'h_nop)

	;;;;;;;;;;;;;;;;;;
	; data and padding
	;;;;;;;;;;;;;;;;;;

	(each (lambda ((op label emit))
			(vp-label label)
			;:r4 = the values, :r5 = how many
			(vpif '(:r5 /= 0))
			(loop-start)
				(vp-cpy-ir :r4 0 :r13)
				(vp-call emit)
				(vp-add-cr +long_size :r4)
				(vp-sub-cr 1 :r5)
			(loop-until '(:r5 = 0))
			(endif)
			(vp-ret)
			(handler op label))
		'((emit-byte h_byte emit8) (emit-short h_short emit16)
		(emit-int h_int emit32) (emit-long h_long emit64)))

	(vp-label 'h_string)
		;:r6 = the operand, its bytes and how many
		(assign '((:r6 +vpbo_a) (:r6 +vpbo_b)) '(:r4 :r5))
		(vpif '(:r5 /= 0))
		(loop-start)
			(vp-cpy-ir-ub :r4 0 :r13)
			(vp-call 'emit8)
			(vp-add-cr 1 :r4)
			(vp-sub-cr 1 :r5)
		(loop-until '(:r5 = 0))
		(endif)
		(vp-ret)
	(handler 'emit-string 'h_string)

	(vp-label 'h_align)
		;:r0 = size, :r1 = fill if given, the pc made a whole number of size
		(vpif '(:r5 < 2))
			(vp-xor-rr :r1 :r1)
		(endif)
		(assign '((:r14 +vpbt_pc)) '(:r2))
		(vp-cpy-rr :r2 :r3)
		(vp-add-rr :r0 :r3)
		(vp-sub-cr 1 :r3)
		(vp-mul-cr -1 :r0)
		(vp-and-rr :r0 :r3)
		(vp-cpy-rr :r1 :r13)
		(loop-while '(:r2 < :r3))
			(vp-call 'emit8)
			(vp-add-cr 1 :r2)
		(loop-end)
		(vp-ret)
	(handler 'emit-align 'h_align)

)

(defun vpb-helpers ()
	;the operands, as the prepasses look at them
	(vp-label 'rec_of)
		;:r0 = i -> :r0 = its record, trashes :r1
		(vp-mul-cr +vpbr_size :r0)
		(assign '((:r14 +vpbt_recs)) '(:r1))
		(vp-add-rr :r1 :r0)
		(vp-ret)

	(vp-label 'is_rsp)
		;:r0 = operand -> :r1 = 1 if :rsp, trashes :r2
		(vp-xor-rr :r1 :r1)
		(assign '((:r0 +vpbo_kind)) '(:r2))
		(vpif '(:r2 = +vpbk_reg))
			(assign '((:r0 +vpbo_a)) '(:r2))
			(vpif `(:r2 = ,+rsp))
				(vp-cpy-cr 1 :r1)
			(endif)
		(endif)
		(vp-ret)

	(vp-label 'opeq)
		;:r0 :r1 = operands -> :r2 = 1 if the same, trashes :r3 :r4
		(vp-xor-rr :r2 :r2)
		(assign '((:r0 +vpbo_kind) (:r1 +vpbo_kind)) '(:r3 :r4))
		(vpif '(:r3 = :r4))
			(assign '((:r0 +vpbo_a) (:r1 +vpbo_a)) '(:r3 :r4))
			(vpif '(:r3 = :r4))
				(assign '((:r0 +vpbo_b) (:r1 +vpbo_b)) '(:r3 :r4))
				(vpif '(:r3 = :r4))
					(vp-cpy-cr 1 :r2)
				(endif)
			(endif)
		(endif)
		(vp-ret)

	(vp-label 'count_rsp)
		;:r0 = record -> :r1 = how many of its operands are :rsp, trashes :r2-:r5
		(assign '((:r0 +vpbr_cnt) (:r0 +vpbr_ops)) '(:r3 :r4))
		(vp-xor-rr :r5 :r5)
		(loop-while '(:r3 /= 0))
			(assign '((:r4 +vpbo_kind) (:r4 +vpbo_a)) '(:r1 :r2))
			(vpif '(:r1 = +vpbk_reg))
				(vpif `(:r2 = ,+rsp))
					(vp-add-cr 1 :r5)
				(endif)
			(endif)
			(vp-add-cr +vpbo_size :r4)
			(vp-sub-cr 1 :r3)
		(loop-end)
		(vp-cpy-rr :r5 :r1)
		(vp-ret)

	(vp-label 'any_eq)
		;:r0 = record, :r1 = operand -> :r2 = 1 if an operand of it is that,
		;trashes :r3-:r7
		(assign '((:r0 +vpbr_cnt) (:r0 +vpbr_ops)) '(:r5 :r6))
		(vp-cpy-rr :r1 :r7)
		(loop-while '(:r5 /= 0))
			(vp-cpy-rr :r6 :r0)
			(vp-cpy-rr :r7 :r1)
			(vp-call 'opeq)
			(vpif '(:r2 /= 0))
				(vp-ret)
			(endif)
			(vp-add-cr +vpbo_size :r6)
			(vp-sub-cr 1 :r5)
		(loop-end)
		(vp-xor-rr :r2 :r2)
		(vp-ret)

	(vp-label 'new_ops)
		;:r0 = how many -> :r0 = that many operands, all 0, trashes :r1
		(assign '((:r14 +vpbt_free)) '(:r1))
		(vp-mul-cr +vpbo_size :r0)
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:r14 +vpbt_free)))
		(vp-cpy-rr :r1 :r0)
		(vp-ret)

	(vp-label 'cpy_op)
		;:r0 = from, :r1 = to, trashes :r2
		(assign '((:r0 +vpbo_kind)) '(:r2))
		(assign '(:r2) '((:r1 +vpbo_kind)))
		(assign '((:r0 +vpbo_a)) '(:r2))
		(assign '(:r2) '((:r1 +vpbo_a)))
		(assign '((:r0 +vpbo_b)) '(:r2))
		(assign '(:r2) '((:r1 +vpbo_b)))
		(vp-ret)

	(vp-label 'num_op)
		;:r0 = value, :r1 = operand to make a number of it
		(assign '(:r0) '((:r1 +vpbo_a)))
		(vp-cpy-cr +vpbk_num :r0)
		(assign '(:r0) '((:r1 +vpbo_kind)))
		(vp-ret)

)

(defun vpb-tables (name)
	;the error of the entry, and the routine of each op
	;the error's signature is data, so after all the code
	(errorcase
	(vp-label 'error)
		(jump :lisp :repl_error `(:r1 ,name +error_msg_wrong_types))
		(signature '(:str)))


		(vp-align +long_size)
	(vp-label 'op_table)
		(each (lambda (op)
				(defq h (some (# (if (eql (first %0) op) (second %0))) *vpb_handlers*))
				(vp-long `(- ,(label-sym (ifn h 'h_none)) ,(label-sym 'op_table))))
			+vpb_all_ops)
)

;;;;;;;;;;;;;;
; call fusion
;;;;;;;;;;;;;;

(defun vpb-call-fusion ()
	;the call fusion prepass, of a CPU with a link register: one call
	;after another in a straight line, the link left on the stack between
	;them, :rsp relative access between a slot deeper. Instructions 8 to
	;the last. Its tables are
	;(vpb-call-fusion-tables cpu)
(vp-label 'prepass)
	(assign '((:r14 +vpbt_ninsts)) '(:r0))
	(assign '(:r0) '((:r14 +vpbt_lim)))
	(vp-cpy-cr 8 :r0)
	(assign '(:r0) '((:r14 +vpbt_pi)))
	(vp-cpy-cr -1 :r0)
	(assign '(:r0) '((:r14 +vpbt_pend)))
	(vp-xor-rr :r0 :r0)
	(assign '(:r0) '((:r14 +vpbt_nadj)))
	(loop-start)
		(assign '((:r14 +vpbt_pi) (:r14 +vpbt_lim)) '(:r0 :r1))
		(breakif '(:r0 >= :r1))
		(vp-call 'cf_one)
		(assign '((:r14 +vpbt_err)) '(:r0))
		(breakif '(:r0 /= 0))
		(assign '((:r14 +vpbt_pi)) '(:r0))
		(vp-add-cr 1 :r0)
		(assign '(:r0) '((:r14 +vpbt_pi)))
	(loop-end)
	(vp-ret)

(vp-label 'cf_load)
	;:r8 = the record at pi, :r7 = its op, :r6 = its cf_tab entry, :r5 = its tag
	(assign '((:r14 +vpbt_pi)) '(:r0))
	(vp-call 'rec_of)
	(vp-cpy-rr :r0 :r8)
	(assign '((:r8 +vpbr_op)) '(:r7))
	(vp-lea-p 'cf_tab :r6)
	(vp-cpy-rr :r7 :r0)
	(vp-shl-cr 2 :r0)
	(vp-add-rr :r0 :r6)
	(vp-cpy-ir-ub :r6 0 :r5)
	(vp-ret)

(vp-label 'cf_one)
	(vp-call 'cf_load)
	(vpif '(:r5 = 0))
		;straight line, an :rsp after a call that may fuse noted, or the fuse lost
		(assign '((:r14 +vpbt_pend)) '(:r0))
		(vpif '(:r0 >= 0))
			(vp-cpy-rr :r8 :r0)
			(vp-call 'count_rsp)
			(vpif '(:r1 /= 0))
				(vp-cpy-rr :r8 :r0)
				(vp-xor-rr :r1 :r1)
				(vp-call 'cf_sp_adjust)
				(vpif '(:r1 = 0))
					(vp-cpy-cr -1 :r0)
					(assign '(:r0) '((:r14 +vpbt_pend)))
				(else)
					(assign '((:r14 +vpbt_adj) (:r14 +vpbt_nadj) (:r14 +vpbt_pi)) '(:r0 :r1 :r2))
					(vp-cpy-rr :r1 :r3)
					(vp-shl-cr 3 :r3)
					(vp-cpy-rd :r2 :r0 :r3)
					(vp-add-cr 1 :r1)
					(assign '(:r1) '((:r14 +vpbt_nadj)))
				(endif)
			(endif)
		(endif)
		(vp-ret)
	(endif)
	(vpif '(:r5 = 1))
		(vp-cpy-cr -1 :r0)
		(assign '(:r0) '((:r14 +vpbt_pend)))
		(vp-ret)
	(endif)
	;a call, not one that uses :rsp
	(vp-cpy-rr :r8 :r0)
	(vp-call 'count_rsp)
	(vpif '(:r1 /= 0))
		(vp-cpy-cr -1 :r0)
		(assign '(:r0) '((:r14 +vpbt_pend)))
		(vp-ret)
	(endif)
	(vp-call 'cf_load)
	(assign '((:r14 +vpbt_pend)) '(:r0))
	(vpif '(:r0 >= 0))
		;the call pending keeps the link on the stack, this one restores it
		(vp-call 'rec_of)
		(assign '((:r14 +vpbt_pend_op)) '(:r1))
		(vp-lea-p 'cf_tab :r2)
		(vp-shl-cr 2 :r1)
		(vp-add-rr :r1 :r2)
		(vp-cpy-ir-ub :r2 1 :r1)
		(assign '(:r1) '((:r0 +vpbr_op)))
		(vp-cpy-ir-ub :r6 2 :r1)
		(assign '(:r1) '((:r8 +vpbr_op)))
		(loop-start)
			(assign '((:r14 +vpbt_nadj)) '(:r0))
			(breakif '(:r0 = 0))
			(vp-sub-cr 1 :r0)
			(assign '(:r0) '((:r14 +vpbt_nadj)))
			(assign '((:r14 +vpbt_adj)) '(:r1))
			(vp-shl-cr 3 :r0)
			(vp-cpy-dr :r1 :r0 :r0)
			(vp-call 'rec_of)
			(vp-cpy-cr 1 :r1)
			(vp-call 'cf_sp_adjust)
			(vpif '(:r1 = 0))
				(vp-cpy-cr 1 :r0)
				(assign '(:r0) '((:r14 +vpbt_err)))
			(endif)
		(loop-end)
		(vp-call 'cf_load)
	(else)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:r14 +vpbt_nadj)))
	(endif)
	(assign '((:r14 +vpbt_pi)) '(:r0))
	(assign '(:r0 :r7) '((:r14 +vpbt_pend) (:r14 +vpbt_pend_op)))
	(vp-ret)

(vp-label 'cf_sp_adjust)
	;trans-sp-adjust, :r0 = record, :r1 = 0 to ask, 1 to do -> :r1 = 1 if it
	;can be, the stack a slot deeper, trashes :r0-:r9
	(vp-cpy-rr :r0 :r8)
	(vp-cpy-rr :r1 :r9)
	(vp-call 'count_rsp)
	(vpif '(:r1 /= 1))
		(vp-xor-rr :r1 :r1)
		(vp-ret)
	(endif)
	(assign '((:r8 +vpbr_op)) '(:r0))
	(vp-lea-p 'cf_sp :r1)
	(vp-shl-cr 1 :r0)
	(vp-add-rr :r0 :r1)
	(vp-cpy-ir-ub :r1 0 :r2)
	(vp-cpy-ir-ub :r1 1 :r3)
	(assign '((:r8 +vpbr_ops)) '(:r4))
	(vpif '(:r2 = 0xff))
		(vp-xor-rr :r1 :r1)
		(vp-ret)
	(endif)
	(vpif '(:r2 = 0xfe))
		;a copy from :rsp, the address of the slot
		(vp-cpy-rr :r4 :r0)
		(vp-call 'is_rsp)
		(vpif '(:r1 /= 0))
			(vpif '(:r9 /= 0))
				(vp-cpy-cr 3 :r0)
				(vp-call 'new_ops)
				(vp-cpy-rr :r0 :r5)
				(vp-cpy-rr :r4 :r0)
				(vp-cpy-rr :r5 :r1)
				(vp-call 'cpy_op)
				(vp-cpy-cr +ptr_size :r0)
				(vp-lea-i :r5 +vpbo_size :r1)
				(vp-call 'num_op)
				(vp-lea-i :r4 +vpbo_size :r0)
				(vp-lea-i :r5 (* 2 +vpbo_size) :r1)
				(vp-call 'cpy_op)
				(vp-cpy-cr +op_lea_i :r0)
				(vp-cpy-cr 3 :r1)
				(assign '(:r0 :r1 :r5) '((:r8 +vpbr_op) (:r8 +vpbr_cnt) (:r8 +vpbr_ops)))
			(endif)
			(vp-cpy-cr 1 :r1)
		(endif)
		(vp-ret)
	(endif)
	;the base :rsp and the offset a number
	(vp-cpy-rr :r2 :r0)
	(vp-mul-cr +vpbo_size :r0)
	(vp-add-rr :r4 :r0)
	(vp-call 'is_rsp)
	(vpif '(:r1 = 0))
		(vp-ret)
	(endif)
	(vp-cpy-rr :r3 :r0)
	(vp-mul-cr +vpbo_size :r0)
	(vp-add-rr :r4 :r0)
	(assign '((:r0 +vpbo_kind)) '(:r2))
	(vpif '(:r2 /= +vpbk_num))
		(vp-xor-rr :r1 :r1)
		(vp-ret)
	(endif)
	(vpif '(:r9 /= 0))
		(assign '((:r0 +vpbo_a)) '(:r2))
		(vp-add-cr +ptr_size :r2)
		(assign '(:r2) '((:r0 +vpbo_a)))
	(endif)
	(vp-cpy-cr 1 :r1)
	(vp-ret))

(defun vpb-call-fusion-tables (cpu)
	;of each op, 4 bytes: 1 a barrier, 2 a call and the ops it becomes, the
	;first call of a pair and the last; then the :rsp access of each op
	(defq calls '(emit-call emit-call-r emit-call-i emit-call-p)
		named (lambda (v) (map (lambda (c) (sym (cat "emit-" cpu (slice c 4 -1) v))) calls))
		hs (named "-h") ms (named "-m") ts (named "-t")
		opi (lambda (o) (find o +vpb_all_ops)))
	(vp-align +long_size)
(vp-label 'cf_tab)
	(each (lambda (op)
			(defq i :nil)
			(apply (const vp-byte) (cond
				((setq i (find op calls)) (list 2 (opi (elem-get hs i)) (opi (elem-get ts i)) 0))
				((setq i (find op ts)) (list 2 (opi (elem-get ms i)) 0xff 0))
				((find op '(emit-label emit-alloc emit-free emit-push emit-pop emit-save-state
						emit-load-state emit-entry-abi emit-call-abi emit-jmp emit-jmp-r emit-jmp-i
						emit-jmp-p emit-ret emit-sync emit-beq-cr emit-bne-cr emit-bge-cr emit-ble-cr
						emit-blt-cr emit-bgt-cr emit-beq-rr emit-bne-rr emit-bge-rr emit-ble-rr
						emit-blt-rr emit-bgt-rr emit-beq-ff emit-bne-ff emit-bge-ff emit-blt-ff
						emit-ble-ff emit-bgt-ff))
					'(1 0 0 0))
				('(0 0 0 0)))))
		+vpb_all_ops)
(vp-label 'cf_sp)
	(each (# (apply (const vp-byte) (cond
			((find %0 '(emit-cpy-ir emit-cpy-ir-b emit-cpy-ir-s emit-cpy-ir-i emit-cpy-ir-ub
				emit-cpy-ir-us emit-cpy-ir-ui emit-lea-i emit-cpy-if)) '(0 1))
			((find %0 '(emit-cpy-ri emit-cpy-ri-b emit-cpy-ri-s emit-cpy-ri-i emit-cpy-fi)) '(1 2))
			((eql %0 'emit-cpy-rr) '(0xfe 0xfe))
			('(0xff 0xff)))))
		+vpb_all_ops))

