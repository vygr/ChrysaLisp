;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; VP translators, what each CPU's has the same
;
; A translator is a .vp of lib/trans/ of one function: VP text in, to its
; records by lib/trans/vp_parse.vp, native out. It calls (trans-driver) first, then has a
; routine for each op it knows, given to (handler), then (trans-helpers),
; (trans-tables) and its own data, a reg_map of the VP's registers in its
; own numbers among them, and its prepass, the routine 'prepass.
;
; A routine of an op is called with :r0 :r1 :r2 :r3 its first operands'
; values, :r4 all of them, :r5 how many, :r6 the operands as parsed and
; :r7 its record, whose +tri_m is the most a branch has had to reach.
; It may trash :r0 to :r13, never :r14,
; the state, with +trs_pc where the output is and +trs_pass the pass.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(structure +trs 0
	(ptr buf labels prev recs ops adj free)
	(long pc err nlabels ninsts pass pi pend pend_op nadj lim)
	(ptr next b1 d1 d2 fs)
	(long fj plim s0 s1 s2 s3)
	(ptr strs vals))

;an instruction, and an operand of one. An instruction's vals are its
;operands' values, in vals of the state as its operands are in ops, and h
;its routine, both as the passes find them, and lab is not 0 if an operand
;is a label's, whose value is worked out again each pass
(structure +tri 0
	(long op cnt ops m)
	(ptr vals h)
	(long lab))
(structure +tro 0
	(long kind a b spare))

(enums +trk 0
	(enum reg num label label_pc label_diff string name pc_label))

(defq +op_label (find 'label +trans_ops)
	+op_nop (find 'nop +trans_ops)
	+op_cpy_rr (find 'cpy-rr +trans_ops)
	+op_lea_i (find 'lea-rcr +trans_ops)
	+rsp 15
	*trans_handlers* (list))

(defun handler (op label)
	;the routine of an op, in the table the passes go by
	(push *trans_handlers* (list op label)))

(defun trans-emit (label &rest parts)
	;the parts added up, to the output by the routine of label, emit8 to
	;emit64: a part is a number, or (reg shift [mask]), (<< (logand reg mask)
	;shift), a shift below 0 a shr. :r12 and :r13 are used, a reg is not them
	(defq k 0 fields (list))
	(each (# (if (num? %0) (setq k (+ k %0)) (push fields %0))) parts)
	(vp-cpy-cr k :r13)
	(each (lambda (f)
			(defq r (first f) s (second f) m (if (> (length f) 2) (third f)))
			(vp-cpy-rr r :r12)
			(if m (vp-and-cr m :r12))
			(cond ((> s 0) (vp-shl-cr s :r12)) ((< s 0) (vp-shr-cr (neg s) :r12)))
			(vp-add-rr :r12 :r13))
		fields)
	(vp-call label))

(defun range? (r lo hi l)
	;goto l if r is not lo to hi
	(vpif `(,r < ,lo)) (vp-jmp l) (endif)
	(vpif `(,r > ,hi)) (vp-jmp l) (endif))

;goto l if r is not a signed field of 12 or 32 bits
(defun within12? (r l) (range? r -0x800 0x7ff l))
(defun within32? (r l) (range? r -0x80000000 0x7fffffff l))

;an instruction of 32 bits, of its fields
(defun ew (&rest parts) (apply (const trans-emit) (cat (list 'emit32) parts)))

(defun trans-driver ()
	;the entry, the decode, the passes and the output, and the data
	(setq *trans_handlers* (list))
		(entry '(:r0 :r1))
		;the loader's call, no Lisp: :r0 = 0, :r1 = the VP text, :r2 = its
		;length -> :r0 = 0 else the str of the native
		(vpif '(:r0 = 0))
			(vp-cpy-rr :r1 :r0)
			(vp-cpy-rr :r2 :r1)
			(vp-jmp 'translate)
		(endif)
		(errorif-lisp-args-sig 'error :r1 1)
		(list-bind-args :r1 '(:r2) '(:obj))
		(vp-push :r0)
		(assign '((:r2 +str_length)) '(:r1))
		(vp-lea-rcr :r2 +str_data :r0)
		(vp-call 'translate)
		;:r0 = 0 else str
		(vpif '(:r0 = 0))
			(vp-pop :r0)
			(assign '((:r0 +lisp_sym_nil)) '(:r1))
			(class/obj/ref :r1 :r2)
		(else)
			(vp-cpy-rr :r0 :r1)
			(vp-pop :r0)
		(endif)
		(exit '(:r0 :r1))
		(vp-ret)

	;;;;;;;;;;;;;;;;;;;;;;
	; decode and the passes
	;;;;;;;;;;;;;;;;;;;;;;

	(vp-label 'alloc0)
		;:r0 = size, -> :r0 = a block of it all 0, trashes :r1-:r3
		(vp-push :r0)
		(call :sys_mem :alloc '(:r0) '(:r0 _))
		(vp-pop :r2)
		(vp-push :r0)
		(call :sys_mem :fill '(:r0 :r2 0) '(_))
		(vp-pop :r0)
		(vp-ret)

	(vp-label 'alloc1)
		;:r0 = size, -> :r0 = a block of it as it comes, trashes :r1-:r2
		(call :sys_mem :alloc '(:r0) '(:r0 _))
		(vp-ret)

	(vp-label 'translate)
		;:r0 = data, :r1 = length, -> :r0 = 0 else the str of the native
		(vp-push :r14 :r0 :r1)
		(vp-cpy-cr +trs_size :r0)
		(vp-call 'alloc0)
		(vp-cpy-rr :r0 :r14)
		;the buffer, room for all an instruction can make
		(vp-load-rcr :rsp 0 :r0)
		(vp-shl-cr 5 :r0)
		(vp-add-cr 65536 :r0)
		(vp-call 'alloc1)
		(assign '(:r0) '((:r14 +trs_buf)))
		;the VP text, ("name" and on, to the records, lib/trans/vp_parse.vp
		(assign '((:rsp 0) (:rsp +ptr_size)) '(:r1 :r0))
		(fn-call 'lib/trans/vp_parse)
		(vpif '(:r0 /= 0))
			(vp-jmp 'fail)
		(endif)
		(vp-call 'prepass)
		(assign '((:r14 +trs_err)) '(:r0))
		(vpif '(:r0 /= 0))
			(vp-jmp 'fail)
		(endif)

		;what no pass changes, once: each operand's value, a register as this
		;CPU's, 4 more past the last for the routines' first 4
		(load-fields :r14 '(+trs_ops +trs_free) '(:r0 :r1))
		(vp-sub-rr :r0 :r1)
		(vp-shr-cr (- (log2 +tro_size) (log2 +long_size)) :r1)
		(vp-add-cr (* 4 +long_size) :r1)
		(vp-cpy-rr :r1 :r0)
		(vp-call 'alloc1)
		(assign '(:r0) '((:r14 +trs_vals)))
		(load-fields :r14 '(+trs_ops +trs_free) '(:r1 :r2))
		(vp-lea-pr 'reg_map :r12)
		(loop-while '(:r1 < :r2))
			(load-fields :r1 '(+tro_kind +tro_a) '(:r3 :r4))
			(vpif '(:r3 = +trk_reg))
				(vp-load-rrr-ub :r12 :r4 :r4)
			(endif)
			(vp-store-rrc :r4 :r0 0)
			(vp-add-cr +tro_size :r1)
			(vp-add-cr +long_size :r0)
		(loop-end)
		;and each instruction's values, routine and if it has a label's
		(load-fields :r14 '(+trs_recs +trs_ninsts +trs_ops +trs_vals) '(:r8 :r10 :r11 :r13))
		(vp-lea-pr 'op_table :r9)
		(loop-while '(:r10 /= 0))
			(load-fields :r8 '(+tri_op +tri_cnt +tri_ops) '(:r0 :r1 :r2))
			(vp-cpy-rr :r2 :r3)
			(vp-sub-rr :r11 :r3)
			(vp-shr-cr (- (log2 +tro_size) (log2 +long_size)) :r3)
			(vp-add-rr :r13 :r3)
			(vp-shl-cr 3 :r0)
			(vp-load-rrr :r9 :r0 :r0)
			(vp-add-rr :r9 :r0)
			(vp-xor-rr :r4 :r4)
			(loop-while '(:r1 /= 0))
				(assign '((:r2 +tro_kind)) '(:r5))
				(vpif '(:r5 >= +trk_label) '(:r5 <= +trk_label_diff))
					(vp-cpy-cr 1 :r4)
				(endif)
				(vpif '(:r5 = +trk_pc_label))
					(vp-cpy-cr 1 :r4)
				(endif)
				(vp-add-cr +tro_size :r2)
				(vp-sub-cr 1 :r1)
			(loop-end)
			(save-fields :r8 '(+tri_vals +tri_h +tri_lab) '(:r3 :r0 :r4))
			(vp-add-cr +tri_size :r8)
			(vp-sub-cr 1 :r10)
		(loop-end)

		;the passes, till the labels are where they were the pass before
		(loop-start)
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:r14 +trs_pc)))
			(assign '((:r14 +trs_recs) (:r14 +trs_ninsts)) '(:r8 :r10))
			(vpif '(:r10 /= 0))
			(loop-start)
				(vp-push :r8 :r10)
				(load-fields :r8 '(+tri_op +tri_cnt +tri_ops) '(:r7 :r5 :r6))
				(vpif `(:r7 = ,+op_label))
					(assign '((:r6 +tro_a) (:r14 +trs_labels) (:r14 +trs_pc)) '(:r0 :r1 :r2))
					(vp-shl-cr 3 :r0)
					(vp-store-rrr :r2 :r1 :r0)
				(else)
					;the values of its labels' operands, as of the pc where it
					;starts, the rest as they were found once
					(load-fields :r8 '(+tri_vals +tri_lab) '(:r4 :r0))
					(vpif '(:r0 /= 0))
						(assign '((:r14 +trs_labels) (:r14 +trs_pc)) '(:r9 :r10))
						(vp-cpy-rr :r6 :r0)
						(vp-cpy-rr :r4 :r1)
						(vp-cpy-rr :r5 :r2)
						(loop-while '(:r2 /= 0))
							(load-fields :r0 '(+tro_kind +tro_a) '(:r3 :r11))
							(vpif '(:r3 = +trk_label))
								(vp-shl-cr 3 :r11)
								(vp-load-rrr :r9 :r11 :r11)
								(vp-store-rrc :r11 :r1 0)
							(elseif '(:r3 = +trk_label_pc))
								(vp-shl-cr 3 :r11)
								(vp-load-rrr :r9 :r11 :r11)
								(vp-sub-rr :r10 :r11)
								(vp-store-rrc :r11 :r1 0)
							(elseif '(:r3 = +trk_pc_label))
								(vp-shl-cr 3 :r11)
								(vp-load-rrr :r9 :r11 :r11)
								(vp-sub-rr :r10 :r11)
								(vp-mul-cr -1 :r11)
								(vp-store-rrc :r11 :r1 0)
							(elseif '(:r3 = +trk_label_diff))
								(vp-shl-cr 3 :r11)
								(vp-load-rrr :r9 :r11 :r11)
								(assign '((:r0 +tro_b)) '(:r12))
								(vp-shl-cr 3 :r12)
								(vp-load-rrr :r9 :r12 :r12)
								(vp-sub-rr :r12 :r11)
								(vp-store-rrc :r11 :r1 0)
							(endif)
							(vp-add-cr +tro_size :r0)
							(vp-add-cr +long_size :r1)
							(vp-sub-cr 1 :r2)
						(loop-end)
					(endif)
					(assign '((:r4 0) (:r4 8) (:r4 16) (:r4 24)) '(:r0 :r1 :r2 :r3))
					(assign '((:r8 +tri_h)) '(:r10))
					(vp-cpy-rr :r8 :r7)
					(vp-call-r :r10)
					(assign '((:r14 +trs_err)) '(:r0))
					(vpif '(:r0 /= 0))
						(vp-jmp 'fail_pop)
					(endif)
				(endif)
				(vp-pop :r8 :r10)
				(vp-add-cr +tri_size :r8)
				(vp-sub-cr 1 :r10)
			(loop-until '(:r10 = 0))
			(endif)
			;the labels as the pass before had them ?
			(assign '((:r14 +trs_labels) (:r14 +trs_prev) (:r14 +trs_nlabels)) '(:r0 :r1 :r2))
			(vp-cpy-cr 1 :r3)
			(vpif '(:r2 /= 0))
			(loop-start)
				(vp-load-rcr :r0 0 :r4)
				(vp-load-rcr :r1 0 :r5)
				(vpif '(:r4 /= :r5))
					(vp-xor-rr :r3 :r3)
				(endif)
				(vp-store-rrc :r4 :r1 0)
				(vp-add-cr +long_size :r0)
				(vp-add-cr +long_size :r1)
				(vp-sub-cr 1 :r2)
			(loop-until '(:r2 = 0))
			(endif)
			(assign '((:r14 +trs_pass)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:r14 +trs_pass)))
			(vpif '(:r0 > 1000))
				(vp-jmp 'fail)
			(endif)
			(vpif '(:r0 < 2))
				(vp-xor-rr :r3 :r3)
			(endif)
		(loop-until '(:r3 /= 0))

		;the native, a str of it
		(assign '((:r14 +trs_pc)) '(:r1))
		(call :str :create_from_buffer '(0 :r1) '(:r0))
		(vp-push :r0)
		(vp-lea-rcr :r0 +str_data :r1)
		(assign '((:r14 +trs_buf) (:r14 +trs_pc)) '(:r0 :r2))
		(call :sys_mem :copy '(:r0 :r1 :r2) '(_ _))
		(vp-pop :r0)
		(vp-jmp 'done)

	(vp-label 'fail_pop)
		(vp-pop :r8 :r10)
	(vp-label 'fail)
		(vp-xor-rr :r0 :r0)
	(vp-label 'done)
		;all let go of, but the str
		(vp-push :r0)
		(assign '((:r14 +trs_buf)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_vals)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_labels)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_prev)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_recs)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_ops)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_adj)) '(:r0))
		(call :sys_mem :free '(:r0))
		(assign '((:r14 +trs_strs)) '(:r0))
		(call :sys_mem :free '(:r0))
		(call :sys_mem :free '(:r14))
		(vp-pop :r0)
		(vp-free (* 2 +ptr_size))
		(vp-pop :r14)
		(vp-ret)

	;;;;;;;;;;;;;;;;;;;;;;;;;
	; output, and what is not
	;;;;;;;;;;;;;;;;;;;;;;;;;

	(vp-label 'emit32)
		;:r13 = int, trashes :r11 :r12
		(assign '((:r14 +trs_buf) (:r14 +trs_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-store-rrc-i :r13 :r11 0)
		(vp-add-cr 4 :r12)
		(assign '(:r12) '((:r14 +trs_pc)))
		(vp-ret)

	(vp-label 'emit8)
		;:r13 = byte, trashes :r11 :r12
		(assign '((:r14 +trs_buf) (:r14 +trs_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-store-rrc-b :r13 :r11 0)
		(vp-add-cr 1 :r12)
		(assign '(:r12) '((:r14 +trs_pc)))
		(vp-ret)

	(vp-label 'emit16)
		(assign '((:r14 +trs_buf) (:r14 +trs_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-store-rrc-s :r13 :r11 0)
		(vp-add-cr 2 :r12)
		(assign '(:r12) '((:r14 +trs_pc)))
		(vp-ret)

	(vp-label 'emit64)
		(assign '((:r14 +trs_buf) (:r14 +trs_pc)) '(:r11 :r12))
		(vp-add-rr :r12 :r11)
		(vp-store-rrc :r13 :r11 0)
		(vp-add-cr 8 :r12)
		(assign '(:r12) '((:r14 +trs_pc)))
		(vp-ret)

	(vp-label 'h_none)
		;an op this has no routine for, or a range it can not reach
		(vp-cpy-cr 1 :r0)
		(assign '(:r0) '((:r14 +trs_err)))
		(vp-ret)

	(vp-label 'h_nop)
		(vp-ret)
	(handler 'nop 'h_nop)
	(handler 'trash 'h_nop)

	;;;;;;;;;;;;;;;;;;
	; data and padding
	;;;;;;;;;;;;;;;;;;

	(each (lambda ((op label emit))
			(vp-label label)
			;:r4 = the values, :r5 = how many
			(vpif '(:r5 /= 0))
			(loop-start)
				(vp-load-rcr :r4 0 :r13)
				(vp-call emit)
				(vp-add-cr +long_size :r4)
				(vp-sub-cr 1 :r5)
			(loop-until '(:r5 = 0))
			(endif)
			(vp-ret)
			(handler op label))
		'((byte h_byte emit8) (short h_short emit16)
		(int h_int emit32) (long h_long emit64)))

	(vp-label 'h_string)
		;:r6 = the operand, its bytes and how many
		(assign '((:r6 +tro_a) (:r6 +tro_b)) '(:r4 :r5))
		(vpif '(:r5 /= 0))
		(loop-start)
			(vp-load-rcr-ub :r4 0 :r13)
			(vp-call 'emit8)
			(vp-add-cr 1 :r4)
			(vp-sub-cr 1 :r5)
		(loop-until '(:r5 = 0))
		(endif)
		(vp-ret)
	(handler 'string 'h_string)

	(vp-label 'h_align)
		;:r0 = size, :r1 = fill if given, the pc made a whole number of size
		(vpif '(:r5 < 2))
			(vp-xor-rr :r1 :r1)
		(endif)
		(assign '((:r14 +trs_pc)) '(:r2))
		(vp-cpy-rr :r2 :r3)
		(vp-add-rr :r0 :r3)
		(vp-sub-cr 1 :r3)
		(vp-mul-cr -1 :r0)
		(vp-and-rr :r0 :r3)
		(vp-cpy-rr :r1 :r13)
		(loop-while '(:r2 < :r3))
			(vp-call 'emit8)
			(vp-add-cr 1 :r2)
		(loop-end)
		(vp-ret)
	(handler 'align 'h_align)

)

(defun trans-helpers ()
	;the operands, as the prepasses look at them
	(vp-label 'rec_of)
		;:r0 = i -> :r0 = its record, trashes :r1
		(vp-mul-cr +tri_size :r0)
		(assign '((:r14 +trs_recs)) '(:r1))
		(vp-add-rr :r1 :r0)
		(vp-ret)

	(vp-label 'is_rsp)
		;:r0 = operand -> :r1 = 1 if :rsp, trashes :r2
		(vp-xor-rr :r1 :r1)
		(assign '((:r0 +tro_kind)) '(:r2))
		(vpif '(:r2 = +trk_reg))
			(assign '((:r0 +tro_a)) '(:r2))
			(vpif `(:r2 = ,+rsp))
				(vp-cpy-cr 1 :r1)
			(endif)
		(endif)
		(vp-ret)

	(vp-label 'opeq)
		;:r0 :r1 = operands -> :r2 = 1 if the same, trashes :r3 :r4
		(vp-xor-rr :r2 :r2)
		(assign '((:r0 +tro_kind) (:r1 +tro_kind)) '(:r3 :r4))
		(vpif '(:r3 = :r4))
			(assign '((:r0 +tro_a) (:r1 +tro_a)) '(:r3 :r4))
			(vpif '(:r3 = :r4))
				(assign '((:r0 +tro_b) (:r1 +tro_b)) '(:r3 :r4))
				(vpif '(:r3 = :r4))
					(vp-cpy-cr 1 :r2)
				(endif)
			(endif)
		(endif)
		(vp-ret)

	(vp-label 'count_rsp)
		;:r0 = record -> :r1 = how many of its operands are :rsp, trashes :r2-:r5
		(assign '((:r0 +tri_cnt) (:r0 +tri_ops)) '(:r3 :r4))
		(vp-xor-rr :r5 :r5)
		(loop-while '(:r3 /= 0))
			(assign '((:r4 +tro_kind) (:r4 +tro_a)) '(:r1 :r2))
			(vpif '(:r1 = +trk_reg))
				(vpif `(:r2 = ,+rsp))
					(vp-add-cr 1 :r5)
				(endif)
			(endif)
			(vp-add-cr +tro_size :r4)
			(vp-sub-cr 1 :r3)
		(loop-end)
		(vp-cpy-rr :r5 :r1)
		(vp-ret)

	(vp-label 'any_eq)
		;:r0 = record, :r1 = operand -> :r2 = 1 if an operand of it is that,
		;trashes :r3-:r7
		(assign '((:r0 +tri_cnt) (:r0 +tri_ops)) '(:r5 :r6))
		(vp-cpy-rr :r1 :r7)
		(loop-while '(:r5 /= 0))
			(vp-cpy-rr :r6 :r0)
			(vp-cpy-rr :r7 :r1)
			(vp-call 'opeq)
			(vpif '(:r2 /= 0))
				(vp-ret)
			(endif)
			(vp-add-cr +tro_size :r6)
			(vp-sub-cr 1 :r5)
		(loop-end)
		(vp-xor-rr :r2 :r2)
		(vp-ret)

	(vp-label 'new_ops)
		;:r0 = how many -> :r0 = that many operands, all 0, trashes :r1
		(assign '((:r14 +trs_free)) '(:r1))
		(vp-mul-cr +tro_size :r0)
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:r14 +trs_free)))
		;the pool is not made 0, these are, from the last back to the first
		(vp-push :r2)
		(vp-xor-rr :r2 :r2)
		(loop-while '(:r0 /= :r1))
			(vp-sub-cr +tro_size :r0)
			(save-fields :r0 '(+tro_kind +tro_a +tro_b) '(:r2 :r2 :r2))
		(loop-end)
		(vp-pop :r2)
		(vp-ret)

	(vp-label 'cpy_op)
		;:r0 = from, :r1 = to, trashes :r2
		(assign '((:r0 +tro_kind)) '(:r2))
		(assign '(:r2) '((:r1 +tro_kind)))
		(assign '((:r0 +tro_a)) '(:r2))
		(assign '(:r2) '((:r1 +tro_a)))
		(assign '((:r0 +tro_b)) '(:r2))
		(assign '(:r2) '((:r1 +tro_b)))
		(vp-ret)

	(vp-label 'num_op)
		;:r0 = value, :r1 = operand to make a number of it
		(assign '(:r0) '((:r1 +tro_a)))
		(vp-cpy-cr +trk_num :r0)
		(assign '(:r0) '((:r1 +tro_kind)))
		(vp-ret)

)

(defun trans-tables (name)
	;the error of the entry, and the routine of each op
	;the error's signature is data, so after all the code
	(vp-label 'error)
		(jump :lisp :repl_error `(:r1 ,name +error_msg_wrong_types))
		(signature '(:str))


		(vp-align +long_size)
	(vp-label 'op_table)
		(each (lambda (op)
				(defq h (some (# (if (eql (first %0) op) (second %0))) *trans_handlers*))
				(vp-long `(- ,(label-sym (ifn h 'h_none)) ,(label-sym 'op_table))))
			+trans_ops)
)

;;;;;;;;;;;;;;
; call fusion
;;;;;;;;;;;;;;

(defun trans-call-fusion ()
	;the call fusion prepass, of a CPU with a link register: one call
	;after another in a straight line, the link left on the stack between
	;them, :rsp relative access between a slot deeper. Instructions 8 to
	;the last. Its tables are
	;(trans-call-fusion-tables cpu)
(vp-label 'prepass)
	(assign '((:r14 +trs_ninsts)) '(:r0))
	(assign '(:r0) '((:r14 +trs_lim)))
	(vp-cpy-cr 8 :r0)
	(assign '(:r0) '((:r14 +trs_pi)))
	(vp-cpy-cr -1 :r0)
	(assign '(:r0) '((:r14 +trs_pend)))
	(vp-xor-rr :r0 :r0)
	(assign '(:r0) '((:r14 +trs_nadj)))
	(loop-start)
		(assign '((:r14 +trs_pi) (:r14 +trs_lim)) '(:r0 :r1))
		(breakif '(:r0 >= :r1))
		(vp-call 'cf_one)
		(assign '((:r14 +trs_err)) '(:r0))
		(breakif '(:r0 /= 0))
		(assign '((:r14 +trs_pi)) '(:r0))
		(vp-add-cr 1 :r0)
		(assign '(:r0) '((:r14 +trs_pi)))
	(loop-end)
	(vp-ret)

(vp-label 'cf_load)
	;:r8 = the record at pi, :r7 = its op, :r6 = its cf_tab entry, :r5 = its tag
	(assign '((:r14 +trs_pi)) '(:r0))
	(vp-call 'rec_of)
	(vp-cpy-rr :r0 :r8)
	(assign '((:r8 +tri_op)) '(:r7))
	(vp-lea-pr 'cf_tab :r6)
	(vp-cpy-rr :r7 :r0)
	(vp-shl-cr 2 :r0)
	(vp-add-rr :r0 :r6)
	(vp-load-rcr-ub :r6 0 :r5)
	(vp-ret)

(vp-label 'cf_one)
	(vp-call 'cf_load)
	(vpif '(:r5 = 0))
		;straight line, an :rsp after a call that may fuse noted, or the fuse lost
		(assign '((:r14 +trs_pend)) '(:r0))
		(vpif '(:r0 >= 0))
			(vp-cpy-rr :r8 :r0)
			(vp-call 'count_rsp)
			(vpif '(:r1 /= 0))
				(vp-cpy-rr :r8 :r0)
				(vp-xor-rr :r1 :r1)
				(vp-call 'cf_sp_adjust)
				(vpif '(:r1 = 0))
					(vp-cpy-cr -1 :r0)
					(assign '(:r0) '((:r14 +trs_pend)))
				(else)
					(assign '((:r14 +trs_adj) (:r14 +trs_nadj) (:r14 +trs_pi)) '(:r0 :r1 :r2))
					(vp-cpy-rr :r1 :r3)
					(vp-shl-cr 3 :r3)
					(vp-store-rrr :r2 :r0 :r3)
					(vp-add-cr 1 :r1)
					(assign '(:r1) '((:r14 +trs_nadj)))
				(endif)
			(endif)
		(endif)
		(vp-ret)
	(endif)
	(vpif '(:r5 = 1))
		(vp-cpy-cr -1 :r0)
		(assign '(:r0) '((:r14 +trs_pend)))
		(vp-ret)
	(endif)
	;a call, not one that uses :rsp
	(vp-cpy-rr :r8 :r0)
	(vp-call 'count_rsp)
	(vpif '(:r1 /= 0))
		(vp-cpy-cr -1 :r0)
		(assign '(:r0) '((:r14 +trs_pend)))
		(vp-ret)
	(endif)
	(vp-call 'cf_load)
	(assign '((:r14 +trs_pend)) '(:r0))
	(vpif '(:r0 >= 0))
		;the call pending keeps the link on the stack, this one restores it
		(vp-call 'rec_of)
		(assign '((:r14 +trs_pend_op)) '(:r1))
		(vp-lea-pr 'cf_tab :r2)
		(vp-shl-cr 2 :r1)
		(vp-add-rr :r1 :r2)
		(vp-load-rcr-ub :r2 1 :r1)
		(assign '(:r1) '((:r0 +tri_op)))
		(vp-load-rcr-ub :r6 2 :r1)
		(assign '(:r1) '((:r8 +tri_op)))
		(loop-start)
			(assign '((:r14 +trs_nadj)) '(:r0))
			(breakif '(:r0 = 0))
			(vp-sub-cr 1 :r0)
			(assign '(:r0) '((:r14 +trs_nadj)))
			(assign '((:r14 +trs_adj)) '(:r1))
			(vp-shl-cr 3 :r0)
			(vp-load-rrr :r1 :r0 :r0)
			(vp-call 'rec_of)
			(vp-cpy-cr 1 :r1)
			(vp-call 'cf_sp_adjust)
			(vpif '(:r1 = 0))
				(vp-cpy-cr 1 :r0)
				(assign '(:r0) '((:r14 +trs_err)))
			(endif)
		(loop-end)
		(vp-call 'cf_load)
	(else)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:r14 +trs_nadj)))
	(endif)
	(assign '((:r14 +trs_pi)) '(:r0))
	(assign '(:r0 :r7) '((:r14 +trs_pend) (:r14 +trs_pend_op)))
	(vp-ret)

(vp-label 'cf_sp_adjust)
	;trans-sp-adjust, :r0 = record, :r1 = 0 to ask, 1 to do -> :r1 = 1 if it
	;can be, the stack a slot deeper, trashes :r0-:r9
	(vp-cpy-rr :r0 :r8)
	(vp-cpy-rr :r1 :r9)
	(vp-call 'count_rsp)
	(vpif '(:r1 /= 1))
		(vp-xor-rr :r1 :r1)
		(vp-ret)
	(endif)
	(assign '((:r8 +tri_op)) '(:r0))
	(vp-lea-pr 'cf_sp :r1)
	(vp-shl-cr 1 :r0)
	(vp-add-rr :r0 :r1)
	(vp-load-rcr-ub :r1 0 :r2)
	(vp-load-rcr-ub :r1 1 :r3)
	(assign '((:r8 +tri_ops)) '(:r4))
	(vpif '(:r2 = 0xff))
		(vp-xor-rr :r1 :r1)
		(vp-ret)
	(endif)
	(vpif '(:r2 = 0xfe))
		;a copy from :rsp, the address of the slot
		(vp-cpy-rr :r4 :r0)
		(vp-call 'is_rsp)
		(vpif '(:r1 /= 0))
			(vpif '(:r9 /= 0))
				(vp-cpy-cr 3 :r0)
				(vp-call 'new_ops)
				(vp-cpy-rr :r0 :r5)
				(vp-cpy-rr :r4 :r0)
				(vp-cpy-rr :r5 :r1)
				(vp-call 'cpy_op)
				(vp-cpy-cr +ptr_size :r0)
				(vp-lea-rcr :r5 +tro_size :r1)
				(vp-call 'num_op)
				(vp-lea-rcr :r4 +tro_size :r0)
				(vp-lea-rcr :r5 (* 2 +tro_size) :r1)
				(vp-call 'cpy_op)
				(vp-cpy-cr +op_lea_i :r0)
				(vp-cpy-cr 3 :r1)
				(assign '(:r0 :r1 :r5) '((:r8 +tri_op) (:r8 +tri_cnt) (:r8 +tri_ops)))
			(endif)
			(vp-cpy-cr 1 :r1)
		(endif)
		(vp-ret)
	(endif)
	;the base :rsp and the offset a number
	(vp-cpy-rr :r2 :r0)
	(vp-mul-cr +tro_size :r0)
	(vp-add-rr :r4 :r0)
	(vp-call 'is_rsp)
	(vpif '(:r1 = 0))
		(vp-ret)
	(endif)
	(vp-cpy-rr :r3 :r0)
	(vp-mul-cr +tro_size :r0)
	(vp-add-rr :r4 :r0)
	(assign '((:r0 +tro_kind)) '(:r2))
	(vpif '(:r2 /= +trk_num))
		(vp-xor-rr :r1 :r1)
		(vp-ret)
	(endif)
	(vpif '(:r9 /= 0))
		(assign '((:r0 +tro_a)) '(:r2))
		(vp-add-cr +ptr_size :r2)
		(assign '(:r2) '((:r0 +tro_a)))
	(endif)
	(vp-cpy-cr 1 :r1)
	(vp-ret))

(defun trans-call-fusion-tables (cpu)
	;of each op, 4 bytes: 1 a barrier, 2 a call and the ops it becomes, the
	;first call of a pair and the last; then the :rsp access of each op
	(defq calls '(call call-r call-rc call-p)
		named (lambda (v) (map (lambda (c) (sym (cat cpu "-" c v))) calls))
		hs (named "-h") ms (named "-m") ts (named "-t")
		opi (lambda (o) (find o +trans_ops)))
	(vp-align +long_size)
(vp-label 'cf_tab)
	(each (lambda (op)
			(defq i :nil)
			(apply (const vp-byte) (cond
				((setq i (find op calls)) (list 2 (opi (elem-get hs i)) (opi (elem-get ts i)) 0))
				((setq i (find op ts)) (list 2 (opi (elem-get ms i)) 0xff 0))
				((find op '(label alloc free push pop save-state
						load-state entry-abi call-abi jmp jmp-r jmp-rc
						jmp-p ret sync beq-cr bne-cr bge-cr ble-cr
						blt-cr bgt-cr beq-rr bne-rr bge-rr ble-rr
						blt-rr bgt-rr beq-dd bne-dd bge-dd blt-dd
						ble-dd bgt-dd beq-ff bne-ff bge-ff blt-ff
						ble-ff bgt-ff))
					'(1 0 0 0))
				('(0 0 0 0)))))
		+trans_ops)
(vp-label 'cf_sp)
	(each (# (apply (const vp-byte) (cond
			((find %0 '(load-rcr load-rcr-b load-rcr-s load-rcr-i load-rcr-ub
				load-rcr-us load-rcr-ui lea-rcr load-rcd load-rcf)) '(0 1))
			((find %0 '(store-rrc store-rrc-b store-rrc-s store-rrc-i store-drc store-frc)) '(1 2))
			((eql %0 'cpy-rr) '(0xfe 0xfe))
			('(0xff 0xff)))))
		+trans_ops))

