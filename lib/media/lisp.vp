(include "lib/asm/func.inc")
(include "class/reals/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./aac_dct4"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f9
	;info
	;(aac-dct4 x tw rev out) -> out, the DCT-IV of the n reals of x, by an
	;FFT of n/2, m, into out, n reals. tw is 5m reals: the twiddles before,
	;e^(-i pi (4j+1)/4n) as cos and sin, m of them, after, e^(-i pi k/n),
	;m, and of the FFT, e^(-2 pi i k/m), m/2. rev is the nums of the bit
	;reversal of m. lib/media/aac.inc makes them

	(vp-rdef (xp tw rev out n m j a b c d e f g h)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,xp ,tw ,rev ,out) '(:obj :obj :obj :obj))
	(vp-push out)
	(assign `((,xp +array_length ui)) `(,n))
	(assign `((,xp +array_begin) (,tw +array_begin) (,rev +array_begin) (,out +array_begin))
		`(,xp ,tw ,rev ,out))
	(vp-cpy-rr n m)
	(vp-shr-cr 1 m)

	;before: each pair of lines a complex, x[2j] and x[n-1-2j], turned by
	;its twiddle, to its place bit reversed
	(vp-xor-rr j j)
	(loop-start)
		;x[2j], x[n-1-2j]
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-df xp a :f0)
		(vp-cpy-rr n b)
		(vp-sub-cr 1 b)
		(vp-shl-cr 3 b)
		(vp-sub-rr a b)
		(vp-cpy-df xp b :f1)
		;its twiddle, cos and sin
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		;re = x0 c - x1 s, im = x0 s + x1 c
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;to its place, rev[j]
		(vp-cpy-rr j c)
		(vp-shl-cr 3 c)
		(vp-cpy-dr rev c d)
		(vp-shl-cr 4 d)
		(vp-cpy-fd :f4 out d)
		(vp-add-cr 8 d)
		(vp-cpy-fd :f0 out d)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,m))

	;the FFT, in place, stages of 2, 4 ... m, a twiddle every so many of
	;the table: c is the length of a stage, d half of it in bytes, e the
	;step through the table in bytes. tw moved to the FFT's twiddles
	(vp-cpy-rr m a)
	(vp-shl-cr 5 a)
	(vp-add-rr a tw)
	(vp-cpy-cr 2 c)
	(vp-cpy-rr m e)
	(vp-shl-cr 3 e)
	(loop-start)
		(vp-cpy-rr c d)
		(vp-shl-cr 3 d)
		;each group, from a, its first in bytes
		(vp-xor-rr a a)
		(loop-start)
			;each pair of the group, b from 0 to half, f through the table
			(vp-xor-rr b b)
			(vp-xor-rr f f)
			(loop-start)
				;i at a + b, j half after it, in bytes of complexes
				(vp-cpy-rr a j)
				(vp-add-rr b j)
				(vp-add-rr out j)
				;the twiddle
				(vp-cpy-df tw f :f2)
				(vp-add-cr 8 f)
				(vp-cpy-df tw f :f3)
				(vp-sub-cr 8 f)
				;x[j] by it, j at g
				(vp-cpy-rr j g)
				(vp-add-rr d g)
				(vp-cpy-if g 0 :f0)
				(vp-cpy-if g 8 :f1)
				(vp-cpy-ff :f0 :f4)
				(vp-mul-ff :f2 :f4)
				(vp-cpy-ff :f1 :f5)
				(vp-mul-ff :f3 :f5)
				(vp-sub-ff :f5 :f4)
				(vp-mul-ff :f3 :f0)
				(vp-mul-ff :f2 :f1)
				(vp-add-ff :f1 :f0)
				;x[j] = x[i] - t, x[i] = x[i] + t
				(vp-cpy-if j 0 :f6)
				(vp-cpy-if j 8 :f7)
				(vp-cpy-ff :f6 :f8)
				(vp-sub-ff :f4 :f8)
				(vp-cpy-ff :f7 :f9)
				(vp-sub-ff :f0 :f9)
				(vp-add-ff :f4 :f6)
				(vp-add-ff :f0 :f7)
				(vp-cpy-fi :f6 j 0)
				(vp-cpy-fi :f7 j 8)
				(vp-cpy-fi :f8 g 0)
				(vp-cpy-fi :f9 g 8)
				(vp-add-cr 16 b)
				(vp-add-rr e f)
			(loop-until `(,b = ,d))
			(vp-add-rr d a)
			(vp-add-rr d a)
			(vp-cpy-rr m j)
			(vp-shl-cr 4 j)
		(loop-until `(,a = ,j))
		(vp-shr-cr 1 e)
		(vp-shl-cr 1 c)
	(loop-until `(,c > ,m))

	;after: each complex k turned by its twiddle, two at once, k and m-1-k,
	;as y[2k] and y[n-1-2k] are where the two of them were. tw back to the
	;twiddles after
	(vp-cpy-rr m a)
	(vp-shl-cr 4 a)
	(vp-sub-rr a tw)
	(vp-xor-rr j j)
	(vp-cpy-rr m b)
	(vp-shr-cr 1 b)
	(loop-start)
		;k at a, m-1-k at c, in bytes
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-rr m c)
		(vp-sub-cr 1 c)
		(vp-sub-rr j c)
		(vp-shl-cr 4 c)
		;u of k
		(vp-cpy-df out a :f0)
		(vp-add-cr 8 a)
		(vp-cpy-df out a :f1)
		(vp-sub-cr 8 a)
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		(vp-sub-cr 8 a)
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;u of m-1-k
		(vp-cpy-df out c :f6)
		(vp-add-cr 8 c)
		(vp-cpy-df out c :f7)
		(vp-sub-cr 8 c)
		(vp-cpy-df tw c :f2)
		(vp-add-cr 8 c)
		(vp-cpy-df tw c :f3)
		(vp-sub-cr 8 c)
		(vp-cpy-ff :f6 :f8)
		(vp-mul-ff :f2 :f8)
		(vp-cpy-ff :f7 :f9)
		(vp-mul-ff :f3 :f9)
		(vp-sub-ff :f9 :f8)
		(vp-mul-ff :f3 :f6)
		(vp-mul-ff :f2 :f7)
		(vp-add-ff :f7 :f6)
		;y[2k] = re k, y[n-1-2k] = -im k, at the im of m-1-k; y[2(m-1-k)] =
		;re m-1-k, y[2k+1] = -im m-1-k, at the im of k
		(vp-neg-ff :f0 :f0)
		(vp-neg-ff :f6 :f6)
		(vp-cpy-fd :f4 out a)
		(vp-add-cr 8 a)
		(vp-cpy-fd :f6 out a)
		(vp-cpy-fd :f8 out c)
		(vp-add-cr 8 c)
		(vp-cpy-fd :f0 out c)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,b))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(aac-dct4 x tw rev out)" +error_msg_wrong_types))
	(signature '(:reals :reals :nums :reals)))

(def-func-end)
