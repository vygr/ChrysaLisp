(include "lib/asm/func.inc")
(include "class/reals/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./media_dct4"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f9
	;info
	;(media-dct4 x tw rev out) -> out, the DCT-IV of the n reals of x, by an
	;FFT of n/2, m, into out, n reals. tw is 5m reals: the twiddles before,
	;e^(-i pi (4j+1)/4n) as cos and sin, m of them, after, e^(-i pi k/n),
	;m, and of the FFT, e^(-2 pi i k/m), m/2. rev is the nums of the bit
	;reversal of m. lib/media/mdct.inc makes them

	(vp-rdef (xp tw rev out n m j a b c d e f g h)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,xp ,tw ,rev ,out) '(:obj :obj :obj :obj))
	(vp-push out)
	(assign `((,xp +array_length ui)) `(,n))
	(assign `((,xp +array_begin) (,tw +array_begin) (,rev +array_begin) (,out +array_begin))
		`(,xp ,tw ,rev ,out))
	(vp-cpy-rr n m)
	(vp-shr-cr 1 m)

	;before: each pair of lines a complex, x[2j] and x[n-1-2j], turned by
	;its twiddle, to its place bit reversed
	(vp-xor-rr j j)
	(loop-start)
		;x[2j], x[n-1-2j]
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-df xp a :f0)
		(vp-cpy-rr n b)
		(vp-sub-cr 1 b)
		(vp-shl-cr 3 b)
		(vp-sub-rr a b)
		(vp-cpy-df xp b :f1)
		;its twiddle, cos and sin
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		;re = x0 c - x1 s, im = x0 s + x1 c
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;to its place, rev[j]
		(vp-cpy-rr j c)
		(vp-shl-cr 3 c)
		(vp-cpy-dr rev c d)
		(vp-shl-cr 4 d)
		(vp-cpy-fd :f4 out d)
		(vp-add-cr 8 d)
		(vp-cpy-fd :f0 out d)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,m))

	;the FFT, in place, stages of 2, 4 ... m, a twiddle every so many of
	;the table: c is the length of a stage, d half of it in bytes, e the
	;step through the table in bytes. tw moved to the FFT's twiddles
	(vp-cpy-rr m a)
	(vp-shl-cr 5 a)
	(vp-add-rr a tw)
	(vp-cpy-cr 2 c)
	(vp-cpy-rr m e)
	(vp-shl-cr 3 e)
	(loop-start)
		(vp-cpy-rr c d)
		(vp-shl-cr 3 d)
		;each group, from a, its first in bytes
		(vp-xor-rr a a)
		(loop-start)
			;each pair of the group, b from 0 to half, f through the table
			(vp-xor-rr b b)
			(vp-xor-rr f f)
			(loop-start)
				;i at a + b, j half after it, in bytes of complexes
				(vp-cpy-rr a j)
				(vp-add-rr b j)
				(vp-add-rr out j)
				;the twiddle
				(vp-cpy-df tw f :f2)
				(vp-add-cr 8 f)
				(vp-cpy-df tw f :f3)
				(vp-sub-cr 8 f)
				;x[j] by it, j at g
				(vp-cpy-rr j g)
				(vp-add-rr d g)
				(vp-cpy-if g 0 :f0)
				(vp-cpy-if g 8 :f1)
				(vp-cpy-ff :f0 :f4)
				(vp-mul-ff :f2 :f4)
				(vp-cpy-ff :f1 :f5)
				(vp-mul-ff :f3 :f5)
				(vp-sub-ff :f5 :f4)
				(vp-mul-ff :f3 :f0)
				(vp-mul-ff :f2 :f1)
				(vp-add-ff :f1 :f0)
				;x[j] = x[i] - t, x[i] = x[i] + t
				(vp-cpy-if j 0 :f6)
				(vp-cpy-if j 8 :f7)
				(vp-cpy-ff :f6 :f8)
				(vp-sub-ff :f4 :f8)
				(vp-cpy-ff :f7 :f9)
				(vp-sub-ff :f0 :f9)
				(vp-add-ff :f4 :f6)
				(vp-add-ff :f0 :f7)
				(vp-cpy-fi :f6 j 0)
				(vp-cpy-fi :f7 j 8)
				(vp-cpy-fi :f8 g 0)
				(vp-cpy-fi :f9 g 8)
				(vp-add-cr 16 b)
				(vp-add-rr e f)
			(loop-until `(,b = ,d))
			(vp-add-rr d a)
			(vp-add-rr d a)
			(vp-cpy-rr m j)
			(vp-shl-cr 4 j)
		(loop-until `(,a = ,j))
		(vp-shr-cr 1 e)
		(vp-shl-cr 1 c)
	(loop-until `(,c > ,m))

	;after: each complex k turned by its twiddle, two at once, k and m-1-k,
	;as y[2k] and y[n-1-2k] are where the two of them were. tw back to the
	;twiddles after
	(vp-cpy-rr m a)
	(vp-shl-cr 4 a)
	(vp-sub-rr a tw)
	(vp-xor-rr j j)
	(vp-cpy-rr m b)
	(vp-shr-cr 1 b)
	(loop-start)
		;k at a, m-1-k at c, in bytes
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-rr m c)
		(vp-sub-cr 1 c)
		(vp-sub-rr j c)
		(vp-shl-cr 4 c)
		;u of k
		(vp-cpy-df out a :f0)
		(vp-add-cr 8 a)
		(vp-cpy-df out a :f1)
		(vp-sub-cr 8 a)
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		(vp-sub-cr 8 a)
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;u of m-1-k
		(vp-cpy-df out c :f6)
		(vp-add-cr 8 c)
		(vp-cpy-df out c :f7)
		(vp-sub-cr 8 c)
		(vp-cpy-df tw c :f2)
		(vp-add-cr 8 c)
		(vp-cpy-df tw c :f3)
		(vp-sub-cr 8 c)
		(vp-cpy-ff :f6 :f8)
		(vp-mul-ff :f2 :f8)
		(vp-cpy-ff :f7 :f9)
		(vp-mul-ff :f3 :f9)
		(vp-sub-ff :f9 :f8)
		(vp-mul-ff :f3 :f6)
		(vp-mul-ff :f2 :f7)
		(vp-add-ff :f7 :f6)
		;y[2k] = re k, y[n-1-2k] = -im k, at the im of m-1-k; y[2(m-1-k)] =
		;re m-1-k, y[2k+1] = -im m-1-k, at the im of k
		(vp-neg-ff :f0 :f0)
		(vp-neg-ff :f6 :f6)
		(vp-cpy-fd :f4 out a)
		(vp-add-cr 8 a)
		(vp-cpy-fd :f6 out a)
		(vp-cpy-fd :f8 out c)
		(vp-add-cr 8 c)
		(vp-cpy-fd :f0 out c)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,b))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-dct4 x tw rev out)" +error_msg_wrong_types))
	(signature '(:reals :reals :nums :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_s16"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f4
	;info
	;(media-s16 out chans from) -> out, the samples of each channel, reals
	;all as long, from frame from, written to the str out one frame after
	;another, each a 16 bit sample of each channel, low byte first, rounded
	;to the nearest and held to -32768 to 32767. out is to be as long as
	;that, a frame is 2 bytes a channel

	(vp-rdef (out chans from n len c src dst i step x top bottom)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,chans ,from) '(:obj :obj :num))
	(vp-push out)
	(assign `((,chans +array_length ui) (,chans +array_begin)) `(,n ,chans))
	(vp-lea-i out +str_data out)
	;the length of the first channel, the frames are to it
	(assign `((,chans 0)) `(,len))
	(assign `((,len +array_length ui)) `(,len))
	;a frame is 2n bytes, half a unit to round by, and the bounds
	(vp-cpy-rr n step)
	(vp-shl-cr 1 step)
	(vp-cpy-cr 1 x)
	(vp-cvt-rf x :f2)
	(vp-cpy-cr 2 x)
	(vp-cvt-rf x :f3)
	(vp-div-ff :f3 :f2)
	(vp-neg-ff :f2 :f3)
	(vp-cpy-cr 32767 top)
	(vp-cpy-cr -32768 bottom)
	(vp-xor-rr c c)
	(vpif `(,from < ,len))
	(loop-start)
		;each channel its own column of the frames
		(vp-cpy-rr c src)
		(vp-shl-cr 3 src)
		(vp-add-rr chans src)
		(assign `((,src 0)) `(,src))
		(assign `((,src +array_begin)) `(,src))
		(vp-cpy-rr c dst)
		(vp-shl-cr 1 dst)
		(vp-add-rr out dst)
		(vp-cpy-rr from i)
		(loop-start)
			(vp-cpy-rr i x)
			(vp-shl-cr 3 x)
			(vp-cpy-df src x :f0)
			;half away from 0, then the whole part
			(vp-cpy-ff :f2 :f1)
			(vp-xor-rr x x)
			(vp-cvt-rf x :f4)
			(vpif '(:f0 < :f4))
				(vp-cpy-ff :f3 :f1)
			(endif)
			(vp-add-ff :f1 :f0)
			(vp-cvt-fr :f0 x)
			(vpif `(,x > ,top))
				(vp-cpy-rr top x)
			(elseif `(,x < ,bottom))
				(vp-cpy-rr bottom x)
			(endif)
			(vp-cpy-ri-s x dst 0)
			(vp-add-rr step dst)
			(vp-add-cr 1 i)
		(loop-until `(,i = ,len))
		(vp-add-cr 1 c)
	(loop-until `(,c = ,n))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-s16 out chans from)" +error_msg_wrong_types))
	(signature '(:str :list :num)))

(def-func-end)

(def-func (path-to-absolute "./media_huff"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8, :r14, :f0-:f15
	;info
	;(media-huff data at table) -> num, the code of a Huffman book at bit
	;at of the str data, high bit first: what it stands for by 2^32, and
	;the bit after it. table is nums, levels of 256 entries, each by 8 bits
	;of the code: an entry of 0 or more is a code that ends in this level,
	;what it stands for by 256 and its bits in it; less than 0 the next
	;level, at -entry. data is to have 4 bytes past the last code read.
	;lib/media/huff.inc makes the tables

	(vp-rdef (data at table e byte x level)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,data ,at ,table) '(:obj :num :obj))
	(vp-lea-i data +str_data data)
	(assign `((,table +array_begin)) `(,table))
	(vp-cpy-rr table level)
	(loop-start)
		;the next 8 bits: the 2 bytes at at, by where at is in the first
		(vp-cpy-rr at byte)
		(vp-shr-cr 3 byte)
		(vp-add-rr data byte)
		(vp-cpy-ir-ub byte 0 x)
		(vp-cpy-ir-ub byte 1 e)
		(vp-shl-cr 8 x)
		(vp-add-rr e x)
		(vp-cpy-rr at e)
		(vp-and-cr 7 e)
		(vp-shl-rr e x)
		(vp-shr-cr 8 x)
		(vp-and-cr 255 x)
		;its entry
		(vp-shl-cr 3 x)
		(vp-cpy-dr level x e)
		(breakif `(,e >= 0))
		;the next level, its entries from the start of the table
		(vp-add-cr 8 at)
		(vp-mul-cr -8 e)
		(vp-cpy-rr table level)
		(vp-add-rr e level)
	(loop-end)
	;what it stands for, and at past it
	(vp-cpy-rr e x)
	(vp-and-cr 255 x)
	(vp-add-rr x at)
	(vp-shr-cr 8 e)
	(vp-shl-cr 32 e)
	(vp-add-rr at e)
	(call :num :create `(,e) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-huff data at table)" +error_msg_wrong_types))
	(signature '(:str :num :nums)))

(def-func-end)
