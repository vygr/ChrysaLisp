(include "lib/asm/func.inc")
(include "class/reals/class.inc")
(include "class/real/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./media_dct4"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f9
	;info
	;(media-dct4 x tw rev out) -> out, the DCT-IV of the n reals of x, by an
	;FFT of n/2, m, into out, n reals. tw is 5m reals: the twiddles before,
	;e^(-i pi (4j+1)/4n) as cos and sin, m of them, after, e^(-i pi k/n),
	;m, and of the FFT, e^(-2 pi i k/m), m/2. rev is the nums of the bit
	;reversal of m. lib/media/mdct.inc makes them

	(vp-rdef (xp tw rev out n m j a b c d e f g h)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,xp ,tw ,rev ,out) '(:obj :obj :obj :obj))
	(vp-push out)
	(assign `((,xp +array_length ui)) `(,n))
	(assign `((,xp +array_begin) (,tw +array_begin) (,rev +array_begin) (,out +array_begin))
		`(,xp ,tw ,rev ,out))
	(vp-cpy-rr n m)
	(vp-shr-cr 1 m)

	;before: each pair of lines a complex, x[2j] and x[n-1-2j], turned by
	;its twiddle, to its place bit reversed
	(vp-xor-rr j j)
	(loop-start)
		;x[2j], x[n-1-2j]
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-df xp a :f0)
		(vp-cpy-rr n b)
		(vp-sub-cr 1 b)
		(vp-shl-cr 3 b)
		(vp-sub-rr a b)
		(vp-cpy-df xp b :f1)
		;its twiddle, cos and sin
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		;re = x0 c - x1 s, im = x0 s + x1 c
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;to its place, rev[j]
		(vp-cpy-rr j c)
		(vp-shl-cr 3 c)
		(vp-cpy-dr rev c d)
		(vp-shl-cr 4 d)
		(vp-cpy-fd :f4 out d)
		(vp-add-cr 8 d)
		(vp-cpy-fd :f0 out d)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,m))

	;the FFT, in place, stages of 2, 4 ... m, a twiddle every so many of
	;the table: c is the length of a stage, d half of it in bytes, e the
	;step through the table in bytes. tw moved to the FFT's twiddles
	(vp-cpy-rr m a)
	(vp-shl-cr 5 a)
	(vp-add-rr a tw)
	(vp-cpy-cr 2 c)
	(vp-cpy-rr m e)
	(vp-shl-cr 3 e)
	(loop-start)
		(vp-cpy-rr c d)
		(vp-shl-cr 3 d)
		;each group, from a, its first in bytes
		(vp-xor-rr a a)
		(loop-start)
			;each pair of the group, b from 0 to half, f through the table
			(vp-xor-rr b b)
			(vp-xor-rr f f)
			(loop-start)
				;i at a + b, j half after it, in bytes of complexes
				(vp-cpy-rr a j)
				(vp-add-rr b j)
				(vp-add-rr out j)
				;the twiddle
				(vp-cpy-df tw f :f2)
				(vp-add-cr 8 f)
				(vp-cpy-df tw f :f3)
				(vp-sub-cr 8 f)
				;x[j] by it, j at g
				(vp-cpy-rr j g)
				(vp-add-rr d g)
				(vp-cpy-if g 0 :f0)
				(vp-cpy-if g 8 :f1)
				(vp-cpy-ff :f0 :f4)
				(vp-mul-ff :f2 :f4)
				(vp-cpy-ff :f1 :f5)
				(vp-mul-ff :f3 :f5)
				(vp-sub-ff :f5 :f4)
				(vp-mul-ff :f3 :f0)
				(vp-mul-ff :f2 :f1)
				(vp-add-ff :f1 :f0)
				;x[j] = x[i] - t, x[i] = x[i] + t
				(vp-cpy-if j 0 :f6)
				(vp-cpy-if j 8 :f7)
				(vp-cpy-ff :f6 :f8)
				(vp-sub-ff :f4 :f8)
				(vp-cpy-ff :f7 :f9)
				(vp-sub-ff :f0 :f9)
				(vp-add-ff :f4 :f6)
				(vp-add-ff :f0 :f7)
				(vp-cpy-fi :f6 j 0)
				(vp-cpy-fi :f7 j 8)
				(vp-cpy-fi :f8 g 0)
				(vp-cpy-fi :f9 g 8)
				(vp-add-cr 16 b)
				(vp-add-rr e f)
			(loop-until `(,b = ,d))
			(vp-add-rr d a)
			(vp-add-rr d a)
			(vp-cpy-rr m j)
			(vp-shl-cr 4 j)
		(loop-until `(,a = ,j))
		(vp-shr-cr 1 e)
		(vp-shl-cr 1 c)
	(loop-until `(,c > ,m))

	;after: each complex k turned by its twiddle, two at once, k and m-1-k,
	;as y[2k] and y[n-1-2k] are where the two of them were. tw back to the
	;twiddles after
	(vp-cpy-rr m a)
	(vp-shl-cr 4 a)
	(vp-sub-rr a tw)
	(vp-xor-rr j j)
	(vp-cpy-rr m b)
	(vp-shr-cr 1 b)
	(loop-start)
		;k at a, m-1-k at c, in bytes
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-rr m c)
		(vp-sub-cr 1 c)
		(vp-sub-rr j c)
		(vp-shl-cr 4 c)
		;u of k
		(vp-cpy-df out a :f0)
		(vp-add-cr 8 a)
		(vp-cpy-df out a :f1)
		(vp-sub-cr 8 a)
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		(vp-sub-cr 8 a)
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;u of m-1-k
		(vp-cpy-df out c :f6)
		(vp-add-cr 8 c)
		(vp-cpy-df out c :f7)
		(vp-sub-cr 8 c)
		(vp-cpy-df tw c :f2)
		(vp-add-cr 8 c)
		(vp-cpy-df tw c :f3)
		(vp-sub-cr 8 c)
		(vp-cpy-ff :f6 :f8)
		(vp-mul-ff :f2 :f8)
		(vp-cpy-ff :f7 :f9)
		(vp-mul-ff :f3 :f9)
		(vp-sub-ff :f9 :f8)
		(vp-mul-ff :f3 :f6)
		(vp-mul-ff :f2 :f7)
		(vp-add-ff :f7 :f6)
		;y[2k] = re k, y[n-1-2k] = -im k, at the im of m-1-k; y[2(m-1-k)] =
		;re m-1-k, y[2k+1] = -im m-1-k, at the im of k
		(vp-neg-ff :f0 :f0)
		(vp-neg-ff :f6 :f6)
		(vp-cpy-fd :f4 out a)
		(vp-add-cr 8 a)
		(vp-cpy-fd :f6 out a)
		(vp-cpy-fd :f8 out c)
		(vp-add-cr 8 c)
		(vp-cpy-fd :f0 out c)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,b))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-dct4 x tw rev out)" +error_msg_wrong_types))
	(signature '(:reals :reals :nums :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_s16"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f4
	;info
	;(media-s16 out chans from) -> out, the samples of each channel, reals
	;all as long, from frame from, written to the str out one frame after
	;another, each a 16 bit sample of each channel, low byte first, rounded
	;to the nearest and held to -32768 to 32767. out is to be as long as
	;that, a frame is 2 bytes a channel

	(vp-rdef (out chans from n len c src dst i step x top bottom)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,chans ,from) '(:obj :obj :num))
	(vp-push out)
	(assign `((,chans +array_length ui) (,chans +array_begin)) `(,n ,chans))
	(vp-lea-i out +str_data out)
	;the length of the first channel, the frames are to it
	(assign `((,chans 0)) `(,len))
	(assign `((,len +array_length ui)) `(,len))
	;a frame is 2n bytes, half a unit to round by, and the bounds
	(vp-cpy-rr n step)
	(vp-shl-cr 1 step)
	(vp-cpy-cr 1 x)
	(vp-cvt-rf x :f2)
	(vp-cpy-cr 2 x)
	(vp-cvt-rf x :f3)
	(vp-div-ff :f3 :f2)
	(vp-neg-ff :f2 :f3)
	(vp-cpy-cr 32767 top)
	(vp-cpy-cr -32768 bottom)
	(vp-xor-rr c c)
	(vpif `(,from < ,len))
	(loop-start)
		;each channel its own column of the frames
		(vp-cpy-rr c src)
		(vp-shl-cr 3 src)
		(vp-add-rr chans src)
		(assign `((,src 0)) `(,src))
		(assign `((,src +array_begin)) `(,src))
		(vp-cpy-rr c dst)
		(vp-shl-cr 1 dst)
		(vp-add-rr out dst)
		(vp-cpy-rr from i)
		(loop-start)
			(vp-cpy-rr i x)
			(vp-shl-cr 3 x)
			(vp-cpy-df src x :f0)
			;half away from 0, then the whole part
			(vp-cpy-ff :f2 :f1)
			(vp-xor-rr x x)
			(vp-cvt-rf x :f4)
			(vpif '(:f0 < :f4))
				(vp-cpy-ff :f3 :f1)
			(endif)
			(vp-add-ff :f1 :f0)
			(vp-cvt-fr :f0 x)
			(vpif `(,x > ,top))
				(vp-cpy-rr top x)
			(elseif `(,x < ,bottom))
				(vp-cpy-rr bottom x)
			(endif)
			(vp-cpy-ri-s x dst 0)
			(vp-add-rr step dst)
			(vp-add-cr 1 i)
		(loop-until `(,i = ,len))
		(vp-add-cr 1 c)
	(loop-until `(,c = ,n))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-s16 out chans from)" +error_msg_wrong_types))
	(signature '(:str :list :num)))

(def-func-end)

(def-func (path-to-absolute "./media_pcm"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13
	;info
	;(media-pcm chans in width) -> chans, the samples of each channel of
	;the str in, frames of a sample of width 1, 2 or 3 bytes a channel, low
	;byte first, into chans, a nums each as long as there are frames: as 16
	;bits, 8 offset by 128 and moved up, 24 its top two bytes

	(vp-rdef (chans in width n len c src dst i step x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,chans ,in ,width) '(:obj :obj :num))
	(vp-push chans)
	(assign `((,chans +array_length ui) (,chans +array_begin)) `(,n ,chans))
	(vp-lea-i in +str_data in)
	;the length of the first channel, the frames are to it
	(assign `((,chans 0)) `(,len))
	(assign `((,len +array_length ui)) `(,len))
	;a frame is width bytes a channel
	(vp-cpy-rr n step)
	(vp-mul-rr width step)
	(vp-xor-rr c c)
	(vpif `(,len /= 0))
	(loop-start)
		;each channel its own column of the frames
		(vp-cpy-rr c dst)
		(vp-shl-cr 3 dst)
		(vp-add-rr chans dst)
		(assign `((,dst 0)) `(,dst))
		(assign `((,dst +array_begin)) `(,dst))
		(vp-cpy-rr c src)
		(vp-mul-rr width src)
		(vp-add-rr in src)
		(vp-cpy-rr len i)
		(loop-start)
			(vpif `(,width = 2))
				(vp-cpy-ir-s src 0 x)
			(elseif `(,width = 1))
				(vp-cpy-ir-ub src 0 x)
				(vp-sub-cr 128 x)
				(vp-shl-cr 8 x)
			(else)
				(vp-cpy-ir-b src 2 x)
				(vp-shl-cr 8 x)
				(vp-cpy-ir-ub src 1 y)
				(vp-or-rr y x)
			(endif)
			(vp-cpy-ri x dst 0)
			(vp-add-cr +long_size dst)
			(vp-add-rr step src)
			(vp-sub-cr 1 i)
		(loop-until `(,i = 0))
		(vp-add-cr 1 c)
	(loop-until `(,c = ,n))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-pcm chans in width)" +error_msg_wrong_types))
	(signature '(:list :str :num)))

(def-func-end)

(defun huff-walk (data off at table e byte x level)
	;a code of a Huffman book's table, lib/media/huff.inc, at bit at of the
	;bytes at data and off: what it stands for into e, and at past it
	(vp-cpy-rr table level)
	(loop-start)
		;the next 8 bits: the 2 bytes at at, by where at is in the first
		(vp-cpy-rr at byte)
		(vp-shr-cr 3 byte)
		(vp-add-rr data byte)
		(vp-cpy-ir-ub byte off x)
		(vp-cpy-ir-ub byte (+ off 1) e)
		(vp-shl-cr 8 x)
		(vp-add-rr e x)
		(vp-cpy-rr at e)
		(vp-and-cr 7 e)
		(vp-shl-rr e x)
		(vp-shr-cr 8 x)
		(vp-and-cr 255 x)
		;its entry
		(vp-shl-cr 3 x)
		(vp-cpy-dr level x e)
		(breakif `(,e >= 0))
		;the next level, its entries from the start of the table
		(vp-add-cr 8 at)
		(vp-mul-cr -8 e)
		(vp-cpy-rr table level)
		(vp-add-rr e level)
	(loop-end)
	;what it stands for, and at past it
	(vp-cpy-rr e x)
	(vp-and-cr 255 x)
	(vp-add-rr x at)
	(vp-shr-cr 8 e))

(def-func (path-to-absolute "./media_huff"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8, :r14, :f0-:f15
	;info
	;(media-huff data at table) -> num, the code of a Huffman book at bit
	;at of the str data, high bit first: what it stands for by 2^32, and
	;the bit after it. table is nums, levels of 256 entries, each by 8 bits
	;of the code: an entry of 0 or more is a code that ends in this level,
	;what it stands for by 256 and its bits in it; less than 0 the next
	;level, at -entry. data is to have 4 bytes past the last code read.
	;lib/media/huff.inc makes the tables

	(vp-rdef (data at table e byte x level)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,data ,at ,table) '(:obj :num :obj))
	(vp-lea-i data +str_data data)
	(assign `((,table +array_begin)) `(,table))
	(huff-walk data 0 at table e byte x level)
	(vp-shl-cr 32 e)
	(vp-add-rr at e)
	(call :num :create `(,e) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-huff data at table)" +error_msg_wrong_types))
	(signature '(:str :num :nums)))

(def-func-end)

(defun media-bits-read (in n e num at p v x)
	;the next n bits of the reader in, (str (nums at)), high bit first, into
	;v, and at moved past them, in its nums. n a reg or a constant. Trashes
	;the regs given
	(assign `((,in +array_begin)) `(,e))
	(assign `((,e 0) (,e +ptr_size)) `(,p ,num))
	(assign `((,num +array_begin)) `(,num))
	(assign `((,num 0)) `(,at))
	;the 4 bytes at at, high first
	(vp-cpy-rr at x)
	(vp-shr-cr 3 x)
	(vp-add-rr x p)
	(vp-cpy-ir-ub p +str_data v)
	(each (lambda (i)
			(vp-shl-cr 8 v)
			(vp-cpy-ir-ub p (+ +str_data i) x)
			(vp-add-rr x v))
		'(1 2 3))
	;the n of them from at, the bits above taken off
	(vp-cpy-rr at x)
	(vp-and-cr 7 x)
	(vp-shl-rr x v)
	(vp-cpy-cr 32 x)
	(if (num? n) (vp-sub-cr n x) (vp-sub-rr n x))
	(vp-shr-rr x v)
	(vp-cpy-cr 1 x)
	(if (num? n) (vp-shl-cr n x) (vp-shl-rr n x))
	(vp-sub-cr 1 x)
	(vp-and-rr x v)
	;at past them
	(if (num? n) (vp-add-cr n at) (vp-add-rr n at))
	(assign `(,at) `((,num 0))))

(def-func (path-to-absolute "./media_bits_get"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r10, :r14, :f0-:f15
	;info
	;(media-bits-get reader n) -> num, the next n bits, 0 to 25, of a reader
	;of lib/media/bits.inc, (str (nums at)), high bit first, and at moved
	;past them. The str is to have 4 bytes past the last bit read

	(vp-rdef (in n e num at p v x)
		'(:r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(list-bind-args :r1 `(,in ,n) '(:obj :num))
	(media-bits-read in n e num at p v x)
	(call :num :create `(,v) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-bits-get reader n)" +error_msg_wrong_types))
	(signature '(:list :num)))

(def-func-end)

(def-func (path-to-absolute "./media_bits_1"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r10, :r14, :f0-:f15
	;info
	;(media-bits-1 reader) -> 0 | 1, the next bit of a reader of
	;lib/media/bits.inc, (str (nums at)), and at moved past it

	(vp-rdef (in e num at p v x)
		'(:r3 :r5 :r6 :r7 :r8 :r9 :r10))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(list-bind-args :r1 `(,in) '(:obj))
	(media-bits-read in 1 e num at p v x)
	(call :num :create `(,v) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-bits-1 reader)" +error_msg_wrong_types))
	(signature '(:list)))

(def-func-end)

(def-func (path-to-absolute "./media_noise"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r12, :r14, :f0-:f15
	;info
	;(media-noise out start end seed scale) -> seed, the reals of out from
	;start to end each the next of the generator of lib/media/noise.inc,
	;seed by 1664525 and 1013904223 of 32 bits, less 2^31, by scale

	(vp-rdef (out start end seed scale p e half mul add)
		'(:r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,start ,end ,seed ,scale) '(:obj :num :num :num :obj))
	(vp-cpy-if scale +num_value :f1)
	(assign `((,out +array_begin)) `(,p))
	(vp-shl-cr 3 start)
	(vp-shl-cr 3 end)
	(vp-lea-d p end e)
	(vp-add-rr start p)
	(vp-cpy-cr 1 half)
	(vp-shl-cr 31 half)
	(vp-cpy-cr 1664525 mul)
	(vp-cpy-cr 1013904223 add)
	(vpif `(,p < ,e))
		(loop-start)
			(vp-mul-rr mul seed)
			(vp-add-rr add seed)
			(vp-shl-cr 32 seed)
			(vp-shr-cr 32 seed)
			(vp-cpy-rr seed end)
			(vp-sub-rr half end)
			(vp-cvt-rf end :f0)
			(vp-mul-ff :f1 :f0)
			(vp-cpy-fi :f0 p 0)
			(vp-add-cr +long_size p)
		(loop-until `(,p = ,e))
	(endif)
	(call :num :create `(,seed) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-noise out start end seed scale)" +error_msg_wrong_types))
	(signature '(:reals :num :num :num :real)))

(def-func-end)

(defun media-read (data at n v x y)
	;the next n bits of the str data at bit at, high bit first, into v, and
	;at moved past them. n a reg or a constant, x and y trashed
	(vp-cpy-rr at x)
	(vp-shr-cr 3 x)
	(vp-add-rr data x)
	(vp-cpy-ir-ub x +str_data v)
	(each (lambda (i)
			(vp-shl-cr 8 v)
			(vp-cpy-ir-ub x (+ +str_data i) y)
			(vp-add-rr y v))
		'(1 2 3))
	(vp-cpy-rr at y)
	(vp-and-cr 7 y)
	(vp-shl-rr y v)
	(vp-cpy-cr 32 y)
	(if (num? n) (vp-sub-cr n y) (vp-sub-rr n y))
	(vp-shr-rr y v)
	(vp-cpy-cr 1 y)
	(if (num? n) (vp-shl-cr n y) (vp-shl-rr n y))
	(vp-sub-cr 1 y)
	(vp-and-rr y v)
	(if (num? n) (vp-add-cr n at) (vp-add-rr n at)))

(def-func (path-to-absolute "./media_ac3_mantissas"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f1
	;info
	;(media-ac3-mantissas reader bap exps start end out groups noise dither
	;table) -> out, the coefficients of AC-3 bins start to end into out, each
	;its mantissa by 2^-exponent, read from a reader of lib/media/bits.inc.
	;bap 1, 2 and 4 are codes of 5, 7 and 7 bits of 3, 3 and 2 levels,
	;groups the nums of the count left and the code of each, shared by the
	;channels of a block; the levels of a code from table, at 0, 96 and
	;480, 3, 3 and 2 a code in the order they are used. bap 3 and 5 are 3
	;and 4 bits, their levels at 736 and 744; 6 to 15 numbers of 5 to 16
	;bits. bap 0 is noise of the reals noise, or 0 if dither is 0

	(vp-rdef (in bap exps bin end out groups noise dither table at b v x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 10)

	(vp-push :r0)
	(list-bind-args :r1 `(,in ,bap ,exps ,bin ,end ,out ,groups ,noise ,dither ,table)
		'(:obj :obj :obj :num :num :obj :obj :obj :num :obj))
	(vp-push out)
	;the reader's str and the nums of its place
	(assign `((,in +array_begin)) `(,x))
	(assign `((,x 0) (,x +ptr_size)) `(,in ,x))
	(assign `((,x +array_begin)) `(,x))
	(vp-push x)
	(assign `((,x 0)) `(,at))
	(assign `((,bap +array_begin) (,exps +array_begin) (,out +array_begin) (,groups +array_begin)
		(,noise +array_begin) (,table +array_begin)) `(,bap ,exps ,out ,groups ,noise ,table))
	(vpif `(,bin < ,end))
	(loop-start)
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr bap x b)
		(vpif `(,b = 0))
			(vpif `(,dither /= 0))
				(vp-cpy-df noise x :f0)
			(else)
				(vp-xor-rr v v)
				(vp-cvt-rf v :f0)
			(endif)
		(elseif `(,b < 6))
			(vpif `(,b = 3))
				(media-read in at 3 v x y)
				(vp-add-cr 736 v)
			(elseif `(,b = 5))
				(media-read in at 4 v x y)
				(vp-add-cr 744 v)
			(else)
				;a level of a code, a new code when the last is used up
				(each (lambda ((k off bits levels base))
						(if (= k 1) (vpif `(,b = 1)) (if (= k 2) (elseif `(,b = 2)) (else)))
						(assign `((,groups ,off)) `(,b))
						(vpif `(,b = 0))
							(media-read in at bits v x y)
							(assign `(,v) `((,groups ,(+ off 8))))
							(vp-cpy-cr levels b)
						(endif)
						(vp-sub-cr 1 b)
						(assign `(,b) `((,groups ,off)))
						(assign `((,groups ,(+ off 8))) `(,v))
						(vp-mul-cr levels v)
						(vp-add-rr b v)
						(vp-add-cr base v))
					'((1 0 5 3 0) (2 16 7 3 96) (4 32 7 2 480)))
				(endif)
			(endif)
			(vp-shl-cr 3 v)
			(vp-cpy-df table v :f0)
		(else)
			;a number of q bits, q b - 1 to 13 bits, then 14 and 16, by 2^-(q-1)
			(vpif `(,b < 14))
				(vp-sub-cr 1 b)
			(else)
				(vp-add-rr b b)
				(vp-sub-cr 14 b)
			(endif)
			(media-read in at b v x y)
			(vp-cpy-cr 64 x)
			(vp-sub-rr b x)
			(vp-shl-rr x v)
			(vp-asr-rr x v)
			(vp-cvt-rf v :f0)
			(vp-sub-cr 1 b)
			(vp-cpy-cr 1 y)
			(vp-shl-rr b y)
			(vp-cvt-rf y :f1)
			(vp-div-ff :f1 :f0)
		(endif)
		;by 2^-exponent
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr exps x b)
		(vp-cpy-cr 1 y)
		(vp-shl-rr b y)
		(vp-cvt-rf y :f1)
		(vp-div-ff :f1 :f0)
		(vp-cpy-fd :f0 out x)
		(vp-add-cr 1 bin)
	(loop-until `(,bin = ,end))
	(endif)
	;the reader's place
	(vp-pop x)
	(assign `(,at) `((,x 0)))
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-mantissas reader bap exps start end out groups noise dither table)" +error_msg_wrong_types))
	(signature '(:list :nums :nums :num :num :reals :nums :reals :num :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_ac3_psd"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-ac3-psd exps start end psd band_psd band_start bin_band log_add)
	;-> psd, of AC-3's bit allocation, nums all: the power of each bin start
	;to end from its exponent, 3072 less 128 a step, and of each band, the
	;first 28 bins a band each, the bins of the others added as logs are,
	;by the table log_add. band_psd is 50 long and made 0 first

	(vp-rdef (exps bin end psd band_psd band_start bin_band log_add v p x band top)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 8)

	(vp-push :r0)
	(list-bind-args :r1 `(,exps ,bin ,end ,psd ,band_psd ,band_start ,bin_band ,log_add)
		'(:obj :num :num :obj :obj :obj :obj :obj))
	(vp-push psd)
	(assign `((,exps +array_begin) (,psd +array_begin) (,band_psd +array_begin)
		(,band_start +array_begin) (,bin_band +array_begin) (,log_add +array_begin))
		`(,exps ,psd ,band_psd ,band_start ,bin_band ,log_add))
	;the bands made 0
	(vp-xor-rr v v)
	(vp-cpy-cr 0 x)
	(loop-start)
		(vp-cpy-rd v band_psd x)
		(vp-add-cr +long_size x)
	(loop-until `(,x = ,(* 50 +long_size)))
	;the power of each bin
	(vpif `(,bin < ,end))
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-rr end p)
		(vp-shl-cr 3 p)
		(loop-start)
			(vp-cpy-dr exps x v)
			(vp-shl-cr 7 v)
			(vp-cpy-cr 3072 top)
			(vp-sub-rr v top)
			(vp-cpy-rd top psd x)
			(vp-add-cr +long_size x)
		(loop-until `(,x = ,p))
	(endif)
	;the first 28 a band each
	(vpif `(,bin < ,end) `(,bin < 28))
	(loop-start)
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr psd x v)
		(vp-cpy-rd v band_psd x)
		(vp-add-cr 1 bin)
		(breakif `(,bin = 28))
	(loop-until `(,bin = ,end))
	(endif)
	;the rest by bands, each its bins added as logs
	(vpif `(,bin < ,end))
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr bin_band x band)
		(loop-start)
			(vp-cpy-rr bin x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr psd x v)
			;the end of this band, at most end
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-add-cr +long_size x)
			(vp-cpy-dr band_start x top)
			(vpif `(,top > ,end))
				(vp-cpy-rr end top)
			(endif)
			;the end of the band where the exponents were, done with
			(vp-cpy-rr top exps)
			(vp-add-cr 1 bin)
			(vpif `(,bin < ,exps))
			(loop-start)
				(vp-cpy-rr bin x)
				(vp-shl-cr 3 x)
				(vp-cpy-dr psd x p)
				;the higher, and the log table by how far the other is below
				(vp-cpy-rr v top)
				(vpif `(,p > ,top))
					(vp-cpy-rr p top)
				(endif)
				(vp-add-rr p v)
				(vp-add-cr 1 v)
				(vp-shr-cr 1 v)
				(vp-cpy-rr top x)
				(vp-sub-rr v x)
				(vpif `(,x > 255))
					(vp-cpy-cr 255 x)
				(endif)
				(vp-shl-cr 3 x)
				(vp-cpy-dr log_add x v)
				(vp-add-rr top v)
				(vp-add-cr 1 bin)
			(loop-until `(,bin = ,exps))
			(endif)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-rd v band_psd x)
			(vp-add-cr 1 band)
			(vp-add-cr +long_size x)
			(vp-cpy-dr band_start x x)
		(loop-until `(,end <= ,x))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-psd exps start end psd band_psd band_start bin_band log_add)" +error_msg_wrong_types))
	(signature '(:nums :num :num :nums :nums :nums :nums :nums)))

(def-func-end)

(def-func (path-to-absolute "./media_ac3_bap"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-ac3-bap psd mask start end snr floor tab bap band_start bin_band)
	;-> bap, of AC-3's bit allocation, nums all: the bits of each bin's
	;mantissa start to end, by its power above its band's mask less the SNR
	;offset, to the floor, of 32 a step, the address in tab, 0 to 63

	(vp-rdef (psd mask bin end snr floor tab bap band_start bin_band m to x band)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 10)

	(vp-push :r0)
	(list-bind-args :r1 `(,psd ,mask ,bin ,end ,snr ,floor ,tab ,bap ,band_start ,bin_band)
		'(:obj :obj :num :num :num :num :obj :obj :obj :obj))
	(vp-push bap)
	(assign `((,psd +array_begin) (,mask +array_begin) (,tab +array_begin) (,bap +array_begin)
		(,band_start +array_begin) (,bin_band +array_begin))
		`(,psd ,mask ,tab ,bap ,band_start ,bin_band))
	(vpif `(,bin < ,end))
	(loop-start)
		;the band, and where it ends: the first 28 bins a band each
		(vpif `(,bin < 28))
			(vp-cpy-rr bin band)
			(vp-lea-i bin 1 to)
		(else)
			(vp-cpy-rr bin x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bin_band x band)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-add-cr +long_size x)
			(vp-cpy-dr band_start x to)
			(vpif `(,to > ,end))
				(vp-cpy-rr end to)
			(endif)
		(endif)
		;the mask of the band less the SNR offset and the floor, to 32 a
		;step, and the floor
		(vp-cpy-rr band x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr mask x m)
		(vp-sub-rr snr m)
		(vp-sub-rr floor m)
		(vpif `(,m < 0))
			(vp-xor-rr m m)
		(endif)
		(vp-and-cr 0x1fe0 m)
		(vp-add-rr floor m)
		(loop-start)
			(vp-cpy-rr bin x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr psd x band)
			(vp-sub-rr m band)
			(vp-asr-cr 5 band)
			(vpif `(,band < 0))
				(vp-xor-rr band band)
			(elseif `(,band > 63))
				(vp-cpy-cr 63 band)
			(endif)
			(vp-shl-cr 3 band)
			(vp-cpy-dr tab band band)
			(vp-cpy-rd band bap x)
			(vp-add-cr 1 bin)
		(loop-until `(,bin = ,to))
	(loop-until `(,bin = ,end))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-bap psd mask start end snr floor tab bap band_start bin_band)" +error_msg_wrong_types))
	(signature '(:nums :nums :num :num :num :num :nums :nums :nums :nums)))

(def-func-end)

(defun ac3-lc1 (a b0 b1 c y)
	;the low frequency compensation a, by the power of a band b0 and the
	;next b1: c if b1 is 256 above, 64 less, to 0, if b0 is the higher
	(vp-lea-i b0 256 y)
	(vpif `(,y = ,b1))
		(vp-cpy-cr c a)
	(elseif `(,b0 > ,b1))
		(vp-sub-cr 64 a)
		(vpif `(,a < 0))
			(vp-xor-rr a a)
		(endif)
	(endif))

(defun ac3-max (a b)
	;a the higher of a and b
	(vpif `(,a < ,b))
		(vp-cpy-rr b a)
	(endif))

(defun ac3-leaks (fl sl t fg prm y)
	;the fast and slow leaks of a band of power t, each by its decay or the
	;power less its gain, whichever is the higher
	(assign `((,prm 8)) `(,y))
	(vp-sub-rr y fl)
	(vp-cpy-rr t y)
	(vp-sub-rr fg y)
	(ac3-max fl y)
	;the slow by its gain, max(sl - decay, t - gain) as max(sl - decay +
	;gain, t) - gain, with the one spare
	(assign `((,prm 16)) `(,y))
	(vp-sub-rr y sl)
	(assign `((,prm 0)) `(,y))
	(vp-add-rr y sl)
	(ac3-max sl t)
	(vp-sub-rr y sl))

(def-func (path-to-absolute "./media_ac3_mask"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-ac3-mask band_psd start end fast_gain lfe params threshold
	;bin_band mask) -> mask, of AC-3's bit allocation, the masking curve of
	;each band of bins start to end: the excitation by the fast and slow
	;leaks of the bands, of the first 22 the low frequency compensation too
	;and of the coupling channel its leaks from the stream, raised where
	;the power is under the dB a bit, and the threshold of hearing at least.
	;params is nums of the slow gain, fast decay, slow decay, dB a bit, the
	;rate, the coupling fast and slow leaks; threshold nums of 3 rates a
	;band; lfe 1 for the LFE. All nums, mask 50 long

	(vp-rdef (bpsd mask prm fg lfe band begin bend lowcomp fl sl t u x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 9)

	(vp-push :r0)
	(list-bind-args :r1 `(,bpsd ,begin ,bend ,fg ,lfe ,prm ,t ,u ,mask)
		'(:obj :num :num :num :num :obj :obj :obj :obj))
	(vp-push mask)
	(vp-push t)
	(assign `((,bpsd +array_begin) (,prm +array_begin) (,mask +array_begin) (,u +array_begin))
		`(,bpsd ,prm ,mask ,u))
	;the bands of the bins, the first and one past the last
	(vp-shl-cr 3 begin)
	(vp-cpy-dr u begin begin)
	(vp-sub-cr 1 bend)
	(vp-shl-cr 3 bend)
	(vp-cpy-dr u bend bend)
	(vp-add-cr 1 bend)
	(vp-push begin)
	(vpif `(,begin = 0))
		;the first two, then on till a band is no higher than the next
		(vp-xor-rr lowcomp lowcomp)
		(each (lambda (o)
				(defq n (+ o 8))
				(assign `((,bpsd ,o) (,bpsd ,n)) `(,t ,u))
				(ac3-lc1 lowcomp t u 384 y)
				(vp-sub-rr fg t)
				(vp-sub-rr lowcomp t)
				(assign `(,t) `((,mask ,o))))
			'(0 8))
		(vp-cpy-cr 7 begin)
		(vp-cpy-cr 2 band)
		(loop-start 'low_bands)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bpsd x t)
			(vp-add-cr 8 x)
			(vp-cpy-dr bpsd x u)
			;the LFE's band 6 leaves the compensation as it is
			(vp-xor-rr y y)
			(vpif `(,lfe /= 0) `(,band = 6))
				(vp-cpy-cr 1 y)
			(endif)
			(vpif `(,y = 0))
				(ac3-lc1 lowcomp t u 384 y)
				(vp-xor-rr y y)
			(endif)
			(vp-cpy-rr t fl)
			(vp-sub-rr fg fl)
			(assign `((,prm 0)) `(,x))
			(vp-cpy-rr t sl)
			(vp-sub-rr x sl)
			(vp-cpy-rr fl x)
			(vp-sub-rr lowcomp x)
			(vp-push x)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-pop y)
			(vp-cpy-rd y mask x)
			;the LFE's band 6 again, for the test
			(vp-xor-rr y y)
			(vpif `(,lfe /= 0) `(,band = 6))
				(vp-cpy-cr 1 y)
			(endif)
			(vpif `(,y = 0) `(,t <= ,u))
				(vp-lea-i band 1 begin)
				(break 'low_bands)
			(endif)
			(vp-add-cr 1 band)
		(loop-until `(,band = 7))
		;on to band 22, or the end, the compensation by the band
		(vp-cpy-rr begin band)
		(vp-cpy-rr bend begin)
		(vpif `(,begin > 22))
			(vp-cpy-cr 22 begin)
		(endif)
		(vpif `(,band < ,begin))
		(loop-start)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bpsd x t)
			(vp-add-cr 8 x)
			(vp-cpy-dr bpsd x u)
			(vp-xor-rr y y)
			(vpif `(,lfe /= 0) `(,band = 6))
				(vp-cpy-cr 1 y)
			(endif)
			(vpif `(,y = 0))
				(vpif `(,band < 7))
					(ac3-lc1 lowcomp t u 384 y)
				(elseif `(,band < 20))
					(ac3-lc1 lowcomp t u 320 y)
				(else)
					(vp-sub-cr 128 lowcomp)
					(vpif `(,lowcomp < 0))
						(vp-xor-rr lowcomp lowcomp)
					(endif)
				(endif)
			(endif)
			(ac3-leaks fl sl t fg prm y)
			(vp-cpy-rr fl x)
			(vp-sub-rr lowcomp x)
			(ac3-max x sl)
			(vp-cpy-rr band y)
			(vp-shl-cr 3 y)
			(vp-cpy-rd x mask y)
			(vp-add-cr 1 band)
		(loop-until `(,band = ,begin))
		(endif)
		(vp-cpy-cr 22 begin)
	(else)
		;the coupling channel, its leaks from the stream
		(assign `((,prm 40) (,prm 48)) `(,fl ,sl))
		(vp-shl-cr 8 fl)
		(vp-add-cr 768 fl)
		(vp-shl-cr 8 sl)
		(vp-add-cr 768 sl)
	(endif)
	;the rest by the leaks alone
	(vpif `(,begin < ,bend))
		(vp-cpy-rr begin band)
		(loop-start)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bpsd x t)
			(ac3-leaks fl sl t fg prm y)
			(vp-cpy-rr fl y)
			(ac3-max y sl)
			(vp-cpy-rd y mask x)
			(vp-add-cr 1 band)
		(loop-until `(,band = ,bend))
	(endif)
	;the mask, raised where the power is under the dB a bit, the threshold
	;of hearing of the band at the rate at least
	(vp-pop band)
	(vp-pop t)
	(assign `((,t +array_begin)) `(,t))
	(vpif `(,band < ,bend))
	(loop-start)
		(vp-cpy-rr band x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr mask x u)
		(assign `((,prm 24)) `(,y))
		(vp-cpy-dr bpsd x fl)
		(vp-sub-rr fl y)
		(vpif `(,y > 0))
			(vp-shr-cr 2 y)
			(vp-add-rr y u)
		(endif)
		(vp-cpy-rr band y)
		(vp-mul-cr 3 y)
		(assign `((,prm 32)) `(,fl))
		(vp-add-rr fl y)
		(vp-shl-cr 3 y)
		(vp-cpy-dr t y y)
		(ac3-max u y)
		(vp-cpy-rd u mask x)
		(vp-add-cr 1 band)
	(loop-until `(,band = ,bend))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-mask band_psd start end fast_gain lfe params threshold bin_band mask)" +error_msg_wrong_types))
	(signature '(:nums :num :num :num :num :nums :nums :nums :nums)))

(def-func-end)

(defun aht-signed (data at n v x y)
	;a number of n bits, n a reg, two's complement, into v
	(media-read data at n v x y)
	(vp-cpy-cr 64 x)
	(vp-sub-rr n x)
	(vp-shl-rr x v)
	(vp-asr-rr x v))

(defun aht-by-2 (k f t x)
	;the float f by 2^-k, k a reg, t a float to use
	(vp-cpy-cr 1 x)
	(vp-shl-rr k x)
	(vp-cvt-rf x t)
	(vp-div-ff t f))

(def-func (path-to-absolute "./media_ac3_aht"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(media-ac3-aht reader bap exps start end top gains out vq consts itab
	;state) -> out, the mantissas of a channel of E-AC-3's adaptive hybrid
	;transform for all 6 blocks, read from a reader of lib/media/bits.inc,
	;by its high efficiency bap: 0 noise of 0.5, the seed of the generator
	;of lib/media/noise.inc first in the nums state; 1 to 7 a vector of 6
	;of the reals vq, at the offset itab has after the bits of each bap; 8
	;and more 6 numbers of the gain adaptive quantisation, of the gain of
	;gains in turn where the bap is under top, remapped by consts. Then the
	;DCT of 6 back across the blocks, each by 2^-exponent, into out, 6
	;blocks of 256. consts: the remap without a gain 12, of a large number
	;by a gain of 2 and 4 18 and 18, 2^-1, 2^-2, the DCT's root 2 by cos
	;2, 0 and 5 twelfths of pi, 0.5, and the noise's scale

	(vp-rdef (data at bin gains bap out g n consts gi b v top x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))
	(defq fs '(:f0 :f1 :f2 :f3 :f4 :f5) s_end 0 s_vq 8 s_itab 16 s_exps 24 s_state 32 s_atp 40 s_size 48)

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 12)

	(vp-push :r0)
	(list-bind-args :r1 `(,data ,bap ,v ,bin ,x ,top ,gains ,out ,n ,consts ,g ,b)
		'(:obj :obj :obj :num :num :num :obj :obj :obj :obj :obj :obj))
	(vp-push out)
	(vp-alloc s_size)
	;the end, vq, itab, the exponents and the state on the stack
	(assign `((,v +array_begin) (,n +array_begin) (,g +array_begin) (,b +array_begin))
		`(,v ,n ,g ,b))
	(assign `(,x ,n ,g ,v ,b) `((:rsp ,s_end) (:rsp ,s_vq) (:rsp ,s_itab) (:rsp ,s_exps) (:rsp ,s_state)))
	;the reader's str and the nums of its place
	(assign `((,data +array_begin)) `(,x))
	(assign `((,x 0) (,x +ptr_size)) `(,data ,x))
	(assign `((,x +array_begin)) `(,x))
	(assign `(,x) `((:rsp ,s_atp)))
	(assign `((,x 0)) `(,at))
	(assign `((,bap +array_begin) (,gains +array_begin) (,out +array_begin) (,consts +array_begin))
		`(,bap ,gains ,out ,consts))
	(vp-xor-rr gi gi)
	(assign `((:rsp ,s_end)) `(,x))
	(vpif `(,bin < ,x))
	(loop-start)
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr bap x b)
		(vpif `(,b = 0))
			;noise, the next 6 of the generator, by its scale
			(assign `((:rsp ,s_state)) `(,x))
			(assign `((,x 0)) `(,v))
			(vp-cpy-if consts (* 54 +long_size) :f6)
			(each (lambda (f)
					(vp-cpy-cr 1664525 x)
					(vp-mul-rr x v)
					(vp-cpy-cr 1013904223 x)
					(vp-add-rr x v)
					(vp-shl-cr 32 v)
					(vp-shr-cr 32 v)
					(vp-cpy-cr 1 x)
					(vp-shl-cr 31 x)
					(vp-cpy-rr v y)
					(vp-sub-rr x y)
					(vp-cvt-rf y f)
					(vp-mul-ff :f6 f))
				fs)
			(assign `((:rsp ,s_state)) `(,x))
			(assign `(,v) `((,x 0)))
		(elseif `(,b < 8))
			;a vector of 6, by a code of the bits of the bap
			(assign `((:rsp ,s_itab)) `(,y))
			(vp-cpy-rr b x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr y x n)
			(media-read data at n v x y)
			(vp-mul-cr 6 v)
			(assign `((:rsp ,s_itab)) `(,y))
			(vp-cpy-rr b x)
			(vp-add-cr 20 x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr y x x)
			(vp-add-rr x v)
			(vp-shl-cr 3 v)
			(assign `((:rsp ,s_vq)) `(,x))
			(vp-add-rr x v)
			(each (lambda (f)
					(vp-cpy-if v (* (!) +long_size) f))
				fs)
		(else)
			;6 numbers of the gain adaptive quantisation, of the gain of
			;the next of gains where the bap is under top
			(vp-xor-rr g g)
			(vpif `(,b < ,top))
				(vp-cpy-rr gi x)
				(vp-shl-cr 3 x)
				(vp-cpy-dr gains x g)
				(vp-add-cr 1 gi)
			(endif)
			(each (lambda (f)
					;the bits of the bap, less the gain
					(assign `((:rsp ,s_itab)) `(,y))
					(vp-cpy-rr b x)
					(vp-shl-cr 3 x)
					(vp-cpy-dr y x n)
					(vp-sub-rr g n)
					(aht-signed data at n v x y)
					;a large number, escaped by the least of the fewer bits
					(vp-cpy-rr n x)
					(vp-sub-cr 1 x)
					(vp-cpy-cr 1 y)
					(vp-shl-rr x y)
					(vp-xor-rr x x)
					(vp-sub-rr y x)
					(vpif `(,g /= 0) `(,v = ,x))
						;its own bits, the bap's less 2 and more the gain
						(vp-add-rr g n)
						(vp-sub-cr 2 n)
						(vp-add-rr g n)
						(aht-signed data at n v x y)
						(vp-cvt-rf v f)
						(vp-sub-cr 1 n)
						(aht-by-2 n f :f6 x)
						;more itself by a, and 2^-gain or b by its sign
						(vp-cpy-rr b x)
						(vp-sub-cr 8 x)
						(vp-add-rr x x)
						(vp-add-rr g x)
						(vp-sub-cr 1 x)
						(vp-shl-cr 3 x)
						(vp-add-rr consts x)
						(vp-cpy-if x (* 12 +long_size) :f7)
						(vp-mul-ff f :f7)
						(vp-add-ff :f7 f)
						(vpif `(,v >= 0))
							(vp-cpy-rr g x)
							(vp-shl-cr 3 x)
							(vp-add-rr consts x)
							(vp-cpy-if x (* 47 +long_size) :f7)
						(else)
							(vp-cpy-if x (* 30 +long_size) :f7)
						(endif)
						(vp-add-ff :f7 f)
					(else)
						;of the bap's bits, without a gain remapped
						(vp-cvt-rf v f)
						(assign `((:rsp ,s_itab)) `(,y))
						(vp-cpy-rr b x)
						(vp-shl-cr 3 x)
						(vp-cpy-dr y x n)
						(vp-sub-cr 1 n)
						(aht-by-2 n f :f6 x)
						(vpif `(,g = 0))
							(vp-cpy-rr b x)
							(vp-sub-cr 8 x)
							(vp-shl-cr 3 x)
							(vp-cpy-df consts x :f7)
							(vp-mul-ff f :f7)
							(vp-add-ff :f7 f)
						(endif)
					(endif))
				fs)
		(endif)
		;the DCT of 6 back across the blocks: even2 tmp odd0 odd1 even1
		;even0 in f6 to f11
		(vp-cpy-if consts (* 50 +long_size) :f12)
		(vp-cpy-if consts (* 51 +long_size) :f13)
		(vp-cpy-if consts (* 52 +long_size) :f14)
		(vp-cpy-if consts (* 53 +long_size) :f15)
		(vp-cpy-ff :f2 :f6)
		(vp-mul-ff :f12 :f6)
		(vp-cpy-ff :f4 :f7)
		(vp-mul-ff :f13 :f7)
		(vp-cpy-ff :f1 :f8)
		(vp-add-ff :f5 :f8)
		(vp-mul-ff :f14 :f8)
		(vp-cpy-ff :f1 :f9)
		(vp-sub-ff :f3 :f9)
		(vp-sub-ff :f5 :f9)
		(vp-cpy-ff :f0 :f10)
		(vp-sub-ff :f7 :f10)
		(vp-mul-ff :f15 :f7)
		(vp-cpy-ff :f0 :f11)
		(vp-add-ff :f7 :f11)
		;e0 f12, e2 f13, o0 f14, o2 f15
		(vp-cpy-ff :f11 :f12)
		(vp-add-ff :f6 :f12)
		(vp-cpy-ff :f11 :f13)
		(vp-sub-ff :f6 :f13)
		(vp-cpy-ff :f8 :f14)
		(vp-add-ff :f1 :f14)
		(vp-add-ff :f3 :f14)
		(vp-cpy-ff :f8 :f15)
		(vp-add-ff :f5 :f15)
		(vp-sub-ff :f3 :f15)
		(vp-cpy-ff :f12 :f0)
		(vp-add-ff :f14 :f0)
		(vp-cpy-ff :f10 :f1)
		(vp-add-ff :f9 :f1)
		(vp-cpy-ff :f13 :f2)
		(vp-add-ff :f15 :f2)
		(vp-cpy-ff :f13 :f3)
		(vp-sub-ff :f15 :f3)
		(vp-cpy-ff :f10 :f4)
		(vp-sub-ff :f9 :f4)
		(vp-cpy-ff :f12 :f5)
		(vp-sub-ff :f14 :f5)
		;each by 2^-exponent, to its block
		(assign `((:rsp ,s_exps)) `(,y))
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr y x n)
		(vp-cpy-cr 1 y)
		(vp-shl-rr n y)
		(vp-cvt-rf y :f6)
		(vp-add-rr out x)
		(each (lambda (f)
				(vp-div-ff :f6 f)
				(vp-cpy-fi f x (* (!) 256 +long_size)))
			fs)
		(vp-add-cr 1 bin)
		(assign `((:rsp ,s_end)) `(,x))
	(loop-until `(,bin = ,x))
	(endif)
	;the reader's place
	(assign `((:rsp ,s_atp)) `(,x))
	(assign `(,at) `((,x 0)))
	(vp-free s_size)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-aht reader bap exps start end top gains out vq consts itab state)" +error_msg_wrong_types))
	(signature '(:list :nums :nums :num :num :num :nums :reals :reals :reals :nums :nums)))

(def-func-end)

(def-func (path-to-absolute "./media_lpc"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11, :f0-:f2
	;info
	;(media-lpc out start count step lpc) -> out, the all pole filter of the
	;reals lpc, its first the 1 it is of, run over count reals of out in
	;place, from start a step of 1 or -1 at a time: each less the sum of
	;the outputs before it by lpc 1 on, as many as there are before it

	(vp-rdef (out p n s l o k m q j)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,p ,n ,s ,l) '(:obj :num :num :num :obj))
	(vp-push out)
	(assign `((,l +array_length ui) (,l +array_begin) (,out +array_begin)) `(,o ,l ,out))
	(vp-sub-cr 1 o)
	(vp-shl-cr 3 p)
	(vp-add-rr out p)
	(vp-shl-cr 3 s)
	(vp-xor-rr k k)
	(vpif `(,n > 0))
	(loop-start)
		(vp-cpy-if p 0 :f0)
		;as many of the outputs before it as there are, to the order
		(vp-cpy-rr k m)
		(vpif `(,m > ,o))
			(vp-cpy-rr o m)
		(endif)
		(vpif `(,m > 0))
			(vp-cpy-rr p q)
			(vp-lea-i l +long_size j)
			(loop-start)
				(vp-sub-rr s q)
				(vp-cpy-if q 0 :f1)
				(vp-cpy-if j 0 :f2)
				(vp-mul-ff :f2 :f1)
				(vp-sub-ff :f1 :f0)
				(vp-add-cr +long_size j)
				(vp-sub-cr 1 m)
			(loop-until `(,m = 0))
		(endif)
		(vp-cpy-fi :f0 p 0)
		(vp-add-rr s p)
		(vp-add-cr 1 k)
	(loop-until `(,k = ,n))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-lpc out start count step lpc)" +error_msg_wrong_types))
	(signature '(:reals :num :num :num :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_matvec"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11, :f0-:f2
	;info
	;(media-matvec matrix rows cols x from out) -> out, the matrix, reals of
	;rows of cols one after another, by cols reals of x from from: each
	;row's sum of its products into out, as many as rows

	(vp-rdef (m rows cols x from out r c p q)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(vp-push :r0)
	(list-bind-args :r1 `(,m ,rows ,cols ,x ,from ,out) '(:obj :num :num :obj :num :obj))
	(vp-push out)
	(assign `((,m +array_begin) (,x +array_begin) (,out +array_begin)) `(,m ,x ,out))
	(vp-shl-cr 3 from)
	(vp-add-rr from x)
	(vpif `(,rows > 0) `(,cols > 0))
		(vp-xor-rr r r)
		(loop-start)
			(vp-cpy-rr x q)
			(vp-cpy-rr cols c)
			(vp-xor-rr p p)
			(vp-cvt-rf p :f0)
			(loop-start)
				(vp-cpy-if m 0 :f1)
				(vp-cpy-if q 0 :f2)
				(vp-mul-ff :f2 :f1)
				(vp-add-ff :f1 :f0)
				(vp-add-cr +long_size m)
				(vp-add-cr +long_size q)
				(vp-sub-cr 1 c)
			(loop-until `(,c = 0))
			(vp-cpy-fi :f0 out 0)
			(vp-add-cr +long_size out)
			(vp-add-cr 1 r)
		(loop-until `(,r = ,rows))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-matvec matrix rows cols x from out)" +error_msg_wrong_types))
	(signature '(:reals :num :num :reals :num :reals)))

(def-func-end)

(defun mp3-sign (v n x y data at)
	;v of the other sign if the next bit is 1, if v is not 0
	(vpif `(,v /= 0))
		(media-read data at 1 n x y)
		(vpif `(,n /= 0))
			(vp-xor-rr x x)
			(vp-sub-rr v x)
			(vp-cpy-rr x v)
		(endif)
	(endif))

(def-func (path-to-absolute "./media_mp3_lines"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-mp3-lines reader lines end regions quad) -> lines, the 576 lines
	;of a granule's channel of MP3 into the nums lines, quantised and signed,
	;read from a reader of lib/media/bits.inc to the bit end: the big values
	;by regions, a list of the pairs, the book's table, its nums of x by 16
	;and y, and the more bits of each of 3, a table of no length the pairs
	;0; each value of 15 more by its bits, then each not 0 its sign. Then
	;quads of 1 and 0 by the table quad till the end, one that goes past it
	;not had. The reader left at the end. The tables of lib/media/huff.inc

	(vp-rdef (data at lp idx end table xy lin n level e x byte y w)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))
	(defq s_atp 0 s_reg 8 s_cnt 16 s_quad 24 s_size 32)

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-push :r0)
	(list-bind-args :r1 `(,data ,lp ,end ,table ,level) '(:obj :obj :num :obj :obj))
	(vp-push lp)
	(vp-alloc s_size)
	(assign `((,table +array_begin) (,level +array_begin)) `(,table ,level))
	(vp-cpy-cr 3 x)
	(assign `(,table ,x ,level) `((:rsp ,s_reg) (:rsp ,s_cnt) (:rsp ,s_quad)))
	;the reader's str and the nums of its place
	(assign `((,data +array_begin)) `(,x))
	(assign `((,x 0) (,x +ptr_size)) `(,data ,x))
	(assign `((,x +array_begin)) `(,x))
	(assign `(,x) `((:rsp ,s_atp)))
	(assign `((,x 0)) `(,at))
	(assign `((,lp +array_begin)) `(,lp))
	(vp-xor-rr idx idx)
	;the big values, region by region
	(loop-start)
		(assign `((:rsp ,s_reg)) `(,x))
		(assign `((,x 0) (,x 8) (,x 16) (,x 24)) `(,n ,table ,xy ,lin))
		(assign `((,n +num_value) (,lin +num_value)) `(,n ,lin))
		(vp-add-cr 32 x)
		(assign `(,x) `((:rsp ,s_reg)))
		(assign `((,table +array_length ui)) `(,e))
		(vpif `(,e = 0))
			(vp-add-rr n idx)
			(vp-add-rr n idx)
		(elseif `(,n > 0) `(,at < ,end))
			(assign `((,table +array_begin) (,xy +array_begin)) `(,table ,xy))
			(loop-start)
				(huff-walk data +str_data at table e byte x level)
				;x high and y low
				(vp-shl-cr 3 e)
				(vp-cpy-dr xy e byte)
				(vp-cpy-rr byte level)
				(vp-and-cr 15 level)
				(vp-shr-cr 4 byte)
				(each (lambda (v)
						(vpif `(,v = 15) `(,lin > 0))
							(media-read data at lin w x y)
							(vp-add-rr w v)
						(endif)
						(mp3-sign v w x y data at))
					(list byte level))
				(vp-cpy-rr idx x)
				(vp-shl-cr 3 x)
				(vp-add-rr lp x)
				(assign `(,byte ,level) `((,x 0) (,x 8)))
				(vp-add-cr 2 idx)
				(vp-sub-cr 1 n)
				(breakif `(,at >= ,end))
			(loop-until `(,n = 0))
		(endif)
		(assign `((:rsp ,s_cnt)) `(,x))
		(vp-sub-cr 1 x)
		(assign `(,x) `((:rsp ,s_cnt)))
	(loop-until `(,x = 0))
	;the quads of the count1 lines
	(vpif `(,idx <= 572) `(,at < ,end))
	(loop-start 'quads)
		(assign `((:rsp ,s_quad)) `(,table))
		(huff-walk data +str_data at table e byte x level)
		(each (lambda (bit k)
				(vp-cpy-rr e byte)
				(vp-and-cr bit byte)
				(vpif `(,byte /= 0))
					(vp-cpy-cr 1 byte)
					(mp3-sign byte w x y data at)
				(endif)
				(vp-cpy-rr idx x)
				(vp-shl-cr 3 x)
				(vp-add-rr lp x)
				(assign `(,byte) `((,x ,(* k 8)))))
			'(8 4 2 1) '(0 1 2 3))
		;past the end, not had
		(vpif `(,at > ,end))
			(vp-xor-rr byte byte)
			(assign `(,byte ,byte ,byte ,byte) `((,x 0) (,x 8) (,x 16) (,x 24)))
			(break 'quads)
		(endif)
		(vp-add-cr 4 idx)
		(breakif `(,idx > 572))
	(loop-until `(,at >= ,end))
	(endif)
	;the reader at the end of the part
	(assign `((:rsp ,s_atp)) `(,x))
	(assign `(,end) `((,x 0)))
	(vp-free s_size)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-mp3-lines reader lines end regions quad)" +error_msg_wrong_types))
	(signature '(:list :nums :num :list :nums)))

(def-func-end)

(def-func (path-to-absolute "./media_aac_values"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-aac-values reader table values lines from to kind) -> lines, the
	;quantised lines of AAC from from to to, one code of a book after
	;another, each its 2 or 4 values, read from a reader of
	;lib/media/bits.inc. table is the book's, lib/media/huff.inc; values
	;each code's, 6 bits each and 16 more than it is, the first highest.
	;kind the values to a code, 4 more if they are signed by the book, 8
	;more if they escape, book 11: else a sign bit after the code for each
	;that is not 0, then for each of 16 so many 1s and a 0, and 4 bits more
	;than there were 1s. The reader left after the last, or where it would
	;go past the end of its str

	(vp-rdef (data pos table vals p pend kind stop e byte x level w y q)
		'(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(defq s_atp 0 s_size 8)

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(vp-push :r0)
	(list-bind-args :r1 `(,data ,table ,vals ,p ,e ,byte ,kind) '(:obj :obj :obj :obj :num :num :num))
	(vp-push p)
	(vp-alloc s_size)
	(assign `((,table +array_begin) (,vals +array_begin) (,p +array_begin)) `(,table ,vals ,p))
	(vp-shl-cr 3 e)
	(vp-shl-cr 3 byte)
	(vp-lea-d p byte pend)
	(vp-add-rr e p)
	;the reader's str, the nums of its place, and the last bit to read
	(assign `((,data +array_begin)) `(,x))
	(assign `((,x 0) (,x +ptr_size)) `(,data ,x))
	(assign `((,x +array_begin)) `(,x))
	(assign `(,x) `((:rsp ,s_atp)))
	(assign `((,x 0) (,data +str_length ui)) `(,pos ,stop))
	(vp-shl-cr 3 stop)
	(vpif `(,p < ,pend))
	(loop-start 'codes)
		(breakif `(,pos >= ,stop) 'codes)
		(huff-walk data +str_data pos table e byte x level)
		;its values, the last first, as they are
		(vp-shl-cr 3 e)
		(vp-cpy-dr vals e q)
		(vp-cpy-rr kind x)
		(vp-and-cr 3 x)
		(vp-cpy-rr x byte)
		(vp-shl-cr 3 byte)
		(vp-add-cr 16 byte)
		(vp-add-rr p byte)
		(vp-cpy-rr byte x)
		(loop-start)
			(vp-sub-cr 8 x)
			(vp-cpy-rr q w)
			(vp-and-cr 63 w)
			(vp-sub-cr 16 w)
			(assign `(,w) `((,x 0)))
			(vp-shr-cr 6 q)
		(loop-until `(,x = ,p))
		;the signs, of an unsigned book
		(vp-cpy-rr kind w)
		(vp-and-cr 4 w)
		(vpif `(,w = 0))
			(loop-start)
				(assign `((,x 0)) `(,w))
				(mp3-sign w e level q data pos)
				(assign `(,w) `((,x 0)))
				(vp-add-cr 8 x)
			(loop-until `(,x = ,byte))
		(endif)
		;the escapes, of book 11
		(vp-cpy-rr kind w)
		(vp-and-cr 8 w)
		(vpif `(,w /= 0))
			(vp-cpy-rr p x)
			(loop-start)
				(assign `((,x 0)) `(,w))
				(vp-cpy-rr w y)
				(vpif `(,y < 0))
					(vp-mul-cr -1 y)
				(endif)
				(vpif `(,y = 16))
					;so many 1s, then a 0, not past the end
					(vp-cpy-cr 4 y)
					(loop-start)
						(breakif `(,pos >= ,stop))
						(breakif `(,y >= 13))
						(media-read data pos 1 e level q)
						(breakif `(,e = 0))
						(vp-add-cr 1 y)
					(loop-end)
					(media-read data pos y e level q)
					(vp-cpy-cr 1 level)
					(vp-shl-rr y level)
					(vp-add-rr e level)
					(vpif `(,w < 0))
						(vp-mul-cr -1 level)
					(endif)
					(assign `(,level) `((,x 0)))
				(endif)
				(vp-add-cr 8 x)
			(loop-until `(,x = ,byte))
		(endif)
		(vp-cpy-rr byte p)
	(loop-until `(,p >= ,pend))
	(endif)
	;the reader after the last read, not past its str
	(vpif `(,pos > ,stop))
		(vp-cpy-rr stop pos)
	(endif)
	(assign `((:rsp ,s_atp)) `(,x))
	(assign `(,pos) `((,x 0)))
	(vp-free s_size)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-aac-values reader table values lines from to kind)" +error_msg_wrong_types))
	(signature '(:list :nums :nums :nums :num :num :num)))

(def-func-end)

(def-func (path-to-absolute "./media_dequant"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :f0-:f1
	;info
	;(media-dequant out q from to pow gain) -> out, the lines from to of the
	;nums q, quantised and signed, each not 0 into out as the reals pow at
	;its size, at most the last of pow, by gain, of its sign, as AAC and
	;MP3 requantise, pow |v|^4/3. The rest of out left as it is

	(vp-rdef (out q i end pow n v x)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,q ,i ,end ,pow ,x) '(:obj :obj :num :num :obj :obj))
	(vp-push out)
	(vp-cpy-if x +num_value :f1)
	(assign `((,pow +array_length ui) (,out +array_begin) (,q +array_begin) (,pow +array_begin)) `(,n ,out ,q ,pow))
	(vp-sub-cr 1 n)
	(vpif `(,i < ,end))
	(loop-start)
		(vp-cpy-rr i x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr q x v)
		(vpif `(,v /= 0))
			(vpif `(,v > 0))
				(vpif `(,v > ,n))
					(vp-cpy-rr n v)
				(endif)
				(vp-shl-cr 3 v)
				(vp-cpy-df pow v :f0)
				(vp-mul-ff :f1 :f0)
			(else)
				(vp-xor-rr x x)
				(vp-sub-rr v x)
				(vpif `(,x > ,n))
					(vp-cpy-rr n x)
				(endif)
				(vp-shl-cr 3 x)
				(vp-cpy-df pow x :f0)
				(vp-mul-ff :f1 :f0)
				(vp-neg-ff :f0 :f0)
			(endif)
			(vp-cpy-rr i v)
			(vp-shl-cr 3 v)
			(vp-cpy-fd :f0 out v)
		(endif)
		(vp-add-cr 1 i)
	(loop-until `(,i = ,end))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-dequant out q from to pow gain)" +error_msg_wrong_types))
	(signature '(:reals :nums :num :num :reals :real)))

(def-func-end)

(def-func (path-to-absolute "./media_window"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f3
	;info
	;(media-window v d out at scale n parts dstep vstep doff voff) -> out,
	;the last stage of a polyphase filterbank, MP3's and SBR's, n samples
	;into out from at: each j the sum over i of parts of d dstep i + j by v
	;vstep i + j and d dstep i + doff + j by v vstep i + voff + j, by scale

	(vp-rdef (v d out j i p q n parts ds vs dof vof)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 11)

	(vp-push :r0)
	(list-bind-args :r1 `(,v ,d ,out ,j ,i ,n ,parts ,ds ,vs ,dof ,vof)
		'(:obj :obj :obj :num :obj :num :num :num :num :num :num))
	(vp-push out)
	(vp-cpy-if i +num_value :f3)
	(assign `((,v +array_begin) (,d +array_begin) (,out +array_begin)) `(,v ,d ,out))
	(vp-shl-cr 3 j)
	(vp-add-rr j out)
	(each (# (vp-shl-cr 3 %0)) (list n ds vs dof vof))
	(vp-xor-rr j j)
	(loop-start)
		(vp-xor-rr q q)
		(vp-cvt-rf q :f0)
		(vp-lea-d d j p)
		(vp-lea-d v j q)
		(vp-cpy-rr parts i)
		(loop-start)
			(vp-cpy-if p 0 :f1)
			(vp-cpy-if q 0 :f2)
			(vp-mul-ff :f2 :f1)
			(vp-add-ff :f1 :f0)
			(vp-cpy-df p dof :f1)
			(vp-cpy-df q vof :f2)
			(vp-mul-ff :f2 :f1)
			(vp-add-ff :f1 :f0)
			(vp-add-rr ds p)
			(vp-add-rr vs q)
			(vp-sub-cr 1 i)
		(loop-until `(,i = 0))
		(vp-mul-ff :f3 :f0)
		(vp-cpy-fi :f0 out 0)
		(vp-add-cr +long_size out)
		(vp-add-cr +long_size j)
	(loop-until `(,j = ,n))
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-window v d out at scale n parts dstep vstep doff voff)" +error_msg_wrong_types))
	(signature '(:reals :reals :reals :num :real :num :num :num :num :num :num)))

(def-func-end)

(def-func (path-to-absolute "./media_sbr_gains"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(media-sbr-gains ins flags lim kx delta consts out) -> out, SBR's gains
	;of an envelope, lib/media/sbr.inc sbr-gains: ins the reals orig, q and
	;energy, 48 each, flags the nums s and si, 48 each, lim the limiter
	;band edges, consts the reals one eps tiny top boost_max limgain. Into
	;out its gain, noise and sinusoid, 48 each, of each limiter band kept
	;to its limit and its energy made what was sent. In the order the Lisp
	;did it, so the samples are the same

	(vp-rdef (ins fl lim kx delta p out k nlim a b m x t)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(vp-push :r0)
	(list-bind-args :r1 `(,ins ,fl ,lim ,kx ,delta ,p ,out) '(:obj :obj :obj :num :num :obj :obj))
	(vp-push out)
	(assign `((,lim +array_length ui) (,ins +array_begin) (,fl +array_begin) (,lim +array_begin) (,p +array_begin) (,out +array_begin))
		`(,nlim ,ins ,fl ,lim ,p ,out))
	;one eps tiny top boost_max limgain, and delta as a real
	(load-fields p '(0 8 16 24 32 40) '(:f8 :f9 :f10 :f11 :f12 :f13))
	(vp-cvt-rf delta :f14)
	(vp-sub-cr 1 nlim)
	(vpif `(,nlim > 0))
		(vp-xor-rr k k)
		(loop-start)
			(vp-cpy-rr k x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr lim x a)
			(vp-add-cr +long_size x)
			(vp-cpy-dr lim x b)
			(vp-sub-rr kx a)
			(vp-sub-rr kx b)
			(vpif `(,a < ,b))
				;each band's noise, sinusoid and gain, and the sums of orig and energy
				(vp-xor-rr x x)
				(vp-cvt-rf x :f6)
				(vp-cpy-ff :f6 :f7)
				(vp-cpy-rr a m)
				(loop-start)
					(vp-cpy-rr m x)
					(vp-shl-cr 3 x)
					;orig, q and energy
					(vp-lea-d ins x p)
					(load-fields p '(0 384 768) '(:f0 :f1 :f2))
					;temp o / (one + qq), q_m sqrt temp qq
					(vp-cpy-ff :f8 :f3)
					(vp-add-ff :f1 :f3)
					(vp-cpy-ff :f0 :f4)
					(vp-div-ff :f3 :f4)
					(vp-cpy-ff :f4 :f5)
					(vp-mul-ff :f1 :f5)
					(vp-sqrt-ff :f5 :f5)
					;s_m sqrt temp si
					(vp-lea-d out x p)
					(vp-add-rr fl x)
					(vp-cpy-ir x 384 t)
					(vp-cvt-rf t :f15)
					(vp-mul-ff :f4 :f15)
					(vp-sqrt-ff :f15 :f15)
					(vp-cpy-fi :f15 p 768)
					;gain, of a band with no sinusoid or with one
					(vp-cpy-ff :f8 :f4)
					(vp-add-ff :f2 :f4)
					(vp-cpy-ir x 0 t)
					(vpif `(,t = 0))
						(vp-cpy-ff :f1 :f15)
						(vp-mul-ff :f14 :f15)
						(vp-add-ff :f8 :f15)
						(vp-mul-ff :f15 :f4)
						(vp-cpy-ff :f0 :f15)
					(else)
						(vp-mul-ff :f3 :f4)
						(vp-cpy-ff :f0 :f15)
						(vp-mul-ff :f1 :f15)
					(endif)
					(vp-div-ff :f4 :f15)
					(vp-sqrt-ff :f15 :f15)
					(vp-add-ff :f10 :f15)
					(save-fields p '(0 384) '(:f15 :f5))
					(vp-add-ff :f0 :f6)
					(vp-add-ff :f2 :f7)
					(vp-add-cr 1 m)
				(loop-until `(,m = ,b))
				;gain_max, min top limgain sqrt (eps + sum0) / (eps + sum1)
				(vp-cpy-ff :f9 :f0)
				(vp-add-ff :f6 :f0)
				(vp-cpy-ff :f9 :f1)
				(vp-add-ff :f7 :f1)
				(vp-div-ff :f1 :f0)
				(vp-sqrt-ff :f0 :f0)
				(vp-cpy-ff :f13 :f4)
				(vp-mul-ff :f0 :f4)
				(vp-cpy-ff :f11 :f0)
				(vp-min-ff :f4 :f0)
				;each kept to it, and the sums again of orig, and of what is made
				(vp-xor-rr x x)
				(vp-cvt-rf x :f6)
				(vp-cpy-ff :f6 :f7)
				(vp-cpy-ff :f6 :f15)
				(vp-cpy-rr a m)
				(loop-start)
					(vp-cpy-rr m x)
					(vp-shl-cr 3 x)
					;gain, q_m and s_m, q_m min itself and itself by gain_max over gain
					(vp-lea-d out x p)
					(load-fields p '(0 384 768) '(:f1 :f2 :f3))
					(vp-cpy-ff :f2 :f4)
					(vp-mul-ff :f0 :f4)
					(vp-div-ff :f1 :f4)
					(vp-cpy-ff :f2 :f5)
					(vp-min-ff :f4 :f5)
					(vp-min-ff :f0 :f1)
					(save-fields p '(0 384) '(:f1 :f5))
					;orig, and energy g g, sm sm, and qm qm where delta and no sinusoid
					(vp-lea-d ins x p)
					(load-fields p '(0 768) '(:f2 :f4))
					(vp-add-ff :f2 :f6)
					(vp-mul-ff :f1 :f4)
					(vp-mul-ff :f1 :f4)
					(vp-add-ff :f4 :f7)
					(vp-cpy-ff :f3 :f4)
					(vp-mul-ff :f3 :f4)
					(vp-add-ff :f4 :f7)
					(vp-cpy-ff :f15 :f4)
					(vpif `(,delta = 1) '(:f3 = :f15))
						(vp-cpy-ff :f5 :f4)
						(vp-mul-ff :f5 :f4)
					(endif)
					(vp-add-ff :f4 :f7)
					(vp-add-cr 1 m)
				(loop-until `(,m = ,b))
				;the boost, min boost_max sqrt (eps + sum0) / (eps + sum1)
				(vp-cpy-ff :f9 :f0)
				(vp-add-ff :f6 :f0)
				(vp-cpy-ff :f9 :f1)
				(vp-add-ff :f7 :f1)
				(vp-div-ff :f1 :f0)
				(vp-sqrt-ff :f0 :f0)
				(vp-cpy-ff :f12 :f1)
				(vp-min-ff :f0 :f1)
				(vp-cpy-rr a m)
				(loop-start)
					(vp-cpy-rr m x)
					(vp-shl-cr 3 x)
					(vp-lea-d out x p)
					(load-fields p '(0 384 768) '(:f2 :f3 :f4))
					(vp-mul-ff :f1 :f2)
					(vp-mul-ff :f1 :f3)
					(vp-mul-ff :f1 :f4)
					(save-fields p '(0 384 768) '(:f2 :f3 :f4))
					(vp-add-cr 1 m)
				(loop-until `(,m = ,b))
			(endif)
			(vp-add-cr 1 k)
		(loop-until `(,k = ,nlim))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-sbr-gains ins flags lim kx delta consts out)" +error_msg_wrong_types))
	(signature '(:reals :nums :nums :num :num :reals :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_mp3_alias"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :f0-:f5
	;info
	;(media-mp3-alias x bands cs ca) -> x, of MP3, the 8 butterflies at
	;each boundary of the 576 reals x's subbands 1 to bands, by the reals
	;cs and ca: below by cs less above by ca, above by cs and below by ca

	(vp-rdef (x sb cs ca i lo hi c a)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,x ,sb ,cs ,ca) '(:obj :num :obj :obj))
	(vp-push x)
	(assign `((,x +array_begin) (,cs +array_begin) (,ca +array_begin)) `(,x ,cs ,ca))
	(vpif `(,sb > 0))
	(loop-start)
		;the boundary of subband sb, below and above it
		(vp-cpy-rr sb lo)
		(vp-mul-cr (* 18 +long_size) lo)
		(vp-add-rr x lo)
		(vp-cpy-rr lo hi)
		(vp-sub-cr +long_size lo)
		(vp-cpy-rr cs c)
		(vp-cpy-rr ca a)
		(vp-cpy-cr 8 i)
		(loop-start)
			(vp-cpy-if lo 0 :f0)
			(vp-cpy-if hi 0 :f1)
			(vp-cpy-if c 0 :f2)
			(vp-cpy-if a 0 :f3)
			(vp-cpy-ff :f0 :f4)
			(vp-mul-ff :f2 :f4)
			(vp-cpy-ff :f1 :f5)
			(vp-mul-ff :f3 :f5)
			(vp-sub-ff :f5 :f4)
			(vp-cpy-fi :f4 lo 0)
			(vp-mul-ff :f2 :f1)
			(vp-mul-ff :f3 :f0)
			(vp-add-ff :f0 :f1)
			(vp-cpy-fi :f1 hi 0)
			(vp-sub-cr +long_size lo)
			(vp-add-cr +long_size hi)
			(vp-add-cr +long_size c)
			(vp-add-cr +long_size a)
			(vp-sub-cr 1 i)
		(loop-until `(,i = 0))
		(vp-sub-cr 1 sb)
	(loop-until `(,sb = 0))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-mp3-alias x bands cs ca)" +error_msg_wrong_types))
	(signature '(:reals :num :reals :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_gather"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7
	;info
	;(media-gather out arrays index) -> out, element index of each of a list
	;of arrays of numbers or reals in turn into out, which is to be as long
	;as the list: a column of rows, the bands of one slot of a list of
	;slots, or a slot of a list of bands

	(vp-rdef (out arrays index p end e v)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,arrays ,index) '(:obj :obj :num))
	(vp-push out)
	(assign `((,arrays +array_length ui) (,arrays +array_begin) (,out +array_begin)) `(,end ,p ,out))
	(vp-shl-cr 3 index)
	(vpif `(,end > 0))
		(vp-shl-cr 3 end)
		(vp-add-rr p end)
		(loop-start)
			(assign `((,p 0)) `(,e))
			(assign `((,e +array_begin)) `(,e))
			(vp-cpy-dr e index v)
			(vp-cpy-ri v out 0)
			(vp-add-cr +ptr_size p)
			(vp-add-cr +long_size out)
		(loop-until `(,p = ,end))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-gather out arrays index)" +error_msg_wrong_types))
	(signature '(:array :list :num)))

(def-func-end)

(def-func (path-to-absolute "./media_sbr_predict"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11, :f0-:f11
	;info
	;(media-sbr-predict hr hi r i from to c0 c1 c2 c3) -> hr, the slots from
	;to of a band of SBR's high band, re into hr and im into hi: of the low
	;band's slot, re r and im i, x n + (c0 + i c1) x n-2 + (c2 + i c3) x n-1.
	;From is 2 or more

	(vp-rdef (hr hi r i n e p q)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 10)

	(vp-push :r0)
	(list-bind-args :r1 `(,hr ,hi ,r ,i ,n ,e :r8 :r9 :r10 :r11)
		'(:obj :obj :obj :obj :num :num :obj :obj :obj :obj))
	(vp-cpy-if :r8 +num_value :f0)
	(vp-cpy-if :r9 +num_value :f1)
	(vp-cpy-if :r10 +num_value :f2)
	(vp-cpy-if :r11 +num_value :f3)
	(vp-push hr)
	(assign `((,hr +array_begin) (,hi +array_begin) (,r +array_begin) (,i +array_begin)) `(,hr ,hi ,r ,i))
	(vp-shl-cr 3 n)
	(vp-shl-cr 3 e)
	(loop-while `(,n < ,e))
		(vp-lea-d r n p)
		(vp-lea-d i n q)
		(vp-cpy-if p (* -2 +long_size) :f4)
		(vp-cpy-if q (* -2 +long_size) :f5)
		(vp-cpy-if p (neg +long_size) :f6)
		(vp-cpy-if q (neg +long_size) :f7)
		;re, r n + (r n-2 c0 - i n-2 c1) + (r n-1 c2 - i n-1 c3)
		(vp-cpy-ff :f4 :f8)
		(vp-mul-ff :f0 :f8)
		(vp-cpy-ff :f5 :f9)
		(vp-mul-ff :f1 :f9)
		(vp-sub-ff :f9 :f8)
		(vp-cpy-ff :f6 :f10)
		(vp-mul-ff :f2 :f10)
		(vp-cpy-ff :f7 :f11)
		(vp-mul-ff :f3 :f11)
		(vp-sub-ff :f11 :f10)
		(vp-add-ff :f10 :f8)
		(vp-cpy-if p 0 :f9)
		(vp-add-ff :f8 :f9)
		(vp-cpy-fd :f9 hr n)
		;im, i n + (i n-2 c0 + r n-2 c1) + (i n-1 c2 + r n-1 c3)
		(vp-cpy-ff :f5 :f8)
		(vp-mul-ff :f0 :f8)
		(vp-cpy-ff :f4 :f9)
		(vp-mul-ff :f1 :f9)
		(vp-add-ff :f9 :f8)
		(vp-cpy-ff :f7 :f10)
		(vp-mul-ff :f2 :f10)
		(vp-cpy-ff :f6 :f11)
		(vp-mul-ff :f3 :f11)
		(vp-add-ff :f11 :f10)
		(vp-add-ff :f10 :f8)
		(vp-cpy-if q 0 :f9)
		(vp-add-ff :f8 :f9)
		(vp-cpy-fd :f9 hi n)
		(vp-add-cr +long_size n)
	(loop-end)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-sbr-predict hr hi r i from to c0 c1 c2 c3)" +error_msg_wrong_types))
	(signature '(:reals :reals :reals :reals :num :num :real :real :real :real)))

(def-func-end)

(def-func (path-to-absolute "./media_sbr_dots"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :f0-:f13, :f15
	;info
	;(media-sbr-dots r i out) -> out, the 14 sums of SBR's prediction of a
	;band of 40 slots, re r and im i, each as (nums-dot) would give it, 0
	;then each product added in turn: of n 0 to 37, r n r n+2, i n i n+2,
	;r n i n+2, i n r n+2, r n r n+1, i n i n+1, r n i n+1, i n r n+1, r n+1
	;r n+2, i n+1 i n+2, r n+1 i n+2, i n+1 r n+2, and of n 1 to 37, r n r
	;n and i n i n

	(vp-rdef (r i out p q e)
		'(:r2 :r3 :r4 :r5 :r6 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,r ,i ,out) '(:obj :obj :obj))
	(vp-push out)
	(assign `((,r +array_begin) (,i +array_begin) (,out +array_begin)) `(,r ,i ,out))

	;the eight of lags 2 and 1 from n
	(each (# (vp-xor-rr p p) (vp-cvt-rf p %0)) '(:f0 :f1 :f2 :f3 :f4 :f5 :f6 :f7))
	(vp-cpy-rr r p)
	(vp-cpy-rr i q)
	(vp-lea-i r (* 38 +long_size) e)
	(loop-start)
		(vp-cpy-if p 0 :f8)
		(vp-cpy-if q 0 :f9)
		(vp-cpy-if p +long_size :f10)
		(vp-cpy-if q +long_size :f11)
		(vp-cpy-if p (* 2 +long_size) :f12)
		(vp-cpy-if q (* 2 +long_size) :f13)
		(vp-cpy-ff :f8 :f15)
		(vp-mul-ff :f12 :f15)
		(vp-add-ff :f15 :f0)
		(vp-cpy-ff :f9 :f15)
		(vp-mul-ff :f13 :f15)
		(vp-add-ff :f15 :f1)
		(vp-cpy-ff :f8 :f15)
		(vp-mul-ff :f13 :f15)
		(vp-add-ff :f15 :f2)
		(vp-cpy-ff :f9 :f15)
		(vp-mul-ff :f12 :f15)
		(vp-add-ff :f15 :f3)
		(vp-cpy-ff :f8 :f15)
		(vp-mul-ff :f10 :f15)
		(vp-add-ff :f15 :f4)
		(vp-cpy-ff :f9 :f15)
		(vp-mul-ff :f11 :f15)
		(vp-add-ff :f15 :f5)
		(vp-cpy-ff :f8 :f15)
		(vp-mul-ff :f11 :f15)
		(vp-add-ff :f15 :f6)
		(vp-cpy-ff :f9 :f15)
		(vp-mul-ff :f10 :f15)
		(vp-add-ff :f15 :f7)
		(vp-add-cr +long_size p)
		(vp-add-cr +long_size q)
	(loop-until `(,p = ,e))
	(each (# (vp-cpy-fi %0 out (* (!) +long_size))) '(:f0 :f1 :f2 :f3 :f4 :f5 :f6 :f7))

	;the four of lag 1 from n + 1
	(each (# (vp-xor-rr p p) (vp-cvt-rf p %0)) '(:f0 :f1 :f2 :f3))
	(vp-cpy-rr r p)
	(vp-cpy-rr i q)
	(loop-start)
		(vp-cpy-if p +long_size :f10)
		(vp-cpy-if q +long_size :f11)
		(vp-cpy-if p (* 2 +long_size) :f12)
		(vp-cpy-if q (* 2 +long_size) :f13)
		(vp-cpy-ff :f10 :f15)
		(vp-mul-ff :f12 :f15)
		(vp-add-ff :f15 :f0)
		(vp-cpy-ff :f11 :f15)
		(vp-mul-ff :f13 :f15)
		(vp-add-ff :f15 :f1)
		(vp-cpy-ff :f10 :f15)
		(vp-mul-ff :f13 :f15)
		(vp-add-ff :f15 :f2)
		(vp-cpy-ff :f11 :f15)
		(vp-mul-ff :f12 :f15)
		(vp-add-ff :f15 :f3)
		(vp-add-cr +long_size p)
		(vp-add-cr +long_size q)
	(loop-until `(,p = ,e))
	(each (# (vp-cpy-fi %0 out (* (+ (!) 8) +long_size))) '(:f0 :f1 :f2 :f3))

	;the two of lag 0, 1 to 37
	(each (# (vp-xor-rr p p) (vp-cvt-rf p %0)) '(:f4 :f5))
	(vp-lea-i r +long_size p)
	(vp-lea-i i +long_size q)
	(loop-start)
		(vp-cpy-if p 0 :f8)
		(vp-cpy-if q 0 :f9)
		(vp-cpy-ff :f8 :f15)
		(vp-mul-ff :f8 :f15)
		(vp-add-ff :f15 :f4)
		(vp-cpy-ff :f9 :f15)
		(vp-mul-ff :f9 :f15)
		(vp-add-ff :f15 :f5)
		(vp-add-cr +long_size p)
		(vp-add-cr +long_size q)
	(loop-until `(,p = ,e))
	(vp-cpy-fi :f4 out (* 12 +long_size))
	(vp-cpy-fi :f5 out (* 13 +long_size))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-sbr-dots r i out)" +error_msg_wrong_types))
	(signature '(:reals :reals :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_sbr_ana"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :f0-:f4
	;info
	;(media-sbr-ana u win x base) -> u, the 64 sums of a slot of SBR's
	;analysis bank: of the 320 samples of x before base + 320, newest
	;first, by the window, z k = win k x base+319-k, u n is ((z n + z n+64)
	;+ (z n+128 + z n+192)) + z n+256, each sum in that order

	(vp-rdef (u w x n e)
		'(:r2 :r3 :r4 :r5 :r6))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,u ,w ,x ,n) '(:obj :obj :obj :num))
	(vp-push u)
	(assign `((,u +array_begin) (,w +array_begin) (,x +array_begin)) `(,u ,w ,x))
	;x at base + 319, w and u at 0, each a step on, x a step back
	(vp-shl-cr 3 n)
	(vp-add-rr n x)
	(vp-add-cr (* 319 +long_size) x)
	(vp-lea-i u (* 64 +long_size) e)
	(loop-start)
		(vp-cpy-if w 0 :f0)
		(vp-cpy-if x 0 :f4)
		(vp-mul-ff :f4 :f0)
		(vp-cpy-if w (* 64 +long_size) :f1)
		(vp-cpy-if x (* -64 +long_size) :f4)
		(vp-mul-ff :f4 :f1)
		(vp-add-ff :f1 :f0)
		(vp-cpy-if w (* 128 +long_size) :f2)
		(vp-cpy-if x (* -128 +long_size) :f4)
		(vp-mul-ff :f4 :f2)
		(vp-cpy-if w (* 192 +long_size) :f3)
		(vp-cpy-if x (* -192 +long_size) :f4)
		(vp-mul-ff :f4 :f3)
		(vp-add-ff :f3 :f2)
		(vp-add-ff :f2 :f0)
		(vp-cpy-if w (* 256 +long_size) :f1)
		(vp-cpy-if x (* -256 +long_size) :f4)
		(vp-mul-ff :f4 :f1)
		(vp-add-ff :f1 :f0)
		(vp-cpy-fi :f0 u 0)
		(vp-add-cr +long_size u)
		(vp-add-cr +long_size w)
		(vp-sub-cr +long_size x)
	(loop-until `(,u = ,e))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-sbr-ana u win x base)" +error_msg_wrong_types))
	(signature '(:reals :reals :reals :num)))

(def-func-end)

(def-func (path-to-absolute "./media_ps_allpass"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f11
	;info
	;(media-ps-allpass out_r out_i dr di links coeffs gains) -> out_r, a band
	;of parametric stereo made unlike itself, its 32 slots: each slot of the
	;delay line, reals dr and di, from 12 on, turned by the band's phase,
	;then through the 3 links of the all-pass filter, links their reals re
	;and im one after another, each 5 slots before and the 32 of this frame
	;written in place: of link m the slot 2 - m before by its fractional
	;delay, less the decayed gain by the slot, and its own slot 5 on the
	;slot and the gain by what comes out. coeffs is the phase re and im, then
	;each link's delay re and im and gain. Each slot out by its gain

	(vp-rdef (out_r out_i dr di gains coeffs a0r a0i a1r a1i a2r a2i c)
		'(:r14 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(vp-push :r0)
	(list-bind-args :r1 `(,out_r ,out_i ,dr ,di ,a0r ,coeffs ,gains) '(:obj :obj :obj :obj :obj :obj :obj))
	(vp-push out_r)
	;the links' 6 reals of the list, the list's own register last
	(assign `((,a0r +array_begin)) `(,a0r))
	(vp-cpy-ir a0r +ptr_size a0i)
	(vp-cpy-ir a0r (* 2 +ptr_size) a1r)
	(vp-cpy-ir a0r (* 3 +ptr_size) a1i)
	(vp-cpy-ir a0r (* 4 +ptr_size) a2r)
	(vp-cpy-ir a0r (* 5 +ptr_size) a2i)
	(vp-cpy-ir a0r 0 a0r)
	(assign `((,out_r +array_begin) (,out_i +array_begin) (,dr +array_begin) (,di +array_begin) (,gains +array_begin) (,coeffs +array_begin)
			(,a0r +array_begin) (,a0i +array_begin) (,a1r +array_begin) (,a1i +array_begin) (,a2r +array_begin) (,a2i +array_begin))
		`(,out_r ,out_i ,dr ,di ,gains ,coeffs ,a0r ,a0i ,a1r ,a1i ,a2r ,a2i))
	;the phase
	(vp-cpy-if coeffs 0 :f2)
	(vp-cpy-if coeffs +long_size :f3)
	(vp-cpy-cr 32 c)
	(loop-start)
		;the slot turned by the phase
		(vp-cpy-if dr (* 12 +long_size) :f4)
		(vp-cpy-if di (* 12 +long_size) :f5)
		(vp-cpy-ff :f4 :f0)
		(vp-mul-ff :f2 :f0)
		(vp-cpy-ff :f5 :f6)
		(vp-mul-ff :f3 :f6)
		(vp-sub-ff :f6 :f0)
		(vp-cpy-ff :f4 :f1)
		(vp-mul-ff :f3 :f1)
		(vp-cpy-ff :f5 :f6)
		(vp-mul-ff :f2 :f6)
		(vp-add-ff :f6 :f1)
		;each link, its delay, gain and buffers
		(each (lambda (m ar ai)
				(defq at (* (+ 2 (* 3 m)) +long_size))
				(vp-cpy-if coeffs at :f4)
				(vp-cpy-if coeffs (+ at +long_size) :f5)
				(vp-cpy-if coeffs (+ at (* 2 +long_size)) :f6)
				(vp-cpy-if ar (* (- 2 m) +long_size) :f7)
				(vp-cpy-if ai (* (- 2 m) +long_size) :f8)
				;the new, the link's slot by its delay less the gain by this
				(vp-cpy-ff :f7 :f9)
				(vp-mul-ff :f4 :f9)
				(vp-cpy-ff :f8 :f11)
				(vp-mul-ff :f5 :f11)
				(vp-sub-ff :f11 :f9)
				(vp-cpy-ff :f0 :f11)
				(vp-mul-ff :f6 :f11)
				(vp-sub-ff :f11 :f9)
				(vp-cpy-ff :f7 :f10)
				(vp-mul-ff :f5 :f10)
				(vp-cpy-ff :f8 :f11)
				(vp-mul-ff :f4 :f11)
				(vp-add-ff :f11 :f10)
				(vp-cpy-ff :f1 :f11)
				(vp-mul-ff :f6 :f11)
				(vp-sub-ff :f11 :f10)
				;the link's own slot 5 on, this and the gain by the new
				(vp-cpy-ff :f9 :f11)
				(vp-mul-ff :f6 :f11)
				(vp-add-ff :f11 :f0)
				(vp-cpy-fi :f0 ar (* 5 +long_size))
				(vp-cpy-ff :f10 :f11)
				(vp-mul-ff :f6 :f11)
				(vp-add-ff :f11 :f1)
				(vp-cpy-fi :f1 ai (* 5 +long_size))
				(vp-cpy-ff :f9 :f0)
				(vp-cpy-ff :f10 :f1))
			'(0 1 2) (list a0r a1r a2r) (list a0i a1i a2i))
		;out by the slot's gain
		(vp-cpy-if gains 0 :f4)
		(vp-mul-ff :f4 :f0)
		(vp-mul-ff :f4 :f1)
		(vp-cpy-fi :f0 out_r 0)
		(vp-cpy-fi :f1 out_i 0)
		(each (# (vp-add-cr +long_size %0)) (list out_r out_i dr di gains a0r a0i a1r a1i a2r a2i))
		(vp-sub-cr 1 c)
	(loop-until `(,c = 0))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ps-allpass out_r out_i dr di links coeffs gains)" +error_msg_wrong_types))
	(signature '(:reals :reals :reals :reals :list :reals :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_flac_rice"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-flac-rice reader out from count k) -> out, count Rice codes of
	;parameter k of a reader of lib/media/bits.inc into the nums out from
	;from: each its quotient in unary, 0s ended by a 1, then k bits, the two
	;one number folded, even the positive and odd the negative. The str is
	;to have 8 bytes past the last bit read, as bits-of gives it: the 0s of
	;a code go no further than those, a bad frame read to its end, not past

	(vp-rdef (in out from n k e p at q v x y num)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-push :r0)
	(list-bind-args :r1 `(,in ,out ,from ,n ,k) '(:obj :obj :num :num :num))
	(vp-push out)
	(assign `((,in +array_begin)) `(,e))
	(assign `((,e 0) (,e +ptr_size)) `(,p ,num))
	(assign `((,num +array_begin)) `(,num))
	(assign `((,num 0) (,out +array_begin)) `(,at ,out))
	(vp-shl-cr 3 from)
	(vp-add-rr from out)
	;from now the bit the str's own bytes end at
	(assign `((,p +str_length)) `(,from))
	(vp-sub-cr 8 from)
	(vp-shl-cr 3 from)
	(vpif `(,n > 0))
	(loop-start)
		;the 0s to a 1, the bit at at of its byte the top one
		(vp-cpy-cr -1 q)
		(loop-start)
			(vp-cpy-rr at x)
			(vp-shr-cr 3 x)
			(vp-add-rr p x)
			(vp-cpy-ir-ub x +str_data v)
			(vp-cpy-rr at y)
			(vp-and-cr 7 y)
			(vp-shl-rr y v)
			(vp-and-cr 0x80 v)
			(vp-add-cr 1 at)
			(vp-add-cr 1 q)
			(breakif `(,at >= ,from))
		(loop-until `(,v /= 0))
		;the k bits, of the 8 bytes from at's byte
		(vp-xor-rr v v)
		(vpif `(,k > 0))
			(vp-cpy-rr at x)
			(vp-shr-cr 3 x)
			(vp-add-rr p x)
			(each (lambda (i)
					(vp-shl-cr 8 v)
					(vp-cpy-ir-ub x (+ +str_data i) y)
					(vp-add-rr y v))
				(range 0 8))
			(vp-cpy-rr at y)
			(vp-and-cr 7 y)
			(vp-shl-rr y v)
			(vp-cpy-cr 64 y)
			(vp-sub-rr k y)
			(vp-shr-rr y v)
			(vp-add-rr k at)
		(endif)
		;the two one number, then unfolded
		(vp-shl-rr k q)
		(vp-add-rr q v)
		(vp-cpy-rr v x)
		(vp-and-cr 1 x)
		(vp-mul-cr -1 x)
		(vp-shr-cr 1 v)
		(vp-xor-rr x v)
		(vp-cpy-ri v out 0)
		(vp-add-cr +long_size out)
		(vp-sub-cr 1 n)
	(loop-until `(,n = 0))
	(endif)
	(assign `(,at) `((,num 0)))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-flac-rice reader out from count k)" +error_msg_wrong_types))
	(signature '(:list :nums :num :num :num)))

(def-func-end)

(def-func (path-to-absolute "./media_flac_lpc"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13
	;info
	;(media-flac-lpc samples order coeffs shift) -> samples, the nums of a
	;FLAC subframe, its first order as they are and the rest residuals, each
	;of those in place plus its prediction: the sum of coeffs by the samples
	;before it, the first by the one just before, shifted down by shift, as
	;integers exactly

	(vp-rdef (s order c shift n i p q cp m x y sum)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,s ,order ,c ,shift) '(:obj :num :obj :num))
	(vp-push s)
	(assign `((,s +array_length ui) (,s +array_begin) (,c +array_begin)) `(,n ,s ,c))
	(vpif `(,order > 0) `(,order < ,n))
		(vp-cpy-rr order i)
		(vp-cpy-rr order p)
		(vp-shl-cr 3 p)
		(vp-add-rr s p)
		(loop-start)
			;the sum of the order before it by the coeffs
			(vp-xor-rr sum sum)
			(vp-cpy-rr p q)
			(vp-cpy-rr c cp)
			(vp-cpy-rr order m)
			(loop-start)
				(vp-sub-cr +long_size q)
				(vp-cpy-ir q 0 x)
				(vp-cpy-ir cp 0 y)
				(vp-mul-rr y x)
				(vp-add-rr x sum)
				(vp-add-cr +long_size cp)
				(vp-sub-cr 1 m)
			(loop-until `(,m = 0))
			(vp-asr-rr shift sum)
			(vp-cpy-ir p 0 x)
			(vp-add-rr sum x)
			(vp-cpy-ri x p 0)
			(vp-add-cr +long_size p)
			(vp-add-cr 1 i)
		(loop-until `(,i = ,n))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-flac-lpc samples order coeffs shift)" +error_msg_wrong_types))
	(signature '(:nums :num :nums :num)))

(def-func-end)

(def-func (path-to-absolute "./media_flac_stereo"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8
	;info
	;(media-flac-stereo a b mode) -> a, the two channels of a FLAC frame
	;made left and right in place, nums as long as each other, by its
	;channel assignment: 8 left and side, the right the left less the side;
	;9 side and right, the left the side and the right; 10 mid and side,
	;the mid twice with the side's low bit, the left half of it with the
	;side, the right half of it without

	(vp-rdef (a b mode n x y m)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,a ,b ,mode) '(:obj :obj :num))
	(vp-push a)
	(assign `((,a +array_length ui) (,a +array_begin) (,b +array_begin)) `(,n ,a ,b))
	(vpif `(,n > 0))
	(loop-start)
		(vp-cpy-ir a 0 x)
		(vp-cpy-ir b 0 y)
		(vpif `(,mode = 8))
			(vp-sub-rr y x)
			(vp-cpy-ri x b 0)
		(elseif `(,mode = 9))
			(vp-add-rr y x)
			(vp-cpy-ri x a 0)
		(else)
			(vp-shl-cr 1 x)
			(vp-cpy-rr y m)
			(vp-and-cr 1 m)
			(vp-add-rr m x)
			(vp-cpy-rr x m)
			(vp-add-rr y x)
			(vp-asr-cr 1 x)
			(vp-cpy-ri x a 0)
			(vp-sub-rr y m)
			(vp-asr-cr 1 m)
			(vp-cpy-ri m b 0)
		(endif)
		(vp-add-cr +long_size a)
		(vp-add-cr +long_size b)
		(vp-sub-cr 1 n)
	(loop-until `(,n = 0))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-flac-stereo a b mode)" +error_msg_wrong_types))
	(signature '(:nums :nums :num)))

(def-func-end)

(def-func (path-to-absolute "./media_flac_ints"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :f0-:f1
	;info
	;(media-flac-ints out ints scale) -> out, each of the nums ints a real
	;by the real scale, into the reals out as long as it

	(vp-rdef (out ints scale n x)
		'(:r2 :r3 :r4 :r5 :r6))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,ints ,scale) '(:obj :obj :obj))
	(vp-push out)
	(vp-cpy-if scale +num_value :f1)
	(assign `((,ints +array_length ui) (,ints +array_begin) (,out +array_begin)) `(,n ,ints ,out))
	(vpif `(,n > 0))
	(loop-start)
		(vp-cpy-ir ints 0 x)
		(vp-cvt-rf x :f0)
		(vp-mul-ff :f1 :f0)
		(vp-cpy-fi :f0 out 0)
		(vp-add-cr +long_size ints)
		(vp-add-cr +long_size out)
		(vp-sub-cr 1 n)
	(loop-until `(,n = 0))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-flac-ints out ints scale)" +error_msg_wrong_types))
	(signature '(:reals :nums :real)))

(def-func-end)
