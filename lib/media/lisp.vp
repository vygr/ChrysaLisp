(include "lib/asm/func.inc")
(include "class/reals/class.inc")
(include "class/real/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./media_dct4"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f9
	;info
	;(media-dct4 x tw rev out) -> out, the DCT-IV of the n reals of x, by an
	;FFT of n/2, m, into out, n reals. tw is 5m reals: the twiddles before,
	;e^(-i pi (4j+1)/4n) as cos and sin, m of them, after, e^(-i pi k/n),
	;m, and of the FFT, e^(-2 pi i k/m), m/2. rev is the nums of the bit
	;reversal of m. lib/media/mdct.inc makes them

	(vp-rdef (xp tw rev out n m j a b c d e f g h)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,xp ,tw ,rev ,out) '(:obj :obj :obj :obj))
	(vp-push out)
	(assign `((,xp +array_length ui)) `(,n))
	(assign `((,xp +array_begin) (,tw +array_begin) (,rev +array_begin) (,out +array_begin))
		`(,xp ,tw ,rev ,out))
	(vp-cpy-rr n m)
	(vp-shr-cr 1 m)

	;before: each pair of lines a complex, x[2j] and x[n-1-2j], turned by
	;its twiddle, to its place bit reversed
	(vp-xor-rr j j)
	(loop-start)
		;x[2j], x[n-1-2j]
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-df xp a :f0)
		(vp-cpy-rr n b)
		(vp-sub-cr 1 b)
		(vp-shl-cr 3 b)
		(vp-sub-rr a b)
		(vp-cpy-df xp b :f1)
		;its twiddle, cos and sin
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		;re = x0 c - x1 s, im = x0 s + x1 c
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;to its place, rev[j]
		(vp-cpy-rr j c)
		(vp-shl-cr 3 c)
		(vp-cpy-dr rev c d)
		(vp-shl-cr 4 d)
		(vp-cpy-fd :f4 out d)
		(vp-add-cr 8 d)
		(vp-cpy-fd :f0 out d)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,m))

	;the FFT, in place, stages of 2, 4 ... m, a twiddle every so many of
	;the table: c is the length of a stage, d half of it in bytes, e the
	;step through the table in bytes. tw moved to the FFT's twiddles
	(vp-cpy-rr m a)
	(vp-shl-cr 5 a)
	(vp-add-rr a tw)
	(vp-cpy-cr 2 c)
	(vp-cpy-rr m e)
	(vp-shl-cr 3 e)
	(loop-start)
		(vp-cpy-rr c d)
		(vp-shl-cr 3 d)
		;each group, from a, its first in bytes
		(vp-xor-rr a a)
		(loop-start)
			;each pair of the group, b from 0 to half, f through the table
			(vp-xor-rr b b)
			(vp-xor-rr f f)
			(loop-start)
				;i at a + b, j half after it, in bytes of complexes
				(vp-cpy-rr a j)
				(vp-add-rr b j)
				(vp-add-rr out j)
				;the twiddle
				(vp-cpy-df tw f :f2)
				(vp-add-cr 8 f)
				(vp-cpy-df tw f :f3)
				(vp-sub-cr 8 f)
				;x[j] by it, j at g
				(vp-cpy-rr j g)
				(vp-add-rr d g)
				(vp-cpy-if g 0 :f0)
				(vp-cpy-if g 8 :f1)
				(vp-cpy-ff :f0 :f4)
				(vp-mul-ff :f2 :f4)
				(vp-cpy-ff :f1 :f5)
				(vp-mul-ff :f3 :f5)
				(vp-sub-ff :f5 :f4)
				(vp-mul-ff :f3 :f0)
				(vp-mul-ff :f2 :f1)
				(vp-add-ff :f1 :f0)
				;x[j] = x[i] - t, x[i] = x[i] + t
				(vp-cpy-if j 0 :f6)
				(vp-cpy-if j 8 :f7)
				(vp-cpy-ff :f6 :f8)
				(vp-sub-ff :f4 :f8)
				(vp-cpy-ff :f7 :f9)
				(vp-sub-ff :f0 :f9)
				(vp-add-ff :f4 :f6)
				(vp-add-ff :f0 :f7)
				(vp-cpy-fi :f6 j 0)
				(vp-cpy-fi :f7 j 8)
				(vp-cpy-fi :f8 g 0)
				(vp-cpy-fi :f9 g 8)
				(vp-add-cr 16 b)
				(vp-add-rr e f)
			(loop-until `(,b = ,d))
			(vp-add-rr d a)
			(vp-add-rr d a)
			(vp-cpy-rr m j)
			(vp-shl-cr 4 j)
		(loop-until `(,a = ,j))
		(vp-shr-cr 1 e)
		(vp-shl-cr 1 c)
	(loop-until `(,c > ,m))

	;after: each complex k turned by its twiddle, two at once, k and m-1-k,
	;as y[2k] and y[n-1-2k] are where the two of them were. tw back to the
	;twiddles after
	(vp-cpy-rr m a)
	(vp-shl-cr 4 a)
	(vp-sub-rr a tw)
	(vp-xor-rr j j)
	(vp-cpy-rr m b)
	(vp-shr-cr 1 b)
	(loop-start)
		;k at a, m-1-k at c, in bytes
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-cpy-rr m c)
		(vp-sub-cr 1 c)
		(vp-sub-rr j c)
		(vp-shl-cr 4 c)
		;u of k
		(vp-cpy-df out a :f0)
		(vp-add-cr 8 a)
		(vp-cpy-df out a :f1)
		(vp-sub-cr 8 a)
		(vp-cpy-df tw a :f2)
		(vp-add-cr 8 a)
		(vp-cpy-df tw a :f3)
		(vp-sub-cr 8 a)
		(vp-cpy-ff :f0 :f4)
		(vp-mul-ff :f2 :f4)
		(vp-cpy-ff :f1 :f5)
		(vp-mul-ff :f3 :f5)
		(vp-sub-ff :f5 :f4)
		(vp-mul-ff :f3 :f0)
		(vp-mul-ff :f2 :f1)
		(vp-add-ff :f1 :f0)
		;u of m-1-k
		(vp-cpy-df out c :f6)
		(vp-add-cr 8 c)
		(vp-cpy-df out c :f7)
		(vp-sub-cr 8 c)
		(vp-cpy-df tw c :f2)
		(vp-add-cr 8 c)
		(vp-cpy-df tw c :f3)
		(vp-sub-cr 8 c)
		(vp-cpy-ff :f6 :f8)
		(vp-mul-ff :f2 :f8)
		(vp-cpy-ff :f7 :f9)
		(vp-mul-ff :f3 :f9)
		(vp-sub-ff :f9 :f8)
		(vp-mul-ff :f3 :f6)
		(vp-mul-ff :f2 :f7)
		(vp-add-ff :f7 :f6)
		;y[2k] = re k, y[n-1-2k] = -im k, at the im of m-1-k; y[2(m-1-k)] =
		;re m-1-k, y[2k+1] = -im m-1-k, at the im of k
		(vp-neg-ff :f0 :f0)
		(vp-neg-ff :f6 :f6)
		(vp-cpy-fd :f4 out a)
		(vp-add-cr 8 a)
		(vp-cpy-fd :f6 out a)
		(vp-cpy-fd :f8 out c)
		(vp-add-cr 8 c)
		(vp-cpy-fd :f0 out c)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,b))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-dct4 x tw rev out)" +error_msg_wrong_types))
	(signature '(:reals :reals :nums :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_s16"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f4
	;info
	;(media-s16 out chans from) -> out, the samples of each channel, reals
	;all as long, from frame from, written to the str out one frame after
	;another, each a 16 bit sample of each channel, low byte first, rounded
	;to the nearest and held to -32768 to 32767. out is to be as long as
	;that, a frame is 2 bytes a channel

	(vp-rdef (out chans from n len c src dst i step x top bottom)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,chans ,from) '(:obj :obj :num))
	(vp-push out)
	(assign `((,chans +array_length ui) (,chans +array_begin)) `(,n ,chans))
	(vp-lea-i out +str_data out)
	;the length of the first channel, the frames are to it
	(assign `((,chans 0)) `(,len))
	(assign `((,len +array_length ui)) `(,len))
	;a frame is 2n bytes, half a unit to round by, and the bounds
	(vp-cpy-rr n step)
	(vp-shl-cr 1 step)
	(vp-cpy-cr 1 x)
	(vp-cvt-rf x :f2)
	(vp-cpy-cr 2 x)
	(vp-cvt-rf x :f3)
	(vp-div-ff :f3 :f2)
	(vp-neg-ff :f2 :f3)
	(vp-cpy-cr 32767 top)
	(vp-cpy-cr -32768 bottom)
	(vp-xor-rr c c)
	(vpif `(,from < ,len))
	(loop-start)
		;each channel its own column of the frames
		(vp-cpy-rr c src)
		(vp-shl-cr 3 src)
		(vp-add-rr chans src)
		(assign `((,src 0)) `(,src))
		(assign `((,src +array_begin)) `(,src))
		(vp-cpy-rr c dst)
		(vp-shl-cr 1 dst)
		(vp-add-rr out dst)
		(vp-cpy-rr from i)
		(loop-start)
			(vp-cpy-rr i x)
			(vp-shl-cr 3 x)
			(vp-cpy-df src x :f0)
			;half away from 0, then the whole part
			(vp-cpy-ff :f2 :f1)
			(vp-xor-rr x x)
			(vp-cvt-rf x :f4)
			(vpif '(:f0 < :f4))
				(vp-cpy-ff :f3 :f1)
			(endif)
			(vp-add-ff :f1 :f0)
			(vp-cvt-fr :f0 x)
			(vpif `(,x > ,top))
				(vp-cpy-rr top x)
			(elseif `(,x < ,bottom))
				(vp-cpy-rr bottom x)
			(endif)
			(vp-cpy-ri-s x dst 0)
			(vp-add-rr step dst)
			(vp-add-cr 1 i)
		(loop-until `(,i = ,len))
		(vp-add-cr 1 c)
	(loop-until `(,c = ,n))
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-s16 out chans from)" +error_msg_wrong_types))
	(signature '(:str :list :num)))

(def-func-end)

(def-func (path-to-absolute "./media_huff"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8, :r14, :f0-:f15
	;info
	;(media-huff data at table) -> num, the code of a Huffman book at bit
	;at of the str data, high bit first: what it stands for by 2^32, and
	;the bit after it. table is nums, levels of 256 entries, each by 8 bits
	;of the code: an entry of 0 or more is a code that ends in this level,
	;what it stands for by 256 and its bits in it; less than 0 the next
	;level, at -entry. data is to have 4 bytes past the last code read.
	;lib/media/huff.inc makes the tables

	(vp-rdef (data at table e byte x level)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 `(,data ,at ,table) '(:obj :num :obj))
	(vp-lea-i data +str_data data)
	(assign `((,table +array_begin)) `(,table))
	(vp-cpy-rr table level)
	(loop-start)
		;the next 8 bits: the 2 bytes at at, by where at is in the first
		(vp-cpy-rr at byte)
		(vp-shr-cr 3 byte)
		(vp-add-rr data byte)
		(vp-cpy-ir-ub byte 0 x)
		(vp-cpy-ir-ub byte 1 e)
		(vp-shl-cr 8 x)
		(vp-add-rr e x)
		(vp-cpy-rr at e)
		(vp-and-cr 7 e)
		(vp-shl-rr e x)
		(vp-shr-cr 8 x)
		(vp-and-cr 255 x)
		;its entry
		(vp-shl-cr 3 x)
		(vp-cpy-dr level x e)
		(breakif `(,e >= 0))
		;the next level, its entries from the start of the table
		(vp-add-cr 8 at)
		(vp-mul-cr -8 e)
		(vp-cpy-rr table level)
		(vp-add-rr e level)
	(loop-end)
	;what it stands for, and at past it
	(vp-cpy-rr e x)
	(vp-and-cr 255 x)
	(vp-add-rr x at)
	(vp-shr-cr 8 e)
	(vp-shl-cr 32 e)
	(vp-add-rr at e)
	(call :num :create `(,e) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-huff data at table)" +error_msg_wrong_types))
	(signature '(:str :num :nums)))

(def-func-end)

(defun media-bits-read (in n e num at p v x)
	;the next n bits of the reader in, (str (nums at)), high bit first, into
	;v, and at moved past them, in its nums. n a reg or a constant. Trashes
	;the regs given
	(assign `((,in +array_begin)) `(,e))
	(assign `((,e 0) (,e +ptr_size)) `(,p ,num))
	(assign `((,num +array_begin)) `(,num))
	(assign `((,num 0)) `(,at))
	;the 4 bytes at at, high first
	(vp-cpy-rr at x)
	(vp-shr-cr 3 x)
	(vp-add-rr x p)
	(vp-cpy-ir-ub p +str_data v)
	(each (lambda (i)
			(vp-shl-cr 8 v)
			(vp-cpy-ir-ub p (+ +str_data i) x)
			(vp-add-rr x v))
		'(1 2 3))
	;the n of them from at, the bits above taken off
	(vp-cpy-rr at x)
	(vp-and-cr 7 x)
	(vp-shl-rr x v)
	(vp-cpy-cr 32 x)
	(if (num? n) (vp-sub-cr n x) (vp-sub-rr n x))
	(vp-shr-rr x v)
	(vp-cpy-cr 1 x)
	(if (num? n) (vp-shl-cr n x) (vp-shl-rr n x))
	(vp-sub-cr 1 x)
	(vp-and-rr x v)
	;at past them
	(if (num? n) (vp-add-cr n at) (vp-add-rr n at))
	(assign `(,at) `((,num 0))))

(def-func (path-to-absolute "./media_bits_get"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r10, :r14, :f0-:f15
	;info
	;(media-bits-get reader n) -> num, the next n bits, 0 to 25, of a reader
	;of lib/media/bits.inc, (str (nums at)), high bit first, and at moved
	;past them. The str is to have 4 bytes past the last bit read

	(vp-rdef (in n e num at p v x)
		'(:r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(list-bind-args :r1 `(,in ,n) '(:obj :num))
	(media-bits-read in n e num at p v x)
	(call :num :create `(,v) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-bits-get reader n)" +error_msg_wrong_types))
	(signature '(:list :num)))

(def-func-end)

(def-func (path-to-absolute "./media_bits_1"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r10, :r14, :f0-:f15
	;info
	;(media-bits-1 reader) -> 0 | 1, the next bit of a reader of
	;lib/media/bits.inc, (str (nums at)), and at moved past it

	(vp-rdef (in e num at p v x)
		'(:r3 :r5 :r6 :r7 :r8 :r9 :r10))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(list-bind-args :r1 `(,in) '(:obj))
	(media-bits-read in 1 e num at p v x)
	(call :num :create `(,v) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-bits-1 reader)" +error_msg_wrong_types))
	(signature '(:list)))

(def-func-end)

(def-func (path-to-absolute "./media_noise"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r12, :r14, :f0-:f15
	;info
	;(media-noise out start end seed scale) -> seed, the reals of out from
	;start to end each the next of the generator of lib/media/noise.inc,
	;seed by 1664525 and 1013904223 of 32 bits, less 2^31, by scale

	(vp-rdef (out start end seed scale p e half mul add)
		'(:r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,start ,end ,seed ,scale) '(:obj :num :num :num :obj))
	(vp-cpy-if scale +num_value :f1)
	(assign `((,out +array_begin)) `(,p))
	(vp-shl-cr 3 start)
	(vp-shl-cr 3 end)
	(vp-lea-d p end e)
	(vp-add-rr start p)
	(vp-cpy-cr 1 half)
	(vp-shl-cr 31 half)
	(vp-cpy-cr 1664525 mul)
	(vp-cpy-cr 1013904223 add)
	(vpif `(,p < ,e))
		(loop-start)
			(vp-mul-rr mul seed)
			(vp-add-rr add seed)
			(vp-shl-cr 32 seed)
			(vp-shr-cr 32 seed)
			(vp-cpy-rr seed end)
			(vp-sub-rr half end)
			(vp-cvt-rf end :f0)
			(vp-mul-ff :f1 :f0)
			(vp-cpy-fi :f0 p 0)
			(vp-add-cr +long_size p)
		(loop-until `(,p = ,e))
	(endif)
	(call :num :create `(,seed) '(:r1))
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-noise out start end seed scale)" +error_msg_wrong_types))
	(signature '(:reals :num :num :num :real)))

(def-func-end)

(defun media-read (data at n v x y)
	;the next n bits of the str data at bit at, high bit first, into v, and
	;at moved past them. n a reg or a constant, x and y trashed
	(vp-cpy-rr at x)
	(vp-shr-cr 3 x)
	(vp-add-rr data x)
	(vp-cpy-ir-ub x +str_data v)
	(each (lambda (i)
			(vp-shl-cr 8 v)
			(vp-cpy-ir-ub x (+ +str_data i) y)
			(vp-add-rr y v))
		'(1 2 3))
	(vp-cpy-rr at y)
	(vp-and-cr 7 y)
	(vp-shl-rr y v)
	(vp-cpy-cr 32 y)
	(if (num? n) (vp-sub-cr n y) (vp-sub-rr n y))
	(vp-shr-rr y v)
	(vp-cpy-cr 1 y)
	(if (num? n) (vp-shl-cr n y) (vp-shl-rr n y))
	(vp-sub-cr 1 y)
	(vp-and-rr y v)
	(if (num? n) (vp-add-cr n at) (vp-add-rr n at)))

(def-func (path-to-absolute "./media_ac3_mantissas"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f1
	;info
	;(media-ac3-mantissas reader bap exps start end out groups noise dither
	;table) -> out, the coefficients of AC-3 bins start to end into out, each
	;its mantissa by 2^-exponent, read from a reader of lib/media/bits.inc.
	;bap 1, 2 and 4 are codes of 5, 7 and 7 bits of 3, 3 and 2 levels,
	;groups the nums of the count left and the code of each, shared by the
	;channels of a block; the levels of a code from table, at 0, 96 and
	;480, 3, 3 and 2 a code in the order they are used. bap 3 and 5 are 3
	;and 4 bits, their levels at 736 and 744; 6 to 15 numbers of 5 to 16
	;bits. bap 0 is noise of the reals noise, or 0 if dither is 0

	(vp-rdef (in bap exps bin end out groups noise dither table at b v x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 10)

	(vp-push :r0)
	(list-bind-args :r1 `(,in ,bap ,exps ,bin ,end ,out ,groups ,noise ,dither ,table)
		'(:obj :obj :obj :num :num :obj :obj :obj :num :obj))
	(vp-push out)
	;the reader's str and the nums of its place
	(assign `((,in +array_begin)) `(,x))
	(assign `((,x 0) (,x +ptr_size)) `(,in ,x))
	(assign `((,x +array_begin)) `(,x))
	(vp-push x)
	(assign `((,x 0)) `(,at))
	(assign `((,bap +array_begin) (,exps +array_begin) (,out +array_begin) (,groups +array_begin)
		(,noise +array_begin) (,table +array_begin)) `(,bap ,exps ,out ,groups ,noise ,table))
	(vpif `(,bin < ,end))
	(loop-start)
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr bap x b)
		(vpif `(,b = 0))
			(vpif `(,dither /= 0))
				(vp-cpy-df noise x :f0)
			(else)
				(vp-xor-rr v v)
				(vp-cvt-rf v :f0)
			(endif)
		(elseif `(,b < 6))
			(vpif `(,b = 3))
				(media-read in at 3 v x y)
				(vp-add-cr 736 v)
			(elseif `(,b = 5))
				(media-read in at 4 v x y)
				(vp-add-cr 744 v)
			(else)
				;a level of a code, a new code when the last is used up
				(each (lambda ((k off bits levels base))
						(if (= k 1) (vpif `(,b = 1)) (if (= k 2) (elseif `(,b = 2)) (else)))
						(assign `((,groups ,off)) `(,b))
						(vpif `(,b = 0))
							(media-read in at bits v x y)
							(assign `(,v) `((,groups ,(+ off 8))))
							(vp-cpy-cr levels b)
						(endif)
						(vp-sub-cr 1 b)
						(assign `(,b) `((,groups ,off)))
						(assign `((,groups ,(+ off 8))) `(,v))
						(vp-mul-cr levels v)
						(vp-add-rr b v)
						(vp-add-cr base v))
					'((1 0 5 3 0) (2 16 7 3 96) (4 32 7 2 480)))
				(endif)
			(endif)
			(vp-shl-cr 3 v)
			(vp-cpy-df table v :f0)
		(else)
			;a number of q bits, q b - 1 to 13 bits, then 14 and 16, by 2^-(q-1)
			(vpif `(,b < 14))
				(vp-sub-cr 1 b)
			(else)
				(vp-add-rr b b)
				(vp-sub-cr 14 b)
			(endif)
			(media-read in at b v x y)
			(vp-cpy-cr 64 x)
			(vp-sub-rr b x)
			(vp-shl-rr x v)
			(vp-asr-rr x v)
			(vp-cvt-rf v :f0)
			(vp-sub-cr 1 b)
			(vp-cpy-cr 1 y)
			(vp-shl-rr b y)
			(vp-cvt-rf y :f1)
			(vp-div-ff :f1 :f0)
		(endif)
		;by 2^-exponent
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr exps x b)
		(vp-cpy-cr 1 y)
		(vp-shl-rr b y)
		(vp-cvt-rf y :f1)
		(vp-div-ff :f1 :f0)
		(vp-cpy-fd :f0 out x)
		(vp-add-cr 1 bin)
	(loop-until `(,bin = ,end))
	(endif)
	;the reader's place
	(vp-pop x)
	(assign `(,at) `((,x 0)))
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-mantissas reader bap exps start end out groups noise dither table)" +error_msg_wrong_types))
	(signature '(:list :nums :nums :num :num :reals :nums :reals :num :reals)))

(def-func-end)

(def-func (path-to-absolute "./media_ac3_psd"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-ac3-psd exps start end psd band_psd band_start bin_band log_add)
	;-> psd, of AC-3's bit allocation, nums all: the power of each bin start
	;to end from its exponent, 3072 less 128 a step, and of each band, the
	;first 28 bins a band each, the bins of the others added as logs are,
	;by the table log_add. band_psd is 50 long and made 0 first

	(vp-rdef (exps bin end psd band_psd band_start bin_band log_add v p x band top)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 8)

	(vp-push :r0)
	(list-bind-args :r1 `(,exps ,bin ,end ,psd ,band_psd ,band_start ,bin_band ,log_add)
		'(:obj :num :num :obj :obj :obj :obj :obj))
	(vp-push psd)
	(assign `((,exps +array_begin) (,psd +array_begin) (,band_psd +array_begin)
		(,band_start +array_begin) (,bin_band +array_begin) (,log_add +array_begin))
		`(,exps ,psd ,band_psd ,band_start ,bin_band ,log_add))
	;the bands made 0
	(vp-xor-rr v v)
	(vp-cpy-cr 0 x)
	(loop-start)
		(vp-cpy-rd v band_psd x)
		(vp-add-cr +long_size x)
	(loop-until `(,x = ,(* 50 +long_size)))
	;the power of each bin
	(vpif `(,bin < ,end))
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-rr end p)
		(vp-shl-cr 3 p)
		(loop-start)
			(vp-cpy-dr exps x v)
			(vp-shl-cr 7 v)
			(vp-cpy-cr 3072 top)
			(vp-sub-rr v top)
			(vp-cpy-rd top psd x)
			(vp-add-cr +long_size x)
		(loop-until `(,x = ,p))
	(endif)
	;the first 28 a band each
	(vpif `(,bin < ,end) `(,bin < 28))
	(loop-start)
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr psd x v)
		(vp-cpy-rd v band_psd x)
		(vp-add-cr 1 bin)
		(breakif `(,bin = 28))
	(loop-until `(,bin = ,end))
	(endif)
	;the rest by bands, each its bins added as logs
	(vpif `(,bin < ,end))
		(vp-cpy-rr bin x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr bin_band x band)
		(loop-start)
			(vp-cpy-rr bin x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr psd x v)
			;the end of this band, at most end
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-add-cr +long_size x)
			(vp-cpy-dr band_start x top)
			(vpif `(,top > ,end))
				(vp-cpy-rr end top)
			(endif)
			;the end of the band where the exponents were, done with
			(vp-cpy-rr top exps)
			(vp-add-cr 1 bin)
			(vpif `(,bin < ,exps))
			(loop-start)
				(vp-cpy-rr bin x)
				(vp-shl-cr 3 x)
				(vp-cpy-dr psd x p)
				;the higher, and the log table by how far the other is below
				(vp-cpy-rr v top)
				(vpif `(,p > ,top))
					(vp-cpy-rr p top)
				(endif)
				(vp-add-rr p v)
				(vp-add-cr 1 v)
				(vp-shr-cr 1 v)
				(vp-cpy-rr top x)
				(vp-sub-rr v x)
				(vpif `(,x > 255))
					(vp-cpy-cr 255 x)
				(endif)
				(vp-shl-cr 3 x)
				(vp-cpy-dr log_add x v)
				(vp-add-rr top v)
				(vp-add-cr 1 bin)
			(loop-until `(,bin = ,exps))
			(endif)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-rd v band_psd x)
			(vp-add-cr 1 band)
			(vp-add-cr +long_size x)
			(vp-cpy-dr band_start x x)
		(loop-until `(,end <= ,x))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-psd exps start end psd band_psd band_start bin_band log_add)" +error_msg_wrong_types))
	(signature '(:nums :num :num :nums :nums :nums :nums :nums)))

(def-func-end)

(def-func (path-to-absolute "./media_ac3_bap"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-ac3-bap psd mask start end snr floor tab bap band_start bin_band)
	;-> bap, of AC-3's bit allocation, nums all: the bits of each bin's
	;mantissa start to end, by its power above its band's mask less the SNR
	;offset, to the floor, of 32 a step, the address in tab, 0 to 63

	(vp-rdef (psd mask bin end snr floor tab bap band_start bin_band m to x band)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 10)

	(vp-push :r0)
	(list-bind-args :r1 `(,psd ,mask ,bin ,end ,snr ,floor ,tab ,bap ,band_start ,bin_band)
		'(:obj :obj :num :num :num :num :obj :obj :obj :obj))
	(vp-push bap)
	(assign `((,psd +array_begin) (,mask +array_begin) (,tab +array_begin) (,bap +array_begin)
		(,band_start +array_begin) (,bin_band +array_begin))
		`(,psd ,mask ,tab ,bap ,band_start ,bin_band))
	(vpif `(,bin < ,end))
	(loop-start)
		;the band, and where it ends: the first 28 bins a band each
		(vpif `(,bin < 28))
			(vp-cpy-rr bin band)
			(vp-lea-i bin 1 to)
		(else)
			(vp-cpy-rr bin x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bin_band x band)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-add-cr +long_size x)
			(vp-cpy-dr band_start x to)
			(vpif `(,to > ,end))
				(vp-cpy-rr end to)
			(endif)
		(endif)
		;the mask of the band less the SNR offset and the floor, to 32 a
		;step, and the floor
		(vp-cpy-rr band x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr mask x m)
		(vp-sub-rr snr m)
		(vp-sub-rr floor m)
		(vpif `(,m < 0))
			(vp-xor-rr m m)
		(endif)
		(vp-and-cr 0x1fe0 m)
		(vp-add-rr floor m)
		(loop-start)
			(vp-cpy-rr bin x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr psd x band)
			(vp-sub-rr m band)
			(vp-asr-cr 5 band)
			(vpif `(,band < 0))
				(vp-xor-rr band band)
			(elseif `(,band > 63))
				(vp-cpy-cr 63 band)
			(endif)
			(vp-shl-cr 3 band)
			(vp-cpy-dr tab band band)
			(vp-cpy-rd band bap x)
			(vp-add-cr 1 bin)
		(loop-until `(,bin = ,to))
	(loop-until `(,bin = ,end))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-bap psd mask start end snr floor tab bap band_start bin_band)" +error_msg_wrong_types))
	(signature '(:nums :nums :num :num :num :num :nums :nums :nums :nums)))

(def-func-end)

(defun ac3-lc1 (a b0 b1 c y)
	;the low frequency compensation a, by the power of a band b0 and the
	;next b1: c if b1 is 256 above, 64 less, to 0, if b0 is the higher
	(vp-lea-i b0 256 y)
	(vpif `(,y = ,b1))
		(vp-cpy-cr c a)
	(elseif `(,b0 > ,b1))
		(vp-sub-cr 64 a)
		(vpif `(,a < 0))
			(vp-xor-rr a a)
		(endif)
	(endif))

(defun ac3-max (a b)
	;a the higher of a and b
	(vpif `(,a < ,b))
		(vp-cpy-rr b a)
	(endif))

(defun ac3-leaks (fl sl t fg prm y)
	;the fast and slow leaks of a band of power t, each by its decay or the
	;power less its gain, whichever is the higher
	(assign `((,prm 8)) `(,y))
	(vp-sub-rr y fl)
	(vp-cpy-rr t y)
	(vp-sub-rr fg y)
	(ac3-max fl y)
	;the slow by its gain, max(sl - decay, t - gain) as max(sl - decay +
	;gain, t) - gain, with the one spare
	(assign `((,prm 16)) `(,y))
	(vp-sub-rr y sl)
	(assign `((,prm 0)) `(,y))
	(vp-add-rr y sl)
	(ac3-max sl t)
	(vp-sub-rr y sl))

(def-func (path-to-absolute "./media_ac3_mask"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-ac3-mask band_psd start end fast_gain lfe params threshold
	;bin_band mask) -> mask, of AC-3's bit allocation, the masking curve of
	;each band of bins start to end: the excitation by the fast and slow
	;leaks of the bands, of the first 22 the low frequency compensation too
	;and of the coupling channel its leaks from the stream, raised where
	;the power is under the dB a bit, and the threshold of hearing at least.
	;params is nums of the slow gain, fast decay, slow decay, dB a bit, the
	;rate, the coupling fast and slow leaks; threshold nums of 3 rates a
	;band; lfe 1 for the LFE. All nums, mask 50 long

	(vp-rdef (bpsd mask prm fg lfe band begin bend lowcomp fl sl t u x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r0 :r1))

	(entry `(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 9)

	(vp-push :r0)
	(list-bind-args :r1 `(,bpsd ,begin ,bend ,fg ,lfe ,prm ,t ,u ,mask)
		'(:obj :num :num :num :num :obj :obj :obj :obj))
	(vp-push mask)
	(vp-push t)
	(assign `((,bpsd +array_begin) (,prm +array_begin) (,mask +array_begin) (,u +array_begin))
		`(,bpsd ,prm ,mask ,u))
	;the bands of the bins, the first and one past the last
	(vp-shl-cr 3 begin)
	(vp-cpy-dr u begin begin)
	(vp-sub-cr 1 bend)
	(vp-shl-cr 3 bend)
	(vp-cpy-dr u bend bend)
	(vp-add-cr 1 bend)
	(vp-push begin)
	(vpif `(,begin = 0))
		;the first two, then on till a band is no higher than the next
		(vp-xor-rr lowcomp lowcomp)
		(each (lambda (o)
				(defq n (+ o 8))
				(assign `((,bpsd ,o) (,bpsd ,n)) `(,t ,u))
				(ac3-lc1 lowcomp t u 384 y)
				(vp-sub-rr fg t)
				(vp-sub-rr lowcomp t)
				(assign `(,t) `((,mask ,o))))
			'(0 8))
		(vp-cpy-cr 7 begin)
		(vp-cpy-cr 2 band)
		(loop-start 'low_bands)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bpsd x t)
			(vp-add-cr 8 x)
			(vp-cpy-dr bpsd x u)
			;the LFE's band 6 leaves the compensation as it is
			(vp-xor-rr y y)
			(vpif `(,lfe /= 0) `(,band = 6))
				(vp-cpy-cr 1 y)
			(endif)
			(vpif `(,y = 0))
				(ac3-lc1 lowcomp t u 384 y)
				(vp-xor-rr y y)
			(endif)
			(vp-cpy-rr t fl)
			(vp-sub-rr fg fl)
			(assign `((,prm 0)) `(,x))
			(vp-cpy-rr t sl)
			(vp-sub-rr x sl)
			(vp-cpy-rr fl x)
			(vp-sub-rr lowcomp x)
			(vp-push x)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-pop y)
			(vp-cpy-rd y mask x)
			;the LFE's band 6 again, for the test
			(vp-xor-rr y y)
			(vpif `(,lfe /= 0) `(,band = 6))
				(vp-cpy-cr 1 y)
			(endif)
			(vpif `(,y = 0) `(,t <= ,u))
				(vp-lea-i band 1 begin)
				(break 'low_bands)
			(endif)
			(vp-add-cr 1 band)
		(loop-until `(,band = 7))
		;on to band 22, or the end, the compensation by the band
		(vp-cpy-rr begin band)
		(vp-cpy-rr bend begin)
		(vpif `(,begin > 22))
			(vp-cpy-cr 22 begin)
		(endif)
		(vpif `(,band < ,begin))
		(loop-start)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bpsd x t)
			(vp-add-cr 8 x)
			(vp-cpy-dr bpsd x u)
			(vp-xor-rr y y)
			(vpif `(,lfe /= 0) `(,band = 6))
				(vp-cpy-cr 1 y)
			(endif)
			(vpif `(,y = 0))
				(vpif `(,band < 7))
					(ac3-lc1 lowcomp t u 384 y)
				(elseif `(,band < 20))
					(ac3-lc1 lowcomp t u 320 y)
				(else)
					(vp-sub-cr 128 lowcomp)
					(vpif `(,lowcomp < 0))
						(vp-xor-rr lowcomp lowcomp)
					(endif)
				(endif)
			(endif)
			(ac3-leaks fl sl t fg prm y)
			(vp-cpy-rr fl x)
			(vp-sub-rr lowcomp x)
			(ac3-max x sl)
			(vp-cpy-rr band y)
			(vp-shl-cr 3 y)
			(vp-cpy-rd x mask y)
			(vp-add-cr 1 band)
		(loop-until `(,band = ,begin))
		(endif)
		(vp-cpy-cr 22 begin)
	(else)
		;the coupling channel, its leaks from the stream
		(assign `((,prm 40) (,prm 48)) `(,fl ,sl))
		(vp-shl-cr 8 fl)
		(vp-add-cr 768 fl)
		(vp-shl-cr 8 sl)
		(vp-add-cr 768 sl)
	(endif)
	;the rest by the leaks alone
	(vpif `(,begin < ,bend))
		(vp-cpy-rr begin band)
		(loop-start)
			(vp-cpy-rr band x)
			(vp-shl-cr 3 x)
			(vp-cpy-dr bpsd x t)
			(ac3-leaks fl sl t fg prm y)
			(vp-cpy-rr fl y)
			(ac3-max y sl)
			(vp-cpy-rd y mask x)
			(vp-add-cr 1 band)
		(loop-until `(,band = ,bend))
	(endif)
	;the mask, raised where the power is under the dB a bit, the threshold
	;of hearing of the band at the rate at least
	(vp-pop band)
	(vp-pop t)
	(assign `((,t +array_begin)) `(,t))
	(vpif `(,band < ,bend))
	(loop-start)
		(vp-cpy-rr band x)
		(vp-shl-cr 3 x)
		(vp-cpy-dr mask x u)
		(assign `((,prm 24)) `(,y))
		(vp-cpy-dr bpsd x fl)
		(vp-sub-rr fl y)
		(vpif `(,y > 0))
			(vp-shr-cr 2 y)
			(vp-add-rr y u)
		(endif)
		(vp-cpy-rr band y)
		(vp-mul-cr 3 y)
		(assign `((,prm 32)) `(,fl))
		(vp-add-rr fl y)
		(vp-shl-cr 3 y)
		(vp-cpy-dr t y y)
		(ac3-max u y)
		(vp-cpy-rd u mask x)
		(vp-add-cr 1 band)
	(loop-until `(,band = ,bend))
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit `(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-ac3-mask band_psd start end fast_gain lfe params threshold bin_band mask)" +error_msg_wrong_types))
	(signature '(:nums :num :num :num :num :nums :nums :nums :nums)))

(def-func-end)
