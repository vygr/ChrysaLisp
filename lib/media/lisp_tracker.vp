(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "class/doubles/class.inc")

;the voices of a tracker's song, lib/media/tracker.inc, mixed. A voice is
;+mix_size longs of a nums: its sample, -1 none, where it is in it and its
;step a frame, 16.16, its weights left and right, its loop's start, -1
;none, its end, in samples, and its flags: +mix_pingpong a loop that goes
;back and forth, +mix_back going back now. Then its filter, an IT's, as
;libxmp's: a0 b0 b1 of 22 bits, a0 0 none, and its last two outputs. And
;what is added to where it is for the sample it plays: 0 the one it is
;at, an Amiga's, half a sample the nearest, as a PC's tracker. Last its
;ring, a sample it is times, -1 none, round its loop as it is, where it is
;in it and its step, an AHX's of HivelyTracker. lib/media/tracker.inc has
;the same fields by number, +mix_sample and on
(defcvar '+mix_pingpong 1 '+mix_back 2)

(structure voice 0
	(long sample pos step left right loop end flags fa0 fb0 fb1 fy1 fy2 round ring ring_pos ring_step))

(def-func (path-to-absolute "./media_mix"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-mix out acc samples state) -> out, the voices of state mixed into
	;out, a str of frames of two 16 bit samples, left first, low byte first,
	;as many frames as it is long. acc is nums of two a frame or more, what
	;is summed. samples is the list of the samples, a str each of 16 bit
	;signed, low byte first. Each sample of a voice is times its weights,
	;the sum of them moved down 16 and held to 16 bits. A voice past its end
	;with no loop is put to -1, where each is and which way it goes is kept
	;in state. Going back, its step is made less than 0 while it is mixed

	(structure slot 0
		(ptr this out acc samples state ring)
		(long frames stend))

	(vp-rdef (dptr pos step wl wr lsq endq a n s x llen st stend)
		'(:r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5) '(:obj :obj :obj :obj))
	(save-fields :rsp '(slot_out slot_acc slot_samples slot_state) '(:r2 :r3 :r4 :r5))

	;the frames, and the sums all 0
	(assign '((:r2 +str_length)) `(,n))
	(vp-shr-cr 2 n)
	(assign `(,n) '((:rsp slot_frames)))
	(vpif `(,n /= 0))
		(assign '((:r3 +array_begin)) `(,a))
		(vp-shl-cr 1 n)
		(vp-xor-rr x x)
		(loop-start)
			(vp-store-rrc x a 0)
			(vp-add-cr +long_size a)
			(vp-sub-cr 1 n)
		(loop-until `(,n = 0))

		;each voice
		(assign '((:r5 +array_begin) (:r5 +array_length ui)) `(,st ,stend))
		(vp-shl-cr (log2 +long_size) stend)
		(vp-add-rr st stend)
		;kept, its register a filter's in the frames
		(assign `(,stend) '((:rsp slot_stend)))
		(vpif `(,st /= ,stend))
			(loop-start)
				(assign `((,st voice_sample)) `(,s))
				(vpif `(,s >= 0))
					;its sample's bytes, and where it is, how it goes, which
					;way, and its loop, lsq less than 0 none
					(assign '((:rsp slot_samples)) `(,x))
					(assign `((,x +array_begin)) `(,x))
					(vp-shl-cr (log2 +long_size) s)
					(vp-load-rrr x s dptr)
					(vp-lea-rcr dptr +str_data dptr)
					;its ring's bytes, 0 none
					(assign `((,st voice_ring)) `(,s))
					(vp-xor-rr x x)
					(vpif `(,s >= 0))
						(assign '((:rsp slot_samples)) `(,x))
						(assign `((,x +array_begin)) `(,x))
						(vp-shl-cr (log2 +long_size) s)
						(vp-load-rrr x s x)
						(vp-lea-rcr x +str_data x)
					(endif)
					(assign `(,x) '((:rsp slot_ring)))
					(load-fields st `(,voice_pos ,voice_step ,voice_left ,voice_right ,voice_loop ,voice_end ,voice_flags) `(,pos ,step ,wl ,wr ,lsq ,endq ,x))
					(vp-and-cr +mix_back x)
					(vpif `(,x /= 0))
						(vp-mul-cr -1 step)
					(endif)
					(vp-shl-cr 16 endq)
					(vpif `(,lsq >= 0))
						(vp-shl-cr 16 lsq)
					(endif)
					(vp-cpy-rr endq llen)
					(vp-sub-rr lsq llen)
					(assign '((:rsp slot_acc) (:rsp slot_frames)) `(,a ,n))
					(assign `((,a +array_begin)) `(,a))
					(loop-start 'frames)
						(vpif `(,pos >= ,endq))
							;past its end: round its loop, back along it, or
							;it has ended
							(vpif `(,lsq < 0))
								(vp-cpy-cr -1 x)
								(vp-store-rrc x st voice_sample)
								(break 'frames)
							(endif)
							(assign `((,st voice_flags)) `(,x))
							(vp-and-cr +mix_pingpong x)
							(vpif `(,x /= 0))
								(vp-cpy-rr endq x)
								(vp-add-rr endq x)
								(vp-sub-cr 0x10000 x)
								(vp-sub-rr pos x)
								(vp-cpy-rr x pos)
								(vpif `(,pos < ,lsq))
									(vp-cpy-rr lsq pos)
								(endif)
								(vp-mul-cr -1 step)
							(else)
								(loop-start)
									(vp-sub-rr llen pos)
								(loop-until `(,pos < ,endq))
							(endif)
						(elseif `(,step < 0))
							;going back, past its loop's start: forward again
							(vpif `(,pos < ,lsq))
								(vp-cpy-rr lsq x)
								(vp-add-rr lsq x)
								(vp-sub-rr pos x)
								(vp-cpy-rr x pos)
								(vpif `(,pos >= ,endq))
									(vp-cpy-rr lsq pos)
								(endif)
								(vp-mul-cr -1 step)
							(endif)
						(endif)
						;the sample it is at, or the nearest, round its loop or
						;the last if that is past the end
						(vp-cpy-rr pos x)
						(assign `((,st voice_round)) '(:r0))
						(vp-add-rr :r0 x)
						(vpif `(,x >= ,endq))
							(vpif `(,lsq >= 0))
								(vp-sub-rr llen x)
							(else)
								(vp-cpy-rr endq x)
								(vp-sub-cr 0x10000 x)
							(endif)
						(endif)
						(vp-asr-cr 16 x)
						(vp-shl-cr 1 x)
						(vp-load-rrr-s dptr x s)
						;filtered, a0 not 0: two poles, as libxmp's, of the
						;sample 15 bits up, held to 17 bits, and down again
						(assign `((,st voice_fa0)) '(:r0))
						(vpif '(:r0 /= 0))
							(vp-shl-cr 15 s)
							(vp-mul-rr :r0 s)
							(assign `((,st voice_fb0) (,st voice_fy1)) `(:r0 ,stend))
							(vp-mul-rr stend :r0)
							(vp-add-rr :r0 s)
							(assign `((,st voice_fb1) (,st voice_fy2)) `(:r0 ,stend))
							(vp-mul-rr stend :r0)
							(vp-add-rr :r0 s)
							(vp-asr-cr 22 s)
							(vp-cpy-cr (* -65536 32768) :r0)
							(vpif `(,s < :r0))
								(vp-cpy-rr :r0 s)
							(endif)
							(vp-cpy-cr (* 65535 32768) :r0)
							(vpif `(,s > :r0))
								(vp-cpy-rr :r0 s)
							(endif)
							(assign `((,st voice_fy1)) '(:r0))
							(assign `(:r0 ,s) `((,st voice_fy2) (,st voice_fy1)))
							(vp-asr-cr 15 s)
						(endif)
						;rung: the byte of each, times, down 7, as HivelyTracker's,
						;and the ring on round the loop
						(assign '((:rsp slot_ring)) '(:r0))
						(vpif '(:r0 /= 0))
							(assign `((,st voice_ring_pos)) `(,x))
							(vpif `(,x >= ,endq))
								(vp-sub-rr llen x)
							(endif)
							(vp-cpy-rr x stend)
							(vp-asr-cr 16 stend)
							(vp-shl-cr 1 stend)
							(vp-load-rrr-s :r0 stend :r0)
							(vp-asr-cr 8 :r0)
							(vp-asr-cr 8 s)
							(vp-mul-rr :r0 s)
							(vp-asr-cr 7 s)
							(vp-shl-cr 8 s)
							(assign `((,st voice_ring_step)) `(,stend))
							(vp-add-rr stend x)
							(vp-store-rrc x st voice_ring_pos)
						(endif)
						(vp-cpy-rr s x)
						(vp-mul-rr wl x)
						(vp-mul-rr wr s)
						(vp-load-rcr a 0 :r0)
						(vp-add-rr x :r0)
						(vp-store-rrc :r0 a 0)
						(vp-load-rcr a 8 :r0)
						(vp-add-rr s :r0)
						(vp-store-rrc :r0 a 8)
						(vp-add-cr (* 2 +long_size) a)
						(vp-add-rr step pos)
						(vp-sub-cr 1 n)
					(loop-until `(,n = 0))
					;where it is, and which way it goes
					(vp-store-rrc pos st voice_pos)
					(assign `((,st voice_flags)) `(,x))
					(vp-and-cr +mix_pingpong x)
					(vpif `(,step < 0))
						(vp-or-cr +mix_back x)
					(endif)
					(vp-store-rrc x st voice_flags)
				(endif)
				(vp-add-cr voice_size st)
				(assign '((:rsp slot_stend)) `(,stend))
			(loop-until `(,st = ,stend))
		(endif)

		;the sums, moved down and held to 16 bits
		(assign '((:rsp slot_acc) (:rsp slot_out) (:rsp slot_frames)) `(,a ,dptr ,n))
		(assign `((,a +array_begin)) `(,a))
		(vp-lea-rcr dptr +str_data dptr)
		(vp-shl-cr 1 n)
		(vp-cpy-cr 32767 wl)
		(vp-cpy-cr -32768 wr)
		(loop-start)
			(vp-load-rcr a 0 x)
			(vp-asr-cr 16 x)
			(vpif `(,x > ,wl))
				(vp-cpy-rr wl x)
			(elseif `(,x < ,wr))
				(vp-cpy-rr wr x)
			(endif)
			(vp-store-rrc-s x dptr 0)
			(vp-add-cr +long_size a)
			(vp-add-cr 2 dptr)
			(vp-sub-cr 1 n)
		(loop-until `(,n = 0))
	(endif)

	(assign '((:rsp slot_out) (:rsp slot_this)) '(:r1 :r0))
	(vp-free slot_size)
	(class/obj/ref :r1 :r2)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-mix out acc samples state)" +error_msg_wrong_types))
	(signature '(:str :nums :list :nums))

(def-func-end)

;the samples of a module made the mixer's: 16 bit signed, low byte first
(defcvar '+widen_s8 0 '+widen_u8 1 '+widen_s16 2 '+widen_u16 3 '+widen_d8 4 '+widen_d16 5
	'+widen_s16be 6 '+widen_s8x2 7 '+widen_s16bex2 8)

(def-func (path-to-absolute "./media_widen"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8
	;info
	;(media-widen out src from kind) -> out, as many samples as out holds,
	;two bytes each, from the bytes of src at from, of a kind: +widen_s8 8
	;bit signed, +widen_u8 unsigned, +widen_s16 and +widen_u16 16 bit low
	;byte first, +widen_d8 and +widen_d16 each the change from the last, as
	;Fasttracker keeps them, +widen_s16be 16 bit signed high byte first, as
	;the Amiga's, and +widen_s8x2 and +widen_s16bex2 a stereo sample of 8
	;bits or of 16 high byte first, all its left then all its right, as
	;OctaMED keeps one, made one channel, half their sum. src holds them all

	(vp-rdef (out src kind n v acc src2)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,src ,n ,kind) '(:obj :obj :num :num))
	(vp-push out)
	(vp-lea-rcr src +str_data src)
	(vp-add-rr n src)
	(assign `((,out +str_length)) `(,n))
	(vp-shr-cr 1 n)
	(vp-lea-rcr out +str_data out)
	(vp-xor-rr acc acc)
	(vpif `(,n /= 0))
		(vpif `(,kind = +widen_s8))
			(loop-start)
				(vp-load-rcr-b src 0 v)
				(vp-shl-cr 8 v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 1 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_u8))
			(loop-start)
				(vp-load-rcr-ub src 0 v)
				(vp-sub-cr 128 v)
				(vp-shl-cr 8 v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 1 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_s16))
			;a byte at a time, as all of 16 bits are: a file has them at
			;any address, and a load of 16 bits is of an even one
			(loop-start)
				(vp-load-rcr-b src 1 v)
				(vp-shl-cr 8 v)
				(vp-load-rcr-ub src 0 acc)
				(vp-add-rr acc v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 2 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_u16))
			(loop-start)
				(vp-load-rcr-ub src 1 v)
				(vp-shl-cr 8 v)
				(vp-load-rcr-ub src 0 acc)
				(vp-add-rr acc v)
				(vp-sub-cr 32768 v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 2 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_d8))
			(loop-start)
				(vp-load-rcr-b src 0 v)
				(vp-add-rr v acc)
				(vp-shl-cr 56 acc)
				(vp-asr-cr 56 acc)
				(vp-cpy-rr acc v)
				(vp-shl-cr 8 v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 1 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_d16))
			;src2 is free for the low byte
			(loop-start)
				(vp-load-rcr-b src 1 v)
				(vp-shl-cr 8 v)
				(vp-load-rcr-ub src 0 src2)
				(vp-add-rr src2 v)
				(vp-add-rr v acc)
				(vp-shl-cr 48 acc)
				(vp-asr-cr 48 acc)
				(vp-store-rrc-s acc out 0)
				(vp-add-cr 2 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_s16be))
			;the high one first
			(loop-start)
				(vp-load-rcr-b src 0 v)
				(vp-shl-cr 8 v)
				(vp-load-rcr-ub src 1 acc)
				(vp-add-rr acc v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 2 src)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_s8x2))
			;the right is as many bytes on as there are samples
			(vp-cpy-rr src src2)
			(vp-add-rr n src2)
			(loop-start)
				(vp-load-rcr-b src 0 v)
				(vp-load-rcr-b src2 0 acc)
				(vp-add-rr acc v)
				(vp-shl-cr 7 v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 1 src)
				(vp-add-cr 1 src2)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(elseif `(,kind = +widen_s16bex2))
			;and of 16 bits twice as many; kind is free for the low bytes
			(vp-cpy-rr n src2)
			(vp-shl-cr 1 src2)
			(vp-add-rr src src2)
			(loop-start)
				(vp-load-rcr-b src 0 v)
				(vp-shl-cr 8 v)
				(vp-load-rcr-ub src 1 kind)
				(vp-add-rr kind v)
				(vp-load-rcr-b src2 0 acc)
				(vp-shl-cr 8 acc)
				(vp-load-rcr-ub src2 1 kind)
				(vp-add-rr kind acc)
				(vp-add-rr acc v)
				(vp-asr-cr 1 v)
				(vp-store-rrc-s v out 0)
				(vp-add-cr 2 src)
				(vp-add-cr 2 src2)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 n)
			(loop-until `(,n = 0))
		(endif)
	(endif)

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-widen out src from kind)" +error_msg_wrong_types))
	(signature '(:str :str :num :num))

(def-func-end)

;the samples of an IT packed, Impulse Tracker's own: blocks of so many,
;each its byte count then its codes, a code's width in bits changing as
;the codes say, each the change from the last
(defcvar '+itunpack_16 1 '+itunpack_215 2 '+itunpack_unsigned 4)

(defun itunpack-read (n v src end bbuf bnum x eof)
	;the next n bits, n a reg, low bit first, into v; to eof past the end
	(loop-while `(,bnum < ,n))
		(gotoif `(,src >= ,end) eof)
		(vp-load-rcr-ub src 0 x)
		(vp-shl-rr bnum x)
		(vp-or-rr x bbuf)
		(vp-add-cr 1 src)
		(vp-add-cr 8 bnum)
	(loop-end)
	(vp-cpy-cr 1 x)
	(vp-shl-rr n x)
	(vp-sub-cr 1 x)
	(vp-cpy-rr bbuf v)
	(vp-and-rr x v)
	(vp-shr-rr n bbuf)
	(vp-sub-rr n bnum))

(defun itunpack-width (wide out src end n mode d bbuf bnum left temp temp2 bits x y eof)
	;the codes of one width of sample, 8 or 16 bits, into the mixer's
	(bind '(block left0 esc mid big wrap maski offi offj sext shift unsigned label)
		(if wide
			(list 0x4000 17 4 17 18 0x10000 0xffff 8 16 16 48 0x8000 'unpack16)
			(list 0x8000 9 3 9 10 256 0xff 4 8 8 56 0x80 'unpack8)))
	(loop-start 'blocks)
		;a block: its count of bytes, not needed, and a new start
		(vp-add-cr 2 src)
		(gotoif `(,src > ,end) eof)
		(vp-cpy-cr block d)
		(vpif `(,d > ,n))
			(vp-cpy-rr n d)
		(endif)
		(vp-sub-rr d n)
		(vp-xor-rr bbuf bbuf)
		(vp-xor-rr bnum bnum)
		(vp-cpy-cr left0 left)
		(vp-xor-rr temp temp)
		(vp-xor-rr temp2 temp2)
		(loop-start 'codes)
			(itunpack-read left bits src end bbuf bnum x eof)
			(vpif `(,left < 7))
				;all but the top bit set says a new width follows
				(vp-cpy-cr 1 x)
				(vp-cpy-rr left y)
				(vp-sub-cr 1 y)
				(vp-shl-rr y x)
				(gotoif `(,bits /= ,x) label)
				(vp-cpy-cr esc y)
				(itunpack-read y bits src end bbuf bnum x eof)
				(vp-add-cr 1 bits)
				(vpif `(,bits >= ,left))
					(vp-add-cr 1 bits)
				(endif)
				(vp-cpy-rr bits left)
				(continue 'codes)
			(elseif `(,left < ,mid))
				;the top few values of the width say a new width
				(vp-cpy-cr maski x)
				(vp-cpy-cr mid y)
				(vp-sub-rr left y)
				(vp-shr-rr y x)
				(vp-add-cr offi x)
				(vp-cpy-rr x y)
				(vp-sub-cr offj y)
				(gotoif `(,bits <= ,y) label)
				(gotoif `(,bits > ,x) label)
				(vp-sub-rr y bits)
				(vp-and-cr 0xff bits)
				(vpif `(,bits >= ,left))
					(vp-add-cr 1 bits)
					(vp-and-cr 0xff bits)
				(endif)
				(vp-cpy-rr bits left)
				(continue 'codes)
			(elseif `(,left >= ,big))
				;a width too wide is a sample of 0
				(vp-xor-rr x x)
				(vp-store-rrc-s x out 0)
				(vp-add-cr 2 out)
				(vp-sub-cr 1 d)
				(continue 'codes)
			(elseif `(,bits >= ,wrap))
				;the widest, past its values, a new width
				(vp-cpy-rr bits left)
				(vp-add-cr 1 left)
				(vp-and-cr 0xff left)
				(continue 'codes)
			(endif)
		(vp-label label)
			;a change, of the width's bits signed, from the last
			(vpif `(,left < ,sext))
				(vp-cpy-cr 64 x)
				(vp-sub-rr left x)
				(vp-shl-rr x bits)
				(vp-asr-rr x bits)
			(endif)
			(vp-add-rr bits temp)
			(vp-shl-cr shift temp)
			(vp-asr-cr shift temp)
			(vp-add-rr temp temp2)
			(vp-shl-cr shift temp2)
			(vp-asr-cr shift temp2)
			(vp-cpy-rr temp x)
			(vpif `(,mode >= +itunpack_215))
				(vp-cpy-rr mode y)
				(vp-and-cr +itunpack_215 y)
				(vpif `(,y /= 0))
					(vp-cpy-rr temp2 x)
				(endif)
			(endif)
			(vpif `(,mode >= +itunpack_unsigned))
				(vp-xor-cr unsigned x)
				(vp-shl-cr shift x)
				(vp-asr-cr shift x)
			(endif)
			(unless wide (vp-shl-cr 8 x))
			(vp-store-rrc-s x out 0)
			(vp-add-cr 2 out)
			(vp-sub-cr 1 d)
		(loop-until `(,d = 0))
	(loop-until `(,n = 0)))

(def-func (path-to-absolute "./media_itunpack"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(media-itunpack out src from mode) -> out, as many samples as out holds,
	;two bytes each, unpacked from the bytes of src at from, Impulse
	;Tracker's packing of a sample: mode +itunpack_16 of 16 bit samples,
	;else 8, +itunpack_215 its second form, each sample the change of the
	;change, +itunpack_unsigned unsigned. What src does not hold is 0

	(vp-rdef (out src end n mode d bbuf bnum left temp temp2 bits x y)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r1))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 4)

	(vp-push :r0)
	(list-bind-args :r1 `(,out ,src ,n ,mode) '(:obj :obj :num :num))
	(vp-push out)
	(assign `((,src +str_length)) `(,end))
	(vp-lea-rcr src +str_data src)
	(vp-add-rr src end)
	(vp-add-rr n src)
	(assign `((,out +str_length)) `(,n))
	(vp-shr-cr 1 n)
	(vp-lea-rcr out +str_data out)
	(vp-xor-rr d d)
	(vpif `(,n /= 0))
		(vp-cpy-rr mode x)
		(vp-and-cr +itunpack_16 x)
		(vpif `(,x /= 0))
			(itunpack-width :t out src end n mode d bbuf bnum left temp temp2 bits x y 'eof)
		(else)
			(itunpack-width :nil out src end n mode d bbuf bnum left temp temp2 bits x y 'eof)
		(endif)
	(endif)
	(goto 'done)

(vp-label 'eof)
	;what is not there, 0
	(vp-add-rr d n)
	(vpif `(,n /= 0))
		(vp-xor-rr x x)
		(loop-start)
			(vp-store-rrc-s x out 0)
			(vp-add-cr 2 out)
			(vp-sub-cr 1 n)
		(loop-until `(,n = 0))
	(endif)

(vp-label 'done)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-itunpack out src from mode)" +error_msg_wrong_types))
	(signature '(:str :str :num :num))

(def-func-end)

(def-func (path-to-absolute "./media_spectrum"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d9
	;info
	;(media-spectrum pcm from x tw rev win pow) -> pow, the power of each of
	;the first n/2 frequencies of n frames of pcm from frame from, its two
	;channels added, times the window win. n is the length of rev, the bit
	;reversal of n, and of win; x is 2n doubles, worked in; tw the twiddles
	;of an FFT of n, e^(-2 pi i k/n) as cos and sin, n/2 of them; pow n/2
	;doubles. pcm is frames of two 16 bit samples, as many as from + n

	(vp-rdef (src g x tw rev f pw n j a b c d e)
		'(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14 :r1))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 7)

	(vp-push :r0)
	(list-bind-args :r1 `(,src ,g ,x ,tw ,rev ,f ,pw) '(:obj :num :obj :obj :obj :obj :obj))
	(vp-push pw)
	(assign `((,rev +array_length ui)) `(,n))
	(assign `((,x +array_begin) (,tw +array_begin) (,rev +array_begin) (,f +array_begin) (,pw +array_begin))
		`(,x ,tw ,rev ,f ,pw))
	(vp-lea-rcr src +str_data src)
	(vp-shl-cr 2 g)
	(vp-add-rr g src)

	;each frame its two channels added, by its window, to its place bit
	;reversed, a complex of no imaginary part
	(vp-xor-rr j j)
	(loop-start)
		(vp-load-rcr-s src 0 a)
		(vp-load-rcr-s src 2 b)
		(vp-add-rr b a)
		(vp-cvt-rd a :d0)
		(vp-cpy-rr j a)
		(vp-shl-cr 3 a)
		(vp-load-rrd f a :d1)
		(vp-mul-dd :d1 :d0)
		(vp-load-rrr rev a b)
		(vp-shl-cr 4 b)
		(vp-store-drr :d0 x b)
		(vp-add-cr 8 b)
		(vp-xor-rr a a)
		(vp-cvt-rd a :d1)
		(vp-store-drr :d1 x b)
		(vp-add-cr 4 src)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,n))

	;the FFT, in place, stages of 2, 4 ... n, a twiddle every so many of
	;the table: c is the length of a stage, d half of it in bytes, e the
	;step through the table in bytes
	(vp-cpy-cr 2 c)
	(vp-cpy-rr n e)
	(vp-shl-cr 3 e)
	(loop-start)
		(vp-cpy-rr c d)
		(vp-shl-cr 3 d)
		;each group, from a, its first in bytes
		(vp-xor-rr a a)
		(loop-start)
			;each pair of the group, b from 0 to half, f through the table
			(vp-xor-rr b b)
			(vp-xor-rr f f)
			(loop-start)
				;i at a + b, j half after it, in bytes of complexes
				(vp-cpy-rr a j)
				(vp-add-rr b j)
				(vp-add-rr x j)
				;the twiddle
				(vp-load-rrd tw f :d2)
				(vp-add-cr 8 f)
				(vp-load-rrd tw f :d3)
				(vp-sub-cr 8 f)
				;x[j] by it, j at g
				(vp-cpy-rr j g)
				(vp-add-rr d g)
				(vp-load-rcd g 0 :d0)
				(vp-load-rcd g 8 :d1)
				(vp-cpy-dd :d0 :d4)
				(vp-mul-dd :d2 :d4)
				(vp-cpy-dd :d1 :d5)
				(vp-mul-dd :d3 :d5)
				(vp-sub-dd :d5 :d4)
				(vp-mul-dd :d3 :d0)
				(vp-mul-dd :d2 :d1)
				(vp-add-dd :d1 :d0)
				;x[j] = x[i] - t, x[i] = x[i] + t
				(vp-load-rcd j 0 :d6)
				(vp-load-rcd j 8 :d7)
				(vp-cpy-dd :d6 :d8)
				(vp-sub-dd :d4 :d8)
				(vp-cpy-dd :d7 :d9)
				(vp-sub-dd :d0 :d9)
				(vp-add-dd :d4 :d6)
				(vp-add-dd :d0 :d7)
				(vp-store-drc :d6 j 0)
				(vp-store-drc :d7 j 8)
				(vp-store-drc :d8 g 0)
				(vp-store-drc :d9 g 8)
				(vp-add-cr 16 b)
				(vp-add-rr e f)
			(loop-until `(,b = ,d))
			(vp-add-rr d a)
			(vp-add-rr d a)
			(vp-cpy-rr n j)
			(vp-shl-cr 4 j)
		(loop-until `(,a = ,j))
		(vp-shr-cr 1 e)
		(vp-shl-cr 1 c)
	(loop-until `(,c > ,n))

	;the power of each of the first half
	(vp-cpy-rr n b)
	(vp-shr-cr 1 b)
	(vp-xor-rr j j)
	(loop-start)
		(vp-cpy-rr j a)
		(vp-shl-cr 4 a)
		(vp-load-rrd x a :d0)
		(vp-add-cr 8 a)
		(vp-load-rrd x a :d1)
		(vp-mul-dd :d0 :d0)
		(vp-mul-dd :d1 :d1)
		(vp-add-dd :d1 :d0)
		(vp-cpy-rr j a)
		(vp-shl-cr 3 a)
		(vp-store-drr :d0 pw a)
		(vp-add-cr 1 j)
	(loop-until `(,j = ,b))

	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(media-spectrum pcm from x tw rev win pow)" +error_msg_wrong_types))
	(signature '(:str :num :DOUBLES :DOUBLES :nums :DOUBLES :DOUBLES))

(def-func-end)
