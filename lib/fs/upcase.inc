;this many characters that are their own upper case, or more, are kept
;as 0xffff and a count, the table every other system writes does so too
(defq +exfat_upcase_gap 400)

(defun exfat-upcase-table ()
	; (exfat-upcase-table) -> str
	(defq pairs (list) out (list) at 0)
	(each (lambda ((start end step add))
			(each (# (push pairs (list %0 (+ %0 add)))) (range start (inc end) step)))
		(partition +exfat_upcase_runs 4))
	(each (lambda ((c upper))
			(defq gap (- c at))
			(if (>= gap +exfat_upcase_gap)
				(push out (char 0xffff 2) (char gap 2))
				(each (# (push out (char %0 2))) (range at c)))
			(when (< c 0x10000)
				(push out (char upper 2))
				(setq at (inc c))))
		(sort (push pairs (list 0x10000 0)) (# (- (first %0) (first %1)))))
	(apply (const cat) out))
