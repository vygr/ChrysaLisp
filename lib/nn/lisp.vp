(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/doubles/class.inc")
(include "class/double/class.inc")

(def-func (path-to-absolute "./scale_bytes"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d1
	;info
	;(nn-scale-bytes bytes scale out) -> out, each byte of a str, 0 to
	;255, times the double scale into the doubles of out, as many as both
	;have, a picture's grey levels as the inputs of a network

	(vp-rdef (this args bytes scale out end dst) '(:r0 :r1 :r2 :r3 :r4 :r5 :r6))

	(entry `(,this ,args))

	(gotoif-lisp-args-sig 'error args 3)

	(list-bind-args args `(,bytes ,scale ,out) '(:obj :obj :obj))
	(assign `((,scale +num_value) (,bytes +str_length) (,out +array_length)) `(:d0 ,end ,dst))
	(vpif `(,dst < ,end))
		(vp-cpy-rr dst end)
	(endif)
	(vp-add-cr +str_data bytes)
	(vp-add-rr bytes end)
	(assign `((,out +array_begin)) `(,dst))
	(vpif `(,bytes /= ,end))
		(loop-start)
			(vp-load-rcr-ub bytes 0 args)
			(vp-cvt-rd args :d1)
			(vp-mul-dd :d0 :d1)
			(vp-store-drc :d1 dst 0)
			(vp-add-cr +byte_size bytes)
			(vp-add-cr +long_size dst)
		(loop-until `(,bytes = ,end))
	(endif)
	(class/obj/ref out args)

	(exit `(,this ,out))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(nn-scale-bytes bytes scale out)" +error_msg_wrong_types))
	(signature '(:str :double :doubles))

(def-func-end)
