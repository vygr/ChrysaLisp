(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "class/sstream/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./parse"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(int c q)
		(ptr state)
	(offset res_start)
		(ptr states tokens) ;must be first 2 resources !
	(offset syms_start)
		(ptr sym_text sym_open sym_close sym_assign sym_string sym_symbol)
	(offset syms_end)
		(ptr not_symbol_chars open_chars close_chars sstoken)
	(offset res_end)
		(ptr stream resources this args))

	(defun write-token ()
		(call :sstream :write_char (vpx sstoken c)))

	(defun output-c ()
		(call :str :create_from_buffer (vpx (& c) 1) '(token))
		(bind '(l t) (method-input :list :push_back))
		(assign `(,token) `(,t))
		(assign (vpx tokens) `(,l))
		(call :list :push_back `(,l ,t)))

	(defun output-token ()
		(call :sstream :claim_string (vpx sstoken) '(_ token))
		(bind '(l t) (method-input :list :push_back))
		(assign `(,token) `(,t))
		(assign (vpx tokens) `(,l))
		(call :list :push_back `(,l ,t)))

	(defun output-state (&optional s)
		(if s
			(call :list :push_back (vpx states ,(second s)) '(_ obj tmp _))
			(call :list :push_back (vpx states state) '(_ obj tmp _)))
		(class/obj/ref obj tmp))

	(defun find_char_in (s)
		(bind '(st ch &) (method-input :str :find))
		(assign `(,c) `(,ch))
		(assign s `(,st))
		(d-call :str :find `(,st ,ch 0) '(_ _ idx)))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(push-scope)
	(assign '(:r0 :r1) (vpx this args))

	(list-bind-args :r1 '(:r0) '(:stream))
	(assign '(:r0) (vpx stream))

	(call :str :create_from_buffer (vpx 0 str_gap) '(:r0))
	(call :sstream :create '(:r0) (vpx sstoken))
	(call :list :create :nil (vpx states))
	(call :list :create :nil (vpx tokens))
	(call :str :create_from_buffer '("\q=<>" 4) (vpx not_symbol_chars))
	(call :str :create_from_buffer (vpx "</!-?" 5) (vpx open_chars))
	(call :str :create_from_buffer (vpx ">/-?" 4) (vpx close_chars))

	;create state symbols
	(vp-rdef (table iter_begin iter_end) '(:r12 :r13 :r14))
	(assign (vpx ($ states) (& syms_start) (& syms_end)) `(,table ,iter_begin ,iter_end))
	(loop-start)
		(call :sym :intern_cstr `(,table) `((,iter_begin 0)))
		(call :sys_str :length `(,table) '(_ len))
		(vp-add-cr +ptr_size iter_begin)
		(vp-add-rr len table)
		(vp-add-cr 1 table)
	(loop-until `(,iter_begin = ,iter_end))

	;create resource tracker list
	(vp-rdef (res iter_begin iter_end) '(:r0 :r12 :r13))
	(call :list :create :nil (vpx resources))
	(assign (vpx resources (& res_start) (& res_end)) `(,res ,iter_begin ,iter_end))
	(loop-start)
		(call :list :push_back `(,res (,iter_begin 0)) '(res _ _ _))
		(vp-add-cr +ptr_size iter_begin)
	(loop-until `(,iter_begin = ,iter_end))

	(assign (vpx sym_text) (vpx state))
	(loop-start 'next_char)
		(call :stream :read_char (vpx stream) '(_ c))
		(breakif `(,c = -1))
		(assign `(,c) (vpx c))
	(vp-label 'proc_char)
		(switch)
		(vp-rdef (state sym c q) '(:r0 :r2 :r1 :r3))
		(assign (vpx state sym_text c) `(,state ,sym ,c))
		(vpcase `(,state = ,sym))
			(switch)
			(continueif `(,c <= +char_space) 'next_char)
			(vpcase `(,c = +char_lt))
				(assign (vpx sym_open) (vpx state))
				(goto 'write_token_then_next)
			(default)
				(find_char_in (vpx close_chars))
				(nextcaseif `(,idx = -1))
				(assign (vpx sym_close) (vpx state))
				(goto 'write_token_then_next)
			(vpcase `(,c = +char_equal))
				(output-c)
				(output-state (vpx sym_assign))
				(continue 'next_char)
			(vpcase `(,c = +char_double_quote))
			(vp-label 'quoted)
				(assign `(,c) (vpx q))
				(assign (vpx sym_string) (vpx state))
				(continue 'next_char)
			(vpcase `(,c = +char_quote))
				(goto 'quoted)
			(default)
				(assign (vpx sym_symbol) (vpx state))
				(goto 'write_token_then_next)
			(endswitch)
		(default)
			(assign (vpx sym_open) `(,sym))
			(nextcaseif `(,state /= ,sym))
			(find_char_in (vpx open_chars))
			(gotoif `(,idx /= -1) 'write_token_then_next)
			(goto 'output_then_proc)
		(default)
			(assign (vpx sym_close) `(,sym))
			(nextcaseif `(,state /= ,sym))
			(find_char_in (vpx close_chars))
			(gotoif `(,idx /= -1) 'write_token_then_next)
			(goto 'output_then_proc)
		(default)
			(assign (vpx sym_symbol) `(,sym))
			(nextcaseif `(,state /= ,sym))
			(gotoif `(,c <= +char_space) 'output_then_proc)
			(find_char_in (vpx not_symbol_chars))
			(gotoif `(,idx = -1) 'write_token_then_next)
		(vp-label 'output_then_proc)
			(output-token)
			(output-state)
			(assign (vpx sym_text) (vpx state))
			(goto 'proc_char)
		(default)
			(assign (vpx q) `(,q))
			(gotoif `(,c /= ,q) 'write_token_then_next)
		(vp-label 'output_then_next)
			(output-token)
			(output-state)
			(assign (vpx sym_text) (vpx state))
			(continue 'next_char)
		(vp-label 'write_token_then_next)
			(write-token)
		(endswitch)
	(loop-end)

	(d-call :list :slice (vpx resources 0 2) (vpx args))
	(call :list :deref (vpx resources))
	(exit (vpx this args))
	(pop-scope)
	(return)

(vp-label 'states)
	(vp-cstr ":text")
	(vp-cstr ":open")
	(vp-cstr ":close")
	(vp-cstr ":assign")
	(vp-cstr ":string")
	(vp-cstr ":symbol")

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(xml-parse stream)" +error_msg_wrong_types))
	(signature '(:stream)))

(def-func-end)
