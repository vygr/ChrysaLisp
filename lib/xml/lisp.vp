(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "class/sstream/class.inc")
(include "class/lisp/class.inc")

;The XML of a stream as kinds and tokens, two lists side by side, in one
;pass over its bytes that knows where in the document it is. Of an element,
;:in and its name, a :key and a :val for each attribute, either quote,
;then :open for > or :empty for />; :out and its name for </name>; :text
;for a run of text that is not all white space, as it is, and CDATA as
;text whatever it is. Comments, <? ?> and <! > with its [ ] are passed
;over. Entities are left as they are, lib/xml/parse.inc makes them what
;they stand for. What is not well formed is taken as near as it can be: an
;attribute with no value has "", one not quoted runs to a space, / or >.

;where in the document it is
(enums +xml 0
	(enum text lt name attrs slash key eq valq val bare endname
		bang bang_dash comment cdata_open cdata pi doctype))

(def-func (path-to-absolute "./parse"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(xml-parse stream) -> (kinds tokens)

	(structure slot 0
		(long c state q n ns)
		(offset res_start)
		(ptr kinds tokens)
		(offset syms_start)
		(ptr sym_in sym_key sym_val sym_open sym_empty sym_out sym_text)
		(offset syms_end)
		(ptr sstoken)
		(offset res_end)
		(ptr stream resources this args))

	(defun xml-state (s)
		(vp-cpy-cr s :r0)
		(assign '(:r0) '((:rsp slot_state))))

	(defun xml-n (v)
		(vp-cpy-cr v :r0)
		(assign '(:r0) '((:rsp slot_n))))

	(defun xml-write ()
		(call :sstream :write_char '((:rsp slot_sstoken) (:rsp slot_c))))

	(defun xml-write-const (ch)
		(call :sstream :write_char `((:rsp slot_sstoken) ,ch)))

	(defun xml-emit (kind)
		;what is in the token so far, of this kind, and the token begun again
		(call :sstream :claim_string '((:rsp slot_sstoken)) '(& :r1))
		(call :list :push_back '((:rsp slot_tokens) :r1))
		(call :list :push_back `((:rsp slot_kinds) (:rsp ,kind)) '(& :r0 :r1 &))
		(class/obj/ref :r0 :r1))

	(defun xml-flush ()
		;a run of text, if it is not all white space
		(assign '((:rsp slot_ns)) '(:r0))
		(vpif '(:r0 /= 0))
			(xml-emit 'slot_sym_text)
		(else)
			(call :sstream :claim_string '((:rsp slot_sstoken)) '(& :r0))
			(call :obj :deref '(:r0))
		(endif)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp slot_ns))))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))

	(list-bind-args :r1 '(:r0) '(:stream))
	(assign '(:r0) '((:rsp slot_stream)))

	(call :str :create_from_buffer `(0 ,str_gap) '(:r0))
	(call :sstream :create '(:r0) '((:rsp slot_sstoken)))
	(call :list :create :nil '((:rsp slot_kinds)))
	(call :list :create :nil '((:rsp slot_tokens)))

	;the kinds, symbols
	(vp-rdef (table iter_begin iter_end) '(:r12 :r13 :r14))
	(assign '(($ kinds) (& :rsp slot_syms_start) (& :rsp slot_syms_end)) `(,table ,iter_begin ,iter_end))
	(loop-start)
		(call :sym :intern_cstr `(,table) `((,iter_begin 0)))
		(call :sys_str :length `(,table) '(& len))
		(vp-add-cr +ptr_size iter_begin)
		(vp-add-rr len table)
		(vp-add-cr 1 table)
	(loop-until `(,iter_begin = ,iter_end))

	;all that is let go of at the end
	(vp-rdef (res iter_begin iter_end) '(:r0 :r12 :r13))
	(call :list :create :nil '((:rsp slot_resources)))
	(assign '((:rsp slot_resources) (& :rsp slot_res_start) (& :rsp slot_res_end)) `(,res ,iter_begin ,iter_end))
	(loop-start)
		(call :list :push_back `(,res (,iter_begin 0)) '(res & & &))
		(vp-add-cr +ptr_size iter_begin)
	(loop-until `(,iter_begin = ,iter_end))

	(vp-xor-rr :r0 :r0)
	(assign '(:r0 :r0 :r0 :r0) '((:rsp slot_state) (:rsp slot_n) (:rsp slot_ns) (:rsp slot_q)))
	(loop-start 'next_char)
		(call :stream :read_char '((:rsp slot_stream)) '(& :r1))
		(breakif '(:r1 = -1))
		(assign '(:r1) '((:rsp slot_c)))
	(vp-label 'proc_char)
		(assign '((:rsp slot_state) (:rsp slot_c)) '(:r0 :r1))
		(switch)
		(vpcase `(:r0 = ,+xml_text))
			(vpif `(:r1 = ,+char_lt))
				(xml-flush)
				(xml-state +xml_lt)
			(else)
				(vpif `(:r1 > ,+char_space))
					(vp-cpy-cr 1 :r0)
					(assign '(:r0) '((:rsp slot_ns)))
				(endif)
				(xml-write)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_lt))
			(vpif `(:r1 = ,+char_divide))
				(xml-state +xml_endname)
			(elseif '(:r1 = 33))
				(xml-state +xml_bang)
			(elseif `(:r1 = ,+char_question))
				(xml-n 0)
				(xml-state +xml_pi)
			(else)
				(xml-write)
				(xml-state +xml_name)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_name))
			(gotoif `(:r1 <= ,+char_space) 'name_end)
			(gotoif `(:r1 = ,+char_divide) 'name_end)
			(gotoif `(:r1 = ,+char_gt) 'name_end)
			(xml-write)
			(continue 'next_char)
		(vp-label 'name_end)
			(xml-emit 'slot_sym_in)
			(xml-state +xml_attrs)
			(goto 'proc_char)
		(vpcase `(:r0 = ,+xml_attrs))
			(continueif `(:r1 <= ,+char_space) 'next_char)
			(vpif `(:r1 = ,+char_gt))
				(xml-emit 'slot_sym_open)
				(xml-state +xml_text)
			(elseif `(:r1 = ,+char_divide))
				(xml-state +xml_slash)
			(else)
				(xml-write)
				(xml-state +xml_key)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_slash))
			(vpif `(:r1 = ,+char_gt))
				(xml-emit 'slot_sym_empty)
				(xml-state +xml_text)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_key))
			(gotoif `(:r1 <= ,+char_space) 'key_end)
			(gotoif `(:r1 = ,+char_equal) 'key_end)
			(gotoif `(:r1 = ,+char_divide) 'key_end)
			(gotoif `(:r1 = ,+char_gt) 'key_end)
			(xml-write)
			(continue 'next_char)
		(vp-label 'key_end)
			(xml-emit 'slot_sym_key)
			(xml-state +xml_eq)
			(goto 'proc_char)
		(vpcase `(:r0 = ,+xml_eq))
			(continueif `(:r1 <= ,+char_space) 'next_char)
			(vpif `(:r1 = ,+char_equal))
				(xml-state +xml_valq)
				(continue 'next_char)
			(endif)
			;a key with no value has ""
			(xml-emit 'slot_sym_val)
			(xml-state +xml_attrs)
			(goto 'proc_char)
		(vpcase `(:r0 = ,+xml_valq))
			(continueif `(:r1 <= ,+char_space) 'next_char)
			(gotoif `(:r1 = ,+char_double_quote) 'quoted)
			(gotoif `(:r1 = ,+char_quote) 'quoted)
			(xml-write)
			(xml-state +xml_bare)
			(continue 'next_char)
		(vp-label 'quoted)
			(assign '(:r1) '((:rsp slot_q)))
			(xml-state +xml_val)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_val))
			(assign '((:rsp slot_q)) '(:r2))
			(vpif '(:r1 = :r2))
				(xml-emit 'slot_sym_val)
				(xml-state +xml_attrs)
			(else)
				(xml-write)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_bare))
			(gotoif `(:r1 <= ,+char_space) 'bare_end)
			(gotoif `(:r1 = ,+char_divide) 'bare_end)
			(gotoif `(:r1 = ,+char_gt) 'bare_end)
			(xml-write)
			(continue 'next_char)
		(vp-label 'bare_end)
			(xml-emit 'slot_sym_val)
			(xml-state +xml_attrs)
			(goto 'proc_char)
		(vpcase `(:r0 = ,+xml_endname))
			(vpif `(:r1 = ,+char_gt))
				(xml-emit 'slot_sym_out)
				(xml-state +xml_text)
			(elseif `(:r1 > ,+char_space))
				(xml-write)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_bang))
			(vpif `(:r1 = ,+char_minus))
				(xml-state +xml_bang_dash)
			(elseif `(:r1 = ,+char_lsb))
				(xml-state +xml_cdata_open)
			(else)
				(xml-n 0)
				(vp-xor-rr :r0 :r0)
				(assign '(:r0) '((:rsp slot_q)))
				(xml-state +xml_doctype)
				(goto 'proc_char)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_bang_dash))
			(xml-n 0)
			(xml-state +xml_comment)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_comment))
			;to the > after two - or more
			(assign '((:rsp slot_n)) '(:r2))
			(vpif `(:r1 = ,+char_minus))
				(vp-add-cr 1 :r2)
			(elseif `(:r1 = ,+char_gt) '(:r2 >= 2))
				(xml-state +xml_text)
			(else)
				(vp-xor-rr :r2 :r2)
			(endif)
			(assign '(:r2) '((:rsp slot_n)))
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_cdata_open))
			;<![CDATA[ to its [
			(vpif `(:r1 = ,+char_lsb))
				(xml-n 0)
				(xml-state +xml_cdata)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_cdata))
			;to ]]>, each ] held back in n till it is known it is not of it
			(assign '((:rsp slot_n)) '(:r2))
			(vpif `(:r1 = ,+char_rsb))
				(vpif '(:r2 = 2))
					(xml-write-const +char_rsb)
				(else)
					(vp-add-cr 1 :r2)
					(assign '(:r2) '((:rsp slot_n)))
				(endif)
			(elseif `(:r1 = ,+char_gt) '(:r2 = 2))
				(vp-cpy-cr 1 :r0)
				(assign '(:r0) '((:rsp slot_ns)))
				(xml-flush)
				(xml-state +xml_text)
			(else)
				(loop-while '(:r2 /= 0))
					(vp-sub-cr 1 :r2)
					(assign '(:r2) '((:rsp slot_n)))
					(xml-write-const +char_rsb)
					(assign '((:rsp slot_n)) '(:r2))
				(loop-end)
				(xml-write)
			(endif)
			(continue 'next_char)
		(vpcase `(:r0 = ,+xml_pi))
			;to ?>
			(assign '((:rsp slot_n)) '(:r2))
			(vpif `(:r1 = ,+char_gt) '(:r2 = 1))
				(xml-state +xml_text)
			(elseif `(:r1 = ,+char_question))
				(xml-n 1)
			(else)
				(xml-n 0)
			(endif)
			(continue 'next_char)
		(default)
			;<! >, its [ ] counted, what is quoted passed over
			(assign '((:rsp slot_q) (:rsp slot_n)) '(:r2 :r3))
			(vpif '(:r2 /= 0))
				(vpif '(:r1 = :r2))
					(vp-xor-rr :r2 :r2)
				(endif)
			(elseif `(:r1 = ,+char_double_quote))
				(vp-cpy-rr :r1 :r2)
			(elseif `(:r1 = ,+char_quote))
				(vp-cpy-rr :r1 :r2)
			(elseif `(:r1 = ,+char_lsb))
				(vp-add-cr 1 :r3)
			(elseif `(:r1 = ,+char_rsb))
				(vp-sub-cr 1 :r3)
			(elseif `(:r1 = ,+char_gt) '(:r3 <= 0))
				(xml-state +xml_text)
			(endif)
			(assign '(:r2 :r3) '((:rsp slot_q) (:rsp slot_n)))
		(endswitch)
	(loop-end)

	;text to the end
	(assign '((:rsp slot_state)) '(:r0))
	(vpif `(:r0 = ,+xml_text))
		(xml-flush)
	(endif)

	(d-call :list :slice '((:rsp slot_resources) 0 2) '((:rsp slot_args)))
	(call :list :deref '((:rsp slot_resources)))
	(exit '((:rsp slot_this) (:rsp slot_args)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(xml-parse stream)" +error_msg_wrong_types))
	(signature '(:stream))

	;the names of the kinds, after all the code
(vp-label 'kinds)
	(vp-cstr ":in")
	(vp-cstr ":key")
	(vp-cstr ":val")
	(vp-cstr ":open")
	(vp-cstr ":empty")
	(vp-cstr ":out")
	(vp-cstr ":text")

(def-func-end)
