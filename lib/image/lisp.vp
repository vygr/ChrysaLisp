(include "lib/asm/func.inc")
(include "class/stream/class.inc")
(include "class/nums/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./png_unfilter"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6
	;info
	;(png-unfilter-row row prev kind step) -> row, the filter of a row of
	;a PNG undone in place: 1 by the byte step to the left, 2 by the one
	;above in prev, 3 by half of both, 4 by Paeth's guess of the three.
	;prev is as long as row, of 0 for the first row

	(structure slot 0
		(ptr this args)
		(long r7 r8 r9 r10 r11 r12 r13 r14))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 4)

	;:r7 to :r14 kept in the frame, the row is worked in registers: :r1 its
	;bytes, :r2 those of prev, :r3 its length, :r4 step, :r5 i
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3) '(:obj :obj :num :num))
	(assign '(:r3 :r2 (:r0 +str_length)) '(:r4 :r6 :r3))
	(vp-lea-rcr :r1 +str_data :r2)
	(vp-lea-rcr :r0 +str_data :r1)
	(vp-xor-rr :r5 :r5)

	(vpif '(:r6 = 1))
		;by the byte step to the left, from step on, :r7 the row step back
		(vp-cpy-rr :r4 :r5)
		(vpif '(:r5 < :r3))
			(vp-cpy-rr :r1 :r7)
			(vp-sub-rr :r4 :r7)
			(loop-start)
				(vp-load-rrr-ub :r1 :r5 :r6)
				(vp-load-rrr-ub :r7 :r5 :r8)
				(vp-add-rr :r8 :r6)
				(vp-store-rrr-b :r6 :r1 :r5)
				(vp-add-cr 1 :r5)
			(loop-until '(:r5 = :r3))
		(endif)
	(elseif '(:r6 = 2))
		;by the one above
		(vpif '(:r5 < :r3))
			(loop-start)
				(vp-load-rrr-ub :r1 :r5 :r6)
				(vp-load-rrr-ub :r2 :r5 :r8)
				(vp-add-rr :r8 :r6)
				(vp-store-rrr-b :r6 :r1 :r5)
				(vp-add-cr 1 :r5)
			(loop-until '(:r5 = :r3))
		(endif)
	(elseif '(:r6 = 3))
		;by half of both, the one to the left 0 before step
		(vpif '(:r5 < :r3))
			(vp-cpy-rr :r1 :r7)
			(vp-sub-rr :r4 :r7)
			(loop-start)
				(vp-xor-rr :r8 :r8)
				(vpif '(:r5 >= :r4))
					(vp-load-rrr-ub :r7 :r5 :r8)
				(endif)
				(vp-load-rrr-ub :r2 :r5 :r9)
				(vp-add-rr :r9 :r8)
				(vp-shr-cr 1 :r8)
				(vp-load-rrr-ub :r1 :r5 :r6)
				(vp-add-rr :r8 :r6)
				(vp-store-rrr-b :r6 :r1 :r5)
				(vp-add-cr 1 :r5)
			(loop-until '(:r5 = :r3))
		(endif)
	(elseif '(:r6 = 4))
		;Paeth: of a, b and c the nearest to a + b - c, each how far it is,
		;|b - c| |a - c| |a + b - 2c|. a :r8, b :r11, c :r9, of the row and
		;prev step back :r7 and :r10, the distances :r12 :r13 :r14
		(vpif '(:r5 < :r3))
			(vp-cpy-rr :r1 :r7)
			(vp-sub-rr :r4 :r7)
			(vp-cpy-rr :r2 :r10)
			(vp-sub-rr :r4 :r10)
			(loop-start)
				(vp-xor-rr :r8 :r8)
				(vp-xor-rr :r9 :r9)
				(vpif '(:r5 >= :r4))
					(vp-load-rrr-ub :r7 :r5 :r8)
					(vp-load-rrr-ub :r10 :r5 :r9)
				(endif)
				(vp-load-rrr-ub :r2 :r5 :r11)
				(vp-cpy-rr :r11 :r12)
				(vp-sub-rr :r9 :r12)
				(vp-abs-rr :r12 :r12)
				(vp-cpy-rr :r8 :r13)
				(vp-sub-rr :r9 :r13)
				(vp-abs-rr :r13 :r13)
				(vp-lea-rrr :r8 :r11 :r14)
				(vp-sub-rr :r9 :r14)
				(vp-sub-rr :r9 :r14)
				(vp-abs-rr :r14 :r14)
				(vp-cpy-rr :r9 :r6)
				(vpif '(:r13 <= :r14))
					(vp-cpy-rr :r11 :r6)
				(endif)
				(vpif '(:r12 <= :r13) '(:r12 <= :r14))
					(vp-cpy-rr :r8 :r6)
				(endif)
				(vp-load-rrr-ub :r1 :r5 :r8)
				(vp-add-rr :r6 :r8)
				(vp-store-rrr-b :r8 :r1 :r5)
				(vp-add-cr 1 :r5)
			(loop-until '(:r5 = :r3))
		(endif)
	(endif)

	(assign '((:rsp slot_args)) '(:r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(assign '((:r1 0)) '(:r1))
	(class/obj/ref :r1 :r2)
	(load-fields :rsp '(slot_this slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(png-unfilter-row row prev kind step)" +error_msg_wrong_types))
	(signature '(:str :str :NUM :NUM))

(def-func-end)

(def-func (path-to-absolute "./png_pixels"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d15
	;info
	;(png-pixels row colour depth width palette clear) -> str, a row of
	;a PNG of 8 or 16 bits a sample, its filter undone, as pixels of 32
	;bits, blue green red alpha, the high byte of a sample of 16. Of a
	;palette, an index past its end is black, past the end of clear opaque

	(structure slot 0
		(ptr this args out)
		(long r7 r8 r9 r10 r11 r12 r13 r14))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 6)

	;:r7 to :r14 kept in the frame, the row made in registers
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5) '(:obj :num :num :num :obj :obj))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5) '(:r12 :r13 :r9 :r10 :r11 :r14))
	(vp-cpy-rr :r10 :r1)
	(vp-shl-cr 2 :r1)
	(call :str :create_from_buffer '(0 :r1) '(:r0))
	(assign '(:r0) '((:rsp slot_out)))

	;:r1 the pixel, :r2 the sample, :r3 the pixels left, :r5 :r6 the
	;palette and its length, :r7 :r8 the clear and its length, :r9 to :r12
	;a sample's size, w, by 1 to 4, :r13 the colour
	(vp-lea-rcr :r0 +str_data :r1)
	(vp-cpy-rr :r10 :r3)
	(vp-shr-cr 3 :r9)
	(assign '((:r11 +str_length) (:r14 +str_length)) '(:r6 :r8))
	(vp-lea-rcr :r11 +str_data :r5)
	(vp-lea-rcr :r14 +str_data :r7)
	(vp-lea-rcr :r12 +str_data :r2)
	(vp-lea-rrr :r9 :r9 :r10)
	(vp-lea-rrr :r10 :r9 :r11)
	(vp-lea-rrr :r10 :r10 :r12)
	(vp-cpy-cr 255 :r14)
	(vpif '(:r3 /= 0))
		(vpif '(:r13 = 0))
			;grey
			(loop-start)
				(vp-load-rcr-ub :r2 0 :r0)
				(vp-store-rrc-b :r0 :r1 0)
				(vp-store-rrc-b :r0 :r1 1)
				(vp-store-rrc-b :r0 :r1 2)
				(vp-store-rrc-b :r14 :r1 3)
				(vp-add-rr :r9 :r2)
				(vp-add-cr 4 :r1)
				(vp-sub-cr 1 :r3)
			(loop-until '(:r3 = 0))
		(elseif '(:r13 = 2))
			;red green blue
			(loop-start)
				(vp-load-rrr-ub :r2 :r10 :r0)
				(vp-store-rrc-b :r0 :r1 0)
				(vp-load-rrr-ub :r2 :r9 :r0)
				(vp-store-rrc-b :r0 :r1 1)
				(vp-load-rcr-ub :r2 0 :r0)
				(vp-store-rrc-b :r0 :r1 2)
				(vp-store-rrc-b :r14 :r1 3)
				(vp-add-rr :r11 :r2)
				(vp-add-cr 4 :r1)
				(vp-sub-cr 1 :r3)
			(loop-until '(:r3 = 0))
		(elseif '(:r13 = 3))
			;of a palette, an index past its end black, past the end of clear opaque
			(loop-start)
				(vp-load-rcr-ub :r2 0 :r0)
				(vp-cpy-cr 255 :r4)
				(vpif '(:r0 < :r8))
					(vp-load-rrr-ub :r7 :r0 :r4)
				(endif)
				(vp-cpy-rr :r0 :r14)
				(vp-shl-cr 1 :r14)
				(vp-add-rr :r0 :r14)
				(vp-lea-rcr :r14 2 :r0)
				(vpif '(:r0 < :r6))
					(vp-add-rr :r5 :r14)
					(vp-load-rcr-ub :r14 2 :r0)
					(vp-store-rrc-b :r0 :r1 0)
					(vp-load-rcr-ub :r14 1 :r0)
					(vp-store-rrc-b :r0 :r1 1)
					(vp-load-rcr-ub :r14 0 :r0)
					(vp-store-rrc-b :r0 :r1 2)
				(else)
					(vp-xor-rr :r0 :r0)
					(vp-store-rrc-b :r0 :r1 0)
					(vp-store-rrc-b :r0 :r1 1)
					(vp-store-rrc-b :r0 :r1 2)
				(endif)
				(vp-store-rrc-b :r4 :r1 3)
				(vp-add-cr 1 :r2)
				(vp-add-cr 4 :r1)
				(vp-sub-cr 1 :r3)
			(loop-until '(:r3 = 0))
		(elseif '(:r13 = 4))
			;grey and alpha
			(loop-start)
				(vp-load-rcr-ub :r2 0 :r0)
				(vp-store-rrc-b :r0 :r1 0)
				(vp-store-rrc-b :r0 :r1 1)
				(vp-store-rrc-b :r0 :r1 2)
				(vp-load-rrr-ub :r2 :r9 :r0)
				(vp-store-rrc-b :r0 :r1 3)
				(vp-add-rr :r10 :r2)
				(vp-add-cr 4 :r1)
				(vp-sub-cr 1 :r3)
			(loop-until '(:r3 = 0))
		(else)
			;red green blue alpha
			(loop-start)
				(vp-load-rrr-ub :r2 :r10 :r0)
				(vp-store-rrc-b :r0 :r1 0)
				(vp-load-rrr-ub :r2 :r9 :r0)
				(vp-store-rrc-b :r0 :r1 1)
				(vp-load-rcr-ub :r2 0 :r0)
				(vp-store-rrc-b :r0 :r1 2)
				(vp-load-rrr-ub :r2 :r11 :r0)
				(vp-store-rrc-b :r0 :r1 3)
				(vp-add-rr :r12 :r2)
				(vp-add-cr 4 :r1)
				(vp-sub-cr 1 :r3)
			(loop-until '(:r3 = 0))
		(endif)
	(endif)

	(load-fields :rsp '(slot_this slot_out slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(png-pixels row colour depth width palette clear)" +error_msg_wrong_types))
	(signature '(:str :NUM :NUM :NUM :str :str))

(def-func-end)

(def-func (path-to-absolute "./jpg_idct"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6
	;info
	;(jpg-idct-put c t k plane at pw) -> plane, the 64 numbers of a block,
	;by their table, in rows, turned back to pixels and written to the
	;plane, 8 rows of 8 bytes from at, pw apart. k is K x u by 1024 in
	;rows of x, t a nums of 64 for the rows by K: t x v is row v of c dot
	;K x, and pixel y x is 128 and K y dot t x, by 2^20

	(structure slot 0
		(ptr this args)
		(long r7 r8 r9 r10 r11 r12 r13 r14))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 6)

	;:r7 to :r14 kept in the frame, the block is worked in registers
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5) '(:obj :obj :obj :obj :num :num))
	;:r0 c, :r1 t, :r2 k, :r13 the plane at at, :r14 pw
	(assign '((:r0 +array_begin) (:r1 +array_begin) (:r2 +array_begin)) '(:r0 :r1 :r2))
	(vp-add-cr +str_data :r3)
	(vp-add-rr :r4 :r3)
	(assign '(:r3 :r5) '(:r13 :r14))

	;t x v, for x the row of k :r10, for v the row of c :r5, into :r4
	(assign '(:r1 :r2) '(:r4 :r10))
	(vp-lea-rcr :r2 512 :r11)
	(vp-lea-rcr :r0 512 :r12)
	(loop-start)
		(vp-cpy-rr :r0 :r5)
		(loop-start)
			(vp-xor-rr :r7 :r7)
			(vp-xor-rr :r6 :r6)
			(loop-start)
				(vp-load-rrr :r5 :r6 :r8)
				(vp-load-rrr :r10 :r6 :r9)
				(vp-mul-rr :r9 :r8)
				(vp-add-rr :r8 :r7)
				(vp-add-cr +long_size :r6)
			(loop-until '(:r6 = 64))
			(vp-store-rrc :r7 :r4 0)
			(vp-add-cr +long_size :r4)
			(vp-add-cr 64 :r5)
		(loop-until '(:r5 = :r12))
		(vp-add-cr 64 :r10)
	(loop-until '(:r10 = :r11))

	;pixel y x, for y the row of k :r10, for x the row of t :r5, into :r3
	(vp-cpy-rr :r2 :r10)
	(vp-lea-rcr :r2 512 :r11)
	(vp-lea-rcr :r1 512 :r12)
	(loop-start)
		(assign '(:r1 :r13) '(:r5 :r3))
		(loop-start)
			(vp-xor-rr :r7 :r7)
			(vp-xor-rr :r6 :r6)
			(loop-start)
				(vp-load-rrr :r10 :r6 :r8)
				(vp-load-rrr :r5 :r6 :r9)
				(vp-mul-rr :r9 :r8)
				(vp-add-rr :r8 :r7)
				(vp-add-cr +long_size :r6)
			(loop-until '(:r6 = 64))
			(vp-add-cr 524288 :r7)
			(vp-asr-cr 20 :r7)
			(vp-add-cr 128 :r7)
			(vp-max-cr 0 :r7)
			(vp-min-cr 255 :r7)
			(vp-store-rrc-b :r7 :r3 0)
			(vp-add-cr 1 :r3)
			(vp-add-cr 64 :r5)
		(loop-until '(:r5 = :r12))
		(vp-add-rr :r14 :r13)
		(vp-add-cr 64 :r10)
	(loop-until '(:r10 = :r11))

	(assign '((:rsp slot_args)) '(:r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(assign `((:r1 ,(* 3 +ptr_size))) '(:r1))
	(class/obj/ref :r1 :r2)
	(load-fields :rsp '(slot_this slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(jpg-idct-put c t k plane at pw)" +error_msg_wrong_types))
	(signature '(:nums :nums :nums :str :NUM :NUM))

(def-func-end)

(def-func (path-to-absolute "./jpg_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d15
	;info
	;(jpg-line planes bases hs hmax width) -> str, a row of pixels of a
	;JPEG, blue green red alpha, from one plane, grey, or three, Y Cb Cr:
	;the sample of x of a plane is at its base and x by its h over hmax

	(structure slot 0
		(ptr this out planes bases hs)
		(uint hmax width)
		(align)
		(long r7 r8 r9 r10 r11 r12 r13 r14))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 5)

	;:r7 to :r14 kept in the frame, the row is made in registers
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4) '(:obj :obj :obj :num :num))
	(save-fields :rsp '(slot_planes slot_bases slot_hs slot_hmax slot_width) '(:r0 :r1 :r2 :r3 :r4))
	(vp-shl-cr 2 :r4)
	(call :str :create_from_buffer '(0 :r4) '(:r0))
	(assign '(:r0) '((:rsp slot_out)))

	;a plane's samples from its base, h of it to hmax: :r4 :r7, and of three
	;planes :r5 :r8, :r6 :r9
	(load-fields :rsp '(slot_planes slot_bases slot_hs slot_hmax slot_width) '(:r0 :r1 :r2 :r10 :r3))
	(assign '((:r0 +array_length) (:r0 +array_begin) (:r1 +array_begin) (:r2 +array_begin)) '(:r14 :r11 :r12 :r13))
	(assign '((:r11 0) (:r12 0) (:r13 0)) '(:r4 :r0 :r7))
	(vp-add-cr +str_data :r4)
	(vp-add-rr :r0 :r4)
	(assign '((:rsp slot_out)) '(:r1))
	(vp-add-cr +str_data :r1)
	(vp-xor-rr :r2 :r2)

	;:r1 the pixel, :r2 x of :r3, blue green red and alpha 255
	(vpif '(:r2 /= :r3))
		(vpif '(:r14 = 3))
			(assign '((:r11 +ptr_size) (:r12 +long_size) (:r13 +long_size)) '(:r5 :r0 :r8))
			(vp-add-cr +str_data :r5)
			(vp-add-rr :r0 :r5)
			(assign `((:r11 ,(* 2 +ptr_size)) (:r12 ,(* 2 +long_size)) (:r13 ,(* 2 +long_size))) '(:r6 :r0 :r9))
			(vp-add-cr +str_data :r6)
			(vp-add-rr :r0 :r6)
			(loop-start)
				(vp-cpy-rr :r2 :r11)
				(vp-mul-rr :r7 :r11)
				(vp-div-rr-u :r10 :r11)
				(vp-load-rrr-ub :r4 :r11 :r11)
				(vp-cpy-rr :r2 :r12)
				(vp-mul-rr :r8 :r12)
				(vp-div-rr-u :r10 :r12)
				(vp-load-rrr-ub :r5 :r12 :r12)
				(vp-cpy-rr :r2 :r13)
				(vp-mul-rr :r9 :r13)
				(vp-div-rr-u :r10 :r13)
				(vp-load-rrr-ub :r6 :r13 :r13)
				(vp-sub-cr 128 :r12)
				(vp-sub-cr 128 :r13)
				(vp-cpy-rr :r12 :r14)
				(vp-mul-cr 116130 :r14)
				(vp-asr-cr 16 :r14)
				(vp-add-rr :r11 :r14)
				(vp-max-cr 0 :r14)
				(vp-min-cr 255 :r14)
				(vp-store-rrc-b :r14 :r1 0)
				(vp-mul-cr 22554 :r12)
				(vp-cpy-rr :r13 :r0)
				(vp-mul-cr 46802 :r0)
				(vp-add-rr :r0 :r12)
				(vp-asr-cr 16 :r12)
				(vp-cpy-rr :r11 :r0)
				(vp-sub-rr :r12 :r0)
				(vp-max-cr 0 :r0)
				(vp-min-cr 255 :r0)
				(vp-store-rrc-b :r0 :r1 1)
				(vp-mul-cr 91881 :r13)
				(vp-asr-cr 16 :r13)
				(vp-add-rr :r11 :r13)
				(vp-max-cr 0 :r13)
				(vp-min-cr 255 :r13)
				(vp-store-rrc-b :r13 :r1 2)
				(vp-cpy-cr 255 :r0)
				(vp-store-rrc-b :r0 :r1 3)
				(vp-add-cr 4 :r1)
				(vp-add-cr 1 :r2)
			(loop-until '(:r2 = :r3))
		(else)
			(vp-cpy-cr 255 :r0)
			(loop-start)
				(vp-cpy-rr :r2 :r11)
				(vp-mul-rr :r7 :r11)
				(vp-div-rr-u :r10 :r11)
				(vp-load-rrr-ub :r4 :r11 :r11)
				(vp-store-rrc-b :r11 :r1 0)
				(vp-store-rrc-b :r11 :r1 1)
				(vp-store-rrc-b :r11 :r1 2)
				(vp-store-rrc-b :r0 :r1 3)
				(vp-add-cr 4 :r1)
				(vp-add-cr 1 :r2)
			(loop-until '(:r2 = :r3))
		(endif)
	(endif)

	(load-fields :rsp '(slot_this slot_out slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(jpg-line planes bases hs hmax width)" +error_msg_wrong_types))
	(signature '(:list :nums :nums :NUM :NUM))

(def-func-end)

(defun jpg-bit (dst)
	;the next bit of a scan into dst, the high bit of each byte first, the
	;scan's state in registers: :r11 the stream, :r12 the byte, :r13 the
	;bits left of it, :r14 the marker. A 0xFF is followed by a 0 that is
	;not data, anything else after it is a marker, kept, and from there on
	;there are only 0 bits. :r0-:r2 trashed by the read
	(vpif '(:r13 = 0))
		(vp-xor-rr :r12 :r12)
		(vpif '(:r14 = 0))
			(call :stream :read_char '(:r11) '(_ :r12))
			(vp-max-cr 0 :r12)
			(vpif '(:r12 = 0xff))
				(call :stream :read_char '(:r11) '(_ :r1))
				(vp-max-cr 0 :r1)
				(vpif '(:r1 /= 0))
					(vp-cpy-rr :r1 :r14)
					(vp-xor-rr :r12 :r12)
				(endif)
			(endif)
		(endif)
		(vp-cpy-cr 8 :r13)
	(endif)
	(vp-sub-cr 1 :r13)
	(vp-cpy-rr :r12 dst)
	(vp-shr-rr :r13 dst)
	(vp-and-cr 1 dst))

(defun jpg-bits (n dst)
	;n bits into dst, the first the high, :r9 and :r10 trashed
	(vp-xor-rr dst dst)
	(vp-cpy-rr n :r10)
	(vpif '(:r10 > 0))
		(loop-start)
			(jpg-bit :r9)
			(vp-shl-cr 1 dst)
			(vp-or-rr :r9 dst)
			(vp-sub-cr 1 :r10)
		(loop-until '(:r10 = 0))
	(endif))

(defun jpg-symbol (maxc valp minc vals dst)
	;the next value of a code into dst, as the standard's F.2.2.3, 0 if the
	;bits are no code. The code's tables are slots, :r3-:r7 and :r9 trashed
	(defq l (gensym))
	(jpg-bit :r3)
	(vp-xor-rr :r4 :r4)
	(vp-xor-rr dst dst)
	(loop-start l)
		(assign `((:rsp ,maxc)) '(:r6))
		(vp-cpy-rr :r4 :r5)
		(vp-shl-cr 3 :r5)
		(vp-load-rrr :r6 :r5 :r6)
		(vpif '(:r6 /= -1) '(:r3 <= :r6))
			(assign `((:rsp ,valp) (:rsp ,minc)) '(:r6 :r7))
			(vp-load-rrr :r6 :r5 :r6)
			(vp-load-rrr :r7 :r5 :r7)
			(vp-add-rr :r3 :r6)
			(vp-sub-rr :r7 :r6)
			(vp-shl-cr 3 :r6)
			(assign `((:rsp ,vals)) '(:r7))
			(vp-load-rrr :r7 :r6 dst)
			(break l)
		(endif)
		(jpg-bit :r9)
		(vp-shl-cr 1 :r3)
		(vp-or-rr :r9 :r3)
		(vp-add-cr 1 :r4)
	(loop-until '(:r4 = 16)))

(defun jpg-extend (v n)
	;v a number of n bits, as the standard has the negative ones, :r5 and
	;:r6 trashed
	(vpif `(,n > 0))
		(vp-cpy-rr n :r6)
		(vp-sub-cr 1 :r6)
		(vp-cpy-cr 1 :r5)
		(vp-shl-rr :r6 :r5)
		(vpif `(,v < :r5))
			(vp-shl-cr 1 :r5)
			(vp-sub-rr :r5 v)
			(vp-add-cr 1 v)
		(endif)
	(endif))

(def-func (path-to-absolute "./jpg_block"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d15
	;info
	;(jpg-block-decode in state codes quant zigzag prior c) -> dc, a block
	;of a baseline scan, its numbers by their table into c in rows, and the
	;dc it has. state the bits of the scan, (byte bits marker), codes the dc
	;and the ac code, each of jpg-code, (maxcode valptr mincode values)

	(structure slot 0
		(ptr this args)
		(plong sp dmax dvp dmin dvals amax avp amin avals qp zp cp)
		(long dc r7 r8 r9 r10 r11 r12 r13 r14)
		(uint k))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 7)

	;:r7 to :r14 kept in the frame, the scan's state in :r11 to :r14
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5 :r6) '(:obj :obj :obj :obj :obj :num :obj))
	(vp-cpy-rr :r0 :r11)
	(assign '((:r1 +array_begin) (:r3 +array_begin) (:r4 +array_begin) (:r6 +array_begin)) '(:r1 :r3 :r4 :r6))
	(save-fields :rsp '(slot_sp slot_qp slot_zp slot_dc slot_cp) '(:r1 :r3 :r4 :r5 :r6))
	(load-fields :r1 (list 0 +long_size (* 2 +long_size)) '(:r12 :r13 :r14))

	;the two codes, each a list of four nums
	(assign '((:r2 +array_begin)) '(:r2))
	(load-fields :r2 '(0 +ptr_size) '(:r3 :r4))
	(assign '((:r3 +array_begin) (:r4 +array_begin)) '(:r3 :r4))
	(load-fields :r3 (list 0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r5 :r6 :r7 :r8))
	(assign '((:r5 +array_begin) (:r6 +array_begin) (:r7 +array_begin) (:r8 +array_begin)) '(:r5 :r6 :r7 :r8))
	(save-fields :rsp '(slot_dmax slot_dvp slot_dmin slot_dvals) '(:r5 :r6 :r7 :r8))
	(load-fields :r4 (list 0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r5 :r6 :r7 :r8))
	(assign '((:r5 +array_begin) (:r6 +array_begin) (:r7 +array_begin) (:r8 +array_begin)) '(:r5 :r6 :r7 :r8))
	(save-fields :rsp '(slot_amax slot_avp slot_amin slot_avals) '(:r5 :r6 :r7 :r8))

	;c all 0
	(assign '((:rsp slot_cp)) '(:r0))
	(vp-xor-rr :r1 :r1)
	(vp-lea-rcr :r0 (* 64 +long_size) :r2)
	(loop-start)
		(vp-store-rrc :r1 :r0 0)
		(vp-add-cr +long_size :r0)
	(loop-until '(:r0 = :r2))

	;the dc, a difference from the last
	(jpg-symbol 'slot_dmax 'slot_dvp 'slot_dmin 'slot_dvals :r8)
	(jpg-bits :r8 :r7)
	(jpg-extend :r7 :r8)
	(load-fields :rsp '(slot_dc slot_qp slot_cp) '(:r3 :r4 :r5))
	(vp-add-rr :r7 :r3)
	(assign '(:r3 (:r4 0)) '((:rsp slot_dc) :r4))
	(vp-mul-rr :r4 :r3)
	(assign '(:r3) '((:r5 0)))

	;the acs, runs of 0 and a number, in zig zag order
	(assign '(1) '(:r4))
	(assign '(:r4) '((:rsp slot_k)))
	(loop-start 'acs)
		(jpg-symbol 'slot_amax 'slot_avp 'slot_amin 'slot_avals :r8)
		(vp-cpy-rr :r8 :r3)
		(vp-shr-cr 4 :r3)
		(vp-and-cr 15 :r8)
		(assign '((:rsp slot_k)) '(:r4))
		(vpif '(:r8 = 0))
			(breakif '(:r3 /= 15) 'acs)
			(vp-add-cr 16 :r4)
			(assign '(:r4) '((:rsp slot_k)))
		(else)
			(vp-add-rr :r3 :r4)
			(assign '(:r4) '((:rsp slot_k)))
			(breakif '(:r4 >= 64) 'acs)
			(jpg-bits :r8 :r7)
			(jpg-extend :r7 :r8)
			(load-fields :rsp '(slot_qp slot_zp slot_cp slot_k) '(:r5 :r6 :r3 :r4))
			(vp-shl-cr 3 :r4)
			(vp-load-rrr :r5 :r4 :r5)
			(vp-mul-rr :r5 :r7)
			(vp-load-rrr :r6 :r4 :r6)
			(vp-shl-cr 3 :r6)
			(vp-store-rrr :r7 :r3 :r6)
			(vp-shr-cr 3 :r4)
			(vp-add-cr 1 :r4)
			(assign '(:r4) '((:rsp slot_k)))
		(endif)
	(loop-until '(:r4 >= 64))

	(assign '((:rsp slot_sp)) '(:r1))
	(save-fields :r1 (list 0 +long_size (* 2 +long_size)) '(:r12 :r13 :r14))
	(call :num :create '((:rsp slot_dc)) '(:r1))
	(load-fields :rsp '(slot_this slot_r7 slot_r8 slot_r9 slot_r10 slot_r11 slot_r12 slot_r13 slot_r14)
		'(:r0 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(jpg-block-decode in state codes quant zigzag prior c)" +error_msg_wrong_types))
	(signature '(:stream :nums :list :nums :nums :NUM :nums))

(def-func-end)

(defun jpg-at (dst)
	;the address in coefs of base and the zig zag of k into dst, :r5 and
	;:r6 trashed
	(load-fields :rsp '(slot_zp slot_k) '(:r5 :r6))
	(vp-shl-cr 3 :r6)
	(vp-load-rrr :r5 :r6 :r6)
	(load-fields :rsp '(slot_cp slot_base) `(,dst :r5))
	(vp-add-rr :r5 :r6)
	(vp-shl-cr 3 :r6)
	(vp-add-rr :r6 dst))

(defun jpg-refine (addr)
	;the next bit of the number at addr, a register, that is not 0, read
	;whatever it is, p1 added to it away from 0 if it is 1 and that bit of
	;it is not. :r3, :r8 and :r9 trashed
	(assign `((,addr 0)) '(:r8))
	(jpg-bit :r9)
	(vpif '(:r9 /= 0))
		(assign '((:rsp slot_p1)) '(:r3))
		(vp-cpy-rr :r8 :r9)
		(vp-and-rr :r3 :r9)
		(vpif '(:r9 = 0))
			(vpif '(:r8 >= 0))
				(vp-add-rr :r3 :r8)
			(else)
				(vp-sub-rr :r3 :r8)
			(endif)
			(assign '(:r8) `((,addr 0)))
		(endif)
	(endif))

(def-func (path-to-absolute "./jpg_prog"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r10, :r14, :d0-:d15
	;info
	;(jpg-prog-block kind in state code coefs base start end low val zigzag)
	;-> val, a block of a scan of a progressive JPEG into coefs from base,
	;its numbers in rows, as the standard's G.1.2. kind 0 the first bits
	;of the dc, val the last dc and the result this one; 1 the next bit of
	;it; 2 the first bits of the acs from start to end, val the blocks
	;still to pass over, and the result what is left of them; 3 the next
	;bit of each, the same. code is of jpg-code, :nil for kind 1

	(structure slot 0
		(ptr this args)
		(plong sp cp zp cmax cvp cmin cvals)
		(long val p1 v r11 r12 r13)
		(uint kind base start end low k r))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 11)

	;:r11 to :r13 kept in the frame, the scan's state in :r11 to :r14
	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args slot_r11 slot_r12 slot_r13) '(:r0 :r1 :r11 :r12 :r13))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10)
		'(:num :obj :obj :obj :obj :num :num :num :num :num :obj))
	(vp-cpy-rr :r1 :r11)
	(assign '((:r2 +array_begin) (:r4 +array_begin) (:r10 +array_begin)) '(:r2 :r4 :r10))
	(save-fields :rsp '(slot_kind slot_sp slot_cp slot_base slot_start slot_end slot_low slot_val slot_zp)
		'(:r0 :r2 :r4 :r5 :r6 :r7 :r8 :r9 :r10))
	(load-fields :r2 (list 0 +long_size (* 2 +long_size)) '(:r12 :r13 :r14))
	(vpif '(:r0 /= 1))
		(assign '((:r3 +array_begin)) '(:r3))
		(load-fields :r3 (list 0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r4 :r5 :r6 :r7))
		(assign '((:r4 +array_begin) (:r5 +array_begin) (:r6 +array_begin) (:r7 +array_begin)) '(:r4 :r5 :r6 :r7))
		(save-fields :rsp '(slot_cmax slot_cvp slot_cmin slot_cvals) '(:r4 :r5 :r6 :r7))
	(endif)
	(vp-cpy-cr 1 :r1)
	(vp-shl-rr :r8 :r1)
	(assign '(:r1) '((:rsp slot_p1)))

	(vpif '(:r0 = 0))
		;the first bits of the dc, a difference from the last
		(jpg-symbol 'slot_cmax 'slot_cvp 'slot_cmin 'slot_cvals :r8)
		(jpg-bits :r8 :r7)
		(jpg-extend :r7 :r8)
		(load-fields :rsp '(slot_val slot_low slot_cp slot_base) '(:r3 :r4 :r5 :r6))
		(vp-add-rr :r7 :r3)
		(assign '(:r3) '((:rsp slot_val)))
		(vp-shl-rr :r4 :r3)
		(vp-shl-cr 3 :r6)
		(vp-store-rrr :r3 :r5 :r6)
	(elseif '(:r0 = 1))
		;the next bit of the dc
		(jpg-bit :r9)
		(vpif '(:r9 /= 0))
			(load-fields :rsp '(slot_cp slot_base slot_p1) '(:r5 :r6 :r3))
			(vp-shl-cr 3 :r6)
			(vp-load-rrr :r5 :r6 :r4)
			(vp-or-rr :r3 :r4)
			(vp-store-rrr :r4 :r5 :r6)
		(endif)
		(vp-xor-rr :r3 :r3)
		(assign '(:r3) '((:rsp slot_val)))
	(elseif '(:r0 = 2))
		;the first bits of a band of the acs, or a block passed over
		(assign '((:rsp slot_val)) '(:r3))
		(vpif '(:r3 /= 0))
			(vp-sub-cr 1 :r3)
			(assign '(:r3) '((:rsp slot_val)))
		(else)
			(load-fields :rsp '(slot_start slot_end) '(:r3 :r4))
			(assign '(:r3) '((:rsp slot_k)))
			(vpif '(:r3 <= :r4))
				(loop-start 'first)
					(jpg-symbol 'slot_cmax 'slot_cvp 'slot_cmin 'slot_cvals :r8)
					(vp-cpy-rr :r8 :r3)
					(vp-shr-cr 4 :r3)
					(vp-and-cr 15 :r8)
					(vpif '(:r8 /= 0))
						(load-fields :rsp '(slot_end slot_k) '(:r5 :r4))
						(vp-add-rr :r3 :r4)
						(assign '(:r4) '((:rsp slot_k)))
						(vpif '(:r4 <= :r5))
							(jpg-bits :r8 :r7)
							(jpg-extend :r7 :r8)
							(assign '((:rsp slot_low)) '(:r3))
							(vp-shl-rr :r3 :r7)
							(jpg-at :r4)
							(assign '(:r7) '((:r4 0)))
						(endif)
						(assign '((:rsp slot_k)) '(:r4))
						(vp-add-cr 1 :r4)
						(assign '(:r4) '((:rsp slot_k)))
					(elseif '(:r3 = 15))
						(assign '((:rsp slot_k)) '(:r4))
						(vp-add-cr 16 :r4)
						(assign '(:r4) '((:rsp slot_k)))
					(else)
						;the end of this block and of so many more
						(jpg-bits :r3 :r7)
						(vp-cpy-cr 1 :r4)
						(vp-shl-rr :r3 :r4)
						(vp-add-rr :r7 :r4)
						(vp-sub-cr 1 :r4)
						(assign '(:r4) '((:rsp slot_val)))
						(break 'first)
					(endif)
					(load-fields :rsp '(slot_end slot_k) '(:r5 :r4))
				(loop-until '(:r4 > :r5))
			(endif)
		(endif)
	(else)
		;the next bit of each that is not 0, and those that are new
		(load-fields :rsp '(slot_start slot_val) '(:r3 :r4))
		(assign '(:r3) '((:rsp slot_k)))
		(vpif '(:r4 = 0))
			(loop-start 'refine)
				(load-fields :rsp '(slot_end slot_k) '(:r5 :r3))
				(breakif '(:r3 > :r5) 'refine)
				(jpg-symbol 'slot_cmax 'slot_cvp 'slot_cmin 'slot_cvals :r8)
				(vp-cpy-rr :r8 :r3)
				(vp-shr-cr 4 :r3)
				(vp-and-cr 15 :r8)
				(vp-xor-rr :r7 :r7)
				(vpif '(:r8 /= 0))
					(jpg-bit :r9)
					(assign '((:rsp slot_p1)) '(:r7))
					(vpif '(:r9 = 0))
						(vp-mul-cr -1 :r7)
					(endif)
				(elseif '(:r3 /= 15))
					(jpg-bits :r3 :r7)
					(vp-cpy-cr 1 :r4)
					(vp-shl-rr :r3 :r4)
					(vp-add-rr :r7 :r4)
					(assign '(:r4) '((:rsp slot_val)))
					(break 'refine)
				(endif)
				;past r of those that are 0, the next bit of each that is not on
				;the way, to where the new one goes
				(save-fields :rsp '(slot_v slot_r) '(:r7 :r3))
				(loop-start 'past)
					(load-fields :rsp '(slot_end slot_k) '(:r5 :r4))
					(breakif '(:r4 > :r5) 'past)
					(jpg-at :r7)
					(assign '((:r7 0)) '(:r8))
					(vpif '(:r8 /= 0))
						(jpg-refine :r7)
					(else)
						(assign '((:rsp slot_r)) '(:r3))
						(breakif '(:r3 = 0) 'past)
						(vp-sub-cr 1 :r3)
						(assign '(:r3) '((:rsp slot_r)))
					(endif)
					(assign '((:rsp slot_k)) '(:r4))
					(vp-add-cr 1 :r4)
					(assign '(:r4) '((:rsp slot_k)))
				(loop-end)
				(load-fields :rsp '(slot_v slot_end slot_k) '(:r7 :r5 :r4))
				(vpif '(:r7 /= 0) '(:r4 <= :r5))
					(jpg-at :r3)
					(assign '(:r7) '((:r3 0)))
				(endif)
				(assign '((:rsp slot_k)) '(:r4))
				(vp-add-cr 1 :r4)
				(assign '(:r4) '((:rsp slot_k)))
			(loop-end)
		(endif)
		(assign '((:rsp slot_val)) '(:r3))
		(vpif '(:r3 /= 0))
			;a block with no new ones, the next bit of each that is not 0
			(loop-start)
				(load-fields :rsp '(slot_end slot_k) '(:r5 :r4))
				(breakif '(:r4 > :r5))
				(jpg-at :r7)
				(assign '((:r7 0)) '(:r8))
				(vpif '(:r8 /= 0))
					(jpg-refine :r7)
				(endif)
				(assign '((:rsp slot_k)) '(:r4))
				(vp-add-cr 1 :r4)
				(assign '(:r4) '((:rsp slot_k)))
			(loop-end)
			(assign '((:rsp slot_val)) '(:r3))
			(vp-sub-cr 1 :r3)
			(assign '(:r3) '((:rsp slot_val)))
		(endif)
	(endif)

	(assign '((:rsp slot_sp)) '(:r1))
	(save-fields :r1 (list 0 +long_size (* 2 +long_size)) '(:r12 :r13 :r14))
	(call :num :create '((:rsp slot_val)) '(:r1))
	(load-fields :rsp '(slot_this slot_r11 slot_r12 slot_r13) '(:r0 :r11 :r12 :r13))
	(exit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(jpg-prog-block kind in state code coefs base start end low val zigzag)" +error_msg_wrong_types))
	(signature '(:NUM :stream :nums :obj :nums :NUM :NUM :NUM :NUM :NUM :nums))

(def-func-end)
