(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/list/class.inc")
(include "class/nums/class.inc")
(include "class/doubles/class.inc")
(include "class/double/class.inc")

;the step of lib/physics/move.inc, each body as its :step in Lisp has it, the
;same sums in the same order, so the two give the same doubles: the frame the
;places of the parts of the mover, :r13 the place of the body in them, a
;long each, :r14 where they end, :r12 the vtable of a doubles, :r11 :nil;
;:d15 dt, :d14 1, :d13 0, :d12 the least speed that has a way, :d11 half dt

(structure slot 0
	(ptr this args)
	(ptr places vels shoves kicks spins faces accels flows)
	(ptr drags tops rates takes aligns follow_rates follows kin live)
	(long wrap wx wy wz))

(defun step-vec (obj len)
	;obj a doubles of at least len, else the error, then its data
	(assign `((,obj +obj_vtable)) '(:r10))
	(gotoif '(:r10 /= :r12) 'error_frame)
	(assign `((,obj +array_length)) '(:r10))
	(gotoif `(:r10 < ,len) 'error_frame)
	(assign `((,obj +array_begin)) `(,obj)))

(defun step-get (field obj)
	;the element of the body of a list or a nums, its object or long
	(assign `((:rsp ,field)) `(,obj))
	(vp-load-rrr obj :r13 obj))

(defun step-num (field d)
	;the double of the body of a doubles
	(assign `((:rsp ,field)) '(:r10))
	(vp-load-rrd :r10 :r13 d))

(defun step-load (base ds)
	;three doubles of a vector
	(each (lambda (d) (vp-load-rcd base (* (!) +long_size) d)) ds))

(defun step-store (ds base)
	(each (lambda (d) (vp-store-drc d base (* (!) +long_size))) ds))

(defun step-scale (ds k)
	;each of ds times k
	(each (lambda (d) (vp-mul-dd k d)) ds))

(defun step-speed (ds d)
	;the length of the three, as nums-dot sums them, then its root
	(bind '(a b c) ds)
	(vp-cpy-dd a d)
	(vp-mul-dd a d)
	(vp-cpy-dd b :d10)
	(vp-mul-dd b :d10)
	(vp-add-dd :d10 d)
	(vp-cpy-dd c :d10)
	(vp-mul-dd c :d10)
	(vp-add-dd :d10 d)
	(vp-sqrt-dd d d))

(defun step-share (d rate)
	;d the least of 1 and dt times the rate
	(vp-cpy-dd :d15 d)
	(vp-mul-dd rate d)
	(vp-min-dd :d14 d))

(defun step-add-to (base ts)
	;the vector at base made more by ts, and kept there
	(each (lambda (t)
			(vp-load-rcd base (* (!) +long_size) :d10)
			(vp-add-dd t :d10)
			(vp-store-drc :d10 base (* (!) +long_size)))
		ts))

(def-func (path-to-absolute "./step"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8, :r10-:r14, :d0-:d15
	;info
	;(move-step dt wrap places vels shoves kicks spins faces accels flows
	;	drags tops rates takes aligns follow_rates follows kin live) -> :nil
	;the step of a Mover, lib/physics/move.inc, its parts as its :step
	;has them, the flows those of the bodies, theirs or the mover's flow
	;function's; wrap its size each way, or no wrap if it has not three

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 19)

	(vp-alloc slot_size)
	(assign '(:r0 :r1) '((:rsp slot_this) (:rsp slot_args)))
	(assign '((:r1 +array_begin)) '(:r2))
	;dt, and the wrap if it has three
	(vp-load-rcr :r2 0 :r3)
	(vp-load-rcr :r2 +long_size :r4)
	(assign '((:r3 +num_value)) '(:d15))
	(assign '((:r4 +array_length)) '(:r5))
	(vpif '(:r5 >= 3))
		(assign '((:r4 +array_begin)) '(:r4))
		(vp-load-rcr :r4 0 :r5)
		(vp-load-rcr :r4 +long_size :r6)
		(vp-load-rcr :r4 (* 2 +long_size) :r7)
		(save-fields :rsp '(slot_wx slot_wy slot_wz) '(:r5 :r6 :r7))
		(vp-cpy-cr 1 :r5)
	(else)
		(vp-xor-rr :r5 :r5)
	(endif)
	(assign '(:r5) '((:rsp slot_wrap)))
	;the parts, each as long as the places, their data
	(vp-load-rcr :r2 (* 2 +long_size) :r3)
	(assign '((:r3 +array_length)) '(:r14))
	(vp-add-cr (* 2 +long_size) :r2)
	(vp-cpy-rr :r2 :r6)
	(vp-cpy-cr 17 :r7)
	(vp-cpy-rr :rsp :r8)
	(vp-add-cr slot_places :r8)
	(loop-start)
		(assign '((:r6 0)) '(:r3))
		(assign '((:r3 +array_length)) '(:r5))
		(gotoif '(:r5 < :r14) 'error_frame)
		(assign '((:r3 +array_begin)) '(:r3))
		(assign '(:r3) '((:r8 0)))
		(vp-add-cr +long_size :r6)
		(vp-add-cr +long_size :r8)
		(vp-sub-cr 1 :r7)
	(loop-until '(:r7 = 0))
	;the constants
	(assign `((:r0 +lisp_sym_nil) (@ ,(f-path :doubles :vtable))) '(:r11 :r12))
	(vp-cpy-cr 1 :r0)
	(vp-cvt-rd :r0 :d14)
	(vp-xor-rr :r0 :r0)
	(vp-cvt-rd :r0 :d13)
	(vp-cpy-cr 1000000 :r0)
	(vp-cvt-rd :r0 :d0)
	(vp-cpy-dd :d14 :d12)
	(vp-div-dd :d0 :d12)
	(vp-cpy-cr 2 :r0)
	(vp-cvt-rd :r0 :d0)
	(vp-cpy-dd :d15 :d11)
	(vp-div-dd :d0 :d11)

	(vp-shl-cr (log2 +long_size) :r14)
	(vp-xor-rr :r13 :r13)
	(vpif '(:r13 /= :r14))
	(loop-start 'body)
		(step-get 'slot_live :r1)
		(gotoif '(:r1 /= 1) 'next)
		(step-get 'slot_places :r2)
		(step-vec :r2 3)
		(step-get 'slot_vels :r3)
		(step-vec :r3 3)
		(step-get 'slot_shoves :r4)
		(step-vec :r4 3)
		(step-get 'slot_kin :r5)
		(vpif '(:r5 = 0))
			;as much of its kick taken up as it takes in the time
			(step-num 'slot_takes :d0)
			(vpif '(:d0 > :d13))
				(step-get 'slot_kicks :r6)
				(step-vec :r6 3)
				(step-share :d1 :d0)
				(step-load :r6 '(:d2 :d3 :d4))
				(step-scale '(:d2 :d3 :d4) :d1)
				(step-add-to :r3 '(:d2 :d3 :d4))
				(step-load :r6 '(:d5 :d6 :d7))
				(vp-sub-dd :d2 :d5)
				(vp-sub-dd :d3 :d6)
				(vp-sub-dd :d4 :d7)
				(step-store '(:d5 :d6 :d7) :r6)
			(endif)
			;its velocity come to its leader's
			(step-get 'slot_follows :r5)
			(vpif '(:r5 >= 0))
				(vp-shl-cr (log2 +long_size) :r5)
				(gotoif '(:r5 >= :r14) 'error_frame)
				(assign '((:rsp slot_vels)) '(:r6))
				(vp-load-rrr :r6 :r5 :r6)
				(step-vec :r6 3)
				(step-load :r6 '(:d2 :d3 :d4))
				(step-load :r3 '(:d5 :d6 :d7))
				(vp-sub-dd :d5 :d2)
				(vp-sub-dd :d6 :d3)
				(vp-sub-dd :d7 :d4)
				(step-num 'slot_follow_rates :d0)
				(vpif '(:d0 > :d13))
					(step-share :d1 :d0)
					(step-scale '(:d2 :d3 :d4) :d1)
				(endif)
				(step-add-to :r3 '(:d2 :d3 :d4))
			(endif)
			;turned to the way it faces, its speed kept
			(step-get 'slot_faces :r6)
			(vpif '(:r6 /= :r11))
				(step-num 'slot_aligns :d0)
				(vpif '(:d0 > :d13))
					(step-load :r3 '(:d5 :d6 :d7))
					(step-speed '(:d5 :d6 :d7) :d8)
					(vpif '(:d8 > :d12))
						(step-vec :r6 3)
						(step-load :r6 '(:d2 :d3 :d4))
						(step-scale '(:d2 :d3 :d4) :d8)
						(vp-sub-dd :d5 :d2)
						(vp-sub-dd :d6 :d3)
						(vp-sub-dd :d7 :d4)
						(step-share :d1 :d0)
						(step-scale '(:d2 :d3 :d4) :d1)
						(vp-add-dd :d2 :d5)
						(vp-add-dd :d3 :d6)
						(vp-add-dd :d4 :d7)
						(step-speed '(:d5 :d6 :d7) :d9)
						(vpif '(:d9 > :d12))
							(vp-cpy-dd :d8 :d1)
							(vp-div-dd :d9 :d1)
							(step-scale '(:d5 :d6 :d7) :d1)
						(endif)
						(step-store '(:d5 :d6 :d7) :r3)
					(endif)
				(endif)
			(endif)
			;its steady acceleration
			(step-get 'slot_accels :r6)
			(vpif '(:r6 /= :r11))
				(step-vec :r6 3)
				(step-load :r6 '(:d2 :d3 :d4))
				(step-scale '(:d2 :d3 :d4) :d15)
				(step-add-to :r3 '(:d2 :d3 :d4))
			(endif)
			;damped toward what it is in, still or a flow
			(step-num 'slot_drags :d0)
			(vpif '(:d0 > :d13))
				(vp-cpy-dd :d0 :d1)
				(vp-mul-dd :d15 :d1)
				(vp-cpy-dd :d14 :d2)
				(vp-sub-dd :d1 :d2)
				(vp-max-dd :d13 :d2)
				(step-load :r3 '(:d5 :d6 :d7))
				(step-get 'slot_flows :r6)
				(vpif '(:r6 /= :r11))
					(step-vec :r6 3)
					(step-load :r6 '(:d3 :d4 :d8))
					(vp-sub-dd :d3 :d5)
					(vp-sub-dd :d4 :d6)
					(vp-sub-dd :d8 :d7)
					(step-scale '(:d5 :d6 :d7) :d2)
					(vp-add-dd :d3 :d5)
					(vp-add-dd :d4 :d6)
					(vp-add-dd :d8 :d7)
				(else)
					(step-scale '(:d5 :d6 :d7) :d2)
				(endif)
				(step-store '(:d5 :d6 :d7) :r3)
			(endif)
			;no faster than its top
			(step-num 'slot_tops :d0)
			(vpif '(:d0 > :d13))
				(step-load :r3 '(:d5 :d6 :d7))
				(step-speed '(:d5 :d6 :d7) :d8)
				(vpif '(:d8 > :d0))
					(vp-div-dd :d8 :d0)
					(step-scale '(:d5 :d6 :d7) :d0)
					(step-store '(:d5 :d6 :d7) :r3)
				(endif)
			(endif)
			;its place on by it
			(step-load :r3 '(:d2 :d3 :d4))
			(step-scale '(:d2 :d3 :d4) :d15)
			(step-add-to :r2 '(:d2 :d3 :d4))
		(endif)
		;as much of its shove as eases in
		(step-num 'slot_rates :d0)
		(step-share :d1 :d0)
		(step-load :r4 '(:d2 :d3 :d4))
		(step-scale '(:d2 :d3 :d4) :d1)
		(step-add-to :r2 '(:d2 :d3 :d4))
		(step-load :r4 '(:d5 :d6 :d7))
		(vp-sub-dd :d2 :d5)
		(vp-sub-dd :d3 :d6)
		(vp-sub-dd :d4 :d7)
		(step-store '(:d5 :d6 :d7) :r4)
		;kept in the box
		(assign '((:rsp slot_wrap)) '(:r5))
		(vpif '(:r5 /= 0))
			(each (lambda (w)
					(defq at (* (!) +long_size))
					(vp-load-rcd :r2 at :d2)
					(assign `((:rsp ,w)) '(:d3))
					(vpif '(:d2 < :d13))
						(vp-add-dd :d3 :d2)
						(vp-store-drc :d2 :r2 at)
					(elseif '(:d2 >= :d3))
						(vp-sub-dd :d3 :d2)
						(vp-store-drc :d2 :r2 at)
					(endif))
				'(slot_wx slot_wy slot_wz))
		(endif)
		;turned on as it tumbles: wx wy wz qw qx qy qz
		(step-get 'slot_spins :r6)
		(vpif '(:r6 /= :r11))
			(step-vec :r6 7)
			(vp-load-rcd :r6 0 :d0)
			(vp-load-rcd :r6 +long_size :d1)
			(vp-load-rcd :r6 (* 2 +long_size) :d2)
			(vp-load-rcd :r6 (* 3 +long_size) :d3)
			(vp-load-rcd :r6 (* 4 +long_size) :d4)
			(vp-load-rcd :r6 (* 5 +long_size) :d5)
			(vp-load-rcd :r6 (* 6 +long_size) :d6)
			;nw, qw less h of the sum of wx qx, wy qy and wz qz
			(vp-cpy-dd :d0 :d7)
			(vp-mul-dd :d4 :d7)
			(vp-cpy-dd :d1 :d10)
			(vp-mul-dd :d5 :d10)
			(vp-add-dd :d10 :d7)
			(vp-cpy-dd :d2 :d10)
			(vp-mul-dd :d6 :d10)
			(vp-add-dd :d10 :d7)
			(vp-mul-dd :d11 :d7)
			(vp-cpy-dd :d3 :d8)
			(vp-sub-dd :d7 :d8)
			(vp-store-drc :d8 :r6 (* 3 +long_size))
			;each of the rest, q of it and h of w of it by qw and the cross
			(each (lambda ((to wa q wb qc wc qb))
					;q + h (wa qw + (wb qc - wc qb)), kept in :d7 to :d9 till all
					;are done, as each reads the old ones
					(vp-cpy-dd wb to)
					(vp-mul-dd qc to)
					(vp-cpy-dd wc :d10)
					(vp-mul-dd qb :d10)
					(vp-sub-dd :d10 to)
					(vp-cpy-dd wa :d10)
					(vp-mul-dd :d3 :d10)
					(vp-add-dd to :d10)
					(vp-mul-dd :d11 :d10)
					(vp-add-dd q :d10)
					(vp-cpy-dd :d10 to))
				'((:d7 :d0 :d4 :d1 :d6 :d2 :d5) (:d8 :d1 :d5 :d2 :d4 :d0 :d6) (:d9 :d2 :d6 :d0 :d5 :d1 :d4)))
			;made a turn again, 1 over the root of the sum of the squares
			(vp-load-rcd :r6 (* 3 +long_size) :d3)
			(vp-cpy-dd :d3 :d0)
			(vp-mul-dd :d3 :d0)
			(vp-cpy-dd :d7 :d10)
			(vp-mul-dd :d7 :d10)
			(vp-add-dd :d10 :d0)
			(vp-cpy-dd :d8 :d10)
			(vp-mul-dd :d8 :d10)
			(vp-add-dd :d10 :d0)
			(vp-cpy-dd :d9 :d10)
			(vp-mul-dd :d9 :d10)
			(vp-add-dd :d10 :d0)
			(vp-sqrt-dd :d0 :d0)
			(vp-cpy-dd :d14 :d1)
			(vp-div-dd :d0 :d1)
			(step-scale '(:d3 :d7 :d8 :d9) :d1)
			(vp-store-drc :d3 :r6 (* 3 +long_size))
			(vp-store-drc :d7 :r6 (* 4 +long_size))
			(vp-store-drc :d8 :r6 (* 5 +long_size))
			(vp-store-drc :d9 :r6 (* 6 +long_size))
		(endif)
	(vp-label 'next)
		(vp-add-cr +long_size :r13)
	(loop-until '(:r13 = :r14) 'body)
	(endif)

	(assign '((:rsp slot_this)) '(:r0))
	(vp-free slot_size)
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error_frame)
	(assign '((:rsp slot_this) (:rsp slot_args)) '(:r0 :r1))
	(vp-free slot_size)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(move-step dt wrap places vels shoves kicks spins faces accels flows drags tops rates takes aligns follow_rates follows kin live)" +error_msg_wrong_types))
	(signature '(:DOUBLE :DOUBLES :list :list :list :list :list :list :list :list
		:DOUBLES :DOUBLES :DOUBLES :DOUBLES :DOUBLES :DOUBLES :NUMS :NUMS :NUMS))

(def-func-end)

(def-func (path-to-absolute "./led_near"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(collide-led-near centres reaches ranks wrap body hits) -> hits
	;the bodies of hits, as the native sweep left them, less those the
	;body does not lead, their ranks not over its, and those that are balls
	;apart from it, a ball too: each body's reach, -1 a body that is not a
	;ball, the way between them round the world where it wraps, and apart
	;only by more than a billionth over, so none that touch is let go of,
	;the Lisp's test then the one that says

	(vp-rdef (this args centres reaches ball body hits src dst end len b ptr word ranks)
		'(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))
	(vp-ddef (ra cx cy cz wx wy wz hx hy hz dx dy dz rb margin))

	(entry `(,this ,args))

	(gotoif-lisp-args-sig 'error args 6)

	(list-bind-args args `(,centres ,reaches ,ranks ,ball ,body ,hits) '(:obj :obj :obj :obj :num :obj))
	;as many centres as three a reach, as many ranks, a wrap of three, the
	;body one of them
	(assign `((,reaches +array_length) (,centres +array_length)) `(,len ,word))
	(vp-cpy-rr len b)
	(vp-mul-cr 3 b)
	(gotoif `(,b /= ,word) 'error)
	(assign `((,ranks +array_length) (,ball +array_length)) `(,word ,b))
	(gotoif `(,word /= ,len) 'error)
	(gotoif `(,b /= 3) 'error)
	(gotoif `(,body < 0) 'error)
	(gotoif `(,body >= ,len) 'error)
	;the wrap, half of it each way, a way that does not wrap half of 0
	(assign `((,ball +array_begin)) `(,ptr))
	(vp-load-rcd ptr 0 wx)
	(vp-load-rcd ptr +long_size wy)
	(vp-load-rcd ptr (* 2 +long_size) wz)
	(vp-cpy-cr 2 word)
	(vp-cvt-rd word margin)
	(vp-cpy-dd wx hx)
	(vp-div-dd margin hx)
	(vp-cpy-dd wy hy)
	(vp-div-dd margin hy)
	(vp-cpy-dd wz hz)
	(vp-div-dd margin hz)
	;1 and a billionth
	(vp-cpy-cr 1000000000 word)
	(vp-cvt-rd word dx)
	(vp-cpy-cr 1 word)
	(vp-cvt-rd word margin)
	(vp-div-dd dx margin)
	(vp-cvt-rd word dx)
	(vp-add-dd dx margin)
	;the body's rank, its reach, and is it a ball, its reach not under 0:
	;a double's sign is its word's
	(assign `((,centres +array_begin) (,reaches +array_begin) (,ranks +array_begin)) `(,centres ,reaches ,ranks))
	(vp-shl-cr (log2 +long_size) body)
	(vp-load-rrd reaches body ra)
	(vp-load-rrr reaches body ball)
	(vp-xor-cr -1 ball)
	(vp-shr-cr 63 ball)
	(vp-cpy-rr body ptr)
	(vp-mul-cr 3 ptr)
	(vp-add-rr centres ptr)
	(vp-load-rcd ptr 0 cx)
	(vp-load-rcd ptr +long_size cy)
	(vp-load-rcd ptr (* 2 +long_size) cz)
	(vp-load-rrr ranks body body)
	;each of hits kept, or not
	(assign `((,hits +array_begin) (,hits +array_length)) `(,src ,end))
	(vp-shl-cr (log2 +long_size) end)
	(vp-add-rr src end)
	(vp-cpy-rr src dst)
	(vpif `(,src /= ,end))
		(loop-start)
			(vp-load-rcr src 0 b)
			(gotoif `(,b < 0) 'error)
			(gotoif `(,b >= ,len) 'error)
			(vp-cpy-rr b ptr)
			(vp-shl-cr (log2 +long_size) ptr)
			;one the body does not lead
			(vp-load-rrr ranks ptr word)
			(gotoif `(,word <= ,body) 'drop)
			;both balls, and apart
			(vpif `(,ball /= 0))
				(vp-load-rrr reaches ptr word)
				(vpif `(,word >= 0))
					(vp-load-rrd reaches ptr rb)
					(vp-cpy-rr b ptr)
					(vp-mul-cr (* 3 +long_size) ptr)
					(vp-add-rr centres ptr)
					;the way round the world
					(each (lambda (d c w h)
							(vp-load-rcd ptr (* (!) +long_size) d)
							(vp-sub-dd c d)
							(vpif `(,d > ,h))
								(vp-sub-dd w d)
							(else)
								(vp-neg-dd h :d15)
								(vpif `(,d < :d15))
									(vp-add-dd w d)
								(endif)
							(endif))
						`(,dx ,dy ,dz) `(,cx ,cy ,cz) `(,wx ,wy ,wz) `(,hx ,hy ,hz))
					(vp-mul-dd dx dx)
					(vp-mul-dd dy dy)
					(vp-mul-dd dz dz)
					(vp-add-dd dy dx)
					(vp-add-dd dz dx)
					(vp-add-dd ra rb)
					(vp-mul-dd rb rb)
					(vp-mul-dd margin rb)
					(gotoif `(,dx >= ,rb) 'drop)
				(endif)
			(endif)
			(vp-store-rrc b dst 0)
			(vp-add-cr +long_size dst)
		(vp-label 'drop)
			(vp-add-cr +long_size src)
		(loop-until `(,src = ,end))
	(endif)
	(assign `((,hits +array_begin)) `(,word))
	(vp-sub-rr word dst)
	(vp-shr-cr (log2 +long_size) dst)
	(assign `(,dst) `((,hits +array_length)))
	(class/obj/ref hits word)

	(exit `(,this ,hits))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(collide-led-near centres reaches ranks wrap body hits)" +error_msg_wrong_types))
	(signature '(:DOUBLES :DOUBLES :NUMS :DOUBLES :NUM :NUMS))

(def-func-end)
