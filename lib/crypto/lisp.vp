(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "class/nums/class.inc")
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; The native code of lib/crypto, the part of a hash or a cipher
; that is done for every byte. What is done once, the padding and
; the like, is Lisp, lib/crypto/sha256.inc.
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;


(def-func (path-to-absolute "./sha256_blocks"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(sha256-blocks state data offset count) -> state
	;the state is 8 numbers of 32 bits, as they are on this machine, in a
	;str of 32 bytes, and is changed where it is. count blocks of 64
	;bytes, from that offset of the data, are taken into it.

	;a number of 32 bits is kept in a register with nothing above it, so
	;x with a copy of itself above it, moved down n, has x rotated right
	;by n as its low 32 bits. What is above 32 bits in a sum does no
	;harm, and is cut off when the sum is kept.
	(vp-rdef (ra rb rc rd re rf rg rh rw rk t1 t2 t3 t4 rm))

	(defun sha-round (RA RB RC RD RE RF RG RH j)
		;round j of 8, the registers that are a to h in this round. What
		;is to be the new e is left in D, and the new a in H
		(vp-cpy-rr RE t1) (vp-shl-cr 32 t1) (vp-or-rr RE t1)
		(vp-cpy-rr t1 t2) (vp-shr-cr 6 t2)
		(vp-cpy-rr t1 t3) (vp-shr-cr 11 t3) (vp-xor-rr t3 t2)
		(vp-shr-cr 25 t1) (vp-xor-rr t1 t2)
		;choose, f where e has a bit and g where it has not
		(vp-cpy-rr RF t1) (vp-xor-rr RG t1) (vp-and-rr RE t1) (vp-xor-rr RG t1)
		(vp-add-rr t2 RH) (vp-add-rr t1 RH)
		(vp-cpy-ir-ui rk (* j 4) t1) (vp-add-rr t1 RH)
		(vp-cpy-ir-ui rw (* j 4) t1) (vp-add-rr t1 RH)
		(vp-add-rr RH RD) (vp-and-rr rm RD)
		(vp-cpy-rr RA t1) (vp-shl-cr 32 t1) (vp-or-rr RA t1)
		(vp-cpy-rr t1 t2) (vp-shr-cr 2 t2)
		(vp-cpy-rr t1 t3) (vp-shr-cr 13 t3) (vp-xor-rr t3 t2)
		(vp-shr-cr 22 t1) (vp-xor-rr t1 t2)
		;majority, of a, b and c
		(vp-cpy-rr RA t1) (vp-or-rr RB t1) (vp-and-rr RC t1)
		(vp-cpy-rr RA t3) (vp-and-rr RB t3) (vp-or-rr t3 t1)
		(vp-add-rr t2 RH) (vp-add-rr t1 RH) (vp-and-rr rm RH))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5) '(:obj :obj :num :num))
(errorcase
	(assign '((:r2 +str_length) (:r3 +str_length)) '(:r6 :r7))
	(gotoif '(:r6 /= 32) 'error)
	(gotoif '(:r4 < 0) 'error)
	(gotoif '(:r5 < 0) 'error)
	(vp-cpy-rr :r5 :r6)
	(vp-shl-cr 6 :r6)
	(vp-add-rr :r4 :r6)
	(gotoif '(:r6 > :r7) 'error))

	;the stack has the 64 words of a block's schedule, then where the
	;state is, where the next block is, how many are left, the lisp
	;object and the state object
	(vp-alloc 304)
	(vp-cpy-ri :r0 :rsp 280)
	(vp-cpy-ri :r2 :rsp 288)
	(vp-add-cr +str_data :r2)
	(vp-add-cr +str_data :r3)
	(vp-add-rr :r4 :r3)
	(vp-cpy-ri :r2 :rsp 256)
	(vp-cpy-ri :r3 :rsp 264)
	(vp-cpy-ri :r5 :rsp 272)

(vp-label 'block)
	(vp-cpy-ir :rsp 272 t1)
	(vp-beq-cr 0 t1 'done)
	(vp-sub-cr 1 t1)
	(vp-cpy-ri t1 :rsp 272)
	;the first 16 words are the block, its bytes the other way round
	(vp-cpy-ir :rsp 264 t4)
	(each (lambda (i)
		(vp-cpy-ir-ui t4 (* i 4) t2)
		(vp-cpy-rr t2 t3) (vp-shr-cr 8 t3) (vp-and-cr 0x00ff00ff t3)
		(vp-and-cr 0x00ff00ff t2) (vp-shl-cr 8 t2) (vp-or-rr t3 t2)
		(vp-cpy-rr t2 t3) (vp-shr-cr 16 t3) (vp-shl-cr 16 t2) (vp-or-rr t3 t2)
		(vp-cpy-ri-i t2 :rsp (* i 4))) (range 0 16))
	(vp-add-cr 64 t4)
	(vp-cpy-ri t4 :rsp 264)
	;the other 48, each from four that came before it. w is 16 words
	;behind the one being made
	(vp-lea-i :rsp 0 rw)
	(vp-lea-i :rsp 192 rk)
(vp-label 'sched)
	(vp-cpy-ir-ui rw 4 t1)
	(vp-cpy-rr t1 t2) (vp-shl-cr 32 t2) (vp-or-rr t1 t2)
	(vp-cpy-rr t2 t3) (vp-shr-cr 7 t3) (vp-shr-cr 18 t2) (vp-xor-rr t2 t3)
	(vp-shr-cr 3 t1) (vp-xor-rr t1 t3)
	(vp-cpy-ir-ui rw 56 t1)
	(vp-cpy-rr t1 t2) (vp-shl-cr 32 t2) (vp-or-rr t1 t2)
	(vp-cpy-rr t2 t4) (vp-shr-cr 17 t4) (vp-shr-cr 19 t2) (vp-xor-rr t2 t4)
	(vp-shr-cr 10 t1) (vp-xor-rr t1 t4)
	(vp-add-rr t4 t3)
	(vp-cpy-ir-ui rw 0 t1) (vp-add-rr t1 t3)
	(vp-cpy-ir-ui rw 36 t1) (vp-add-rr t1 t3)
	(vp-cpy-ri-i t3 rw 64)
	(vp-add-cr 4 rw)
	(vp-bne-rr rk rw 'sched)
	;the 64 rounds, 8 at a time, after which a to h are in the registers
	;they started in
	(vp-cpy-ir :rsp 256 t4)
	(each (lambda (r) (vp-cpy-ir-ui t4 (* (!) 4) r)) (list ra rb rc rd re rf rg rh))
	(vp-cpy-cr 0xffffffff rm)
	(vp-lea-i :rsp 0 rw)
	(vp-lea-p 'k256 rk)
(vp-label 'rounds)
	(defq roles (list ra rb rc rd re rf rg rh))
	(each (lambda (j)
		(apply sha-round (cat roles (list j)))
		(setq roles (cat (list (last roles)) (slice roles 0 -2)))) (range 0 8))
	(vp-add-cr 32 rw)
	(vp-add-cr 32 rk)
	(vp-lea-i :rsp 256 t4)
	(vp-bne-rr t4 rw 'rounds)
	;and they are added to the state
	(vp-cpy-ir :rsp 256 t4)
	(each (lambda (r)
		(vp-cpy-ir-ui t4 (* (!) 4) t1)
		(vp-add-rr t1 r)
		(vp-cpy-ri-i r t4 (* (!) 4))) (list ra rb rc rd re rf rg rh))
	(vp-jmp 'block)

(vp-label 'done)
	(vp-cpy-ir :rsp 280 :r0)
	(vp-cpy-ir :rsp 288 :r1)
	(vp-free 304)
	(class/obj/ref :r1 :r2)

	(exit '(:r0 :r1))
	(vp-ret)

	;the first 32 bits of the fractions of the cube roots of the first
	;64 primes
	(vp-align 4)
(vp-label 'k256)
	(vp-int 0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5)
	(vp-int 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5)
	(vp-int 0xd807aa98 0x12835b01 0x243185be 0x550c7dc3)
	(vp-int 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174)
	(vp-int 0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc)
	(vp-int 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da)
	(vp-int 0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7)
	(vp-int 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967)
	(vp-int 0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13)
	(vp-int 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85)
	(vp-int 0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3)
	(vp-int 0xd192e819 0xd6990624 0xf40e3585 0x106aa070)
	(vp-int 0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5)
	(vp-int 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3)
	(vp-int 0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208)
	(vp-int 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(sha256-blocks state data offset count)" +error_msg_wrong_types))
	(signature '(:str :str :NUM :NUM)))

(def-func-end)

(def-func (path-to-absolute "./sha512_blocks"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13
	;info
	;(sha512-blocks state data offset count) -> state
	;the state is 8 numbers of 64 bits, as they are on this machine, in a
	;str of 64 bytes, and is changed where it is. count blocks of 128
	;bytes, from that offset of the data, are taken into it.

	;a number is a whole register here, so a sum wraps as it should with
	;nothing to cut off. VP has no rotate, a rotate right by n is the
	;number moved down n, or'd with it moved up 64 less n.
	(vp-rdef (ra rb rc rd re rf rg rh rw rk t1 t2 t3 t4))

	(defun sha512-rotr (x n to tmp)
		;x rotated right by n, into to. tmp is used
		(vp-cpy-rr x to) (vp-shr-cr n to)
		(vp-cpy-rr x tmp) (vp-shl-cr (- 64 n) tmp) (vp-or-rr tmp to))

	(defun sha512-round (RA RB RC RD RE RF RG RH j)
		;round j of 8, the registers that are a to h in this round. What
		;is to be the new e is left in D, and the new a in H
		(sha512-rotr RE 14 t2 t1)
		(sha512-rotr RE 18 t3 t1) (vp-xor-rr t3 t2)
		(sha512-rotr RE 41 t3 t1) (vp-xor-rr t3 t2)
		;choose, f where e has a bit and g where it has not
		(vp-cpy-rr RF t1) (vp-xor-rr RG t1) (vp-and-rr RE t1) (vp-xor-rr RG t1)
		(vp-add-rr t2 RH) (vp-add-rr t1 RH)
		(vp-cpy-ir rk (* j 8) t1) (vp-add-rr t1 RH)
		(vp-cpy-ir rw (* j 8) t1) (vp-add-rr t1 RH)
		(vp-add-rr RH RD)
		(sha512-rotr RA 28 t2 t1)
		(sha512-rotr RA 34 t3 t1) (vp-xor-rr t3 t2)
		(sha512-rotr RA 39 t3 t1) (vp-xor-rr t3 t2)
		;majority, of a, b and c
		(vp-cpy-rr RA t1) (vp-or-rr RB t1) (vp-and-rr RC t1)
		(vp-cpy-rr RA t3) (vp-and-rr RB t3) (vp-or-rr t3 t1)
		(vp-add-rr t2 RH) (vp-add-rr t1 RH))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5) '(:obj :obj :num :num))
(errorcase
	(assign '((:r2 +str_length) (:r3 +str_length)) '(:r6 :r7))
	(gotoif '(:r6 /= 64) 'error)
	(gotoif '(:r4 < 0) 'error)
	(gotoif '(:r5 < 0) 'error)
	(vp-cpy-rr :r5 :r6)
	(vp-shl-cr 7 :r6)
	(vp-add-rr :r4 :r6)
	(gotoif '(:r6 > :r7) 'error))

	;the stack has the 80 words of a block's schedule, then where the
	;state is, where the next block is, how many are left, the lisp
	;object and the state object
	(vp-alloc 688)
	(vp-cpy-ri :r0 :rsp 664)
	(vp-cpy-ri :r2 :rsp 672)
	(vp-add-cr +str_data :r2)
	(vp-add-cr +str_data :r3)
	(vp-add-rr :r4 :r3)
	(vp-cpy-ri :r2 :rsp 640)
	(vp-cpy-ri :r3 :rsp 648)
	(vp-cpy-ri :r5 :rsp 656)

(vp-label 'block)
	(vp-cpy-ir :rsp 656 t1)
	(vp-beq-cr 0 t1 'done)
	(vp-sub-cr 1 t1)
	(vp-cpy-ri t1 :rsp 656)
	;the first 16 words are the block, its bytes the other way round. The
	;bytes of each pair change places, then the pairs, then the halves
	(vp-cpy-ir :rsp 648 t4)
	(vp-cpy-cr 0x00ff00ff00ff00ff ra)
	(vp-cpy-cr 0x0000ffff0000ffff rb)
	(each (lambda (i)
		(vp-cpy-ir t4 (* i 8) t2)
		(vp-cpy-rr t2 t3) (vp-shr-cr 8 t3) (vp-and-rr ra t3)
		(vp-and-rr ra t2) (vp-shl-cr 8 t2) (vp-or-rr t3 t2)
		(vp-cpy-rr t2 t3) (vp-shr-cr 16 t3) (vp-and-rr rb t3)
		(vp-and-rr rb t2) (vp-shl-cr 16 t2) (vp-or-rr t3 t2)
		(vp-cpy-rr t2 t3) (vp-shr-cr 32 t3) (vp-shl-cr 32 t2) (vp-or-rr t3 t2)
		(vp-cpy-ri t2 :rsp (* i 8))) (range 0 16))
	(vp-add-cr 128 t4)
	(vp-cpy-ri t4 :rsp 648)
	;the other 64, each from four that came before it. w is 16 words
	;behind the one being made
	(vp-lea-i :rsp 0 rw)
	(vp-lea-i :rsp 512 rk)
(vp-label 'sched)
	(vp-cpy-ir rw 8 t1)
	(sha512-rotr t1 1 t3 t2)
	(sha512-rotr t1 8 t4 t2) (vp-xor-rr t4 t3)
	(vp-shr-cr 7 t1) (vp-xor-rr t1 t3)
	(vp-cpy-ir rw 112 t1)
	(sha512-rotr t1 19 t4 t2)
	(sha512-rotr t1 61 ra t2) (vp-xor-rr ra t4)
	(vp-shr-cr 6 t1) (vp-xor-rr t1 t4)
	(vp-add-rr t4 t3)
	(vp-cpy-ir rw 0 t1) (vp-add-rr t1 t3)
	(vp-cpy-ir rw 72 t1) (vp-add-rr t1 t3)
	(vp-cpy-ri t3 rw 128)
	(vp-add-cr 8 rw)
	(vp-bne-rr rk rw 'sched)
	;the 80 rounds, 8 at a time, after which a to h are in the registers
	;they started in
	(vp-cpy-ir :rsp 640 t4)
	(each (lambda (r) (vp-cpy-ir t4 (* (!) 8) r)) (list ra rb rc rd re rf rg rh))
	(vp-lea-i :rsp 0 rw)
	(vp-lea-p 'k512 rk)
(vp-label 'rounds)
	(defq roles (list ra rb rc rd re rf rg rh))
	(each (lambda (j)
		(apply sha512-round (cat roles (list j)))
		(setq roles (cat (list (last roles)) (slice roles 0 -2)))) (range 0 8))
	(vp-add-cr 64 rw)
	(vp-add-cr 64 rk)
	(vp-lea-i :rsp 640 t4)
	(vp-bne-rr t4 rw 'rounds)
	;and they are added to the state
	(vp-cpy-ir :rsp 640 t4)
	(each (lambda (r)
		(vp-cpy-ir t4 (* (!) 8) t1)
		(vp-add-rr t1 r)
		(vp-cpy-ri r t4 (* (!) 8))) (list ra rb rc rd re rf rg rh))
	(vp-jmp 'block)

(vp-label 'done)
	(vp-cpy-ir :rsp 664 :r0)
	(vp-cpy-ir :rsp 672 :r1)
	(vp-free 688)
	(class/obj/ref :r1 :r2)

	(exit '(:r0 :r1))
	(vp-ret)

	;the first 64 bits of the fractions of the cube roots of the first
	;80 primes, each as the signed number of the same bits
	(vp-align 8)
(vp-label 'k512)
	(vp-long 4794697086780616226 8158064640168781261 -5349999486874862801 -1606136188198331460)
	(vp-long 4131703408338449720 6480981068601479193 -7908458776815382629 -6116909921290321640)
	(vp-long -2880145864133508542 1334009975649890238 2608012711638119052 6128411473006802146)
	(vp-long 8268148722764581231 -9160688886553864527 -7215885187991268811 -4495734319001033068)
	(vp-long -1973867731355612462 -1171420211273849373 1135362057144423861 2597628984639134821)
	(vp-long 3308224258029322869 5365058923640841347 6679025012923562964 8573033837759648693)
	(vp-long -7476448914759557205 -6327057829258317296 -5763719355590565569 -4658551843659510044)
	(vp-long -4116276920077217854 -3051310485924567259 489312712824947311 1452737877330783856)
	(vp-long 2861767655752347644 3322285676063803686 5560940570517711597 5996557281743188959)
	(vp-long 7280758554555802590 8532644243296465576 -9096487096722542874 -7894198246740708037)
	(vp-long -6719396339535248540 -6333637450476146687 -4446306890439682159 -4076793802049405392)
	(vp-long -3345356375505022440 -2983346525034927856 -860691631967231958 1182934255886127544)
	(vp-long 1847814050463011016 2177327727835720531 2830643537854262169 3796741975233480872)
	(vp-long 4115178125766777443 5681478168544905931 6601373596472566643 7507060721942968483)
	(vp-long 8399075790359081724 8693463985226723168 -8878714635349349518 -8302665154208450068)
	(vp-long -8016688836872298968 -6606660893046293015 -4685533653050689259 -4147400797238176981)
	(vp-long -3880063495543823972 -3348786107499101689 -1523767162380948706 -757361751448694408)
	(vp-long 500013540394364858 748580250866718886 1242879168328830382 1977374033974150939)
	(vp-long 2944078676154940804 3659926193048069267 4368137639120453308 4836135668995329356)
	(vp-long 5532061633213252278 6448918945643986474 6902733635092675308 7801388544844847127)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(sha512-blocks state data offset count)" +error_msg_wrong_types))
	(signature '(:str :str :NUM :NUM)))

(def-func-end)

(def-func (path-to-absolute "./chacha20_xor"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(chacha20-xor key nonce counter data out offset length) -> out
	;length bytes of data, from that offset, go to the same place in out,
	;each xored with the next byte of the key stream of ChaCha20, RFC
	;8439. The key is 32 bytes, the nonce 12, and counter is the number
	;of the block of 64 bytes the offset is the start of. out can be the
	;data itself.

	;the 16 numbers of a block are 32 bits each. 12 of them are in
	;registers through the rounds, and the four of the third row are on
	;the stack, one of them in a register for the quarter round that
	;uses it
	(vp-rdef (x0 x1 x2 x3 x4 x5 x6 x7 x12 x13 x14 x15 ct tm cm))

	(defq +cc_state 0 +cc_work 64 +cc_tail 128 +cc_in 192 +cc_out 200 +cc_left 208
		+cc_this 216 +cc_obj 224 +cc_rounds 232 +cc_real 240 +cc_part 248 +cc_stack 256)

	(defun cc-rotl (x n)
		;x rotated left by n, of 32 bits
		(vp-cpy-rr x tm) (vp-shl-cr n x) (vp-shr-cr (- 32 n) tm)
		(vp-or-rr tm x) (vp-and-rr cm x))

	(defun cc-quarter (xa xb ic xd)
		;a quarter round, on three registers and number ic of the block
		(vp-add-rr xb xa) (vp-and-rr cm xa) (vp-xor-rr xa xd) (cc-rotl xd 16)
		(vp-cpy-ir-ui :rsp (+ +cc_work (* ic 4)) ct)
		(vp-add-rr xd ct) (vp-and-rr cm ct) (vp-xor-rr ct xb) (cc-rotl xb 12)
		(vp-add-rr xb xa) (vp-and-rr cm xa) (vp-xor-rr xa xd) (cc-rotl xd 8)
		(vp-add-rr xd ct) (vp-and-rr cm ct) (vp-xor-rr ct xb) (cc-rotl xb 7)
		(vp-cpy-ri-i ct :rsp (+ +cc_work (* ic 4))))

	(defun cc-bytes (from to count label)
		;count bytes from one place to another, count is not 0
		(vp-label label)
		(vp-cpy-ir-ub from 0 tm)
		(vp-cpy-ri-b tm to 0)
		(vp-add-cr 1 from) (vp-add-cr 1 to)
		(vp-sub-cr 1 count)
		(vp-bne-cr 0 count label))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8) '(:obj :obj :num :obj :obj :num :num))
(errorcase
	(assign '((:r2 +str_length) (:r3 +str_length)) '(:r9 :r10))
	(gotoif '(:r9 /= 32) 'error)
	(gotoif '(:r10 /= 12) 'error)
	(gotoif '(:r7 < 0) 'error)
	(gotoif '(:r8 < 0) 'error)
	(vp-cpy-rr :r7 :r9)
	(vp-add-rr :r8 :r9)
	(assign '((:r5 +str_length) (:r6 +str_length)) '(:r10 :r11))
	(gotoif '(:r9 > :r10) 'error)
	(gotoif '(:r9 > :r11) 'error))

	(vp-alloc +cc_stack)
	(vp-cpy-ri :r0 :rsp +cc_this)
	(vp-cpy-ri :r6 :rsp +cc_obj)
	;the block as it starts, four numbers that never change, the key,
	;the counter, and the nonce
	(each (lambda (word)
		(vp-cpy-cr word :r9)
		(vp-cpy-ri-i :r9 :rsp (+ +cc_state (* (!) 4))))
		'(0x61707865 0x3320646e 0x79622d32 0x6b206574))
	(each (lambda (i)
		(vp-cpy-ir-ui :r2 (+ +str_data (* i 4)) :r9)
		(vp-cpy-ri-i :r9 :rsp (+ +cc_state 16 (* i 4)))) (range 0 8))
	(vp-cpy-ri-i :r4 :rsp (+ +cc_state 48))
	(each (lambda (i)
		(vp-cpy-ir-ui :r3 (+ +str_data (* i 4)) :r9)
		(vp-cpy-ri-i :r9 :rsp (+ +cc_state 52 (* i 4)))) (range 0 3))
	(vp-add-cr +str_data :r5)
	(vp-add-cr +str_data :r6)
	(vp-add-rr :r7 :r5)
	(vp-add-rr :r7 :r6)
	(vp-cpy-ri :r5 :rsp +cc_in)
	(vp-cpy-ri :r6 :rsp +cc_out)
	(vp-cpy-ri :r8 :rsp +cc_left)
	(vp-xor-rr :r9 :r9)
	(vp-cpy-ri :r9 :rsp +cc_part)

(vp-label 'cc_block)
	(vp-cpy-ir :rsp +cc_left x0)
	(vp-beq-cr 0 x0 'cc_done)
	(vp-blt-cr 64 x0 'cc_short)
	(vp-sub-cr 64 x0)
	(vp-cpy-ri x0 :rsp +cc_left)
	(vp-jmp 'cc_go)
(vp-label 'cc_short)
	;less than a block is left. It is copied to the stack, done there,
	;and what comes of it copied out
	(vp-cpy-ri x0 :rsp +cc_part)
	(vp-xor-rr x1 x1)
	(vp-cpy-ri x1 :rsp +cc_left)
	(vp-cpy-ir :rsp +cc_in x1)
	(vp-lea-i :rsp +cc_tail x2)
	(cc-bytes x1 x2 x0 'cc_copy_in)
	(vp-cpy-ir :rsp +cc_out x1)
	(vp-cpy-ri x1 :rsp +cc_real)
	(vp-lea-i :rsp +cc_tail x2)
	(vp-cpy-ri x2 :rsp +cc_in)
	(vp-cpy-ri x2 :rsp +cc_out)
(vp-label 'cc_go)
	(each (lambda (x i) (vp-cpy-ir-ui :rsp (+ +cc_state (* i 4)) x))
		(list x0 x1 x2 x3 x4 x5 x6 x7 x12 x13 x14 x15) '(0 1 2 3 4 5 6 7 12 13 14 15))
	(each (lambda (i)
		(vp-cpy-ir-ui :rsp (+ +cc_state (* i 4)) ct)
		(vp-cpy-ri-i ct :rsp (+ +cc_work (* i 4)))) '(8 9 10 11))
	(vp-cpy-cr 0xffffffff cm)
	(vp-cpy-cr 10 tm)
	(vp-cpy-ri tm :rsp +cc_rounds)
(vp-label 'cc_round)
	;down the columns, then along the diagonals
	(cc-quarter x0 x4 8 x12)
	(cc-quarter x1 x5 9 x13)
	(cc-quarter x2 x6 10 x14)
	(cc-quarter x3 x7 11 x15)
	(cc-quarter x0 x5 10 x15)
	(cc-quarter x1 x6 11 x12)
	(cc-quarter x2 x7 8 x13)
	(cc-quarter x3 x4 9 x14)
	(vp-cpy-ir :rsp +cc_rounds tm)
	(vp-sub-cr 1 tm)
	(vp-cpy-ri tm :rsp +cc_rounds)
	(vp-bne-cr 0 tm 'cc_round)
	;all 16 on the stack, then each, with what it started as added, is
	;xored with 4 bytes of the data
	(each (lambda (x i) (vp-cpy-ri-i x :rsp (+ +cc_work (* i 4))))
		(list x0 x1 x2 x3 x4 x5 x6 x7 x12 x13 x14 x15) '(0 1 2 3 4 5 6 7 12 13 14 15))
	(vp-cpy-ir :rsp +cc_in x0)
	(vp-cpy-ir :rsp +cc_out x1)
	(each (lambda (i)
		(vp-cpy-ir-ui :rsp (+ +cc_work (* i 4)) x2)
		(vp-cpy-ir-ui :rsp (+ +cc_state (* i 4)) x3)
		(vp-add-rr x3 x2)
		(vp-cpy-ir-ui x0 (* i 4) x3)
		(vp-xor-rr x3 x2)
		(vp-cpy-ri-i x2 x1 (* i 4))) (range 0 16))
	(vp-add-cr 64 x0)
	(vp-add-cr 64 x1)
	(vp-cpy-ri x0 :rsp +cc_in)
	(vp-cpy-ri x1 :rsp +cc_out)
	;the next block has the next counter
	(vp-cpy-ir-ui :rsp (+ +cc_state 48) x2)
	(vp-add-cr 1 x2)
	(vp-cpy-ri-i x2 :rsp (+ +cc_state 48))
	(vp-cpy-ir :rsp +cc_part x0)
	(vp-beq-cr 0 x0 'cc_block)
	(vp-lea-i :rsp +cc_tail x1)
	(vp-cpy-ir :rsp +cc_real x2)
	(cc-bytes x1 x2 x0 'cc_copy_out)

(vp-label 'cc_done)
	(vp-cpy-ir :rsp +cc_this :r0)
	(vp-cpy-ir :rsp +cc_obj :r1)
	(vp-free +cc_stack)
	(class/obj/ref :r1 :r2)

	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(chacha20-xor key nonce counter data out offset length)" +error_msg_wrong_types))
	(signature '(:str :str :NUM :str :str :NUM :NUM)))

(def-func-end)

(def-func (path-to-absolute "./poly1305_blocks"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(poly1305-blocks state data offset count top) -> state
	;count blocks of 16 bytes, from that offset of the data, are taken
	;into the sum of Poly1305, RFC 8439. The state is 15 numbers of 64
	;bits in a str, the sum so far, h, in 5, each 26 bits of it, then r
	;the same way, then 5 times each of the top four of r, and one that
	;is this function's own. top is 1 for whole blocks, the bit that
	;goes above the 16 bytes of each, and 0 for a last block that has
	;had its own put in.

	;h is a number of 130 bits, kept as five of 26. h times r is 25
	;products that each fit in 64 bits with room to add five of them,
	;and what would go above 130 bits comes back in at the bottom times
	;5, 2 to the 130 being 5 more than the prime
	(vp-rdef (h0 h1 h2 h3 h4 d0 d1 d2 d3 d4 t0 t1 pm ps pn))
	(defq +pl_mask 0x3ffffff)

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6) '(:obj :obj :num :num :num))
(errorcase
	(assign '((:r2 +str_length) (:r3 +str_length)) '(:r7 :r8))
	(gotoif '(:r7 /= 120) 'error)
	(gotoif '(:r4 < 0) 'error)
	(gotoif '(:r5 < 0) 'error)
	(gotoif '(:r6 < 0) 'error)
	(gotoif '(:r6 > 1) 'error)
	(vp-cpy-rr :r5 :r7)
	(vp-shl-cr 4 :r7)
	(vp-add-rr :r4 :r7)
	(gotoif '(:r7 > :r8) 'error))

	(vp-push :r0 :r2)
	(vp-add-cr +str_data :r2)
	(vp-add-cr +str_data :r3)
	(vp-add-rr :r4 :r3)
	(vp-shl-cr 24 :r6)
	(vp-cpy-ri :r6 :r2 112)
	(vp-cpy-rr :r5 pn)
	(vp-cpy-rr :r3 pm)
	(vp-cpy-rr :r2 ps)
	(defq hs (list h0 h1 h2 h3 h4) ds (list d0 d1 d2 d3 d4))
	(each (lambda (h) (vp-cpy-ir ps (* (!) 8) h)) hs)

(vp-label 'pl_block)
	(vp-beq-cr 0 pn 'pl_done)
	;the 16 bytes, as five numbers of 26 bits, added to h
	(vp-cpy-ir pm 0 t0)
	(vp-cpy-ir pm 8 t1)
	(vp-cpy-rr t0 d0) (vp-and-cr +pl_mask d0) (vp-add-rr d0 h0)
	(vp-cpy-rr t0 d0) (vp-shr-cr 26 d0) (vp-and-cr +pl_mask d0) (vp-add-rr d0 h1)
	(vp-shr-cr 52 t0) (vp-cpy-rr t1 d1) (vp-shl-cr 12 d1) (vp-or-rr d1 t0)
	(vp-and-cr +pl_mask t0) (vp-add-rr t0 h2)
	(vp-cpy-rr t1 d0) (vp-shr-cr 14 d0) (vp-and-cr +pl_mask d0) (vp-add-rr d0 h3)
	(vp-shr-cr 40 t1) (vp-add-rr t1 h4)
	(vp-cpy-ir ps 112 t1) (vp-add-rr t1 h4)
	;h times r. Number k of the answer is every h i times r k - i, and
	;where that is off the bottom, 5 times the r that many from the top
	(each (lambda (d k)
		(each (lambda (h i)
			(defq slot (* (if (<= i k) (+ 5 (- k i)) (+ 9 (- (+ 5 k) i))) 8))
			(cond
				((= i 0) (vp-cpy-ir ps slot d) (vp-mul-rr h d))
				(:t (vp-cpy-ir ps slot t0) (vp-mul-rr h t0) (vp-add-rr t0 d))))
			hs '(0 1 2 3 4)))
		ds '(0 1 2 3 4))
	;what is above 26 bits of each goes on to the next, and of the last,
	;times 5, to the first
	(each (lambda (d h next)
		(vp-cpy-rr d t0) (vp-shr-cr 26 t0)
		(vp-cpy-rr d h) (vp-and-cr +pl_mask h)
		(if next (vp-add-rr t0 next)))
		ds hs (list d1 d2 d3 d4 :nil))
	(vp-cpy-rr t0 t1) (vp-shl-cr 2 t0) (vp-add-rr t1 t0) (vp-add-rr t0 h0)
	(vp-cpy-rr h0 t0) (vp-shr-cr 26 t0) (vp-and-cr +pl_mask h0) (vp-add-rr t0 h1)
	(vp-add-cr 16 pm)
	(vp-sub-cr 1 pn)
	(vp-jmp 'pl_block)

(vp-label 'pl_done)
	(each (lambda (h) (vp-cpy-ri h ps (* (!) 8))) hs)
	(vp-pop :r0 :r1)
	(class/obj/ref :r1 :r2)

	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly1305-blocks state data offset count top)" +error_msg_wrong_types))
	(signature '(:str :str :NUM :NUM :NUM)))

(def-func-end)

(def-func (path-to-absolute "./gf25519_mul"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r8-:r12
	;info
	;(gf25519-mul o a b) -> o
	;o is a times b, numbers of the field of the prime 2 to the 255 less
	;19, each 16 numbers of 16 bits or so in a nums. o can be a, or b, or
	;both, the answer is made on the stack and then put in o.

	;16 by 16 products, each added in where its two parts say, 31 sums
	;that fit in 64 bits. The top 15 come back in at the bottom 38 times,
	;2 to the 256 is 38 in this field. Then each sum is taken down to 16
	;bits, what is over going on to the next, twice. It is the M of
	;TweetNaCl, as (ed-mul-ref) of lib/crypto/ed25519.inc is in Lisp.
	(vp-rdef (po pa pb pacc pend ai v u w) '(:r8 :r9 :r10 :r11 :r12 :r3 :r4 :r5 :r6))

	(entry '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 3)
	(errorif-lisp-args-match 'error :r1 :nums 3)
	(array-bind-args :r1 `(,po ,pa ,pb))
(errorcase
	(each (lambda (r)
		(assign `((,r +array_length)) '(:r2))
		(gotoif '(:r2 < 16) 'error)) (list po pa pb)))

	(vp-push :r0 po)
	(assign `((,pa +array_begin) (,pb +array_begin)) `(,pa ,pb))
	(vp-alloc 256)
	(vp-xor-rr v v)
	(each (lambda (i) (vp-cpy-ri v :rsp (* i 8))) (range 0 31))
	;the products
	(vp-lea-i :rsp 0 pacc)
	(vp-lea-i pa 128 pend)
(vp-label 'mul_loop)
	(vp-cpy-ir pa 0 ai)
	(each (lambda (j)
		(vp-cpy-ir pb (* j 8) v)
		(vp-mul-rr ai v)
		(vp-cpy-ir pacc (* j 8) u)
		(vp-add-rr v u)
		(vp-cpy-ri u pacc (* j 8))) (range 0 16))
	(vp-add-cr 8 pa)
	(vp-add-cr 8 pacc)
	(vp-bne-rr pend pa 'mul_loop)
	;the top 15 come back in
	(each (lambda (i)
		(vp-cpy-ir :rsp (* (+ i 16) 8) v)
		(vp-mul-cr 38 v)
		(vp-cpy-ir :rsp (* i 8) u)
		(vp-add-rr v u)
		(vp-cpy-ri u :rsp (* i 8))) (range 0 15))
	;each down to 16 bits, twice
	(times 2
		(each (lambda (i)
			(vp-cpy-ir :rsp (* i 8) v)
			(vp-add-cr 65536 v)
			(vp-cpy-rr v u) (vp-asr-cr 16 u)
			(vp-cpy-rr u w) (vp-shl-cr 16 w) (vp-sub-rr w v)
			(vp-cpy-ri v :rsp (* i 8))
			(vp-sub-cr 1 u)
			(cond
				((< i 15)
					(vp-cpy-ir :rsp (* (inc i) 8) v)
					(vp-add-rr u v)
					(vp-cpy-ri v :rsp (* (inc i) 8)))
				(:t (vp-mul-cr 38 u)
					(vp-cpy-ir :rsp 0 v)
					(vp-add-rr u v)
					(vp-cpy-ri v :rsp 0)))) (range 0 16)))
	;and into o
	(vp-cpy-ir :rsp 256 :r1)
	(assign '((:r1 +array_begin)) `(,u))
	(each (lambda (i)
		(vp-cpy-ir :rsp (* i 8) v)
		(vp-cpy-ri v u (* i 8))) (range 0 16))
	(vp-free 256)
	(vp-pop :r0 :r1)
	(class/obj/ref :r1 :r2)

	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gf25519-mul o a b)" +error_msg_wrong_types))
	(signature '(:nums :nums :nums)))

(def-func-end)

(def-func (path-to-absolute "./random_bytes"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :f0-:f15
	;info
	;(random-bytes size) -> str
	;that many bytes from the host's own source of random bytes, which is
	;what a key or a nonce is made from. Not the numbers of (random),
	;which come from a seed and can be worked out.

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)
	(list-bind-args :r1 '(:r2) '(:num))
(errorcase
	(gotoif '(:r2 < 0) 'error))

	(vp-push :r0)
	(call :str :create_from_buffer '(0 :r2) '(:r0))
	(vp-push :r0)
	(assign '((:r0 +str_length)) '(:r1))
	(vp-add-cr +str_data :r0)
	(call :host_os :pii_rand '(:r0 :r1))
	(vp-pop :r1)
	(vp-pop :r0)

	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(random-bytes size)" +error_msg_wrong_types))
	(signature '(:NUM)))

(def-func-end)
