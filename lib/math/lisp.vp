(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "gui/path/class.inc")
(include "class/lisp/class.inc")

;an edge, as lib/math/polygon.inc has it, longs
(structure +pe 0
	(long yt yb xt xb wind set id x0 x1 key))

;the mode, as it has it
(defq +pm_op 3 +pm_mode_a 4 +pm_mode_b 8 +pm_by_middle 16 +pm_goes_on 32 +pe_near 2)

(defun pe-edge (iter e ebase)
	;the edge an entry of active is the place of
	(assign `((,iter 0)) `(,e))
	(vp-mul-cr +pe_size e)
	(vp-add-rr ebase e))

(defun pe-x-at (y yt yb xt xb xlow xhigh d)
	;where an edge is at a y, its ends as they are
	(vp-cpy-rr xt xlow)
	(vpif `(,y /= ,yt))
		(vp-cpy-rr xb xlow)
		(vpif `(,y /= ,yb))
			(vp-cpy-rr y xhigh)
			(vp-sub-rr xt xlow)
			(vp-sub-rr yt xhigh)
			(vp-cpy-rr yb d)
			(vp-mul-rr xhigh xlow)
			(vp-sub-rr yt d)
			(vp-ext-rr xlow xhigh)
			(vp-div-rrr d xhigh xlow)
			(vp-add-rr xt xlow)
		(endif)
	(endif))

(defun pe-wound (wind bit mode in tmp)
	;is a set wound round here by its rule, 0 or 1
	(vp-cpy-rr mode tmp)
	(vp-cpy-rr wind in)
	(vp-and-cr bit tmp)
	(vpif `(,tmp = 0))
		(vp-and-cr 1 in)
	(elseif `(,in /= 0))
		(vp-cpy-cr 1 in)
	(endif))

(defun pe-line (sw a ya b yb id)
	;a line on the end of segs
	(assign `(,a ,ya ,b ,yb ,id)
		`((,sw 0) (,sw ,+long_size) (,sw ,(* 2 +long_size)) (,sw ,(* 3 +long_size)) (,sw ,(* 4 +long_size))))
	(vp-add-cr (* 5 +long_size) sw))

(def-func (path-to-absolute "./poly_band"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(poly-band edges active y0 y1 mode out) -> :nil | out
	;the pieces of the answer in a band of a set op of polygons, see
	;(poly-band) in lib/math/polygon.inc, which this does as that does

	(structure local 0
		(ptr this edges active out optr)
		(long y0 y1 mode inside lx0 lx1 lid))

	(vp-rdef (xlow t xhigh ebase aiter aend y0 y1 e yt yb xt xb witer d))

	(entry `(,xlow ,t))

	(errorif-lisp-args-sig 'error :r1 6)

	(vp-alloc local_size)
	(assign `(,xlow) '((:rsp local_this)))
	(list-bind-args t `(,ebase ,aiter ,y0 ,y1 ,witer ,d) '(:nums :nums :num :num :num :nums))
	(assign `(,ebase ,aiter ,d ,y0 ,y1 ,witer)
		'((:rsp local_edges) (:rsp local_active) (:rsp local_out) (:rsp local_y0) (:rsp local_y1) (:rsp local_mode)))

	;room in out for the most pieces there can be, one to each two edges
	(assign `((,aiter +array_length)) `(,t))
	(vp-mul-cr 3 t)
	(vp-add-cr 6 t)
	(call :array :set_cap `(,d ,t))

	(assign '((:rsp local_edges) (:rsp local_active) (:rsp local_y0) (:rsp local_y1))
		`(,ebase ,aiter ,y0 ,y1))
	(assign `((,aiter +array_length)) `(,aend))
	(assign `((,ebase +array_begin) (,aiter +array_begin)) `(,ebase ,aiter))
	(vp-shl-cr (log2 +long_size) aend)
	(vp-cpy-rr aiter witer)
	(vp-add-rr aiter aend)

	;an edge that ends at or above the top of the band is not in it and
	;goes. Where each of the rest is at the top and the bottom of the
	;band, and what it is ordered by
	(loop-while `(,aiter /= ,aend))
		(pe-edge aiter e ebase)
		(vp-simd vp-cpy-ir `(,e) `(,+pe_yt ,+pe_yb ,+pe_xt ,+pe_xb) `(,yt ,yb ,xt ,xb))
		(vpif `(,yb > ,y0))
			;with +pm_goes_on the band before this ended where this
			;begins, and where an edge that was in it is here is known
			(assign '((:rsp local_mode)) `(,xhigh))
			(vp-and-cr +pm_goes_on xhigh)
			(vpif `(,yt = ,y0))
				(vp-xor-rr xhigh xhigh)
			(endif)
			(vpif `(,xhigh /= 0))
				(assign `((,e +pe_x1)) `(,xlow))
			(else)
				(pe-x-at y0 yt yb xt xb xlow xhigh d)
			(endif)
			(assign `(,xlow) `((,e +pe_x0)))
			(vp-cpy-rr xlow t)
			(pe-x-at y1 yt yb xt xb xlow xhigh d)
			(assign `(,xlow) `((,e +pe_x1)))
			(assign '((:rsp local_mode)) `(,xhigh))
			(vp-and-cr +pm_by_middle xhigh)
			(vpif `(,xhigh /= 0))
				(vp-add-rr xlow t)
			(endif)
			(assign `(,t (,aiter 0)) `((,e +pe_key) ,xhigh))
			(assign `(,xhigh) `((,witer 0)))
			(vp-add-cr +long_size witer)
		(endif)
		(vp-add-cr +long_size aiter)
	(loop-end)
	;how many are left
	(assign '((:rsp local_active)) `(,aiter))
	(vp-cpy-rr witer aend)
	(assign `((,aiter +array_begin)) `(,t))
	(vp-sub-rr t witer)
	(vp-shr-cr (log2 +long_size) witer)
	(assign `(,witer) `((,aiter +array_length)))

	;in order, each put back past those that are after it
	(vp-rdef (kv xv ku ebase abegin aend i j v eu xu))
	(assign '((:rsp local_active)) `(,abegin))
	(assign `((,abegin +array_begin)) `(,abegin))
	(vp-lea-i abegin +long_size i)
	(loop-while `(,i < ,aend))
		(assign `((,i 0)) `(,v))
		(vp-cpy-rr v eu)
		(vp-mul-cr +pe_size eu)
		(vp-add-rr ebase eu)
		(assign `((,eu +pe_key) (,eu +pe_x1)) `(,kv ,xv))
		(vp-cpy-rr i j)
		(loop-while `(,j /= ,abegin) 'back)
			(assign `((,j ,(* -1 +long_size))) `(,eu))
			(vp-mul-cr +pe_size eu)
			(vp-add-rr ebase eu)
			(assign `((,eu +pe_key)) `(,ku))
			(breakif `(,ku < ,kv) 'back)
			(vpif `(,ku = ,kv))
				(assign `((,eu +pe_x1)) `(,xu))
				(breakif `(,xu <= ,xv) 'back)
			(endif)
			(assign `((,j ,(* -1 +long_size))) `(,xu))
			(assign `(,xu) `((,j 0)))
			(vp-sub-cr +long_size j)
		(loop-end)
		(assign `(,v) `((,j 0)))
		(vp-add-cr +long_size i)
	(loop-end)

	;do any cross: is one further left at the bottom than one before it
	(vp-rdef (top x t ebase aiter aend e x0 x1 wa wb px0 px1 mode gid))
	(assign '((:rsp local_mode)) `(,mode))
	(vp-cpy-rr mode t)
	(vp-and-cr +pm_by_middle t)
	(vpif `(,t = 0))
		(vp-cpy-cr +min_long top)
		(loop-while `(,aiter /= ,aend))
			(pe-edge aiter e ebase)
			(assign `((,e +pe_x1)) `(,x))
			(gotoif `(,x < ,top) 'cross)
			(vp-cpy-rr x top)
			(vp-add-cr +long_size aiter)
		(loop-end)
		(assign '((:rsp local_active)) `(,aiter))
		(assign `((,aiter +array_begin)) `(,aiter))
	(endif)

	;go along them, counting how each set is wound round, and where what
	;is asked for begins and ends is a piece
	(vp-rdef (gx0 gx1 t ebase aiter aend e x0 x1 wa wb px0 px1 mode gid))
	(assign '((:rsp local_out)) `(,t))
	(assign `((,t +array_begin)) `(,t))
	(vp-xor-rr wa wa)
	(vp-xor-rr wb wb)
	(assign `(,t ,wa) '((:rsp local_optr) (:rsp local_inside)))
	(vp-cpy-cr +min_long px0)
	(vp-cpy-cr -1 gid)
	(vp-cpy-rr px0 px1)
	(loop-while `(,aiter /= ,aend))
		(pe-edge aiter e ebase)
		(assign `((,e +pe_x0) (,e +pe_x1)) `(,x0 ,x1))
		;none is to the left of the one before it, at either end
		(vp-max-rr px0 x0)
		(vp-max-rr px1 x1)
		(vp-cpy-rr x0 px0)
		(vp-cpy-rr x1 px1)
		(vpif `(,gid >= 0))
			(vp-cpy-rr x0 t)
			(vp-sub-rr gx0 t)
			(vpif `(,t <= ,+pe_near))
				(vp-cpy-rr x1 t)
				(vp-sub-rr gx1 t)
				(vpif `(,t <= ,+pe_near))
					;one edge with the last
					(assign `((,e +pe_id)) `(,t))
					(vp-min-rr t gid)
					(goto 'wind)
				(endif)
			(endif)
			;is what is wound round here in the answer. x0 and x1 are
			;kept in px0 and px1, and are used to work it out in
			(pe-wound wa +pm_mode_a mode x0 t)
			(pe-wound wb +pm_mode_b mode x1 t)
			(vp-cpy-rr mode t)
			(vp-and-cr +pm_op t)
			(vpif `(,t = 0))
				(vp-or-rr x1 x0)
			(elseif `(,t = 1))
				(vp-and-rr x1 x0)
			(elseif `(,t = 2))
				(vp-xor-cr 1 x1)
				(vp-and-rr x1 x0)
			(else)
				(vp-xor-rr x1 x0)
			(endif)
			(assign '((:rsp local_inside)) `(,t))
			(vpif `(,x0 /= ,t))
				(assign `(,x0) '((:rsp local_inside)))
				(vpif `(,x0 /= 0))
					;it begins
					(assign `(,gx0 ,gx1 ,gid) '((:rsp local_lx0) (:rsp local_lx1) (:rsp local_lid)))
				(else)
					;it ends, a piece
					(assign '((:rsp local_optr) (:rsp local_lx0)) `(,t ,x0))
					(assign '((:rsp local_lx1)) `(,x1))
					(assign `(,x0 ,x1 ,gx0 ,gx1) `((,t 0) (,t ,+long_size) (,t ,(* 2 +long_size)) (,t ,(* 3 +long_size))))
					(assign '((:rsp local_lid)) `(,x0))
					(assign `(,x0 ,gid) `((,t ,(* 4 +long_size)) (,t ,(* 5 +long_size))))
					(vp-add-cr (* 6 +long_size) t)
					(assign `(,t) '((:rsp local_optr)))
				(endif)
			(endif)
			(vp-cpy-rr px0 x0)
			(vp-cpy-rr px1 x1)
		(endif)
		;an edge that is not one with the last begins the next
		(vp-cpy-rr x0 gx0)
		(vp-cpy-rr x1 gx1)
		(assign `((,e +pe_id)) `(,gid))
	(vp-label 'wind)
		(assign `((,e +pe_wind) (,e +pe_set)) `(,t ,x0))
		(vpif `(,x0 = 0))
			(vp-add-rr t wa)
		(else)
			(vp-add-rr t wb)
		(endif)
		(vp-add-cr +long_size aiter)
	(loop-end)

	;after the last edge nothing is wound round, so a piece that is open ends at it
	(assign '((:rsp local_optr) (:rsp local_inside)) `(,t ,x0))
	(vpif `(,gid >= 0) `(,x0 /= 0))
		(assign '((:rsp local_lx0) (:rsp local_lx1)) `(,x0 ,x1))
		(assign `(,x0 ,x1 ,gx0 ,gx1) `((,t 0) (,t ,+long_size) (,t ,(* 2 +long_size)) (,t ,(* 3 +long_size))))
		(assign '((:rsp local_lid)) `(,x0))
		(assign `(,x0 ,gid) `((,t ,(* 4 +long_size)) (,t ,(* 5 +long_size))))
		(vp-add-cr (* 6 +long_size) t)
	(endif)

	;how many numbers that is, and out is what comes back
	(vp-rdef (this out t len))
	(assign '((:rsp local_out) (:rsp local_this)) `(,out ,this))
	(assign `((,out +array_begin)) `(,len))
	(vp-sub-rr len t)
	(vp-shr-cr (log2 +long_size) t)
	(assign `(,t) `((,out +array_length)))
	(class/obj/ref out t)
	(vp-free local_size)
	(exit `(,this ,out))
	(vp-ret)

(vp-label 'cross)
	;some cross, nothing is made
	(assign '((:rsp local_this)) '(:r0))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-band edges active y0 y1 mode out)" +error_msg_wrong_types))
	(signature '(:nums :nums :num :num :num :nums)))

(def-func-end)

(def-func (path-to-absolute "./poly_cuts"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(poly-cuts edges active ya yb cuts) -> cuts
	;the ys within a band at which two of its edges cross, put on the end
	;of cuts, see (poly-cuts-ref) in lib/math/polygon.inc

	(structure local 0
		(ptr this cuts))

	(vp-rdef (xlow elm xhigh x3 den t ebase iiter jiter aend ya yb x0 x1 e))

	(entry `(,xlow ,elm))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-alloc local_size)
	(assign `(,xlow) '((:rsp local_this)))
	(list-bind-args elm `(,ebase ,iiter ,ya ,yb ,t) '(:nums :nums :num :num :nums))
	(assign `(,t) '((:rsp local_cuts)))
	(assign `((,iiter +array_length)) `(,aend))
	(assign `((,ebase +array_begin) (,iiter +array_begin)) `(,ebase ,iiter))
	(vp-shl-cr (log2 +long_size) aend)
	(vp-add-rr iiter aend)

	;each with each that is after it across the top
	(loop-while `(,iiter /= ,aend))
		(pe-edge iiter e ebase)
		(assign `((,e +pe_x0) (,e +pe_x1)) `(,x0 ,x1))
		(vp-lea-i iiter +long_size jiter)
		(loop-while `(,jiter /= ,aend))
			(pe-edge jiter e ebase)
			(assign `((,e +pe_x1)) `(,x3))
			(vpif `(,x1 > ,x3))
				;they cross: as far down the band as the gap at its top is of
				;the gap at its top and the gap, the other way, at its bottom
				(assign `((,e +pe_x0)) `(,xlow))
				(vp-cpy-rr x1 den)
				(vp-sub-rr x0 xlow)
				(vp-sub-rr x3 den)
				(vp-cpy-rr yb t)
				(vp-add-rr xlow den)
				(vp-sub-rr ya t)
				(vp-mul-rr t xlow)
				(vp-ext-rr xlow xhigh)
				(vp-div-rrr den xhigh xlow)
				(vp-add-rr ya xlow)
				(vpif `(,xlow > ,ya) `(,xlow < ,yb))
					(vp-cpy-rr xlow elm)
					(assign '((:rsp local_cuts)) `(,xlow))
					(call :array :push_back `(,xlow ,elm))
				(endif)
			(endif)
			(vp-add-cr +long_size jiter)
		(loop-end)
		(vp-add-cr +long_size iiter)
	(loop-end)

	(assign '((:rsp local_this) (:rsp local_cuts)) '(:r0 :r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-cuts edges active ya yb cuts)" +error_msg_wrong_types))
	(signature '(:nums :nums :num :num :nums)))

(def-func-end)

(def-func (path-to-absolute "./poly_lines"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(poly-lines out y0 y1 above below segs openl openr) -> below
	;the lines of the pieces of a band, see (poly-lines-ref) in
	;lib/math/polygon.inc, which this does as that does

	(structure local 0
		(ptr this out above below segs openl openr)
		(long y0 y1))

	(vp-rdef (a b id i t sbase sw oiter oend y0 y1 ol or bw))

	(entry `(,a ,b))

	(errorif-lisp-args-sig 'error :r1 8)

	(vp-alloc local_size)
	(assign `(,a) '((:rsp local_this)))
	(list-bind-args b `(,oiter ,y0 ,y1 ,i ,bw ,sbase ,ol ,or) '(:nums :num :num :nums :nums :nums :nums :nums))
	(assign `(,oiter ,y0 ,y1 ,i ,bw ,sbase ,ol ,or)
		'((:rsp local_out) (:rsp local_y0) (:rsp local_y1) (:rsp local_above) (:rsp local_below)
		(:rsp local_segs) (:rsp local_openl) (:rsp local_openr)))

	;room in below for the bottom of each piece
	(assign `((,oiter +array_length)) `(,b))
	(vp-add-cr 6 b)
	(call :array :set_cap `(,bw ,b))
	;and in segs for the two sides of each, and a line across for each
	;end of a piece of this band and of the band above
	(assign '((:rsp local_out) (:rsp local_above) (:rsp local_segs)) `(,oiter ,i ,a))
	(assign `((,oiter +array_length) (,i +array_length) (,a +array_length)) `(,b ,i ,t))
	(vp-mul-cr 4 b)
	(vp-mul-cr 5 i)
	(vp-add-rr t b)
	(vp-add-rr i b)
	(vp-add-cr 10 b)
	(call :array :set_cap `(,a ,b))

	(assign '((:rsp local_out) (:rsp local_y0) (:rsp local_y1) (:rsp local_below) (:rsp local_segs)
		(:rsp local_openl) (:rsp local_openr)) `(,oiter ,y0 ,y1 ,bw ,sbase ,ol ,or))
	(assign `((,oiter +array_length) (,sbase +array_length)) `(,oend ,sw))
	(assign `((,oiter +array_begin) (,sbase +array_begin) (,bw +array_begin) (,ol +array_begin) (,or +array_begin))
		`(,oiter ,sbase ,bw ,ol ,or))
	(vp-shl-cr (log2 +long_size) oend)
	(vp-shl-cr (log2 +long_size) sw)
	(vp-add-rr oiter oend)
	(vp-add-rr sbase sw)

	;down the left of each piece and up its right
	(loop-while `(,oiter /= ,oend))
		(assign `((,oiter 0) (,oiter ,+long_size) (,oiter ,(* 4 +long_size))) `(,a ,b ,id))
		(assign `(,b) `((,bw 0)))
		(vp-shl-cr (log2 +long_size) id)
		(assign `((,ol ,id)) `(,i))
		(vpif `(,i >= 0) 'left)
			;the left of this edge in the band above: does this go on from it
			(vp-shl-cr (log2 +long_size) i)
			(vp-add-rr sbase i)
			(assign `((,i ,(* 2 +long_size))) `(,t))
			(vpif `(,t = ,a))
				(assign `((,i ,(* 3 +long_size))) `(,t))
				(vpif `(,t = ,y0))
					(assign `(,b ,y1) `((,i ,(* 2 +long_size)) (,i ,(* 3 +long_size))))
					(goto 'left_done)
				(endif)
			(endif)
		(endif)
		(vp-cpy-rr sw t)
		(vp-sub-rr sbase t)
		(vp-shr-cr (log2 +long_size) t)
		(assign `(,t) `((,ol ,id)))
		(vp-shr-cr (log2 +long_size) id)
		(pe-line sw a y0 b y1 id)
	(vp-label 'left_done)
		(assign `((,oiter ,(* 2 +long_size)) (,oiter ,(* 3 +long_size)) (,oiter ,(* 5 +long_size))) `(,a ,b ,id))
		(assign `(,b) `((,bw ,+long_size)))
		(vp-add-cr (* 2 +long_size) bw)
		(vp-shl-cr (log2 +long_size) id)
		(assign `((,or ,id)) `(,i))
		(vpif `(,i >= 0) 'right)
			(vp-shl-cr (log2 +long_size) i)
			(vp-add-rr sbase i)
			(assign `((,i 0)) `(,t))
			(vpif `(,t = ,a))
				(assign `((,i ,+long_size)) `(,t))
				(vpif `(,t = ,y0))
					(assign `(,b ,y1) `((,i 0) (,i ,+long_size)))
					(goto 'right_done)
				(endif)
			(endif)
		(endif)
		(vp-cpy-rr sw t)
		(vp-sub-rr sbase t)
		(vp-shr-cr (log2 +long_size) t)
		(assign `(,t) `((,or ,id)))
		(vp-shr-cr (log2 +long_size) id)
		(pe-line sw b y1 a y0 id)
	(vp-label 'right_done)
		(vp-add-cr (* 6 +long_size) oiter)
	(loop-end)

	;how long below is now
	(assign '((:rsp local_below)) `(,t))
	(assign `((,t +array_begin)) `(,i))
	(vp-sub-rr i bw)
	(vp-shr-cr (log2 +long_size) bw)
	(assign `(,bw) `((,t +array_length)))

	;across: the ends of what is above and of the tops of these, each in
	;order, taken the least first
	(vp-rdef (xa xb x px t sbase sw oiter oend y0 step aiter aend ia ib))
	(assign '((:rsp local_out) (:rsp local_above)) `(,oiter ,aiter))
	(assign `((,aiter +array_length)) `(,aend))
	(assign `((,oiter +array_begin) (,aiter +array_begin)) `(,oiter ,aiter))
	(vp-shl-cr (log2 +long_size) aend)
	(vp-xor-rr ia ia)
	(vp-xor-rr ib ib)
	(vp-xor-rr px px)
	(vp-add-rr aiter aend)
	(vp-cpy-cr (* 2 +long_size) step)
	(loop-start 'across)
		(vp-cpy-cr +max_long xa)
		(vp-cpy-cr +max_long xb)
		(vpif `(,aiter /= ,aend))
			(assign `((,aiter 0)) `(,xa))
		(endif)
		(vpif `(,oiter /= ,oend))
			(assign `((,oiter 0)) `(,xb))
		(elseif `(,aiter = ,aend))
			(goto 'across_done)
		(endif)
		(vp-cpy-rr xa x)
		(vp-min-rr xb x)
		(vpif `(,x > ,px))
			(vpif `(,ia /= ,ib))
				(vpif `(,ia /= 0))
					;above and not below, a bottom, left to right
					(vp-cpy-cr -1 t)
					(pe-line sw px y0 x y0 t)
				(else)
					;below and not above, a top, right to left
					(vp-cpy-cr -1 t)
					(pe-line sw x y0 px y0 t)
				(endif)
			(endif)
		(endif)
		(vpif `(,xa <= ,xb))
			(vp-xor-cr 1 ia)
			(vp-add-cr +long_size aiter)
		(else)
			(vp-xor-cr 1 ib)
			(vp-add-rr step oiter)
			(vp-xor-cr (* 6 +long_size) step)
		(endif)
		(vp-cpy-rr x px)
	(loop-end)
(vp-label 'across_done)

	;how long segs is now, and below is what comes back
	(assign '((:rsp local_segs)) `(,t))
	(vp-sub-rr sbase sw)
	(vp-shr-cr (log2 +long_size) sw)
	(assign `(,sw) `((,t +array_length)))
	(assign '((:rsp local_this) (:rsp local_below)) '(:r0 :r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-lines out y0 y1 above below segs openl openr)" +error_msg_wrong_types))
	(signature '(:nums :num :num :nums :nums :nums :nums :nums)))

(def-func-end)

(defun pr-bases (sbase head nxt used ring t u)
	;where the lines begin, and the four parts of the room that was got:
	;the first line of each bucket, the next line of each line, is a line
	;used, and the points of the ring being walked
	(assign '((:rsp local_segs) (:rsp local_mem) (:rsp local_mask) (:rsp local_n)) `(,sbase ,head ,t ,u))
	(assign `((,sbase +array_begin)) `(,sbase))
	(vp-add-cr 1 t)
	(vp-shl-cr (log2 +long_size) t)
	(vp-shl-cr (log2 +long_size) u)
	(vp-cpy-rr head nxt)
	(vp-add-rr t nxt)
	(vp-cpy-rr nxt used)
	(vp-add-rr u used)
	(vp-cpy-rr used ring)
	(vp-add-rr u ring))

(defun pr-hash (x y h tmp)
	;the bucket a point is in, as how far into the buckets it is
	(vp-cpy-rr x h)
	(vp-cpy-rr x tmp)
	(vp-shr-cr 16 tmp)
	(vp-xor-rr tmp h)
	(vp-cpy-rr y tmp)
	(vp-shl-cr 5 tmp)
	(vp-xor-rr tmp h)
	(vp-cpy-rr y tmp)
	(vp-shr-cr 11 tmp)
	(vp-xor-rr tmp h)
	(assign '((:rsp local_mask)) `(,tmp))
	(vp-and-rr tmp h)
	(vp-shl-cr (log2 +long_size) h))

(def-func (path-to-absolute "./poly_rings"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(poly-rings segs) -> paths
	;the lines of all the bands joined end to start into rings, see
	;(poly-rings-ref) in lib/math/polygon.inc, which this does as that
	;does, and gives each as a path. A line is found by where it starts
	;in buckets, the last put in a bucket the first found there

	(structure local 0
		(ptr this segs out mem scratch newp)
		(long n mask s bytes))

	(vp-rdef (a b sbase head nxt used ring i j t u x y cnt idl))

	(entry `(,a ,b))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc local_size)
	(assign `(,a) '((:rsp local_this)))
	(list-bind-args b `(,sbase) '(:nums))
	(assign `(,sbase) '((:rsp local_segs)))

	;how many lines, 5 numbers each, and a number of buckets that is
	;twice that or more, and 1 2 4 8 ...
	(assign `((,sbase +array_length)) `(,i))
	(vp-cpy-cr 5 t)
	(vp-ext-rr i u)
	(vp-div-rrr t u i)
	(assign `(,i) '((:rsp local_n)))
	(vp-cpy-cr 16 j)
	(vp-cpy-rr i t)
	(vp-shl-cr 1 t)
	(loop-while `(,j < ,t))
		(vp-shl-cr 1 j)
	(loop-end)
	(vp-cpy-rr j t)
	(vp-sub-cr 1 t)
	(assign `(,t) '((:rsp local_mask)))
	;room: the buckets, and for each line its next, is it used, the two
	;numbers of a point, and those again for the ring made tidy
	(vp-mul-cr 6 i)
	(vp-add-rr i j)
	(vp-shl-cr (log2 +long_size) j)
	(call :sys_mem :calloc `(,j) '(:r0 _))
	(assign '(:r0) '((:rsp local_mem)))
	(call :list :create :nil '(:r0))
	(assign '(:r0) '((:rsp local_out)))

	;each line into the bucket of where it starts
	(pr-bases sbase head nxt used ring t u)
	(vp-xor-rr i i)
	(assign '((:rsp local_n)) `(,cnt))
	(vp-cpy-rr sbase j)
	(loop-while `(,i /= ,cnt))
		(assign `((,j 0) (,j ,+long_size)) `(,x ,y))
		(pr-hash x y t u)
		(assign `((,head ,t)) `(,u))
		(vp-cpy-rr i x)
		(vp-shl-cr (log2 +long_size) x)
		(assign `(,u) `((,nxt ,x)))
		(vp-cpy-rr i u)
		(vp-add-cr 1 u)
		(assign `(,u) `((,head ,t)))
		(vp-add-cr 1 i)
		(vp-add-cr (* 5 +long_size) j)
	(loop-end)

	;from each line not yet used, round till no line goes on
	(vp-xor-rr i i)
	(assign `(,i) '((:rsp local_s)))
	(loop-start 'rings)
		(assign '((:rsp local_s) (:rsp local_n)) `(,i ,t))
		(gotoif `(,i = ,t) 'done)
		(vp-cpy-rr i t)
		(vp-add-cr 1 t)
		(assign `(,t) '((:rsp local_s)))
		(pr-bases sbase head nxt used ring t u)
		(vp-cpy-rr i t)
		(vp-shl-cr (log2 +long_size) t)
		(assign `((,used ,t)) `(,u))
		(vpif `(,u = 0))
			(vp-xor-rr cnt cnt)
			(vp-cpy-rr ring b)
			(loop-start 'walk)
				(vp-cpy-rr i t)
				(vp-shl-cr (log2 +long_size) t)
				(vp-cpy-cr 1 u)
				(assign `(,u) `((,used ,t)))
				(vp-cpy-rr i j)
				(vp-mul-cr (* 5 +long_size) j)
				(vp-add-rr sbase j)
				(assign `((,j ,(* 4 +long_size))) `(,u))
				;a point, unless this goes on along the line before it
				(vpif `(,cnt = 0))
					(vp-cpy-rr u a)
					(vp-cpy-rr u idl)
					(vp-xor-cr 1 idl)
				(endif)
				(vpif `(,u /= ,idl))
					(assign `((,j 0) (,j ,+long_size)) `(,x ,y))
					(assign `(,x ,y) `((,b 0) (,b ,+long_size)))
					(vp-add-cr (* 2 +long_size) b)
					(vp-add-cr 1 cnt)
					(vp-cpy-rr u idl)
				(endif)
				;the line that starts where this ends, not yet used
				(assign `((,j ,(* 2 +long_size)) (,j ,(* 3 +long_size))) `(,x ,y))
				(pr-hash x y t u)
				(assign `((,head ,t)) `(,t))
				(vp-cpy-cr -1 i)
				(loop-while `(,t /= 0))
					(vp-sub-cr 1 t)
					(vp-cpy-rr t u)
					(vp-shl-cr (log2 +long_size) u)
					(assign `((,used ,u)) `(,j))
					(vpif `(,j = 0))
						(vp-cpy-rr t j)
						(vp-mul-cr (* 5 +long_size) j)
						(vp-add-rr sbase j)
						(assign `((,j 0)) `(,ring))
						(vpif `(,ring = ,x))
							(assign `((,j ,+long_size)) `(,ring))
							(vpif `(,ring = ,y))
								(vp-cpy-rr t i)
								(goto 'found)
							(endif)
						(endif)
					(endif)
					(assign `((,nxt ,u)) `(,t))
				(loop-end)
			(vp-label 'found)
				(gotoif `(,i < 0) 'walked)
			(loop-end)
		(vp-label 'walked)
			;its points begin here. Round to its start, the last may go on
			;along the first
			(assign '((:rsp local_n)) `(,t))
			(vp-shl-cr (log2 +long_size) t)
			(vp-cpy-rr used ring)
			(vp-add-rr t ring)
			(vp-cpy-rr ring j)
			(vpif `(,cnt > 1))
				(vpif `(,a = ,idl))
					(vp-add-cr (* 2 +long_size) j)
					(vp-sub-cr 1 cnt)
				(endif)
			(endif)
			;made tidy, after the room for the points: a point that is on
			;the line from the one before it to the one after it is not a
			;corner, two edges that lay along each other met there
			(vp-shl-cr 1 t)
			(vp-cpy-rr ring head)
			(vp-add-rr t head)
			(vp-cpy-rr head b)
			(vp-cpy-rr cnt t)
			(vp-shl-cr (log2 (* 2 +long_size)) t)
			(vp-add-rr j t)
			(vp-cpy-rr t u)
			(vp-sub-cr (* 2 +long_size) u)
			(vp-cpy-rr j i)
			(loop-while `(,i /= ,t))
				(vp-cpy-rr i nxt)
				(vp-add-cr (* 2 +long_size) nxt)
				(vpif `(,nxt = ,t))
					(vp-cpy-rr j nxt)
				(endif)
				(assign `((,i 0) (,u 0) (,nxt ,+long_size) (,u ,+long_size)) `(,x ,a ,y ,idl))
				(vp-sub-rr a x)
				(vp-sub-rr idl y)
				(vp-mul-rr y x)
				(assign `((,i ,+long_size) (,nxt 0)) `(,y ,used))
				(vp-sub-rr idl y)
				(vp-sub-rr a used)
				(vp-mul-rr used y)
				(vpif `(,x /= ,y))
					(assign `((,i 0) (,i ,+long_size)) `(,x ,y))
					(assign `(,x ,y) `((,b 0) (,b ,+long_size)))
					(vp-add-cr (* 2 +long_size) b)
				(endif)
				(vp-cpy-rr i u)
				(vp-add-cr (* 2 +long_size) i)
			(loop-end)
			;three corners or more and it is a ring, a path of them
			(vp-sub-rr head b)
			(vpif `(,b >= ,(* 6 +long_size)))
				(assign `(,b ,head) '((:rsp local_bytes) (:rsp local_scratch)))
				(call :path :create :nil '(:r0))
				(assign '((:rsp local_bytes)) '(:r1))
				(vp-shr-cr (log2 +long_size) :r1)
				(call :array :set_cap '(:r0 :r1) '(:r0))
				(assign '(:r0) '((:rsp local_newp)))
				(assign '((:rsp local_bytes)) '(:r2))
				(vp-cpy-rr :r2 :r1)
				(vp-shr-cr (log2 +long_size) :r1)
				(assign '(:r1) '((:r0 +array_length)))
				(assign '((:r0 +array_begin) (:rsp local_scratch)) '(:r1 :r0))
				(call :sys_mem :copy '(:r0 :r1 :r2))
				(call :list :push_back '((:rsp local_out) (:rsp local_newp)))
			(endif)
		(endif)
	(loop-end)
(vp-label 'done)

	(call :sys_mem :free '((:rsp local_mem)))
	(assign '((:rsp local_this) (:rsp local_out)) '(:r0 :r1))
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-rings segs)" +error_msg_wrong_types))
	(signature '(:nums)))

(def-func-end)

(defun ps-copy (from to)
	;numbers from one place to another, till the first is at to
	(loop-while `(,from /= ,to))
		(assign `((,from 0)) '(:r13))
		(assign '(:r13) '((:r11 0)))
		(vp-add-cr +long_size from)
		(vp-add-cr +long_size :r11)
	(loop-end))

(defun ps-sort ()
	;inputs
	;:r0 = the records (ptr)
	;:r1 = how many bytes of them (bytes)
	;:r2 = the size of one (bytes)
	;:r3 = room for as many (ptr)
	;trashes
	;:r1-:r13
	;info
	;put in order by the first number of each, the least first, those
	;that are the same left in the order they were in. Runs of 1 2 4 ...
	;are merged from the one place to the other and back
	(vp-rdef (base total rec dst src width i l le r re d t u))
	(vp-cpy-rr base src)
	(vp-cpy-rr rec width)
	(loop-while `(,width < ,total))
		(vp-xor-rr i i)
		(loop-while `(,i < ,total))
			(vp-cpy-rr src l)
			(vp-add-rr i l)
			(vp-cpy-rr dst d)
			(vp-add-rr i d)
			(vp-add-rr width i)
			(vp-cpy-rr i t)
			(vpif `(,t > ,total))
				(vp-cpy-rr total t)
			(endif)
			(vp-cpy-rr src le)
			(vp-add-rr t le)
			(vp-cpy-rr le r)
			(vp-add-rr width i)
			(vp-cpy-rr i t)
			(vpif `(,t > ,total))
				(vp-cpy-rr total t)
			(endif)
			(vp-cpy-rr src re)
			(vp-add-rr t re)
			(loop-start)
				(breakif `(,l = ,le) `(,r = ,re))
				(assign `((,l 0) (,r 0)) `(,t ,u))
				(vpif `(,u < ,t))
					(vp-cpy-rr r t)
					(vp-add-rr rec t)
					(ps-copy r t)
				(else)
					(vp-cpy-rr l t)
					(vp-add-rr rec t)
					(ps-copy l t)
				(endif)
			(loop-end)
			(ps-copy l le)
			(ps-copy r re)
		(loop-end)
		(vp-cpy-rr src t)
		(vp-cpy-rr dst src)
		(vp-cpy-rr t dst)
		(vp-shl-cr 1 width)
	(loop-end)
	(vpif `(,src /= ,base))
		(vp-cpy-rr base d)
		(vp-cpy-rr src le)
		(vp-add-rr total le)
		(ps-copy src le)
	(endif)
	(vp-ret))

(def-func (path-to-absolute "./poly_setup"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :f0-:f15
	;info
	;(poly-setup a b edges ys openl openr) -> edges
	;what (poly-segs) in lib/math/polygon.inc starts from. a and b are
	;lists of paths. edges is made the edges of both, those that lie flat
	;left out, the highest first, and those that start at the same height
	;in the order they are met, each with its place for a number. ys is
	;made every height a point is at, the least first, each once. openl
	;and openr are made a -1 for each edge

	(structure local 0
		(ptr this a b edges ys openl openr mem)
		(long points))

	(vp-rdef (set iter end pi pe x0 y0 x1 y1 eptr yptr t))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7) '(:list :list :nums :nums :nums :nums))
	(assign '(:r2 :r3 :r4 :r5 :r6 :r7)
		'((:rsp local_a) (:rsp local_b) (:rsp local_edges) (:rsp local_ys) (:rsp local_openl) (:rsp local_openr)))

	;how many points there are, there are no more edges than that
	(vp-xor-rr x0 x0)
	(vp-xor-rr set set)
	(loop-start)
		(assign '((:rsp local_a)) `(,iter))
		(vpif `(,set /= 0))
			(assign '((:rsp local_b)) `(,iter))
		(endif)
		(assign `((,iter +array_length)) `(,end))
		(assign `((,iter +array_begin)) `(,iter))
		(vp-shl-cr (log2 +long_size) end)
		(vp-add-rr iter end)
		(loop-while `(,iter /= ,end))
			(assign `((,iter 0)) `(,pi))
			(assign `((,pi +array_length)) `(,pi))
			(vp-add-rr pi x0)
			(vp-add-cr +long_size iter)
		(loop-end)
		(vp-add-cr 1 set)
	(loop-until `(,set = 2))
	(vp-shr-cr 1 x0)
	(assign `(,x0) '((:rsp local_points)))

	;room for them
	(vp-cpy-rr x0 :r1)
	(vp-mul-cr +pe_size :r1)
	(vp-add-cr +long_size :r1)
	(call :sys_mem :alloc '(:r1) '(:r0 _))
	(assign '(:r0) '((:rsp local_mem)))
	(assign '((:rsp local_points)) '(:r1))
	(vp-mul-cr (/ +pe_size +long_size) :r1)
	(call :array :set_cap '((:rsp local_edges) :r1))
	(call :array :set_cap '((:rsp local_ys) (:rsp local_points)))
	(call :array :set_cap '((:rsp local_openl) (:rsp local_points)))
	(call :array :set_cap '((:rsp local_openr) (:rsp local_points)))

	;the edges and the heights, as they are met
	(assign '((:rsp local_edges) (:rsp local_ys)) `(,eptr ,yptr))
	(assign `((,eptr +array_begin) (,yptr +array_begin)) `(,eptr ,yptr))
	(vp-xor-rr set set)
	(loop-start)
		(assign '((:rsp local_a)) `(,iter))
		(vpif `(,set /= 0))
			(assign '((:rsp local_b)) `(,iter))
		(endif)
		(assign `((,iter +array_length)) `(,end))
		(assign `((,iter +array_begin)) `(,iter))
		(vp-shl-cr (log2 +long_size) end)
		(vp-add-rr iter end)
		(loop-while `(,iter /= ,end))
			(assign `((,iter 0)) `(,pi))
			(vp-add-cr +long_size iter)
			(assign `((,pi +array_length)) `(,pe))
			(vpif `(,pe >= 6))
				(assign `((,pi +array_begin)) `(,pi))
				(vp-shl-cr (log2 +long_size) pe)
				(vp-add-rr pi pe)
				(assign `((,pe ,(neg (* 2 +long_size))) (,pe ,(neg +long_size))) `(,x0 ,y0))
				(loop-start)
					(assign `((,pi 0) (,pi ,+long_size)) `(,x1 ,y1))
					(vp-add-cr (* 2 +long_size) pi)
					(assign `(,y1) `((,yptr 0)))
					(vp-add-cr +long_size yptr)
					(vpif `(,y0 /= ,y1))
						(vpif `(,y0 < ,y1))
							(vp-cpy-cr 1 t)
							(assign `(,y0 ,y1 ,x0 ,x1 ,t)
								`((,eptr +pe_yt) (,eptr +pe_yb) (,eptr +pe_xt) (,eptr +pe_xb) (,eptr +pe_wind)))
						(else)
							(vp-cpy-cr -1 t)
							(assign `(,y1 ,y0 ,x1 ,x0 ,t)
								`((,eptr +pe_yt) (,eptr +pe_yb) (,eptr +pe_xt) (,eptr +pe_xb) (,eptr +pe_wind)))
						(endif)
						(vp-xor-rr t t)
						(assign `(,set ,t ,t ,t ,t)
							`((,eptr +pe_set) (,eptr +pe_id) (,eptr +pe_x0) (,eptr +pe_x1) (,eptr +pe_key)))
						(vp-add-cr +pe_size eptr)
					(endif)
					(vp-cpy-rr x1 x0)
					(vp-cpy-rr y1 y0)
				(loop-until `(,pi = ,pe))
			(endif)
		(loop-end)
		(vp-add-cr 1 set)
	(loop-until `(,set = 2))

	;how much of each, and each put in order
	(assign '((:rsp local_edges) (:rsp local_ys)) `(,x0 ,x1))
	(assign `((,x0 +array_begin) (,x1 +array_begin)) `(,y0 ,y1))
	(vp-sub-rr y0 eptr)
	(vp-sub-rr y1 yptr)
	(vp-cpy-rr eptr t)
	(vp-shr-cr (log2 +long_size) t)
	(assign `(,t) `((,x0 +array_length)))
	(vp-cpy-rr yptr t)
	(vp-shr-cr (log2 +long_size) t)
	(assign `(,t) `((,x1 +array_length)))
	(assign `(,y0 ,eptr ,+pe_size (:rsp local_mem)) '(:r0 :r1 :r2 :r3))
	(vp-call 'sort)
	(assign '((:rsp local_ys)) '(:r0))
	(assign '((:r0 +array_length) (:r0 +array_begin) (:rsp local_mem)) '(:r1 :r0 :r3))
	(vp-shl-cr (log2 +long_size) :r1)
	(vp-cpy-cr +long_size :r2)
	(vp-call 'sort)

	;each edge its number, and a -1 each for it
	(assign '((:rsp local_edges) (:rsp local_openl) (:rsp local_openr)) `(,x0 ,x1 ,y1))
	(assign `((,x0 +array_length) (,x0 +array_begin)) `(,end ,iter))
	(vp-shl-cr (log2 +long_size) end)
	(vp-add-rr iter end)
	(assign `((,x1 +array_begin) (,y1 +array_begin)) `(,pi ,pe))
	(vp-xor-rr set set)
	(vp-cpy-cr -1 t)
	(loop-while `(,iter /= ,end))
		(assign `(,set ,t ,t) `((,iter +pe_id) (,pi 0) (,pe 0)))
		(vp-add-cr 1 set)
		(vp-add-cr +pe_size iter)
		(vp-add-cr +long_size pi)
		(vp-add-cr +long_size pe)
	(loop-end)
	(assign `(,set ,set) `((,x1 +array_length) (,y1 +array_length)))

	;each height once
	(assign '((:rsp local_ys)) `(,x0))
	(assign `((,x0 +array_length) (,x0 +array_begin)) `(,end ,iter))
	(vpif `(,end /= 0))
		(vp-shl-cr (log2 +long_size) end)
		(vp-add-rr iter end)
		(vp-cpy-rr iter pi)
		(assign `((,iter 0)) `(,y0))
		(vp-add-cr +long_size iter)
		(vp-add-cr +long_size pi)
		(loop-while `(,iter /= ,end))
			(assign `((,iter 0)) `(,y1))
			(vp-add-cr +long_size iter)
			(vpif `(,y1 /= ,y0))
				(assign `(,y1) `((,pi 0)))
				(vp-add-cr +long_size pi)
				(vp-cpy-rr y1 y0)
			(endif)
		(loop-end)
		(assign `((,x0 +array_begin)) `(,iter))
		(vp-sub-rr iter pi)
		(vp-shr-cr (log2 +long_size) pi)
		(assign `(,pi) `((,x0 +array_length)))
	(endif)

	(call :sys_mem :free '((:rsp local_mem)))
	(assign '((:rsp local_this) (:rsp local_edges)) '(:r0 :r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'sort)
	(ps-sort)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-setup a b edges ys openl openr)" +error_msg_wrong_types))
	(signature '(:list :list :nums :nums :nums :nums)))

(def-func-end)

(defun pc-push (lst &rest objs)
	;objects put on the end of a list of arguments, each held once more
	(each (lambda (obj)
		(assign `((:rsp ,obj)) '(:r1))
		(class/obj/ref :r1 :r2)
		(call :list :push_back `((:rsp ,lst) :r1))) objs))

(defun pc-made (lst &rest objs)
	;as (pc-push), of objects just made, which the list is to hold alone
	(each (lambda (obj)
		(call :list :push_back `((:rsp ,lst) (:rsp ,obj)))) objs))

(defun pc-do (func lst)
	;a function of lib/math/polygon.inc done, with a list of arguments.
	;What it gives is in :r0, and is let go of
	(assign `((:rsp local_this) (:rsp ,lst)) '(:r0 :r1))
	(fn-call func)
	(assign '(:r1) '((:rsp local_got)))
	(call :obj :deref '(:r1))
	(assign '((:rsp local_got)) '(:r0)))

(defun pc-band ()
	;the pieces of the band the two heights say, and the lines of them.
	;The band above is then the one that was below
	(pc-do 'lib/math/poly_band 'local_bargs)
	(pc-lines))

(defun pc-lines ()
	(pc-do 'lib/math/poly_lines 'local_largs)
	(vp-cpy-cr +pm_goes_on :r1)
	(assign '(:r1) '((:rsp local_on)))
	(assign '((:rsp local_largs)) '(:r0))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign `((:r0 ,(* 3 +ptr_size)) (:r0 ,(* 4 +ptr_size))) '(:r1 :r2))
	(assign '(:r2 :r1) `((:r0 ,(* 3 +ptr_size)) (:r0 ,(* 4 +ptr_size)))))

(defun pc-heights (a b)
	;the two heights of a band, into the numbers the arguments have
	(assign '((:rsp local_ya) (:rsp local_yb)) '(:r13 :r14))
	(assign `(,a ,b) '((:r13 +num_value) (:r14 +num_value))))

(defun pc-mode (more)
	;and has the band before this ended where this begins
	(assign '((:rsp local_mode) (:rsp local_nmode)) '(:r13 :r14))
	(if (/= more 0) (vp-add-cr more :r13))
	(assign '((:rsp local_on)) '(:r12))
	(vp-add-rr :r12 :r13)
	(assign '(:r13) '((:r14 +num_value))))

(def-func (path-to-absolute "./poly_scan"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(poly-scan edges ys openl openr mode segs) -> segs
	;every band of (poly-segs) in lib/math/polygon.inc, from the top to
	;the bottom, as (poly-scan-ref) there does it: the edges that begin
	;at a height come, (poly-band) makes the pieces between it and the
	;next, or the band is cut where edges cross, (poly-cuts), and done a
	;part at a time, and (poly-lines) puts the lines of them on segs

	(structure local 0
		(ptr this edges ys openl openr segs got)
		(ptr bargs largs cargs active above below out cuts ya yb nmode)
		(long mode n next yi ci on))

	(vp-rdef (a b c d e f g h))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7) '(:nums :nums :nums :nums :num :nums))
	(assign '(:r2 :r3 :r4 :r5 :r6 :r7)
		'((:rsp local_edges) (:rsp local_ys) (:rsp local_openl) (:rsp local_openr) (:rsp local_mode) (:rsp local_segs)))
	(assign '((:r4 +array_length)) '(:r4))
	(vp-xor-rr :r5 :r5)
	(assign '(:r4 :r5 :r5 :r5) '((:rsp local_n) (:rsp local_next) (:rsp local_yi) (:rsp local_on)))

	;what the three functions are given, made once
	(each (lambda (obj)
			(call :nums :create :nil '(:r0))
			(assign '(:r0) `((:rsp ,obj))))
		'(local_active local_above local_below local_out local_cuts))
	(each (lambda (obj)
			(call :num :create '(0) '(:r0))
			(assign '(:r0) `((:rsp ,obj))))
		'(local_ya local_yb local_nmode))
	(each (lambda (obj)
			(call :list :create :nil '(:r0))
			(assign '(:r0) `((:rsp ,obj))))
		'(local_bargs local_largs local_cargs))
	(pc-push 'local_bargs 'local_edges)
	(pc-made 'local_bargs 'local_active 'local_ya 'local_yb 'local_nmode 'local_out)
	(pc-push 'local_largs 'local_out 'local_ya 'local_yb)
	(pc-made 'local_largs 'local_above 'local_below)
	(pc-push 'local_largs 'local_segs 'local_openl 'local_openr)
	(pc-push 'local_cargs 'local_edges 'local_active 'local_ya 'local_yb)
	(pc-made 'local_cargs 'local_cuts)
	;every edge can be in a band at once, and a band cut has its two heights
	(call :array :set_cap '((:rsp local_active) (:rsp local_n)))
	(call :array :set_cap '((:rsp local_cuts) 2))

	(loop-start 'bands)
		;the band from this height to the next, if there is a next
		(assign '((:rsp local_ys) (:rsp local_yi)) `(,a ,b))
		(assign `((,a +array_length) (,a +array_begin)) `(,c ,a))
		(vp-add-cr 1 b)
		(gotoif `(,b >= ,c) 'bottom)
		(assign `(,b) '((:rsp local_yi)))
		(vp-shl-cr (log2 +long_size) b)
		(vp-add-rr b a)
		(assign `((,a ,(neg +long_size)) (,a 0)) `(,c ,d))
		(pc-heights c d)
		(pc-mode 0)
		;those that begin here come, those that end here (poly-band) takes out
		(assign '((:rsp local_edges) (:rsp local_active) (:rsp local_next) (:rsp local_n)) `(,a ,b ,d ,e))
		(assign `((,a +array_begin) (,b +array_length) (,b +array_begin)) `(,a ,f ,g))
		(vp-cpy-rr d h)
		(vp-mul-cr +pe_size h)
		(vp-add-rr h a)
		(loop-while `(,d /= ,e))
			(assign `((,a +pe_yt)) `(,h))
			(breakif `(,h /= ,c))
			(vp-cpy-rr f h)
			(vp-shl-cr (log2 +long_size) h)
			(assign `(,d) `((,g ,h)))
			(vp-add-cr 1 f)
			(vp-add-cr 1 d)
			(vp-add-cr +pe_size a)
		(loop-end)
		(assign `(,f) `((,b +array_length)))
		(assign `(,d) '((:rsp local_next)))

		(pc-do 'lib/math/poly_band 'local_bargs)
		(assign '((:rsp local_out)) `(,b))
		(vpif `(,a = ,b))
			;none cross in it
			(pc-lines)
		(else)
			;some do, and it is cut where they do. Where the edges are
			;at the bottom of it was made, not at its top
			(vp-xor-rr a a)
			(assign `(,a) '((:rsp local_on)))
			(assign '((:rsp local_cuts) (:rsp local_ya) (:rsp local_yb)) `(,a ,b ,c))
			(assign `((,b +num_value) (,c +num_value) (,a +array_begin)) `(,b ,c ,d))
			(assign `(,b ,c) `((,d 0) (,d ,+long_size)))
			(vp-cpy-cr 2 b)
			(assign `(,b) `((,a +array_length)))
			(pc-do 'lib/math/poly_cuts 'local_cargs)
			;the heights it is cut at, the least first, each once
			(assign '((:rsp local_cuts)) `(,a))
			(assign `((,a +array_length) (,a +array_begin)) `(,b ,c))
			(vp-shl-cr (log2 +long_size) b)
			(vp-add-rr c b)
			(vp-cpy-rr c d)
			(vp-add-cr +long_size d)
			(loop-while `(,d < ,b))
				(assign `((,d 0)) `(,e))
				(vp-cpy-rr d f)
				(loop-while `(,f /= ,c))
					(assign `((,f ,(neg +long_size))) `(,g))
					(breakif `(,g <= ,e))
					(assign `(,g) `((,f 0)))
					(vp-sub-cr +long_size f)
				(loop-end)
				(assign `(,e) `((,f 0)))
				(vp-add-cr +long_size d)
			(loop-end)
			(vp-cpy-rr c d)
			(vp-cpy-rr c f)
			(assign `((,c 0)) `(,e))
			(loop-start)
				(vp-add-cr +long_size d)
				(breakif `(,d >= ,b))
				(assign `((,d 0)) `(,g))
				(continueif `(,g = ,e))
				(vp-add-cr +long_size f)
				(assign `(,g) `((,f 0)))
				(vp-cpy-rr g e)
			(loop-end)
			(vp-sub-rr c f)
			(vp-shr-cr (log2 +long_size) f)
			(vp-add-cr 1 f)
			(assign `(,f) `((,a +array_length)))
			;each part of it, by the middle of each edge
			(vp-xor-rr a a)
			(assign `(,a) '((:rsp local_ci)))
			(loop-start)
				(assign '((:rsp local_cuts) (:rsp local_ci)) `(,a ,b))
				(assign `((,a +array_length) (,a +array_begin)) `(,c ,a))
				(vp-add-cr 1 b)
				(breakif `(,b >= ,c))
				(assign `(,b) '((:rsp local_ci)))
				(vp-shl-cr (log2 +long_size) b)
				(vp-add-rr b a)
				(assign `((,a ,(neg +long_size)) (,a 0)) `(,c ,d))
				(pc-heights c d)
				(pc-mode +pm_by_middle)
				(pc-band)
			(loop-end)
		(endif)
	(loop-end)

(vp-label 'bottom)
	;and across the bottom of the last
	(vpif `(,c /= 0))
		(vp-shl-cr (log2 +long_size) c)
		(vp-add-rr c a)
		(assign `((,a ,(neg +long_size))) `(,c))
		(pc-heights c c)
		(assign '((:rsp local_out)) `(,a))
		(vp-xor-rr b b)
		(assign `(,b) `((,a +array_length)))
		(pc-lines)
	(endif)

	(call :obj :deref '((:rsp local_bargs)))
	(call :obj :deref '((:rsp local_largs)))
	(call :obj :deref '((:rsp local_cargs)))
	(assign '((:rsp local_this) (:rsp local_segs)) '(:r0 :r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-scan edges ys openl openr mode segs)" +error_msg_wrong_types))
	(signature '(:nums :nums :nums :nums :num :nums)))

(def-func-end)

(defun ph-paths (lst iter end)
	;where the paths of a list begin and end
	(assign `((,lst +array_length) (,lst +array_begin)) `(,end ,iter))
	(vp-shl-cr (log2 +long_size) end)
	(vp-add-rr iter end))

(defun ph-points (iter pi pe)
	;the next path of a list, where its points begin and end, pe 0 if it
	;has less than three of them
	(assign `((,iter 0)) `(,pi))
	(vp-add-cr +ptr_size iter)
	(assign `((,pi +array_length) (,pi +array_begin)) `(,pe ,pi))
	(vpif `(,pe < 6))
		(vp-xor-rr pe pe)
	(else)
		(vp-shl-cr (log2 +long_size) pe)
		(vp-add-rr pi pe)
	(endif))

(defun ph-box (lst)
	;the box round the paths of a list that have three points or more, in
	;:r5 :r6 :r7 :r8, and :r9 not 0 if there are any
	(vp-rdef (iter end pi pe t x0 y0 x1 y1 n x y))
	(assign `((:rsp ,lst)) `(,t))
	(ph-paths t iter end)
	(vp-cpy-cr +max_long x0)
	(vp-cpy-rr x0 y0)
	(vp-cpy-cr +min_long x1)
	(vp-cpy-rr x1 y1)
	(vp-xor-rr n n)
	(loop-while `(,iter /= ,end))
		(ph-points iter pi pe)
		(vpif `(,pe /= 0))
			(vp-cpy-cr 1 n)
			(loop-start)
				(assign `((,pi 0) (,pi ,+long_size)) `(,x ,y))
				(vp-min-rr x x0)
				(vp-max-rr x x1)
				(vp-min-rr y y0)
				(vp-max-rr y y1)
				(vp-add-cr (* 2 +long_size) pi)
			(loop-until `(,pi = ,pe))
		(endif)
	(loop-end))

(defun ph-apart (a b to)
	;two that are both more than 0, or both less, and it goes
	(vpif `(,a > 0))
		(gotoif `(,b > 0) to)
	(endif)
	(vpif `(,a < 0))
		(gotoif `(,b < 0) to)
	(endif))

(def-func (path-to-absolute "./poly_hit"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14
	;info
	;(poly-hit a b mode_a mode_b) -> :t | :nil
	;do two sets of polygons touch, see (poly-hit?) in
	;lib/math/polygon.inc, and (poly-hit-ref?) there, which this does as
	;that does but for the hulls. The numbers of a path are the whole
	;numbers it works in

	(structure local 0
		(ptr this la lb lp ls oi oe)
		(long ma mb ms pass wx0 wy0 wx1 wy1 px py qx qy dx dy lx ly hx hy))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5) '(:list :list :num :num))
	(assign '(:r2 :r3 :r4 :r5) '((:rsp local_la) (:rsp local_lb) (:rsp local_ma) (:rsp local_mb)))

	;the box that is in the boxes of both, if there is one
	(ph-box 'local_la)
	(gotoif '(:r9 = 0) 'miss)
	(assign '(:r5 :r6 :r7 :r8) '((:rsp local_wx0) (:rsp local_wy0) (:rsp local_wx1) (:rsp local_wy1)))
	(ph-box 'local_lb)
	(gotoif '(:r9 = 0) 'miss)
	(assign '((:rsp local_wx0) (:rsp local_wy0) (:rsp local_wx1) (:rsp local_wy1)) '(:r0 :r1 :r2 :r3))
	(vp-max-rr :r0 :r5)
	(vp-max-rr :r1 :r6)
	(vp-min-rr :r2 :r7)
	(vp-min-rr :r3 :r8)
	(gotoif '(:r5 > :r7) 'miss)
	(gotoif '(:r6 > :r8) 'miss)
	(assign '(:r5 :r6 :r7 :r8) '((:rsp local_wx0) (:rsp local_wy0) (:rsp local_wx1) (:rsp local_wy1)))

	;does an edge of the one meet an edge of the other. An edge of a
	;that has no part in that box meets none
	(vp-rdef (api ape biter bend bpi bpe rx ry sx sy t1 t2 t3 t4 t5))
	(assign '((:rsp local_la)) `(,t1))
	(ph-paths t1 t2 t3)
	(assign `(,t2 ,t3) '((:rsp local_oi) (:rsp local_oe)))
	(loop-start 'apaths)
		(assign '((:rsp local_oi) (:rsp local_oe)) `(,t1 ,t2))
		(gotoif `(,t1 = ,t2) 'contain)
		(ph-points t1 api ape)
		(assign `(,t1) '((:rsp local_oi)))
		(vpif `(,ape /= 0))
			(assign `((,ape ,(neg (* 2 +long_size))) (,ape ,(neg +long_size))) `(,t1 ,t2))
			(assign `(,t1 ,t2) '((:rsp local_px) (:rsp local_py)))
			(loop-start)
				;p to q, the box round it, and how far it goes
				(assign '((:rsp local_px) (:rsp local_py)) `(,rx ,ry))
				(assign `((,api 0) (,api ,+long_size)) `(,sx ,sy))
				(assign `(,sx ,sy) '((:rsp local_qx) (:rsp local_qy)))
				(vp-cpy-rr sx t1)
				(vp-sub-rr rx t1)
				(vp-cpy-rr sy t2)
				(vp-sub-rr ry t2)
				(assign `(,t1 ,t2) '((:rsp local_dx) (:rsp local_dy)))
				(vp-cpy-rr rx t1)
				(vp-min-rr sx t1)
				(vp-max-rr rx sx)
				(vp-cpy-rr ry t2)
				(vp-min-rr sy t2)
				(vp-max-rr ry sy)
				(assign `(,t1 ,t2 ,sx ,sy) '((:rsp local_lx) (:rsp local_ly) (:rsp local_hx) (:rsp local_hy)))
				(assign '((:rsp local_wx0) (:rsp local_wy0) (:rsp local_wx1) (:rsp local_wy1)) `(,rx ,ry ,t3 ,t4))
				(gotoif `(,sx < ,rx) 'nexta)
				(gotoif `(,sy < ,ry) 'nexta)
				(gotoif `(,t1 > ,t3) 'nexta)
				(gotoif `(,t2 > ,t4) 'nexta)
				;against every edge of b, r to s
				(assign '((:rsp local_lb)) `(,t1))
				(ph-paths t1 biter bend)
				(loop-while `(,biter /= ,bend))
					(ph-points biter bpi bpe)
					(vpif `(,bpe /= 0))
						(assign `((,bpe ,(neg (* 2 +long_size))) (,bpe ,(neg +long_size))) `(,rx ,ry))
						(loop-start)
							(assign `((,bpi 0) (,bpi ,+long_size)) `(,sx ,sy))
							;their boxes are apart
							(assign '((:rsp local_lx) (:rsp local_hx)) `(,t3 ,t4))
							(vp-cpy-rr rx t1)
							(vp-max-rr sx t1)
							(gotoif `(,t1 < ,t3) 'nextb)
							(vp-cpy-rr rx t1)
							(vp-min-rr sx t1)
							(gotoif `(,t1 > ,t4) 'nextb)
							(assign '((:rsp local_ly) (:rsp local_hy)) `(,t3 ,t4))
							(vp-cpy-rr ry t1)
							(vp-max-rr sy t1)
							(gotoif `(,t1 < ,t3) 'nextb)
							(vp-cpy-rr ry t1)
							(vp-min-rr sy t1)
							(gotoif `(,t1 > ,t4) 'nextb)
							;which side of the line p q are r and s
							(assign '((:rsp local_px) (:rsp local_py)) `(,t1 ,t2))
							(vp-cpy-rr ry t3)
							(vp-sub-rr t2 t3)
							(assign '((:rsp local_dx)) `(,t4))
							(vp-mul-rr t4 t3)
							(vp-cpy-rr rx t4)
							(vp-sub-rr t1 t4)
							(assign '((:rsp local_dy)) `(,t5))
							(vp-mul-rr t5 t4)
							(vp-sub-rr t4 t3)
							(vp-cpy-rr sy t4)
							(vp-sub-rr t2 t4)
							(assign '((:rsp local_dx)) `(,t5))
							(vp-mul-rr t5 t4)
							(vp-cpy-rr sx t5)
							(vp-sub-rr t1 t5)
							(assign '((:rsp local_dy)) `(,t1))
							(vp-mul-rr t1 t5)
							(vp-sub-rr t5 t4)
							(ph-apart t3 t4 'nextb)
							;and of the line r s are p and q
							(vp-cpy-rr sx t1)
							(vp-sub-rr rx t1)
							(vp-cpy-rr sy t2)
							(vp-sub-rr ry t2)
							(assign '((:rsp local_py) (:rsp local_px)) `(,t3 ,t4))
							(vp-sub-rr ry t3)
							(vp-mul-rr t1 t3)
							(vp-sub-rr rx t4)
							(vp-mul-rr t2 t4)
							(vp-sub-rr t4 t3)
							(assign '((:rsp local_qy) (:rsp local_qx)) `(,t4 ,t5))
							(vp-sub-rr ry t4)
							(vp-mul-rr t1 t4)
							(vp-sub-rr rx t5)
							(vp-mul-rr t2 t5)
							(vp-sub-rr t5 t4)
							(ph-apart t3 t4 'nextb)
							(goto 'hit)
						(vp-label 'nextb)
							(vp-cpy-rr sx rx)
							(vp-cpy-rr sy ry)
							(vp-add-cr (* 2 +long_size) bpi)
						(loop-until `(,bpi = ,bpe))
					(endif)
				(loop-end)
			(vp-label 'nexta)
				(assign '((:rsp local_qx) (:rsp local_qy)) `(,t1 ,t2))
				(assign `(,t1 ,t2) '((:rsp local_px) (:rsp local_py)))
				(vp-add-cr (* 2 +long_size) api)
			(loop-until `(,api = ,ape))
		(endif)
	(loop-end)

(vp-label 'contain)
	;none do. So each path is all in the other set or all out of it, and
	;its first point says which: the paths of a in b, then those of b in a
	(vp-rdef (x y wind siter send spi spe x0 y0 x1 y1 t1 t2 t3))
	(assign '((:rsp local_la) (:rsp local_lb) (:rsp local_mb)) `(,t1 ,t2 ,t3))
	(assign `(,t1 ,t2 ,t3) '((:rsp local_lp) (:rsp local_ls) (:rsp local_ms)))
	(vp-xor-rr t1 t1)
	(assign `(,t1) '((:rsp local_pass)))
	(loop-start 'passes)
		(assign '((:rsp local_lp)) `(,t1))
		(ph-paths t1 t2 t3)
		(assign `(,t2 ,t3) '((:rsp local_oi) (:rsp local_oe)))
		(loop-start)
			(assign '((:rsp local_oi) (:rsp local_oe)) `(,t1 ,t2))
			(breakif `(,t1 = ,t2))
			(ph-points t1 spi spe)
			(assign `(,t1) '((:rsp local_oi)))
			(vpif `(,spe /= 0))
				(assign `((,spi 0) (,spi ,+long_size)) `(,x ,y))
				(vp-xor-rr wind wind)
				(assign '((:rsp local_ls)) `(,t1))
				(ph-paths t1 siter send)
				(loop-while `(,siter /= ,send))
					(ph-points siter spi spe)
					(vpif `(,spe /= 0))
						(assign `((,spe ,(neg (* 2 +long_size))) (,spe ,(neg +long_size))) `(,x0 ,y0))
						(loop-start)
							(assign `((,spi 0) (,spi ,+long_size)) `(,x1 ,y1))
							;an edge that goes up past the point with it on its
							;left winds one way, down past it on its right the other
							(vp-cpy-rr x1 t1)
							(vp-sub-rr x0 t1)
							(vp-cpy-rr y t2)
							(vp-sub-rr y0 t2)
							(vp-mul-rr t2 t1)
							(vp-cpy-rr y1 t2)
							(vp-sub-rr y0 t2)
							(vp-cpy-rr x t3)
							(vp-sub-rr x0 t3)
							(vp-mul-rr t3 t2)
							(vp-sub-rr t2 t1)
							(vpif `(,y0 <= ,y))
								(vpif `(,y1 > ,y))
									(vpif `(,t1 > 0))
										(vp-add-cr 1 wind)
									(endif)
								(endif)
							(else)
								(vpif `(,y1 <= ,y))
									(vpif `(,t1 < 0))
										(vp-sub-cr 1 wind)
									(endif)
								(endif)
							(endif)
							(vp-cpy-rr x1 x0)
							(vp-cpy-rr y1 y0)
							(vp-add-cr (* 2 +long_size) spi)
						(loop-until `(,spi = ,spe))
					(endif)
				(loop-end)
				(assign '((:rsp local_ms)) `(,t1))
				(vpif `(,t1 = 0))
					(vp-and-cr 1 wind)
				(endif)
				(gotoif `(,wind /= 0) 'hit)
			(endif)
		(loop-end)
		(assign '((:rsp local_pass)) `(,t1))
		(gotoif `(,t1 /= 0) 'miss)
		(vp-cpy-cr 1 t1)
		(assign `(,t1) '((:rsp local_pass)))
		(assign '((:rsp local_lb) (:rsp local_la) (:rsp local_ma)) `(,t1 ,t2 ,t3))
		(assign `(,t1 ,t2 ,t3) '((:rsp local_lp) (:rsp local_ls) (:rsp local_ms)))
	(loop-end)

(vp-label 'hit)
	(assign '((:rsp local_this)) '(:r0))
	(assign '((:r0 +lisp_sym_t)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'miss)
	(assign '((:rsp local_this)) '(:r0))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(poly-hit a b mode_a mode_b)" +error_msg_wrong_types))
	(signature '(:list :list :num :num)))

(def-func-end)

