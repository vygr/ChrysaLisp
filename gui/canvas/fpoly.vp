(include "lib/asm/func.inc")
(include "./class.inc")
(include "././pixmap/class.inc")

(def-method :canvas :set_edges)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = list of path objects (ptr)
	;:r2 = x (fixed)
	;:r3 = y (fixed)
	;:r4 = y scale (int)
	;outputs
	;:r0 = canvas object (ptr)
	;:r11 = min_x (fixed)
	;:r12 = min_y (fixed)
	;:r13 = max_x (fixed)
	;:r14 = max_y (fixed)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(pint iter_edge1 iter_edge2 iter_begin_polygon iter_end_polygon)
		(pptr iter_end_polygons iter_begin_polygons)
		(int x y)
		(uint length yscale))

	(vp-rdef (xlow iter_edge2 xhigh x y x1 x2 y1 y2 cy cy1 xs ys xe ye))

	(vp-alloc local_size)
	(entry :canvas :set_edges '(:r0 :r1 :r2 :r3 :r4))
	(assign '(:r0 :r2 :r3 :r4) '((:rsp local_this) (:rsp local_x) (:rsp local_y) (:rsp local_yscale)))

	;fill edges, find min and max xy, clip edges not visible or redundant
	(assign '((:r0 +canvas_cy) (:r0 +canvas_cy1)) (list cy cy1))
	(vp-xor-rr :r0 :r0)
	;a pixel is filled if its middle is in, so half a pixel is added
	;across. Down, it is the middle of a scan line, and with soft edges
	;there are y scale of them to a pixel
	(vp-cpy-cr 0.5 :r5)
	(vpif '(:r4 /= 1))
		(vp-cpy-cr 0.0625 :r5)
	(endif)
	(vp-add-cr 0.5 :r2)
	(vp-add-rr :r5 :r3)
	(vp-simd vp-cpy-cr `(,+max_int ,+min_int) `(,xs ,xe))
	(vp-simd vp-mul-rr '(:r4) `(,cy ,cy1))
	(assign '(:r0 :r2 :r3) '((:rsp local_length) (:rsp local_x) (:rsp local_y)))
	(assign (list xs xe) (list ys ye))

	(class/array/get_both :r1 :r1 :r2)
	(assign '(:r2) '((:rsp local_iter_end_polygons)))
	(loop-while '(:r1 /= :r2))
		(assign '(:r1 (:r1 0)) '((:rsp local_iter_begin_polygons) :r1))
		(class/array/get_both :r1 :r1 :r2)
		(assign '(:r1 :r2) '((:rsp local_iter_begin_polygon) (:rsp local_iter_end_polygon)))
		(vp-sub-rr :r1 :r2)
		(assign '((:rsp local_this) (:rsp local_length)) '(:r0 :r1))
		(vp-shr-cr 4 :r2)
		(vp-mul-cr (>> +edge_size 3) :r2)
		(vp-add-rr :r2 :r1)

		(call :array :set_cap '((:r0 +canvas_edges) :r1) '(:r0))
		(assign '((:r0 +array_begin) (:rsp local_length)) '(:r1 :r2))
		(assign '(:r1) '((:rsp local_iter_edge1)))
		(vp-mul-cr +long_size :r2)
		(vp-add-rr :r2 :r1)
		(assign '(:r1) '((:rsp local_iter_edge2)))

		(assign '((:rsp local_iter_begin_polygon) (:rsp local_iter_end_polygon) (:rsp local_x) (:rsp local_y))
			(list :r1 :r2 x y))
		(vp-sub-rr :r1 :r2)
		(vpif (list :r2 '>= (* +long_size 6)))
			(assign '((:rsp local_iter_end_polygon) (:rsp local_yscale)) (list :r2 :r0))
			(assign '((:r2 (* +long_size -2)) (:r2 (* +long_size -1))) (list x1 y1))
			(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
			(vp-mul-rr :r0 y1)
			(vp-asr-cr +fp_shift y1)
			(loop-start)
				(assign '((:r1 0) (:r1 +long_size)) (list x2 y2))
				(vp-simd vp-add-rr `(,x ,y) `(,x2 ,y2))
				(vp-mul-rr :r0 y2)
				(vp-asr-cr +fp_shift y2)
				(vpif `(,y1 /= ,y2))
					(switch)
					(vp-cpy-rr x2 x)
					(vp-asr-cr +fp_shift x)
					(vp-min-rr x xs)
					(vp-max-rr x xe)
					(vp-cpy-cr 1 x)
					(vpif `(,y2 < ,y1))
						(vp-simd vp-swp-rr `(,x1 ,y1) `(,x2 ,y2))
						(vp-cpy-cr -1 x)
					(endif)
					(breakif `(,y2 <= ,cy) `(,y1 >= ,cy1))
					(default)
						(assign '((:rsp local_iter_edge2)) (list iter_edge2))
						(vp-simd vp-cpy-rr `(,x2 ,y2) `(,xlow ,y))
						(vp-simd vp-sub-rr `(,x1 ,y1) `(,xlow ,y))
						(vp-ext-rr xlow xhigh)
						(vp-div-rrr y xhigh xlow)
						(vpif `(,y1 < ,cy))
							(vp-cpy-rr cy y)
							(vp-sub-rr y1 y)
							(vp-mul-rr xlow y)
							(vp-cpy-rr cy y1)
							(vp-add-rr y x1)
						(endif)
						(vp-simd vp-cpy-ri-i `(,x1 ,y1 ,y2 ,xlow ,x) `(,iter_edge2)
							`(,+edge_x ,+edge_ys ,+edge_ye ,+edge_dda ,+edge_w))
						(vp-add-cr +edge_size iter_edge2)
						(vp-min-rr y1 ys)
						(vp-max-rr y2 ye)
						(assign (list iter_edge2) '((:rsp local_iter_edge2)))
						(assign '((:rsp local_iter_begin_polygon) (:rsp local_iter_end_polygon)
							(:rsp local_y) (:rsp local_yscale)) (list :r1 :r2 y :r0))
					(endswitch)
					(assign '((:rsp local_x)) (list x))
				(else)
					(vp-asr-cr +fp_shift x2)
					(vp-min-rr x2 xs)
					(vp-max-rr x2 xe)
				(endif)
				(assign '((:r1 0) (:r1 +long_size)) (list x1 y1))
				(vp-add-cr (* +long_size 2) :r1)
				(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
				(vp-mul-rr :r0 y1)
				(vp-asr-cr +fp_shift y1)
				(assign '(:r1) '((:rsp local_iter_begin_polygon)))
			(loop-until '(:r1 = :r2))
			(assign '((:rsp local_iter_edge1) (:rsp local_iter_edge2)) '(:r1 :r2))
			(vp-sub-rr :r1 :r2)
			(vp-shr-cr 3 :r2)
			(assign '(:r2) '((:rsp local_length)))
		(endif)
		(assign '((:rsp local_iter_begin_polygons) (:rsp local_iter_end_polygons)) '(:r1 :r2))
		(vp-add-cr +ptr_size :r1)
	(loop-end)
	(assign '((:rsp local_this) (:rsp local_length)) '(:r0 :r1))
	(assign '((:r0 +canvas_edges)) '(:r2))
	(assign '(:r1) '((:r2 +array_length)))

	(exit :canvas :set_edges (list :r0 xs ys xe ye))
	(vp-free local_size)
	(vp-ret)

(def-func-end)

(def-method :canvas :fpoly)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = x (fixed)
	;:r2 = y (fixed)
	;:r3 = winding mode (winding_odd_even, winding_none_zero)
	;:r4 = list of path objects (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this)
		(union
			(ptr polygons)
			(pint sorted_list)
			(pint tracker_node tracker_last tracker_list))
		(int ys ye xs xe x y om min_x max_x)
		(uint mode yscale cy cy1))

	(push-scope)
	(entry :canvas :fpoly (vpx this x y mode polygons))

	;fill edges, find min and max xy, clip edges not visible or redundant
	(assign (vpx 1) (vpx yscale))
	(vpif (vpx (.> this +canvas_flags)))
		(assign (vpx 8) (vpx yscale))
	(endif)
	(call :canvas :set_edges (vpx this polygons x y yscale) (vpx _ xs ys xe ye))

	;clip check
	(assign (vpx (* yscale (.> this +canvas_cy)) (* yscale (.> this +canvas_cy1))) (vpx cy cy1))
	(vpif (vpx (&& (< xs (.> this +canvas_cx1)) (> xe (.> this +canvas_cx)) (< ys cy1) (> ye cy))))
		;setup active edge list, edge starts and coverage
		(assign (vpx 0) (vpx tracker_list))
		(vpifnot (vpx (.> this +canvas_edges_start)))
			(call :sys_mem :calloc (vpx (* (.> this +canvas_pixmap +pixmap_height) 8 +ptr_size)) (vpx (.> this +canvas_edges_start) _))
		(endif)
		(vpif (vpx (.> this +canvas_flags)))
			(assign (vpx +max_int +min_int) (vpx min_x max_x))
			(vpifnot (vpx (.> this +canvas_coverage)))
				(call :sys_mem :calloc (vpx (+ (.> this +canvas_pixmap +pixmap_width) 1)) (vpx (.> this +canvas_coverage) _))
			(endif)
		(endif)

		;edge pointers into edge starts
		(call :array :get_both (vpx (.> this +canvas_edges)) (vpx _ tracker_node tracker_last))
		(vp-rdef (edges_start edge_node edge_last edge_tmp edge_list_head))
		(assign (vpx (.> this +canvas_edges_start) tracker_node tracker_last)
			(list edges_start edge_node edge_last))
		(loop-start)
			(vp-cpy-ir-i edge_node +edge_ys edge_list_head)
			(vp-mul-cr +ptr_size edge_list_head)
			(vp-add-rr edges_start edge_list_head)
			(ln-add-fnode edge_list_head 0 edge_node edge_tmp)
			(vp-add-cr +edge_size edge_node)
		(loop-until `(,edge_node = ,edge_last))

		;for each scanline
		(loop-while (vpx (< ys ye)))
			;include new edges that begin on this scanline
			(vp-rdef (tracker_list_head starts_node starts_last starts_new starts_tmp))
			(assign (vpx (& (elem (.> this +canvas_edges_start) (* ys +ptr_size))) (& tracker_list))
				(list starts_node tracker_list_head))
			(loop-start)
				(ln-next-fnode starts_node starts_last)
				(vp-cpy-rr starts_node starts_new)
				(ln-remove-fnode starts_node starts_last)
				(ln-add-fnode tracker_list_head 0 starts_new starts_tmp)
			(loop-end)

			;sort active edges on x
			(vpif (vpx (|| (! (.> this +canvas_flags)) mode)))
				(assign (vpx 0) (vpx sorted_list))
				(vp-rdef (sorted_list_head tracker_node tracker_last tracker_new
					sorted_node sorted_last x1 x2))
				(assign (vpx (& sorted_list) (& tracker_list)) (list sorted_list_head tracker_node))
				(loop-start)
					(ln-next-fnode tracker_node tracker_last)
					(vp-cpy-rr tracker_node tracker_new)
					(ln-remove-fnode tracker_node tracker_last)
					(vp-cpy-ir-i tracker_new +edge_x x1)
					(loop-flist sorted_list_head 0 sorted_node sorted_last)
						(vp-cpy-ir-i sorted_node +edge_x x2)
					(loop-until `(,x1 <= ,x2))
					(ln-add-fnode sorted_last 0 tracker_new tracker_last)
				(loop-end)
				(assign (vpx sorted_list) (vpx tracker_list))
			(endif)

			;antialiased ?
			(vpif (vpx (.> this +canvas_flags)))
				;draw edges into coverage mask
				(vp-rdef (tracker_node mask xo cx cx1 x xp xb xm min_x max_x w v))
				(assign (vpx (& tracker_list) (.> this +canvas_coverage) (int (+ ($ sample_offsets) (<< (& ys 7) 2)))
					(<< 1 (& ys 7)) (<< (.> this +canvas_cx) +fp_shift) (<< (.> this +canvas_cx1) +fp_shift) min_x max_x mode)
					(list tracker_node mask xo xm cx cx1 min_x max_x v))
				(vpif `(,v = 0))
					;odd even
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(vp-cpy-ir-i tracker_node +edge_x x)
						(vp-add-rr xo x)
						(vpif `(,x < ,cx))
							(vp-cpy-rr cx x)
						(elseif `(,x > ,cx1))
							(vp-cpy-rr cx1 x)
						(endif)
						(vp-asr-cr +fp_shift x)
						(vp-cpy-dr-ub mask x xb)
						(vp-min-rr x min_x)
						(vp-max-rr x max_x)
						(vp-xor-rr xm xb)
						(vp-cpy-rd-b xb mask x)
					(loop-end)
				(else)
					;non zero
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(vp-simd vp-cpy-ir-i `(,tracker_node) `(,+edge_x ,+edge_w) `(,x ,w))
						(vp-add-rr xo x)
						(vpif `(,x < ,cx))
							(vp-cpy-rr cx x)
						(elseif `(,x > ,cx1))
							(vp-cpy-rr cx1 x)
						(endif)
						(vp-asr-cr +fp_shift x)
						(vp-cpy-dr-ub mask x xb)
						(vp-min-rr x min_x)
						(vp-xor-rr xm xb)
						(vp-cpy-rd-b xb mask x)
						(loop-start)
							(vp-cpy-ir tracker_node +ln_fnode_next tracker_node)
							(vp-cpy-ir-i tracker_node +edge_w v)
							(vp-add-rr v w)
						(loop-until `(,w = 0))
						(vp-cpy-ir-i tracker_node +edge_x x)
						(vp-add-rr xo x)
						(vpif `(,x < ,cx))
							(vp-cpy-rr cx x)
						(elseif `(,x > ,cx1))
							(vp-cpy-rr cx1 x)
						(endif)
						(vp-asr-cr +fp_shift x)
						(vp-cpy-dr-ub mask x xb)
						(vp-max-rr x max_x)
						(vp-xor-rr xm xb)
						(vp-cpy-rd-b xb mask x)
					(loop-end)
				(endif)
				(assign (list min_x max_x) (vpx min_x max_x))

				;flush coverage mask to scan line
				(gotoif (vpx (|| (= (& ys 7) 7) (= (+ ys 1) ye))) 'flush_mask)
				(breakif (vpx (< (+ ys 1) cy1)))
			(vp-label 'flush_mask)
				(vp-rdef (this c x y x1 mask m om max_x mask_to_coverage v)
					(method-input :canvas :span))
				(assign (vpx this min_x max_x (>> ys 3)) (list this x max_x y))
				(breakif `(,x > ,max_x))
				(vp-add-cr 1 max_x)
				(vp-xor-rr om om)
				(assign (list max_x y om) (vpx max_x y om))
				(loop-start)
					(assign (vpx ($ mask_to_coverage)) (list mask_to_coverage))
					(vp-cpy-ir this +canvas_coverage mask)
					;the pixel an edge is on is the first of the run that
					;begins there, so the cover from it on has that edge in
					(vp-cpy-dr-ub mask x c)
					(vp-xor-rr c om)
					(vp-xor-rr c c)
					(vp-cpy-rd-b c mask x)
					(vp-lea-i x 1 x1)
					(loop-while `(,x1 < ,max_x))
						(vp-cpy-dr-ub mask x1 c)
						(breakif `(,c /= 0))
						(vp-add-cr 1 x1)
					(loop-end)
					(vp-cpy-dr-ub mask_to_coverage om c)
					(assign (list om x1) (vpx om x))
					;an edge at or past the right of the clip is on the pixel
					;after its last, where nothing is drawn
					(assign (list (list this '+canvas_cx1)) (list v))
					(vpif `(,c /= 0) `(,x < ,v))
						(call :canvas :span_noclip (list this c x y x1) (list this))
					(endif)
					(assign (vpx this x max_x y om) (list this x max_x y om))
				(loop-until `(,x >= ,max_x))
				(assign (vpx +max_int +min_int) (vpx min_x max_x))
			(else)
				;draw spans for mode
				(vp-rdef (this c x1 ys x2 w v tracker_node) (method-input :canvas :span))
				(assign (vpx mode this (& tracker_list)) (list v this tracker_node))
				(vpif `(,v = ,+winding_odd_even))
					;odd even
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(assign (vpx ys) (list ys))
						(vp-cpy-ir-i tracker_node +edge_x x1)
						(vp-cpy-ir tracker_node +ln_fnode_next tracker_node)
						(vp-cpy-ir-i tracker_node +edge_x x2)
						(vp-simd vp-asr-cr `(,+fp_shift) `(,x1 ,x2))
						(assign (list tracker_node) (vpx tracker_node))
						(call :canvas :span (list this 0x80 x1 ys x2) (list this))
						(assign (vpx tracker_node) (list tracker_node))
					(loop-end)
				(else)
					;non zero
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(assign (vpx ys) (list ys))
						(vp-simd vp-cpy-ir-i `(,tracker_node) `(,+edge_x ,+edge_w) `(,x1 ,w))
						(loop-start)
							(vp-cpy-ir tracker_node +ln_fnode_next tracker_node)
							(vp-cpy-ir-i tracker_node +edge_w v)
							(vp-add-rr v w)
						(loop-until `(,w = 0))
						(vp-cpy-ir-i tracker_node +edge_x x2)
						(vp-simd vp-asr-cr `(,+fp_shift) `(,x1 ,x2))
						(assign (list tracker_node) (vpx tracker_node))
						(call :canvas :span (list this 0x80 x1 ys x2) (list this))
						(assign (vpx tracker_node) (list tracker_node))
					(loop-end)
				(endif)
			(endif)

			;next sub scanline
			(breakif (vpx (>= (=> (+ ys 1) ys) cy1)))

			;step the edges and remove any dead ones
			(vp-rdef (tracker_node tracker_last ys x dda))
			(assign (vpx (& tracker_list) ys) (list tracker_node ys))
			(loop-start)
			(vp-label 'start)
				(ln-next-fnode tracker_node tracker_last)
				(vp-cpy-ir-i tracker_node +edge_ye x)
				(vpif `(,x /= ,ys))
					(vp-simd vp-cpy-ir-i `(,tracker_node) `(,+edge_x ,+edge_dda) `(,x ,dda))
					(vp-add-rr dda x)
					(vp-cpy-ri-i x tracker_node +edge_x)
					(goto 'start)
				(endif)
				(ln-remove-fnode tracker_node tracker_last)
			(loop-end)
		(loop-end)
	(endif)

	(exit :canvas :fpoly (vpx this))
	(pop-scope)
	(return)

(vp-label 'sample_offsets)
	;where across a pixel each of its 8 scan lines is sampled, less the
	;half that (:set_edges) put on. They are the middles of eighths, the
	;0.0625 more, so an edge on a whole number, or a hair off one, has
	;every sample of a pixel to the same side of it
	(apply (const vp-int) (map (lambda (o)
		(- o 0.4375)) '(0.25 0.875 0.5 0.125 0.75 0.375 0.0 0.625)))

(vp-label 'mask_to_coverage)
	(apply (const vp-byte) (map (lambda (m)
		(/ (* 0x80 (apply (const +) (map (lambda (s)
			(logand 1 (>> m s))) (const (push (list quote) (range 0 8)))))) 8)) (range 0 256)))

(def-func-end)
