(include "lib/asm/func.inc")
(include "./class.inc")
(include "././pixmap/class.inc")

(def-method :canvas :set_edges)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = list of path objects (ptr)
	;:r2 = x (fixed)
	;:r3 = y (fixed)
	;:r4 = y scale (int)
	;outputs
	;:r0 = canvas object (ptr)
	;:r11 = min_x (fixed)
	;:r12 = min_y (fixed)
	;:r13 = max_x (fixed)
	;:r14 = max_y (fixed)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(pint iter_edge1 iter_edge2 iter_begin_polygon iter_end_polygon)
		(pptr iter_end_polygons iter_begin_polygons)
		(int x y)
		(uint length yscale))

	(vp-rdef (xlow iter_edge2 xhigh x y x1 x2 y1 y2 cy cy1 xs ys xe ye))

	(vp-alloc slot_size)
	(entry :canvas :set_edges '(:r0 :r1 :r2 :r3 :r4))
	(save-fields :rsp '(slot_this slot_x slot_y slot_yscale) '(:r0 :r2 :r3 :r4))

	;fill edges, find min and max xy, clip edges not visible or redundant
	(assign '((:r0 +canvas_cy) (:r0 +canvas_cy1)) (list cy cy1))
	(vp-xor-rr :r0 :r0)
	;a pixel is filled if its middle is in, so half a pixel is added
	;across. Down, it is the middle of a scan line, and with soft edges
	;there are y scale of them to a pixel
	(vp-cpy-cr 0.5 :r5)
	(vpif '(:r4 /= 1))
		(vp-cpy-cr 0.0625 :r5)
	(endif)
	(vp-add-cr 0.5 :r2)
	(vp-add-rr :r5 :r3)
	(vp-simd vp-cpy-cr `(,+max_int ,+min_int) `(,xs ,xe))
	(vp-simd vp-mul-rr '(:r4) `(,cy ,cy1))
	(save-fields :rsp '(slot_length slot_x slot_y) '(:r0 :r2 :r3))
	(assign (list xs xe) (list ys ye))

	(class/array/get_both :r1 :r1 :r2)
	(assign '(:r2) '((:rsp slot_iter_end_polygons)))
	(loop-while '(:r1 /= :r2))
		(assign '(:r1 (:r1 0)) '((:rsp slot_iter_begin_polygons) :r1))
		(class/array/get_both :r1 :r1 :r2)
		(save-fields :rsp '(slot_iter_begin_polygon slot_iter_end_polygon) '(:r1 :r2))
		(vp-sub-rr :r1 :r2)
		(load-fields :rsp '(slot_this slot_length) '(:r0 :r1))
		(vp-shr-cr 4 :r2)
		(vp-mul-cr (>> +edge_size 3) :r2)
		(vp-add-rr :r2 :r1)

		(call :array :set_cap '((:r0 +canvas_edges) :r1) '(:r0))
		(assign '((:r0 +array_begin) (:rsp slot_length)) '(:r1 :r2))
		(assign '(:r1) '((:rsp slot_iter_edge1)))
		(vp-mul-cr +long_size :r2)
		(vp-add-rr :r2 :r1)
		(assign '(:r1) '((:rsp slot_iter_edge2)))

		(assign '((:rsp slot_iter_begin_polygon) (:rsp slot_iter_end_polygon) (:rsp slot_x) (:rsp slot_y))
			(list :r1 :r2 x y))
		(vp-sub-rr :r1 :r2)
		(vpif (list :r2 '>= (* +long_size 6)))
			(assign '((:rsp slot_iter_end_polygon) (:rsp slot_yscale)) (list :r2 :r0))
			(assign '((:r2 (* +long_size -2)) (:r2 (* +long_size -1))) (list x1 y1))
			(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
			(vp-mul-rr :r0 y1)
			(vp-asr-cr +fp_shift y1)
			(loop-start)
				(assign '((:r1 0) (:r1 +long_size)) (list x2 y2))
				(vp-simd vp-add-rr `(,x ,y) `(,x2 ,y2))
				(vp-mul-rr :r0 y2)
				(vp-asr-cr +fp_shift y2)
				(vpif `(,y1 /= ,y2))
					(switch)
					(vp-cpy-rr x2 x)
					(vp-asr-cr +fp_shift x)
					(vp-min-rr x xs)
					(vp-max-rr x xe)
					(vp-cpy-cr 1 x)
					(vpif `(,y2 < ,y1))
						(vp-simd vp-swp-rr `(,x1 ,y1) `(,x2 ,y2))
						(vp-cpy-cr -1 x)
					(endif)
					(breakif `(,y2 <= ,cy) `(,y1 >= ,cy1))
					(default)
						(assign '((:rsp slot_iter_edge2)) (list iter_edge2))
						(vp-simd vp-cpy-rr `(,x2 ,y2) `(,xlow ,y))
						(vp-simd vp-sub-rr `(,x1 ,y1) `(,xlow ,y))
						(vp-div-rr y xlow)
						(vpif `(,y1 < ,cy))
							(vp-cpy-rr cy y)
							(vp-sub-rr y1 y)
							(vp-mul-rr xlow y)
							(vp-cpy-rr cy y1)
							(vp-add-rr y x1)
						(endif)
						(vp-simd vp-store-rrc-i `(,x1 ,y1 ,y2 ,xlow ,x) `(,iter_edge2)
							`(,+edge_x ,+edge_ys ,+edge_ye ,+edge_dda ,+edge_w))
						(vp-add-cr +edge_size iter_edge2)
						(vp-min-rr y1 ys)
						(vp-max-rr y2 ye)
						(assign (list iter_edge2) '((:rsp slot_iter_edge2)))
						(assign '((:rsp slot_iter_begin_polygon) (:rsp slot_iter_end_polygon)
							(:rsp slot_y) (:rsp slot_yscale)) (list :r1 :r2 y :r0))
					(endswitch)
					(assign '((:rsp slot_x)) (list x))
				(else)
					(vp-asr-cr +fp_shift x2)
					(vp-min-rr x2 xs)
					(vp-max-rr x2 xe)
				(endif)
				(assign '((:r1 0) (:r1 +long_size)) (list x1 y1))
				(vp-add-cr (* +long_size 2) :r1)
				(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
				(vp-mul-rr :r0 y1)
				(vp-asr-cr +fp_shift y1)
				(assign '(:r1) '((:rsp slot_iter_begin_polygon)))
			(loop-until '(:r1 = :r2))
			(load-fields :rsp '(slot_iter_edge1 slot_iter_edge2) '(:r1 :r2))
			(vp-sub-rr :r1 :r2)
			(vp-shr-cr 3 :r2)
			(assign '(:r2) '((:rsp slot_length)))
		(endif)
		(load-fields :rsp '(slot_iter_begin_polygons slot_iter_end_polygons) '(:r1 :r2))
		(vp-add-cr +ptr_size :r1)
	(loop-end)
	(load-fields :rsp '(slot_this slot_length) '(:r0 :r1))
	(assign '((:r0 +canvas_edges)) '(:r2))
	(assign '(:r1) '((:r2 +array_length)))

	(exit :canvas :set_edges (list :r0 xs ys xe ye))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :canvas :fpoly)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = x (fixed)
	;:r2 = y (fixed)
	;:r3 = winding mode (winding_odd_even, winding_none_zero)
	;:r4 = list of path objects (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(union
			(ptr polygons)
			(pint sorted_list)
			(pint tracker_node tracker_last tracker_list))
		(int ys ye xs xe x y om min_x max_x)
		(uint mode yscale cy cy1))

	(vp-alloc slot_size)
	(entry :canvas :fpoly '(:r0 :r1 :r2 :r3 :r4))

	;fill edges, find min and max xy, clip edges not visible or redundant,
	;the y of an antialiased canvas by 8
	(assign '((:r0 +canvas_flags)) '(:r5))
	(vp-cpy-cr 1 :r6)
	(vpif '(:r5 /= 0))
		(vp-cpy-cr 8 :r6)
	(endif)
	(save-fields :rsp '(slot_this slot_polygons slot_x slot_y slot_mode slot_yscale) '(:r0 :r4 :r1 :r2 :r3 :r6))
	(call :canvas :set_edges '((:rsp slot_this) (:rsp slot_polygons) (:rsp slot_x) (:rsp slot_y) (:rsp slot_yscale))
		'(_ :r11 :r12 :r13 :r14))
	(save-fields :rsp '(slot_xs slot_ys slot_xe slot_ye) '(:r11 :r12 :r13 :r14))

	;clip check
	(load-fields :rsp '(slot_this slot_yscale) '(:r0 :r1))
	(assign '((:r0 +canvas_cy) (:r0 +canvas_cy1) (:r0 +canvas_cx) (:r0 +canvas_cx1)) '(:r2 :r3 :r8 :r9))
	(vp-mul-rr :r1 :r2)
	(vp-mul-rr :r1 :r3)
	(save-fields :rsp '(slot_cy slot_cy1) '(:r2 :r3))
	(vpif '(:r11 < :r9) '(:r13 > :r8) '(:r12 < :r3) '(:r14 > :r2))
		;setup active edge list, edge starts and coverage
		(vp-xor-rr :r1 :r1)
		(assign '(:r1) '((:rsp slot_tracker_list)))
		(assign '((:r0 +canvas_edges_start)) '(:r1))
		(vpif '(:r1 = 0))
			(assign '((:r0 +canvas_pixmap)) '(:r1))
			(assign '((:r1 +pixmap_height)) '(:r0))
			(vp-mul-cr (* 8 +ptr_size) :r0)
			(call :sys_mem :calloc '(:r0) '(:r0 _))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0) '((:r1 +canvas_edges_start)))
		(endif)
		(assign '((:rsp slot_this)) '(:r0))
		(assign '((:r0 +canvas_flags)) '(:r1))
		(vpif '(:r1 /= 0))
			(assign `(,+max_int ,+min_int) '(:r1 :r2))
			(save-fields :rsp '(slot_min_x slot_max_x) '(:r1 :r2))
			(assign '((:r0 +canvas_coverage)) '(:r1))
			(vpif '(:r1 = 0))
				(assign '((:r0 +canvas_pixmap)) '(:r1))
				(assign '((:r1 +pixmap_width)) '(:r0))
				(vp-add-cr 1 :r0)
				(call :sys_mem :calloc '(:r0) '(:r0 _))
				(assign '((:rsp slot_this)) '(:r1))
				(assign '(:r0) '((:r1 +canvas_coverage)))
			(endif)
		(endif)

		;edge pointers into edge starts
		(assign '((:rsp slot_this)) '(:r0))
		(call :array :get_both '((:r0 +canvas_edges)) '(_ (:rsp slot_tracker_node) (:rsp slot_tracker_last)))
		(vp-rdef (edges_start edge_node edge_last edge_tmp edge_list_head))
		(assign '((:rsp slot_this)) `(,edges_start))
		(assign `((,edges_start +canvas_edges_start)) `(,edges_start))
		(load-fields :rsp '(slot_tracker_node slot_tracker_last) `(,edge_node ,edge_last))
		(loop-start)
			(vp-load-rcr-i edge_node +edge_ys edge_list_head)
			(vp-mul-cr +ptr_size edge_list_head)
			(vp-add-rr edges_start edge_list_head)
			(ln-add-fnode edge_list_head 0 edge_node edge_tmp)
			(vp-add-cr +edge_size edge_node)
		(loop-until `(,edge_node = ,edge_last))

		;for each scanline
		(loop-start)
			(load-fields :rsp '(slot_ys slot_ye) '(:r0 :r1))
			(breakif '(:r0 >= :r1))
			;not antialiased, or by the non zero rule, the edges in order of x,
			;else only the new ones in
			(load-fields :rsp '(slot_this slot_mode) '(:r0 :r1))
			(assign '((:r0 +canvas_flags)) '(:r0))
			(vpif '(:r0 /= 0) '(:r1 = 0))
				;include new edges that begin on this scanline
				(vp-rdef (tracker_list_head starts_node starts_last starts_new starts_tmp))
				(load-fields :rsp '(slot_this slot_ys) `(,starts_node ,tracker_list_head))
				(assign `((,starts_node +canvas_edges_start)) `(,starts_node))
				(vp-shl-cr (log2 +ptr_size) tracker_list_head)
				(vp-add-rr tracker_list_head starts_node)
				(vp-lea-rcr :rsp slot_tracker_list tracker_list_head)
				(loop-start)
					(ln-next-fnode starts_node starts_last)
					(vp-cpy-rr starts_node starts_new)
					(ln-remove-fnode starts_node starts_last)
					(ln-add-fnode tracker_list_head 0 starts_new starts_tmp)
				(loop-end)
			(else)
				;the active edges are wanted in order of x. They are in order
				;already from the scanline before, but for any that crossed,
				;so they are put into a list that goes down, where each finds
				;its place at the front, and that list is then turned round
				(vp-xor-rr :r0 :r0)
				(assign '(:r0) '((:rsp slot_sorted_list)))
				(vp-rdef (sorted_list_head tracker_node tracker_last tracker_new
					sorted_node sorted_last x1 x2))
				(assign '((& :rsp slot_sorted_list) (& :rsp slot_tracker_list)) (list sorted_list_head tracker_node))
				(loop-start)
					(ln-next-fnode tracker_node tracker_last)
					(vp-cpy-rr tracker_node tracker_new)
					(ln-remove-fnode tracker_node tracker_last)
					(vp-load-rcr-i tracker_new +edge_x x1)
					(loop-flist sorted_list_head 0 sorted_node sorted_last)
						(vp-load-rcr-i sorted_node +edge_x x2)
					(loop-until `(,x1 >= ,x2))
					(ln-add-fnode sorted_last 0 tracker_new tracker_last)
				(loop-end)
				(vp-load-rcr sorted_list_head +ln_fnode_next sorted_node)
				(vp-xor-rr tracker_new tracker_new)
				(vpif `(,sorted_node /= 0))
					(loop-start)
						(vp-load-rcr sorted_node +ln_fnode_next sorted_last)
						(vp-store-rrc tracker_new sorted_node +ln_fnode_next)
						(vp-cpy-rr sorted_node tracker_new)
						(vp-cpy-rr sorted_last sorted_node)
					(loop-until `(,sorted_node = 0))
				(endif)
				(assign (list tracker_new) '((:rsp slot_tracker_list)))

				;the edges that begin on this scanline, put in order among
				;themselves. Each is looked for from where the one before it
				;went in, if it is no less than that, so edges that come
				;nearly in order, going up or going down, cost little
				(vp-xor-rr :r0 :r0)
				(assign '(:r0) '((:rsp slot_sorted_list)))
				(vp-rdef (starts_head starts_new sorted_list_head sorted_hint
					sorted_node sorted_last x1 x2 tmp))
				(load-fields :rsp '(slot_this slot_ys) `(,starts_head ,sorted_list_head))
				(assign `((,starts_head +canvas_edges_start)) `(,starts_head))
				(vp-shl-cr (log2 +ptr_size) sorted_list_head)
				(vp-add-rr sorted_list_head starts_head)
				(vp-lea-rcr :rsp slot_sorted_list sorted_list_head)
				(vp-cpy-rr sorted_list_head sorted_hint)
				(loop-start)
					(vp-load-rcr starts_head +ln_fnode_next starts_new)
					(breakif `(,starts_new = 0))
					(vp-load-rcr starts_new +ln_fnode_next tmp)
					(vp-store-rrc tmp starts_head +ln_fnode_next)
					(vp-load-rcr-i starts_new +edge_x x1)
					(vp-cpy-rr sorted_list_head sorted_last)
					(vpif `(,sorted_hint /= ,sorted_list_head))
						(vp-load-rcr-i sorted_hint +edge_x x2)
						(vpif `(,x1 >= ,x2))
							(vp-cpy-rr sorted_hint sorted_last)
						(endif)
					(endif)
					(loop-start)
						(vp-load-rcr sorted_last +ln_fnode_next sorted_node)
						(breakif `(,sorted_node = 0))
						(vp-load-rcr-i sorted_node +edge_x x2)
						(breakif `(,x1 <= ,x2))
						(vp-cpy-rr sorted_node sorted_last)
					(loop-end)
					(vp-store-rrc sorted_node starts_new +ln_fnode_next)
					(vp-store-rrc starts_new sorted_last +ln_fnode_next)
					(vp-cpy-rr sorted_last sorted_hint)
				(loop-end)

				;and those are merged into the active edges
				(vp-rdef (tracker_last sorted_node tracker_node x1 x2 tmp))
				(assign '((& :rsp slot_tracker_list) (:rsp slot_sorted_list)) (list tracker_last sorted_node))
				(vpif `(,sorted_node /= 0))
					(loop-start)
						(vp-load-rcr-i sorted_node +edge_x x1)
						(loop-start)
							(vp-load-rcr tracker_last +ln_fnode_next tracker_node)
							(breakif `(,tracker_node = 0))
							(vp-load-rcr-i tracker_node +edge_x x2)
							(breakif `(,x2 >= ,x1))
							(vp-cpy-rr tracker_node tracker_last)
						(loop-end)
						(vp-load-rcr sorted_node +ln_fnode_next tmp)
						(vp-store-rrc tracker_node sorted_node +ln_fnode_next)
						(vp-store-rrc sorted_node tracker_last +ln_fnode_next)
						(vp-cpy-rr sorted_node tracker_last)
						(vp-cpy-rr tmp sorted_node)
					(loop-until `(,sorted_node = 0))
				(endif)
			(endif)

			;antialiased ?
			(assign '((:rsp slot_this)) '(:r0))
			(assign '((:r0 +canvas_flags)) '(:r0))
			(vpif '(:r0 /= 0))
				;draw edges into coverage mask
				(vp-rdef (tracker_node mask xo cx cx1 x xp xb xm min_x max_x w v))
				;the sample of this sub scanline across a pixel, xo, and its bit, xm
				(load-fields :rsp '(slot_this slot_ys slot_min_x slot_max_x slot_mode) `(,cx1 ,x ,min_x ,max_x ,v))
				(assign `((,cx1 +canvas_coverage) (,cx1 +canvas_cx) (,cx1 +canvas_cx1)) `(,mask ,cx ,cx1))
				(vp-shl-cr +fp_shift cx)
				(vp-shl-cr +fp_shift cx1)
				(vp-and-cr 7 x)
				(vp-cpy-cr 1 xm)
				(vp-shl-rr x xm)
				(vp-shl-cr 2 x)
				(vp-lea-pr 'sample_offsets xo)
				(vp-load-rrr-i xo x xo)
				(vp-lea-rcr :rsp slot_tracker_list tracker_node)
				(vpif `(,v = 0))
					;odd even
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(vp-load-rcr-i tracker_node +edge_x x)
						(vp-add-rr xo x)
						(vpif `(,x < ,cx))
							(vp-cpy-rr cx x)
						(elseif `(,x > ,cx1))
							(vp-cpy-rr cx1 x)
						(endif)
						(vp-asr-cr +fp_shift x)
						(vp-load-rrr-ub mask x xb)
						(vp-min-rr x min_x)
						(vp-max-rr x max_x)
						(vp-xor-rr xm xb)
						(vp-store-rrr-b xb mask x)
					(loop-end)
				(else)
					;non zero
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(vp-simd vp-load-rcr-i `(,tracker_node) `(,+edge_x ,+edge_w) `(,x ,w))
						(vp-add-rr xo x)
						(vpif `(,x < ,cx))
							(vp-cpy-rr cx x)
						(elseif `(,x > ,cx1))
							(vp-cpy-rr cx1 x)
						(endif)
						(vp-asr-cr +fp_shift x)
						(vp-load-rrr-ub mask x xb)
						(vp-min-rr x min_x)
						(vp-xor-rr xm xb)
						(vp-store-rrr-b xb mask x)
						(loop-start)
							(vp-load-rcr tracker_node +ln_fnode_next tracker_node)
							(vp-load-rcr-i tracker_node +edge_w v)
							(vp-add-rr v w)
						(loop-until `(,w = 0))
						(vp-load-rcr-i tracker_node +edge_x x)
						(vp-add-rr xo x)
						(vpif `(,x < ,cx))
							(vp-cpy-rr cx x)
						(elseif `(,x > ,cx1))
							(vp-cpy-rr cx1 x)
						(endif)
						(vp-asr-cr +fp_shift x)
						(vp-load-rrr-ub mask x xb)
						(vp-max-rr x max_x)
						(vp-xor-rr xm xb)
						(vp-store-rrr-b xb mask x)
					(loop-end)
				(endif)
				(assign (list min_x max_x) '((:rsp slot_min_x) (:rsp slot_max_x)))

				;flush coverage mask to scan line
				(load-fields :rsp '(slot_ys slot_ye slot_cy1) '(:r0 :r1 :r2))
				(vp-cpy-rr :r0 :r3)
				(vp-and-cr 7 :r3)
				(gotoif '(:r3 = 7) 'flush_mask)
				(vp-add-cr 1 :r0)
				(gotoif '(:r0 = :r1) 'flush_mask)
				(breakif '(:r0 < :r2))
			(vp-label 'flush_mask)
				(vp-rdef (this c x y x1 mask m om max_x mask_to_coverage v)
					(method-input :canvas :span))
				(load-fields :rsp '(slot_this slot_ys slot_min_x slot_max_x) (list this y x max_x))
				(vp-shr-cr 3 y)
				(breakif `(,x > ,max_x))
				(vp-add-cr 1 max_x)
				(vp-xor-rr om om)
				(assign (list max_x y om) '((:rsp slot_max_x) (:rsp slot_y) (:rsp slot_om)))
				(loop-start)
					(assign '(($ mask_to_coverage)) (list mask_to_coverage))
					(vp-load-rcr this +canvas_coverage mask)
					;the pixel an edge is on is the first of the run that
					;begins there, so the cover from it on has that edge in
					(vp-load-rrr-ub mask x c)
					(vp-xor-rr c om)
					(vp-xor-rr c c)
					(vp-store-rrr-b c mask x)
					;to the next edge: eight bytes at a time while eight are in the
					;row and all 0, then a byte at a time
					(vp-lea-rcr x 1 x1)
					(vp-lea-rcr x1 8 m)
					(vpif `(,m <= ,max_x))
						(loop-start)
							(vp-load-rrr mask x1 c)
							(breakif `(,c /= 0))
							(vp-cpy-rr m x1)
							(vp-add-cr 8 m)
						(loop-until `(,m > ,max_x))
					(endif)
					(vpif `(,x1 < ,max_x))
						(loop-start)
							(vp-load-rrr-ub mask x1 c)
							(breakif `(,c /= 0))
							(vp-add-cr 1 x1)
						(loop-until `(,x1 >= ,max_x))
					(endif)
					(vp-load-rrr-ub mask_to_coverage om c)
					(assign (list om x1) '((:rsp slot_om) (:rsp slot_x)))
					;an edge at or past the right of the clip is on the pixel
					;after its last, where nothing is drawn
					(assign (list (list this '+canvas_cx1)) (list v))
					(vpif `(,c /= 0) `(,x < ,v))
						(call :canvas :span_noclip (list this c x y x1) (list this))
					(endif)
					(assign '((:rsp slot_this) (:rsp slot_x) (:rsp slot_max_x) (:rsp slot_y) (:rsp slot_om)) (list this x max_x y om))
				(loop-until `(,x >= ,max_x))
				(assign `(,+max_int ,+min_int) '(:r0 :r1))
				(save-fields :rsp '(slot_min_x slot_max_x) '(:r0 :r1))
			(else)
				;draw spans for mode
				(vp-rdef (this c x1 ys x2 w v tracker_node) (method-input :canvas :span))
				(assign '((:rsp slot_mode) (:rsp slot_this) (& :rsp slot_tracker_list)) (list v this tracker_node))
				(vpif `(,v = ,+winding_odd_even))
					;odd even
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(assign '((:rsp slot_ys)) (list ys))
						(vp-load-rcr-i tracker_node +edge_x x1)
						(vp-load-rcr tracker_node +ln_fnode_next tracker_node)
						(vp-load-rcr-i tracker_node +edge_x x2)
						(vp-simd vp-asr-cr `(,+fp_shift) `(,x1 ,x2))
						(assign (list tracker_node) '((:rsp slot_tracker_node)))
						(call :canvas :span (list this 0x80 x1 ys x2) (list this))
						(assign '((:rsp slot_tracker_node)) (list tracker_node))
					(loop-end)
				(else)
					;non zero
					(loop-start)
						(ln-next-fnode tracker_node tracker_node)
						(assign '((:rsp slot_ys)) (list ys))
						(vp-simd vp-load-rcr-i `(,tracker_node) `(,+edge_x ,+edge_w) `(,x1 ,w))
						(loop-start)
							(vp-load-rcr tracker_node +ln_fnode_next tracker_node)
							(vp-load-rcr-i tracker_node +edge_w v)
							(vp-add-rr v w)
						(loop-until `(,w = 0))
						(vp-load-rcr-i tracker_node +edge_x x2)
						(vp-simd vp-asr-cr `(,+fp_shift) `(,x1 ,x2))
						(assign (list tracker_node) '((:rsp slot_tracker_node)))
						(call :canvas :span (list this 0x80 x1 ys x2) (list this))
						(assign '((:rsp slot_tracker_node)) (list tracker_node))
					(loop-end)
				(endif)
			(endif)

			;next sub scanline
			(load-fields :rsp '(slot_ys slot_cy1) '(:r0 :r1))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:rsp slot_ys)))
			(breakif '(:r0 >= :r1))

			;step the edges and remove any dead ones
			(vp-rdef (tracker_node tracker_last ys x dda))
			(assign '((& :rsp slot_tracker_list) (:rsp slot_ys)) (list tracker_node ys))
			(loop-start)
			(vp-label 'start)
				(ln-next-fnode tracker_node tracker_last)
				(vp-load-rcr-i tracker_node +edge_ye x)
				(vpif `(,x /= ,ys))
					(vp-simd vp-load-rcr-i `(,tracker_node) `(,+edge_x ,+edge_dda) `(,x ,dda))
					(vp-add-rr dda x)
					(vp-store-rrc-i x tracker_node +edge_x)
					(goto 'start)
				(endif)
				(ln-remove-fnode tracker_node tracker_last)
			(loop-end)
		(loop-end)
	(endif)

	(exit :canvas :fpoly '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'sample_offsets)
	;where across a pixel each of its 8 scan lines is sampled, less the
	;half that (:set_edges) put on. They are the middles of eighths, the
	;0.0625 more, so an edge on a whole number, or a hair off one, has
	;every sample of a pixel to the same side of it. 16.16 fixed, 0.25 0.875
	;0.5 0.125 0.75 0.375 0.0 0.625 less 0.4375
	(vp-int -12288 28672 4096 -20480 20480 -4096 -28672 12288)

(vp-label 'mask_to_coverage)
	(apply (const vp-byte) (map (lambda (m)
		(/ (* 0x80 (apply (const +) (map (lambda (s)
			(logand 1 (>> m s))) (const (push (list quote) (range 0 8)))))) 8)) (range 0 256)))

(def-func-end)
