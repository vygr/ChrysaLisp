(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/fixed/class.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././pixmap/class.inc")
(include "././path/class.inc")

(def-method :canvas :lisp_create)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :r14, :f0-:f15

	(entry :canvas :lisp_create '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(defq in (method-input :canvas :create))
	(list-bind-args :r1 in '(:num :num :num))
	(call :canvas :create in '(:r1))
	(vp-pop :r0)

	(exit :canvas :lisp_create '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(create-canvas width height scale)" +error_msg_wrong_types))
	(signature '(:NUM :NUM :NUM)))

(def-func-end)

(def-method :canvas :lisp_create_pixmap)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15

	(entry :canvas :lisp_create_pixmap '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(defq in (method-input :canvas :create_pixmap))
	(list-bind-args :r1 in '(:pixmap))
	(call :canvas :create_pixmap in '(:r1))
	(vp-pop :r0)

	(exit :canvas :lisp_create_pixmap '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(create-canvas-pixmap pixmap)" +error_msg_wrong_types))
	(signature '(:PIXMAP)))

(def-func-end)

(def-method :canvas :lisp_fill)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6

	(entry :canvas :lisp_fill '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(defq in (method-input :pixmap :fill))
	(list-bind-args :r1 in '(:canvas :num))
	(vp-push (first in))
	(assign `((,(first in) +canvas_pixmap)) `(,(first in)))
	(vpif `(,(first in) /= 0))
		(call :pixmap :fill in)
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)

	(exit :canvas :lisp_fill '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-fill canvas argb)" +error_msg_wrong_types))
	(signature '(:CANVAS :NUM)))

(def-func-end)

(def-method :canvas :lisp_swap)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :canvas :lisp_swap '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(defq in (method-input :canvas :swap))
	(list-bind-args :r1 in '(:canvas :num))

	;check we are on a GUI capable node before attempting to swap
	(fn-bind 'sys/statics/statics :r2)
	(assign '((:r2 statics_sys_load_host_gui_funcs)) '(:r2))
	(vpif '(:r2 /= 0))
		(call :canvas :swap in '(:r0))
		(call :obj :ref '(:r0) '(:r1))
	(else)
		; :nil safely without crashing.
		(assign '((:rsp 0)) '(:r1))
		(assign '((:r1 +lisp_sym_nil)) '(:r1))
		(class/obj/ref :r1 :r2)
	(endif)

	(vp-pop :r0)

	(exit :canvas :lisp_swap '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-swap canvas flags)" +error_msg_wrong_types))
	(signature '(:CANVAS :NUM)))

(def-func-end)

;a call of the host GUI driver is made on the kernel task's stack, the
;frame of the caller is the user data, and holds the args and the result

(defun shader-callback-begin ()
(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-cpy-rr :rsp :r1)
	(vp-alloc 16)
	(vp-and-cr -16 :rsp)
	(assign '(:r0 :r1) '((:rsp 0) (:rsp 8))))

(defun shader-callback-end ()
	(assign '((:rsp 8)) '(:rsp))
	(vp-ret))

(defun shader-on-gui-node ()
	;is there a host GUI driver on this node ?
	(fn-bind 'sys/statics/statics :r3)
	(assign '((:r3 statics_sys_load_host_gui_funcs)) '(:r3)))

(def-method :canvas :lisp_shade 16)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;the GPU draws the shader into the texture of the canvas, the
	;pixmap is not used, and is not changed. The part of the texture
	;given is drawn, all of it if x1 is not greater than x. The result
	;is 0 if not drawn, the GPU is busy, -1 if the shader did not build.

	(structure local 0
		(ptr this block lisp)
		(long shader x y x1 y1 result))

	(entry :canvas :lisp_shade '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_lisp)))
	(list-bind-args :r1 '(:r0 :r2 :r4 :r5 :r6 :r7 :r8) '(:canvas :num :obj :num :num :num :num))
	(vp-xor-rr :r9 :r9)
	(assign '(:r0 :r2 :r4 :r5 :r6 :r7 :r8 :r9)
		'((:rsp local_this) (:rsp local_shader) (:rsp local_block) (:rsp local_x)
		(:rsp local_y) (:rsp local_x1) (:rsp local_y1) (:rsp local_result)))
	(shader-on-gui-node)
	(vpif '(:r3 /= 0))
		(call :sys_task :callback '(:rsp ($ callback)))
	(endif)
	(assign '((:rsp local_this) (:rsp local_result)) '(:r0 :r8))
	(vpif '(:r8 > 0))
		(call :obj :ref '(:r0) '(:r1))
	(elseif '(:r8 < 0))
		;the shader did not build
		(call :num :create '(:r8) '(:r1))
	(else)
		(assign '((:rsp local_lisp)) '(:r1))
		(assign '((:r1 +lisp_sym_nil)) '(:r1))
		(class/obj/ref :r1 :r2)
	(endif)
	(assign '((:rsp local_lisp)) '(:r0))
	(vp-free local_size)

	(exit :canvas :lisp_shade '(:r0 :r1))
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = user data

	(def-vars
		(ptr user this old_stack pixmap texture block part)
		(long tex_id)
		(uint w h)
		(struct rect host_gui_rect_size))

	(vp-cpy-rr :rsp :r1)
	(push-scope)
	(vp-and-cr -16 :rsp)
	(entry {user, old_stack})

	(assign {user->local_this} {this})
	(vpifnot {this->+canvas_flags & +canvas_flag_shader})
		;no texture a shader can draw into, so make one, the size the canvas is shown at
		(assign {this->+canvas_pixmap, this->+canvas_texture, 0, 0} {pixmap, texture, tex_id, w})
		(vpif {pixmap})
			(assign {pixmap->+pixmap_width / this->+canvas_scale,
				pixmap->+pixmap_height / this->+canvas_scale} {w, h})
		(elseif {texture})
			(assign {texture->+texture_width, texture->+texture_height} {w, h})
		(endif)
		(vpif {w})
			(host-gui-call :host_gui :shader_texture {w, h} {tex_id})
		(endif)
		(vpif {tex_id})
			(assign {this->+canvas_texture} {texture})
			(call :texture :create {tex_id, w, h} {this->+canvas_texture})
			(call :texture :deref_if {texture})
			(assign {this->+canvas_flags | +canvas_flag_shader} {this->+canvas_flags})
		(endif)
	(endif)
	(vpif {this->+canvas_flags & +canvas_flag_shader})
		(assign {user->local_block, this->+canvas_texture} {block, texture})
		;the part to draw, no rect is all of it
		(assign {0} {part})
		(vpif {user->local_x1 > user->local_x})
			(assign {user->local_x, user->local_y,
				user->local_x1 - user->local_x, user->local_y1 - user->local_y, &rect}
				{rect.host_gui_rect_x, rect.host_gui_rect_y, rect.host_gui_rect_w, rect.host_gui_rect_h, part})
		(endif)
		(host-gui-call :host_gui :shader_draw {user->local_shader, texture->+texture_handle,
			&block->+str_data, block->+str_length, part} {user->local_result})
	(endif)

	(assign {old_stack} '(:rsp))
	(pop-scope-syms)
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-shade canvas shader block x y x1 y1)" +error_msg_wrong_types))
	(signature '(:CANVAS :NUM :STR :NUM :NUM :NUM :NUM)))

(def-func-end)

(def-method :canvas :lisp_shader_format)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(long result))

	(entry :canvas :lisp_shader_format '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc local_size)
	(vp-xor-rr :r1 :r1)
	(assign '(:r0 :r1) '((:rsp local_this) (:rsp local_result)))
	(shader-on-gui-node)
	(vpif '(:r3 /= 0))
		(call :sys_task :callback '(:rsp ($ callback)))
	(endif)
	(call :num :create '((:rsp local_result)) '(:r1))
	(assign '((:rsp local_this)) '(:r0))
	(vp-free local_size)

	(exit :canvas :lisp_shader_format '(:r0 :r1))
	(vp-ret)

	(shader-callback-begin)
	(host-gui-call :host_gui :shader_format '() '(:r0))
	(assign '((:rsp 0)) '(:r1))
	(assign '(:r0) '((:r1 local_result)))
	(shader-callback-end)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-shader-format)" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :canvas :lisp_shader_create)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this vertex fragment)
		(long result))

	(entry :canvas :lisp_shader_create '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3) '(:obj :obj))
	(vp-xor-rr :r4 :r4)
	(assign '(:r2 :r3 :r4) '((:rsp local_vertex) (:rsp local_fragment) (:rsp local_result)))
	(shader-on-gui-node)
	(vpif '(:r3 /= 0))
		(call :sys_task :callback '(:rsp ($ callback)))
	(endif)
	(call :num :create '((:rsp local_result)) '(:r1))
	(assign '((:rsp local_this)) '(:r0))
	(vp-free local_size)

	(exit :canvas :lisp_shader_create '(:r0 :r1))
	(vp-ret)

	(shader-callback-begin)
	(assign '((:r0 local_vertex) (:r0 local_fragment)) '(:r5 :r6))
	(assign '((:r5 +str_length) (:r6 +str_length)) '(:r7 :r8))
	(host-gui-call :host_gui :shader_create
		'((& :r5 +str_data) :r7 (& :r6 +str_data) :r8) '(:r0))
	(assign '((:rsp 0)) '(:r1))
	(assign '(:r0) '((:r1 local_result)))
	(shader-callback-end)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-shader-create vertex fragment)" +error_msg_wrong_types))
	(signature '(:STR :STR)))

(def-func-end)

(def-method :canvas :lisp_shader_destroy)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this args)
		(long shader))

	(entry :canvas :lisp_shader_destroy '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc local_size)
	(assign '(:r0 :r1) '((:rsp local_this) (:rsp local_args)))
	(list-bind-args :r1 '(:r2) '(:num))
	(assign '(:r2) '((:rsp local_shader)))
	(shader-on-gui-node)
	(vpif '(:r3 /= 0))
		(call :sys_task :callback '(:rsp ($ callback)))
	(endif)
	(assign '((:rsp local_args)) '(:r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(assign '((:r1 0)) '(:r1))
	(class/obj/ref :r1 :r2)
	(assign '((:rsp local_this)) '(:r0))
	(vp-free local_size)

	(exit :canvas :lisp_shader_destroy '(:r0 :r1))
	(vp-ret)

	(shader-callback-begin)
	(host-gui-call :host_gui :shader_destroy '((:r0 local_shader)))
	(shader-callback-end)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-shader-destroy shader)" +error_msg_wrong_types))
	(signature '(:NUM)))

(def-func-end)

(def-method :canvas :lisp_next_frame)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8, :r14, :f0-:f15

	(structure local 0
		(ptr this canvas))

	(vp-alloc local_size)
	(entry :canvas :lisp_next_frame '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r0) '(:canvas))
	(assign '(:r0 (:r0 +canvas_pixmap)) '((:rsp local_canvas) :r0))
	(vpif '(:r0 /= 0))
		(call :pixmap :next_frame '(:r0))
	(endif)
	(assign '((:rsp local_canvas)) '(:r1))
	(class/obj/ref :r1 :r2)

	(exit :canvas :lisp_next_frame '((:rsp local_this) :r1))
	(vp-free local_size)
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-next-frame canvas)" +error_msg_wrong_types))
	(signature '(:CANVAS)))

(def-func-end)

