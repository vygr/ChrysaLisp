(def-method :canvas :lisp_swap)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(entry :canvas :lisp_swap '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(defq in (method-input :canvas :swap))
	(list-bind-args :r1 in '(:canvas :num))

	;check we are on a GUI capable node before attempting to swap
	(fn-bind 'sys/statics/statics :r2)
	(assign '((:r2 statics_sys_load_host_gui_funcs)) '(:r2))
	(vpif '(:r2 /= 0))
		(call :canvas :swap in '(:r0))
		(call :obj :ref '(:r0) '(:r1))
	(else)
		; :nil safely without crashing.
		(assign '((:rsp 0)) '(:r1))
		(assign '((:r1 +lisp_sym_nil)) '(:r1))
		(class/obj/ref :r1 :r2)
	(endif)

	(vp-pop :r0)

	(exit :canvas :lisp_swap '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-swap canvas flags)" +error_msg_wrong_types))
	(signature '(:CANVAS :NUM))

(def-func-end)

;a call of the host GUI driver is made on the kernel task's stack, the
;frame of the caller is the user data, and holds the args and the result

(defun shader-on-gui-node ()
	;is there a host GUI driver on this node ?
	(fn-bind 'sys/statics/statics :r3)
	(assign '((:r3 statics_sys_load_host_gui_funcs)) '(:r3)))

(def-method :canvas :lisp_target)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(canvas-target canvas) -> 0 | handle, the texture of the canvas made
	;one the GPU can draw triangles into, if it is not, the size the
	;canvas is shown at, and its handle as the host GUI driver has it. The
	;pixmap is not used, and is not changed. 0 on a node with no GUI, or
	;whose GUI has no such texture.

	(structure slot 0
		(ptr this lisp)
		(long result))

	(entry :canvas :lisp_target '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_lisp)))
	(list-bind-args :r1 '(:r0) '(:canvas))
	(vp-xor-rr :r9 :r9)
	(save-fields :rsp '(slot_this slot_result) '(:r0 :r9))
	(shader-on-gui-node)
	(vpif '(:r3 /= 0))
		(call :sys_task :callback '(:rsp ($ callback)))
	(endif)
	(call :num :create '((:rsp slot_result)) '(:r1))
	(assign '((:rsp slot_lisp)) '(:r0))
	(vp-free slot_size)

	(exit :canvas :lisp_target '(:r0 :r1))
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = user data, the frame above

	(structure cb 0
		(ptr user this texture)
		(long tex_id)
		(uint w h))

	(entry :sys_task :task_callback '(:r0))
	(vp-alloc cb_size)
	(assign '((:r0 slot_this)) '(:r1))
	(save-fields :rsp '(cb_user cb_this) '(:r0 :r1))

	(assign '((:r1 +canvas_flags)) '(:r2))
	(vp-and-cr +canvas_flag_shader :r2)
	(vpif '(:r2 = 0))
		;no texture the GPU can draw into, so make one, the size the canvas is shown at
		(load-fields :r1 '(+canvas_pixmap +canvas_texture) '(:r2 :r3))
		(vp-xor-rr :r4 :r4)
		(vp-xor-rr :r5 :r5)
		(vpif '(:r2 /= 0))
			(assign '((:r2 +pixmap_width) (:r2 +pixmap_height) (:r1 +canvas_scale)) '(:r4 :r5 :r6))
			(vp-div-rr-u :r6 :r4)
			(vp-div-rr-u :r6 :r5)
		(elseif '(:r3 /= 0))
			(load-fields :r3 '(+texture_width +texture_height) '(:r4 :r5))
		(endif)
		(vp-xor-rr :r0 :r0)
		(save-fields :rsp '(cb_texture cb_tex_id cb_w cb_h) '(:r3 :r0 :r4 :r5))
		(vpif '(:r4 /= 0))
			(host-gui-call :host_gui :target_texture '(:r4 :r5) '(:r0))
			(assign '(:r0) '((:rsp cb_tex_id)))
		(endif)
		(vpif '(:r0 /= 0))
			(assign '((:rsp cb_this)) '(:r1))
			(assign '((:r1 +canvas_texture)) '(:r2))
			(assign '(:r2) '((:rsp cb_texture)))
			(call :texture :create '(:r0 (:rsp cb_w) (:rsp cb_h)) '(:r0))
			(assign '((:rsp cb_this)) '(:r1))
			(assign '(:r0) '((:r1 +canvas_texture)))
			(call :texture :deref_if '((:rsp cb_texture)))
			(assign '((:rsp cb_this)) '(:r1))
			(assign '((:r1 +canvas_flags)) '(:r2))
			(vp-or-cr +canvas_flag_shader :r2)
			(assign '(:r2) '((:r1 +canvas_flags)))
		(endif)
	(endif)
	;its handle, if it has one
	(assign '((:rsp cb_this)) '(:r1))
	(assign '((:r1 +canvas_flags)) '(:r2))
	(vp-and-cr +canvas_flag_shader :r2)
	(vpif '(:r2 /= 0))
		(assign '((:r1 +canvas_texture) (:rsp cb_user)) '(:r3 :r0))
		(assign '((:r3 +texture_handle)) '(:r3))
		(assign '(:r3) '((:r0 slot_result)))
	(endif)

	(exit :sys_task :task_callback '())
	(vp-free cb_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-target canvas)" +error_msg_wrong_types))
	(signature '(:CANVAS))

(def-func-end)

