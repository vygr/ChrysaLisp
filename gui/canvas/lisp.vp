(def-method :canvas :lisp_resize)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(entry :canvas :lisp_resize '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(defq in (method-input :pixmap :resize))
	(list-bind-args :r1 in '(:canvas :canvas))
	(vp-push (first in))
	(assign `((,(first in) +canvas_pixmap) (,(second in) +canvas_pixmap)) in)
	(vpif `(,(first in) /= 0) `(,(second in) /= 0))
		(call :pixmap :resize in)
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)

	(exit :canvas :lisp_resize '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-resize canvas canvas)" +error_msg_wrong_types))
	(signature '(:CANVAS :CANVAS))

(def-func-end)

(def-method :canvas :lisp_tile)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(uint x y x1 y1))

	(vp-rdef (x y x1 y1 xp data this args col)
		'(:r9 :r10 :r11 :r12 :r13 :r14))

	(entry :canvas :lisp_tile `(,this ,args))

	(gotoif-lisp-args-sig 'error args 6)

	(vp-alloc slot_size)
	(assign `(,this) '((:rsp slot_this)))

	(list-bind-args args `(,this ,data ,xp ,y ,x1 ,y1)
		'(:canvas :str :num :num :num :num))
	(save-fields :rsp '(slot_x slot_y slot_x1 slot_y1) `(,xp ,y ,x1 ,y1))
	(loop-start)
		(vp-cpy-rr xp x)
		(loop-start)
			(vp-load-rcr-ui data 0 col)
			(vp-add-cr +int_size data)
			(assign `(,col) `((,this +canvas_color)))
			(call :canvas :plot `(,this ,x ,y) `(,this))
			(vp-add-cr 1 x)
		(loop-until `(,x = ,x1))
		(vp-add-cr 1 y)
	(loop-until `(,y = ,y1))

	(load-fields :rsp '(slot_x slot_y slot_x1 slot_y1) '(:r2 :r3 :r0 :r1))
	(vp-sub-rr :r2 :r0)
	(vp-sub-rr :r3 :r1)
	(vp-mul-rr :r1 :r0)
	(call :num :create '(:r0) `(,args))

	(exit :canvas :lisp_tile `((:rsp slot_this) ,args))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(canvas-tile canvas data x1 y1 x2 y2)" +error_msg_wrong_types))
	(signature '(:CANVAS :str :NUM :NUM :NUM :NUM))

(def-func-end)

(def-method :canvas :lisp_flip_x)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
