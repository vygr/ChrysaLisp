(def-method :canvas :lisp_resize)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :f0-:f15

	(entry :canvas :lisp_resize '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(defq in (method-input :pixmap :resize))
	(list-bind-args :r1 in '(:canvas :canvas))
	(vp-push (first in))
	(assign `((,(first in) +canvas_pixmap) (,(second in) +canvas_pixmap)) in)
	(vpif `(,(first in) /= 0) `(,(second in) /= 0))
		(call :pixmap :resize in)
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)

	(exit :canvas :lisp_resize '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-resize canvas canvas)" +error_msg_wrong_types))
	(signature '(:CANVAS :CANVAS)))

(def-func-end)

(def-method :canvas :lisp_ftri)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14

	(entry :canvas :lisp_ftri '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(array-bind-args :r1 '(:r0 :r13))
(errorcase
	(assign '((:r13 +array_length)) '(:r2))
	(gotoif '(:r2 /= 6) 'error1))
	(defq in (method-input :canvas :ftri))
	(array-bind-args :r13 (rest in))
	(call :canvas :ftri in '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :canvas :lisp_ftri '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error1)
	(vp-pop :r0)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-ftri canvas path)" +error_msg_wrong_types))
	(signature '(:CANVAS :PATH)))

(def-func-end)

(def-method :canvas :lisp_tile)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this)
		(uint x y x1 y1))

	(vp-rdef (x y x1 y1 xp data this args col)
		'(:r9 :r10 :r11 :r12 :r13 :r14))

	(entry :canvas :lisp_tile `(,this ,args))

	(errorif-lisp-args-sig 'error :r1 6)

	(push-scope)
	(assign `(,this) {this})

	(list-bind-args args `(,this ,data ,xp ,y ,x1 ,y1)
		'(:canvas :str :num :num :num :num))
	(assign `(,xp ,y ,x1 ,y1) {x, y, x1, y1})
	(loop-start)
		(vp-cpy-rr xp x)
		(loop-start)
			(vp-cpy-ir-ui data 0 col)
			(vp-add-cr +int_size data)
			(assign `(,col) `((,this +canvas_color)))
			(call :canvas :plot `(,this ,x ,y) `(,this))
			(vp-add-cr 1 x)
		(loop-until `(,x = ,x1))
		(vp-add-cr 1 y)
	(loop-until `(,y = ,y1))

	(call :num :create {(x1 - x) * (y1 - y)} `(,args))

	(assign {this} `(,this))
	(exit :canvas :lisp_tile `(,this ,args))
	(pop-scope)
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(canvas-tile canvas data x1 y1 x2 y2)" +error_msg_wrong_types))
	(signature '(:CANVAS :str :NUM :NUM :NUM :NUM)))

(def-func-end)

(def-method :canvas :lisp_flip_x)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11

	(entry :canvas :lisp_flip_x '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(defq in (method-input :pixmap :flip_x))
	(list-bind-args :r1 in '(:canvas :canvas))
	(vp-push (first in))
	(assign `((,(first in) +canvas_pixmap) (,(second in) +canvas_pixmap)) in)
	(vpif `(,(first in) /= 0) `(,(second in) /= 0))
		(call :pixmap :flip_x in)
	(endif)
	(vp-pop :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0)

	(exit :canvas :lisp_flip_x '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(canvas-flip-x canvas canvas)" +error_msg_wrong_types))
	(signature '(:CANVAS :CANVAS)))

(def-func-end)
