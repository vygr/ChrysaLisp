(include "lib/asm/func.inc")
(include "lib/consts/colors.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././pixmap/class.inc")

(gen-vtable :canvas)
(gen-create :canvas)
	;inputs
	;:r0 = width (pixels)
	;:r1 = height (pixels)
	;:r2 = aa scale (uint)
	;outputs
	;:r0 = 0 if error, else canvas object (ptr)
	;trashes
	;:r0-:r7, :r14, :f0-:f15
(gen-create :canvas 'pixmap)
	;inputs
	;:r0 = pixmap object (ptr)
	;outputs
	;:r0 = 0 if error, else canvas object (ptr)
	;trashes
	;:r0-:r5, :r14, :f0-:f15

(def-method :canvas :init)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = width (pixels)
	;:r3 = height (pixels)
	;:r4 = aa scale (uint)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7, :f0-:f15

	(entry :canvas :init '(:r0 :r1 :r2 :r3 :r4))
	(assign '(:r2 :r3 :r4) '((:r0 +canvas_cx1) (:r0 +canvas_cy1) (:r0 +canvas_scale)))

	;init parent
	(s-call :canvas :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		(vp-push :r0)
		(assign '(0 +argb_black) '(:r1 :r2))
		(assign '(:r1 :r1 :r1 :r1 :r1 :r1 :r2)
			'((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_flags)
			(:r0 +canvas_edges_start) (:r0 +canvas_coverage) (:r0 +canvas_texture) (:r0 +canvas_color)))
		(assign '(:r0 (:r0 +canvas_cx1) (:r0 +canvas_cy1) (:r0 +canvas_scale)) '(:r3 :r0 :r1 :r2))
		(assign '(:r0 :r1) '((:r3 +view_w) (:r3 +view_h)))
		(vp-simd vp-mul-rr '(:r2) '(:r0 :r1))
		(assign '(:r0 :r1) '((:r3 +canvas_cx1) (:r3 +canvas_cy1)))

		;alloc pixmap, type premul 32bit !
		(call :pixmap :create '(:r0 :r1 -32) '(:r0))
		(assign '((:rsp 0)) '(:r1))
		(assign '(:r0) '((:r1 +canvas_pixmap)))

		;edge array
		(call :array :create :nil '(:r1))
		(vp-pop :r0)
		(assign '(:r1) '((:r0 +canvas_edges)))
	(endif)

	(exit :canvas :init '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :canvas :init_pixmap)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = pixmap object (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :f0-:f15

	(entry :canvas :init_pixmap '(:r0 :r1 :r2))
	(assign '(:r2) '((:r0 +canvas_pixmap)))

	;init parent
	(s-call :canvas :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		(vp-push :r0)
		(assign '(0 1 +argb_black) '(:r1 :r2 :r3))
		(assign '(:r1 :r1 :r1 :r1 :r1 :r2 :r3)
			'((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_flags)
			(:r0 +canvas_edges_start) (:r0 +canvas_coverage)
			(:r0 +canvas_scale) (:r0 +canvas_color)))
		(assign '((:r0 +canvas_pixmap)) '(:r1))
		(assign '((:r1 +pixmap_width) (:r1 +pixmap_height) (:r1 +pixmap_texture)) '(:r1 :r2 :r3))
		(assign '(:r1 :r2 :r1 :r2 :r3) '((:r0 +view_w) (:r0 +view_h) (:r0 +canvas_cx1) (:r0 +canvas_cy1)
			(:r0 +canvas_texture)))
		(vpif '(:r3 /= 0))
			(class/obj/ref :r3 :r1)
		(endif)

		;ref pixmap
		(assign '((:rsp 0)) '(:r0))
		(call :canvas :ref '((:r0 +canvas_pixmap)))

		;edge array
		(call :array :create :nil '(:r1))
		(vp-pop :r0)
		(assign '(:r1) '((:r0 +canvas_edges)))
	(endif)

	(exit :canvas :init_pixmap '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :canvas :deinit)
	;inputs
	;:r0 = canvas object (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-push :r0)

	;free edge arrays
	(assign '((:rsp 0)) '(:r0))
	(call :array :deref '((:r0 +canvas_edges)))
	(assign '((:rsp 0)) '(:r0))
	(call :sys_mem :free '((:r0 +canvas_edges_start)))

	;free alias buffers
	(assign '((:rsp 0)) '(:r0))
	(call :sys_mem :free '((:r0 +canvas_coverage)))

	;free any canvas texture
	(assign '((:rsp 0)) '(:r0))
	(call :texture :deref_if '((:r0 +canvas_texture)))

	;free pixel buffer, if it has not been freed by a swap
	(assign '((:rsp 0)) '(:r0))
	(call :pixmap :deref_if '((:r0 +canvas_pixmap)))

	(vp-pop :r0)
	(s-jump :canvas :deinit '(:r0))

(def-func-end)

(def-method :canvas :swap)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = canvas upload flags (uint)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this pixmap texture)
		(int flags))

	(push-scope)
	(entry :canvas :swap {this, flags})

	;a negative number is the other way, the texture back to the pixmap
	(assign {this->+canvas_pixmap} {pixmap})
	(vpif {flags < 0})
		(call :canvas :read {this})
	;a canvas that has freed its pixmap has nothing new to show
	(elseif {pixmap})
	(vpifnot {flags & +swap_flag_keep})
		;must be in premul alpha format
		(call :pixmap :as_premul {pixmap})

		;scale the pixmap if needed
		(vpif {this->+canvas_scale = 1})
			(call :pixmap :ref {pixmap} {pixmap})
		(else)
			(call :pixmap :create {pixmap->+pixmap_width / this->+canvas_scale,
				pixmap->+pixmap_height / this->+canvas_scale, -32} {pixmap})
			(call :pixmap :resize {pixmap, this->+canvas_pixmap})
		(endif)

		;upload then ref_if the texture
		(call :pixmap :upload {pixmap, flags & 0xff})
		(assign {this->+canvas_texture} {texture})
		(call :texture :ref_if {pixmap->+pixmap_texture} {this->+canvas_texture})
		(call :texture :deref_if {texture})
		(call :pixmap :deref {pixmap})

		;the texture is now not one a shader can draw into
		(assign {(this->+canvas_flags | +canvas_flag_shader) ^ +canvas_flag_shader} {this->+canvas_flags})
	(endif)

		;free the pixmap if asked. One that is shared lives on in the
		;cache, this only lets go of it. The clip is left as one that
		;nothing is inside, so every draw call is clipped away.
		(vpif {flags & +swap_flag_free})
			(call :pixmap :deref {this->+canvas_pixmap})
			(assign {0, 0x7fffffff, 0x7fffffff, 0, 0}
				{this->+canvas_pixmap, this->+canvas_cx, this->+canvas_cy,
				this->+canvas_cx1, this->+canvas_cy1})
		(endif)
	(endif)

	(exit :canvas :swap {this})
	(pop-scope)
	(return)

(def-func-end)

(def-method :canvas :read 16)
	;inputs
	;:r0 = canvas object (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;the texture of the canvas is read back into its pixmap. The
	;canvas is given a new pixmap, premultiplied, so one that was
	;freed is made again, and one that is shared is left alone.

	(structure local 0
		(ptr this pixmap)
		(long handle ok))

	(def-vars
		(struct frame local_size)
		(ptr this texture pixmap old)
		(uint w h))

	(push-scope)
	(entry :canvas :read {this})

	(assign {this->+canvas_texture} {texture})
	(vpif {texture})
		;a pixmap the size of the texture, for the host GUI driver to fill
		(assign {texture->+texture_width, texture->+texture_height} {w, h})
		(call :pixmap :create {w, h, -32} {pixmap})
		(assign {this, pixmap, texture->+texture_handle, 0}
			{frame.local_this, frame.local_pixmap, frame.local_handle, frame.local_ok})
		(call :sys_task :callback {&frame, $callback})
		(vpif {frame.local_ok})
			;the pixmap of a canvas is its texture times the scale
			(vpif {this->+canvas_scale /= 1})
				(assign {pixmap} {old})
				(call :pixmap :create {w * this->+canvas_scale, h * this->+canvas_scale, -32} {pixmap})
				(call :pixmap :resize {pixmap, old})
				(call :pixmap :deref {old})
			(endif)
			(call :pixmap :deref_if {this->+canvas_pixmap})
			(assign {pixmap} {this->+canvas_pixmap})
			;and all of it can be drawn on
			(call :canvas :set_clip {this, 0, 0, pixmap->+pixmap_width, pixmap->+pixmap_height})
		(else)
			(call :pixmap :deref {pixmap})
		(endif)
	(endif)

	(exit :canvas :read {this})
	(pop-scope)
	(return)

(vp-label 'callback)
	;inputs
	;:r0 = user data

	(def-vars
		(ptr user old_stack pixmap)
		(long ok))

	(vp-cpy-rr :rsp :r1)
	(push-scope)
	(vp-and-cr -16 :rsp)
	(entry {user, old_stack})

	(assign {user->local_pixmap} {pixmap})
	(host-gui-call :host_gui :read_texture {user->local_handle, &pixmap->+pixmap_data,
			pixmap->+pixmap_width, pixmap->+pixmap_height, pixmap->+pixmap_stride}
		{ok})
	(assign {ok} {user->local_ok})

	(assign {old_stack} '(:rsp))
	(pop-scope-syms)
	(return)

(def-func-end)

(def-method :canvas :shade 16)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = shader handle (long)
	;:r2 = inputs block str object (ptr)
	;:r3 = x (pixels)
	;:r4 = y (pixels)
	;:r5 = x1 (pixels)
	;:r6 = y1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = 0 if not drawn, the GPU is busy, -1 if the shader did not build
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;the GPU draws the shader into the texture of the canvas, the
	;pixmap is not used, and is not changed. The part of the texture
	;given is drawn, all of it if x1 is not greater than x.

	(structure local 0
		(ptr this block)
		(long shader x y x1 y1 result))

	(def-vars
		(struct frame local_size))

	(push-scope)
	(entry :canvas :shade {frame.local_this, frame.local_shader, frame.local_block,
		frame.local_x, frame.local_y, frame.local_x1, frame.local_y1})

	(assign {0} {frame.local_result})
	(call :sys_task :callback {&frame, $callback})

	(exit :canvas :shade {frame.local_this, frame.local_result})
	(pop-scope)
	(return)

(vp-label 'callback)
	;inputs
	;:r0 = user data

	(def-vars
		(ptr user this old_stack pixmap texture block)
		(long tex_id)
		(uint w h)
		(struct rect host_gui_rect_size))

	(vp-cpy-rr :rsp :r1)
	(push-scope)
	(vp-and-cr -16 :rsp)
	(entry {user, old_stack})

	(assign {user->local_this} {this})
	(vpifnot {this->+canvas_flags & +canvas_flag_shader})
		;no texture a shader can draw into, so make one, the size the canvas is shown at
		(assign {this->+canvas_pixmap, this->+canvas_texture, 0} {pixmap, texture, tex_id})
		(vpif {pixmap})
			(assign {pixmap->+pixmap_width / this->+canvas_scale,
				pixmap->+pixmap_height / this->+canvas_scale} {w, h})
			(host-gui-call :host_gui :shader_texture {w, h} {tex_id})
		(elseif {texture})
			(assign {texture->+texture_width, texture->+texture_height} {w, h})
			(host-gui-call :host_gui :shader_texture {w, h} {tex_id})
		(endif)
		(vpif {tex_id})
			(assign {this->+canvas_texture} {texture})
			(call :texture :create {tex_id, w, h} {this->+canvas_texture})
			(call :texture :deref_if {texture})
			(assign {this->+canvas_flags | +canvas_flag_shader} {this->+canvas_flags})
		(endif)
	(endif)
	(vpif {this->+canvas_flags & +canvas_flag_shader})
		(assign {user->local_block, this->+canvas_texture} {block, texture})
		(vpif {user->local_x1 > user->local_x})
			(assign {user->local_x, user->local_y,
				user->local_x1 - user->local_x, user->local_y1 - user->local_y}
				{rect.host_gui_rect_x, rect.host_gui_rect_y, rect.host_gui_rect_w, rect.host_gui_rect_h})
			(host-gui-call :host_gui :shader_draw {user->local_shader, texture->+texture_handle,
				&block->+str_data, block->+str_length, &rect} {user->local_result})
		(else)
			(host-gui-call :host_gui :shader_draw {user->local_shader, texture->+texture_handle,
				&block->+str_data, block->+str_length, 0} {user->local_result})
		(endif)
	(endif)

	(assign {old_stack} '(:rsp))
	(pop-scope-syms)
	(return)

(def-func-end)

(def-method :canvas :set_clip)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = x1 (pixels)
	;:r10 = y1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r2, :r7-:r10

	(entry :canvas :set_clip '(:r0 :r7 :r8 :r9 :r10))

	;clip check, with no pixmap the clip stays as one nothing is inside
	(assign '((:r0 +canvas_pixmap)) '(:r2))
	(vpif '(:r2 /= 0))
	(assign '((:r2 +pixmap_width) (:r2 +pixmap_height)) '(:r1 :r2))
	(vpif '(:r7 <= :r9) '(:r8 <= :r10) '(:r7 < :r1) '(:r8 < :r2) '(:r9 >= 0) '(:r10 >= 0))
		(vpif '(:r7 < 0))
			(vp-xor-rr :r7 :r7)
		(endif)
		(vpif '(:r8 < 0))
			(vp-xor-rr :r8 :r8)
		(endif)
		(vp-simd vp-min-rr '(:r1 :r2) '(:r9 :r10))
		(assign '(:r7 :r8 :r9 :r10) '((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_cx1) (:r0 +canvas_cy1)))
	(endif)
	(endif)

	(exit :canvas :set_clip '(:r0))
	(vp-ret)

(def-func-end)

(def-method :canvas :span_noclip)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = coverage (long)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = x1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r9
	;info
	;coverage is 0x0 to 0x80

	(entry :canvas :span_noclip '(:r0 :r1 :r7 :r8 :r9))

	(switch)
	(breakif '(:r1 = 0))
	(assign '((:r0 +canvas_color)) '(:r2))
	(vp-cpy-rr :r2 :r3)
	(vp-shr-cr 24 :r2)
	(vp-and-cr 0xffffff :r3)
	(vp-mul-rr :r2 :r1)
	(vp-shr-cr 7 :r1)
	(vp-shl-cr 24 :r1)
	(vp-add-rr :r3 :r1)
	(call :pixmap :to_premul '(:r1) '(:r1))
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 24 :r2)
	(breakif '(:r2 = 0))
	(vpcase '(:r2 = 0xff))
		(assign '((:r0 +canvas_pixmap)) '(:r3))
		(assign '((:r3 +pixmap_stride) (& :r3 +pixmap_data)) '(:r2 :r3))
		(vp-mul-rr :r2 :r8)
		(vp-simd vp-shl-cr `(,(log2 +int_size)) '(:r7 :r9))
		(vp-add-rr :r8 :r3)
		(loop-start)
			(vp-cpy-rd-i :r1 :r3 :r7)
			(vp-add-cr +int_size :r7)
		(loop-until '(:r7 = :r9))

		(exit :canvas :span_noclip '(:r0))
		(vp-ret)
	(default)
		(vp-simd vp-cpy-cr '(0xff 0x00ff00ff 0xff00ff00) '(:r6 :r4 :r5))
		(vp-sub-rr :r2 :r6)

		(assign '((:r0 +canvas_pixmap)) '(:r3))
		(assign '((:r3 +pixmap_stride) (& :r3 +pixmap_data)) '(:r2 :r3))
		(vp-mul-rr :r2 :r8)
		(vp-simd vp-shl-cr `(,(log2 +int_size)) '(:r7 :r9))
		(vp-add-rr :r8 :r3)
		(vp-simd vp-add-rr '(:r3) '(:r7 :r9))
		(loop-start)
			(vp-cpy-ir-ui :r7 0 :r2)
			(vp-cpy-rr :r2 :r3)

			(vp-simd vp-and-rr '(:r4 :r5) '(:r2 :r3))
			(vp-simd vp-mul-rr '(:r6) '(:r2 :r3))
			(vp-simd vp-shr-cr '(8) '(:r2 :r3))
			(vp-simd vp-and-rr '(:r4 :r5) '(:r2 :r3))
			(vp-add-rr :r3 :r2) (vp-add-rr :r1 :r2)

			(vp-cpy-ri-i :r2 :r7 0)
			(vp-add-cr +int_size :r7)
		(loop-until '(:r7 = :r9))
	(endswitch)

	(exit :canvas :span_noclip '(:r0))
	(vp-ret)

(def-func-end)

(def-method :canvas :span)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = coverage (long)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = x1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r9
	;info
	;coverage is 0x0 to 0x80

	(entry :canvas :span '(:r0 :r1 :r7 :r8 :r9))

	;clip check
	(assign '((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_cx1) (:r0 +canvas_cy1)) '(:r2 :r3 :r4 :r5))
	(vpif '(:r9 > :r7) '(:r9 > :r2) '(:r8 >= :r3) '(:r7 < :r4) '(:r8 < :r5))
		(vp-max-rr :r2 :r7)
		(vp-min-rr :r4 :r9)
		(jump :canvas :span_noclip '(:r0 :r1 :r7 :r8 :r9))
	(endif)

	(exit :canvas :span '(:r0))
	(vp-ret)

(def-func-end)

(def-method :canvas :pick)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = color (argb)
	;trashes
	;:r1-:r8

	(entry :canvas :pick '(:r0 :r7 :r8))

	;clip check
	(assign '((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_cx1) (:r0 +canvas_cy1)) '(:r3 :r4 :r5 :r6))
	(vpif '(:r7 >= :r3) '(:r8 >= :r4) '(:r7 < :r5) '(:r8 < :r6))
		(assign '((:r0 +canvas_pixmap)) '(:r2))
		(assign '((:r2 +pixmap_stride) (& :r2 +pixmap_data)) '(:r1 :r2))
		(vp-mul-rr :r1 :r8)
		(vp-shl-cr (log2 +int_size) :r7)
		(vp-add-rr :r8 :r2)
		(vp-cpy-dr-i :r2 :r7 :r1)
		(jump :pixmap :to_argb '(:r1))
	(endif)
	(vp-xor-rr :r1 :r1)

	(exit :canvas :pick '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :canvas :plot)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r8

	(vp-rdef (this col dcol cx cy cx1 cy1 x y))

	(entry :canvas :plot `(,this ,x ,y))

	;clip check
	(vp-simd vp-cpy-ir-ui `(,this)
		`(,+canvas_cx ,+canvas_cy ,+canvas_cx1 ,+canvas_cy1)
		`(,cx ,cy ,cx1 ,cy1))
	(switch)
	(breakif `(,x < ,cx) `(,y < ,cy) `(,x >= ,cx1) `(,y >= ,cy1))
	(assign `((,this +canvas_color)) `(,col))
	(call :pixmap :to_premul `(,col) `(,col))
	(vp-cpy-rr col dcol)
	(vp-shr-cr 24 dcol)
	(breakif `(,dcol = 0))
	(vpcase `(,dcol = 0xff))
		(assign `((,this +canvas_pixmap)) `(,cx))
		(assign `((,cx +pixmap_stride) (& ,cx +pixmap_data)) `(,dcol ,cx))
		(vp-mul-rr dcol y)
		(vp-shl-cr (log2 +int_size) x)
		(vp-add-rr y cx)
		(vp-cpy-rd-i col cx x)

		(exit :canvas :plot `(,this))
		(vp-ret)
	(default)
		(vp-simd vp-cpy-cr '(0xff 0x00ff00ff 0xff00ff00) `(,cy1 ,cy ,cx1))
		(vp-sub-rr dcol cy1)

		(assign `((,this +canvas_pixmap)) `(,cx))
		(assign `((,cx +pixmap_stride) (& ,cx +pixmap_data)) `(,dcol ,cx))
		(vp-mul-rr dcol y)
		(vp-shl-cr (log2 +int_size) x)
		(vp-simd vp-add-rr `(,y ,cx) `(,cx ,x))

		(vp-cpy-ir-ui x 0 dcol)
		(vp-cpy-rr dcol cx)

		(vp-simd vp-and-rr `(,cy ,cx1) `(,dcol ,cx))
		(vp-simd vp-mul-rr `(,cy1) `(,dcol ,cx))
		(vp-simd vp-shr-cr '(8) `(,dcol ,cx))
		(vp-simd vp-and-rr `(,cy ,cx1) `(,dcol ,cx))
		(vp-add-rr cx dcol) (vp-add-rr col dcol)

		(vp-cpy-ri-i dcol x 0)
	(endswitch)

	(exit :canvas :plot `(,this))
	(vp-ret)

(def-func-end)

(def-method :canvas :fbox)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = w (pixels)
	;:r10 = h (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r9

	(def-vars
		(ptr this)
		(int x y w h))

	(push-scope)
	(entry :canvas :fbox {this, x, y, w, h})

	;clip check
	(switch)
	(breakif {w <= 0 || h <= 0})
	(assign {x + w, y + h} {w, h})
	(breakif {x >= this->+canvas_cx1 || w <= this->+canvas_cx || y >= this->+canvas_cy1 || h <= this->+canvas_cy})
		(vpif {x < this->+canvas_cx})
			(assign {this->+canvas_cx} {x})
		(endif)
		(vpif {w > this->+canvas_cx1})
			(assign {this->+canvas_cx1} {w})
		(endif)
		(vpif {y < this->+canvas_cy})
			(assign {this->+canvas_cy} {y})
		(endif)
		(vpif {h > this->+canvas_cy1})
			(assign {this->+canvas_cy1} {h})
		(endif)
		(loop-start)
			(call :canvas :span_noclip {this, 0x80, x, y, w})
		(loop-until {(y + 1 => y) = h})
	(endswitch)

	(exit :canvas :fbox {this})
	(pop-scope)
	(return)

(def-func-end)
