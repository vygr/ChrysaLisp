(include "lib/asm/func.inc")
(include "lib/consts/colors.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././pixmap/class.inc")

(gen-vtable :canvas)
(gen-create :canvas)
	;inputs
	;:r0 = width (pixels)
	;:r1 = height (pixels)
	;:r2 = aa scale (uint)
	;outputs
	;:r0 = 0 if error, else canvas object (ptr)
	;trashes
	;:r0-:r7, :r14, :d0-:d15
(gen-create :canvas 'pixmap)
	;inputs
	;:r0 = pixmap object (ptr)
	;outputs
	;:r0 = 0 if error, else canvas object (ptr)
	;trashes
	;:r0-:r5, :r14, :d0-:d15

(def-method :canvas :init)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = width (pixels)
	;:r3 = height (pixels)
	;:r4 = aa scale (uint)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7, :d0-:d15

	(entry :canvas :init '(:r0 :r1 :r2 :r3 :r4))
	(save-fields :r0 '(+canvas_cx1 +canvas_cy1 +canvas_scale) '(:r2 :r3 :r4))

	;init parent
	(s-call :canvas :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		(vp-push :r0)
		(assign '(0 +argb_black) '(:r1 :r2))
		(assign '(:r1 :r1 :r1 :r1 :r1 :r1 :r2)
			'((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_flags)
			(:r0 +canvas_edges_start) (:r0 +canvas_coverage) (:r0 +canvas_texture) (:r0 +canvas_color)))
		(assign '(:r0 (:r0 +canvas_cx1) (:r0 +canvas_cy1) (:r0 +canvas_scale)) '(:r3 :r0 :r1 :r2))
		(save-fields :r3 '(+view_w +view_h) '(:r0 :r1))
		(vp-simd vp-mul-rr '(:r2) '(:r0 :r1))
		(save-fields :r3 '(+canvas_cx1 +canvas_cy1) '(:r0 :r1))

		;alloc pixmap, type premul 32bit !
		(call :pixmap :create '(:r0 :r1 -32) '(:r0))
		(assign '((:rsp 0)) '(:r1))
		(assign '(:r0) '((:r1 +canvas_pixmap)))

		;edge array
		(call :array :create :nil '(:r1))
		(vp-pop :r0)
		(assign '(:r1) '((:r0 +canvas_edges)))
	(endif)

	(exit :canvas :init '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :canvas :init_pixmap)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = pixmap object (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d15

	(entry :canvas :init_pixmap '(:r0 :r1 :r2))
	(assign '(:r2) '((:r0 +canvas_pixmap)))

	;init parent
	(s-call :canvas :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		(vp-push :r0)
		(assign '(0 1 +argb_black) '(:r1 :r2 :r3))
		(assign '(:r1 :r1 :r1 :r1 :r1 :r2 :r3)
			'((:r0 +canvas_cx) (:r0 +canvas_cy) (:r0 +canvas_flags)
			(:r0 +canvas_edges_start) (:r0 +canvas_coverage)
			(:r0 +canvas_scale) (:r0 +canvas_color)))
		(assign '((:r0 +canvas_pixmap)) '(:r1))
		(assign '((:r1 +pixmap_width) (:r1 +pixmap_height) (:r1 +pixmap_texture)) '(:r1 :r2 :r3))
		(assign '(:r1 :r2 :r1 :r2 :r3) '((:r0 +view_w) (:r0 +view_h) (:r0 +canvas_cx1) (:r0 +canvas_cy1)
			(:r0 +canvas_texture)))
		(vpif '(:r3 /= 0))
			(class/obj/ref :r3 :r1)
		(endif)

		;ref pixmap
		(assign '((:rsp 0)) '(:r0))
		(call :canvas :ref '((:r0 +canvas_pixmap)))

		;edge array
		(call :array :create :nil '(:r1))
		(vp-pop :r0)
		(assign '(:r1) '((:r0 +canvas_edges)))
	(endif)

	(exit :canvas :init_pixmap '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :canvas :deinit)
	;inputs
	;:r0 = canvas object (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r4, :d0-:d15

	(vp-push :r0)

	;free edge arrays
	(assign '((:rsp 0)) '(:r0))
	(call :array :deref '((:r0 +canvas_edges)))
	(assign '((:rsp 0)) '(:r0))
	(call :sys_mem :free '((:r0 +canvas_edges_start)))

	;free alias buffers
	(assign '((:rsp 0)) '(:r0))
	(call :sys_mem :free '((:r0 +canvas_coverage)))

	;free any canvas texture
	(assign '((:rsp 0)) '(:r0))
	(call :texture :deref_if '((:r0 +canvas_texture)))

	;free pixel buffer, if it has not been freed by a swap
	(assign '((:rsp 0)) '(:r0))
	(call :pixmap :deref_if '((:r0 +canvas_pixmap)))

	(vp-pop :r0)
	(s-jump :canvas :deinit '(:r0))

(def-func-end)

(def-method :canvas :swap)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = canvas upload flags (uint)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this pixmap texture)
		(int flags))

	(vp-alloc slot_size)
	(entry :canvas :swap '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_flags) '(:r0 :r1))

	;a negative number is the other way, the texture back to the pixmap
	(assign '((:r0 +canvas_pixmap)) '(:r2))
	(assign '(:r2) '((:rsp slot_pixmap)))
	(vpif '(:r1 < 0))
		(call :canvas :read '(:r0))
		;a canvas that has freed its pixmap has nothing new to show
	(elseif '(:r2 /= 0))
		(vp-and-cr +swap_flag_keep :r1)
		(vpif '(:r1 = 0))
			;must be in premul alpha format
			(call :pixmap :as_premul '(:r2))

			;scale the pixmap if needed
			(load-fields :rsp '(slot_this slot_pixmap) '(:r0 :r1))
			(assign '((:r0 +canvas_scale)) '(:r2))
			(vpif '(:r2 = 1))
				(call :pixmap :ref '(:r1) '((:rsp slot_pixmap)))
			(else)
				(load-fields :r1 '(+pixmap_width +pixmap_height) '(:r0 :r3))
				(vp-div-rr-u :r2 :r0)
				(vp-div-rr-u :r2 :r3)
				(call :pixmap :create '(:r0 :r3 -32) '(:r0))
				(assign '(:r0) '((:rsp slot_pixmap)))
				(assign '((:rsp slot_this)) '(:r1))
				(call :pixmap :resize '(:r0 (:r1 +canvas_pixmap)))
			(endif)

			;upload then ref_if the texture
			(load-fields :rsp '(slot_pixmap slot_flags) '(:r0 :r1))
			(vp-and-cr 0xff :r1)
			(call :pixmap :upload '(:r0 :r1))
			(load-fields :rsp '(slot_this slot_pixmap) '(:r1 :r0))
			(assign '((:r1 +canvas_texture)) '(:r2))
			(assign '(:r2) '((:rsp slot_texture)))
			(call :texture :ref_if '((:r0 +pixmap_texture)) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0) '((:r1 +canvas_texture)))
			(call :texture :deref_if '((:rsp slot_texture)))
			(call :pixmap :deref '((:rsp slot_pixmap)))

			;the texture is now not one a shader can draw into
			(assign '((:rsp slot_this)) '(:r0))
			(assign '((:r0 +canvas_flags)) '(:r1))
			(vp-or-cr +canvas_flag_shader :r1)
			(vp-xor-cr +canvas_flag_shader :r1)
			(assign '(:r1) '((:r0 +canvas_flags)))
		(endif)

		;free the pixmap if asked. One that is shared lives on in the
		;cache, this only lets go of it. The clip is left as one that
		;nothing is inside, so every draw call is clipped away.
		(load-fields :rsp '(slot_this slot_flags) '(:r0 :r1))
		(vp-and-cr +swap_flag_free :r1)
		(vpif '(:r1 /= 0))
			(call :pixmap :deref '((:r0 +canvas_pixmap)))
			(assign '((:rsp slot_this)) '(:r0))
			(vp-xor-rr :r1 :r1)
			(assign '(0x7fffffff) '(:r2))
			(save-fields :r0 '(+canvas_pixmap +canvas_cx +canvas_cy +canvas_cx1 +canvas_cy1) '(:r1 :r2 :r2 :r1 :r1))
		(endif)
	(endif)

	(exit :canvas :swap '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :canvas :read)
	;inputs
	;:r0 = canvas object (ptr)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;the texture of the canvas is read back into its pixmap. The
	;canvas is given a new pixmap, premultiplied, so one that was
	;freed is made again, and one that is shared is left alone.

	(structure slot 0
		(ptr this pixmap)
		(long handle ok)
		(ptr old)
		(uint w h))

	(vp-alloc slot_size)
	(entry :canvas :read '((:rsp slot_this)))

	(assign '((:r0 +canvas_texture)) '(:r1))
	(vpif '(:r1 /= 0))
		;a pixmap the size of the texture, for the host GUI driver to fill,
		;the callback is given the frame
		(load-fields :r1 '(+texture_width +texture_height +texture_handle) '(:r0 :r2 :r3))
		(vp-xor-rr :r4 :r4)
		(save-fields :rsp '(slot_w slot_h slot_handle slot_ok) '(:r0 :r2 :r3 :r4))
		(call :pixmap :create '(:r0 :r2 -32) '(:r0))
		(assign '(:r0) '((:rsp slot_pixmap)))
		(call :sys_task :callback '(:rsp ($ callback)))
		(assign '((:rsp slot_ok)) '(:r0))
		(vpif '(:r0 /= 0))
			;the pixmap of a canvas is its texture times the scale
			(load-fields :rsp '(slot_this slot_pixmap) '(:r0 :r1))
			(assign '((:r0 +canvas_scale)) '(:r2))
			(vpif '(:r2 /= 1))
				(assign '(:r1) '((:rsp slot_old)))
				(load-fields :rsp '(slot_w slot_h) '(:r0 :r1))
				(vp-mul-rr :r2 :r0)
				(vp-mul-rr :r2 :r1)
				(call :pixmap :create '(:r0 :r1 -32) '(:r0))
				(assign '(:r0) '((:rsp slot_pixmap)))
				(call :pixmap :resize '(:r0 (:rsp slot_old)))
				(call :pixmap :deref '((:rsp slot_old)))
			(endif)
			(assign '((:rsp slot_this)) '(:r0))
			(call :pixmap :deref_if '((:r0 +canvas_pixmap)))
			(load-fields :rsp '(slot_this slot_pixmap) '(:r0 :r1))
			(assign '(:r1) '((:r0 +canvas_pixmap)))
			;and all of it can be drawn on
			(call :canvas :set_clip '(:r0 0 0 (:r1 +pixmap_width) (:r1 +pixmap_height)))
		(else)
			(call :pixmap :deref '((:rsp slot_pixmap)))
		(endif)
	(endif)

	(exit :canvas :read '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = user data, the frame above

	(entry '(:r0))
	(vp-push :r0)
	(assign '((:r0 slot_handle) (:r0 slot_pixmap)) '(:r0 :r1))
	(host-gui-call :host_gui :read_texture '(:r0 (:r1 +pixmap_data)
			(:r1 +pixmap_width) (:r1 +pixmap_height) (:r1 +pixmap_stride))
		'(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_ok)))
	(vp-ret)

(def-func-end)

(def-method :canvas :set_clip)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = x1 (pixels)
	;:r10 = y1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r2, :r7-:r10

	(entry :canvas :set_clip '(:r0 :r7 :r8 :r9 :r10))

	;clip check, with no pixmap the clip stays as one nothing is inside
	(assign '((:r0 +canvas_pixmap)) '(:r2))
	(vpif '(:r2 /= 0))
		(assign '((:r2 +pixmap_width) (:r2 +pixmap_height)) '(:r1 :r2))
		(vpif '(:r7 <= :r9) '(:r8 <= :r10) '(:r7 < :r1) '(:r8 < :r2) '(:r9 >= 0) '(:r10 >= 0))
			(vpif '(:r7 < 0))
				(vp-xor-rr :r7 :r7)
			(endif)
			(vpif '(:r8 < 0))
				(vp-xor-rr :r8 :r8)
			(endif)
			(vp-simd vp-min-rr '(:r1 :r2) '(:r9 :r10))
			(save-fields :r0 '(+canvas_cx +canvas_cy +canvas_cx1 +canvas_cy1) '(:r7 :r8 :r9 :r10))
		(endif)
	(endif)

	(exit :canvas :set_clip '(:r0))
	(vp-ret)

(def-func-end)

(def-method :canvas :span_noclip)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = coverage (long)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = x1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r9
	;info
	;coverage is 0x0 to 0x80

	(entry :canvas :span_noclip '(:r0 :r1 :r7 :r8 :r9))

	(switch)
	(breakif '(:r1 = 0))
	(assign '((:r0 +canvas_color)) '(:r2))
	(vp-cpy-rr :r2 :r3)
	(vp-shr-cr 24 :r2)
	(vp-and-cr 0xffffff :r3)
	(vp-mul-rr :r2 :r1)
	(vp-shr-cr 7 :r1)
	(vp-shl-cr 24 :r1)
	(vp-add-rr :r3 :r1)
	(call :pixmap :to_premul '(:r1) '(:r1))
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 24 :r2)
	(breakif '(:r2 = 0))
	(vpcase '(:r2 = 0xff))
		(assign '((:r0 +canvas_pixmap)) '(:r3))
		(assign '((:r3 +pixmap_stride) (:r3 +pixmap_data)) '(:r2 :r3))
		(vp-mul-rr :r2 :r8)
		(vp-simd vp-shl-cr `(,(log2 +int_size)) '(:r7 :r9))
		(vp-add-rr :r8 :r3)
		(loop-start)
			(vp-store-rrr-i :r1 :r3 :r7)
			(vp-add-cr +int_size :r7)
		(loop-until '(:r7 = :r9))

		(exit :canvas :span_noclip '(:r0))
		(vp-ret)
	(default)
		(vp-simd vp-cpy-cr '(0xff 0x00ff00ff 0xff00ff00) '(:r6 :r4 :r5))
		(vp-sub-rr :r2 :r6)

		(assign '((:r0 +canvas_pixmap)) '(:r3))
		(assign '((:r3 +pixmap_stride) (:r3 +pixmap_data)) '(:r2 :r3))
		(vp-mul-rr :r2 :r8)
		(vp-simd vp-shl-cr `(,(log2 +int_size)) '(:r7 :r9))
		(vp-add-rr :r8 :r3)
		(vp-simd vp-add-rr '(:r3) '(:r7 :r9))
		(loop-start)
			(vp-load-rcr-ui :r7 0 :r2)
			(vp-cpy-rr :r2 :r3)

			(vp-simd vp-and-rr '(:r4 :r5) '(:r2 :r3))
			(vp-simd vp-mul-rr '(:r6) '(:r2 :r3))
			(vp-simd vp-shr-cr '(8) '(:r2 :r3))
			(vp-simd vp-and-rr '(:r4 :r5) '(:r2 :r3))
			(vp-add-rr :r3 :r2) (vp-add-rr :r1 :r2)

			(vp-store-rrc-i :r2 :r7 0)
			(vp-add-cr +int_size :r7)
		(loop-until '(:r7 = :r9))
	(endswitch)

	(exit :canvas :span_noclip '(:r0))
	(vp-ret)

(def-func-end)

(def-method :canvas :span)
	;inputs
	;:r0 = canvas object (ptr)
	;:r1 = coverage (long)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = x1 (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r9
	;info
	;coverage is 0x0 to 0x80

	(entry :canvas :span '(:r0 :r1 :r7 :r8 :r9))

	;clip check
	(load-fields :r0 '(+canvas_cx +canvas_cy +canvas_cx1 +canvas_cy1) '(:r2 :r3 :r4 :r5))
	(vpif '(:r9 > :r7) '(:r9 > :r2) '(:r8 >= :r3) '(:r7 < :r4) '(:r8 < :r5))
		(vp-max-rr :r2 :r7)
		(vp-min-rr :r4 :r9)
		(jump :canvas :span_noclip '(:r0 :r1 :r7 :r8 :r9))
	(endif)

	(exit :canvas :span '(:r0))
	(vp-ret)

(def-func-end)

(def-method :canvas :pick)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;:r1 = color (argb)
	;trashes
	;:r1-:r8

	(entry :canvas :pick '(:r0 :r7 :r8))

	;clip check
	(load-fields :r0 '(+canvas_cx +canvas_cy +canvas_cx1 +canvas_cy1) '(:r3 :r4 :r5 :r6))
	(vpif '(:r7 >= :r3) '(:r8 >= :r4) '(:r7 < :r5) '(:r8 < :r6))
		(assign '((:r0 +canvas_pixmap)) '(:r2))
		(assign '((:r2 +pixmap_stride) (:r2 +pixmap_data)) '(:r1 :r2))
		(vp-mul-rr :r1 :r8)
		(vp-shl-cr (log2 +int_size) :r7)
		(vp-add-rr :r8 :r2)
		(vp-load-rrr-i :r2 :r7 :r1)
		(jump :pixmap :to_argb '(:r1))
	(endif)
	(vp-xor-rr :r1 :r1)

	(exit :canvas :pick '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :canvas :plot)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r8

	(vp-rdef (this col dcol cx cy cx1 cy1 x y))

	(entry :canvas :plot `(,this ,x ,y))

	;clip check
	(vp-simd vp-load-rcr-ui `(,this)
		`(,+canvas_cx ,+canvas_cy ,+canvas_cx1 ,+canvas_cy1)
		`(,cx ,cy ,cx1 ,cy1))
	(switch)
	(breakif `(,x < ,cx) `(,y < ,cy) `(,x >= ,cx1) `(,y >= ,cy1))
	(assign `((,this +canvas_color)) `(,col))
	(call :pixmap :to_premul `(,col) `(,col))
	(vp-cpy-rr col dcol)
	(vp-shr-cr 24 dcol)
	(breakif `(,dcol = 0))
	(vpcase `(,dcol = 0xff))
		(assign `((,this +canvas_pixmap)) `(,cx))
		(assign `((,cx +pixmap_stride) (,cx +pixmap_data)) `(,dcol ,cx))
		(vp-mul-rr dcol y)
		(vp-shl-cr (log2 +int_size) x)
		(vp-add-rr y cx)
		(vp-store-rrr-i col cx x)

		(exit :canvas :plot `(,this))
		(vp-ret)
	(default)
		(vp-simd vp-cpy-cr '(0xff 0x00ff00ff 0xff00ff00) `(,cy1 ,cy ,cx1))
		(vp-sub-rr dcol cy1)

		(assign `((,this +canvas_pixmap)) `(,cx))
		(assign `((,cx +pixmap_stride) (,cx +pixmap_data)) `(,dcol ,cx))
		(vp-mul-rr dcol y)
		(vp-shl-cr (log2 +int_size) x)
		(vp-simd vp-add-rr `(,y ,cx) `(,cx ,x))

		(vp-load-rcr-ui x 0 dcol)
		(vp-cpy-rr dcol cx)

		(vp-simd vp-and-rr `(,cy ,cx1) `(,dcol ,cx))
		(vp-simd vp-mul-rr `(,cy1) `(,dcol ,cx))
		(vp-simd vp-shr-cr '(8) `(,dcol ,cx))
		(vp-simd vp-and-rr `(,cy ,cx1) `(,dcol ,cx))
		(vp-add-rr cx dcol) (vp-add-rr col dcol)

		(vp-store-rrc-i dcol x 0)
	(endswitch)

	(exit :canvas :plot `(,this))
	(vp-ret)

(def-func-end)

(def-method :canvas :fbox)
	;inputs
	;:r0 = canvas object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = w (pixels)
	;:r10 = h (pixels)
	;outputs
	;:r0 = canvas object (ptr)
	;trashes
	;:r1-:r9

	(structure slot 0
		(int x y x1 y1))

	(vp-alloc slot_size)
	(entry :canvas :fbox '(:r0 :r7 :r8 :r9 :r10))

	;clip check, the box to its ends, x1 and y1, and to the clip
	(switch)
	(breakif '(:r9 <= 0) '(:r10 <= 0))
	(vp-add-rr :r7 :r9)
	(vp-lea-rrr :r8 :r10 :r6)
	(load-fields :r0 '(+canvas_cx +canvas_cy +canvas_cx1 +canvas_cy1) '(:r1 :r2 :r3 :r4))
	(breakif '(:r7 >= :r3) '(:r9 <= :r1) '(:r8 >= :r4) '(:r6 <= :r2))
	(vp-max-rr :r1 :r7)
	(vp-min-rr :r3 :r9)
	(vp-max-rr :r2 :r8)
	(vp-min-rr :r4 :r6)
	(save-fields :rsp '(slot_x slot_y slot_x1 slot_y1) '(:r7 :r8 :r9 :r6))
	(loop-start)
		(call :canvas :span_noclip '(:r0 0x80 :r7 :r8 :r9))
		(load-fields :rsp '(slot_x slot_y slot_x1 slot_y1) '(:r7 :r8 :r9 :r6))
		(vp-add-cr 1 :r8)
		(assign '(:r8) '((:rsp slot_y)))
	(loop-until '(:r8 = :r6))
	(endswitch)

	(exit :canvas :fbox '(:r0))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
