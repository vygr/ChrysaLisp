(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "lib/consts/colors.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././pixmap/class.inc")
(include "././path/class.inc")
(include "././canvas/class.inc")

(gen-create :font)
	;inputs
	;:r0 = name c string (pubyte)
	;:r1 = 0, else ctf data string object (ptr)
	;:r2 = font size (pixels)
	;outputs
	;:r0 = 0 if error, else font object (ptr)
	;trashes
	;:r0-:r11, :r14, :d0-:d15
(gen-vtable :font)

(def-method :font :open)
	;:r0 = name c string (pubyte)
	;:r1 = font size (pixels)
	;outputs
	;:r0 = 0 if error, else font object (ptr)
	;trashes
	;:r0-:r11, :r14, :d0-:d15

	(structure slot 0
		(ptr this name flat_set data)
		(pptr iter_begin iter_end)
		(uint pixels))

	(vp-alloc slot_size)
	(entry :font :open '(:r0 :r1))
	(save-fields :rsp '(slot_name slot_pixels) '(:r0 :r1))

	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_font_intern)) '(:r0))
	(vpif '(:r0 = 0))
		(call :list :create :nil '(:r0))
		(fn-bind 'sys/statics/statics :r1)
		(assign '(:r0) '((:r1 statics_font_intern)))
	(endif)
	(assign '(:r0) '((:rsp slot_flat_set)))

	;intern font
	(call :list :get_both '(:r0) '(_ :r1 :r2))
	(vp-xor-rr :r0 :r0)
	(assign '(:r0) '((:rsp slot_data)))
	(vpif '(:r1 /= :r2))
		(loop-start)
			(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r1 :r2))
			(assign '((:r1 0)) '(:r1))
			(assign '(:r1) '((:rsp slot_this)))
			(assign '((:r1 +font_name) (:rsp slot_name)) '(:r0 :r1))
			(vp-add-cr +str_data :r0)
			(call :sys_str :compare '(:r0 :r1) '(:r0))
			(vpif '(:r0 = 0))
				(load-fields :rsp '(slot_this slot_pixels) '(:r0 :r2))
				(load-fields :r0 '(+font_data +font_pixels) '(:r1 :r3))
				(assign '(:r1) '((:rsp slot_data)))
				(gotoif '(:r3 = :r2) 'found)
			(endif)
			(load-fields :rsp '(slot_iter_begin slot_iter_end) '(:r1 :r2))
			(vp-add-cr +ptr_size :r1)
		(loop-until '(:r1 = :r2))
	(endif)
	(call :font :create '((:rsp slot_name) (:rsp slot_data) (:rsp slot_pixels)) '(:r0))
	(assign '(:r0) '((:rsp slot_this)))
	(vpif '(:r0 /= 0))
		(call :list :push_back '((:rsp slot_flat_set) :r0))
	(vp-label 'found)
		(call :font :ref '((:rsp slot_this)))
	(endif)

	(exit :font :open '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :font :init)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = name c string (pubyte)
	;:r3 = 0, else ctf data string object (ptr)
	;:r4 = font size (pixels)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r11, :r14, :d0-:d15

	(structure slot 0
		(ptr this name data)
		(union
			(ptr vtable)
			(long ok))
		(uint pixels))

	(vp-alloc slot_size)
	(entry :font :init '(:r0 :r1 :r2 :r3 :r4))
	(save-fields :rsp '(slot_this slot_vtable slot_name slot_data slot_pixels) '(:r0 :r1 :r2 :r3 :r4))

	;init parent
	(s-call :font :init '(:r0 :r1) '(_ :r1))
	(assign '(:r1) '((:rsp slot_ok)))
	(vpif '(:r1 /= 0))
		;init state
		(load-fields :rsp '(slot_this slot_pixels) '(:r0 :r1))
		(vp-xor-rr :r2 :r2)
		(save-fields :r0 '(+font_chars +font_pixels) '(:r2 :r1))
		(call :sym :intern_cstr '((:rsp slot_name)) '(:r1))
		(assign '((:rsp slot_this)) '(:r0))
		(assign '(:r1) '((:r0 +font_name)))
		(call :hmap :create '(101) '(:r1))
		(assign '((:rsp slot_this)) '(:r0))
		(assign '(:r1) '((:r0 +font_sym_map)))
		(assign '((:rsp slot_data)) '(:r0))
		(vpif '(:r0 /= 0))
			(call :str :ref '(:r0) '(:r1))
			(assign '((:rsp slot_this)) '(:r0))
			(assign '(:r1) '((:r0 +font_data)))
		(else)
			(call :str :create_from_file '((:rsp slot_name)) '(:r1))
			(assign '((:rsp slot_this)) '(:r0))
			(assign '(:r1) '((:r0 +font_data)))
			(vpif '(:r1 = 0))
				(call :str :deref '((:r0 +font_name)))
				(assign '((:rsp slot_this)) '(:r0))
				(call :hmap :deref '((:r0 +font_sym_map)))
				(vp-xor-rr :r0 :r0)
				(assign '(:r0) '((:rsp slot_ok)))
			(endif)
		(endif)
	(endif)

	(exit :font :init '((:rsp slot_this) (:rsp slot_ok)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :font :deinit)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;trashes
	;:r1-:r2, :d0-:d15

	(entry :font :deinit '(:r0))

	(vp-push :r0)
	(call :list :deref_if '((:r0 +font_chars)))
	(assign '((:rsp 0)) '(:r0))
	(call :hmap :deref '((:r0 +font_sym_map)))
	(assign '((:rsp 0)) '(:r0))
	(call :str :deref '((:r0 +font_name)))
	(assign '((:rsp 0)) '(:r0))
	(call :str :deref '((:r0 +font_data)))
	(vp-pop :r0)

	;deinit parent
	(s-jump :font :deinit '(:r0))

(def-func-end)

(def-method :font :get_metrics)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = ascent (pixels)
	;:r2 = descent (pixels)
	;:r3 = height (pixels)
	;trashes
	;:r1-:r4

	(entry :font :get_metrics '(:r0))

	(assign '((:r0 +font_data) (:r0 +font_pixels)) '(:r3 :r4))
	(vp-add-cr +str_data :r3)
	(assign '((:r3 +font_data_ascent) (:r3 +font_data_descent)) '(:r1 :r2))
	(vp-mul-rr :r4 :r1)
	(vp-mul-rr :r4 :r2)
	(assign '((& :r1 :r2)) '(:r3))
	(vp-shr-cr 13 :r1)
	(vp-shr-cr 13 :r2)
	(vp-shr-cr 13 :r3)

	(exit :font :get_metrics '(:r0 :r1 :r2 :r3))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_data)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = char code (uint)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = 0, else glyph data pointer (ptr)
	;trashes
	;:r1-:r4

	(vp-rdef (this data c start end))

	(entry :font :glyph_data `(,this ,c))

	(assign `((,this +font_data)) `(,data))
	(vp-add-cr (+ +str_data +font_data_size) data)
	(loop-start)
		;scan pages for char c
		(loop-start)
			(assign `((,data +font_page_end)) `(,end))
			(breakif `(,end = 0))
			(assign `((,data +font_page_start)) `(,start))
			(vp-add-cr +font_page_size data)
			(vpif `(,c >= ,start) `(,c <= ,end))
				(vp-sub-rr start c)
				(vp-shl-cr (log2 +int_size) c)
				(assign `((,data ,c ui)) `(,c))
				(assign `((,this +font_data)) `(,data))
				(vp-add-cr +str_data data)
				(vp-add-rr c data)

				(exit :font :glyph_data `(,this ,data))
				(vp-ret)
			(endif)
			(vp-sub-rr start end)
			(vp-add-cr 1 end)
			(vp-shl-cr (log2 +int_size) end)
			(vp-add-rr end data)
		(loop-end)
		;glyph not found - retry with '_' fill char, unless already tried
		(breakif `(,c <= ,(code " ")) `(,c = ,(code "_")))
		(vp-cpy-cr (code "_") c)
		(assign `((,this +font_data)) `(,data))
		(vp-add-cr (+ +str_data +font_data_size) data)
	(loop-end)
	(vp-xor-rr data data)

	(exit :font :glyph_data `(,this ,data))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_ranges)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = glyph ranges array object (ptr)
	;trashes
	;:r1-:r4, :r6-:r7, :d0-:d15

	(vp-rdef (this data info start end) '(:r6 :r7 :r0 :r1 :r2))

	(entry :font :glyph_ranges `(,this))

	(call :array :create :nil `(,info))
	(assign `((,this +font_data)) `(,data))
	(vp-add-cr (+ +str_data +font_data_size) data)
	(loop-start)
		(assign `((,data +font_page_end)) `(,end))
		(breakif `(,end = 0))
		(assign `((,data +font_page_start)) `(,start))
		(call :array :push_back2 `(,info ,start ,end) `(,info ,start ,end _ _))
		(vp-sub-rr start end)
		(vp-add-cr +font_page_size data)
		(vp-add-cr 1 end)
		(vp-shl-cr (log2 +int_size) end)
		(vp-add-rr end data)
	(loop-end)

	(exit :font :glyph_ranges `(,this ,info))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_info)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = utf8 encoded str object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = glyph info array object (ptr)
	;trashes
	;:r1-:r4, :r6-:r8, :d0-:d15

	(vp-rdef (this utf8 info data c) '(:r6 :r7 :r8 :r7 :r1))

	(entry :font :glyph_info `(,this ,utf8))

	(call :array :create :nil `(,info))
	(call :array :set_cap `(,info (,utf8 +str_length)) `(,info))
	(assign `((& ,utf8 +str_data)) `(,data))
	(loop-start)
		(call :sys_str :read_utf8 `(,data) `(,data ,c))
		(breakif `(,c = 0))
		(vpif `(,c = ,(ascii-code "\t")))
			(call :array :push_back2 `(,info 0 0) `(tmp _ _ _ _))
			(call :array :push_back2 `(,tmp 0 0))
		(else)
			(call :font :glyph_data `(,this ,c) `(_ ,c))
			(call :array :push_back `(,info ,c))
		(endif)
	(loop-end)

	(exit :font :glyph_info `(,this ,info))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_bounds)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = glyph info array object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = width (pixels)
	;:r2 = height (pixels)
	;trashes
	;:r1-:r13

	(vp-rdef (this w h gap gw iter_begin iter_end info prev_info cur_code klen k_offset k_code k_adj))

	(entry :font :glyph_bounds `(,this ,info))

	(assign `((,this +font_data)) `(,iter_begin))
	(vp-add-cr +str_data iter_begin)
	(assign `((,iter_begin +font_data_ascent)
		(,iter_begin +font_data_descent)
		(,iter_begin +font_data_xkern)) `(,h ,gap ,w))
	(vp-add-rr gap h) ; h = ascent + descent
	(vp-cpy-rr w gap) ; gap = xkern

	(class/array/get_both info iter_begin iter_end)
	(vp-xor-rr prev_info prev_info)
	(loop-while `(,iter_begin /= ,iter_end))
		(assign `((,iter_begin 0)) `(,info))
		(vpif `(,info = 0))
			(vp-cpy-rr h gw)
			(vp-shr-cr 4 gw)
			(vp-xor-rr prev_info prev_info)
		(else)
			(assign `((,info +font_path_width)) `(,gw))
			(vpif `(,prev_info /= 0) 'no_kern)
				(assign `((,info +font_path_code)) `(,cur_code))
				(assign `((,prev_info +font_path_klen)) `(,klen))
				(vpif `(,klen /= 0))
					(assign `((,prev_info +font_path_plen)) `(,k_offset))
					(vp-add-rr prev_info k_offset)
					(vp-add-cr +font_path_size k_offset)
					(loop-start)
						(assign `((,k_offset +font_kern_code)) `(,k_code))
						(gotoif `(,k_code = ,cur_code) 'kern_hit)
						(breakif `(,k_code > ,cur_code) 'no_kern)
						(vp-add-cr +font_kern_size k_offset)
						(vp-sub-cr 1 klen)
					(loop-until `(,klen = 0))
					(break 'no_kern)
				(vp-label 'kern_hit)
					(assign `((,k_offset +font_kern_xkern)) `(,k_adj))
					(vp-add-rr k_adj w)
				(endif)
			(endif)
			(vp-cpy-rr info prev_info)
		(endif)
		(vp-add-rr gw w)
		(vp-add-rr gap w)
		(vp-add-cr +ptr_size iter_begin)
	(loop-end)

	(assign `((,this +font_pixels)) `(,gw))
	(vp-mul-rr gw w)
	(vp-mul-rr gw h)
	(vp-shr-cr 13 w)
	(vp-shr-cr 13 h)
	(vp-add-cr 2 w)

	(exit :font :glyph_bounds `(,this ,w ,h))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_paths)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = glyph info array object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = glyph paths list object (ptr)
	;:r2 = width (pixels)
	;:r3 = height (pixels)
	;trashes
	;:r1-:r13, :d0-:d15

	(defun trans_xy (rx ry)
		(vp-add-rr ox rx)
		(vp-add-rr oy ry)
		(vp-mul-rr pixels rx)
		(vp-mul-rr pixels ry)
		(vp-shl-cr 4 rx)
		(vp-shl-cr 4 ry))

	(structure slot 0
		(ptr this paths path info prev_info k_offset)
		(pptr iter_begin iter_end)
		(puint data data_end)
		(int x y pos_x pos_y)
		(uint width height gap ox oy cur_code klen k_code))

	(vp-alloc slot_size)
	(entry :font :glyph_paths '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_info) '(:r0 :r1))

	;the height, ascent and descent, and the gap between glyphs
	(assign '((:r0 +font_data)) '(:r2))
	(vp-add-cr +str_data :r2)
	(assign '((:r2 +font_data_ascent) (:r2 +font_data_descent) (:r2 +font_data_xkern)) '(:r3 :r4 :r5))
	(vp-add-rr :r4 :r3)
	(save-fields :rsp '(slot_height slot_gap) '(:r3 :r5))
	(call :list :create :nil '(:r0))
	(assign '((:rsp slot_gap)) '(:r1))
	(vp-xor-rr :r2 :r2)
	(save-fields :rsp '(slot_paths slot_prev_info slot_ox slot_oy) '(:r0 :r2 :r1 :r2))
	(call :array :get_both '((:rsp slot_info)) '(_ :r1 :r2))
	(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r1 :r2))
	(vpif '(:r1 /= :r2))
	(loop-start)
		(assign '((:rsp slot_iter_begin)) '(:r0))
		(assign '((:r0 0)) '(:r0))
		(assign '(:r0) '((:rsp slot_data)))
		(vpif '(:r0 /= 0))
			;the kern of the glyph before against this one, the kerns its
			;table in order of code: :r2 the code, :r3 the kerns left, :r4 the kern
			(assign '((:rsp slot_prev_info)) '(:r1))
			(vpif '(:r1 /= 0) 'no_kern)
				(assign '((:r0 +font_path_code) (:r1 +font_path_klen)) '(:r2 :r3))
				(vpif '(:r3 /= 0))
					(assign '((:r1 +font_path_plen)) '(:r4))
					(vp-add-rr :r1 :r4)
					(vp-add-cr +font_path_size :r4)
					(loop-start)
						(assign '((:r4 +font_kern_code)) '(:r5))
						(gotoif '(:r5 = :r2) 'kern_hit)
						(breakif '(:r5 > :r2) 'no_kern)
						(vp-add-cr +font_kern_size :r4)
						(vp-sub-cr 1 :r3)
					(loop-until '(:r3 = 0))
					(break 'no_kern)
				(vp-label 'kern_hit)
					(assign '((:r4 +font_kern_xkern) (:rsp slot_ox)) '(:r5 :r6))
					(vp-add-rr :r5 :r6)
					(assign '(:r6) '((:rsp slot_ox)))
				(endif)
			(endif)
			(assign '((:rsp slot_data)) '(:r0))
			(assign '(:r0) '((:rsp slot_prev_info)))
			(vp-rdef (data ox oy data_end width x y c pixels))
			(load-fields :rsp '(slot_data slot_ox slot_oy) `(,data ,ox ,oy))
			(assign `((,data +font_path_width) (,data +font_path_plen)) `(,width ,data_end))
			(vp-add-cr +font_path_size data)
			(vp-add-rr data data_end)
			(save-fields :rsp '(slot_data slot_data_end slot_pos_x slot_pos_y slot_width) `(,data ,data_end ,ox ,oy ,width))

			(loop-while `(,data /= ,data_end))
				(assign '((:rsp slot_this)) `(,pixels))
				(assign `((,pixels +font_pixels)) `(,pixels))
				(assign `((,data +font_path_element_type) (,data +font_line_element_x) (,data +font_line_element_y)) `(,c ,x ,y))
				(trans_xy x y)
				(save-fields :rsp '(slot_x slot_y) `(,x ,y))

				(switch)
				(vpcase `(,c = 3))
					;quadto
					(call :path :pop_back2 '((:rsp slot_path)))
					(vp-rdef (pth pos_x pos_y x y x1 y1 eps data ox oy pixels)
						(method-input :path :gen_quadratic))
					(load-fields :rsp '(slot_path slot_data slot_x slot_y slot_pos_x slot_pos_y slot_ox slot_oy)
						`(,pth ,data ,x ,y ,pos_x ,pos_y ,ox ,oy))
					(assign '((:rsp slot_this)) `(,pixels))
					(assign `((,pixels +font_pixels)) `(,pixels))
					(assign `((,data +font_quad_element_x1) (,data +font_quad_element_y1)) `(,x1 ,y1))
					(trans_xy x1 y1)
					(call :path :gen_quadratic `(,pth ,pos_x ,pos_y ,x ,y ,x1 ,y1))

					(load-fields :rsp '(slot_data slot_ox slot_oy) `(,data ,ox ,oy))
					(assign '((:rsp slot_this)) `(,pixels))
					(assign `((,pixels +font_pixels)) `(,pixels))
					(assign `((,data +font_quad_element_x1) (,data +font_quad_element_y1)) `(,x1 ,y1))
					(trans_xy x1 y1)
					(vp-add-cr +font_quad_element_size data)
					(save-fields :rsp '(slot_pos_x slot_pos_y slot_data) `(,x1 ,y1 ,data))
					(break)
				(vpcase `(,c = 2))
					;curveto
					(call :path :pop_back2 '((:rsp slot_path)))
					(vp-rdef (pth pos_x pos_y x y x1 y1 x2 y2 eps data ox oy pixels)
						(method-input :path :gen_cubic))
					(load-fields :rsp '(slot_path slot_data slot_x slot_y slot_pos_x slot_pos_y slot_ox slot_oy)
						`(,pth ,data ,x ,y ,pos_x ,pos_y ,ox ,oy))
					(assign '((:rsp slot_this)) `(,pixels))
					(assign `((,pixels +font_pixels)) `(,pixels))
					(assign `((,data +font_quad_element_x1) (,data +font_quad_element_y1)
						(,data +font_curve_element_x2) (,data +font_curve_element_y2)) `(,x1 ,y1 ,x2 ,y2))
					(trans_xy x1 y1)
					(trans_xy x2 y2)
					(call :path :gen_cubic `(,pth ,pos_x ,pos_y ,x ,y ,x1 ,y1 ,x2 ,y2))

					(load-fields :rsp '(slot_data slot_ox slot_oy) `(,data ,ox ,oy))
					(assign '((:rsp slot_this)) `(,pixels))
					(assign `((,pixels +font_pixels)) `(,pixels))
					(assign `((,data +font_curve_element_x2) (,data +font_curve_element_y2)) `(,x2 ,y2))
					(trans_xy x2 y2)
					(vp-add-cr +font_curve_element_size data)
					(save-fields :rsp '(slot_pos_x slot_pos_y slot_data) `(,x2 ,y2 ,data))
					(break)
				(vpcase `(,c = 1))
					;lineto
				(vp-label 'lineto)
					(call :path :push_back2 '((:rsp slot_path) (:rsp slot_x) (:rsp slot_y)))
					(load-fields :rsp '(slot_data slot_x slot_y) '(:r2 :r0 :r1))
					(vp-add-cr +font_line_element_size :r2)
					(save-fields :rsp '(slot_data slot_pos_x slot_pos_y) '(:r2 :r0 :r1))
					(break)
				(vpcase `(,c = 0))
					;moveto
					(call :path :create :nil '((:rsp slot_path)))
					(call :list :push_back '((:rsp slot_paths) (:rsp slot_path)))
					(goto 'lineto)
				(endswitch)
				(vp-rdef (data ox oy data_end))
				(load-fields :rsp '(slot_data slot_data_end slot_ox slot_oy) `(,data ,data_end ,ox ,oy))
			(loop-end)
			(load-fields :rsp '(slot_width slot_gap slot_ox) '(:r1 :r2 :r0))
			(vp-add-rr :r1 :r0)
			(vp-add-rr :r2 :r0)
			(assign '(:r0) '((:rsp slot_ox)))
		(else)
			;no glyph, a space of a quarter of the height
			(load-fields :rsp '(slot_height slot_gap slot_ox) '(:r1 :r2 :r0))
			(vp-shr-cr 4 :r1)
			(vp-add-rr :r1 :r0)
			(vp-add-rr :r2 :r0)
			(vp-xor-rr :r1 :r1)
			(save-fields :rsp '(slot_prev_info slot_ox) '(:r1 :r0))
		(endif)
		(load-fields :rsp '(slot_iter_begin slot_iter_end) '(:r0 :r1))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp slot_iter_begin)))
	(loop-until '(:r0 = :r1))
	(endif)

	;the size, the width of all and the height, by the pixels
	(assign '((:rsp slot_this)) '(:r0))
	(assign '((:r0 +font_data) (:r0 +font_pixels)) '(:r4 :r5))
	(vp-add-cr +str_data :r4)
	(assign '((:r4 +font_data_ascent) (:r4 +font_data_descent)) '(:r3 :r6))
	(vp-add-rr :r6 :r3)
	(vp-mul-rr :r5 :r3)
	(vp-shr-cr 13 :r3)
	(assign '((:rsp slot_ox)) '(:r2))
	(vp-mul-rr :r5 :r2)
	(vp-shr-cr 13 :r2)
	(vp-add-cr 2 :r2)
	(assign '((:rsp slot_paths)) '(:r1))
	(exit :font :glyph_paths '(:r0 :r1 :r2 :r3))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :font :sym_texture)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = utf8 encoded sym object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = 0, else texture object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this sym txt sym_canvas paths info)
		(uint w h)
		(pptr iter bucket))

	(vp-alloc slot_size)
	(entry :font :sym_texture '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_sym) '(:r0 :r1))

	;look up string in sym map
	(call :hmap :pfind '((:r0 +font_sym_map) :r1) '(_ :r1 :r2))
	(save-fields :rsp '(slot_iter slot_bucket) '(:r1 :r2))
	(vpif '(:r1 = 0))
		;create sym canvas
		(call :font :glyph_info '((:rsp slot_this) (:rsp slot_sym)) '(_ (:rsp slot_info)))
		(call :font :glyph_paths '((:rsp slot_this) (:rsp slot_info)) '(_ (:rsp slot_paths) (:rsp slot_w) (:rsp slot_h)))
		(call :canvas :create '((:rsp slot_w) (:rsp slot_h) 2) '(:r0))
		(assign `(:r0 ,+argb_white 1) '((:rsp slot_sym_canvas) :r1 :r2))
		(save-fields :r0 '(+canvas_color +canvas_flags) '(:r1 :r2))
		(call :font :get_metrics '((:rsp slot_this)) '(_ :r2 _ _))
		;by the non zero rule, as a TrueType outline is meant to be. Where
		;two parts of a glyph overlap they are filled, they do not cut a
		;hole, which is what lets a symbol be the outlines of its strokes
		(vp-shl-cr (+ +fp_shift 1) :r2)
		(call :canvas :fpoly `((:rsp slot_sym_canvas) 0 :r2 ,+winding_none_zero (:rsp slot_paths)))

		;take texture from canvas
		(call :canvas :swap `((:rsp slot_sym_canvas) ,+pixmap_mode_glyph))
		(assign '((:rsp slot_sym_canvas)) '(:r0))
		(assign '((:r0 +canvas_texture)) '(:r1))
		(assign '(:r1) '((:rsp slot_txt)))
		(vp-xor-rr :r1 :r1)
		(assign '(:r1) '((:r0 +canvas_texture)))

		;free all the gubins
		(call :canvas :deref '((:rsp slot_sym_canvas)))
		(call :array :deref '((:rsp slot_info)))
		(call :list :deref '((:rsp slot_paths)))
		(assign '((:rsp slot_txt)) '(:r0))
		(breakif '(:r0 = 0))

		;create new entry
		(call :sym :ref '((:rsp slot_sym)))
		(call :texture :ref '((:rsp slot_txt)))
		(call :list :push_back2 '((:rsp slot_bucket) (:rsp slot_sym) (:rsp slot_txt)))
		(fn-bind 'sys/statics/statics :r0)
		(assign '((:r0 statics_font_count)) '(:r1))
		(vp-add-cr 1 :r1)
		(assign '(:r1) '((:r0 statics_font_count)))
	(else)
		(call :obj :ref '((:r1 +ptr_size)) '((:rsp slot_txt)))
	(endif)

	(exit :font :sym_texture '((:rsp slot_this) (:rsp slot_txt)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :font :ascii_textures)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = list of ascii texture objects (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this sym chars)
		(uint code))

	;save inputs
	(vp-alloc slot_size)
	(entry :font :ascii_textures '((:rsp slot_this)))

	;lazy create char textures
	(assign '((:r0 +font_chars)) '(:r1))
	(vpif '(:r1 = 0))
		;note, don't write to member var yet in case flush gets called !
		(call :list :create :nil '(:r0))
		(assign '(:r0) '((:rsp slot_chars)))
		(call :list :set_cap `(:r0 ,(- 127 33)))
		;the code is a C string of one char, the bytes above it 0
		(assign '(33) '(:r0))
		(assign '(:r0) '((:rsp slot_code)))
		(loop-start)
			(call :sym :intern_cstr '((& :rsp slot_code)) '((:rsp slot_sym)))
			(call :font :sym_texture '((:rsp slot_this) (:rsp slot_sym)) '(_ :r1))
			(vpif '(:r1 /= 0))
				(call :list :push_back '((:rsp slot_chars) :r1))
			(endif)
			(call :sym :deref '((:rsp slot_sym)))
			(assign '((:rsp slot_code)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:rsp slot_code)))
		(loop-until '(:r0 = 127))
		(load-fields :rsp '(slot_this slot_chars) '(:r0 :r1))
		(assign '((:r0 +font_chars)) '(:r2))
		(vpif '(:r2 /= 0))
			;another thread got to it during a flush !
			(call :list :deref '(:r1))
		(else)
			(assign '(:r1) '((:r0 +font_chars)))
		(endif)
	(endif)
	(assign '((:rsp slot_this)) '(:r0))
	(call :list :ref '((:r0 +font_chars)))

	(assign '((:rsp slot_this)) '(:r0))
	(exit :font :ascii_textures '(:r0 (:r0 +font_chars)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :font :flush)
	;trashes
	;:r0-:r5, :r14, :d0-:d15

	(structure slot 0
		(ptr font flat_set)
		(uint index))

	(vp-alloc slot_size)

	;must not use iters as kernel callbacks will deshedule us !
	;a node that never made a font, one with no GUI, has none to flush
	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_font_intern)) '(:r0))
	(vp-xor-rr :r1 :r1)
	(save-fields :rsp '(slot_flat_set slot_index) '(:r0 :r1))
	(vpif '(:r0 /= 0))
		(loop-start)
			(call :array :get_length '((:rsp slot_flat_set)) '(_ :r1))
			(assign '((:rsp slot_index)) '(:r2))
			(breakif '(:r1 = :r2))
			(call :list :get_elem '((:rsp slot_flat_set) :r2) '(_ :r0))
			(assign '(:r0) '((:rsp slot_font)))
			(assign '((:r0 +font_chars)) '(:r1))
			(vpif '(:r1 /= 0))
				(assign '((:r1 +obj_count)) '(:r2))
				(vpif '(:r2 = 1))
					;during deref +font_chars could be written to !
					(vp-xor-rr :r2 :r2)
					(assign '(:r2) '((:r0 +font_chars)))
					(call :list :deref '(:r1))
				(endif)
			(endif)
			(assign '((:rsp slot_font)) '(:r0))
			(assign '((:r0 +font_sym_map)) '(:r0))
			(call :hmap :create '((:r0 +array_num_buckets)) '(:r0))
			(assign '((:rsp slot_font)) '(:r1))
			(assign '((:r1 +font_sym_map)) '(:r2))
			(assign '(:r0) '((:r1 +font_sym_map)))
			(call :hmap :deref '(:r2))
			(assign '((:rsp slot_index)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:rsp slot_index)))
		(loop-end)
	(endif)
	(fn-bind 'sys/statics/statics :r0)
	(vp-xor-rr :r1 :r1)
	(assign '(:r1) '((:r0 statics_font_count)))

	(vp-free slot_size)
	(vp-ret)

(def-func-end)
