(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "lib/consts/colors.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././pixmap/class.inc")
(include "././path/class.inc")
(include "././canvas/class.inc")

(gen-create :font)
	;inputs
	;:r0 = name c string (pubyte)
	;:r1 = 0, else ctf data string object (ptr)
	;:r2 = font size (pixels)
	;outputs
	;:r0 = 0 if error, else font object (ptr)
	;trashes
	;:r0-:r14, :f0-:f15
(gen-vtable :font)

(def-method :font :open)
	;:r0 = name c string (pubyte)
	;:r1 = font size (pixels)
	;outputs
	;:r0 = 0 if error, else font object (ptr)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(ptr this name flat_set data)
		(pptr iter_begin iter_end)
		(uint pixels))

	(push-scope)
	(entry :font :open (vpx name pixels))

	(assign (vpx (. (@ sys/statics/statics) statics_font_intern)) (vpx flat_set))
	(vpifnot (vpx flat_set))
		(call :list :create :nil (vpx flat_set))
		(assign (vpx flat_set) (vpx (. (@ sys/statics/statics) statics_font_intern)))
	(endif)

	;intern font
	(call :list :get_both (vpx flat_set) (vpx _ iter_begin iter_end))
	(assign (vpx 0) (vpx data))
	(loop-while (vpx (/= iter_begin iter_end)))
		(assign (vpx (* iter_begin)) (vpx this))
		(call :sys_str :compare (vpx (& (.> this +font_name +str_data)) name) '(tmp))
		(vpif `(,tmp = 0))
			(assign (vpx (.> this +font_data)) (vpx data))
			(gotoif (vpx (= (.> this +font_pixels) pixels)) 'found)
		(endif)
		(assign (vpx (+ iter_begin +ptr_size)) (vpx iter_begin))
	(loop-end)
	(call :font :create (vpx name data pixels) (vpx this))
	(vpif (vpx this))
		(call :list :push_back (vpx flat_set this))
	(vp-label 'found)
		(call :font :ref (vpx this))
	(endif)

	(exit :font :open (vpx this))
	(pop-scope)
	(return)

(def-func-end)

(def-method :font :init)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = name c string (pubyte)
	;:r3 = 0, else ctf data string object (ptr)
	;:r4 = font size (pixels)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this name data)
		(union
			(ptr vtable)
			(long ok))
		(uint pixels))

	(push-scope)
	(entry :font :init (vpx this vtable name data pixels))

	;init parent
	(s-call :font :init (vpx this vtable) (vpx _ ok))
	(vpif (vpx ok))
		;init state
		(assign (vpx 0 pixels) (vpx (.> this +font_chars) (.> this +font_pixels)))
		(call :sym :intern_cstr (vpx name) (vpx (.> this +font_name)))
		(call :hmap :create (vpx 101) (vpx (.> this +font_sym_map)))
		(vpif (vpx data))
			(call :str :ref (vpx data) (vpx (.> this +font_data)))
		(else)
			(call :str :create_from_file (vpx name) (vpx (.> this +font_data)))
			(vpifnot (vpx (.> this +font_data)))
				(call :str :deref (vpx (.> this +font_name)))
				(call :hmap :deref (vpx (.> this +font_sym_map)))
				(assign (vpx 0) (vpx ok))
			(endif)
		(endif)
	(endif)

	(exit :font :init (vpx this ok))
	(pop-scope)
	(return)

(def-func-end)

(def-method :font :deinit)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :font :deinit '(:r0))

	(vp-push :r0)
	(call :list :deref_if '((:r0 +font_chars)))
	(assign '((:rsp 0)) '(:r0))
	(call :hmap :deref '((:r0 +font_sym_map)))
	(assign '((:rsp 0)) '(:r0))
	(call :str :deref '((:r0 +font_name)))
	(assign '((:rsp 0)) '(:r0))
	(call :str :deref '((:r0 +font_data)))
	(vp-pop :r0)

	;deinit parent
	(s-jump :font :deinit '(:r0))

(def-func-end)

(def-method :font :get_metrics)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = ascent (pixels)
	;:r2 = descent (pixels)
	;:r3 = height (pixels)
	;trashes
	;:r1-:r4

	(entry :font :get_metrics '(:r0))

	(assign '((:r0 +font_data) (:r0 +font_pixels)) '(:r3 :r4))
	(vp-add-cr +str_data :r3)
	(assign '((:r3 +font_data_ascent) (:r3 +font_data_descent)) '(:r1 :r2))
	(vp-mul-rr :r4 :r1)
	(vp-mul-rr :r4 :r2)
	(assign '((& :r1 :r2)) '(:r3))
	(vp-shr-cr 13 :r1)
	(vp-shr-cr 13 :r2)
	(vp-shr-cr 13 :r3)

	(exit :font :get_metrics '(:r0 :r1 :r2 :r3))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_data)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = char code (uint)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = 0, else glyph data pointer (ptr)
	;trashes
	;:r1-:r4

	(vp-rdef (this data c start end))

	(entry :font :glyph_data `(,this ,c))

	(assign `((,this +font_data)) `(,data))
	(vp-add-cr (+ +str_data +font_data_size) data)
	(loop-start)
		;scan pages for char c
		(loop-start)
			(assign `((,data +font_page_end)) `(,end))
			(breakif `(,end = 0))
			(assign `((,data +font_page_start)) `(,start))
			(vp-add-cr +font_page_size data)
			(vpif `(,c >= ,start) `(,c <= ,end))
				(vp-sub-rr start c)
				(vp-shl-cr (log2 +int_size) c)
				(assign `((,data ,c ui)) `(,c))
				(assign `((,this +font_data)) `(,data))
				(vp-add-cr +str_data data)
				(vp-add-rr c data)

				(exit :font :glyph_data `(,this ,data))
				(vp-ret)
			(endif)
			(vp-sub-rr start end)
			(vp-add-cr 1 end)
			(vp-shl-cr (log2 +int_size) end)
			(vp-add-rr end data)
		(loop-end)
		;glyph not found - retry with '_' fill char, unless already tried
		(breakif `(,c <= ,(code " ")) `(,c = ,(code "_")))
		(vp-cpy-cr (code "_") c)
		(assign `((,this +font_data)) `(,data))
		(vp-add-cr (+ +str_data +font_data_size) data)
	(loop-end)
	(vp-xor-rr data data)

	(exit :font :glyph_data `(,this ,data))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_ranges)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = glyph ranges array object (ptr)
	;trashes
	;:r1-:r7, :f0-:f15

	(vp-rdef (this data info start end) '(:r6 :r7 :r0 :r1 :r2))

	(entry :font :glyph_ranges `(,this))

	(call :array :create :nil `(,info))
	(assign `((,this +font_data)) `(,data))
	(vp-add-cr (+ +str_data +font_data_size) data)
	(loop-start)
		(assign `((,data +font_page_end)) `(,end))
		(breakif `(,end = 0))
		(assign `((,data +font_page_start)) `(,start))
		(call :array :push_back2 `(,info ,start ,end) `(,info ,start ,end _ _))
		(vp-sub-rr start end)
		(vp-add-cr +font_page_size data)
		(vp-add-cr 1 end)
		(vp-shl-cr (log2 +int_size) end)
		(vp-add-rr end data)
	(loop-end)

	(exit :font :glyph_ranges `(,this ,info))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_info)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = utf8 encoded str object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = glyph info array object (ptr)
	;trashes
	;:r1-:r8, :f0-:f15

	(vp-rdef (this utf8 info data c) '(:r6 :r7 :r8 :r7 :r1))

	(entry :font :glyph_info `(,this ,utf8))

	(call :array :create :nil `(,info))
	(call :array :set_cap `(,info (,utf8 +str_length)) `(,info))
	(assign `((& ,utf8 +str_data)) `(,data))
	(loop-start)
		(call :sys_str :read_utf8 `(,data) `(,data ,c))
		(breakif `(,c = 0))
		(vpif `(,c = ,(ascii-code "\t")))
			(call :array :push_back2 `(,info 0 0) `(tmp _ _ _ _))
			(call :array :push_back2 `(,tmp 0 0))
		(else)
			(call :font :glyph_data `(,this ,c) `(_ ,c))
			(call :array :push_back `(,info ,c))
		(endif)
	(loop-end)

	(exit :font :glyph_info `(,this ,info))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_bounds)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = glyph info array object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = width (pixels)
	;:r2 = height (pixels)
	;trashes
	;:r1-:r13

	(vp-rdef (this w h gap gw iter_begin iter_end info prev_info cur_code klen k_offset k_code k_adj))

	(entry :font :glyph_bounds `(,this ,info))

	(assign `((,this +font_data)) `(,iter_begin))
	(vp-add-cr +str_data iter_begin)
	(assign `((,iter_begin +font_data_ascent)
		(,iter_begin +font_data_descent)
		(,iter_begin +font_data_xkern)) `(,h ,gap ,w))
	(vp-add-rr gap h) ; h = ascent + descent
	(vp-cpy-rr w gap) ; gap = xkern

	(class/array/get_both info iter_begin iter_end)
	(vp-xor-rr prev_info prev_info)
	(loop-while `(,iter_begin /= ,iter_end))
		(assign `((,iter_begin 0)) `(,info))
		(vpif `(,info = 0))
			(vp-cpy-rr h gw)
			(vp-shr-cr 4 gw)
			(vp-xor-rr prev_info prev_info)
		(else)
			(assign `((,info +font_path_width)) `(,gw))
			(vpif `(,prev_info /= 0) 'no_kern)
				(assign `((,info +font_path_code)) `(,cur_code))
				(assign `((,prev_info +font_path_klen)) `(,klen))
				(vpif `(,klen /= 0))
					(assign `((,prev_info +font_path_plen)) `(,k_offset))
					(vp-add-rr prev_info k_offset)
					(vp-add-cr +font_path_size k_offset)
					(loop-start)
						(assign `((,k_offset +font_kern_code)) `(,k_code))
						(gotoif `(,k_code = ,cur_code) 'kern_hit)
						(breakif `(,k_code > ,cur_code) 'no_kern)
						(vp-add-cr +font_kern_size k_offset)
						(vp-sub-cr 1 klen)
					(loop-until `(,klen = 0))
					(break 'no_kern)
				(vp-label 'kern_hit)
					(assign `((,k_offset +font_kern_xkern)) `(,k_adj))
					(vp-add-rr k_adj w)
				(endif)
			(endif)
			(vp-cpy-rr info prev_info)
		(endif)
		(vp-add-rr gw w)
		(vp-add-rr gap w)
		(vp-add-cr +ptr_size iter_begin)
	(loop-end)

	(assign `((,this +font_pixels)) `(,gw))
	(vp-mul-rr gw w)
	(vp-mul-rr gw h)
	(vp-shr-cr 13 w)
	(vp-shr-cr 13 h)
	(vp-add-cr 2 w)

	(exit :font :glyph_bounds `(,this ,w ,h))
	(vp-ret)

(def-func-end)

(def-method :font :glyph_paths)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = glyph info array object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = glyph paths list object (ptr)
	;:r2 = width (pixels)
	;:r3 = height (pixels)
	;trashes
	;:r1-:r14, :f0-:f15

	(defun trans_xy (rx ry)
		(vp-add-rr ox rx)
		(vp-add-rr oy ry)
		(vp-mul-rr pixels rx)
		(vp-mul-rr pixels ry)
		(vp-shl-cr 4 rx)
		(vp-shl-cr 4 ry))

	(def-vars
		(ptr this paths path info prev_info k_offset)
		(pptr iter_begin iter_end)
		(puint data data_end)
		(int x y pos_x pos_y)
		(uint width height gap ox oy cur_code klen k_code))

	(push-scope)
	(entry :font :glyph_paths (vpx this info))

	(assign (vpx (& (.> this +font_data +str_data))) (vpx iter_begin))
	(assign (vpx (+ (.> iter_begin +font_data_ascent) (.> iter_begin +font_data_descent))
		(.> iter_begin +font_data_xkern)) (vpx height gap))
	(call :list :create :nil (vpx paths))
	(assign (vpx gap 0 0) (vpx ox oy prev_info))
	(call :array :get_both (vpx info) (vpx _ iter_begin iter_end))
	(loop-while (vpx (/= iter_begin iter_end)))
		(assign (vpx (* iter_begin)) (vpx data))
		(vpif (vpx data))
			(vpif (vpx (/= prev_info 0)) 'no_kern)
				(assign (vpx (.> data +font_path_code)) (vpx cur_code))
				(assign (vpx (.> prev_info +font_path_klen)) (vpx klen))
				(vpif (vpx (/= klen 0)))
					(assign (vpx (+ (.> prev_info +font_path_plen) prev_info +font_path_size)) (vpx k_offset))
					(loop-start)
						(assign (vpx (.> k_offset +font_kern_code)) (vpx k_code))
						(gotoif (vpx (= k_code cur_code)) 'kern_hit)
						(breakif (vpx (> k_code cur_code)) 'no_kern)
						(assign (vpx (+ k_offset +font_kern_size)) (vpx k_offset))
					(loop-until (vpx (= (=> (- klen 1) klen) 0)))
					(break 'no_kern)
				(vp-label 'kern_hit)
					(assign (vpx (+ (.> k_offset +font_kern_xkern) ox)) (vpx ox)) ; Direct add, no shift needed!
				(endif)
			(endif)
			(assign (vpx data) (vpx prev_info))
			(vp-rdef (data ox oy data_end width x y c pixels))
			(assign (vpx data ox oy) `(,data ,ox ,oy))
			(assign `((,data +font_path_width) (,data +font_path_plen)) `(,width ,data_end))
			(vp-add-cr +font_path_size data)
			(vp-add-rr data data_end)
			(assign `(,data ,data_end ,ox ,oy ,width) (vpx data data_end pos_x pos_y width))

			(loop-while `(,data /= ,data_end))
				(assign (vpx (.> this +font_pixels)) `(,pixels))
				(assign `((,data +font_path_element_type) (,data +font_line_element_x) (,data +font_line_element_y)) `(,c ,x ,y))
				(trans_xy x y)
				(assign `(,x ,y) (vpx x y))

				(switch)
				(vpcase `(,c = 3))
					;quadto
					(call :path :pop_back2 (vpx path))
					(vp-rdef (pth pos_x pos_y x y x1 y1 eps data ox oy pixels)
						(method-input :path :gen_quadratic))
					(assign (vpx data path pos_x pos_y x y ox oy (.> this +font_pixels))
						`(,data ,pth ,pos_x ,pos_y ,x ,y ,ox ,oy ,pixels))
					(assign `((,data +font_quad_element_x1) (,data +font_quad_element_y1)) `(,x1 ,y1))
					(trans_xy x1 y1)
					(call :path :gen_quadratic `(,pth ,pos_x ,pos_y ,x ,y ,x1 ,y1))

					(assign (vpx data ox oy (.> this +font_pixels)) `(,data ,ox ,oy ,pixels))
					(assign `((,data +font_quad_element_x1) (,data +font_quad_element_y1)) `(,x1 ,y1))
					(trans_xy x1 y1)
					(vp-add-cr +font_quad_element_size data)
					(assign `(,x1 ,y1 ,data) (vpx pos_x pos_y data))
					(break)
				(vpcase `(,c = 2))
					;curveto
					(call :path :pop_back2 (vpx path))
					(vp-rdef (pth pos_x pos_y x y x1 y1 x2 y2 eps data ox oy pixels)
						(method-input :path :gen_cubic))
					(assign (vpx data path pos_x pos_y x y ox oy (.> this +font_pixels))
						`(,data ,pth ,pos_x ,pos_y ,x ,y ,ox ,oy ,pixels))
					(assign `((,data +font_quad_element_x1) (,data +font_quad_element_y1)
						(,data +font_curve_element_x2) (,data +font_curve_element_y2)) `(,x1 ,y1 ,x2 ,y2))
					(trans_xy x1 y1)
					(trans_xy x2 y2)
					(call :path :gen_cubic `(,pth ,pos_x ,pos_y ,x ,y ,x1 ,y1 ,x2 ,y2))

					(assign (vpx data ox oy (.> this +font_pixels)) `(,data ,ox ,oy ,pixels))
					(assign `((,data +font_curve_element_x2) (,data +font_curve_element_y2)) `(,x2 ,y2))
					(trans_xy x2 y2)
					(vp-add-cr +font_curve_element_size data)
					(assign `(,x2 ,y2 ,data) (vpx pos_x pos_y data))
					(break)
				(vpcase `(,c = 1))
					;lineto
				(vp-label 'lineto)
					(call :path :push_back2 (vpx path x y))
					(assign (vpx x y (+ data +font_line_element_size)) (vpx pos_x pos_y data))
					(break)
				(vpcase `(,c = 0))
					;moveto
					(call :path :create :nil (vpx path))
					(call :list :push_back (vpx paths path))
					(goto 'lineto)
				(endswitch)
				(vp-rdef (data ox oy data_end))
				(assign (vpx data data_end ox oy) `(,data ,data_end ,ox ,oy))
			(loop-end)
			(assign (vpx (+ ox width gap)) (vpx ox))
		(else)
			(assign (vpx (+ ox (>> height 4) gap)) (vpx ox))
			(assign (vpx 0) (vpx prev_info))
		(endif)
		(assign (vpx (+ iter_begin +ptr_size)) (vpx iter_begin))
	(loop-end)
	(assign (vpx (& (.> this +font_data +str_data))) (vpx iter_begin))

	(exit :font :glyph_paths (vpx this paths (+ (>> (* ox (.> this +font_pixels)) 13) 2)
		(>> (* (+ (.> iter_begin +font_data_ascent) (.> iter_begin +font_data_descent)) (.> this +font_pixels)) 13)))
	(pop-scope)
	(return)

(def-func-end)

(def-method :font :sym_texture)
	;inputs
	;:r0 = font object (ptr)
	;:r1 = utf8 encoded sym object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = 0, else texture object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this sym txt sym_canvas paths info)
		(uint w h)
		(union
			(ptr statics)
			(pptr iter bucket)))

	(push-scope)
	(entry :font :sym_texture (vpx this sym))

	;look up string in sym map
	(call :hmap :pfind (vpx (.> this +font_sym_map) sym) (vpx _ iter bucket))
	(vpifnot (vpx iter))
		;create sym canvas
		(call :font :glyph_info (vpx this sym) (vpx _ info))
		(call :font :glyph_paths (vpx this info) (vpx _ paths w h))
		(call :canvas :create (vpx w h 2) (vpx sym_canvas))
		(assign (vpx +argb_white 1) (vpx (.> sym_canvas +canvas_color) (.> sym_canvas +canvas_flags)))
		(call :font :get_metrics (vpx this) (vpx _ h _ _))
		;by the non zero rule, as a TrueType outline is meant to be. Where
		;two parts of a glyph overlap they are filled, they do not cut a
		;hole, which is what lets a symbol be the outlines of its strokes
		(call :canvas :fpoly (vpx sym_canvas 0 (<< h (+ +fp_shift 1)) +winding_none_zero paths))

		;take texture from canvas
		(call :canvas :swap (vpx sym_canvas +pixmap_mode_glyph))
		(assign (vpx (.> sym_canvas +canvas_texture)) (vpx txt))
		(assign (vpx 0) (vpx (.> sym_canvas +canvas_texture)))

		;free all the gubins
		(call :canvas :deref (vpx sym_canvas))
		(call :array :deref (vpx info))
		(call :list :deref (vpx paths))
		(breakifnot (vpx txt))

		;create new entry
		(call :sym :ref (vpx sym))
		(call :texture :ref (vpx txt))
		(call :list :push_back2 (vpx bucket sym txt))
		(assign (vpx (@ sys/statics/statics)) (vpx statics))
		(assign (vpx (+ (.> statics statics_font_count) 1)) (vpx (.> statics statics_font_count)))
	(else)
		(call :obj :ref (vpx (elem iter +ptr_size)) (vpx txt))
	(endif)

	(exit :font :sym_texture (vpx this txt))
	(pop-scope)
	(return)

(def-func-end)

(def-method :font :ascii_textures)
	;inputs
	;:r0 = font object (ptr)
	;outputs
	;:r0 = font object (ptr)
	;:r1 = list of ascii texture objects (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this sym txt chars)
		(uint code))

	;save inputs
	(push-scope)
	(entry :font :ascii_textures (vpx this))

	;lazy create char textures
	(vpifnot (vpx (.> this +font_chars)))
		;note, don't write to member var yet in case flush gets called !
		(call :list :create :nil (vpx chars))
		(call :list :set_cap (vpx chars (- 127 33)))
		(assign (vpx 33) (vpx code))
		(loop-start)
			(call :sym :intern_cstr (vpx (& code)) (vpx sym))
			(call :font :sym_texture (vpx this sym) (vpx _ txt))
			(vpif (vpx txt))
				(call :list :push_back (vpx chars txt))
			(endif)
			(call :sym :deref (vpx sym))
		(loop-until (vpx (= (=> (+ code 1) code) 127)))
		(vpif (vpx (.> this +font_chars)))
			;another thread got to it during a flush !
			(call :list :deref (vpx chars))
		(else)
			(assign (vpx chars) (vpx (.> this +font_chars)))
		(endif)
	(endif)
	(call :list :ref (vpx (.> this +font_chars)))

	(exit :font :ascii_textures (vpx this (.> this +font_chars)))
	(pop-scope)
	(return)

(def-func-end)

(def-method :font :flush)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(ptr font new_map flat_set tmp statics)
		(uint length index))

	(push-scope)

	;must not use iters as kernel callbacks will deshedule us !
	(assign (vpx (@ sys/statics/statics)) (vpx statics))
	(assign (vpx 0 (.> statics statics_font_intern)) (vpx index flat_set))
	(loop-start)
		(call :array :get_length (vpx flat_set) (vpx _ length))
		(breakif (vpx (= index length)))
		(call :list :get_elem (vpx flat_set index) (vpx _ font))
		(vpif (vpx (.> font +font_chars)))
			(vpif (vpx (= (.> font +font_chars +obj_count) 1)))
				;during deref +font_chars could be written to !
				(assign (vpx (.> font +font_chars)) (vpx tmp))
				(assign (vpx 0) (vpx (.> font +font_chars)))
				(call :list :deref (vpx tmp))
			(endif)
		(endif)
		(call :hmap :create (vpx (.> font +font_sym_map +array_num_buckets)) (vpx new_map))
		(assign (vpx (.> font +font_sym_map)) (vpx tmp))
		(assign (vpx new_map) (vpx (.> font +font_sym_map)))
		(call :hmap :deref (vpx tmp))
		(assign (vpx (+ index 1)) (vpx index))
	(loop-end)
	(assign (vpx 0) (vpx (.> statics statics_font_count)))

	(pop-scope)
	(return)

(def-func-end)
