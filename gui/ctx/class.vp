(include "lib/asm/func.inc")
(include "./class.inc")
(include "././view/class.inc")

;A view draws into its own list of draws, in its own coordinates, and keeps
;it till it is to be drawn again, its own :dirty or a view's above it, or a
;new size. The GUI puts the lists of what is to be seen on the host, clipped
;and moved to where each view is, service/gui/class.vp

(def-method :ctx :reserve)
	;inputs
	;:r0 = view object (ptr)
	;:r1 = longs (uint)
	;outputs
	;:r0 = view object (ptr)
	;:r1 = the first of them (plong)
	;trashes
	;:r1-:r3, :f0-:f15
	;info
	;the view's list of draws that many longer, made if it has none

	(entry :ctx :reserve '(:r0 :r1))

	(assign '((:r0 +view_draws)) '(:r2))
	(vpif '(:r2 = 0))
		(vp-push :r0 :r1)
		(call :array :create :nil '(:r2))
		(vp-pop :r0 :r1)
		(assign '(:r2) '((:r0 +view_draws)))
	(endif)
	(vp-push :r0)
	(assign '((:r2 +array_length)) '(:r3))
	(vp-add-rr :r3 :r1)
	(vp-push :r1)
	(call :array :set_cap '(:r2 :r1) '(:r0))
	(vp-pop :r1)
	(assign '(:r1 (:r0 +array_begin)) '((:r0 +array_length) :r1))
	(vp-shl-cr (log2 +long_size) :r3)
	(vp-add-rr :r3 :r1)
	(vp-pop :r0)

	(exit :ctx :reserve '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :ctx :set_color)
	;inputs
	;:r0 = view object (ptr)
	;:r1 = color (argb)
	;trashes
	;:r1-:r4, :f0-:f15

	(entry :ctx :set_color '(:r0 :r1))

	(vp-cpy-rr :r1 :r4)
	(call :ctx :reserve '(:r0 2) '(:r0 :r1))
	(vp-cpy-cr +ctx_op_color :r2)
	(assign '(:r2 :r4) '((:r1 0) (:r1 +long_size)))
	(vp-ret)

(def-func-end)

(defun ctx-rect (%0)
	;a host rect of :r7-:r10 at %0 from :r1
	(assign '(:r7 :r8 :r9 :r10)
		`((:r1 ,(+ %0 host_gui_rect_x) i) (:r1 ,(+ %0 host_gui_rect_y) i)
		(:r1 ,(+ %0 host_gui_rect_w) i) (:r1 ,(+ %0 host_gui_rect_h) i))))

(def-method :ctx :box)
	;inputs
	;:r0 = view object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = width (pixels)
	;:r10 = height (pixels)
	;trashes
	;:r1-:r3, :f0-:f15

	(entry :ctx :box '(:r0 :r7 :r8 :r9 :r10))

	(call :ctx :reserve '(:r0 3) '(:r0 :r1))
	(vp-cpy-cr +ctx_op_box :r2)
	(assign '(:r2) '((:r1 0)))
	(ctx-rect +long_size)
	(vp-ret)

(def-func-end)

(def-method :ctx :filled_box)
	;inputs
	;:r0 = view object (ptr)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = width (pixels)
	;:r10 = height (pixels)
	;trashes
	;:r1-:r3, :f0-:f15

	(entry :ctx :filled_box '(:r0 :r7 :r8 :r9 :r10))

	(call :ctx :reserve '(:r0 3) '(:r0 :r1))
	(vp-cpy-cr +ctx_op_filled_box :r2)
	(assign '(:r2) '((:r1 0)))
	(ctx-rect +long_size)
	(vp-ret)

(def-func-end)

(def-method :ctx :blit)
	;inputs
	;:r0 = view object (ptr)
	;:r1 = 0, else texture object (ptr)
	;:r2 = color mod (argb)
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = width (pixels)
	;:r10 = height (pixels)
	;:r11 = sx (pixels)
	;:r12 = sy (pixels)
	;trashes
	;:r1-:r5, :r7-:r8, :f0-:f15

	(entry :ctx :blit '(:r0 :r1 :r2 :r7 :r8 :r9 :r10 :r11 :r12))

	(vpif '(:r1 /= 0))
		;the list keeps the texture while it has it
		(class/obj/ref :r1 :r3)
		(vp-cpy-rr :r1 :r4)
		(vp-cpy-rr :r2 :r5)
		(call :ctx :reserve '(:r0 7) '(:r0 :r1))
		(vp-cpy-cr +ctx_op_blit :r2)
		(assign '(:r2 :r4 :r5) `((:r1 0) (:r1 ,(* 3 +long_size)) (:r1 ,(* 4 +long_size))))
		(ctx-rect +long_size)
		(vp-cpy-rr :r11 :r7)
		(vp-cpy-rr :r12 :r8)
		(ctx-rect (* 5 +long_size))
	(endif)
	(vp-ret)

(def-func-end)
