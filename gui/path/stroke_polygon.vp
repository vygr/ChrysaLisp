(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :path :stroke_polygon)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = radius (fixed)
	;:r2 = join style (byte)
	;outputs
	;:r0 = path object (ptr)
	;:r1 = output path1 object (ptr)
	;:r2 = output path2 object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this path1 path2)
		(plong iter_begin_polyline iter_end_polyline)
		(int radius)
		(byte join_style))

	(push-scope)
	(entry :path :stroke_polygon (vpx this radius join_style))

	(call :path :filter_polygon (vpx this this 0.5))
	(call :path :get_both (vpx this) (vpx _ iter_begin_polyline iter_end_polyline))
	(call :path :create :nil (vpx path1))
	(call :path :stroke_joints (vpx path1 iter_begin_polyline iter_end_polyline
		(elem iter_end_polyline (* (- +long_size) 4)) (elem iter_end_polyline (* (- +long_size) 3))
		(elem iter_end_polyline (* (- +long_size) 2)) (elem iter_end_polyline (- +long_size)) radius join_style))
	(call :path :create :nil (vpx path2))
	(call :path :stroke_joints (vpx path2 (- iter_end_polyline (* 2 +long_size))
		(- iter_begin_polyline (* 2 +long_size))
		(elem iter_begin_polyline (* +long_size 2)) (elem iter_begin_polyline (* +long_size 3))
		(elem iter_begin_polyline 0) (elem iter_begin_polyline +long_size) radius join_style))

	(exit :path :stroke_polygon (vpx this path1 path2))
	(pop-scope)
	(return)

(def-func-end)
