(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :gen_cubic)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = p1x (fixed)
	;:r2 = p1y (fixed)
	;:r3 = p2x (fixed)
	;:r4 = p2y (fixed)
	;:r5 = p3x (fixed)
	;:r6 = p3y (fixed)
	;:r7 = p4x (fixed)
	;:r8 = p4y (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r11, :d0-:d15

	(structure slot 0
		(ptr this stack)
		(plong iter_end)
		(union
			(long p1 p2 p3 p4 p12 p23 p34 p123 p234 p1234)
			(int p1x p1y p2x p2y p3x p3y p4x p4y
				p12x p12y p23x p23y p34x p34y p123x p123y p234x p234y p1234x p1234y))
		(uint length))

	(vp-alloc slot_size)
	(entry :path :gen_cubic '((:rsp slot_this) (:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_p2x) (:rsp slot_p2y) (:rsp slot_p3x) (:rsp slot_p3y) (:rsp slot_p4x) (:rsp slot_p4y)))

	;output first point
	(vec-set 0)
	(call :path :push_back2 '((:rsp slot_this) (:rsp slot_p1x) (:rsp slot_p1y)))

	(call :array :create :nil '((:rsp slot_stack)))
	(loop-start)
		;calculate the mid-path
		(vec-load 6 '((:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_p2x) (:rsp slot_p2y) (:rsp slot_p3x) (:rsp slot_p3y)))
		(vec-dup 4)
		(vec-load 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
		(vec-add 6)
		(vec-asr 6 1)
		(vec-store 2 '((:rsp slot_p34x) (:rsp slot_p34y)))
		(vec-tee 4 '((:rsp slot_p12x) (:rsp slot_p12y) (:rsp slot_p23x) (:rsp slot_p23y)))
		(vec-dup 2)
		(vec-load 2 '((:rsp slot_p34x) (:rsp slot_p34y)))
		(vec-add 4)
		(vec-asr 4 1)
		(vec-tee 4 '((:rsp slot_p123x) (:rsp slot_p123y) (:rsp slot_p234x) (:rsp slot_p234y)))
		(vec-add 2)
		(vec-asr 2 1)
		(vec-store 2 '((:rsp slot_p1234x) (:rsp slot_p1234y)))

		;flatness test
		(vec-load 1 '((:rsp slot_p1x)) '((:rsp slot_p3x)))
		(vec-add 1)
		(vec-load 1 '((:rsp slot_p2x)))
		(vec-dup 1)
		(vec-dif 3)
		(vec-load 1 '((:rsp slot_p1y)) '((:rsp slot_p3y)))
		(vec-add 1)
		(vec-load 1 '((:rsp slot_p2y)))
		(vec-dup 1)
		(vec-dif 3)
		(vec-load 1 '((:rsp slot_p2x)) '((:rsp slot_p4x)))
		(vec-add 1)
		(vec-load 1 '((:rsp slot_p3x)))
		(vec-dup 1)
		(vec-dif 3)
		(vec-load 1 '((:rsp slot_p2y)) '((:rsp slot_p4y)))
		(vec-add 1)
		(vec-load 1 '((:rsp slot_p3y)))
		(vec-dup 1)
		(vec-dif 3)
		(vec-abs 4)
		(vec-sum 4)

		(vec-load 1 `(,(logior 0 0.5)))
		(bind '(d e) (vec-pop 2))
		(vpif `(,d <= ,e))
			;output point
			(call :path :push_back2 '((:rsp slot_this) (:rsp slot_p1234x) (:rsp slot_p1234y)))
		(else)
			;continue subdivision
			(d-call :array :get_length '((:rsp slot_stack)) '(_ :r1))
			(vp-add-cr 8 :r1)
			(assign '(:r1) '((:rsp slot_length)))
			(call :array :set_cap '((:rsp slot_stack) :r1))
			(call :array :get_end '((:rsp slot_stack)) '(_ (:rsp slot_iter_end)))
			(call :array :set_length '((:rsp slot_stack) (:rsp slot_length)))
			(vec-load 9 '((:rsp slot_p1234) (:rsp slot_p234) (:rsp slot_p34) (:rsp slot_p4) (:rsp slot_p1) (:rsp slot_p12) (:rsp slot_p123) (:rsp slot_p1234) (:rsp slot_iter_end)))
			(vec-store-long 8 (first (vec-pop 1)))
		(endif)

		(d-call :array :get_length '((:rsp slot_stack)) '(_ :r1))
		(breakif '(:r1 = 0))
		(vp-sub-cr 4 :r1)
		(call :array :set_length '((:rsp slot_stack) :r1))
		(call :array :get_end '((:rsp slot_stack)) '(_ (:rsp slot_iter_end)))
		(vec-load 1 '((:rsp slot_iter_end)))
		(vec-load-long 4 (first (vec-top 1)))
		(vec-store 4 '((:rsp slot_p1) (:rsp slot_p2) (:rsp slot_p3) (:rsp slot_p4)))
		(vec-pop 1)
	(loop-end)
	(call :array :deref '((:rsp slot_stack)))

	;output last point
	(call :path :push_back2 '((:rsp slot_this) (:rsp slot_p4x) (:rsp slot_p4y)))

	(exit :path :gen_cubic '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
