(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :gen_clerp)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = cx (fixed)
	;:r2 = cy (fixed)
	;:r3 = v1x (fixed)
	;:r4 = v1y (fixed)
	;:r5 = v2x (fixed)
	;:r6 = v2y (fixed)
	;:r7 = radius (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r4, :d0-:d15

	(structure slot 0
		(ptr this stack)
		(plong iter_end)
		(union
			(long v1 v2 bv)
			(int v1x v1y v2x v2y bvx bvy))
		(int cx cy radius)
		(uint length))

	(vp-alloc slot_size)
	(entry :path :gen_clerp '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7))
	(save-fields :rsp '(slot_this slot_cx slot_cy slot_v1x slot_v1y slot_v2x slot_v2y slot_radius)
		'(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7))

	(vec-set 0)

	;output first point
	(vec-load 2 '((:rsp slot_cx) (:rsp slot_cy)) '((:rsp slot_v1x) (:rsp slot_v1y)))
	(vec-add 2)
	(vec-store 2 '((:rsp slot_bvx) (:rsp slot_bvy)))
	(call :path :push_back2 '((:rsp slot_this) (:rsp slot_bvx) (:rsp slot_bvy)))

	(call :array :create :nil '((:rsp slot_stack)))
	(loop-start)
		;calculate the mid-point
		(vec-load 2 '((:rsp slot_v1x) (:rsp slot_v1y)) '((:rsp slot_v2x) (:rsp slot_v2y)))
		(vec-add 2)
		(vec-asr 2 1)
		(vec-tee 2 '((:rsp slot_bvx) (:rsp slot_bvy)))
		(vec-load 1 '((:rsp slot_radius)))
		(vec-scale 2)
		(vec-load 2 '((:rsp slot_bvx) (:rsp slot_bvy)))
		(vec-flength 2)
		(vec-load 1 '(1))
		(vec-high 2)
		(vec-dup 1)
		(vec-div 2)
		(vec-store 2 '((:rsp slot_bvx) (:rsp slot_bvy)))

		;flatness test
		(vec-load 1 '((:rsp slot_v1x)) '((:rsp slot_v2x)))
		(vec-add 1)
		(vec-load 1 '((:rsp slot_bvx)))
		(vec-dup 1)
		(vec-dif 3)
		(vec-load 1 '((:rsp slot_v1y)) '((:rsp slot_v2y)))
		(vec-add 1)
		(vec-load 1 '((:rsp slot_bvy)))
		(vec-dup 1)
		(vec-dif 3)
		(vec-abs 2)
		(vec-sum 2)

		(vec-load 1 `(,(logior 0 0.5)))
		(bind '(d e) (vec-pop 2))
		(vpif `(,d <= ,e))
			;output point
			(vec-load 2 '((:rsp slot_bvx) (:rsp slot_bvy)) '((:rsp slot_cx) (:rsp slot_cy)))
			(vec-add 2)
			(vec-store 2 '((:rsp slot_bvx) (:rsp slot_bvy)))
			(call :path :push_back2 '((:rsp slot_this) (:rsp slot_bvx) (:rsp slot_bvy)))
		(else)
			;continue subdivision
			(d-call :array :get_length '((:rsp slot_stack)) '(_ :r1))
			(vp-add-cr 4 :r1)
			(assign '(:r1) '((:rsp slot_length)))
			(call :array :set_cap '((:rsp slot_stack) :r1))
			(call :array :get_end '((:rsp slot_stack)) '(_ (:rsp slot_iter_end)))
			(call :array :set_length '((:rsp slot_stack) (:rsp slot_length)))
			;the two halves to the stack of vectors, loaded in the order they lie in
			(load-fields :rsp '(slot_bv slot_v2 slot_v1 slot_bv slot_iter_end) (vec-push 5))
			(bind '(p) (vec-pop 1))
			(vec-store-long 4 p)
		(endif)

		(d-call :array :get_length '((:rsp slot_stack)) '(_ :r1))
		(breakif '(:r1 = 0))
		(vp-sub-cr 2 :r1)
		(call :array :set_length '((:rsp slot_stack) :r1))
		(call :array :get_end '((:rsp slot_stack)) '(_ (:rsp slot_iter_end)))
		(vec-load 1 '((:rsp slot_iter_end)))
		(bind '(p) (vec-top 1))
		(vec-load-long 2 p)
		(vec-store 2 '((:rsp slot_v1) (:rsp slot_v2)))
		(vec-pop 1)
	(loop-end)
	(call :array :deref '((:rsp slot_stack)))

	;output last point
	(vec-load 2 '((:rsp slot_cx) (:rsp slot_cy)) '((:rsp slot_v2x) (:rsp slot_v2y)))
	(vec-add 2)
	(vec-store 2 '((:rsp slot_bvx) (:rsp slot_bvy)))
	(call :path :push_back2 '((:rsp slot_this) (:rsp slot_bvx) (:rsp slot_bvy)))

	(exit :path :gen_clerp '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
