(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :gen_clerp)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = cx (fixed)
	;:r2 = cy (fixed)
	;:r3 = v1x (fixed)
	;:r4 = v1y (fixed)
	;:r5 = v2x (fixed)
	;:r6 = v2y (fixed)
	;:r7 = radius (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this stack)
		(plong iter_end)
		(union
			(long v1 v2 bv)
			(int v1x v1y v2x v2y bvx bvy))
		(int cx cy radius)
		(uint length))

	(push-scope)
	(entry :path :gen_clerp (vpx this cx cy v1x v1y v2x v2y radius))

	(vec-set 0)

	;output first point
	(vec-load 2 (vpx cx cy) (vpx v1x v1y))
	(vec-add 2)
	(vec-store 2 (vpx bvx bvy))
	(call :path :push_back2 (vpx this bvx bvy))

	(call :array :create :nil (vpx stack))
	(loop-start)
		;calculate the mid-point
		(vec-load 2 (vpx v1x v1y) (vpx v2x v2y))
		(vec-add 2)
		(vec-asr 2 1)
		(vec-tee 2 (vpx bvx bvy))
		(vec-load 1 (vpx radius))
		(vec-scale 2)
		(vec-load 2 (vpx bvx bvy))
		(vec-flength 2)
		(vec-load 1 (vpx 1))
		(vec-high 2)
		(vec-dup 1)
		(vec-div 2)
		(vec-store 2 (vpx bvx bvy))

		;flatness test
		(vec-load 1 (vpx v1x) (vpx v2x))
		(vec-add 1)
		(vec-load 1 (vpx bvx))
		(vec-dup 1)
		(vec-dif 3)
		(vec-load 1 (vpx v1y) (vpx v2y))
		(vec-add 1)
		(vec-load 1 (vpx bvy))
		(vec-dup 1)
		(vec-dif 3)
		(vec-abs 2)
		(vec-sum 2)

		(vec-load 1 (vpx 0.5))
		(bind '(d e) (vec-pop 2))
		(vpif `(,d <= ,e))
			;output point
			(vec-load 2 (vpx bvx bvy) (vpx cx cy))
			(vec-add 2)
			(vec-store 2 (vpx bvx bvy))
			(call :path :push_back2 (vpx this bvx bvy))
		(else)
			;continue subdivision
			(d-call :array :get_length (vpx stack) (vpx _ length))
			(call :array :set_cap (vpx stack (+ length 4)))
			(call :array :get_end (vpx stack) (vpx _ iter_end))
			(call :array :set_length (vpx stack (+ length 4)))
			(vec-load 5 (vpx bv v2 v1 bv iter_end))
			(bind '(p) (vec-pop 1))
			(vec-store-long 4 p)
		(endif)

		(d-call :array :get_length (vpx stack) (vpx _ length))
		(breakifnot (vpx length))
		(call :array :set_length (vpx stack (- length 2)))
		(call :array :get_end (vpx stack) (vpx _ iter_end))
		(vec-load 1 (vpx iter_end))
		(bind '(p) (vec-top 1))
		(vec-load-long 2 p)
		(vec-store 2 (vpx v1 v2))
		(vec-pop 1)
	(loop-end)
	(call :array :deref (vpx stack))

	;output last point
	(vec-load 2 (vpx cx cy) (vpx v2x v2y))
	(vec-add 2)
	(vec-store 2 (vpx bvx bvy))
	(call :path :push_back2 (vpx this bvx bvy))

	(exit :path :gen_clerp (vpx this))
	(pop-scope)
	(return)

(def-func-end)
