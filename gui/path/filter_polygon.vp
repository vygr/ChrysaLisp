(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :filter_polygon)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = source path object, can be same (ptr)
	;:r2 = tolerance (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r9, :f0-:f15

	(def-vars
		(ptr this that)
		(pptr iter_begin iter_end)
		(int eps))

	;the named locals are kept in registers where they can be
	(push-scope)
	(entry :path :filter_polygon (vpx this that eps))

	(call :path :filter_polyline (vpx this that eps))
	(call :path :get_both (vpx this) (vpx _ iter_begin iter_end))

	(vec-set 0)
	(vec-load 2 (vpx iter_end iter_begin))
	(vec-dup 2)
	(vec-dif 2)
	(vpif (list (first (vec-pop 1)) '> (* 2 +long_size)))
		(vec-load 1 (vpx eps))
		(vec-fsquare 1)
		(bind '(e i x) (vec-top 3))
		(vec-load-long 2 i)
		(vec-load-long 2 e (* -2 +long_size))
		(vec-fdistance-squared 2)
		(vpif (list (first (vec-pop 1)) '< x))
			(call :path :pop_back2 (vpx this))
		(endif)
	(endif)

	(exit :path :filter_polygon (vpx this))
	(pop-scope)
	(return)

(def-func-end)
