(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :filter_polygon)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = source path object, can be same (ptr)
	;:r2 = tolerance (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	;the frame is what the filter of the line is called over, and this
	;for the end: that filter gives it back
	(structure slot 0
		(ptr this)
		(long eps))

	(vp-alloc slot_size)
	(entry :path :filter_polygon '(:r0 :r1 (:rsp slot_eps)))

	(call :path :filter_polyline '(:r0 :r1 :r2) '(:r2))
	(assign '(:r2) '((:rsp slot_this)))

	;the end and the begin, as two on the stack of vectors
	(class/array/get_both :r2 :r1 :r0)
	(vec-set 2)
	(vec-dup 2)
	(vec-dif 2)
	(vpif (list (first (vec-pop 1)) '> (* 2 +long_size)))
		(vec-load 1 '((:rsp slot_eps)))
		(vec-fsquare 1)
		(bind '(e i x) (vec-top 3))
		(vec-load-long 2 i)
		(vec-load-long 2 e (* -2 +long_size))
		(vec-fdistance-squared 2)
		(vpif (list (first (vec-pop 1)) '< x))
			(call :path :pop_back2 '((:rsp slot_this)))
		(endif)
	(endif)

	(exit :path :filter_polygon '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
