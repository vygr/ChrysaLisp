(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :filter_polygon)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = source path object, can be same (ptr)
	;:r2 = tolerance (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(structure local 0
		(ptr this that)
		(pptr iter_begin iter_end)
		(int eps))

	;the named locals are kept in registers where they can be
	(vp-alloc local_size)
	(entry :path :filter_polygon '((:rsp local_this) (:rsp local_that) (:rsp local_eps)))

	(call :path :filter_polyline '((:rsp local_this) (:rsp local_that) (:rsp local_eps)))
	(call :path :get_both '((:rsp local_this)) '(_ (:rsp local_iter_begin) (:rsp local_iter_end)))

	(vec-set 0)
	(vec-load 2 '((:rsp local_iter_end) (:rsp local_iter_begin)))
	(vec-dup 2)
	(vec-dif 2)
	(vpif (list (first (vec-pop 1)) '> (* 2 +long_size)))
		(vec-load 1 '((:rsp local_eps)))
		(vec-fsquare 1)
		(bind '(e i x) (vec-top 3))
		(vec-load-long 2 i)
		(vec-load-long 2 e (* -2 +long_size))
		(vec-fdistance-squared 2)
		(vpif (list (first (vec-pop 1)) '< x))
			(call :path :pop_back2 '((:rsp local_this)))
		(endif)
	(endif)

	(exit :path :filter_polygon '((:rsp local_this)))
	(vp-free local_size)
	(vp-ret)

(def-func-end)
