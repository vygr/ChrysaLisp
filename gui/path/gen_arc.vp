(include "lib/asm/func.inc")
(include "./class.inc")
(include "sys/math/class.inc")

(def-method :path :gen_arc)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = cx (fixed)
	;:r2 = cy (fixed)
	;:r3 = start angle (fixed)
	;:r4 = end angle (fixed)
	;:r5 = radius (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this)
		(int v1x v1y v2x v2y cx cy radius)
		(union
			(int ca1 ca2 sa1 sa2)
			(int a1 a2 ah)))

	(push-scope)
	(entry :path :gen_arc (vpx this cx cy a1 a2 radius))

	(vec-set 0)
	(vec-load 2 (vpx a1 +fp_2pi))
	(vec-fmod 1)
	(vec-store 1 (vpx a1))
	(vpif (vpx (> a2 +fp_2pi)))
		(vec-load 2 (vpx a2 +fp_2pi))
		(vec-fmod 1)
		(vec-store 1 (vpx a2))
	(endif)

	(vpif (vpx (<= a2 +fp_hpi)))
		(assign (vpx (+ a1 a2)) (vpx a2))
		(call :sys_math :f_sin (vpx a1) (vpx sa1))
		(call :sys_math :f_cos (vpx a1) (vpx ca1))
		(call :sys_math :f_sin (vpx a2) (vpx sa2))
		(call :sys_math :f_cos (vpx a2) (vpx ca2))
		(vec-load 5 (vpx sa1 ca1 sa2 ca2 radius))
		(vec-fscale 4)
		(vec-store 2 (vpx v2x v2y) (vpx v1x v1y))
		(call :path :gen_clerp (vpx this cx cy v1x v1y v2x v2y radius))
	(else)
		(assign (vpx (>>> a2 1)) (vpx ah))
		(assign (vpx (- a2 ah)) (vpx a2))
		(call :path :gen_arc (vpx this cx cy a1 ah radius))
		(call :path :gen_arc (vpx this cx cy (+ a1 ah) a2 radius))
	(endif)

	(exit :path :gen_arc (vpx this))
	(pop-scope)
	(return)

(def-func-end)
