(include "lib/asm/func.inc")
(include "./class.inc")
(include "sys/math/class.inc")

(def-method :path :gen_arc)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = cx (fixed)
	;:r2 = cy (fixed)
	;:r3 = start angle (fixed)
	;:r4 = end angle (fixed)
	;:r5 = radius (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15

	(structure slot 0
		(ptr this)
		(int v1x v1y v2x v2y cx cy radius)
		(union
			(int ca1 ca2 sa1 sa2)
			(int a1 a2 ah)))

	(vp-alloc slot_size)
	(entry :path :gen_arc '(:r0 :r1 :r2 :r3 :r4 :r5))
	(save-fields :rsp '(slot_this slot_cx slot_cy slot_a1 slot_a2 slot_radius) '(:r0 :r1 :r2 :r3 :r4 :r5))

	(vec-set 0)
	(vec-load 2 `((:rsp slot_a1) ,(logior 0 +fp_2pi)))
	(vec-fmod 1)
	(vec-store 1 '((:rsp slot_a1)))
	(assign '((:rsp slot_a2)) '(:r0))
	(vpif `(:r0 > ,(logior 0 +fp_2pi)))
		(vec-load 2 `((:rsp slot_a2) ,(logior 0 +fp_2pi)))
		(vec-fmod 1)
		(vec-store 1 '((:rsp slot_a2)))
	(endif)

	(assign '((:rsp slot_a2)) '(:r0))
	(vpif `(:r0 <= ,(logior 0 +fp_hpi)))
		(assign '((:rsp slot_a1)) '(:r1))
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:rsp slot_a2)))
		(call :sys_math :f_sin '((:rsp slot_a1)) '((:rsp slot_sa1)))
		(call :sys_math :f_cos '((:rsp slot_a1)) '((:rsp slot_ca1)))
		(call :sys_math :f_sin '((:rsp slot_a2)) '((:rsp slot_sa2)))
		(call :sys_math :f_cos '((:rsp slot_a2)) '((:rsp slot_ca2)))
		(vec-load 5 '((:rsp slot_sa1) (:rsp slot_ca1) (:rsp slot_sa2) (:rsp slot_ca2) (:rsp slot_radius)))
		(vec-fscale 4)
		(vec-store 2 '((:rsp slot_v2x) (:rsp slot_v2y)) '((:rsp slot_v1x) (:rsp slot_v1y)))
		(call :path :gen_clerp '((:rsp slot_this) (:rsp slot_cx) (:rsp slot_cy) (:rsp slot_v1x) (:rsp slot_v1y) (:rsp slot_v2x) (:rsp slot_v2y) (:rsp slot_radius)))
	(else)
		;two arcs, of half the angle each
		(vp-cpy-rr :r0 :r1)
		(vp-asr-cr 1 :r1)
		(vp-sub-rr :r1 :r0)
		(save-fields :rsp '(slot_a2 slot_ah) '(:r0 :r1))
		(call :path :gen_arc '((:rsp slot_this) (:rsp slot_cx) (:rsp slot_cy) (:rsp slot_a1) (:rsp slot_ah) (:rsp slot_radius)))
		(load-fields :rsp '(slot_a1 slot_a2 slot_ah) '(:r3 :r4 :r6))
		(vp-add-rr :r6 :r3)
		(call :path :gen_arc '((:rsp slot_this) (:rsp slot_cx) (:rsp slot_cy) :r3 :r4 (:rsp slot_radius)))
	(endif)

	(exit :path :gen_arc '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
