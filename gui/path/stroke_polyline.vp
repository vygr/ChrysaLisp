(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :stroke_polyline)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = radius (fixed)
	;:r2 = join style (byte)
	;:r3 = cap style1 (byte)
	;:r4 = cap style2 (byte)
	;outputs
	;:r0 = path object (ptr)
	;:r1 = output path object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	;the paths first, then the points: a call given a path and a point
	;loads them going up, the point's two as neighbours
	(structure slot 0
		(ptr this path1)
		(plong iter iter_begin iter_end limit)
		(union
			(long p1 p2 p3 p4 l2_v l2_pv l2_npv l2_rv)
			(int p1x p1y p2x p2y p3x p3y p4x p4y
				l2_vx l2_vy l2_pvx l2_pvy l2_npvx l2_npvy l2_rvx l2_rvy))
		(int radius step)
		(byte join_style cap1_style cap2_style))

	(vp-alloc slot_size)
	(entry :path :stroke_polyline '((:rsp slot_this) (:rsp slot_radius) (:rsp slot_join_style) (:rsp slot_cap1_style) (:rsp slot_cap2_style)))

	(vec-set 0)
	(call :path :filter_polyline `((:rsp slot_this) (:rsp slot_this) ,(logior 0 0.5)))
	(call :path :create :nil '((:rsp slot_path1)))
	(call :path :get_both '((:rsp slot_this)) '(_ :r1 :r2))
	(save-fields :rsp '(slot_iter slot_iter_end) '(:r1 :r2))
	(vp-sub-rr :r1 :r2)
	(vpif `(:r2 >= ,(* 4 +ptr_size)))
		(vp-lea-rcr :r1 (* -2 +long_size) :r4)
		(assign `(,(* 2 +long_size)) '(:r5))
		(save-fields :rsp '(slot_iter_begin slot_step) '(:r4 :r5))
		(loop-start)
			;p1 and p2, the two points from iter the way of the walk
			(load-fields :rsp '(slot_iter slot_step) '(:r0 :r1))
			(load-fields :r0 '(0 +long_size) '(:r2 :r3))
			(vp-add-rr :r1 :r0)
			(load-fields :r0 '(0 +long_size) '(:r4 :r5))
			(vp-add-rr :r1 :r0)
			(save-fields :rsp '(slot_p1x slot_p1y slot_p2x slot_p2y slot_iter) '(:r2 :r3 :r4 :r5 :r0))
			(vec-load 2 '((:rsp slot_p2x) (:rsp slot_p2y)) '((:rsp slot_p1x) (:rsp slot_p1y)))
			(vec-sub 2)
			(vec-tee 2 '((:rsp slot_l2_vx) (:rsp slot_l2_vy)))
			(vec-perp)
			(vec-tee 2 '((:rsp slot_l2_pvx) (:rsp slot_l2_pvy)))
			(vec-fnorm 2)
			(vec-tee 2 '((:rsp slot_l2_npvx) (:rsp slot_l2_npvy)))
			(vec-load 1 '((:rsp slot_radius)))
			(vec-fscale 2)
			(vec-store 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))

			;the cap of this end, in :r1
			(load-fields :rsp '(slot_step slot_cap1_style slot_cap2_style) '(:r0 :r1 :r2))
			(vpif '(:r0 <= 0))
				(vp-cpy-rr :r2 :r1)
			(endif)
			(switch)
			(vpcase `(:r1 = ,+cap_butt))
				;butt cap
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)))
				(vec-goto 'out_cap)
			(vpcase `(:r1 = ,+cap_square))
				;square cap
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)) '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-perp)
				(vec-add 2)
			(vp-label 'out_cap)
				(vec-load 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-dup 4)
				(vec-sub 2)
				(vec-goto 'store_p3p4)
			(vpcase `(:r1 = ,+cap_tri))
				;triangle cap
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)) '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-dup 4)
				(vec-dup 4)
				(vec-sub 2)
				(vec-store 2 '((:rsp slot_p1x) (:rsp slot_p1y)))
				(vec-perp)
				(vec-add 2)
				(vec-store 2 '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-add 2)
				(vec-store 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
				(call :path :push_back2 '((:rsp slot_path1) (:rsp slot_p1x) (:rsp slot_p1y)))
				(goto 'out_p3p4)
			(vpcase `(:r1 = ,+cap_arrow))
				;arrow cap
				(vec-load 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-shl 2 1)
				(vec-store 2 '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)) '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-sub 2)
				(vec-store 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
				(call :path :push_back2 '((:rsp slot_path1) (:rsp slot_p4x) (:rsp slot_p4y)))
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)) '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-sub 2)
				(vec-store 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
				(call :path :push_back2 '((:rsp slot_path1) (:rsp slot_p4x) (:rsp slot_p4y)))
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)) '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-perp)
				(vec-add 2)
				(vec-store 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
				(call :path :push_back2 '((:rsp slot_path1) (:rsp slot_p4x) (:rsp slot_p4y)))
				(vec-load 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)) '((:rsp slot_p1x) (:rsp slot_p1y)))
				(vec-dup 2)
				(vec-load 2 '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-add 2)
			(vp-label 'store_p3p4)
				(vec-store 2 '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-add 2)
				(vec-store 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
			(vp-label 'out_p3p4)
				(call :path :push_back2 '((:rsp slot_path1) (:rsp slot_p3x) (:rsp slot_p3y)))
				(call :path :push_back2 '((:rsp slot_path1) (:rsp slot_p4x) (:rsp slot_p4y)))
			(else)
				;round cap
				(vec-load 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-dup 2)
				(vec-perp)
				(vec-store 2 '((:rsp slot_p3x) (:rsp slot_p3y)))
				(vec-load 1 '(-1))
				(vec-scale 2)
				(vec-store 2 '((:rsp slot_p4x) (:rsp slot_p4y)))
				(call :path :gen_clerp '((:rsp slot_path1) (:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_p4x) (:rsp slot_p4y) (:rsp slot_p3x) (:rsp slot_p3y) (:rsp slot_radius)))
				(call :path :gen_clerp '((:rsp slot_path1) (:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_p3x) (:rsp slot_p3y) (:rsp slot_l2_rvx) (:rsp slot_l2_rvy) (:rsp slot_radius)))
			(endswitch)
			;the joints, from here to the end the walk is heading for. The
			;way back starts again from the points themselves
			(load-fields :rsp '(slot_step slot_iter_begin slot_iter_end) '(:r0 :r1 :r2))
			(vpif '(:r0 <= 0))
				(vp-cpy-rr :r1 :r2)
			(endif)
			(assign '(:r2) '((:rsp slot_limit)))
			;a cap may have moved p1, so the start of the line is worked back
			;from its end
			(load-fields :rsp '(slot_p2x slot_p2y slot_l2_vx slot_l2_vy) '(:r3 :r4 :r7 :r8))
			(assign '(:r3 :r4) '(:r5 :r6))
			(vp-sub-rr :r7 :r3)
			(vp-sub-rr :r8 :r4)
			(load-fields :rsp '(slot_iter slot_limit slot_path1 slot_radius slot_join_style) '(:r1 :r2 :r0 :r7 :r8))
			(call :path :stroke_joints '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8))
			;back the other way from the end, once
			(load-fields :rsp '(slot_limit slot_step) '(:r0 :r1))
			(assign '(:r0) '((:rsp slot_iter)))
			(breakif '(:r1 < 0))
			(vp-mul-cr -1 :r1)
			(vp-add-rr :r1 :r0)
			(save-fields :rsp '(slot_iter slot_step) '(:r0 :r1))
		(loop-end)
	(endif)

	(exit :path :stroke_polyline '((:rsp slot_this) (:rsp slot_path1)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
