(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :stroke_polyline)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = radius (fixed)
	;:r2 = join style (byte)
	;:r3 = cap style1 (byte)
	;:r4 = cap style2 (byte)
	;outputs
	;:r0 = path object (ptr)
	;:r1 = output path object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(union
			(long p1 p2 p3 p4 l2_v l2_pv l2_npv l2_rv)
			(int p1x p1y p2x p2y p3x p3y p4x p4y
				l2_vx l2_vy l2_pvx l2_pvy l2_npvx l2_npvy l2_rvx l2_rvy))
		(plong iter iter_begin iter_end limit)
		(ptr this path1)
		(int radius step c)
		(byte join_style cap1_style cap2_style))

	(push-scope)
	(scope-used p1 p2 p3 p4 l2_v l2_pv l2_npv l2_rv)
	(entry :path :stroke_polyline (vpx this radius join_style cap1_style cap2_style))

	(vec-set 0)
	(call :path :filter_polyline (vpx this this 0.5))
	(call :path :create :nil (vpx path1))
	(call :path :get_both (vpx this) (vpx _ iter iter_end))
	(vpif (vpx (>= (- iter_end iter) (* 4 +ptr_size))))
		(assign (vpx (- iter (* 2 +long_size)) (* 2 +long_size)) (vpx iter_begin step))
		(loop-start)
			(assign (vpx (elem iter 0)) (vpx p1x))
			(assign (vpx (elem iter +long_size)) (vpx p1y))
			(assign (vpx (+ iter step)) (vpx iter))
			(assign (vpx (elem iter 0)) (vpx p2x))
			(assign (vpx (elem iter +long_size)) (vpx p2y))
			(assign (vpx (+ iter step)) (vpx iter))
			(vec-load 2 (vpx p2x p2y) (vpx p1x p1y))
			(vec-sub 2)
			(vec-tee 2 (vpx l2_vx l2_vy))
			(vec-perp)
			(vec-tee 2 (vpx l2_pvx l2_pvy))
			(vec-fnorm 2)
			(vec-tee 2 (vpx l2_npvx l2_npvy))
			(vec-load 1 (vpx radius))
			(vec-fscale 2)
			(vec-store 2 (vpx l2_rvx l2_rvy))

			(vpif (vpx (> step 0)))
				(assign (vpx cap1_style) (vpx c))
			(else)
				(assign (vpx cap2_style) (vpx c))
			(endif)
			(switch)
			(vpcase (vpx (= c +cap_butt)))
				;butt cap
				(vec-load 2 (vpx p1x p1y))
				(vec-goto 'out_cap)
			(vpcase (vpx (= c +cap_square)))
				;square cap
				(vec-load 2 (vpx p1x p1y) (vpx l2_rvx l2_rvy))
				(vec-perp)
				(vec-add 2)
			(vp-label 'out_cap)
				(vec-load 2 (vpx l2_rvx l2_rvy))
				(vec-dup 4)
				(vec-sub 2)
				(vec-goto 'store_p3p4)
			(vpcase (vpx (= c +cap_tri)))
				;triangle cap
				(vec-load 2 (vpx p1x p1y) (vpx l2_rvx l2_rvy))
				(vec-dup 4)
				(vec-dup 4)
				(vec-sub 2)
				(vec-store 2 (vpx p1x p1y))
				(vec-perp)
				(vec-add 2)
				(vec-store 2 (vpx p3x p3y))
				(vec-add 2)
				(vec-store 2 (vpx p4x p4y))
				(call :path :push_back2 (vpx path1 p1x p1y))
				(goto 'out_p3p4)
			(vpcase (vpx (= c +cap_arrow)))
				;arrow cap
				(vec-load 2 (vpx l2_rvx l2_rvy))
				(vec-shl 2 1)
				(vec-store 2 (vpx p3x p3y))
				(vec-load 2 (vpx p1x p1y) (vpx l2_rvx l2_rvy))
				(vec-sub 2)
				(vec-store 2 (vpx p4x p4y))
				(call :path :push_back2 (vpx path1 p4x p4y))
				(vec-load 2 (vpx p1x p1y) (vpx p3x p3y))
				(vec-sub 2)
				(vec-store 2 (vpx p4x p4y))
				(call :path :push_back2 (vpx path1 p4x p4y))
				(vec-load 2 (vpx p1x p1y) (vpx p3x p3y))
				(vec-perp)
				(vec-add 2)
				(vec-store 2 (vpx p4x p4y))
				(call :path :push_back2 (vpx path1 p4x p4y))
				(vec-load 2 (vpx l2_rvx l2_rvy) (vpx p1x p1y))
				(vec-dup 2)
				(vec-load 2 (vpx p3x p3y))
				(vec-add 2)
			(vp-label 'store_p3p4)
				(vec-store 2 (vpx p3x p3y))
				(vec-add 2)
				(vec-store 2 (vpx p4x p4y))
			(vp-label 'out_p3p4)
				(call :path :push_back2 (vpx path1 p3x p3y))
				(call :path :push_back2 (vpx path1 p4x p4y))
			(else)
				;round cap
				(vec-load 2 (vpx l2_rvx l2_rvy))
				(vec-dup 2)
				(vec-perp)
				(vec-store 2 (vpx p3x p3y))
				(vec-load 1 (vpx (- 1)))
				(vec-scale 2)
				(vec-store 2 (vpx p4x p4y))
				(call :path :gen_clerp (vpx path1 p1x p1y p4x p4y p3x p3y radius))
				(call :path :gen_clerp (vpx path1 p1x p1y p3x p3y l2_rvx l2_rvy radius))
			(endswitch)
			;the joints, from here to the end the walk is heading for. The
			;way back starts again from the points themselves
			(vpif (vpx (> step 0)))
				(assign (vpx iter_end) (vpx limit))
			(else)
				(assign (vpx iter_begin) (vpx limit))
			(endif)
			;a cap may have moved p1, so the start of the line is worked back
			;from its end
			(call :path :stroke_joints (vpx path1 iter limit (- p2x l2_vx) (- p2y l2_vy)
				p2x p2y radius join_style))
			(assign (vpx limit) (vpx iter))
			(breakif (vpx (< step 0)))
			(assign (vpx (- step)) (vpx step))
			(assign (vpx (+ iter step)) (vpx iter))
		(loop-end)
	(endif)

	(exit :path :stroke_polyline (vpx this path1))
	(pop-scope)
	(return)

(def-func-end)
