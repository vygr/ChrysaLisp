(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :stroke_joints)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = in path start iter (plong)
	;:r2 = in path end iter (plong)
	;:r3 = p1x (fixed)
	;:r4 = p1y (fixed)
	;:r5 = p2x (fixed)
	;:r6 = p2y (fixed)
	;:r7 = radius (fixed)
	;:r8 = join style (byte)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(union
			(long p1 p2 p3 l2_v l2_pv l2_npv l2_rv l1_v l1_npv l1_rv)
			(int p1x p1y p2x p2y p3x p3y
				l2_vx l2_vy l2_pvx l2_pvy l2_npvx l2_npvy l2_rvx l2_rvy
				l1_vx l1_vy l1_npvx l1_npvy l1_rvx l1_rvy))
		(plong iter_i iter_j)
		(ptr this)
		(int radius step c c1 l1_len l2_len back room)
		(byte join_style))

	(push-scope)
	(scope-used l2_pv l1_vx l1_vy p3)
	(entry :path :stroke_joints (vpx this iter_i iter_j p1x p1y p2x p2y radius join_style))

	(vpif (vpx (/= iter_i iter_j)))
		(vpif (vpx (> iter_j iter_i)))
			(assign (vpx (* 2 +long_size)) (vpx step))
		(else)
			(assign (vpx (* (- 2) +long_size)) (vpx step))
		(endif)

		(vec-set 0)
		(vec-load 2 (vpx p2x p2y) (vpx p1x p1y))
		(vec-sub 2)
		(vec-tee 2 (vpx l2_vx l2_vy))
		(vec-perp)
		(vec-tee 2 (vpx l2_pvx l2_pvy))
		(vec-fnorm 2)
		(vec-tee 2 (vpx l2_npvx l2_npvy))
		(vec-load 1 (vpx radius))
		(vec-fscale 2)
		(vec-store 2 (vpx l2_rvx l2_rvy))
		(vec-load 2 (vpx l2_vx l2_vy))
		(vec-flength 2)
		(vec-store 1 (vpx l2_len))

		(loop-start)
			(vec-load 4 (vpx p2 l2_v l2_npv l2_rv))
			(vec-store 4 (vpx p1 l1_v l1_npv l1_rv))
			(assign (vpx l2_len) (vpx l1_len))
			(assign (vpx (elem iter_i 0)) (vpx p2x))
			(assign (vpx (elem iter_i +long_size)) (vpx p2y))
			(assign (vpx (+ iter_i step)) (vpx iter_i))
			(vec-load 2 (vpx p2x p2y) (vpx p1x p1y))
			(vec-sub 2)
			(vec-tee 2 (vpx l2_vx l2_vy))
			(vec-perp)
			(vec-tee 2 (vpx l2_pvx l2_pvy))
			(vec-fnorm 2)
			(vec-tee 2 (vpx l2_npvx l2_npvy))
			(vec-load 1 (vpx radius))
			(vec-fscale 2)
			(vec-store 2 (vpx l2_rvx l2_rvy))
			(vec-load 2 (vpx l2_vx l2_vy))
			(vec-flength 2)
			(vec-store 1 (vpx l2_len))

			;what kind of join
			(vec-load 2 (vpx l1_npvx l1_npvy) (vpx l2_npvx l2_npvy))
			(vec-dup 4)
			(vec-perp)
			(vec-fdot 2)
			(vec-store 1 (vpx c))
			(vec-fdot 2)
			(vec-store 1 (vpx c1))

			;on the inside of a turn the two edges meet at a point that is some
			;way back along both lines, further the sharper the turn. Is it
			;further back than the shorter of the lines is long ?
			(vec-load 2 (vpx l1_len l2_len))
			(vec-min 1)
			(vec-load 1 (vpx (+ c1 1.0)))
			(vec-fmul 1)
			(vec-store 1 (vpx room))
			(vec-load 2 (vpx radius (- 0 c)))
			(vec-fmul 1)
			(vec-store 1 (vpx back))

			(switch)
			(vpcase (vpx (|| (&& (< c 0.01) (> c (- 0.01))) (< c1 (- 0.9)))))
				;accuracy limit
				(goto 'do_bevel)
			(vpcase (vpx (&& (<= c 0) (> back room))))
				;too sharp for lines this short, the point where the edges
				;meet would be out past the ends of them, a spike
				(goto 'do_bevel)
			(vpcase (vpx (|| (<= c 0) (= join_style +join_miter))))
				;mitre join
				(vec-load 2 (vpx p1x p1y))
				(vec-dup 2)
				(vec-load 4 (vpx l1_rvx l1_rvy l2_rvx l2_rvy))
				(vec-add 4)
				(vec-store 4 (vpx p3x p3y p1x p1y))
				(call :sys_math :f_intersect (vpx p3x p3y p1x p1y l1_vx l1_vy l2_vx l2_vy) (vpx p1x p1y))
				(goto 'out_p1)
			(vpcase (vpx (= join_style +join_bevel)))
			(vp-label 'do_bevel)
				;bevel join
				(vec-load 2 (vpx p1x p1y))
				(vec-dup 2)
				(vec-load 4 (vpx l1_rvx l1_rvy l2_rvx l2_rvy))
				(vec-add 4)
				(vec-store 4 (vpx p3x p3y p1x p1y))
				(call :path :push_back2 (vpx this p3x p3y))
			(vp-label 'out_p1)
				(call :path :push_back2 (vpx this p1x p1y))
			(else)
				;rounded join
				(call :path :gen_clerp (vpx this p1x p1y l1_rvx l1_rvy l2_rvx l2_rvy radius))
			(endswitch)
		(loop-until (vpx (= iter_i iter_j)))
	(endif)

	(exit :path :stroke_joints (vpx this))
	(pop-scope)
	(return)

(def-func-end)
