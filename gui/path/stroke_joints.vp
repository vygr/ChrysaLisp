(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :stroke_joints)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = in path start iter (plong)
	;:r2 = in path end iter (plong)
	;:r3 = p1x (fixed)
	;:r4 = p1y (fixed)
	;:r5 = p2x (fixed)
	;:r6 = p2y (fixed)
	;:r7 = radius (fixed)
	;:r8 = join style (byte)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(structure slot 0
		(union
			(long p1 p2 p3 l2_v l2_pv l2_npv l2_rv l1_v l1_npv l1_rv)
			(int p1x p1y p2x p2y p3x p3y
				l2_vx l2_vy l2_pvx l2_pvy l2_npvx l2_npvy l2_rvx l2_rvy
				l1_vx l1_vy l1_npvx l1_npvy l1_rvx l1_rvy))
		(plong iter_i iter_j)
		(ptr this)
		(int radius step c c1 l1_len l2_len back room)
		(byte join_style))

	(vp-alloc slot_size)
	(entry :path :stroke_joints '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8))
	(save-fields :rsp '(slot_this slot_iter_i slot_iter_j slot_p1x slot_p1y slot_p2x slot_p2y slot_radius slot_join_style)
		'(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(vpif '(:r1 /= :r2))
		(vpif '(:r2 > :r1))
			(assign `(,(* 2 +long_size)) '(:r3))
		(else)
			(assign `(,(* -2 +long_size)) '(:r3))
		(endif)
		(assign '(:r3) '((:rsp slot_step)))

		(vec-set 0)
		(vec-load 2 '((:rsp slot_p2x) (:rsp slot_p2y)) '((:rsp slot_p1x) (:rsp slot_p1y)))
		(vec-sub 2)
		(vec-tee 2 '((:rsp slot_l2_vx) (:rsp slot_l2_vy)))
		(vec-perp)
		(vec-tee 2 '((:rsp slot_l2_pvx) (:rsp slot_l2_pvy)))
		(vec-fnorm 2)
		(vec-tee 2 '((:rsp slot_l2_npvx) (:rsp slot_l2_npvy)))
		(vec-load 1 '((:rsp slot_radius)))
		(vec-fscale 2)
		(vec-store 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
		(vec-load 2 '((:rsp slot_l2_vx) (:rsp slot_l2_vy)))
		(vec-flength 2)
		(vec-store 1 '((:rsp slot_l2_len)))

		(loop-start)
			(vec-load 4 '((:rsp slot_p2) (:rsp slot_l2_v) (:rsp slot_l2_npv) (:rsp slot_l2_rv)))
			(vec-store 4 '((:rsp slot_p1) (:rsp slot_l1_v) (:rsp slot_l1_npv) (:rsp slot_l1_rv)))
			(assign '((:rsp slot_l2_len)) '(:r0))
			(assign '(:r0) '((:rsp slot_l1_len)))
			(load-fields :rsp '(slot_iter_i slot_step) '(:r0 :r1))
			(assign '((:r0 0) (:r0 +long_size)) '(:r2 :r3))
			(vp-add-rr :r1 :r0)
			(save-fields :rsp '(slot_p2x slot_p2y slot_iter_i) '(:r2 :r3 :r0))
			(vec-load 2 '((:rsp slot_p2x) (:rsp slot_p2y)) '((:rsp slot_p1x) (:rsp slot_p1y)))
			(vec-sub 2)
			(vec-tee 2 '((:rsp slot_l2_vx) (:rsp slot_l2_vy)))
			(vec-perp)
			(vec-tee 2 '((:rsp slot_l2_pvx) (:rsp slot_l2_pvy)))
			(vec-fnorm 2)
			(vec-tee 2 '((:rsp slot_l2_npvx) (:rsp slot_l2_npvy)))
			(vec-load 1 '((:rsp slot_radius)))
			(vec-fscale 2)
			(vec-store 2 '((:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
			(vec-load 2 '((:rsp slot_l2_vx) (:rsp slot_l2_vy)))
			(vec-flength 2)
			(vec-store 1 '((:rsp slot_l2_len)))

			;what kind of join
			(vec-load 2 '((:rsp slot_l1_npvx) (:rsp slot_l1_npvy)) '((:rsp slot_l2_npvx) (:rsp slot_l2_npvy)))
			(vec-dup 4)
			(vec-perp)
			(vec-fdot 2)
			(vec-store 1 '((:rsp slot_c)))
			(vec-fdot 2)
			(vec-store 1 '((:rsp slot_c1)))

			;on the inside of a turn the two edges meet at a point that is some
			;way back along both lines, further the sharper the turn. Is it
			;further back than the shorter of the lines is long ?
			(vec-load 2 '((:rsp slot_l1_len) (:rsp slot_l2_len)))
			(vec-min 1)
			(vec-load 2 `((:rsp slot_c1) ,(logior 0 1.0)))
			(vec-add 1)
			(vec-fmul 1)
			(vec-store 1 '((:rsp slot_room)))
			(vec-load 2 '((:rsp slot_radius) (:rsp slot_c)))
			(bind '(nc) (vec-top 1))
			(vp-mul-cr -1 nc)
			(vec-fmul 1)
			(vec-store 1 '((:rsp slot_back)))

			;c :r0, c1 :r1, back :r2, room :r3, the join style :r4
			(load-fields :rsp '(slot_c slot_c1 slot_back slot_room slot_join_style) '(:r0 :r1 :r2 :r3 :r4))
			(switch)
			(vpcase `(:r0 < ,(logior 0 0.01)) `(:r0 > ,(logior 0 -0.01)))
				;accuracy limit
				(goto 'do_bevel)
			(vpcase `(:r1 < ,(logior 0 -0.9)))
				(goto 'do_bevel)
			(vpcase '(:r0 <= 0) '(:r2 > :r3))
				;too sharp for lines this short, the point where the edges
				;meet would be out past the ends of them, a spike
				(goto 'do_bevel)
			(vpcase `(:r4 = ,+join_miter))
				(goto 'do_mitre)
			(vpcase '(:r0 <= 0))
			(vp-label 'do_mitre)
				;mitre join
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)))
				(vec-dup 2)
				(vec-load 4 '((:rsp slot_l1_rvx) (:rsp slot_l1_rvy) (:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-add 4)
				(vec-store 4 '((:rsp slot_p3x) (:rsp slot_p3y) (:rsp slot_p1x) (:rsp slot_p1y)))
				(call :sys_math :f_intersect '((:rsp slot_p3x) (:rsp slot_p3y) (:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_l1_vx) (:rsp slot_l1_vy) (:rsp slot_l2_vx) (:rsp slot_l2_vy)) '((:rsp slot_p1x) (:rsp slot_p1y)))
				(goto 'out_p1)
			(vpcase `(:r4 = ,+join_bevel))
			(vp-label 'do_bevel)
				;bevel join
				(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)))
				(vec-dup 2)
				(vec-load 4 '((:rsp slot_l1_rvx) (:rsp slot_l1_rvy) (:rsp slot_l2_rvx) (:rsp slot_l2_rvy)))
				(vec-add 4)
				(vec-store 4 '((:rsp slot_p3x) (:rsp slot_p3y) (:rsp slot_p1x) (:rsp slot_p1y)))
				(call :path :push_back2 '((:rsp slot_this) (:rsp slot_p3x) (:rsp slot_p3y)))
			(vp-label 'out_p1)
				(call :path :push_back2 '((:rsp slot_this) (:rsp slot_p1x) (:rsp slot_p1y)))
			(else)
				;rounded join
				(call :path :gen_clerp '((:rsp slot_this) (:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_l1_rvx) (:rsp slot_l1_rvy) (:rsp slot_l2_rvx) (:rsp slot_l2_rvy) (:rsp slot_radius)))
			(endswitch)
			(load-fields :rsp '(slot_iter_i slot_iter_j) '(:r0 :r1))
		(loop-until '(:r0 = :r1))
	(endif)

	(exit :path :stroke_joints '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
