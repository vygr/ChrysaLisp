(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :filter_polyline)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = source path object, can be same (ptr)
	;:r2 = tolerance (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	;the frame is this, for the end: the rest is in registers, the source
	;and the tolerance where the clear and the append leave them
	(structure slot 0
		(ptr this))

	(vp-alloc slot_size)
	(entry :path :filter_polyline '(:r0 :r4 :r5))

	;room for all of the source, before any pointer is taken, and what
	;is not filtered below, a point or none, is the source as it is
	(vpif '(:r0 /= :r4))
		(assign '((:r4 +array_length)) '(:r3))
		(d-call :path :clear '(:r0) '(:r0))
		(d-call :path :append '(:r0 :r4 0 :r3) '(:r0))
	(endif)
	(assign '(:r0) '((:rsp slot_this)))

	;the end and the begin of the source, as two on the stack of vectors
	(class/array/get_both :r4 :r1 :r0)
	(vec-set 2)
	(vec-dup 2)
	(vec-dif 2)
	(vpif (list (first (vec-pop 1)) '> (* 2 +long_size)))
		(vec-load 1 '(:r5))
		(vec-fsquare 1)
		(vec-load 1 '((:rsp slot_this)))
		(bind '(e i x j) (vec-top 4))
		(assign `((,j +array_begin)) `(,j))
		(loop-start 'outer_loop)
			(vpif `(,i /= ,j))
				(vec-load-long 2 i)
				(vec-store-long 2 j)
			(endif)
			(loop-start)
				(vp-add-cr (* 2 +long_size) i)
				(breakif `(,i = ,e) 'outer_loop)
				(vec-load-long 2 j)
				(vec-load-long 2 i)
				(vec-fdistance-squared 2)
			(loop-until (list (first (vec-pop 1)) '>= x))
			(vp-add-cr (* 2 +long_size) j)
		(loop-end)
		(assign '((:rsp slot_this)) `(,e))
		(assign `((,e +array_begin)) `(,i))
		(vp-sub-rr i j)
		(vp-shr-cr 3 j)
		(vp-add-cr 2 j)
		(call :path :set_length `(,e ,j))
	(endif)

	(exit :path :filter_polyline '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
