(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")

(def-method :path :filter_polyline)
	;inputs
	;:r0 = path object (ptr)
	;:r1 = source path object, can be same (ptr)
	;:r2 = tolerance (fixed)
	;outputs
	;:r0 = path object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(structure slot 0
		(ptr this that)
		(plong iter_begin iter_end iter_this)
		(int eps)
		(uint length))

	(vp-alloc slot_size)
	(entry :path :filter_polyline '((:rsp slot_this) (:rsp slot_that) (:rsp slot_eps)))

	;room for all of the source, before any pointer is taken, and what
	;is not filtered below, a point or none, is the source as it is
	(vpif '(:r0 /= :r1))
		(d-call :path :get_length '((:rsp slot_that)) '(_ (:rsp slot_length)))
		(d-call :path :clear '((:rsp slot_this)))
		(d-call :path :append '((:rsp slot_this) (:rsp slot_that) 0 (:rsp slot_length)))
	(endif)

	(call :path :get_both '((:rsp slot_that)) '(_ (:rsp slot_iter_begin) (:rsp slot_iter_end)))
	(call :path :get_begin '((:rsp slot_this)) '(_ (:rsp slot_iter_this)))

	(vec-set 0)
	(vec-load 2 '((:rsp slot_iter_end) (:rsp slot_iter_begin)))
	(vec-dup 2)
	(vec-dif 2)
	(vpif (list (first (vec-pop 1)) '> (* 2 +long_size)))
		(vec-load 1 '((:rsp slot_eps)))
		(vec-fsquare 1)
		(vec-load 1 '((:rsp slot_iter_this)))
		(bind '(e i x j) (vec-top 4))
		(loop-start 'outer_loop)
			(vpif `(,i /= ,j))
				(vec-load-long 2 i)
				(vec-store-long 2 j)
			(endif)
			(loop-start)
				(vp-add-cr (* 2 +long_size) i)
				(breakif `(,i = ,e) 'outer_loop)
				(vec-load-long 2 j)
				(vec-load-long 2 i)
				(vec-fdistance-squared 2)
			(loop-until (list (first (vec-pop 1)) '>= x))
			(vp-add-cr (* 2 +long_size) j)
		(loop-end)
		(vec-store 1 '((:rsp slot_iter_end)))
		(load-fields :rsp '(slot_this slot_iter_end slot_iter_this) '(:r0 :r1 :r2))
		(vp-sub-rr :r2 :r1)
		(vp-shr-cr 3 :r1)
		(vp-add-cr 2 :r1)
		(call :path :set_length '(:r0 :r1))
	(endif)

	(exit :path :filter_polyline '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
