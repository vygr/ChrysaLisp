(def-method :path :lisp_stroke_polyline)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(entry :path :lisp_stroke_polyline '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 5)

	(vp-push :r0)
	(defq in (method-input :path :stroke_polyline))
	(list-bind-args :r1 in '(:path :fixed :num :num :num))
	(call :path :stroke_polyline in '(_ :r1))
	(vp-pop :r0)

	(exit :path :lisp_stroke_polyline '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-stroke-polyline path radius join cap1 cap2)" +error_msg_wrong_types))
	(signature '(:PATH :FIXED :NUM :NUM :NUM))

(def-func-end)

(def-method :path :lisp_stroke_polygon)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(entry :path :lisp_stroke_polygon '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(defq in (method-input :path :stroke_polygon))
	(list-bind-args :r1 in '(:path :fixed :num))
	(call :path :stroke_polygon in '(_ :r12 :r13))
	(call :list :create :nil '(:r0))
	(call :list :push_back2 '(:r0 :r12 :r13) '(:r1 _ _ _ _))
	(vp-pop :r0)

	(exit :path :lisp_stroke_polygon '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-stroke-polygon path radius join)" +error_msg_wrong_types))
	(signature '(:PATH :FIXED :NUM))

(def-func-end)

(def-method :path :lisp_svg)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r11-:r14, :d0-:d15

	(structure slot 0
		(ptr commands command_chars num_start_chars num_mid_chars)
		(ptr this args)
		(int c))

	(vp-rdef (d d_start state sstr c) '(:r11 :r12 :r13))

	(entry :path :lisp_svg '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))

	(list-bind-args :r1 `(,d) '(:str))

	(call :list :create :nil '((:rsp slot_commands)))
	(call :str :create_from_buffer '("MLHVCSQTAZmlhvcsqtaz" 20) '((:rsp slot_command_chars)))
	(call :str :create_from_buffer '("-0123456789" 11) '((:rsp slot_num_start_chars)))
	(call :str :create_from_buffer '(".0123456789" 11) '((:rsp slot_num_mid_chars)))

	(bind '(st ch &ignore) (method-input :str :find))
	(vp-xor-rr state state)
	(loop-start)
		(vp-load-rcr-ub d 0 c)
		(breakif `(,c = 0))
		(assign `(,c) '((:rsp slot_c)))
		(vpif `(,state = 0) 'next_char)
		(vp-label 'eat_char)
			(breakif `(,c <= +char_space))
			(breakif `(,c = +char_comma))
			(assign `(,c) `(,ch))
			(assign '((:rsp slot_num_start_chars)) `(,st))
			(d-call :str :find `(,st ,ch 0) '(_ _ idx))
			(vpif `(,idx /= -1))
				;number
				(vp-cpy-rr d d_start)
				(vp-cpy-cr 1 state)
				(break 'next_char)
			(endif)
			(assign `(,c) `(,ch))
			(assign '((:rsp slot_command_chars)) `(,st))
			(d-call :str :find `(,st ,ch 0) '(_ _ idx))
			(gotoif `(,idx = -1) 'error1)
			;command
			(call :str :create_from_buffer '((& :rsp slot_c) 1) '(sstr))
			(bind '(l s) (method-input :list :push_back))
			(assign `(,sstr) `(,s))
			(assign '((:rsp slot_commands)) `(,l))
			(call :list :push_back `(,l ,s))
		(else)
			(assign `(,c) `(,ch))
			(assign '((:rsp slot_num_mid_chars)) `(,st))
			(d-call :str :find `(,st ,ch 0) '(_ _ idx))
			(breakif `(,idx /= -1))
			(vp-xor-rr :r0 :r0)
			(vp-store-rrc-b :r0 d 0)
			(call :sys_str :to_num `(,d_start) '(num dot))
			(vpif `(,dot = 0))
				(vp-shl-cr +fp_shift num)
			(endif)
			(call :fixed :create `(,num) '(num))
			(bind '(l n) (method-input :list :push_back))
			(assign `(,num) `(,n))
			(assign '((:rsp slot_commands)) `(,l))
			(call :list :push_back `(,l ,n))
			(assign '((:rsp slot_c)) `(,c))
			(vp-xor-rr state state)
			(vp-store-rrc-b c d 0)
			(goto 'eat_char)
		(endif)
		(vp-add-cr +byte_size d)
	(loop-end)
	(call :str :create_from_buffer '("x" 1) '(sstr))
	(bind '(l s) (method-input :list :push_back))
	(assign `(,sstr) `(,s))
	(assign '((:rsp slot_commands)) `(,l))
	(call :list :push_back `(,l ,s))

	(call :str :destroy '((:rsp slot_command_chars)))
	(call :str :destroy '((:rsp slot_num_start_chars)))
	(call :str :destroy '((:rsp slot_num_mid_chars)))

	(exit :path :lisp_svg '((:rsp slot_this) (:rsp slot_commands)))
	(vp-free slot_size)
	(vp-ret)


(vp-label 'error1)
	(call :str :destroy '((:rsp slot_commands)))
	(call :str :destroy '((:rsp slot_command_chars)))
	(call :str :destroy '((:rsp slot_num_start_chars)))
	(call :str :destroy '((:rsp slot_num_mid_chars)))
	(load-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(vp-free slot_size)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-svg d)" +error_msg_wrong_types))
	(signature '(:str))

(def-func-end)
