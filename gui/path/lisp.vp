(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "class/lisp/class.inc")
(include "class/fixed/class.inc")
(include "./class.inc")

(def-method :path :lisp_mat3x2_mul)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(vp-rdef (dst iter_begin ma mb this args argc len)
		'(:r0 :r6 :r7 :r8 :r9 :r1 :r11 :r12))

	(entry :path :lisp_mat3x2_mul `(,this ,args))

	(gotoif-lisp-args-sig 'error args 2 3)

	(assign `((,args +array_length) (,args +array_begin)) `(,argc ,iter_begin))
	(array-get-args iter_begin `(,ma ,mb))
	(assign `((,ma +array_length)) `(,len))
	(gotoif `(,len < 6) 'error)
	(assign `((,mb +array_length)) `(,len))
	(gotoif `(,len < 6) 'error)
	(vpif `(,argc = 2))
		(call :fixeds :create :nil `(,dst))
		(call :fixeds :set_cap `(,dst 6) `(,dst) :r2)
		(call :fixeds :set_length `(,dst 6) `(,dst &))
	(else)
		(vp-load-rcr iter_begin (* +ptr_size 2) dst)
		(assign `((,dst +array_length)) `(,len))
		(gotoif `(,len < 6) 'error)
		(call :obj :ref `(,dst) `(,dst))
	(endif)
	(vp-push this)
	(call :path :mat3x2_mul `(,dst ,ma ,mb) `(,dst))
	(vp-pop this)

	(exit :path :lisp_mat3x2_mul `(,this ,dst))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(mat3x2-mul ma mb [out])" +error_msg_wrong_types))
	(signature '(:FIXEDS :FIXEDS :FIXEDS))

(def-func-end)

(def-method :path :lisp_mat3x2_v2_mul)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14

	(entry :path :lisp_mat3x2_v2_mul '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 3)

	(vp-push :r0 :r1)
	(bind '(dst sp m3x2) (method-input :path :mat3x2_v2_mul))
	(list-bind-args :r1 `(,m3x2 ,sp ,dst) '(:fixeds :path :path))
	(assign `((,m3x2 +array_length)) '(:r14))
	(gotoif '(:r14 < 6) 'error1)
	;a src of whole points, and a dst as long
	(assign `((,sp +array_length) (,dst +array_length)) '(:r13 :r14))
	(gotoif '(:r14 < :r13) 'error1)
	(vp-and-cr 1 :r13)
	(gotoif '(:r13 /= 0) 'error1)
	(call :path :mat3x2_v2_mul `(,dst ,sp ,m3x2) '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0 :r2)

	(exit :path :lisp_mat3x2_v2_mul '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(mat3x2-vec2-mul m3x2 src dst)" +error_msg_wrong_types))
	(signature '(:FIXEDS :PATH :PATH))

(def-func-end)

(def-method :path :lisp_simplify)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r10, :d0-:d15

	(entry :path :lisp_simplify '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 3)

	(vp-push :r0 :r1)
	(bind '(dst src tol) (method-input :path :simplify))
	(list-bind-args :r1 `(,tol ,src ,dst) '(:fixed :path :path))
	;a src of whole points
	(assign `((,src +array_length)) '(:r3))
	(vp-and-cr 1 :r3)
	(gotoif '(:r3 /= 0) 'error1)
	(call :path :simplify `(,dst ,src ,tol) '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0 :r2)

	(exit :path :lisp_simplify '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-simplify tol src dst)" +error_msg_wrong_types))
	(signature '(:FIXED :PATH :PATH))

(def-func-end)

(def-method :path :lisp_filter)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(entry :path :lisp_filter '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 3)

	(vp-push :r0 :r1)
	(bind '(dst sp tol) (method-input :path :filter_polyline))
	(list-bind-args :r1 `(,tol ,sp ,dst) '(:fixed :path :path))
	;a src of whole points
	(assign `((,sp +array_length)) '(:r3))
	(vp-and-cr 1 :r3)
	(gotoif '(:r3 /= 0) 'error1)
	(call :path :filter_polyline `(,dst ,sp ,tol) '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0 :r2)

	(exit :path :lisp_filter '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-filter tol src dst)" +error_msg_wrong_types))
	(signature '(:FIXED :PATH :PATH))

(def-func-end)

(def-method :path :lisp_gen_quadratic)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15

	(entry :path :lisp_gen_quadratic '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 7)

	(vp-push :r0)
	(bind '(dst p1x p1y p2x p2y p3x p3y) (method-input :path :gen_quadratic))
	(list-bind-args :r1 `(,p1x ,p1y ,p2x ,p2y ,p3x ,p3y ,dst)
		'(:fixed :fixed :fixed :fixed :fixed :fixed :path))
	(call :path :gen_quadratic `(,dst ,p1x ,p1y ,p2x ,p2y ,p3x ,p3y) '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :path :lisp_gen_quadratic '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-gen-quadratic p1x p1y p2x p2y p3x p3y dst)" +error_msg_wrong_types))
	(signature '(:FIXED :FIXED :FIXED :FIXED :FIXED :FIXED :PATH))

(def-func-end)

(def-method :path :lisp_gen_cubic)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11, :d0-:d15

	(entry :path :lisp_gen_cubic '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 9)

	(vp-push :r0)
	(bind '(dst p1x p1y p2x p2y p3x p3y p4x p4y) (method-input :path :gen_cubic))
	(list-bind-args :r1 `(,p1x ,p1y ,p2x ,p2y ,p3x ,p3y ,p4x ,p4y ,dst)
		'(:fixed :fixed :fixed :fixed :fixed :fixed :fixed :fixed :path))
	(call :path :gen_cubic `(,dst ,p1x ,p1y ,p2x ,p2y ,p3x ,p3y ,p4x ,p4y) '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :path :lisp_gen_cubic '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-gen-cubic p1x p1y p2x p2y p3x p3y p4x p4y dst)" +error_msg_wrong_types))
	(signature '(:FIXED :FIXED :FIXED :FIXED :FIXED :FIXED :FIXED :FIXED :PATH))

(def-func-end)

(def-method :path :lisp_gen_arc)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15

	(entry :path :lisp_gen_arc '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 6)

	(vp-push :r0 :r1)
	(bind '(dst cx cy start end radius) (method-input :path :gen_arc))
	(list-bind-args :r1 `(,cx ,cy ,start ,end ,radius ,dst)
		'(:fixed :fixed :fixed :fixed :fixed :path))
	;a radius not less than 0
	(gotoif `(,radius < 0) 'error1)
	(call :path :gen_arc `(,dst ,cx ,cy ,start ,end ,radius) '(:r0))
	(call :obj :ref '(:r0) '(:r1))
	(vp-pop :r0 :r2)

	(exit :path :lisp_gen_arc '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-gen-arc cx cy start end radius dst)" +error_msg_wrong_types))
	(signature '(:FIXED :FIXED :FIXED :FIXED :FIXED :PATH))

(def-func-end)

(def-method :path :lisp_stroke_polyline)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(entry :path :lisp_stroke_polyline '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 5)

	(vp-push :r0 :r1)
	(defq in (method-input :path :stroke_polyline))
	(list-bind-args :r1 in '(:path :fixed :num :num :num))
	;a path of whole points
	(assign '((:r0 +array_length)) '(:r5))
	(vp-and-cr 1 :r5)
	(gotoif '(:r5 /= 0) 'error1)
	(call :path :stroke_polyline in '(& :r1))
	(vp-pop :r0 :r2)

	(exit :path :lisp_stroke_polyline '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-stroke-polyline path radius join cap1 cap2)" +error_msg_wrong_types))
	(signature '(:PATH :FIXED :NUM :NUM :NUM))

(def-func-end)

(def-method :path :lisp_stroke_polygon)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(entry :path :lisp_stroke_polygon '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 3)

	(vp-push :r0 :r1)
	(defq in (method-input :path :stroke_polygon))
	(list-bind-args :r1 in '(:path :fixed :num))
	;a path of whole points
	(assign '((:r0 +array_length)) '(:r5))
	(vp-and-cr 1 :r5)
	(gotoif '(:r5 /= 0) 'error1)
	(call :path :stroke_polygon in '(& :r12 :r13))
	(call :list :create :nil '(:r0))
	(call :list :push_back2 '(:r0 :r12 :r13) '(:r1 & & & &))
	(vp-pop :r0 :r2)

	(exit :path :lisp_stroke_polygon '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-stroke-polygon path radius join)" +error_msg_wrong_types))
	(signature '(:PATH :FIXED :NUM))

(def-func-end)

(def-method :path :lisp_svg)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	;the commands of an SVG path's d, and its numbers as fixeds, ending in
	;"x", up to its first error, as SVG has it: each command with whole
	;sets of its numbers, a set that is not whole left out, and a command
	;with none. A number is as SVG has it, a sign, digits with a point, an
	;exponent, .5 and 5.5.3 two, made as :to_long makes one; the flags of
	;an arc one character each, as they may be written together
	(structure slot 0
		(ptr this args commands d)
		(long cmd argn n any c))

	(vp-rdef (d c num dot e minus lc))

	(entry :path :lisp_svg '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(list-bind-args :r1 '(:r0) '(:str))
	(assign '(:r0) '((:rsp slot_d)))
	(call :list :create :nil '((:rsp slot_commands)))
	(vp-xor-rr :r0 :r0)
	(save-fields :rsp '(slot_cmd slot_argn slot_n slot_any) '(:r0 :r0 :r0 :r0))

	(loop-start 'scan)
		(assign '((:rsp slot_d)) `(,d))
		(vp-load-rcr-ub d 0 c)
		(breakif `(,c = 0))
		;white space and commas between
		(vpif `(,c <= +char_space))
			(vp-add-cr +byte_size d)
			(assign `(,d) '((:rsp slot_d)))
			(continue 'scan)
		(endif)
		(vpif `(,c = +char_comma))
			(vp-add-cr +byte_size d)
			(assign `(,d) '((:rsp slot_d)))
			(continue 'scan)
		(endif)
		;the flags of an arc, its 4th and 5th, 0 or 1, one character
		(assign '((:rsp slot_cmd) (:rsp slot_argn)) `(,lc ,e))
		(vp-or-cr 0x20 lc)
		(vpif (list lc '= (ascii-code "a")) `(,e >= 3) `(,e <= 4))
			(vp-sub-cr (ascii-code "0") c)
			(breakif `(,c < 0) 'scan)
			(breakif `(,c > 1) 'scan)
			(vp-cpy-rr c num)
			(vp-shl-cr +fp_shift num)
			(vp-add-cr +byte_size d)
			(goto 'number)
		(endif)
		;a command
		(vp-cpy-rr c lc)
		(vp-or-cr 0x20 lc)
		(gotoif (list lc '= (ascii-code "m")) 'command)
		(gotoif (list lc '= (ascii-code "l")) 'command)
		(gotoif (list lc '= (ascii-code "h")) 'command)
		(gotoif (list lc '= (ascii-code "v")) 'command)
		(gotoif (list lc '= (ascii-code "c")) 'command)
		(gotoif (list lc '= (ascii-code "s")) 'command)
		(gotoif (list lc '= (ascii-code "q")) 'command)
		(gotoif (list lc '= (ascii-code "t")) 'command)
		(gotoif (list lc '= (ascii-code "a")) 'command)
		(gotoif (list lc '= (ascii-code "z")) 'command)
		;a number, of a command that takes them, its sign
		(assign '((:rsp slot_n)) `(,e))
		(breakif `(,e = 0) 'scan)
		(vp-cpy-cr 1 minus)
		(vpif (list c '= (ascii-code "-")))
			(vp-cpy-cr -1 minus)
			(vp-add-cr +byte_size d)
		(elseif (list c '= (ascii-code "+")))
			(vp-add-cr +byte_size d)
		(endif)
		;its digits and its point, of which only the first is its, 7
		;digits of the fraction at most, as :to_long has them
		(vp-simd vp-xor-rr `(,num ,dot ,e) `(,num ,dot ,e))
		(loop-start 'digits)
			(vp-load-rcr-ub d 0 c)
			(vpif (list c '= (ascii-code ".")))
				(breakif `(,dot /= 0) 'digits)
				(vp-cpy-cr 1 dot)
			(else)
				(vp-sub-cr (ascii-code "0") c)
				(breakif `(,c < 0) 'digits)
				(breakif `(,c > 9) 'digits)
				(vp-add-cr 1 e)
				(vpif `(,dot < 10000000))
					(vp-simd vp-mul-cr '(10) `(,num ,dot))
					(vp-add-rr c num)
				(endif)
			(endif)
			(vp-add-cr +byte_size d)
		(loop-end)
		;no digits, an error
		(breakif `(,e = 0) 'scan)
		;its exponent, folded into the point
		(vp-load-rcr-ub d 0 c)
		(vp-or-cr 0x20 c)
		(vpif (list c '= (ascii-code "e")))
			(vp-add-cr +byte_size d)
			(vp-load-rcr-ub d 0 c)
			(vp-cpy-cr 1 lc)
			(vpif (list c '= (ascii-code "-")))
				(vp-cpy-cr -1 lc)
				(vp-add-cr +byte_size d)
			(elseif (list c '= (ascii-code "+")))
				(vp-add-cr +byte_size d)
			(endif)
			(vp-load-rcr-ub d 0 c)
			(vp-sub-cr (ascii-code "0") c)
			(breakif `(,c < 0) 'scan)
			(breakif `(,c > 9) 'scan)
			(vp-xor-rr e e)
			(loop-start)
				(vp-load-rcr-ub d 0 c)
				(vp-sub-cr (ascii-code "0") c)
				(breakif `(,c < 0))
				(breakif `(,c > 9))
				(vpif `(,e < 100))
					(vp-mul-cr 10 e)
					(vp-add-rr c e)
				(endif)
				(vp-add-cr +byte_size d)
			(loop-end)
			(vp-mul-rr lc e)
			;more, a point taken off, or a digit put on
			(loop-while `(,e > 0))
				(vpif `(,dot > 1))
					(vp-cpy-cr 10 lc)
					(vp-div-rr-u lc dot)
				(else)
					(vp-mul-cr 10 num)
				(endif)
				(vp-sub-cr 1 e)
			(loop-end)
			;less, a point put on, and past 15 places nothing
			(vpif `(,e < 0))
				(vpif `(,dot = 0))
					(vp-cpy-cr 1 dot)
				(endif)
				(vp-cpy-cr 1000000000000000 lc)
				(loop-while `(,e < 0))
					(vpif `(,dot < ,lc))
						(vp-mul-cr 10 dot)
					(else)
						(vp-xor-rr num num)
					(endif)
					(vp-add-cr 1 e)
				(loop-end)
			(endif)
		(endif)
		;the fixed, as :to_long makes it
		(vp-shl-cr +fp_shift num)
		(vpif `(,dot /= 0))
			(vp-div-rr-u dot num)
		(endif)
		(vp-mul-rr minus num)
	(vp-label 'number)
		(assign `(,d) '((:rsp slot_d)))
		(call :fixed :create `(,num) '(:r1))
		(call :list :push_back '((:rsp slot_commands) :r1))
		;the place of the next in its set, a set whole at its end
		(load-fields :rsp '(slot_argn slot_n) '(:r0 :r1))
		(vp-add-cr 1 :r0)
		(vpif '(:r0 = :r1))
			(vp-xor-rr :r0 :r0)
			(vp-cpy-cr 1 :r1)
			(assign '(:r1) '((:rsp slot_any)))
		(endif)
		(assign '(:r0) '((:rsp slot_argn)))
		(continue 'scan)
	(vp-label 'command)
		;the one before ends here, whole, or it is an error
		(load-fields :rsp '(slot_argn slot_n slot_any) '(:r7 :r8 :r9))
		(breakif '(:r7 /= 0) 'scan)
		(vpif '(:r8 /= 0))
			(breakif '(:r9 = 0) 'scan)
		(endif)
		;the size of the sets of this one
		(vp-cpy-cr 2 num)
		(vpif (list lc '= (ascii-code "h")))
			(vp-cpy-cr 1 num)
		(elseif (list lc '= (ascii-code "v")))
			(vp-cpy-cr 1 num)
		(elseif (list lc '= (ascii-code "c")))
			(vp-cpy-cr 6 num)
		(elseif (list lc '= (ascii-code "s")))
			(vp-cpy-cr 4 num)
		(elseif (list lc '= (ascii-code "q")))
			(vp-cpy-cr 4 num)
		(elseif (list lc '= (ascii-code "a")))
			(vp-cpy-cr 7 num)
		(elseif (list lc '= (ascii-code "z")))
			(vp-xor-rr num num)
		(endif)
		(vp-add-cr +byte_size d)
		(vp-xor-rr lc lc)
		(assign `(,d ,c ,c ,lc ,num ,lc) '((:rsp slot_d) (:rsp slot_c) (:rsp slot_cmd) (:rsp slot_argn) (:rsp slot_n) (:rsp slot_any)))
		(call :str :create_from_buffer '((& :rsp slot_c) 1) '(:r1))
		(call :list :push_back '((:rsp slot_commands) :r1))
	(loop-end)

	;at the end, or an error: a set that is not whole left out, and the
	;command with it if it has none whole
	(load-fields :rsp '(slot_commands slot_argn slot_n slot_any) '(:r0 :r2 :r3 :r4))
	(vpif '(:r3 /= 0) '(:r4 = 0))
		(vp-add-cr 1 :r2)
	(endif)
	(vpif '(:r2 /= 0))
		(assign '((:r0 +array_length)) '(:r1))
		(vp-sub-rr :r2 :r1)
		(call :list :truncate '(:r0 :r1))
	(endif)
	(call :str :create_from_buffer '("x" 1) '(:r1))
	(call :list :push_back '((:rsp slot_commands) :r1))

	(exit :path :lisp_svg '((:rsp slot_this) (:rsp slot_commands)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(path-svg d)" +error_msg_wrong_types))
	(signature '(:str))

(def-func-end)
