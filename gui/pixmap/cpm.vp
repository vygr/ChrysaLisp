(include "lib/asm/func.inc")
(include "class/stream/class.inc")
(include "./class.inc")

(def-method :pixmap :next_frame)
	;inputs
	;:r0 = pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r1-:r8, :r14, :f0-:f15

	(def-vars
		(ptr this)
		(puint data data_end)
		(long col bit_pool)
		(int len)
		(uint bit_pool_size num_bits))

	;save inputs
	(push-scope)
	(entry :pixmap :next_frame (vpx this))

	(vpif (vpx (.> this +pixmap_stream)) 'error)
		;remember what to seek back to !
		(vpifnot (vpx (.> this +pixmap_bufp)))
			(assign (vpx (.> this +pixmap_stream +stream_bufp)) (vpx (.> this +pixmap_bufp)))
		(endif)

		;must be premul
		(call :pixmap :as_premul (vpx this))

		;decode according to type
		(assign (vpx (.> this +pixmap_stream_type)) (vpx num_bits))
		(vpif (vpx (= num_bits 12)))
			(assign (vpx 16) (vpx num_bits))
		(endif)
		(vpif (vpx (= num_bits 15)))
			(assign (vpx 16) (vpx num_bits))
		(endif)
		(assign (vpx (.> this +pixmap_data)) (vpx data))
		(assign (vpx (+ data (* (.> this +pixmap_height) (.> this +pixmap_stride)))) (vpx data_end))
		(assign (vpx 0 0) (vpx bit_pool bit_pool_size))

		(vp-rdef (stream len bit_pool bit_pool_size col data data_end)
			(method-input :stream :read_bits))
		(loop-start)
			;get token, loop back if stream end
			(loop-start)
				(call :stream :read_bits (vpx (.> this +pixmap_stream) 8 bit_pool bit_pool_size)
					`(,stream ,len ,bit_pool ,bit_pool_size))
				(breakif `(,len /= -1))
				(assign (vpx (.> this +pixmap_bufp) 0 0)
					(vpx (.> this +pixmap_stream +stream_bufp) bit_pool bit_pool_size))
			(loop-end)
			(assign `(,bit_pool ,bit_pool_size) (vpx bit_pool bit_pool_size))

			;decode token
			(vpif `(,len >= 128))
				;skip
				(assign (vpx data data_end) `(,data ,data_end))
				(vp-sub-cr 256 len)
				(vp-shl-cr (log2 +int_size) len)
				(vp-sub-rr len data)
			(else)
				;block of pixels
				(loop-start)
					(assign `(,len) (vpx len))
					(call :stream :read_bits (vpx (.> this +pixmap_stream) num_bits bit_pool bit_pool_size)
						(vpx _ col bit_pool bit_pool_size))
					(breakif (vpx (= col (- 1))) 'error)
					(call :pixmap :to_argb32 (vpx col (.> this +pixmap_stream_type)) `(,col))
					(call :pixmap :to_premul `(,col) `(,col))
					(assign (vpx len data data_end) `(,len ,data ,data_end))
					(breakif `(,data >= ,data_end) 'error)
					(vp-cpy-ri-i col data 0)
					(vp-sub-cr 1 len)
					(vp-add-cr +int_size data)
					(assign `(,data) (vpx data))
				(loop-until `(,len = 0))
			(endif)
			(assign `(,data) (vpx data))
		(loop-until `(,data = ,data_end))
	(endif)

	(exit :pixmap :next_frame (vpx this))
	(pop-scope)
	(return)

(def-func-end)
