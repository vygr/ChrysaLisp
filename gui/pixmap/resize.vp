(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :pixmap :resize)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r1-:r13, :f0-:f15

	(def-vars
		(ptr this source)
		(puint data sdata buf)
		(uint x y x2 y2)
		(uint x1a x1b x1c x1d y1a y1b y1c y1d)
		(uint a r g b q weight_x weight_y)
		(long sw256 sh256 dw dh))

	(assign '((:r0 +pixmap_width) (:r0 +pixmap_height) (:r1 +pixmap_width) (:r1 +pixmap_height))
		'(:r2 :r3 :r4 :r5))
	;the same size, a copy
	(vpif '(:r2 = :r4) '(:r3 = :r5))
		(vp-push :r0)
		(assign '((:r1 +pixmap_data) (:r0 +pixmap_data) (:r1 +pixmap_stride)) '(:r6 :r7 :r8))
		(vp-mul-rr :r3 :r8)
		(call :sys_mem :copy '(:r6 :r7 :r8))
		(vp-pop :r0)
		(vp-ret)
	(endif)
	(vp-simd vp-shl-cr '(1) '(:r2 :r3))
	(vpif '(:r2 = :r4) '(:r3 = :r5))
		(jump :pixmap :resize_2 '(:r0 :r1))
	(endif)
	(vp-simd vp-shr-cr '(1) '(:r2 :r3))
	(vp-simd vp-mul-cr '(3) '(:r2 :r3))
	(vpif '(:r2 = :r4) '(:r3 = :r5))
		(jump :pixmap :resize_3 '(:r0 :r1))
	(endif)

	(push-scope)
	(entry :pixmap :resize (vpx this source))

	;where each column starts in the source, in 256ths of a pixel, each
	;worked out from the sizes and not by steps, which drift: with a step of
	;a third of a pixel cut to 256ths, three columns came to a 256th short of
	;the next pixel, and every edge of a 3x was blended
	(call :sys_mem :alloc (vpx (* (+ (.> this +pixmap_width) 1) +int_size)) (vpx buf _))
	(assign (vpx (* (.> source +pixmap_width) 256) (* (.> source +pixmap_height) 256)
		(.> this +pixmap_width) (.> this +pixmap_height)) (vpx sw256 sh256 dw dh))

	(assign (vpx 0) (vpx x2))
	(loop-while (vpx (<= x2 dw)))
		(assign (vpx (/ (* x2 sw256) dw)) (vpx (elem buf (* x2 +int_size))))
		(assign (vpx (+ x2 1)) (vpx x2))
	(loop-end)

	(assign (vpx (.> this +pixmap_data)) (vpx data))
	(assign (vpx 0) (vpx y2))
	(loop-while (vpx (< y2 (.> this +pixmap_height))))
		(assign (vpx (/ (* y2 sh256) dh)) (vpx y1a))
		(assign (vpx (>> y1a 8)) (vpx y1c))
		(assign (vpx (- (/ (* (+ y2 1) sh256) dh) 1)) (vpx y1b))
		(assign (vpx (>> y1b 8)) (vpx y1d))

		(assign (vpx 0) (vpx x2))
		(loop-while (vpx (< x2 (.> this +pixmap_width))))
			(assign (vpx (elem buf (* x2 +int_size))) (vpx x1a))
			(assign (vpx (>> x1a 8)) (vpx x1c))
			(assign (vpx (- (elem buf (* (+ x2 1) +int_size)) 1)) (vpx x1b))
			(assign (vpx (>> x1b 8)) (vpx x1d))

			;all of it in one pixel of the source, as most are made bigger:
			;that pixel, with no weights and no divide
			(vpif (vpx (= x1c x1d)))
				(vpif (vpx (= y1c y1d)))
					(assign (vpx (+ (.> source +pixmap_data) (* (+ (* y1c (.> source +pixmap_width)) x1c) +int_size))) (vpx sdata))
					(assign (vpx (elem sdata 0)) (vpx (elem data 0)))
					(assign (vpx (+ data +int_size)) (vpx data))
					(goto 'next_pixel)
				(endif)
			(endif)

			(assign (vpx (=> (=> (=> (=> 0 a) r) g) b)) (vpx q))

			(assign (vpx y1c) (vpx y))
			(loop-while (vpx (<= y y1d)))
				(vp-rdef (weight_y y1c y1d y y1a y1b))
				(assign (vpx 256 y1c y1d) (list weight_y y1c y1d))
				(vpif `(,y1c /= ,y1d))
					(assign (vpx y y1a y1b) (list y y1a y1b))
					(vpif `(,y = ,y1c))
						(vp-and-cr 0xff y1a)
						(vp-sub-rr y1a weight_y)
					(elseif `(,y = ,y1d))
						(vp-and-cr 0xff y1b)
						(vp-add-cr 1 y1b)
						(vp-cpy-rr y1b weight_y)
					(endif)
				(endif)
				(assign (list weight_y) (vpx weight_y))

				(assign (vpx (+ (.> source +pixmap_data) (* (+ (* y (.> source +pixmap_width)) x1c) +int_size))) (vpx sdata))
				(assign (vpx x1c) (vpx x))
				(loop-while (vpx (<= x x1d)))
					(vp-rdef (weight_x x1c x1d x x1a x1b))
					(assign (vpx 256 x1c x1d) (list weight_x x1c x1d))
					(vpif `(,x1c /= ,x1d))
						(assign (vpx x x1a x1b) (list x x1a x1b))
						(vpif `(,x = ,x1c))
							(vp-and-cr 0xff x1a)
							(vp-sub-rr x1a weight_x)
						(elseif `(,x = ,x1d))
							(vp-and-cr 0xff x1b)
							(vp-add-cr 1 x1b)
							(vp-cpy-rr x1b weight_x)
						(endif)
					(endif)
					(assign (list weight_x) (vpx weight_x))

					;multiply pixel channels by the pixel weight and accumulate
					(vp-rdef (r g b a q sr sg sb sa sdata weight))
					(assign (vpx r g b a q sdata (* weight_x weight_y))
						(list r g b a q sdata weight))
					(vp-cpy-ir-ui sdata 0 sa)
					(vp-add-cr +int_size sdata)

					(vp-simd vp-cpy-rr `(,sa) `(,sr ,sg ,sb))
					(vp-simd vp-shr-cr '(8 16 24) `(,sg ,sb ,sa))
					(vp-simd vp-and-cr '(0xff) `(,sr ,sg ,sb))
					(vp-simd vp-mul-rr `(,weight) `(,sr ,sg ,sb ,sa))
					(vp-simd vp-add-rr `(,sr ,sg ,sb ,sa) `(,r ,g ,b ,a))
					(vp-add-rr weight q)
					(assign (list sdata r g b a q) (vpx sdata r g b a q))

					(assign (vpx (+ x 1)) (vpx x))
				(loop-end)
				(assign (vpx (+ y 1)) (vpx y))
			(loop-end)

			;divide by the pixel weight, to the nearest, and store. The
			;reciprocal is rounded up, and of 2^40, so a solid colour comes
			;out as it went in: rounded down, and of 2^32, white was 254
			(vp-rdef (q h r g b a data))
			(assign (vpx (/ (+ (<< 1 40) (- q 1)) q) (>> q 1) r g b a data) (list q h r g b a data))
			(vp-simd vp-add-rr `(,h) `(,r ,g ,b ,a))
			(vp-simd vp-mul-rr `(,q) `(,r ,g ,b ,a))
			(vp-simd vp-shr-cr '(40) `(,r ,g ,b ,a))
			(vp-simd vp-shl-cr '(8 16 24) `(,g ,b ,a))
			(vp-simd vp-add-rr `(,g ,b ,a) `(,r))
			(vp-cpy-ri-i r data 0)
			(vp-add-cr +int_size data)
			(assign (list data) (vpx data))

		(vp-label 'next_pixel)
			(assign (vpx (+ x2 1)) (vpx x2))
		(loop-end)
		(assign (vpx (+ y2 1)) (vpx y2))
	(loop-end)

	;the table of where each column starts in the source goes
	(call :sys_mem :free (vpx buf))

	(exit :pixmap :resize (vpx this))
	(pop-scope)
	(return)

(def-func-end)

(def-method :pixmap :resize_2)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r2-:r12

	(vp-rdef (this source sdata xdata ydata data rb ga srb sga sw mga mrb))

	(entry :pixmap :resize_2 (list this source))

	(assign `((,this +pixmap_data) (,source +pixmap_data)) `(,data , sdata))
	(assign `((,source +pixmap_stride) (,source +pixmap_height) 0xff00ff00 0xff00ff)
		(list sw ydata mga mrb))

	(vp-mul-rr sw ydata)
	(vp-add-rr sdata ydata)
	(loop-while `(,sdata /= ,ydata))
		(vp-lea-d sdata sw xdata)
		(loop-while `(,sdata /= ,xdata))
			;accumulate pixel channels
			(vp-cpy-ir-ui sdata 0 ga)
			(vp-cpy-rr ga rb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata +int_size sga)
			(vp-add-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata 0 sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata +int_size sga)
			(vp-sub-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			;divide by the pixel weight, to the nearest, and store
			(vp-simd vp-cpy-cr '(0x02000200 0x00020002) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))
			(vp-simd vp-shr-cr '(2) `(,ga ,rb))
			(vp-simd vp-and-rr `(,mga ,mrb) `(,ga ,rb))
			(vp-add-rr ga rb)
			(vp-cpy-ri-i rb data 0)

			(vp-add-cr +int_size data)
			(vp-add-cr (* 2 +int_size) sdata)
		(loop-end)
		(vp-add-rr sw sdata)
	(loop-end)

	(exit :pixmap :resize_2 (list this))
	(vp-ret)

(def-func-end)

(def-method :pixmap :resize_3)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r2-:r13

	(vp-rdef (this source sdata xdata ydata data q rb ga srb sga sw mga mrb))

	(entry :pixmap :resize_3 (list this source))

	(assign `((,this +pixmap_data) (,source +pixmap_data)) `(,data , sdata))
	;a ninth, rounded up, so with half of 9 added the sums round to the
	;nearest and a solid colour comes out as it went in
	(assign `(,(/ (+ (<< 1 32) 8) 9) (,source +pixmap_stride) (,source +pixmap_height) 0xff00ff00 0xff00ff)
		(list q sw ydata mga mrb))

	(vp-mul-rr sw ydata)
	(vp-add-rr sdata ydata)
	(loop-while `(,sdata /= ,ydata))
		(vp-lea-d sdata sw xdata)
		(loop-while `(,sdata /= ,xdata))
			;accumulate pixel channels
			(vp-cpy-ir-ui sdata 0 ga)
			(vp-cpy-rr ga rb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata +int_size sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata (* 2 +int_size) sga)
			(vp-add-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata 0 sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata +int_size sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata (* 2 +int_size) sga)
			(vp-add-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata 0 sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata +int_size sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-cpy-ir-ui sdata (* 2 +int_size) sga)
			(vp-sub-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-sub-rr sw sdata)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			;divide by the pixel weight and store
			(vp-simd vp-cpy-rr `(,ga ,rb) `(,sga ,srb))
			(vp-simd vp-shr-cr '(24 16 8) `(,sga ,srb ,ga))
			(vp-simd vp-and-cr '(0xfff) `(,rb ,ga))
			(vp-simd vp-add-cr '(4) `(,sga ,srb ,ga ,rb))
			(vp-simd vp-mul-rr `(,q) `(,sga ,srb ,ga ,rb))
			(vp-simd vp-shr-cr '(32) `(,sga ,srb ,ga ,rb))
			(vp-simd vp-shl-cr '(8 16 24) `(,ga ,srb ,sga))
			(vp-add-rr ga rb) (vp-add-rr srb rb) (vp-add-rr sga rb)
			(vp-cpy-ri-i rb data 0)

			(vp-add-cr +int_size data)
			(vp-add-cr (* 3 +int_size) sdata)
		(loop-end)
		(vp-add-rr sw sdata) (vp-add-rr sw sdata)
	(loop-end)

	(exit :pixmap :resize_3 (list this))
	(vp-ret)

(def-func-end)

(def-method :pixmap :flip_x)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r2-:r11

	(vp-rdef (this src w_bytes h ddata sdata dstride sstride dst_ptr src_ptr val dend)
		'(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11))

	(entry :pixmap :flip_x `(,this ,src))

	;copy pixmap type
	(assign `((,src +pixmap_type)) `(,val))
	(assign `(,val) `((,this +pixmap_type)))

	;get dimensions and strides
	(assign `((,this +pixmap_width) (,this +pixmap_height) (,this +pixmap_stride))
		`(,w_bytes ,h ,dstride))
	(assign `((,src +pixmap_width) (,src +pixmap_height) (,src +pixmap_stride))
		`(,val ,dend ,sstride))

	;clip width and height to min of both
	(vp-min-rr val w_bytes)
	(vp-min-rr dend h)

	(gotoif `(,w_bytes <= 0) 'done)
	(gotoif `(,h <= 0) 'done)

	(assign `((,this +pixmap_data) (,src +pixmap_data)) `(,ddata ,sdata))

	;sdata points to the rightmost pixel of row 0 in src: sdata + (src_width - 1) * 4
	(assign `((,src +pixmap_width)) `(,val))
	(vp-sub-cr 1 val)
	(vp-shl-cr (log2 +int_size) val)
	(vp-add-rr val sdata)

	(vp-shl-cr (log2 +int_size) w_bytes)

	(loop-start 'y_loop)
		(vp-cpy-rr ddata dst_ptr)
		(vp-cpy-rr sdata src_ptr)
		(vp-lea-d ddata w_bytes dend)

		(loop-start 'x_loop)
			(vp-cpy-ir-ui src_ptr 0 val)
			(vp-sub-cr +int_size src_ptr)
			(vp-cpy-ri-i val dst_ptr 0)
			(vp-add-cr +int_size dst_ptr)
		(loop-until `(,dst_ptr = ,dend))

		(vp-add-rr dstride ddata)
		(vp-add-rr sstride sdata)
		(vp-sub-cr 1 h)
	(loop-until `(,h = 0))

(vp-label 'done)
	(exit :pixmap :flip_x `(,this))
	(vp-ret)

(def-func-end)
