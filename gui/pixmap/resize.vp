(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :pixmap :resize)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(structure slot 0
		(ptr this source)
		(puint data buf)
		(uint x2 y2 y x1a x1b x1c x1d y1a y1b y1c y1d)
		(long sw256 sh256 dw dh))

	(assign '((:r0 +pixmap_width) (:r0 +pixmap_height) (:r1 +pixmap_width) (:r1 +pixmap_height))
		'(:r2 :r3 :r4 :r5))
	;the same size, a copy
	(vpif '(:r2 = :r4) '(:r3 = :r5))
		(vp-push :r0)
		(assign '((:r1 +pixmap_data) (:r0 +pixmap_data) (:r1 +pixmap_stride)) '(:r6 :r7 :r8))
		(vp-mul-rr :r3 :r8)
		(call :sys_mem :copy '(:r6 :r7 :r8))
		(vp-pop :r0)
		(vp-ret)
	(endif)
	(vp-simd vp-shl-cr '(1) '(:r2 :r3))
	(vpif '(:r2 = :r4) '(:r3 = :r5))
		(jump :pixmap :resize_2 '(:r0 :r1))
	(endif)
	(vp-simd vp-shr-cr '(1) '(:r2 :r3))
	(vp-simd vp-mul-cr '(3) '(:r2 :r3))
	(vpif '(:r2 = :r4) '(:r3 = :r5))
		(jump :pixmap :resize_3 '(:r0 :r1))
	(endif)

	(vp-alloc slot_size)
	(entry :pixmap :resize '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_source) '(:r0 :r1))

	;where each column starts in the source, in 256ths of a pixel, each
	;worked out from the sizes and not by steps, which drift: with a step of
	;a third of a pixel cut to 256ths, three columns came to a 256th short of
	;the next pixel, and every edge of a 3x was blended
	(assign '((:r0 +pixmap_width)) '(:r0))
	(vp-add-cr 1 :r0)
	(vp-shl-cr (log2 +int_size) :r0)
	(call :sys_mem :alloc '(:r0) '(:r0 _))
	(load-fields :rsp '(slot_this slot_source) '(:r1 :r2))
	(assign '((:r2 +pixmap_width) (:r2 +pixmap_height) (:r1 +pixmap_width) (:r1 +pixmap_height))
		'(:r3 :r4 :r5 :r6))
	(vp-simd vp-shl-cr '(8) '(:r3 :r4))
	(save-fields :rsp '(slot_buf slot_sw256 slot_sh256 slot_dw slot_dh) '(:r0 :r3 :r4 :r5 :r6))
	(vp-xor-rr :r7 :r7)
	(loop-start)
		(vp-cpy-rr :r7 :r8)
		(vp-mul-rr :r3 :r8)
		(vp-div-rr-u :r5 :r8)
		(vp-store-rrc-i :r8 :r0 0)
		(vp-add-cr +int_size :r0)
		(vp-add-cr 1 :r7)
	(loop-until '(:r7 > :r5))

	(assign '((:r1 +pixmap_data)) '(:r1))
	(vp-xor-rr :r2 :r2)
	(save-fields :rsp '(slot_data slot_y2) '(:r1 :r2))
	(loop-start)
		;the rows of the source this row takes, in 256ths, y1a to y1b, and
		;the pixels, y1c to y1d
		(load-fields :rsp '(slot_this slot_y2 slot_sh256 slot_dh) '(:r0 :r1 :r2 :r3))
		(assign '((:r0 +pixmap_height)) '(:r4))
		(breakif '(:r1 >= :r4))
		(vp-lea-rcr :r1 1 :r4)
		(vp-mul-rr :r2 :r1)
		(vp-mul-rr :r2 :r4)
		(vp-div-rr-u :r3 :r1)
		(vp-div-rr-u :r3 :r4)
		(vp-sub-cr 1 :r4)
		(assign '(:r1 :r4) '(:r5 :r6))
		(vp-simd vp-shr-cr '(8) '(:r5 :r6))
		(vp-xor-rr :r0 :r0)
		(save-fields :rsp '(slot_x2 slot_y1a slot_y1b slot_y1c slot_y1d) '(:r0 :r1 :r4 :r5 :r6))

		(loop-start)
			;the columns of the source this pixel takes, x1a to x1b, and
			;the pixels, x1c to x1d
			(load-fields :rsp '(slot_this slot_x2 slot_buf) '(:r0 :r1 :r2))
			(assign '((:r0 +pixmap_width)) '(:r3))
			(breakif '(:r1 >= :r3))
			(vp-shl-cr (log2 +int_size) :r1)
			(vp-add-rr :r1 :r2)
			(vp-load-rcr-ui :r2 0 :r4)
			(vp-load-rcr-ui :r2 +int_size :r5)
			(vp-sub-cr 1 :r5)
			(assign '(:r4 :r5) '(:r6 :r7))
			(vp-simd vp-shr-cr '(8) '(:r6 :r7))
			(save-fields :rsp '(slot_x1a slot_x1b slot_x1c slot_x1d) '(:r4 :r5 :r6 :r7))

			(load-fields :rsp '(slot_y1c slot_y1d) '(:r8 :r9))
			(vpif '(:r6 = :r7) '(:r8 = :r9))
				;all of it in one pixel of the source, as most are made bigger:
				;that pixel, with no weights and no divide
				(load-fields :rsp '(slot_source slot_data) '(:r1 :r2))
				(assign '((:r1 +pixmap_width) (:r1 +pixmap_data)) '(:r3 :r1))
				(vp-mul-rr :r8 :r3)
				(vp-add-rr :r6 :r3)
				(vp-shl-cr (log2 +int_size) :r3)
				(vp-load-rrr-ui :r1 :r3 :r4)
				(vp-store-rrc-i :r4 :r2 0)
				(vp-add-cr +int_size :r2)
				(assign '(:r2) '((:rsp slot_data)))
			(else)
				;r g b a and q, the sums, :r0 to :r4
				(vp-xor-rr :r0 :r0)
				(vp-xor-rr :r1 :r1)
				(vp-xor-rr :r2 :r2)
				(vp-xor-rr :r3 :r3)
				(vp-xor-rr :r4 :r4)
				(assign '(:r8) '((:rsp slot_y)))
				(loop-start)
					;y :r6, the weight of this row :r8
					(load-fields :rsp '(slot_y slot_y1a slot_y1b slot_y1c slot_y1d) '(:r6 :r10 :r11 :r7 :r9))
					(breakif '(:r6 > :r9))
					(vp-cpy-cr 256 :r8)
					(vpif '(:r7 /= :r9))
						(vpif '(:r6 = :r7))
							(vp-and-cr 0xff :r10)
							(vp-sub-rr :r10 :r8)
						(elseif '(:r6 = :r9))
							(vp-and-cr 0xff :r11)
							(vp-lea-rcr :r11 1 :r8)
						(endif)
					(endif)

					;sdata :r5, x :r6, x1d :r7
					(load-fields :rsp '(slot_source slot_x1c slot_x1d) '(:r10 :r11 :r7))
					(load-fields :r10 '(+pixmap_width +pixmap_data) '(:r12 :r5))
					(vp-mul-rr :r6 :r12)
					(vp-add-rr :r11 :r12)
					(vp-shl-cr (log2 +int_size) :r12)
					(vp-add-rr :r12 :r5)
					(vp-cpy-rr :r11 :r6)
					(loop-while '(:r6 <= :r7))
						;the weight of this pixel :r9
						(vp-cpy-cr 256 :r9)
						(load-fields :rsp '(slot_x1a slot_x1b slot_x1c) '(:r11 :r12 :r10))
						(vpif '(:r10 /= :r7))
							(vpif '(:r6 = :r10))
								(vp-and-cr 0xff :r11)
								(vp-sub-rr :r11 :r9)
							(elseif '(:r6 = :r7))
								(vp-and-cr 0xff :r12)
								(vp-lea-rcr :r12 1 :r9)
							(endif)
						(endif)
						(vp-mul-rr :r8 :r9)

						;multiply pixel channels by the pixel weight and accumulate
						(vp-load-rcr-ui :r5 0 :r13)
						(vp-add-cr +int_size :r5)
						(vp-simd vp-cpy-rr '(:r13) '(:r10 :r11 :r12))
						(vp-simd vp-shr-cr '(8 16 24) '(:r11 :r12 :r13))
						(vp-simd vp-and-cr '(0xff) '(:r10 :r11 :r12))
						(vp-simd vp-mul-rr '(:r9) '(:r10 :r11 :r12 :r13))
						(vp-simd vp-add-rr '(:r10 :r11 :r12 :r13) '(:r0 :r1 :r2 :r3))
						(vp-add-rr :r9 :r4)
						(vp-add-cr 1 :r6)
					(loop-end)
					(assign '((:rsp slot_y)) '(:r6))
					(vp-add-cr 1 :r6)
					(assign '(:r6) '((:rsp slot_y)))
				(loop-end)

				;divide by the pixel weight, to the nearest, and store. The
				;reciprocal is rounded up, and of 2^40, so a solid colour comes
				;out as it went in: rounded down, and of 2^32, white was 254
				(assign `(,(<< 1 40)) '(:r5))
				(vp-add-rr :r4 :r5)
				(vp-sub-cr 1 :r5)
				(vp-div-rr-u :r4 :r5)
				(vp-shr-cr 1 :r4)
				(vp-simd vp-add-rr '(:r4) '(:r0 :r1 :r2 :r3))
				(vp-simd vp-mul-rr '(:r5) '(:r0 :r1 :r2 :r3))
				(vp-simd vp-shr-cr '(40) '(:r0 :r1 :r2 :r3))
				(vp-simd vp-shl-cr '(8 16 24) '(:r1 :r2 :r3))
				(vp-simd vp-add-rr '(:r1 :r2 :r3) '(:r0))
				(assign '((:rsp slot_data)) '(:r1))
				(vp-store-rrc-i :r0 :r1 0)
				(vp-add-cr +int_size :r1)
				(assign '(:r1) '((:rsp slot_data)))
			(endif)
			(assign '((:rsp slot_x2)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:rsp slot_x2)))
		(loop-end)
		(assign '((:rsp slot_y2)) '(:r0))
		(vp-add-cr 1 :r0)
		(assign '(:r0) '((:rsp slot_y2)))
	(loop-end)

	;the table of where each column starts in the source goes
	(call :sys_mem :free '((:rsp slot_buf)))

	(exit :pixmap :resize '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :pixmap :resize_2)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r2-:r12

	(vp-rdef (this source sdata xdata ydata data rb ga srb sga sw mga mrb))

	(entry :pixmap :resize_2 (list this source))

	(assign `((,this +pixmap_data) (,source +pixmap_data)) `(,data , sdata))
	(assign `((,source +pixmap_stride) (,source +pixmap_height) 0xff00ff00 0xff00ff)
		(list sw ydata mga mrb))

	(vp-mul-rr sw ydata)
	(vp-add-rr sdata ydata)
	(loop-while `(,sdata /= ,ydata))
		(vp-lea-rrr sdata sw xdata)
		(loop-while `(,sdata /= ,xdata))
			;accumulate pixel channels
			(vp-load-rcr-ui sdata 0 ga)
			(vp-cpy-rr ga rb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,ga ,rb))

			(vp-load-rcr-ui sdata +int_size sga)
			(vp-add-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata 0 sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata +int_size sga)
			(vp-sub-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			;divide by the pixel weight, to the nearest, and store
			(vp-simd vp-cpy-cr '(0x02000200 0x00020002) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))
			(vp-simd vp-shr-cr '(2) `(,ga ,rb))
			(vp-simd vp-and-rr `(,mga ,mrb) `(,ga ,rb))
			(vp-add-rr ga rb)
			(vp-store-rrc-i rb data 0)

			(vp-add-cr +int_size data)
			(vp-add-cr (* 2 +int_size) sdata)
		(loop-end)
		(vp-add-rr sw sdata)
	(loop-end)

	(exit :pixmap :resize_2 (list this))
	(vp-ret)

(def-func-end)

(def-method :pixmap :resize_3)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r2-:r13

	(vp-rdef (this source sdata xdata ydata data q rb ga srb sga sw mga mrb))

	(entry :pixmap :resize_3 (list this source))

	(assign `((,this +pixmap_data) (,source +pixmap_data)) `(,data , sdata))
	;a ninth, rounded up, so with half of 9 added the sums round to the
	;nearest and a solid colour comes out as it went in
	(assign `(,(/ (+ (<< 1 32) 8) 9) (,source +pixmap_stride) (,source +pixmap_height) 0xff00ff00 0xff00ff)
		(list q sw ydata mga mrb))

	(vp-mul-rr sw ydata)
	(vp-add-rr sdata ydata)
	(loop-while `(,sdata /= ,ydata))
		(vp-lea-rrr sdata sw xdata)
		(loop-while `(,sdata /= ,xdata))
			;accumulate pixel channels
			(vp-load-rcr-ui sdata 0 ga)
			(vp-cpy-rr ga rb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,ga ,rb))

			(vp-load-rcr-ui sdata +int_size sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata (* 2 +int_size) sga)
			(vp-add-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata 0 sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata +int_size sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata (* 2 +int_size) sga)
			(vp-add-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata 0 sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata +int_size sga)
			(vp-cpy-rr sga srb)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			(vp-load-rcr-ui sdata (* 2 +int_size) sga)
			(vp-sub-rr sw sdata)
			(vp-cpy-rr sga srb)
			(vp-sub-rr sw sdata)
			(vp-simd vp-and-rr `(,mga ,mrb) `(,sga ,srb))
			(vp-simd vp-add-rr `(,sga ,srb) `(,ga ,rb))

			;divide by the pixel weight and store
			(vp-simd vp-cpy-rr `(,ga ,rb) `(,sga ,srb))
			(vp-simd vp-shr-cr '(24 16 8) `(,sga ,srb ,ga))
			(vp-simd vp-and-cr '(0xfff) `(,rb ,ga))
			(vp-simd vp-add-cr '(4) `(,sga ,srb ,ga ,rb))
			(vp-simd vp-mul-rr `(,q) `(,sga ,srb ,ga ,rb))
			(vp-simd vp-shr-cr '(32) `(,sga ,srb ,ga ,rb))
			(vp-simd vp-shl-cr '(8 16 24) `(,ga ,srb ,sga))
			(vp-add-rr ga rb) (vp-add-rr srb rb) (vp-add-rr sga rb)
			(vp-store-rrc-i rb data 0)

			(vp-add-cr +int_size data)
			(vp-add-cr (* 3 +int_size) sdata)
		(loop-end)
		(vp-add-rr sw sdata) (vp-add-rr sw sdata)
	(loop-end)

	(exit :pixmap :resize_3 (list this))
	(vp-ret)

(def-func-end)

(def-method :pixmap :flip_x)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = source pixmap object (ptr)
	;outputs
	;:r0 = pixmap object (ptr)
	;trashes
	;:r2-:r11

	(vp-rdef (this src w_bytes h ddata sdata dstride sstride dst_ptr src_ptr val dend)
		'(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11))

	(entry :pixmap :flip_x `(,this ,src))

	;copy pixmap type
	(assign `((,src +pixmap_type)) `(,val))
	(assign `(,val) `((,this +pixmap_type)))

	;get dimensions and strides
	(assign `((,this +pixmap_width) (,this +pixmap_height) (,this +pixmap_stride))
		`(,w_bytes ,h ,dstride))
	(assign `((,src +pixmap_width) (,src +pixmap_height) (,src +pixmap_stride))
		`(,val ,dend ,sstride))

	;clip width and height to min of both
	(vp-min-rr val w_bytes)
	(vp-min-rr dend h)

	(gotoif `(,w_bytes <= 0) 'done)
	(gotoif `(,h <= 0) 'done)

	(assign `((,this +pixmap_data) (,src +pixmap_data)) `(,ddata ,sdata))

	;sdata points to the rightmost pixel of row 0 in src: sdata + (src_width - 1) * 4
	(assign `((,src +pixmap_width)) `(,val))
	(vp-sub-cr 1 val)
	(vp-shl-cr (log2 +int_size) val)
	(vp-add-rr val sdata)

	(vp-shl-cr (log2 +int_size) w_bytes)

	(loop-start 'y_loop)
		(vp-cpy-rr ddata dst_ptr)
		(vp-cpy-rr sdata src_ptr)
		(vp-lea-rrr ddata w_bytes dend)

		(loop-start 'x_loop)
			(vp-load-rcr-ui src_ptr 0 val)
			(vp-sub-cr +int_size src_ptr)
			(vp-store-rrc-i val dst_ptr 0)
			(vp-add-cr +int_size dst_ptr)
		(loop-until `(,dst_ptr = ,dend))

		(vp-add-rr dstride ddata)
		(vp-add-rr sstride sdata)
		(vp-sub-cr 1 h)
	(loop-until `(,h = 0))

(vp-label 'done)
	(exit :pixmap :flip_x `(,this))
	(vp-ret)

(def-func-end)
