(include "lib/asm/func.inc")
(include "class/stream/class.inc")
(include "./class.inc")

(def-method :pixmap :flm_delta)
	;inputs
	;:r0 = pixmap object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = pixel type of the stream (uint)
	;outputs
	;:r0 = pixmap object (ptr)
	;:r1 = 1 if the frame was whole, 0 if the stream ended first (uint)
	;trashes
	;:r1-:r13, :d0-:d15
	;info
	;a frame of a film made from the frame before: runs, each a byte, of
	;pixels to keep, 256 less the count, or of pixels to draw, the count
	;and then the pixels, till every pixel of the pixmap is covered.
	;lib/media/flm.inc has the packets of a film

	;the stream stays in :r0, the reads of bits give it back and the pixel
	;calls leave it. The place, the end, the count of a run and the pool
	;of bits are in registers all of them leave. The frame is this, for
	;the end, and what a pixel is, which each read and convert is given
	(structure slot 0
		(ptr this)
		(uint num_bits type))

	(vp-rdef (stream len) (method-input :stream :read_bits))
	(vp-rdef (data data_end count pool pool_size) '(:r9 :r10 :r11 :r12 :r13))
	(defq col len)

	(vp-alloc slot_size)
	(entry :pixmap :flm_delta '(:r0 :r8 :r2))
	(save-fields :rsp '(slot_this slot_type) '(:r0 :r2))

	;must be premul
	(call :pixmap :as_premul '(:r0) '(:r0))

	;the bits of a pixel, 12 and 15 are read as 16
	(assign '((:rsp slot_type)) '(:r1))
	(vpif '(:r1 = 12))
		(assign '(16) '(:r1))
	(elseif '(:r1 = 15))
		(assign '(16) '(:r1))
	(endif)
	(assign '(:r1) '((:rsp slot_num_bits)))
	(load-fields :r0 '(+pixmap_data +pixmap_height +pixmap_stride) `(,data :r3 :r4))
	(vp-mul-rr :r4 :r3)
	(vp-lea-rrr data :r3 data_end)
	(vp-cpy-rr :r8 stream)
	(vp-xor-rr pool pool)
	(vp-xor-rr pool_size pool_size)

	(loop-start)
		;the next run, the frame is short if the stream ends first
		(call :stream :read_bits `(,stream 8 ,pool ,pool_size) `(,stream ,len ,pool ,pool_size))
		(gotoif `(,len = -1) 'short)

		(vpif `(,len >= 128))
			;pixels kept
			(vp-sub-cr 256 len)
			(vp-shl-cr (log2 +int_size) len)
			(vp-sub-rr len data)
		(else)
			;pixels drawn
			(vp-cpy-rr len count)
			(loop-start)
				(call :stream :read_bits `(,stream (:rsp slot_num_bits) ,pool ,pool_size)
					`(,stream ,col ,pool ,pool_size))
				(gotoif `(,col = -1) 'short)
				(call :pixmap :to_argb32 `(,col (:rsp slot_type)) `(,col))
				(call :pixmap :to_premul `(,col) `(,col))
				(gotoif `(,data >= ,data_end) 'short)
				(vp-store-rrc-i col data 0)
				(vp-sub-cr 1 count)
				(vp-add-cr +int_size data)
			(loop-until `(,count = 0))
		(endif)
	(loop-until `(,data >= ,data_end))

	(exit :pixmap :flm_delta '((:rsp slot_this) 1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'short)
	(exit :pixmap :flm_delta '((:rsp slot_this) 0))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
