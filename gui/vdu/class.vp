(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././region/class.inc")
(include "././pixmap/class.inc")
(include "././ctx/class.inc")

(gen-create :vdu)
	;outputs
	;:r0 = 0 if error, else vdu object (ptr)
	;trashes
	;:r0-:r5, :d0-:d15
(gen-vtable :vdu)

(def-method :vdu :init)
	;inputs
	;:r0 = vdu object (ptr)
	;:r1 = vtable (pptr)
	;outputs
	;:r0 = vdu object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d15

	;init parent
	(s-call :vdu :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		;init myself
		(vp-xor-rr :r2 :r2)
		(assign '(:r2 :r2 :r2 :r2 :r2)
			'((:r0 +vdu_font) (:r0 +vdu_textures) (:r0 +vdu_chars) (:r0 +vdu_width) (:r0 +vdu_height)))
		;it draws only the lines that are dirty, so keeps no list of draws
		(assign '((:r0 +view_flags)) '(:r2))
		(vp-or-cr +view_flag_nocache :r2)
		(assign '(:r2) '((:r0 +view_flags)))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :vdu :deinit)
	;inputs
	;:r0 = vdu object (ptr)
	;outputs
	;:r0 = vdu object (ptr)
	;trashes
	;:r1-:r4, :d0-:d15

	;save object
	(vp-push :r0)

	(call :sys_mem :free '((:r0 +vdu_chars)))
	(assign '((:rsp 0)) '(:r0))
	(call :list :deref_if '((:r0 +vdu_textures)))

	;deinit parent
	(vp-pop :r0)
	(s-jump :vdu :deinit '(:r0))

(def-func-end)

(def-method :vdu :draw)
	;inputs
	;:r0 = view object (ptr)
	;outputs
	;:r0 = view object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	;this and the column are in registers no call of the loops trashes,
	;the char in one all but the blit leave, and its ink where the calls
	;between its making and the blit leave it. The frame is this for the
	;end, the box of chars and the ink of the vdu
	(structure slot 0
		(ptr this)
		(int bx bx1 by by1)
		(uint col))

	(vp-rdef (this x c ink) '(:r13 :r14 :r12 :r5))

	(vp-alloc slot_size)
	(entry :vdu :draw '(:r0))
	(assign '(:r0) '((:rsp slot_this)))

	;get properties
	(call :vdu :get_long_prop `(:r0 ,static_sym_ink) '(:r0 (:rsp slot_col)))
	(call :vdu :get_prop `(:r0 ,static_sym_font) '(:r0 :r1))

	;draw vdu chars
	(load-fields :r0 '(+vdu_chars +vdu_textures) '(:r2 :r3))
	(vpif '(:r1 /= 0) '(:r2 /= 0) '(:r3 /= 0))
		;the dirty region in chars, to the last of each way
		(call :region :bounds '((& :r0 +view_dirty_region)) '(:r7 :r8 :r9 :r10))
		(load-fields :r0 '(+view_ctx_x +view_ctx_y +vdu_char_width +vdu_char_height) '(:r1 :r2 :r3 :r4))
		(vp-sub-rr :r1 :r7)
		(vp-sub-rr :r1 :r9)
		(vp-sub-cr 1 :r9)
		(vp-sub-rr :r2 :r8)
		(vp-sub-rr :r2 :r10)
		(vp-sub-cr 1 :r10)
		(vp-div-rr-u :r3 :r7)
		(vp-div-rr-u :r3 :r9)
		(vp-div-rr-u :r4 :r8)
		(vp-div-rr-u :r4 :r10)
		(load-fields :r0 '(+vdu_width +vdu_height) '(:r1 :r2))
		(vp-sub-cr 1 :r1)
		(vp-sub-cr 1 :r2)
		(vp-min-rr :r1 :r9)
		(vp-min-rr :r2 :r10)
		(save-fields :rsp '(slot_bx slot_by slot_bx1 slot_by1) '(:r7 :r8 :r9 :r10))
		(vp-cpy-rr :r0 this)
		(vpif '(:r8 <= :r10))
			(loop-start)
				(load-fields :rsp '(slot_bx slot_bx1) `(,x :r2))
				(vpif `(,x <= :r2))
					(loop-start)
						(assign '((:rsp slot_by)) '(:r2))
						(load-fields this '(+vdu_chars +vdu_width) '(:r3 :r4))
						(vp-mul-rr :r4 :r2)
						(vp-add-rr x :r2)
						(vp-shl-cr (log2 +long_size) :r2)
						(vp-load-rrr :r3 :r2 c)
						;attributes
						(vp-cpy-rr c :r1)
						(vp-shr-cr 32 :r1)
						(vpif '(:r1 /= 0))
							;has attributes, the ink and the paper made in
							;registers the convert leaves
							(vp-cpy-rr :r1 :r11)
							(vp-shr-cr 16 :r1)
							(call :pixmap :to_argb32 '(:r1 15) '(:r10))
							(call :pixmap :to_argb32 '(:r11 15) '(:r1))
							(vp-cpy-rr :r10 :r2)
						(else)
							;default attributes
							(assign '((:rsp slot_col)) '(:r1))
							(vp-xor-rr :r2 :r2)
						(endif)
						(vp-cpy-rr c ink)
						(vp-shr-cr 31 ink)
						(vp-and-cr 1 ink)
						(vpif `(,ink /= 0))
							;inverse video char
							(vp-swp-rr :r1 :r2)
						(endif)
						(vp-cpy-rr :r1 ink)
						(vpif '(:r2 /= 0))
							;do we have any paper to draw ?
							(call :ctx :set_color `(,this :r2))
							(assign '((:rsp slot_by)) '(:r8))
							(load-fields this '(+vdu_char_width +vdu_char_height) '(:r9 :r10))
							(vp-cpy-rr x :r7)
							(vp-mul-rr :r9 :r7)
							(vp-mul-rr :r10 :r8)
							(call :ctx :filled_box `(,this :r7 :r8 :r9 :r10))
						(endif)
						;char texture
						(vp-and-cr 0x7fffffff c)
						(vpif `(,c /= +char_lf) `(,c /= +char_space))
							(gotoif `(,c < +char_space) 'cntl_char)
							(vpif `(,c > 0x7e))
							(vp-label 'cntl_char)
								(assign '(+char_dot) `(,c))
							(endif)
							(vp-sub-cr 33 c)
							(assign `((,this +vdu_textures)) '(:r0))
							(call :list :get_elem `(:r0 ,c) '(_ :r0))
							(call :texture :get_metrics '(:r0) '(:r0 :r1 :r2 :r3))
							(vpif '(:r1 /= 0))
								;blit the char texture, in the middle of its cell
								(assign '((:rsp slot_by)) '(:r8))
								(load-fields this '(+vdu_char_width +vdu_char_height) '(:r9 :r10))
								(vp-cpy-rr x :r7)
								(vp-mul-rr :r9 :r7)
								(vp-mul-rr :r10 :r8)
								(vp-sub-rr :r2 :r9)
								(vp-asr-cr 1 :r9)
								(vp-add-rr :r9 :r7)
								(call :ctx :blit `(,this :r0 ,ink :r7 :r8 :r2 :r3 0 0))
							(endif)
						(endif)
						(assign '((:rsp slot_bx1)) '(:r2))
						(vp-add-cr 1 x)
					(loop-until `(,x > :r2))
				(endif)
				(load-fields :rsp '(slot_by slot_by1) '(:r1 :r2))
				(vp-add-cr 1 :r1)
				(assign '(:r1) '((:rsp slot_by)))
			(loop-until '(:r1 > :r2))
		(endif)
	(endif)

	(exit :vdu :draw '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
