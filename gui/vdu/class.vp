(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././texture/class.inc")
(include "././region/class.inc")
(include "././pixmap/class.inc")
(include "././ctx/class.inc")

(gen-create :vdu)
	;outputs
	;:r0 = 0 if error, else vdu object (ptr)
	;trashes
	;:r0-:r5, :f0-:f15
(gen-vtable :vdu)

(def-method :vdu :init)
	;inputs
	;:r0 = vdu object (ptr)
	;:r1 = vtable (pptr)
	;outputs
	;:r0 = vdu object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :f0-:f15

	;init parent
	(s-call :vdu :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		;init myself
		(vp-xor-rr :r2 :r2)
		(assign '(:r2 :r2 :r2 :r2 :r2)
			'((:r0 +vdu_font) (:r0 +vdu_chars) (:r0 +vdu_width) (:r0 +vdu_height) (:r0 +vdu_textures)))
		;it draws only the lines that are dirty, so keeps no list of draws
		(assign '((:r0 +view_flags)) '(:r2))
		(vp-or-cr +view_flag_nocache :r2)
		(assign '(:r2) '((:r0 +view_flags)))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :vdu :deinit)
	;inputs
	;:r0 = vdu object (ptr)
	;outputs
	;:r0 = vdu object (ptr)
	;trashes
	;:r1-:r4, :f0-:f15

	;save object
	(vp-push :r0)

	(call :sys_mem :free '((:r0 +vdu_chars)))
	(assign '((:rsp 0)) '(:r0))
	(call :list :deref_if '((:r0 +vdu_textures)))

	;deinit parent
	(vp-pop :r0)
	(s-jump :vdu :deinit '(:r0))

(def-func-end)

(def-method :vdu :draw)
	;inputs
	;:r0 = view object (ptr)
	;outputs
	;:r0 = view object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this font tex)
		(long handle c)
		(int x bx by bx1 by1)
		(uint w h col paper ink))

	;save inputs
	(push-scope)
	(entry :vdu :draw (vpx this))

	;get properties, do checks for any changes
	(call :vdu :get_long_prop (vpx this static_sym_ink) (vpx _ col))
	(call :vdu :get_long_prop (vpx this static_sym_vdu_width) (vpx _ w))
	(call :vdu :get_long_prop (vpx this static_sym_vdu_height) (vpx _ h))
	(call :vdu :get_prop (vpx this static_sym_font) (vpx _ font))

	;draw vdu chars
	(vpif (vpx (&& font (.> this +vdu_chars) (.> this +vdu_textures))))
		(call :region :bounds (vpx (& (.> this +view_dirty_region))) (vpx bx by bx1 by1))
		(assign (vpx (/ (- bx (.> this +view_ctx_x)) (.> this +vdu_char_width))) (vpx bx))
		(assign (vpx (/ (- bx1 (.> this +view_ctx_x) 1) (.> this +vdu_char_width))) (vpx bx1))
		(assign (vpx (/ (- by (.> this +view_ctx_y)) (.> this +vdu_char_height))) (vpx by))
		(assign (vpx (/ (- by1 (.> this +view_ctx_y) 1) (.> this +vdu_char_height))) (vpx by1))
		(vpif (vpx (>= bx1 (.> this +vdu_width))))
			(assign (vpx (- (.> this +vdu_width) 1)) (vpx bx1))
		(endif)
		(vpif (vpx (>= by1 (.> this +vdu_height))))
			(assign (vpx (- (.> this +vdu_height) 1)) (vpx by1))
		(endif)
		(loop-while (vpx (<= by by1)))
			(assign (vpx bx) (vpx x))
			(loop-while (vpx (<= x bx1)))
				(assign (vpx (elem (.> this +vdu_chars) (* (+ (* by (.> this +vdu_width)) x) +long_size))) (vpx c))
				;attributes
				(vpif (vpx (=> (>> c 32) ink)))
					;has attributes
					(call :pixmap :to_argb32 (vpx (>> ink 16) 15) (vpx paper))
					(call :pixmap :to_argb32 (vpx ink 15) (vpx ink))
				(else)
					;default attributes
					(assign (vpx col 0) (vpx ink paper))
				(endif)
				(vpif (vpx (& (>> c 31) 1)))
					;inverse video char
					(assign (vpx ink paper) (vpx w h))
					(assign (vpx w h) (vpx paper ink))
				(endif)
				(vpif (vpx paper))
					;do we have any paper to draw ?
					(call :ctx :set_color (vpx this paper))
					(call :ctx :filled_box (vpx this (* x (.> this +vdu_char_width)) (* by (.> this +vdu_char_height)) (.> this +vdu_char_width) (.> this +vdu_char_height)))
				(endif)
				;char texture
				(vp-rdef (txt c))
				(assign (vpx c) `(,c))
				(vp-and-cr 0x7fffffff c)
				(vpif `(,c /= +char_lf) `(,c /= +char_space))
					(gotoif `(,c < +char_space) 'cntl_char)
					(vpif `(,c > 0x7e))
					(vp-label 'cntl_char)
						(assign '(+char_dot) `(,c))
					(endif)
					(vp-sub-cr 33 c)
					(assign (vpx (.> this +vdu_textures)) `(,txt))
					(call :list :get_elem `(,txt ,c) `(_ ,txt))
					(call :texture :get_metrics `(,txt) (vpx tex handle w h))
					(vpif (vpx handle))
						;blit the char texture
						(call :ctx :blit (vpx this tex ink (+ (* x (.> this +vdu_char_width)) (>>> (- (.> this +vdu_char_width) w) 1)) (* by (.> this +vdu_char_height)) w h 0 0))
					(endif)
				(endif)
				(assign (vpx (+ x 1)) (vpx x))
			(loop-end)
			(assign (vpx (+ by 1)) (vpx by))
		(loop-end)
	(endif)

	(exit :vdu :draw (vpx this))
	(pop-scope)
	(return)

(def-func-end)
