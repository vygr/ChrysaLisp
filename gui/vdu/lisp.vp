(include "lib/asm/func.inc")
(include "class/nums/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "./class.inc")
(include "././pixmap/class.inc")
(include "././font/class.inc")

(def-method :vdu :lisp_create)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :d0-:d15

	(entry :vdu :lisp_create '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(call :vdu :create :nil '(:r1))
	(vp-pop :r0)

	(exit :vdu :lisp_create '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(create-vdu)" +error_msg_wrong_num_of_args))

(def-func-end)

(def-method :vdu :lisp_load)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8

	(structure slot 0
		(ptr this vdu lines)
		(pptr iter_begin iter_end)
		(plong cursor)
		(uint ox oy cx cy)
		(int len))

	(entry :vdu :lisp_load '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(vp-alloc slot_size)
	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6) '(:vdu :list :num :num :num :num))
	(save-fields :rsp '(slot_this slot_vdu slot_lines slot_ox slot_oy slot_cx slot_cy) '(:r0 :r1 :r2 :r3 :r4 :r5 :r6))

	;load vdu with line text
	(load-fields :r1 '(+vdu_chars +vdu_width +vdu_height) '(:r0 :r7 :r8))
	(vp-mul-rr :r8 :r7)
	(vp-shl-cr (log2 +long_size) :r7)
	(call :sys_mem :fill `(:r0 :r7 ,+char_space))
	(load-fields :rsp '(slot_vdu slot_lines slot_oy) '(:r0 :r1 :r2))
	(assign '((:r1 +array_length) (:r0 +vdu_height)) '(:r3 :r4))
	(vp-sub-rr :r2 :r3)
	(vpif '(:r3 > 0))
		(vp-min-rr :r4 :r3)
		(assign '(:r3) '((:rsp slot_len)))
		(vp-add-rr :r2 :r3)
		(call :list :get_iters '(:r1 :r2 :r3) '(_ :r1 :r2))
		(breakif '(:r1 = :r2))
		(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r1 :r2))
		(assign '((:rsp slot_vdu)) '(:r0))
		(assign '((:r0 +vdu_chars)) '(:r0))
		(assign '(:r0) '((:rsp slot_cursor)))
		(loop-start)
			;:r4 the line, :r2 len, its length less ox, :r7 ox
			(assign '((:rsp slot_iter_begin)) '(:r0))
			(assign '((:r0 0)) '(:r4))
			(assign `((:r4 +obj_vtable) (@ ,(f-path :str :vtable))) '(:r5 :r6))
			(vpif '(:r5 = :r6))
				(assign '((:r4 +str_length) (:rsp slot_ox)) '(:r2 :r7))
				(vp-sub-rr :r7 :r2)
				(assign '(:r2) '((:rsp slot_len)))
				(vpif '(:r2 > 0))
					;copy bytes to longs
					(vp-lea-rcr :r4 +str_data :r0)
					(vp-add-rr :r7 :r0)
					(load-fields :rsp '(slot_vdu slot_cursor) '(:r3 :r1))
					(assign '((:r3 +vdu_width)) '(:r3))
					(vp-min-rr :r3 :r2)
					(vp-add-rr :r0 :r2)
					(loop-start)
						(vp-load-rcr-ub :r0 0 :r3)
						(vp-store-rrc :r3 :r1 0)
						(vp-add-cr +byte_size :r0)
						(vp-add-cr +long_size :r1)
					(loop-until '(:r0 = :r2))
				(endif)
			(else)
				(assign `((@ ,(f-path :array :vtable))) '(:r6))
				(vpif '(:r5 /= :r6))
					(assign `((@ ,(f-path :nums :vtable))) '(:r6))
					(gotoif '(:r5 /= :r6) 'exit)
				(endif)
				(assign '((:r4 +array_length) (:rsp slot_ox)) '(:r2 :r7))
				(vp-sub-rr :r7 :r2)
				(assign '(:r2) '((:rsp slot_len)))
				(vpif '(:r2 > 0))
					;copy longs to longs
					(assign '((:r4 +array_begin)) '(:r0))
					(vp-shl-cr (log2 +long_size) :r7)
					(vp-add-rr :r7 :r0)
					(load-fields :rsp '(slot_vdu slot_cursor) '(:r3 :r1))
					(assign '((:r3 +vdu_width)) '(:r3))
					(vp-min-rr :r3 :r2)
					(vp-shl-cr (log2 +long_size) :r2)
					(call :sys_mem :copy '(:r0 :r1 :r2))
				(endif)
			(endif)
			(load-fields :rsp '(slot_vdu slot_cursor) '(:r0 :r1))
			(assign '((:r0 +vdu_width)) '(:r0))
			(vp-shl-cr (log2 +long_size) :r0)
			(vp-add-rr :r0 :r1)
			(assign '(:r1) '((:rsp slot_cursor)))
			(load-fields :rsp '(slot_iter_begin slot_iter_end) '(:r0 :r1))
			(vp-add-cr +ptr_size :r0)
			(assign '(:r0) '((:rsp slot_iter_begin)))
		(loop-until '(:r0 = :r1))
	(endif)

	;show cursor as inverse video char
	(load-fields :rsp '(slot_vdu slot_ox slot_oy slot_cx slot_cy) '(:r0 :r1 :r2 :r3 :r4))
	(vp-sub-rr :r1 :r3)
	(vp-sub-rr :r2 :r4)
	(assign '((:r0 +vdu_width) (:r0 +vdu_height)) '(:r5 :r6))
	(switch)
	(breakif '(:r3 < 0) '(:r4 < 0) '(:r3 >= :r5) '(:r4 >= :r6))
	(save-fields :rsp '(slot_cx slot_cy) '(:r3 :r4))
	(call :vdu :get_long_prop `(:r0 ,static_sym_ink) '(_ :r1))
	(call :pixmap :from_argb32 '(:r1 15) '(:r1))
	(load-fields :rsp '(slot_vdu slot_cx slot_cy) '(:r0 :r3 :r4))
	(assign '((:r0 +vdu_width) (:r0 +vdu_chars)) '(:r5 :r0))
	(vp-mul-rr :r5 :r4)
	(vp-add-rr :r3 :r4)
	(vp-shl-cr (log2 +long_size) :r4)
	(vp-add-rr :r4 :r0)
	(vp-shl-cr 48 :r1)
	(vp-load-rcr :r0 0 :r2)
	(vp-and-cr 0xffffff :r2)
	(vp-add-rr :r1 :r2)
	(vp-store-rrc :r2 :r0 0)
	(endswitch)

(vp-label 'exit)
	(load-fields :rsp '(slot_this slot_vdu) '(:r0 :r1))
	(exit :vdu :lisp_load '(:r0 :r1))
	(class/obj/ref :r1 :r2)
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(vdu-load vdu lines ox oy cx cy)" +error_msg_wrong_types))
	(signature '(:VDU :LIST :NUM :NUM :NUM :NUM))

(def-func-end)

(def-method :vdu :lisp_configure)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr vdu font this)
		(uint w h))

	(entry :vdu :lisp_configure '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))

	(list-bind-args :r1 '(:r0) '(:vdu))
	(assign '(:r0) '((:rsp slot_vdu)))
	(call :vdu :get_long_prop `((:rsp slot_vdu) ,static_sym_vdu_width) '(_ (:rsp slot_w)))
	(call :vdu :get_long_prop `((:rsp slot_vdu) ,static_sym_vdu_height) '(_ (:rsp slot_h)))
	(call :vdu :ref_prop `((:rsp slot_vdu) ,static_sym_font) '(_ :r1))
	(assign '(:r1) '((:rsp slot_font)))
	(assign '((:rsp slot_vdu)) '(:r0))
	(assign '((:r0 +vdu_font)) '(:r2))
	(vpif '(:r1 /= 0) '(:r1 /= :r2))
		(assign '(:r1) '((:r0 +vdu_font)))
		;set char size
		(call :font :get_metrics '(:r1) '(_ _ _ :r3))
		(assign '((:rsp slot_vdu)) '(:r0))
		(vp-cpy-rr :r3 :r4)
		(vp-mul-cr 9 :r4)
		(vp-shr-cr 4 :r4)
		(save-fields :r0 '(+vdu_char_height +vdu_char_width) '(:r3 :r4))
		;ref char textures
		(call :list :deref_if '((:r0 +vdu_textures)))
		(call :font :ascii_textures '((:rsp slot_font)) '(_ :r1))
		(assign '((:rsp slot_vdu)) '(:r0))
		(assign '(:r1) '((:r0 +vdu_textures)))
	(endif)
	(load-fields :rsp '(slot_vdu slot_w slot_h) '(:r0 :r1 :r2))
	(load-fields :r0 '(+vdu_width +vdu_height) '(:r3 :r4))
	(vpif '(:r1 = :r3) '(:r2 = :r4))
		;the size as it was
	(else)
		;free leaves the size in :r3 and :r4
		(call :sys_mem :free '((:r0 +vdu_chars)))
		(vp-cpy-rr :r3 :r0)
		(vp-mul-rr :r4 :r0)
		(vp-shl-cr (log2 +long_size) :r0)
		(call :sys_mem :alloc '(:r0) '(:r0 :r1))
		(assign '((:rsp slot_vdu)) '(:r2))
		(assign '(:r0) '((:r2 +vdu_chars)))
		(call :sys_mem :fill `(:r0 :r1 ,+char_space))
	(endif)
	(call :font :deref_if '((:rsp slot_font)))
	(call :obj :ref '((:rsp slot_vdu)))

	(exit :vdu :lisp_configure '((:rsp slot_this) (:rsp slot_vdu)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(vdu-configure vdu)" +error_msg_wrong_types))
	(signature '(:VDU))

(def-func-end)
