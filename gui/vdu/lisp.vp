(include "lib/asm/func.inc")
(include "class/nums/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "./class.inc")
(include "././pixmap/class.inc")
(include "././font/class.inc")

(def-method :vdu :lisp_create)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :d0-:d15

	(entry :vdu :lisp_create '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(call :vdu :create :nil '(:r1))
	(vp-pop :r0)

	(exit :vdu :lisp_create '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(create-vdu)" +error_msg_wrong_num_of_args))

(def-func-end)

(def-method :vdu :lisp_load)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8

	(def-vars
		(ptr this vdu lines line)
		(pptr iter_begin iter_end)
		(plong cursor)
		(uint ox oy cx cy col)
		(int len))

	(entry :vdu :lisp_load '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 6)

	(push-scope)
	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6) '(:vdu :list :num :num :num :num))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5 :r6) (vpx this vdu lines ox oy cx cy))

	;load vdu with line text
	(call :sys_mem :fill (vpx (.> vdu +vdu_chars) (* (.> vdu +vdu_width) (.> vdu +vdu_height) +long_size) +char_space))
	(assign (vpx (- (.> lines +array_length) oy)) (vpx len))
	(vpif (vpx (> len 0)))
		(vpif (vpx (> len (.> vdu +vdu_height))))
			(assign (vpx (.> vdu +vdu_height)) (vpx len))
		(endif)
		(call :list :get_iters (vpx lines oy (+ oy len)) (vpx _ iter_begin iter_end))
		(breakif (vpx (= iter_begin iter_end)))
		(assign (vpx (.> vdu +vdu_chars)) (vpx cursor))
		(loop-start)
			(assign (vpx (* iter_begin)) (vpx line))
			(vpif (vpx (= (.> line +obj_vtable) (@ ,(f-path :str :vtable)))))
				(vpif (vpx (> (=> (- (.> line +str_length) ox) len) 0)))
					;copy bytes to longs
					(assign (vpx (+ (& (.> line +str_data)) ox) cursor len (.> vdu +vdu_width)) '(:r0 :r1 :r2 :r3))
					(vpif '(:r2 > :r3))
						(vp-cpy-rr :r3 :r2)
					(endif)
					(vp-add-rr :r0 :r2)
					(loop-start)
						(vp-load-rcr-ub :r0 0 :r3)
						(vp-store-rrc :r3 :r1 0)
						(vp-add-cr +byte_size :r0)
						(vp-add-cr +long_size :r1)
					(loop-until '(:r0 = :r2))
				(endif)
			(else)
			(vpif (vpx (/= (.> line +obj_vtable) (@ ,(f-path :array :vtable)))))
				(gotoif (vpx (/= (.> line +obj_vtable) (@ ,(f-path :nums :vtable)))) 'exit)
			(endif)
				(vpif (vpx (> (=> (- (.> line +array_length) ox) len) 0)))
					;copy longs to longs
					(assign (vpx (+ (.> line +array_begin) (* ox +long_size)) cursor len (.> vdu +vdu_width)) '(:r0 :r1 :r2 :r3))
					(vpif '(:r2 > :r3))
						(vp-cpy-rr :r3 :r2)
					(endif)
					(vp-shl-cr (log2 +long_size) :r2)
					(call :sys_mem :copy '(:r0 :r1 :r2))
				(endif)
			(endif)
			(assign (vpx (+ cursor (* (.> vdu +vdu_width) +long_size))) (vpx cursor))
		(loop-until (vpx (= (=> (+ iter_begin +ptr_size) iter_begin) iter_end)))
	(endif)

	;show cursor as inverse video char
	(assign (vpx (- cx ox) (- cy oy)) (vpx cx cy))
	(switch)
	(breakif (vpx (| (< cx 0) (< cy 0) (>= cx (.> vdu +vdu_width)) (>= cy (.> vdu +vdu_height)))))
	(call :vdu :get_long_prop (vpx vdu static_sym_ink) (vpx _ col))
	(call :pixmap :from_argb32 (vpx col 15) (vpx col))
	(assign (vpx (+ (.> vdu +vdu_chars) (* (+ (* cy (.> vdu +vdu_width)) cx) +long_size)) (<< col 48)) '(:r0 :r1))
	(vp-load-rcr :r0 0 :r2)
	(vp-and-cr 0xffffff :r2)
	(vp-add-rr :r1 :r2)
	(vp-store-rrc :r2 :r0 0)
	(endswitch)

(vp-label 'exit)
	(exit :vdu :lisp_load (vpx this vdu))
	(class/obj/ref :r1 :r2)
	(pop-scope)
	(return)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(vdu-load vdu lines ox oy cx cy)" +error_msg_wrong_types))
	(signature '(:VDU :LIST :NUM :NUM :NUM :NUM))

(def-func-end)

(def-method :vdu :lisp_configure)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr vdu font this)
		(uint w h))

	(entry :vdu :lisp_configure '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))

	(list-bind-args :r1 '(:r0) '(:vdu))
	(assign '(:r0) '((:rsp slot_vdu)))
	(call :vdu :get_long_prop `((:rsp slot_vdu) ,static_sym_vdu_width) '(_ (:rsp slot_w)))
	(call :vdu :get_long_prop `((:rsp slot_vdu) ,static_sym_vdu_height) '(_ (:rsp slot_h)))
	(call :vdu :ref_prop `((:rsp slot_vdu) ,static_sym_font) '(_ :r1))
	(assign '(:r1) '((:rsp slot_font)))
	(assign '((:rsp slot_vdu)) '(:r0))
	(assign '((:r0 +vdu_font)) '(:r2))
	(vpif '(:r1 /= 0) '(:r1 /= :r2))
		(assign '(:r1) '((:r0 +vdu_font)))
		;set char size
		(call :font :get_metrics '(:r1) '(_ _ _ :r3))
		(assign '((:rsp slot_vdu)) '(:r0))
		(vp-cpy-rr :r3 :r4)
		(vp-mul-cr 9 :r4)
		(vp-shr-cr 4 :r4)
		(save-fields :r0 '(+vdu_char_height +vdu_char_width) '(:r3 :r4))
		;ref char textures
		(call :list :deref_if '((:r0 +vdu_textures)))
		(call :font :ascii_textures '((:rsp slot_font)) '(_ :r1))
		(assign '((:rsp slot_vdu)) '(:r0))
		(assign '(:r1) '((:r0 +vdu_textures)))
	(endif)
	(load-fields :rsp '(slot_vdu slot_w slot_h) '(:r0 :r1 :r2))
	(load-fields :r0 '(+vdu_width +vdu_height) '(:r3 :r4))
	(vpif '(:r1 = :r3) '(:r2 = :r4))
		;the size as it was
	(else)
		;free leaves the size in :r3 and :r4
		(call :sys_mem :free '((:r0 +vdu_chars)))
		(vp-cpy-rr :r3 :r0)
		(vp-mul-rr :r4 :r0)
		(vp-shl-cr (log2 +long_size) :r0)
		(call :sys_mem :alloc '(:r0) '(:r0 :r1))
		(assign '((:rsp slot_vdu)) '(:r2))
		(assign '(:r0) '((:r2 +vdu_chars)))
		(call :sys_mem :fill `(:r0 :r1 ,+char_space))
	(endif)
	(call :font :deref_if '((:rsp slot_font)))
	(call :obj :ref '((:rsp slot_vdu)))

	(exit :vdu :lisp_configure '((:rsp slot_this) (:rsp slot_vdu)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(vdu-configure vdu)" +error_msg_wrong_types))
	(signature '(:VDU))

(def-func-end)
