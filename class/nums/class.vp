(include "lib/asm/func.inc")
(include "././list/class.inc")
(include "././floats/class.inc")
(include "././bytes/class.inc")
(include "././shorts/class.inc")
(include "././ints/class.inc")

(gen-create :nums)
	;outputs
	;:r0 = 0 if error, else nums object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :nums)
(gen-type :nums)
	;inputs
	;:r0 = nums object (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :nums :add)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 e0 e1))

	(entry :nums :add `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-add-rr %1 %0) %0))

	(exit :nums :add `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :nums :sub)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 e0 e1))

	(entry :nums :sub `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-sub-rr %1 %0) %0))

	(exit :nums :sub `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :nums :min)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 e0 e1))

	(entry :nums :min `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-min-rr %1 %0) %0))

	(exit :nums :min `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :nums :max)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 e0 e1))

	(entry :nums :max `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-max-rr %1 %0) %0))

	(exit :nums :max `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :nums :mul)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r7

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 e0 e1))

	(entry :nums :mul `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-rr %1 %0) %0))

	(exit :nums :mul `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :nums :div)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1, :r3-:r8

	(vp-rdef (e0 e1 high src1 src2 dst1 idx1 idx2 dst))

	(entry :nums :div `(,dst ,e1 ,high))

	(vec-map-idx (list e1 high) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = 0) 'error)
			(vp-div-rr %1 %0)
			%0))

	(exit :nums :div `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :nums :div `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :nums :mod)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1, :r3-:r8

	(vp-rdef (e0 e1 high src1 src2 dst1 idx1 idx2 dst))

	(entry :nums :mod `(,dst ,e1 ,high))

	(vec-map-idx (list e1 high) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (gotoif `(,%%1 = 0) 'error)
			(vp-rem-rr %1 %0)
			%0))

	(exit :nums :mod `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :nums :mod `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :nums :abs)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;trashes
	;:r1-:r5

	(vp-rdef (dst src1 dst1 idx1 idx2 e0))

	(entry :nums :abs `(,dst ,src1))

	(vec-map-idx (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-abs-rr %0 %0) %0))

	(exit :nums :abs `(,dst))
	(vp-ret)

(def-func-end)

(def-method :nums :sum)
	;inputs
	;:r0 = nums object (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = sum (long)
	;trashes
	;:r1-:r4

	(vp-rdef (dst sum dst1 dst_end e0))

	(entry :nums :sum `(,dst))

	(vec-reduce (list dst) (list e0) (list dst1) dst_end
		(# (vp-add-rr %0 sum))
		(# (vp-sub-rr sum sum)))

	(exit :nums :sum `(,dst ,sum))
	(vp-ret)

(def-func-end)

(def-method :nums :scale)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source nums object, can be same (ptr)
	;:r2 = scale (int)
	;outputs
	;:r0 = nums object (ptr)
	;trashes
	;:r1, :r3-:r6

	(vp-rdef (dst src1 scale dst1 idx1 idx2 e0))

	(entry :nums :scale `(,dst ,src1 ,scale))

	(vec-map-idx (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-mul-rr scale %0) %0))

	(exit :nums :scale `(,dst))
	(vp-ret)

(def-func-end)

(def-method :nums :add_scaled)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source1 nums object, can be same (ptr)
	;:r2 = source2 nums object, can be same (ptr)
	;:r3 = scale (int)
	;outputs
	;:r0 = nums object (ptr)
	;trashes
	;:r1-:r2, :r4-:r8
	;info
	;each of the first plus each of the second times the scale, in one pass

	(vp-rdef (dst src1 src2 scale dst1 idx1 idx2 e0 e1))

	(entry :nums :add_scaled `(,dst ,src1 ,src2 ,scale))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-rr scale %1) (vp-add-rr %1 %0) %0))

	(exit :nums :add_scaled `(,dst))
	(vp-ret)

(def-func-end)

(def-method :nums :convert)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = source nums object, of any kind (ptr)
	;:r3 = 1 to read a raw source signed, else 0 (uint)
	;outputs
	;:r0 = nums object (ptr)
	;trashes
	;:r2-:r6, :d0-:d15
	;info
	;made the source's length, each element of it converted

	(nums-convert-method :nums :nums)

(def-func-end)

(def-method :nums :kind)
	;inputs
	;:r0 = nums object, or a bytes, shorts or ints (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = 0 nums, 1 fixeds, 2 doubles, 3 floats, 4 bytes, 6 shorts,
	;8 ints (uint)
	;trashes
	;:r1-:r2
	;info
	;the kind of vector, a path as fixeds

	(entry :nums :kind '(:r0))

	(assign '((:r0 +obj_vtable)) '(:r1))
	(f-bind :bytes :vtable :r2)
	(gotoif '(:r1 = :r2) 'bytes)
	(f-bind :shorts :vtable :r2)
	(gotoif '(:r1 = :r2) 'shorts)
	(f-bind :ints :vtable :r2)
	(gotoif '(:r1 = :r2) 'ints)
	(f-bind :floats :vtable :r2)
	(vpif '(:r1 = :r2))
		(vp-cpy-cr 3 :r1)
	(else)
		(f-bind :doubles :vtable :r2)
		(vpif '(:r1 = :r2))
			(vp-cpy-cr 2 :r1)
		(else)
			(call :obj :inst_of `(:r0 (@ ,(f-path :fixeds :vtable))) '(:r0 :r1))
			(vpif '(:r1 /= 0))
				(vp-cpy-cr 1 :r1)
			(endif)
		(endif)
	(endif)

	(exit :nums :kind '(:r0 :r1))
	(vp-ret)

(vp-label 'bytes)
	(vp-cpy-cr 4 :r1)
	(exit :nums :kind '(:r0 :r1))
	(vp-ret)
(vp-label 'shorts)
	(vp-cpy-cr 6 :r1)
	(exit :nums :kind '(:r0 :r1))
	(vp-ret)
(vp-label 'ints)
	(vp-cpy-cr 8 :r1)
	(exit :nums :kind '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :nums :narrow)
	;inputs
	;:r0 = bytes, shorts or ints object (ptr)
	;:r1 = source nums object, of any kind of number (ptr)
	;outputs
	;:r0 = bytes, shorts or ints object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15
	;info
	;made the source's length, each element an integer as n2i makes it,
	;its low bits

	(vp-rdef (dst src s d len tmp kind w))
	(entry :nums :narrow `(,dst ,src))
	(assign `((,src +array_length)) `(,len))
	(vp-push dst src len)
	(call :array :set_cap `(,dst ,len) :nil :r2)
	(vp-pop dst src len)
	(assign `(,len) `((,dst +array_length)))
	;the width, 0 1 2 for bytes shorts ints, in w, which :kind leaves
	(assign `((,dst +obj_vtable)) `(,tmp))
	(vp-xor-rr w w)
	(f-bind :shorts :vtable kind)
	(vpif `(,tmp = ,kind))
		(vp-cpy-cr 1 w)
	(endif)
	(f-bind :ints :vtable kind)
	(vpif `(,tmp = ,kind))
		(vp-cpy-cr 2 w)
	(endif)
	(vp-push dst)
	(call :nums :kind `(,src) `(,src ,kind))
	(vp-pop dst)
	(assign `((,dst +array_begin) (,src +array_begin)) `(,d ,s))
	(vp-mul-cr 3 kind)
	(vp-add-rr w kind)
	(switch)
	(each (lambda (from)
			(defq fi (!))
			(each (lambda (wb)
					(vpcase `(,kind = ,(+ (* 3 fi) (!))))
						(nums-narrow-pair from wb s d len tmp)
						(break))
				'(1 2 4)))
		+nums_kinds)
	(endswitch)
	(exit :nums :narrow `(,dst))
	(vp-ret)

(def-func-end)

(def-method :nums :dot)
	;inputs
	;:r0 = nums object (ptr)
	;:r1 = nums object, can be same (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = dot product (long)
	;trashes
	;:r1-:r7

	(vp-rdef (src dot src1 src2 idx1 idx2 e0 e1))

	(entry :nums :dot `(,src ,dot))

	(vec-reduce-idx (list src dot) (list e0 e1) (list src1 src2) (list idx1 idx2)
		(# (vp-mul-rr %0 %1) (vp-add-rr %1 dot))
		(# (vp-sub-rr dot dot)))

	(exit :nums :dot `(,src ,dot))
	(vp-ret)

(def-func-end)

(def-method :nums :hash)
	;inputs
	;:r0 = nums object (ptr)
	;outputs
	;:r0 = nums object (ptr)
	;:r1 = hash code (long)
	;trashes
	;:r1-:r4

	(vp-rdef (src val src1 src_end e0))

	(entry :nums :hash `(,src))

	(vec-reduce (list src) (list e0) (list src1) src_end
		(# (vp-xor-rr %0 val))
		(# (vp-sub-rr val val))
		(# (vp-shr-cr 1 val)))

	(exit :nums :hash `(,src ,val))
	(vp-ret)

(def-func-end)
