(def-method :nums :lisp_sum)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15

	(entry :nums :lisp_sum '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)
;an empty vector has no sum, as with the other vector ops
	(array-bind-args :r1 '(:r2))
	(assign '((:r2 +array_length)) '(:r2))
	(gotoif '(:r2 = 0) 'error)

	(vp-push :r0)
	(array-bind-args :r1 '(:r0))
	(vp-push :r0)
	(call :nums :sum '(:r0) '(& :r0) :r1)
	(vp-pop :r1)
	(v-call :array :velement '(:r0) '(:r1) :r1 :r1)
	(vp-pop :r0)

	(exit :nums :lisp_sum '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(nums-sum nums)" +error_msg_wrong_types))
	(signature '(:nums))

(def-func-end)

(def-method :nums :lisp_scale)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(vp-rdef (dst iter_begin nums1 scale this args argc len1 len2)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry :nums :lisp_scale '(:r0 :r1))
	(assign '(:r0 :r1) `(,this ,args))

	(gotoif-lisp-args-sig 'error args 2 3)

	(assign `((,args +array_length) (,args +array_begin)) `(,argc ,iter_begin))
	(array-get-args iter_begin `(,nums1 ,scale))
	(assign `((,nums1 +array_length)) `(,len1))
	(gotoif `(,len1 = 0) 'error)
	(vpif `(,argc = 2))
		(v-call :nums :vcreate `(,dst) `(,dst) nums1 iter_begin)
		(call :nums :set_cap `(,dst ,len1) `(,dst) :r2)
		(call :nums :set_length `(,dst ,len1) `(,dst &))
	(else)
		(vp-load-rcr iter_begin (* +ptr_size 2) dst)
		(assign `((,dst +array_length)) `(,len2))
		(gotoif `(,len1 > ,len2) 'error)
		;of the kind it is scaled from, a floats' numbers are half the size
		(assign `((,nums1 +obj_vtable) (,dst +obj_vtable)) `(,argc ,len2))
		(gotoif `(,argc /= ,len2) 'error)
		(call :obj :ref `(,dst) `(,dst))
	(endif)
	(call :nums :scale `(,dst ,nums1 (,scale +num_value)) `(,dst) :r3)

	(exit :nums :lisp_scale `(,this ,dst))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r10 "(nums-scale nums scale [nums])" +error_msg_wrong_types))
	(signature '(:nums :num :nums))

(def-func-end)

(def-method :nums :lisp_add_scaled)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15
	;info
	;(nums-add-scaled nums nums scale [nums]) -> nums, the first plus the
	;second times scale, in one pass

	(vp-rdef (dst iter_begin nums1 nums2 scale this args argc len1 len2)
		'(:r0 :r1 :r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13))

	(entry :nums :lisp_add_scaled '(:r0 :r1))
	(assign '(:r0 :r1) `(,this ,args))

	(gotoif-lisp-args-sig 'error args 3 4)

	(assign `((,args +array_length) (,args +array_begin)) `(,argc ,iter_begin))
	(array-get-args iter_begin `(,nums1 ,nums2 ,scale))
	(assign `((,nums1 +array_length) (,nums2 +array_length)) `(,len1 ,len2))
	(gotoif `(,len1 = 0) 'error)
	(gotoif `(,len1 > ,len2) 'error)
	;all of one kind, a floats' numbers are half the size of the others'
	(assign `((,nums1 +obj_vtable) (,nums2 +obj_vtable)) `(,dst ,len2))
	(gotoif `(,dst /= ,len2) 'error)
	(vpif `(,argc = 3))
		(v-call :nums :vcreate `(,dst) `(,dst) nums1 iter_begin)
		(call :nums :set_cap `(,dst ,len1) `(,dst) :r2)
		(call :nums :set_length `(,dst ,len1) `(,dst &))
	(else)
		(vp-load-rcr iter_begin (* +ptr_size 3) dst)
		(assign `((,dst +array_length)) `(,len2))
		(gotoif `(,len1 > ,len2) 'error)
		(assign `((,nums1 +obj_vtable) (,dst +obj_vtable)) `(,argc ,len2))
		(gotoif `(,argc /= ,len2) 'error)
		(call :obj :ref `(,dst) `(,dst))
	(endif)
	(call :nums :add_scaled `(,dst ,nums1 ,nums2 (,scale +num_value)) `(,dst) :r4)

	(exit :nums :lisp_add_scaled `(,this ,dst))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(nums-add-scaled nums nums scale [nums])" +error_msg_wrong_types))
	(signature '(:nums :nums :num :nums))

(def-func-end)

(def-method :nums :lisp_convert)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15
	;info
	;(nums-convert src dst [signed]) -> dst, dst made the length of src, each
	;element converted to dst's kind: of nums, fixeds, doubles or floats from
	;any of those or a raw kind, bytes, shorts or ints, read signed if signed
	;is given and not :nil; or of a raw kind from any of the four, each made
	;an integer as n2i does, its low bits

	(entry :nums :lisp_convert '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2 3)

	(vp-push :r0 :r1)
	;the sign in :r3, a third that is not :nil
	(assign '((:r1 +array_length) (:r1 +array_begin) (:r0 +lisp_sym_nil)) '(:r2 :r5 :r6))
	(vp-xor-rr :r3 :r3)
	(vpif '(:r2 = 3))
		(assign `((:r5 ,(* 2 +ptr_size))) '(:r2))
		(vpif '(:r2 /= :r6))
			(vp-cpy-cr 1 :r3)
		(endif)
	(endif)
	(assign '((:r5 0) (:r5 +ptr_size)) '(:r4 :r5))
	;the kinds of each, :r4 source and :r5 destination: a raw kind or a
	;number, or an error
	(assign '((:r4 +obj_vtable)) '(:r1))
	(f-bind :bytes :vtable :r2)
	(gotoif '(:r1 = :r2) 'raw_source)
	(f-bind :shorts :vtable :r2)
	(gotoif '(:r1 = :r2) 'raw_source)
	(f-bind :ints :vtable :r2)
	(gotoif '(:r1 = :r2) 'raw_source)
	(call :obj :inst_of `(:r4 (@ ,(f-path :nums :vtable))) '(& :r1))
	(gotoif '(:r1 = 0) 'error1)
	;a source of numbers, into numbers or a raw kind
	(call :obj :inst_of `(:r5 (@ ,(f-path :nums :vtable))) '(& :r1))
	(gotoif '(:r1 /= 0) 'numbers)
	(assign '((:r5 +obj_vtable)) '(:r1))
	(f-bind :bytes :vtable :r2)
	(gotoif '(:r1 = :r2) 'narrow)
	(f-bind :shorts :vtable :r2)
	(gotoif '(:r1 = :r2) 'narrow)
	(f-bind :ints :vtable :r2)
	(gotoif '(:r1 /= :r2) 'error1)
(vp-label 'narrow)
	(call :nums :narrow '(:r5 :r4) '(:r0))
	(goto 'done)
(vp-label 'raw_source)
	;a raw source, into numbers only
	(call :obj :inst_of `(:r5 (@ ,(f-path :nums :vtable))) '(& :r1))
	(gotoif '(:r1 = 0) 'error1)
(vp-label 'numbers)
	(call :nums :convert '(:r5 :r4 :r3) '(:r0) :r2)
(vp-label 'done)
	(class/obj/ref :r0 :r1)
	(vp-cpy-rr :r0 :r1)
	(vp-pop :r0 :r2)

	(exit :nums :lisp_convert '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(nums-convert src dst [signed])" +error_msg_wrong_types))
	(signature '(:array :array :obj))

(def-func-end)

(def-method :nums :lisp_abs)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r12, :r14, :d0-:d15

	(entry :nums :lisp_abs '(:r0 :r1))

	(vp-push :r1)
	(array-bind-args :r1 '(:r2))
	(v-bind :nums :abs :r2 :r2)
	(call :nums :lisp_vecop2 '(:r0 :r1 :r2) '(:r0 :r1))
	(vp-pop :r3)
	(gotoif '(:r1 = 0) 'error)

	(exit :nums :lisp_abs '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r3 "(nums-abs nums [nums])" +error_msg_wrong_types))

(def-func-end)

(def-method :nums :lisp_dot)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :r14, :d0-:d15

	(entry :nums :lisp_dot '(:r0 :r1))

	(gotoif-lisp-args-len 'error :r1 /= 2)
	(gotoif-lisp-args-match 'error :r1 :nums 2)

	(vp-push :r0 :r1)
	(array-bind-args :r1 '(:r0 :r1))

	(assign '((:r0 +array_length) (:r1 +array_length)) '(:r2 :r3))
	(gotoif '(:r2 = 0) 'error1)
	(gotoif '(:r2 > :r3) 'error1)

	(vp-push :r0)
	(call :nums :dot '(:r0 :r1) '(& :r0) :r2)
	(vp-pop :r1)
	(v-call :array :velement '(:r0) '(:r1) :r1 :r1)
	(vp-pop :r0 :r2)

	(exit :nums :lisp_dot '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-pop :r0 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(nums-dot nums nums)" +error_msg_wrong_types))

(def-func-end)
