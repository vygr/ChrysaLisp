(include "lib/asm/func.inc")
(include "./class.inc")
(include "././hset/class.inc")

(gen-create :hmap)
(gen-vtable :hmap)
(gen-type :hmap)

(def-method :hmap :init)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = num buckets (uint)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :f0-:f15

	(vp-rdef (this vtable num_buckets iter_begin iter_end saved_this))

	(entry :hmap :init `(,this ,vtable (,this +array_num_buckets)))

	;init parent
	(s-call :hmap :init `(,this ,vtable) `(,this ,vtable))
	(vpif `(,vtable /= 0))
		;init myself, massage the :array element layout
		(assign `(,(>> (- +hmap_size +hmap_elems) (log2 +long_size)) (& ,this +hmap_elems) 0)
			`(,vtable ,num_buckets ,iter_begin))
		(save-fields this '(+array_capacity +array_begin +hmap_parent)
			`(,vtable ,num_buckets ,iter_begin))
		;now the buckets
		(assign `((,this +array_num_buckets)) `(,vtable))
		(vpif `(,vtable /= 1))
			(assign `(,vtable) `((,this +array_length)))
			(call :hmap :set_cap `(,this ,vtable) `(,this))
			(class/array/get_both this iter_begin iter_end)
			(vp-cpy-rr this saved_this)
			(loop-start)
				(call :list :create :nil `((,iter_begin 0)))
				(vp-add-cr +ptr_size iter_begin)
			(loop-until `(,iter_begin = ,iter_end))
			(vp-cpy-rr saved_this this)
		(endif)
	(endif)

	(exit :hmap :init `(,this ,vtable))
	(vp-ret)

(def-func-end)

(def-method :hmap :deinit)
	;inputs
	;:r0 = hmap object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :hmap :deinit '(this))

	(vp-push this)
	(call :hmap :deref_if `((,this +hmap_parent)))
	(vp-pop this)
	(s-jump :hmap :deinit `(,this))

(def-func-end)

(def-method :hmap :set_parent)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = 0, else hmap parent object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this parent old_parent))

	(entry :hmap :set_parent `(,this ,parent))

	(vp-push this)
	(assign `((,this +hmap_parent)) `(,old_parent))
	(assign `(,parent) `((,this +hmap_parent)))
	(call :hmap :deref_if `(,old_parent))
	(vp-pop this)

	(exit :hmap :set_parent `(,this))
	(vp-ret)

(def-func-end)

(def-method :hmap :copy)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = num buckets (uint)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = hmap copy object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		;obj must be first
		(ptr obj this))

	;save inputs
	(vp-alloc local_size)
	(entry :hmap :copy '(this num_buckets))
	(assign `(,this) '((:rsp local_this)))

	(call :hmap :create `(,num_buckets) '((:rsp local_obj)))
	(assign '((:rsp local_this)) `(,this))
	(assign `((,this +hmap_parent)) `(,this))
	(call :hmap :ref_if `(,this) `(,this))
	(call :hmap :set_parent `((:rsp local_obj) ,this) `(,this))
	(call :hmap :each `((:rsp local_this) ($ callback) ,this) `(,this))

	(exit :hmap :copy `(,this (:rsp local_obj)))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(vp-rdef (obj key val tmp))

	(entry :hmap :each_callback `(,obj ,key ,val))

	(assign `((,key 0) (,key +ptr_size)) `(,key ,val))
	(class/obj/ref key tmp)
	(class/obj/ref val tmp)
	(vp-push key val)
	(call :hset :bucket `(,obj ,key) `(_ ,obj))
	(vp-pop key val)
	(jump :list :push_back2 `(,obj ,key ,val))

(def-func-end)

(def-method :hmap :list)
	;inputs
	;:r0 = hmap object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = list object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr obj this))

	;save inputs
	(vp-alloc local_size)
	(entry :hmap :list '(this))
	(assign `(,this) '((:rsp local_this)))

	(call :list :create :nil `(,this))
	(assign `(,this) '((:rsp local_obj)))
	(call :hmap :each `((:rsp local_this) ($ callback) ,this) `(,this))

	(exit :hmap :list `(,this (:rsp local_obj)))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(vp-rdef (out_list key val pair_list iter bucket) '(:r6 :r7 :r8))

	(entry :hmap :each_callback `(,pair_list ,iter ,bucket))

	(assign `(,pair_list (,iter 0) (,iter +ptr_size)) `(,out_list ,key ,val))
	(call :list :create :nil `(,pair_list))
	(class/obj/ref key iter)
	(class/obj/ref val iter)
	(call :list :push_back2 `(,pair_list ,key ,val) `(,iter _ _ _ _))
	(jump :list :push_back `(,out_list ,iter))

(def-func-end)

(def-method :hmap :pfind)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = key str object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = 0, else found iterator (pptr)
	;:r2 = bucket list (ptr)
	;trashes
	;:r1-:r7

	(vp-rdef (key this iter buckets iter_end iter_begin slot) '(:r7))

	;save inputs
	(entry :hmap :pfind `(,this ,iter))

	;search hash bucket
	(assign `(,iter) `(,key))
	(call :hset :bucket `(,this ,iter) `(,this ,buckets))
	(class/array/get_both buckets iter_begin iter_end)
	(vpif `(,iter_begin /= ,iter_end))
		;use the key address, and last known slot
		(vp-cpy-rr iter_begin iter)
		(assign `((,key +str_hashslot)) `(,slot))
		(vp-shl-cr (log2 (* +ptr_size 2)) slot)
		(vp-add-rr slot iter)
		(vpif `(,iter < ,iter_end))
			(assign `((,iter 0)) `(,slot))
			(gotoif `(,key = ,slot) 'slot_hit)
		(endif)
		;cache miss, so scan the bucket
		(vp-cpy-rr iter_begin iter)
		(loop-start)
			(assign `((,iter 0)) `(,slot))
			(gotoif `(,key = ,slot) 'scan_hit)
			(vp-add-cr (* +ptr_size 2) iter)
		(loop-until `(,iter = ,iter_end))
	(endif)
	(vp-xor-rr iter iter)

(vp-label 'slot_hit)
	(exit :hmap :pfind `(,this ,iter ,buckets))
	(vp-ret)

(vp-label 'scan_hit)
	(vp-cpy-rr iter slot)
	(vp-sub-rr iter_begin slot)
	(vp-shr-cr (log2 (* +ptr_size 2)) slot)
	(assign `(,slot) `((,key +str_hashslot)))
	(exit :hmap :pfind `(,this ,iter ,buckets))
	(vp-ret)

(def-func-end)

(def-method :hmap :pinsert)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = key str object (ptr)
	;:r2 = value object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = iterator (pptr)
	;:r2 = bucket list (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this key) (method-input :hmap :pinsert))
	(vp-rdef (_ iter bucket) (method-output :hmap :pinsert))
	(vp-rdef (saved_key saved_value old_value tmp) '(:r8 :r9 :r10 :r11))

	;save inputs
	(entry :hmap :pinsert `(,this ,key ,saved_value))
	(assign `(,key) `(,saved_key))

	;search hash bucket
	(call :hmap :pfind `(,this ,key) `(,this ,iter ,bucket))
	(vpif `(,iter /= 0))
		;have old key
		(assign `((,iter +ptr_size)) `(,old_value))
		(vpif `(,old_value /= ,saved_value))
			;have new value
			(vp-push this iter bucket)

			(assign `(,saved_value) `((,iter +ptr_size)))
			(class/obj/ref saved_value tmp)
			(call :obj :deref `(,old_value))

			(vp-pop this iter bucket)
		(endif)
		(exit :hmap :pinsert `(,this ,iter ,bucket))
		(vp-ret)
	(endif)

	;new key, (key could be same as value !)
	(vp-push this)

	(class/obj/ref saved_key tmp)
	(class/obj/ref saved_value tmp)
	(call :list :push_back2 `(,bucket ,saved_key ,saved_value) `(,bucket ,iter _ iter_s iter_e))

	;initial known slot
	(vp-sub-cr (* +ptr_size 2) iter_e)
	(vp-sub-rr iter_e iter_s)
	(vp-mul-cr -1 iter_s)
	(vp-shr-cr (log2 (* +ptr_size 2)) iter_s)
	(assign `(,iter_s) `((,iter +str_hashslot)))

	(vp-pop this)
	(exit :hmap :pinsert `(,this ,iter_e ,bucket))
	(vp-ret)

(def-func-end)

(def-method :hmap :cfind)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = key object (ptr)
	;:r2 = key callback (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = 0, else found iterator (pptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r10

	(vp-rdef (key1 key2))
	(vp-rdef (this key cmp_func buckets iter_begin iter_end)
		'(:r7 :r8 :r9 :r5 :r6 :r10))

	;save inputs
	(entry :hmap :cfind `(,this ,key ,cmp_func))

	;search hash bucket
	(call :hset :bucket `(,this ,key) `(_ ,buckets))
	(class/array/get_both buckets iter_begin iter_end)
	(vpif `(,iter_begin /= ,iter_end))
		(loop-start)
			(assign `((,iter_begin 0) ,key) `(,key2 ,key1))
			;give some indication of the trashes
			;:nodeid :eql is the worst ATM
			(vp-call-r cmp_func :nodeid :eql)
			(gotoif `(,key2 = 0) 'cmp_hit)
			(vp-add-cr (* +ptr_size 2) iter_begin)
		(loop-until `(,iter_begin = ,iter_end))
	(endif)
	(vp-xor-rr iter_begin iter_begin)
(vp-label 'cmp_hit)
	(exit :hmap :cfind `(,this ,iter_begin ,buckets))
	(vp-ret)

(def-func-end)

(def-method :hmap :search)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = key str object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = 0, else iterator (pptr)
	;:r2 = bucket list (ptr)
	;trashes
	;:r1-:r9

	(vp-rdef (this key) (method-input :hmap :search))
	(vp-rdef (_ iter bucket) (method-output :hmap :search))
	(vp-rdef (saved_this saved_key) '(:r8 :r9))

	(entry :hmap :search `(,this ,key))
	(assign `(,this ,key) `(,saved_this ,saved_key))

	(loop-start)
		(call :hmap :pfind `(,this ,key) `(,this ,iter ,bucket))
		(breakif `(,iter /= 0))
		(assign `((,this +hmap_parent)) `(,iter))
		(breakif `(,iter = 0))
		(assign `(,iter ,saved_key) `(,this ,key))
	(loop-end)

	(exit :hmap :search `(,saved_this ,iter ,bucket))
	(vp-ret)

(def-func-end)

(def-method :hmap :set)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = key str object (ptr)
	;:r2 = value object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = 0 if not found, else value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this key) (method-input :hmap :set))
	(vp-rdef (_ iter) (method-output :hmap :set))
	(vp-rdef (saved_value old_value tmp) '(:r10 :r11 :r12))

	(entry :hmap :set `(,this ,key ,saved_value))

	(call :hmap :search `(,this ,key) `(,this ,iter _))
	(vpif `(,iter /= 0))
		;have old key
		(assign `((,iter +ptr_size)) `(,old_value))
		(breakif `(,old_value = ,saved_value))

		;have new value
		(vp-push this saved_value)

		(assign `(,saved_value) `((,iter +ptr_size)))
		(class/obj/ref saved_value tmp)
		(call :obj :deref `(,old_value))

		(vp-pop this iter)
	(endif)

	(exit :hmap :set `(,this ,iter))
	(vp-ret)

(def-func-end)

(def-method :hmap :get)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = key str object (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;:r1 = 0 if not found, else value object (ptr)
	;trashes
	;:r1-:r9

	(vp-rdef (this key) (method-input :hmap :get))
	(vp-rdef (_ iter) (method-output :hmap :get))
	(vp-rdef (tmp) '(:r2))

	(entry :hmap :get `(,this ,key))

	(call :hmap :search `(,this ,key) `(,this ,iter _))
	(vpif `(,iter /= 0))
		;have old key
		(assign `((,iter +ptr_size)) `(,iter))
		(class/obj/ref iter tmp)
	(endif)

	(exit :hmap :get `(,this ,iter))
	(vp-ret)

(def-func-end)

(def-method :hmap :each)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = predicate function (ptr)
	;:r2 = predicate data (ptr)
	;outputs
	;:r0 = hmap object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
		;callback predicate
		;inputs
		;:r0 = predicate data (ptr)
		;:r1 = element iterator (pptr)
		;trashes
		;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this predicate predicate_data bucket)
		(pptr iter_begin iter_end iter_begin1 iter_end1))

	(vp-rdef (this predicate predicate_data scratch old_end))

	;save inputs
	(vp-alloc local_size)
	(entry :hmap :each `(,this (:rsp local_predicate) (:rsp local_predicate_data)))
	(assign `(,this) '((:rsp local_this)))

	;for all buckets
	(assign `((,this +array_num_buckets) ,this) `(,predicate ,predicate_data))
	(vpif `(,predicate = 1))
		(class/array/get_both predicate_data predicate this)
		(assign `(,predicate_data) '((:rsp local_bucket)))
	(vp-label 'erased)
		(assign `(,this) '((:rsp local_iter_end)))
		(loop-while `(,predicate < ,this))
			(assign `((:rsp local_predicate_data) ,predicate) `(,this (:rsp local_iter_begin)))
			(vp-call-i :rsp local_predicate)
			(assign `((:rsp local_bucket) (:rsp local_iter_begin) (:rsp local_iter_end))
				`(,predicate_data ,predicate ,old_end))
			(class/array/get_end predicate_data this scratch)
			(gotoif `(,this /= ,old_end) 'erased)
			(vp-add-cr (* +ptr_size 2) predicate)
		(loop-end)
	(else)
		(class/array/get_both predicate_data predicate this)
		(assign `(,this) '((:rsp local_iter_end1)))
		(loop-start)
			(assign `((,predicate 0) ,predicate) `(,predicate_data (:rsp local_iter_begin1)))
			(class/array/get_both predicate_data predicate this)
			(assign `(,predicate_data) '((:rsp local_bucket)))
		(vp-label 'erased1)
			(assign `(,this) '((:rsp local_iter_end)))
			(loop-while `(,predicate < ,this))
				(assign `((:rsp local_predicate_data) ,predicate) `(,this (:rsp local_iter_begin)))
				(vp-call-i :rsp local_predicate)
				(assign `((:rsp local_bucket) (:rsp local_iter_begin) (:rsp local_iter_end))
					`(,predicate_data ,predicate ,old_end))
				(class/array/get_end predicate_data this scratch)
				(gotoif `(,this /= ,old_end) 'erased1)
				(vp-add-cr (* +ptr_size 2) predicate)
			(loop-end)
			(assign `((:rsp local_iter_begin1) (:rsp local_iter_end1)) `(,predicate ,predicate_data))
			(vp-add-cr +ptr_size predicate)
		(loop-until `(,predicate = ,predicate_data))
	(endif)

	(exit :hmap :each '((:rsp local_this)))
	(vp-free local_size)
	(vp-ret)

(def-func-end)

(def-method :hmap :resize)
	;inputs
	;:r0 = hmap object (ptr)
	;:r1 = num buckets (uint)
	;outputs
	;:r0 = hmap object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this that))

	(vp-rdef (this that len))

	;save inputs
	(vp-alloc local_size)
	(entry :hmap :resize `(,this ,that))

	(call :hmap :copy `(,this ,that) `(,this ,that))
	(assign `(,this ,that) '((:rsp local_this) (:rsp local_that)))
	(call :hmap :clear `(,this) `(,this))
	(assign '((:rsp local_that)) `(,that))
	(call :hmap :append `(,this ,that 0 (,that +array_length)) `(,this))
	(assign '((:rsp local_that)) `(,that))
	(assign `((,that +array_num_buckets)) `(,len))
	(assign `(,len) `((,this +array_num_buckets)))
	(call :hmap :deref `(,that))
	(assign '((:rsp local_this)) `(,this))

	(exit :hmap :resize `(,this))
	(vp-free local_size)
	(vp-ret)

(def-func-end)
