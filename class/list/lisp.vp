(include "lib/asm/func.inc")
(include "././num/class.inc")
(include "././lisp/class.inc")

(def-method :list :lisp_list)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r2

	(entry :list :lisp_list '(:r0 :r1))

	(class/obj/ref :r1 :r2)

	(exit :list :lisp_list '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :list :lisp_merge)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r12, :d0-:d15

	(vp-rdef (iter_begin iter_end dlist) '(:r10 :r11))
	(vp-rdef (this args) '(:r12 :r1))

	(entry :list :lisp_merge `(,this ,args))

	(errorif-lisp-args-sig 'error :r1 2)

	(array-bind-args args `(,dlist ,args))
	(class/array/get_both args iter_begin iter_end)
	(vpif `(,iter_begin /= ,iter_end))
		(call :list :set_cap `(,dlist (,args +array_length)) `(,dlist))
		(loop-start)
			(d-call :list :find `(,dlist (,iter_begin 0) 0) `(,dlist ,args tmp))
			(vp-add-cr +ptr_size iter_begin)
			(vpif `(,tmp = -1))
				(class/obj/ref args tmp)
				(call :list :push_back `(,dlist ,args) `(,dlist _ _ _))
			(endif)
		(loop-until `(,iter_begin = ,iter_end))
	(endif)
	(class/obj/ref dlist args)

	(exit :list :lisp_merge `(,this ,dlist))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(merge dlist slist)" +error_msg_wrong_types))
	(signature '(:list :list))

(def-func-end)

(def-method :list :lisp_pivot)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	;error is the value local, used to hold the first error the compare
	;function throws
	(structure pdata 0
		(ptr this func params error))

	;the first four of the frame are a pdata, the callback is given it
	(structure slot 0
		(ptr this func)
		(union
			(ptr args)
			(ptr params))
		(ptr value list)
		(pptr iter_begin liter)
		(int start end))

	(structure cb 0
		(ptr pdata)
		(union
			(pptr liter)
			(ptr value))
		(union
			(pptr hiter)
			(long result)))

	(vp-alloc slot_size)
	(entry :list :lisp_pivot '((:rsp slot_this) (:rsp slot_args)))

	(errorif-lisp-args-sig 'error1 :r1 4)

	(call :list :get_begin '(:r1) '(_ :r1))
	(load-fields :r1 (list 0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r2 :r3 :r4 :r5))
	(save-fields :rsp '(slot_func slot_list) '(:r2 :r3))
	(call :num :get_value '(:r4) '(_ :r4))
	(call :num :get_value '(:r5) '(_ :r5))
	(save-fields :rsp '(slot_start slot_end) '(:r4 :r5))
	(d-call :array :get_length '(:r3) '(_ :r1))
	(gotoif '(:r4 < 0) 'error2)
	(gotoif '(:r4 >= :r5) 'error2)
	(gotoif '(:r5 > :r1) 'error2)

	(call :list :create :nil '(:r0))
	(vp-xor-rr :r1 :r1)
	(save-fields :rsp '(slot_params slot_value) '(:r0 :r1))
	(call :list :get_iter '((:rsp slot_list) (:rsp slot_start)) '(_ :r1))
	(assign '(:r1) '((:rsp slot_liter)))
	(call :list :get_iter '((:rsp slot_list) (:rsp slot_end)) '(_ :r2))
	(call :list :pivot '((:rsp slot_list) (:rsp slot_liter) :r2 ($ callback) :rsp) '(_ :r1))
	(assign '(:r1 (:rsp slot_value)) '((:rsp slot_liter) :r0))
	(gotoif '(:r0 /= 0) 'error3)
	(call :list :get_begin '((:rsp slot_list)) '(_ :r0))
	(assign '((:rsp slot_liter)) '(:r1))
	(vp-sub-rr :r0 :r1)
	(vp-shr-cr (log2 +ptr_size) :r1)
	(call :num :create '(:r1) '((:rsp slot_value)))
	(call :list :deref '((:rsp slot_params)))
	;the other tasks of the node have a turn if this one's slice is up, a
	;sort is many of these
	(call :sys_task :slice)

	(exit :list :lisp_pivot '((:rsp slot_this) (:rsp slot_value)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error1)
	(assign '((:rsp slot_args)) '(:r1))
	(vp-free slot_size)
	(jump :lisp :repl_error '(:r1 "(pivot lambda list start end)" +error_msg_wrong_types))
(vp-label 'error2)
	(assign '((:rsp slot_args)) '(:r1))
	(vp-free slot_size)
	(jump :lisp :repl_error '(:r1 "(pivot lambda list start end)" +error_msg_not_valid_index))
(vp-label 'error3)
	;the compare function threw, pass its error on
	(call :list :deref '((:rsp slot_params)))
	(exit :list :lisp_pivot '((:rsp slot_this) (:rsp slot_value)))
	(vp-free slot_size)
	(vp-ret)
	(signature '(:obj :LIST :NUM :NUM))

(vp-label 'callback)
	(entry :array :sort_callback '(:r0 :r1 :r2))
	(vp-alloc cb_size)
	(save-fields :rsp '(cb_pdata cb_hiter) '(:r0 :r2))

	(call :obj :ref '((:r1 0)) '(:r0))
	(assign '(:r0 (:rsp cb_hiter)) '((:rsp cb_liter) :r1))
	(call :obj :ref '((:r1 0)) '(:r0))
	(assign '(:r0 (:rsp cb_pdata)) '((:rsp cb_hiter) :r0))
	(d-call :list :clear '((:r0 pdata_params)))
	(assign '((:rsp cb_pdata)) '(:r0))
	(call :list :push_back2 '((:r0 pdata_params) (:rsp cb_liter) (:rsp cb_hiter)))
	(assign '((:rsp cb_pdata)) '(:r2))
	(call :lisp :repl_apply '((:r2 pdata_this) (:r2 pdata_params) (:r2 pdata_func)) '(_ :r1))
	(assign '(:r1) '((:rsp cb_value)))
	;the first error the compare throws is kept, to be passed on
	(assign '((:rsp cb_pdata)) '(:r0))
	(assign '((:r0 pdata_this)) '(:r2))
	(assign '((:r1 +obj_vtable) (:r2 +lisp_error) (:r0 pdata_error)) '(:r3 :r4 :r5))
	(vpif '(:r3 = :r4) '(:r5 = 0))
		(call :obj :ref '(:r1))
		(load-fields :rsp '(cb_pdata cb_value) '(:r0 :r1))
		(assign '(:r1) '((:r0 pdata_error)))
	(endif)
	(vp-xor-rr :r0 :r0)
	(assign '(:r0) '((:rsp cb_result)))
	(call :obj :inst_of `((:rsp cb_value) (@ ,(f-path :num :vtable))) '(val tmp))
	(vpif `(,tmp /= 0))
		(call :num :get_value `(,val) '(_ :r1))
		(assign '(:r1) '((:rsp cb_result)))
	(endif)
	(call :obj :deref `(,val))

	(exit :array :sort_callback '((:rsp cb_result)))
	(vp-free cb_size)
	(vp-ret)

(def-func-end)

(def-method :list :lisp_match)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6

	(vp-rdef (this args src iter_begin iter_end iter_start wild_card))

	(entry :list :lisp_match `(,this ,args))

	(errorif-lisp-args-sig 'error1 :r1 2)

	(assign `((,this +lisp_sym_underscore)) `(,wild_card))
	(array-bind-args args `(,src ,args))
	(assign `((,src +array_length) (,args +array_length)) `(,iter_end ,iter_begin))
	(vpif `(,iter_begin = ,iter_end))
		(assign `((,src +array_begin) (,args +array_begin)) `(,iter_begin ,iter_start))
		(vp-shl-cr (log2 +ptr_size) iter_end)
		(vp-add-rr iter_begin iter_end)
		(vpif `(,iter_begin /= ,iter_end))
			(loop-start)
				(assign `((,iter_begin 0) (,iter_start 0)) `(,src ,args))
				(vp-simd vp-add-cr `(,+ptr_size) `(,iter_begin ,iter_start))
				(vpif `(,src /= ,args))
					(gotoif `(,args /= ,wild_card) 'nomatch)
				(endif)
			(loop-until `(,iter_begin = ,iter_end))
		(endif)
		(assign `((,this +lisp_sym_t)) `(,args))
	(else)
	(vp-label 'nomatch)
		(assign `((,this +lisp_sym_nil)) `(,args))
	(endif)
	(class/obj/ref args iter_start)

	(exit :list :lisp_match `(,this ,args))
	(vp-ret)

(vp-label 'error1)
	(jump :lisp :repl_error `(,args "(lmatch? list list)" +error_msg_wrong_types))
	(signature '(:LIST :LIST))

(def-func-end)

(def-method :list :lisp_copy)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r4, :r6-:r13, :d0-:d15

	(entry :list :lisp_copy '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 1)

	(vp-push :r0)
	(array-bind-args :r1 '(:r0))
	(call :obj :inst_of `(:r0 (@ ,(f-path :list :vtable))) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		(call :list :copy '(:r0) '(_ :r1))
	(else)
		(vp-cpy-rr :r0 :r1)
		(class/obj/ref :r1 :r2)
	(endif)
	(vp-pop :r0)

	(exit :list :lisp_copy '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(copy form)" +error_msg_wrong_num_of_args))

(def-func-end)
