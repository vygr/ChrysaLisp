(include "lib/asm/func.inc")
(include "sys/kernel/class.inc")
(include "./class.inc")
(include "././out/class.inc")
(include "././list/class.inc")
(include "././in/class.inc")

(gen-create :stdio)
	;inputs
	;none
	;outputs
	;:r0 = 0 if error, else stdio object (ptr)
	;trashes
	;:r0-:r6, :r14, :f0-:f15
(gen-vtable :stdio)
(gen-type :stdio)
	;inputs
	;:r0 = stdio object (ptr)
	;outputs
	;:r0 = stdio object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r5, :f0-:f15

(def-method :stdio :init)
	;inputs
	;:r0 = stdio object (ptr)
	;:r1 = vtable (pptr)
	;outputs
	;:r0 = stdio object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r6, :r14, :f0-:f15

	(def-vars
		(ptr this msg data)
		(union
			(ptr vtable)
			(long ok)))

	;read init args
	(push-scope)
	(entry :stdio :init (vpx this vtable))

	;init parent
	(s-call :stdio :init (vpx this vtable) (vpx _ ok))
	(vpif (vpx ok))
		;init myself
		(call :sys_mail :mymail :nil (vpx msg data))
		(vpif (vpx (.> msg +msg_length)))
			;create stdin, stdout, stderr
			;stdin has its own mailbox, leaving the task mailbox free
			(call :in :create (vpx 0) (vpx (.> this +stdio_stdin)))
			(call :out :create
				(vpx (. (.> data +stdio_msg_init_stdout) +net_id_mbox_id)
				(. (.> data +stdio_msg_init_stdout) +net_id_node_id +node_id_node1)
				(. (.> data +stdio_msg_init_stdout) +net_id_node_id +node_id_node2))
				(vpx (.> this +stdio_stdout)))
			(call :out :create
				(vpx (. (.> data +stdio_msg_init_stderr) +net_id_mbox_id)
				(. (.> data +stdio_msg_init_stderr) +net_id_node_id +node_id_node1)
				(. (.> data +stdio_msg_init_stderr) +net_id_node_id +node_id_node2))
				(vpx (.> this +stdio_stderr)))

			;create args string
			(call :str :create_from_buffer (vpx (& (.> data +stdio_msg_init_args)) (- (.> msg +msg_length) +stdio_msg_init_size)) (vpx (.> this +stdio_args)))

			;send back ack with stdin mailbox
			(assign (vpx (. (.> data +stdio_msg_init_ack) +net_id_mbox_id)
					(. (.> data +stdio_msg_init_ack) +net_id_node_id +node_id_node1)
					(. (.> data +stdio_msg_init_ack) +net_id_node_id +node_id_node2))
				(vpx (. (.> msg +msg_dest) +net_id_mbox_id)
					(. (.> msg +msg_dest) +net_id_node_id +node_id_node1)
					(. (.> msg +msg_dest) +net_id_node_id +node_id_node2)))
			(assign (vpx (.> this +stdio_stdin +in_mbox_id))
				(vpx (. (.> data +stdio_msg_init_stdout) +net_id_mbox_id)))
			(call :sys_kernel :id :nil
				(vpx (. (.> data +stdio_msg_init_stdout) +net_id_node_id +node_id_node1)
				(. (.> data +stdio_msg_init_stdout) +net_id_node_id +node_id_node2)))
			(assign (vpx +stdio_msg_init_reply) (vpx (.> msg +msg_length)))
			(call :sys_mail :send (vpx msg))
		(else)
			;abort
			(call :sys_mail :free (vpx msg))
			(s-call :stdio :deinit (vpx this))
			(assign (vpx 0) (vpx ok))
		(endif)
	(endif)

	(exit :stdio :init (vpx this ok))
	(pop-scope)
	(return)

(def-func-end)

(def-method :stdio :deinit)
	;inputs
	;:r0 = stdio object (ptr)
	;outputs
	;:r0 = stdio object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this))

	(entry :stdio :deinit `(,this))

	;flush remaining stdout, stderr
	(vp-push this)
	(call :out :flush `((,this +stdio_stderr)))

	;send stopping on stderr, and on stdout. Each is a stream of its own,
	;and what reads them, a pipe, has them in whatever order they come.
	;With no word that the stderr had no more to say, a pipe took the
	;stdout stopping for the end of the command, and what the command had
	;said on its stderr, the error it ended with, came after that now and
	;then and was lost
	(assign '((:rsp 0)) `(,this))
	(call :out :set_state `((,this +stdio_stderr) +stream_mail_state_stopping) `(,this))
	(assign '((:rsp 0)) `(,this))
	(call :out :set_state `((,this +stdio_stdout) +stream_mail_state_stopping) `(,this))

	;free stdin, stdout and stderr
	(assign '((:rsp 0)) `(,this))
	(call :in :deref `((,this +stdio_stdin)))
	(assign '((:rsp 0)) `(,this))
	(call :out :deref `((,this +stdio_stdout)))
	(assign '((:rsp 0)) `(,this))
	(call :out :deref `((,this +stdio_stderr)))

	;free args
	(assign '((:rsp 0)) `(,this))
	(call :list :deref `((,this +stdio_args)))
	(vp-pop this)

	;deinit parent
	(s-jump :stdio :deinit `(,this))

(def-func-end)
