(include "lib/asm/func.inc")
(include "sys/kernel/class.inc")
(include "./class.inc")
(include "././out/class.inc")
(include "././list/class.inc")
(include "././in/class.inc")

(gen-create :stdio)
	;inputs
	;none
	;outputs
	;:r0 = 0 if error, else stdio object (ptr)
	;trashes
	;:r0-:r6, :r14, :d0-:d15
(gen-vtable :stdio)
(gen-type :stdio)
	;inputs
	;:r0 = stdio object (ptr)
	;outputs
	;:r0 = stdio object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :stdio :init)
	;inputs
	;:r0 = stdio object (ptr)
	;:r1 = vtable (pptr)
	;outputs
	;:r0 = stdio object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r6, :r14, :d0-:d15

	(structure slot 0
		(ptr this msg data)
		(union
			(ptr vtable)
			(long ok)))

	;read init args
	(vp-alloc slot_size)
	(entry :stdio :init '((:rsp slot_this) (:rsp slot_vtable)))

	;init parent
	(s-call :stdio :init '(:r0 :r1) '(_ :r1))
	(assign '(:r1) '((:rsp slot_ok)))
	(vpif '(:r1 /= 0))
		;init myself
		(call :sys_mail :mymail :nil '(:r0 :r1))
		(save-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
		(assign '((:r0 +msg_length)) '(:r2))
		(vpif '(:r2 /= 0))
			;create stdin, stdout, stderr
			;stdin has its own mailbox, leaving the task mailbox free
			(call :in :create '(0) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0 (:rsp slot_data)) '((:r1 +stdio_stdin) :r3))
			(load-net-id :r3 +stdio_msg_init_stdout :r0 :r1 :r2)
			(call :out :create '(:r0 :r1 :r2) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0 (:rsp slot_data)) '((:r1 +stdio_stdout) :r3))
			(load-net-id :r3 +stdio_msg_init_stderr :r0 :r1 :r2)
			(call :out :create '(:r0 :r1 :r2) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0) '((:r1 +stdio_stderr)))

			;create args string
			(load-fields :rsp '(slot_msg slot_data) '(:r1 :r0))
			(assign '((:r1 +msg_length)) '(:r1))
			(vp-sub-cr +stdio_msg_init_size :r1)
			(vp-add-cr +stdio_msg_init_args :r0)
			(call :str :create_from_buffer '(:r0 :r1) '(:r1))
			(assign '((:rsp slot_this)) '(:r0))
			(assign '(:r1) '((:r0 +stdio_args)))

			;send back ack with stdin mailbox
			(load-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
			(assign-net-id :r1 +stdio_msg_init_ack :r0 +msg_dest :r2 :r3 :r4)
			(assign '((:rsp slot_this)) '(:r0))
			(assign '((:r0 +stdio_stdin)) '(:r0))
			(assign '((:r0 +in_mbox_id)) '(:r0))
			(assign '(:r0) `((:r1 ,(+ +stdio_msg_init_stdout +net_id_mbox_id))))
			(call :sys_kernel :id :nil '(:r0 :r1))
			(assign '((:rsp slot_data)) '(:r2))
			(save-node-id :r2 (+ +stdio_msg_init_stdout +net_id_node_id) :r0 :r1)
			(assign `((:rsp slot_msg) ,+stdio_msg_init_reply) '(:r0 :r1))
			(assign '(:r1) '((:r0 +msg_length)))
			(call :sys_mail :send '(:r0))
		(else)
			;abort
			(call :sys_mail :free '(:r0))
			(s-call :stdio :deinit '((:rsp slot_this)))
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:rsp slot_ok)))
		(endif)
	(endif)

	(exit :stdio :init '((:rsp slot_this) (:rsp slot_ok)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :stdio :deinit)
	;inputs
	;:r0 = stdio object (ptr)
	;outputs
	;:r0 = stdio object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(vp-rdef (this))

	(entry :stdio :deinit `(,this))

	;flush remaining stdout, stderr
	(vp-push this)
	(call :out :flush `((,this +stdio_stderr)))

	;send stopping on stderr, and on stdout. Each is a stream of its own,
	;and what reads them, a pipe, has them in whatever order they come.
	;With no word that the stderr had no more to say, a pipe took the
	;stdout stopping for the end of the command, and what the command had
	;said on its stderr, the error it ended with, came after that now and
	;then and was lost
	(assign '((:rsp 0)) `(,this))
	(call :out :set_state `((,this +stdio_stderr) +stream_mail_state_stopping) `(,this))
	(assign '((:rsp 0)) `(,this))
	(call :out :set_state `((,this +stdio_stdout) +stream_mail_state_stopping) `(,this))

	;free stdin, stdout and stderr
	(assign '((:rsp 0)) `(,this))
	(call :in :deref `((,this +stdio_stdin)))
	(assign '((:rsp 0)) `(,this))
	(call :out :deref `((,this +stdio_stdout)))
	(assign '((:rsp 0)) `(,this))
	(call :out :deref `((,this +stdio_stderr)))

	;free args
	(assign '((:rsp 0)) `(,this))
	(call :list :deref `((,this +stdio_args)))
	(vp-pop this)

	;deinit parent
	(s-jump :stdio :deinit `(,this))

(def-func-end)
