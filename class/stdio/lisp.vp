(include "lib/asm/func.inc")
(include "./class.inc")
(include "././lisp/class.inc")

(def-method :stdio :lisp_create)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15

	(structure slot 0
		(ptr this val stdin stdout stderr))

	(entry :stdio :lisp_create '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(call :stdio :create :nil '(:r0))
	(vpif '(:r0 = 0))
		(assign '((:rsp slot_this)) '(:r0))
		(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r1))
	(else)
		;redirect lisp io
		(assign '((:rsp slot_this) :r0 :r0) '(:r5 :r6 (:rsp slot_val)))
		(assign '((:r5 +lisp_stdin) (:r5 +lisp_stdout) (:r5 +lisp_stderr)) '(:r0 :r1 :r2))
		(assign '(:r0 :r1 :r2) '((:rsp slot_stdin) (:rsp slot_stdout) (:rsp slot_stderr)))
		(call :obj :ref '((:r6 +stdio_stdin)) '((:r5 +lisp_stdin)))
		(call :obj :ref '((:r6 +stdio_stdout)) '((:r5 +lisp_stdout)))
		(call :obj :ref '((:r6 +stdio_stderr)) '((:r5 +lisp_stderr)))
		(call :obj :deref '((:rsp slot_stdin)))
		(call :obj :deref '((:rsp slot_stdout)))
		(call :obj :deref '((:rsp slot_stderr)))
		(assign '((:rsp slot_val)) '(:r1))
	(endif)

	(exit :stdio :lisp_create '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(create-stdio)" +error_msg_wrong_types))

(def-func-end)
