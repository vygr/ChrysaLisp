(include "lib/asm/func.inc")
(include "././num/class.inc")
(include "././lisp/class.inc")

(def-method :seq :lisp_pling)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3, :r14, :f0-:f15

	(entry :seq :lisp_pling '(:r3 :r1))

	(call :num :create '((:r0 +lisp_seq_idx)) '(:r1))

	(exit :seq :lisp_pling '(:r3 :r1))
	(vp-ret)

(def-func-end)

(def-method :seq :lisp_each)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this seqs func args)
		(int dir end)
		(uint old_idx))

	;func, seqs and this are where :list :collect leaves them, and value
	;where a deref and :list :min_length do, so the loop reads each from
	;the stack the once, after the apply, that leaves nothing
	(vp-rdef (dir idx end func seqs this value old_idx vt1 vt2)
		'(:r8 :r9 :r10 :r7 :r12 :r13 :r6))

	(push-scope)
	(entry :seq :lisp_each (vpx this seqs))

(errorif-lisp-args-sig 'error1 :r1 2 4)
(assign '((:r1 +array_begin)) '(:r1))
(assign `((:r1 +ptr_size)) '(:r1))
(errorif-lisp-args-type 'error1 :r1 :seq 0)

	(assign (vpx seqs) '(:r1))
	(load-fields :r1 '(+array_length +array_begin) '(:r2 :r0))
	(assign '(0 -1) `(,idx ,end))
	(array-get-args :r0 `(,func ,seqs))
	(vpif '(:r2 > 2))
		(array-get-args :r0 `(_ _ ,idx))
		(list-cast-args `(,idx) '(:num))
	(endif)
	(vpif '(:r2 > 3))
		(array-get-args :r0 `(_ _ _ ,end))
		(list-cast-args `(,end) '(:num))
	(endif)
	(call :obj :ref (vpx (.> this +lisp_sym_nil)) `(,value))

	(call :list :min_length `(,seqs) '(_ len))
	(seq-elem-index idx len)
	(seq-elem-index end len)

(gotoif `(,idx < 0) 'error2)
(gotoif `(,end < 0) 'error2)
(gotoif `(,idx > ,len) 'error2)
(gotoif `(,end > ,len) 'error2)

	(vpif `(,idx /= ,end))
		(vp-cpy-cr 1 dir)
		(vpif `(,idx > ,end))
			(vp-simd vp-sub-rr `(,dir) `(,idx ,end))
			(vp-cpy-cr -1 dir)
		(endif)

		(assign (vpx this) `(,this))
		(assign `(,dir ,end ,func ,seqs) (vpx dir end func seqs))
		(assign `((,this +lisp_seq_idx)) `(,old_idx))
		(assign `(,idx) `((,this +lisp_seq_idx)))
		(assign `(,old_idx) (vpx old_idx))

		;the one list of args for every time round, while nothing but this
		;holds it
		(call :list :create :nil '(:r0))
		(assign '(:r0) (vpx args))

		(loop-start)
			;discard old value, get new value of function call
			(bind '(%0 %1 %2) (method-input :lisp :repl_apply))
			(call :obj :deref `(,value))
			(assign (vpx args) '(:r0))
			(call :list :collect `(:r0 ,seqs (,this +lisp_seq_idx)) `(,%1))
			(call :lisp :repl_apply `(,this ,%1 ,func) `(_ ,value))
			;if what was called kept the args, it is the value of (list),
			;they are its now and the next time round has a list of its
			;own. If not they are emptied and used again
			(assign (vpx args) '(:r0))
			(assign '((:r0 +obj_count)) '(:r1))
			(vpif '(:r1 = 1))
				;emptied here, an element that lives on let go of with no
				;call, and the place in registers a deref leaves
				(class/array/get_both :r0 :r3 :r5)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1) '((:r0 +array_length)))
				(vpif '(:r3 /= :r5))
					(loop-start)
						(assign '((:r3 0)) '(:r1))
						(class/obj/deref-live :r1 :r2 'args_last)
					(vp-label 'args_next)
						(vp-add-cr +ptr_size :r3)
					(loop-until '(:r3 = :r5))
				(endif)
			(else)
				(call :obj :deref '(:r0))
				(call :list :create :nil '(:r0))
				(assign '(:r0) (vpx args))
			(endif)
			(assign (vpx this dir end func seqs) `(,this ,dir ,end ,func ,seqs))

		(assign `((,this +lisp_error) (,value +obj_vtable)) `(,vt1 ,vt2))
		(breakif `(,vt1 = ,vt2))

			(assign `((,this +lisp_seq_idx)) `(,idx))
			(vp-add-rr dir idx)
			(assign `(,idx) `((,this +lisp_seq_idx)))
		(loop-until `(,idx = ,end))

		(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
		(call :obj :deref (vpx args))
	(endif)

	(assign (vpx this) '(:r0))
	(exit :seq :lisp_each `(:r0 ,value))
	(return)

(vp-label 'args_last)
	;the last ref of one of the args, it is destroyed
	(call :obj :deref '(:r1))
	(vp-jmp 'args_next)

(vp-label 'error1)
	(jump :lisp :repl_error (vpx seqs "(each! lambda seqs [start end])" +error_msg_wrong_types))
(vp-label 'error2)
	(call :obj :deref `(,value))
	(jump :lisp :repl_error (vpx seqs "(each! lambda seqs [start end])" +error_msg_not_valid_index))
	(signature '(:obj :LIST :NUM :NUM))

	(pop-scope-syms)

(def-func-end)

(def-method :seq :lisp_some)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this seqs mode func args)
		(int dir end)
		(uint old_idx))

	;func, seqs and this are where :list :collect leaves them, and value
	;where a deref and :list :min_length do, so the loop reads each from
	;the stack the once, after the apply, that leaves nothing
	(vp-rdef (dir idx end mode func seqs this value old_idx vt1 vt2)
		'(:r8 :r9 :r10 :r11 :r7 :r12 :r13 :r6))

	(push-scope)
	(entry :seq :lisp_some (vpx this seqs))

(errorif-lisp-args-sig 'error1 :r1 2 5)
(assign '((:r1 +array_begin)) '(:r1))
(assign `((:r1 +ptr_size)) '(:r1))
(errorif-lisp-args-type 'error1 :r1 :seq 0)

	(assign (vpx (.> this +lisp_sym_nil) seqs) `(,mode :r1))
	(load-fields :r1 '(+array_length +array_begin) '(:r2 :r0))
	(assign '(0 -1) `(,idx ,end))
	(array-get-args :r0 `(,func ,seqs))
	(vpif '(:r2 > 2))
		(array-get-args :r0 `(_ _ ,mode))
	(endif)
	(vpif '(:r2 > 3))
		(array-get-args :r0 `(_ _ _ ,idx))
		(list-cast-args `(,idx) '(:num))
	(endif)
	(vpif '(:r2 > 4))
		(array-get-args :r0 `(_ _ _ _ ,end))
		(list-cast-args `(,end) '(:num))
	(endif)
	(call :obj :ref `(,mode) `(,value))

	(call :list :min_length `(,seqs) '(_ len))
	(seq-elem-index idx len)
	(seq-elem-index end len)

(gotoif `(,idx < 0) 'error2)
(gotoif `(,end < 0) 'error2)
(gotoif `(,idx > ,len) 'error2)
(gotoif `(,end > ,len) 'error2)

	(vpif `(,idx /= ,end))
		(vp-cpy-cr 1 dir)
		(vpif `(,idx > ,end))
			(vp-simd vp-sub-rr `(,dir) `(,idx ,end))
			(vp-cpy-cr -1 dir)
		(endif)

		(assign (vpx this) `(,this))
		(assign `(,dir ,end ,mode ,func ,seqs) (vpx dir end mode func seqs))
		(assign `((,this +lisp_seq_idx)) `(,old_idx))
		(assign `(,idx) `((,this +lisp_seq_idx)))
		(assign `(,old_idx) (vpx old_idx))

		;the one list of args for every time round, while nothing but this
		;holds it
		(call :list :create :nil '(:r0))
		(assign '(:r0) (vpx args))

		(loop-start 'exit)
			;discard old value, get new value of function call
			(bind '(%0 %1 %2) (method-input :lisp :repl_apply))
			(call :obj :deref `(,value))
			(assign (vpx args) '(:r0))
			(call :list :collect `(:r0 ,seqs (,this +lisp_seq_idx)) `(,%1))
			(call :lisp :repl_apply `(,this ,%1 ,func) `(_ ,value))
			;if what was called kept the args, it is the value of (list),
			;they are its now and the next time round has a list of its
			;own. If not they are emptied and used again
			(assign (vpx args) '(:r0))
			(assign '((:r0 +obj_count)) '(:r1))
			(vpif '(:r1 = 1))
				;emptied here, an element that lives on let go of with no
				;call, and the place in registers a deref leaves
				(class/array/get_both :r0 :r3 :r5)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1) '((:r0 +array_length)))
				(vpif '(:r3 /= :r5))
					(loop-start)
						(assign '((:r3 0)) '(:r1))
						(class/obj/deref-live :r1 :r2 'args_last)
					(vp-label 'args_next)
						(vp-add-cr +ptr_size :r3)
					(loop-until '(:r3 = :r5))
				(endif)
			(else)
				(call :obj :deref '(:r0))
				(call :list :create :nil '(:r0))
				(assign '(:r0) (vpx args))
			(endif)
			(assign (vpx this mode dir end func seqs) `(,this ,mode ,dir ,end ,func ,seqs))

		(assign `((,this +lisp_error) (,value +obj_vtable)) `(,vt1 ,vt2))
		(breakif `(,vt1 = ,vt2))

			;break out based on mode and new value
			(assign `((,this +lisp_sym_nil)) `(,vt1))
			(vpif `(,vt1 /= ,mode))
				(breakif `(,vt1 = ,value) 'exit)
			(else)
				(breakif `(,vt1 /= ,value) 'exit)
			(endif)

			(assign `((,this +lisp_seq_idx)) `(,idx))
			(vp-add-rr dir idx)
			(assign `(,idx) `((,this +lisp_seq_idx)))
		(loop-until `(,idx = ,end))

		(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
		(call :obj :deref (vpx args))
	(endif)

	(assign (vpx this) '(:r0))
	(exit :seq :lisp_some `(:r0 ,value))
	(return)

(vp-label 'args_last)
	;the last ref of one of the args, it is destroyed
	(call :obj :deref '(:r1))
	(vp-jmp 'args_next)

(vp-label 'error1)
	(jump :lisp :repl_error (vpx seqs "(some! lambda seqs [mode start end])" +error_msg_wrong_types))
(vp-label 'error2)
	(call :obj :deref `(,value))
	(jump :lisp :repl_error (vpx seqs "(some! lambda seqs [mode start end])" +error_msg_not_valid_index))
	(signature '(:obj :LIST :obj :NUM :NUM))

	(pop-scope-syms)

(def-func-end)

(def-method :seq :lisp_map)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this seqs func args out)
		(int dir end)
		(uint old_idx))

	;func, seqs and this are where :list :collect leaves them, and value
	;where a deref and a push do, so the loop reads each from the stack
	;the once, after the apply, that leaves nothing
	(vp-rdef (dir idx end func seqs this value old_idx vt1 vt2)
		'(:r8 :r9 :r10 :r7 :r12 :r13 :r4))

	(push-scope)
	(entry :seq :lisp_map (vpx this seqs))

(errorif-lisp-args-sig 'error1 :r1 2 5)
(assign '((:r1 +array_begin)) '(:r1))
(assign `((:r1 +ptr_size)) '(:r1))
(errorif-lisp-args-type 'error1 :r1 :seq 0)

	(assign (vpx seqs) '(:r1))
	(load-fields :r1 '(+array_length +array_begin) '(:r2 :r0))
	(assign '(0 -1) `(,idx ,end))
	(array-get-args :r0 `(,func ,seqs))
	(vpif '(:r2 > 2))
		(array-get-args :r0 `(_ _ ,idx))
		(list-cast-args `(,idx) '(:num))
	(endif)
	(vpif '(:r2 > 3))
		(array-get-args :r0 `(_ _ _ ,end))
		(list-cast-args `(,end) '(:num))
	(endif)
	(vpif '(:r2 > 4))
		(array-get-args :r0 `(_ _ _ _ :r0))
		(class/obj/ref :r0 :r1)
	(else)
		(call :list :create :nil '(:r0))
	(endif)
	(assign '(:r0) (vpx out))

	(call :list :min_length `(,seqs) '(_ len))
	(seq-elem-index idx len)
	(seq-elem-index end len)

(gotoif `(,idx < 0) 'error2)
(gotoif `(,end < 0) 'error2)
(gotoif `(,idx > ,len) 'error2)
(gotoif `(,end > ,len) 'error2)

	(vpif `(,idx /= ,end))
		(vp-cpy-cr 1 dir)
		(vpif `(,idx > ,end))
			(vp-simd vp-sub-rr `(,dir) `(,idx ,end))
			(vp-cpy-cr -1 dir)
		(endif)

		(assign (vpx this) `(,this))
		(assign `(,dir ,end ,func ,seqs) (vpx dir end func seqs))
		(assign `((,this +lisp_seq_idx)) `(,old_idx))
		(assign `(,idx) `((,this +lisp_seq_idx)))
		(assign `(,old_idx) (vpx old_idx))

		(assign (vpx out) '(:r0))
		(assign '((:r0 +array_length)) '(:r1))
		(vp-cpy-rr end :r2)
		(vp-sub-rr idx :r2)
		(vp-mul-rr dir :r2)
		(vp-add-rr :r2 :r1)
		(call :list :set_cap '(:r0 :r1))

		;the one list of args for every time round, while nothing but this
		;holds it
		(call :list :create :nil '(:r0))
		(assign '(:r0) (vpx args))

		(loop-start)
			;get new value of function call
			(bind '(%0 %1 %2) (method-input :lisp :repl_apply))
			(assign (vpx args) '(:r0))
			(call :list :collect `(:r0 ,seqs (,this +lisp_seq_idx)) `(,%1))
			(call :lisp :repl_apply `(,this ,%1 ,func) `(_ ,value))
			;if what was called kept the args, it is the value of (list),
			;they are its now and the next time round has a list of its
			;own. If not they are emptied and used again
			(assign (vpx args) '(:r0))
			(assign '((:r0 +obj_count)) '(:r1))
			(vpif '(:r1 = 1))
				;emptied here, an element that lives on let go of with no
				;call, and the place in registers a deref leaves
				(class/array/get_both :r0 :r3 :r5)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1) '((:r0 +array_length)))
				(vpif '(:r3 /= :r5))
					(loop-start)
						(assign '((:r3 0)) '(:r1))
						(class/obj/deref-live :r1 :r2 'args_last)
					(vp-label 'args_next)
						(vp-add-cr +ptr_size :r3)
					(loop-until '(:r3 = :r5))
				(endif)
			(else)
				(call :obj :deref '(:r0))
				(call :list :create :nil '(:r0))
				(assign '(:r0) (vpx args))
			(endif)
			(assign (vpx this) `(,this))

		(assign `((,value +obj_vtable) (,this +lisp_error)) `(,vt1 ,vt2))
		(gotoif `(,vt1 = ,vt2) 'error3)

			;collect value of function call
			(assign (vpx out) '(:r0))
			(call :list :push_back `(:r0 ,value))

			(assign (vpx dir end func seqs) `(,dir ,end ,func ,seqs))
			(assign `((,this +lisp_seq_idx)) `(,idx))
			(vp-add-rr dir idx)
			(assign `(,idx) `((,this +lisp_seq_idx)))
		(loop-until `(,idx = ,end))

		(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
		(call :obj :deref (vpx args))
	(endif)

	(exit :seq :lisp_map (vpx this out))
	(return)

(vp-label 'args_last)
	;the last ref of one of the args, it is destroyed
	(call :obj :deref '(:r1))
	(vp-jmp 'args_next)

(vp-label 'error1)
	(jump :lisp :repl_error (vpx seqs "(map! lambda seqs [start end out])" +error_msg_wrong_types))
(vp-label 'error2)
	(call :obj :deref (vpx out))
	(jump :lisp :repl_error (vpx seqs "(map! lambda seqs [start end out])" +error_msg_not_valid_index))
(vp-label 'error3)
	;the function threw, put the outer loop index back as a normal exit does
	(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
	(call :obj :deref (vpx args))
	(call :obj :deref (vpx out))
	(exit :seq :lisp_map `(,this ,value))
	(return)
	(signature '(:obj :LIST :NUM :NUM :list))

	(pop-scope-syms)

(def-func-end)

(def-method :seq :lisp_reduce)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this seqs func args)
		(int dir end)
		(uint old_idx))

	;func, seqs and this are where :list :collect leaves them, and value
	;where a deref and :list :min_length do, so the loop reads each from
	;the stack the once, after the apply, that leaves nothing
	(vp-rdef (dir idx end func seqs this value old_idx vt1 vt2)
		'(:r8 :r9 :r10 :r7 :r12 :r13 :r6))

	(push-scope)
	(entry :seq :lisp_reduce (vpx this seqs))

(errorif-lisp-args-sig 'error1 :r1 3 5)
(assign '((:r1 +array_begin)) '(:r1))
(assign `((:r1 +ptr_size)) '(:r1))
(errorif-lisp-args-type 'error1 :r1 :seq 0)

	(assign (vpx seqs) '(:r0))
	(load-fields :r0 '(+array_length +array_begin) '(:r2 :r0))
	(assign '(0 -1) `(,idx ,end))
	(array-get-args :r0 `(,func ,seqs ,value))
	(vpif '(:r2 > 3))
		(array-get-args :r0 `(_ _ _ ,idx))
		(list-cast-args `(,idx) '(:num))
	(endif)
	(vpif '(:r2 > 4))
		(array-get-args :r0 `(_ _ _ _ ,end))
		(list-cast-args `(,end) '(:num))
	(endif)
	(class/obj/ref value dir)

	(call :list :min_length `(,seqs) `(,seqs len))
	(seq-elem-index idx len)
	(seq-elem-index end len)

(gotoif `(,idx < 0) 'error2)
(gotoif `(,end < 0) 'error2)
(gotoif `(,idx > ,len) 'error2)
(gotoif `(,end > ,len) 'error2)

	(vpif `(,idx /= ,end))
		(vp-cpy-cr 1 dir)
		(vpif `(,idx > ,end))
			(vp-simd vp-sub-rr `(,dir) `(,idx ,end))
			(vp-cpy-cr -1 dir)
		(endif)

		(assign (vpx this) `(,this))
		(assign `(,dir ,end ,func ,seqs) (vpx dir end func seqs))
		(assign `((,this +lisp_seq_idx)) `(,old_idx))
		(assign `(,idx) `((,this +lisp_seq_idx)))
		(assign `(,old_idx) (vpx old_idx))

		;the one list of args for every time round, while nothing but this
		;holds it
		(call :list :create :nil '(:r0))
		(assign '(:r0) (vpx args))

		(loop-start)
			;recycle value as arg 0, get new value of function call
			(bind '(%0 %1 %2) (method-input :lisp :repl_apply))
			(bind '(%3 %4 %5) (method-input :list :collect))
			(assign (vpx args) `(,%3))
			(call :list :push_back `(,%3 ,value) `(,%3 _ _ _))
			(call :list :collect `(,%3 ,seqs (,this +lisp_seq_idx)) `(,%1))
			(call :lisp :repl_apply `(,this ,%1 ,func) `(_ ,value))
			;if what was called kept the args, it is the value of (list),
			;they are its now and the next time round has a list of its
			;own. If not they are emptied and used again
			(assign (vpx args) '(:r0))
			(assign '((:r0 +obj_count)) '(:r1))
			(vpif '(:r1 = 1))
				;emptied here, an element that lives on let go of with no
				;call, and the place in registers a deref leaves
				(class/array/get_both :r0 :r3 :r5)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1) '((:r0 +array_length)))
				(vpif '(:r3 /= :r5))
					(loop-start)
						(assign '((:r3 0)) '(:r1))
						(class/obj/deref-live :r1 :r2 'args_last)
					(vp-label 'args_next)
						(vp-add-cr +ptr_size :r3)
					(loop-until '(:r3 = :r5))
				(endif)
			(else)
				(call :obj :deref '(:r0))
				(call :list :create :nil '(:r0))
				(assign '(:r0) (vpx args))
			(endif)
			(assign (vpx this dir end func seqs) `(,this ,dir ,end ,func ,seqs))

		(assign `((,this +lisp_error) (,value +obj_vtable)) `(,vt1 ,vt2))
		(breakif `(,vt1 = ,vt2))

			(assign `((,this +lisp_seq_idx)) `(,idx))
			(vp-add-rr dir idx)
			(assign `(,idx) `((,this +lisp_seq_idx)))
		(loop-until `(,idx = ,end))

		(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
		(call :obj :deref (vpx args))
	(endif)

	(assign (vpx this) '(:r0))
	(exit :seq :lisp_reduce `(:r0 ,value))
	(return)

(vp-label 'args_last)
	;the last ref of one of the args, it is destroyed
	(call :obj :deref '(:r1))
	(vp-jmp 'args_next)

(vp-label 'error1)
	(jump :lisp :repl_error (vpx seqs "(reduce! lambda seqs init [start end])" +error_msg_wrong_types))
(vp-label 'error2)
	(call :obj :deref `(,value))
	(jump :lisp :repl_error (vpx seqs "(reduce! lambda seqs init [start end])" +error_msg_not_valid_index))
	(signature '(:obj :LIST :obj :NUM :NUM))

	(pop-scope-syms)

(def-func-end)

(def-method :seq :lisp_filter)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this seq func args out)
		(int dir end)
		(uint old_idx))

	;this and value are where a deref, a push and a pop leave them, so
	;the loop reads this from the stack the once, after the apply, that
	;leaves nothing, and value not at all
	(vp-rdef (dir idx end func seq value this old_idx vt1 vt2)
		'(:r8 :r9 :r10 :r11 :r12 :r13 :r7))

	(push-scope)
	(entry :seq :lisp_filter (vpx this seq))

	(errorif-lisp-args-sig 'error1 :r1 2 5)

	(assign (vpx seq) '(:r1))
	(load-fields :r1 '(+array_length +array_begin) '(:r2 :r0))
	(assign '(0 -1) `(,idx ,end))
	(array-get-args :r0 `(,func ,seq))
	(vpif '(:r2 > 2))
		(array-get-args :r0 `(_ _ ,idx))
		(list-cast-args `(,idx) '(:num))
	(endif)
	(vpif '(:r2 > 3))
		(array-get-args :r0 `(_ _ _ ,end))
		(list-cast-args `(,end) '(:num))
	(endif)
	(vpif '(:r2 > 4))
		(array-get-args :r0 `(_ _ _ _ :r0))
		(class/obj/ref :r0 :r1)
	(else)
		(call :list :create :nil '(:r0))
	(endif)
	(assign '(:r0) (vpx out))

	(call :seq :get_length `(,seq) '(_ len))
	(seq-elem-index idx len)
	(seq-elem-index end len)

(gotoif `(,idx < 0) 'error2)
(gotoif `(,end < 0) 'error2)
(gotoif `(,idx > ,len) 'error2)
(gotoif `(,end > ,len) 'error2)

	(vpif `(,idx /= ,end))
		(vp-cpy-cr 1 dir)
		(vpif `(,idx > ,end))
			(vp-simd vp-sub-rr `(,dir) `(,idx ,end))
			(vp-cpy-cr -1 dir)
		(endif)

		(assign (vpx this) `(,this))
		(assign `(,dir ,end ,func ,seq) (vpx dir end func seq))
		(assign `((,this +lisp_seq_idx)) `(,old_idx))
		(assign `(,idx) `((,this +lisp_seq_idx)))
		(assign `(,old_idx) (vpx old_idx))

		(assign (vpx out) '(:r0))
		(assign '((:r0 +array_length)) '(:r1))
		(vp-cpy-rr end :r2)
		(vp-sub-rr idx :r2)
		(vp-mul-rr dir :r2)
		(vp-add-rr :r2 :r1)
		(call :list :set_cap '(:r0 :r1))

		;the one list of args for every time round, while nothing but this
		;holds it
		(call :list :create :nil '(:r0))
		(assign '(:r0) (vpx args))

		(loop-start)
			;get new value of function call
			(bind '(%0 %1 %2) (method-input :lisp :repl_apply))
			(bind '(%3 %4) (method-input :list :push_back))
			;the element first, it is kept where the create leaves it
			(call :seq :ref_elem `(,seq (,this +lisp_seq_idx)) '(_ :r3))
			(assign (vpx args) `(,%3))
			(call :list :push_back `(,%3 :r3) `(,%1 _ _ _))
			(call :lisp :repl_apply `(,this ,%1 ,func) `(_ ,value))
			(assign (vpx this) `(,this))

		(assign `((,this +lisp_error) (,value +obj_vtable)) `(,vt1 ,vt2))
		(gotoif `(,vt1 = ,vt2) 'error3)

			;collect or ignore item
			(assign `((,this +lisp_sym_nil)) `(,vt1))
			(vpif `(,value /= ,vt1))
				(call :list :pop_back (vpx args) `(_ ,%4))
				(assign (vpx out) `(,%3))
				(call :list :push_back `(,%3 ,%4))
			(endif)
			(call :obj :deref `(,value))
			;if what was called kept the args, it is the value of (list),
			;they are its now and the next time round has a list of its
			;own. If not they are emptied and used again
			(assign (vpx args) '(:r0))
			(assign '((:r0 +obj_count)) '(:r1))
			(vpif '(:r1 = 1))
				;emptied here, an element that lives on let go of with no
				;call, and the place in registers a deref leaves
				(class/array/get_both :r0 :r3 :r5)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1) '((:r0 +array_length)))
				(vpif '(:r3 /= :r5))
					(loop-start)
						(assign '((:r3 0)) '(:r1))
						(class/obj/deref-live :r1 :r2 'args_last)
					(vp-label 'args_next)
						(vp-add-cr +ptr_size :r3)
					(loop-until '(:r3 = :r5))
				(endif)
			(else)
				(call :obj :deref '(:r0))
				(call :list :create :nil '(:r0))
				(assign '(:r0) (vpx args))
			(endif)

			(assign (vpx dir end func seq) `(,dir ,end ,func ,seq))
			(assign `((,this +lisp_seq_idx)) `(,idx))
			(vp-add-rr dir idx)
			(assign `(,idx) `((,this +lisp_seq_idx)))
		(loop-until `(,idx = ,end))

		(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
		(call :obj :deref (vpx args))
	(endif)

	(exit :seq :lisp_filter (vpx this out))
	(return)

(vp-label 'args_last)
	;the last ref of one of the args, it is destroyed
	(call :obj :deref '(:r1))
	(vp-jmp 'args_next)

(vp-label 'error1)
	(jump :lisp :repl_error (vpx seq "(filter! lambda seq [start end out])" +error_msg_wrong_types))
(vp-label 'error2)
	(call :obj :deref (vpx out))
	(jump :lisp :repl_error (vpx seq "(filter! lambda seq [start end out])" +error_msg_not_valid_index))
(vp-label 'error3)
	;the function threw, put the outer loop index back as a normal exit does
	(assign (vpx old_idx) (vpx (.> this +lisp_seq_idx)))
	(call :obj :deref (vpx args))
	(call :obj :deref (vpx out))
	(assign (vpx this) '(:r0))
	(exit :seq :lisp_filter `(:r0 ,value))
	(return)
	(signature '(:obj :seq :NUM :NUM :list))

	(pop-scope-syms)

(def-func-end)
