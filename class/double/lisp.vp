(include "lib/asm/func.inc")
(include "./class.inc")
(include "././lisp/class.inc")

;generic double math op
(redefun mathop (%0)
	(entry :double (sym (cat :lisp_ (rest %0))) '(:r0 :r1))
	(gotoif-lisp-args-sig 'error :r1 1)
	(vp-cpy-rr :r0 :r13)
	(assign '((:r1 +array_begin)) '(:r2))
	(call :double %0 '((:r2 0)) '(:r1) :r1)
	(exit :double (sym (cat :lisp_ (rest %0))) '(:r13 :r1))
	(vp-ret))

(def-method :double :lisp_exp)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r13-:r14, :d0-:d15

	(mathop :exp)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(exp double)" +error_msg_wrong_types))
	(signature '(:double))

(def-func-end)

