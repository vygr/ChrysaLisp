(def-method :double :lisp_atan2)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r13-:r14, :d0-:d15
	;info
	;the angle of the point x y, both doubles or both floats

	(entry :double :lisp_atan2 '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2)

	(vp-cpy-rr :r0 :r13)
	(list-bind-args :r1 '(:r2 :r3) '(:obj :obj))
	(assign '((:r2 +obj_vtable) (:r3 +obj_vtable)) '(:r4 :r5))
	(gotoif '(:r4 /= :r5) 'error1)
	(call :double :atan2 '(:r2 :r3) '(:r1) :r2)

	(exit :double :lisp_atan2 '(:r13 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-cpy-rr :r13 :r0)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(atan2 y x)" +error_msg_wrong_types))
	(signature '(:double :double))

(def-func-end)

(def-method :double :lisp_quant)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r13-:r14, :d0-:d15

	(entry :double :lisp_quant '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2)

	(vp-cpy-rr :r0 :r13)
	(list-bind-args :r1 '(:r0 :r1) '(:obj :obj))
	(call :double :quant '(:r0 :r1) '(:r1) :r2)

	(exit :double :lisp_quant '(:r13 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(quant double tol)" +error_msg_wrong_types))
	(signature '(:DOUBLE :DOUBLE))

(def-func-end)
