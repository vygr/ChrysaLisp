(def-method :double :lisp_quant)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r13-:r14, :d0-:d15

	(entry :double :lisp_quant '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2)

	(vp-cpy-rr :r0 :r13)
	(list-bind-args :r1 '(:r0 :r1) '(:obj :obj))
	(call :double :quant '(:r0 :r1) '(:r1) :r2)

	(exit :double :lisp_quant '(:r13 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(quant double tol)" +error_msg_wrong_types))
	(signature '(:DOUBLE :DOUBLE))

(def-func-end)
