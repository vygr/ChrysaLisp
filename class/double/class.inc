(include "././fixed/class.inc")
(include "./struct.inc")

;the real numbers, a double of 64 bits; what comes of it, a float, does
;what a double does at its own width, and overrides it
(def-class :double :fixed
	(dec-method :vtable class/double/vtable)
	(dec-method :type class/double/type :override)
	(dec-method :create class/double/create)
	(dec-method :print class/double/print :override)
	(dec-method :vcreate class/double/create :override)
	(dec-method :random class/double/random :override)
	(dec-method :add class/double/add :override)
	(dec-method :sub class/double/sub :override)
	(dec-method :mul class/double/mul :override)
	(dec-method :div class/double/div :override)
	(dec-method :mod class/double/mod :override)
	(dec-method :min class/double/min :override)
	(dec-method :max class/double/max :override)
	(dec-method :abs class/double/abs :override)
	(dec-method :sign class/double/sign :override)
	(dec-method :neg class/double/neg :override)
	(dec-method :sqrt class/double/sqrt :override)
	(dec-method :sin class/double/sin :override)
	(dec-method :cos class/double/cos :override)
	(dec-method :exp class/double/exp :virtual (:r0) (:r0))
	(dec-method :log class/double/log :virtual (:r0) (:r0))
	(dec-method :tanh class/double/tanh :virtual (:r0) (:r0))
	(dec-method :frac class/double/frac :override)
	(dec-method :floor class/double/floor :override)
	(dec-method :ceil class/double/ceil :override)
	(dec-method :recip class/double/recip :override)
	(dec-method :eq class/double/eq :override)
	(dec-method :ne class/double/ne :override)
	(dec-method :lt class/double/lt :override)
	(dec-method :gt class/double/gt :override)
	(dec-method :le class/double/le :override)
	(dec-method :ge class/double/ge :override)
	(dec-method :quant class/double/quant :final (:r0 :r1) (:r0))
	(dec-method :pow class/double/pow :override)
	(dec-method :lisp_exp class/double/lisp_exp :static (:r0 :r1) (:r0 :r1))
	(dec-method :lisp_log class/double/lisp_log :static (:r0 :r1) (:r0 :r1))
	(dec-method :lisp_tanh class/double/lisp_tanh :static (:r0 :r1) (:r0 :r1))
	(dec-method :lisp_quant class/double/lisp_quant :static (:r0 :r1) (:r0 :r1)))
