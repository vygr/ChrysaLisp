(gen-create :bytes)
	;outputs
	;:r0 = 0 if error, else bytes object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :bytes)
(gen-type :bytes)

(def-method :bytes :set_cap)
	;the set_cap of :array at 1 byte

	(array-set-cap :bytes 1)

(def-func-end)

(def-method :bytes :ref_elem)
	;the ref_elem of :array at 1 byte

	(array-ref-elem :bytes 1)

(def-func-end)

