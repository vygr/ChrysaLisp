(include "lib/asm/func.inc")
(include "./class.inc")
(include "././num/class.inc")
(include "././lisp/class.inc")

(def-method :bytes :lisp_bytes)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;a bytes of the low 1 byte of each number

	(entry :bytes :lisp_bytes '(:r0 :r1))

	(gotoif-lisp-args-match 'error :r1 :num (:r1 +array_length))
	(assign '(:r0 :r1) '(:r6 :r8))
	(call :bytes :create :nil '(:r7))
	(assign '((:r8 +array_length)) '(:r1))
	(assign '(:r1) '((:r7 +array_length)))
	(call :bytes :set_cap '(:r7 :r1) :nil :r2)
	(assign '((:r7 +array_begin)) '(:r5))
	(class/array/get_both :r8 :r3 :r4)
	(vpif '(:r3 /= :r4))
		(loop-start)
			(assign '((:r3 0)) '(:r0))
			(vp-add-cr +ptr_size :r3)
			(vp-add-cr 1 :r5)
			(assign '((:r0 +num_value)) '(:r0))
			(assign '(:r0) (list (array-to 1 :r5 -1)))
		(loop-until '(:r3 = :r4))
	(endif)

	(exit :bytes :lisp_bytes '(:r6 :r7))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(bytes [num ...])" +error_msg_wrong_types))

(def-func-end)
