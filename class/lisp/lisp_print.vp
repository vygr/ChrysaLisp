(include "lib/asm/func.inc")
(include "./class.inc")
(include "././stream/class.inc")

(def-method :lisp :lisp_prin)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :lisp :lisp_prin '(:r0 :r1))

	(class/array/get_both :r1 :r1 :r2)
	(vpif '(:r1 /= :r2))
		;the two iterators are all that is kept
		(vp-push :r1 :r2)
		(loop-start)
			(assign '((:r1 0)) '(:r2))
			(assign `((:r2 +obj_vtable) (@ ,(f-path :str :vtable))) '(:r3 :r4))
			(vpif '(:r3 = :r4))
				(call :stream :write '((:r0 +lisp_stdout) (& :r2 +str_data) (:r2 +str_length)))
				(lisp-this :r0)
			(else)
				(call :lisp :repl_print '(:r0 (:r0 +lisp_stdout) :r2 1) '(:r0))
			(endif)
			(assign `((:rsp ,+ptr_size) (:rsp 0)) '(:r1 :r2))
			(vp-add-cr +ptr_size :r1)
			(breakif '(:r1 = :r2))
			(assign '(:r1) `((:rsp ,+ptr_size)))
		(loop-end)
		(vp-free (* 2 +ptr_size))
	(endif)
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)

	(exit :lisp :lisp_prin '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lisp :lisp_print)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :lisp :lisp_print '(:r0 :r1))

	(vp-push :r1)
	(call :lisp :lisp_prin '(:r0 :r1) '(:r0 :r1))
	;the value takes the slot, the args are only wanted for their length
	(assign '((:rsp 0)) '(:r2))
	(assign '(:r1 (:r2 +array_length)) '((:rsp 0) :r2))
	(vp-push :r2)
	(call :stream :write_char '((:r0 +lisp_stdout) +char_lf))
	(lisp-this :r0)
	(vp-pop :r2)
	(vpif '(:r2 = 0))
		(call :stream :flush '((:r0 +lisp_stdout)))
		(lisp-this :r0)
	(endif)
	(vp-pop :r1)

	(exit :lisp :lisp_print '(:r0 :r1))
	(vp-ret)

(def-func-end)
