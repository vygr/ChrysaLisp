(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././stream/class.inc")
(include "././num/class.inc")

(def-method :lisp :lisp_repl)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	;info
	;an (import) is a repl, in a repl, so this nests. The lisp object is
	;not in the frame, it is fetched again after a call that trashes it.

	(structure local 0
		(ptr args ast value old_name)
		(long char old_line))

	(entry :lisp :lisp_repl '(:r0 :r1))

	(vp-alloc local_size)
	(assign '(:r1) '((:rsp local_args)))

(errorcase
	(assign '((:r1 +array_length)) '(:r2))
	(gotoif '(:r2 /= 2) 'error1)
	(assign '((:r1 +array_begin)) '(:r1))
	(call :obj :inst_of `((:r1 0) (@ ,(f-path :stream :vtable))) '(_ :r1))
	(gotoif '(:r1 = 0) 'error2)
	(assign '((:rsp local_args)) '(:r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(call :obj :inst_of `((:r1 ,+ptr_size) (@ ,(f-path :str :vtable))) '(_ :r1))
	(gotoif '(:r1 = 0) 'error3)
	(lisp-this :r0)
	(assign '((:rsp local_args)) '(:r1)))

	;push old repl info
	;we have refs to the name (from the args), so we DON'T need to manage our use here !
	(assign '((:r1 +array_begin)) '(:r1))
	(assign `((:r1 ,+ptr_size) (:r0 +lisp_stream_name) (:r0 +lisp_stream_line)) '(:r2 :r3 :r4))
	(assign '(:r3 :r4) '((:rsp local_old_name) (:rsp local_old_line)))
	(vp-cpy-cr 1 :r4)
	(assign '(:r2 :r4) '((:r0 +lisp_stream_name) (:r0 +lisp_stream_line)))
	(assign '((:r0 +lisp_sym_nil)) '(:r2))
	(class/obj/ref :r2 :r3)
	(assign '(:r2) '((:rsp local_value)))

	(call :stream :read_char '((:r1 0)) '(_ :r1))
	(loop-while '(:r1 /= -1))
		(assign '(:r1) '((:rsp local_char)))
		(lisp-this :r0)
		(call :stream :flush '((:r0 +lisp_stdout)))
		(lisp-this :r0)
		(call :stream :flush '((:r0 +lisp_stderr)))
		(lisp-this :r0)
		(assign '((:rsp local_args) (:rsp local_char)) '(:r1 :r2))
		(assign '((:r1 +array_begin)) '(:r1))
		(call :lisp :read '(:r0 (:r1 0) :r2) '(:r0 :r1 :r2))
		(assign '(:r1 :r2) '((:rsp local_ast) (:rsp local_char)))
		(call :lisp :repl_expand '(:r0 (& :rsp local_ast)) '(:r0))
		(call :lisp :repl_bind '(:r0 (:rsp local_ast)) '(:r0))
		(call :obj :deref '((:rsp local_value)))
		(lisp-this :r0)
		(call :lisp :repl_eval '(:r0 (:rsp local_ast)) '(_ :r1))
		(assign '(:r1) '((:rsp local_value)))
		(call :obj :deref '((:rsp local_ast)))
		(lisp-this :r0)
		(assign '((:rsp local_args) (:r0 +lisp_stdin)) '(:r1 :r2))
		(assign '((:r1 +array_begin)) '(:r1))
		(assign '((:r1 0)) '(:r1))
		(vpif '(:r1 = :r2))
			(call :lisp :repl_print '(:r0 (:r0 +lisp_stdout) (:rsp local_value) 1) '(:r0))
			(call :stream :write_char '((:r0 +lisp_stdout) +char_lf))
			(lisp-this :r0)
		(endif)
	(errorcase
		(assign '((:rsp local_value)) '(:r1))
		(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r1 :r2))
		(breakif '(:r1 = :r2)))
		(assign '((:rsp local_char)) '(:r1))
	(loop-end)

	;pop old repl info
	(lisp-this :r0)
	(assign '((:rsp local_old_name) (:rsp local_old_line) (:rsp local_value)) '(:r2 :r3 :r1))
	(assign '(:r2 :r3) '((:r0 +lisp_stream_name) (:r0 +lisp_stream_line)))

	(exit :lisp :lisp_repl '(:r0 :r1))
	(vp-free local_size)
	(vp-ret)

(errorcase
(vp-label 'error1)
	(vp-cpy-cr +error_msg_wrong_num_of_args :r3)
	(goto 'error)
(vp-label 'error2)
	(vp-cpy-cr +error_msg_not_a_stream :r3)
	(goto 'error)
(vp-label 'error3)
	(vp-cpy-cr +error_msg_not_a_string :r3)
(vp-label 'error)
	(assign '((:rsp local_args)) '(:r1))
	(vp-free local_size)
	(jump :lisp :repl_error '(:r1 "(repl stream path)" :r3)))

(def-func-end)

(def-method :lisp :lisp_repl_info)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :r11-:r14, :f0-:f15

	(entry :lisp :lisp_repl_info '(:r0 :r1))

	(vp-cpy-rr :r0 :r13)
	(call :obj :ref '((:r0 +lisp_stream_name)) '(:r11))
	(call :num :create '((:r13 +lisp_stream_line)) '(:r12))
	(call :list :create :nil '(:r0))
	(call :list :push_back2 '(:r0 :r11 :r12) '(:r1 _ _ _ _))

	(exit :lisp :lisp_repl_info '(:r13 :r1))
	(vp-ret)

(def-func-end)
