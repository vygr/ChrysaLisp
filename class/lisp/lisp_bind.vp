(include "lib/asm/func.inc")
(include "./class.inc")
(include "././hmap/class.inc")

(def-method :lisp :lisp_env_push)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :r13-:r14, :f0-:f15

	(entry :lisp :lisp_env_push '(:r0 :r1))

	(assign '((:r1 +array_length)) '(:r2))
	(errorif '(:r2 > 1) 'error)
	(vpif '(:r2 = 0))
		(call :lisp :env_push '(:r0) '(:r0 :r1))
		(class/obj/ref :r1 :r2)
	(else)
		(array-bind-args :r1 '(:r13))
	(errorcase
		(assign '((:r13 +obj_vtable)) '(:r3))
		(f-bind :hmap :vtable :r4)
		(gotoif '(:r4 /= :r3) 'error)
		(assign '((:r13 +hmap_parent)) '(:r3))
		(gotoif '(:r3 /= 0) 'error))
		(assign '((:r0 +lisp_environment)) '(:r2))
		(assign '(:r2) '((:r13 +hmap_parent)))
		(class/obj/ref :r13 :r2 2)
		(assign '(:r13 :r13) '((:r0 +lisp_environment) :r1))
	(endif)

	(exit :lisp :lisp_env_push '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(env-push [env])" +error_msg_wrong_types)))

(def-func-end)

(def-method :lisp :lisp_env_pop)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3

	(entry :lisp :lisp_env_pop '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(assign '((:r0 +lisp_environment)) '(:r1))
	(assign '((:r1 +hmap_parent)) '(:r2))
	(errorif '(:r2 = 0) 'error)
	(vp-xor-rr :r3 :r3)
	(assign '(:r3 :r2) '((:r1 +hmap_parent) (:r0 +lisp_environment)))

	(exit :lisp :lisp_env_pop '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(env-pop)" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :lisp :lisp_bind)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :lisp :lisp_bind '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 2)

	(array-bind-args :r1 '(:r1 :r2))
	(jump :lisp :env_bind '(:r0 :r1 :r2))

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(bind (param ...) seq)" +error_msg_wrong_num_of_args)))

(def-func-end)
