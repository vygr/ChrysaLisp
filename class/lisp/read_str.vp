(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././sstream/class.inc")

(def-method :lisp :read_str)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = close char (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = str object (ptr)
	;:r2 = next char (uint)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this stm cc buf bufp bufe c))

	(entry :lisp :read_str `(,this ,stm ,cc))

	(vp-push this stm cc)

	;most strings are whole in the stream's buffer, on one line
	(assign `((,stm +stream_bufp) (,stm +stream_bufe)) `(,bufp ,bufe))
	(assign `(,bufp) `(,buf))
	(loop-start)
		(assign `((,bufp 0 ub)) `(,c))
		(gotoif `(,bufp = ,bufe) 'slow_but_sure)
		(gotoif (list c '= +char_lf) 'slow_but_sure)
		(vp-add-cr +byte_size bufp)
	(loop-until `(,c = ,cc))
	(assign `(,bufp) `((,stm +stream_bufp)))
	(vp-sub-rr buf bufp)
	(vp-sub-cr +byte_size bufp)
	(call :str :create_from_buffer `(,buf ,bufp) '(:r0))

(vp-label 'have_str)
	;the value takes the slot of the close char
	(call :str :unescape '(:r0 :r0) '(_ :r1))
	(assign '(:r1) '((:rsp 0)))
	(call :stream :read_char `((:rsp ,+ptr_size)) '(_ :r2))
	(vp-pop :r0 :r3 :r1)

	(exit :lisp :read_str '(:r0 :r1 :r2))
	(vp-ret)

(vp-label 'slow_but_sure)
	;it runs off the end of the buffer, or the line, so start again, a
	;char at a time, the stream has not been moved on
	(call :str :create_from_buffer '(0 str_gap) '(:r0))
	(call :sstream :create '(:r0) '(:r0))
	(vp-push :r0)
	(call :stream :read_char `((:rsp ,(* 2 +ptr_size))) '(_ :r1))
	(loop-start)
		(assign `((:rsp ,+ptr_size)) '(:r2))
		(breakif '(:r1 = -1) '(:r1 = :r2))
		(vp-push :r1)
		(call :stream :write_char `((:rsp ,+ptr_size) :r1))
		(vp-pop :r2)
		(assign `((:rsp ,(* 3 +ptr_size)) (:rsp ,(* 2 +ptr_size))) '(:r0 :r1))
		(call :lisp :read_char '(:r0 :r1 :r2) '(_ :r1))
	(loop-end)
	(assign '((:rsp 0)) '(:r0))
	(call :sstream :ref_string '(:r0) '(:r0 :r1))
	(assign '(:r1) '((:rsp 0)))
	(call :sstream :destroy '(:r0))
	(vp-pop :r0)
	(goto 'have_str)

(def-func-end)
