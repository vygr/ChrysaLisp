(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "./class.inc")
(include "././stream/class.inc")
(include "././fixed/class.inc")

(def-method :lisp :read_num)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = next char (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = num object (ptr)
	;:r2 = next char (uint)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this stream)
		(pubyte bufp)
		(int char sign)
		(struct buffer 72))

	(vp-rdef (bufp base char num dot bufe))

	(vp-alloc local_size)
	(entry :lisp :read_num `((:rsp local_this) (:rsp local_stream) ,char))
	(assign `(,char ,char) '((:rsp local_char) (:rsp local_sign)))

	(vpif `(,char = +char_minus))
		(call :stream :read_char `((:rsp local_stream)) `(,base ,char))
		(breakif `(,char >= +char_0))
		;a symbol that starts with a minus. No char is pushed back into the
		;stream, not every stream can take that. The rest of the symbol, if
		;there is any, is read, then the minus put in front of it.
		(assign `(,char) '((:rsp local_char)))
		(vpif `(,char > +char_space) `(,char /= +char_lrb) `(,char /= +char_rrb))
			(call :lisp :read_sym '((:rsp local_this) (:rsp local_stream) (:rsp local_char)) '(_ :r1 :r2))
			(assign '(:r1 :r2) '((:rsp local_bufp) (:rsp local_char)))
			(assign '((:r1 +str_length)) '(:r1))
			(call :str :create_from_buffer '(0 (& :r1 1)) '(:r0))
			(assign '(:r0) '((:rsp local_buffer)))
			(assign '((:rsp local_bufp) :r0) '(:r3 :r4))
			(vp-cpy-cr +char_minus :r1)
			(vp-cpy-ri-b :r1 :r4 +str_data)
			(call :sys_mem :copy '((& :r3 +str_data) (& :r4 (inc +str_data)) (:r3 +str_length)))
			(call :sym :intern_str '((:rsp local_buffer)) '(:r0))
			(assign '(:r0) '((:rsp (+ local_buffer +ptr_size))))
			(call :obj :deref '((:rsp local_bufp)))
			(call :obj :deref '((:rsp local_buffer)))
			(assign '((:rsp (+ local_buffer +ptr_size))) '(:r0))
		(else)
			;just the minus
			(call :sym :intern_cstr '("-") '(:r0))
		(endif)
		(goto 'exit)
	(endif)

	(assign '((& :rsp local_buffer)) `(,bufp))
	(loop-start 'num_loop)
		(vpif `(,char >= +char_0))
			(gotoif `(,char <= +char_9) 'valid_digit)
		(endif)
		(vpif `(,char >= +char_a))
			(gotoif `(,char <= +char_z) 'valid_digit)
		(endif)
		(gotoif `(,char = +char_dot) 'valid_digit)
		(breakif `(,char < +char_A))
		(breakif `(,char > +char_Z))
	(vp-label 'valid_digit)
		(assign `(,char) `((,bufp 0 ub)))
		(vp-add-cr 1 bufp)
		(assign `(,bufp) '((:rsp local_bufp)))
		(call :stream :read_char `((:rsp local_stream)) `(_ ,char))
		(assign `((:rsp local_bufp) (& :rsp ,(+ local_buffer 72))) `(,bufp ,bufe))
	(loop-until `(,bufp = ,bufe))
	(assign `(,char) `((:rsp local_char)))
	(vp-xor-rr char char)
	(assign `(,char) `((,bufp 0 ub)))

	;pick base
	(assign `((& :rsp ,(+ local_buffer 2))) `(,bufp))
	(assign `((,bufp -1 ub)) `(,base))
	(vp-or-cr (- (ascii-code "a") (ascii-code "A")) base)
	(vpif `(,base = +char_x))
		(vp-cpy-cr 16 base)
	(elseif `(,base = +char_o))
		(vp-cpy-cr 8 base)
	(elseif `(,base = +char_b))
		(vp-cpy-cr 2 base)
	(else)
		(vp-sub-cr 2 bufp)
		(vp-cpy-cr 10 base)
	(endif)

	;create the number
	(call :sys_str :to_long `(,bufp ,base) `(:r0 ,dot))
	(assign '((:rsp local_sign)) `(,char))
	(vpif `(,char = +char_minus))
		(vp-mul-cr -1 :r0)
	(endif)
	(vpif `(,dot /= 0))
		;there was a fixed point
		(call :fixed :create '(:r0) '(:r0))
	(else)
		;just parsed an int
		(call :num :create '(:r0) '(:r0))
	(endif)
	(call :num :intern '(:r0) '(:r0))

(vp-label 'exit)
	(exit :lisp :read_num `((:rsp local_this) :r0 (:rsp local_char)))
	(vp-free local_size)
	(vp-ret)

(def-func-end)
