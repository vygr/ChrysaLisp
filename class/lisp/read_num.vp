(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "./class.inc")
(include "././stream/class.inc")
(include "././fixed/class.inc")

(def-method :lisp :read_num)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = next char (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = num object (ptr)
	;:r2 = next char (uint)
	;trashes
	;:r1-:r14, :d0-:d15

	;the frame is the buffer, and what the intern of the number, which
	;keeps nothing, is called over. The stream stays in :r0, each read of
	;a char gives it back, and the place in the buffer, its end and the
	;sign are in registers a read of a char leaves
	(structure slot 0
		(ptr this)
		(long char)
		(struct buffer 72))

	(vp-rdef (stream char _ bufp bufe sign))

	(vp-alloc slot_size)
	(entry :lisp :read_num `((:rsp slot_this) ,stream ,char))
	(vp-cpy-rr char sign)

	(vpif `(,char = +char_minus))
		(call :stream :read_char `(,stream) `(,stream ,char))
		(breakif `(,char >= +char_0))
		;a symbol that starts with a minus. No char is pushed back into the
		;stream, not every stream can take that. The rest of the symbol, if
		;there is any, is read, then the minus put in front of it.
		(assign `(,char) '((:rsp slot_char)))
		(vpif `(,char > +char_space) `(,char /= +char_lrb) `(,char /= +char_rrb))
			;the rest in :r13 and the whole in :r14, the intern leaves them
			(call :lisp :read_sym `((:rsp slot_this) ,stream ,char) '(_ :r13 :r2))
			(assign '(:r2 (:r13 +str_length)) '((:rsp slot_char) :r1))
			(call :str :create_from_buffer '(0 (& :r1 1)) '(:r14))
			(vp-cpy-cr +char_minus :r1)
			(vp-store-rrc-b :r1 :r14 +str_data)
			(call :sys_mem :copy `((& :r13 +str_data) (& :r14 ,(inc +str_data)) (:r13 +str_length)))
			(call :sym :intern_str '(:r14) '(:r12))
			(call :obj :deref '(:r13))
			(call :obj :deref '(:r14))
			(vp-cpy-rr :r12 :r0)
		(else)
			;just the minus
			(call :sym :intern_cstr '("-") '(:r0))
		(endif)
		(goto 'exit)
	(endif)

	(assign `((& :rsp slot_buffer) (& :rsp ,(+ slot_buffer 72))) `(,bufp ,bufe))
	(loop-start 'num_loop)
		(vpif `(,char >= +char_0))
			(gotoif `(,char <= +char_9) 'valid_digit)
		(endif)
		(vpif `(,char >= +char_a))
			(gotoif `(,char <= +char_z) 'valid_digit)
		(endif)
		(gotoif `(,char = +char_dot) 'valid_digit)
		(breakif `(,char < +char_A))
		(breakif `(,char > +char_Z))
	(vp-label 'valid_digit)
		(assign `(,char) `((,bufp 0 ub)))
		(vp-add-cr 1 bufp)
		(call :stream :read_char `(,stream) `(,stream ,char))
	(loop-until `(,bufp = ,bufe))
	(assign `(,char) `((:rsp slot_char)))
	(vp-xor-rr char char)
	(assign `(,char) `((,bufp 0 ub)))

	;pick base
	(vp-rdef (bufp base))
	(assign `((& :rsp ,(+ slot_buffer 2))) `(,bufp))
	(assign `((,bufp -1 ub)) `(,base))
	(vp-or-cr (- (ascii-code "a") (ascii-code "A")) base)
	(vpif `(,base = +char_x))
		(vp-cpy-cr 16 base)
	(elseif `(,base = +char_o))
		(vp-cpy-cr 8 base)
	(elseif `(,base = +char_b))
		(vp-cpy-cr 2 base)
	(else)
		(vp-sub-cr 2 bufp)
		(vp-cpy-cr 10 base)
	(endif)

	;create the number, the sign is where the parse leaves it
	(call :sys_str :to_long `(,bufp ,base) '(:r0 :r4))
	(vpif `(,sign = +char_minus))
		(vp-mul-cr -1 :r0)
	(endif)
	(vpif '(:r4 /= 0))
		;there was a fixed point
		(call :fixed :create '(:r0) '(:r0))
	(else)
		;just parsed an int
		(call :num :create '(:r0) '(:r0))
	(endif)
	(call :num :intern '(:r0) '(:r0))

(vp-label 'exit)
	(exit :lisp :read_num `((:rsp slot_this) :r0 (:rsp slot_char)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
