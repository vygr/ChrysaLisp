(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././stream/class.inc")

(def-method :lisp :read_char)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = last char (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = next char (uint)
	;trashes
	;:r1-:r8, :r14, :f0-:f15

	(entry :lisp :read_char '(:r0 :r1 :r2))

	(vp-push :r0)
	(vpif '(:r2 = +char_lf))
		(assign '((:r0 +lisp_stream_line)) '(:r2))
		(vp-add-cr 1 :r2)
		(assign '(:r2) '((:r0 +lisp_stream_line)))
	(endif)
	(call :stream :read_char '(:r1) '(_ :r1))
	(vp-pop :r0)

	(exit :lisp :read_char '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lisp :read)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = next char (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = form object (ptr)
	;:r2 = next char (uint)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this stream list stack)
		(long c))

	(vp-rdef (this stream c item) '(:r0 :r1 :r2 :r1))

	(entry :lisp :read `(,this ,stream ,c))

	(vp-alloc local_size)
	(assign `(,this ,stream ,c) '((:rsp local_this) (:rsp local_stream) (:rsp local_c)))
	(call :list :create :nil '((:rsp local_list)))
	(call :array :create :nil '((:rsp local_stack)))
	(loop-start)
		;skip white space and comments
		(assign '((:rsp local_this) (:rsp local_stream) (:rsp local_c)) `(,this ,stream ,c))
		(loop-start)
			(loop-while `(,c <= +char_space) `(,c /= -1))
				(call :lisp :read_char `(,this ,stream ,c) `(,this ,c))
				(assign '((:rsp local_stream)) `(,stream))
			(loop-end)
			(breakif `(,c /= +char_semi))
			(call 'skip_not `(,stream +char_lf) '(s))
			(call :stream :read_char `(,s) `(,stream ,c))
			(assign '((:rsp local_this)) `(,this))
		(loop-end)
		(assign `(,c) '((:rsp local_c)))

		;what are we reading ?
		(switch)
		(vpcase `(,c = +char_lrb))
			;a new list, it goes in the current one, and becomes it
			(call :lisp :read_char `(,this ,stream ,c) '(_ (:rsp local_c)))
			(call :array :push_back '((:rsp local_stack) (:rsp local_list)))
			(call :list :create :nil '(:r1))
			(assign '((:rsp local_list)) '(:r0))
			(assign '(:r1) '((:rsp local_list)))
			(call :list :push_back '(:r0 :r1))
			(break)
		(vpcase `(,c = +char_rrb))
			;back to the list this one is in
			(call :lisp :read_char `(,this ,stream ,c) '(_ (:rsp local_c)))
		(errorcase
			(assign '((:rsp local_stack)) '(:r0))
			(assign '((:r0 +array_length)) '(:r1))
			(gotoif '(:r1 = 0) 'error1))
			(call :array :pop_back '((:rsp local_stack)) '(_ (:rsp local_list)))
			(break)
		(vpcase `(,c >= +char_0) `(,c <= +char_9))
			(call :lisp :read_num `(,this ,stream ,c) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_double_quote))
			(call :lisp :read_str `(,this ,stream ,c) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_lcb))
			(call :lisp :read_str `(,this ,stream +char_rcb) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_quote))
			(call :lisp :read_quasi `(,this ,stream ,c (,this +lisp_sym_quote)) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_comma))
			(call :lisp :read_quasi `(,this ,stream ,c (,this +lisp_sym_unquote)) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_tick))
			(call :lisp :read_quasi `(,this ,stream ,c (,this +lisp_sym_qquote)) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_tilde))
			(call :lisp :read_quasi `(,this ,stream ,c (,this +lisp_sym_splicing)) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = +char_minus))
			(call :lisp :read_num `(,this ,stream ,c) `(_ ,item ,c))
			(goto 'push_item)
		(vpcase `(,c = -1))
		(errorcase
			(assign '((:rsp local_stack)) '(:r3))
			(assign '((:r3 +array_length)) '(:r3))
			(gotoif '(:r3 /= 0) 'error2))
			(assign `((,this +lisp_sym_nil)) `(,item))
			(class/obj/ref item :r2)
			(goto 'push_item1)
		(default)
			(call :lisp :read_sym `(,this ,stream ,c) `(_ ,item ,c))
		(vp-label 'push_item)
			(assign `(,c) '((:rsp local_c)))
		(vp-label 'push_item1)
			(call :list :push_back `((:rsp local_list) ,item))
		(endswitch)

		;reached start point ?
		(assign '((:rsp local_stack)) '(:r0))
		(assign '((:r0 +array_length)) '(:r0))
	(loop-until '(:r0 = 0))

	;the form read is the one element of the list, it takes the slot of
	;the stream
	(call :list :pop_back '((:rsp local_list)) '(_ (:rsp local_stream)))

(vp-label 'funcexit1)
	(call :list :deref '((:rsp local_list)))
	(call :array :deref '((:rsp local_stack)))
	(assign '((:rsp local_this) (:rsp local_stream) (:rsp local_c)) `(,this ,item ,c))

	(exit :lisp :read `(,this ,item ,c))
	(vp-free local_size)
	(vp-ret)

(errorcase
(vp-label 'error2)
	(call :lisp :repl_error '((:rsp local_list) "missing )" +error_msg_wrong_types) '(_ (:rsp local_stream)))
	(goto 'error)
(vp-label 'error1)
	(call :lisp :repl_error '((:rsp local_list) "unexpected )" +error_msg_wrong_types) '(_ (:rsp local_stream)))
(vp-label 'error)
	;free the whole of the part read form, from its root list,
	;the error holds its own ref to the payload list
	(assign '((:rsp local_stack)) '(:r0))
	(assign '((:r0 +array_length)) '(:r1))
	(vpif '(:r1 /= 0))
		(call :array :get_first '(:r0) '(_ (:rsp local_list)))
	(endif)
	(goto 'funcexit1))

(vp-label 'skip_not)
	(assign '((:r0 +stream_bufp) (:r0 +stream_bufe)) '(:r2 :r3))
	(loop-start)
		(loop-while '(:r2 = :r3))
			(vp-push :r1)
			(assign '(:r2) '((:r0 +stream_bufp)))
			(call :stream :read_next '(:r0) '(:r0 :r4))
			(vp-pop :r1)
			(gotoif '(:r4 = -1) 'funcexit)
			(assign '((:r0 +stream_bufp) (:r0 +stream_bufe)) '(:r2 :r3))
		(loop-end)
		(vp-cpy-ir-ub :r2 0 :r4)
		(breakif '(:r4 = :r1))
		(vp-add-cr +byte_size :r2)
	(loop-end)
	(assign '(:r2) '((:r0 +stream_bufp)))
(vp-label 'funcexit)
	(vp-ret)

(def-func-end)
