(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././hmap/class.inc")

(def-method :lisp :env_push)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = hmap object (ptr)
	;trashes
	;:r1-:r5, :r14, :f0-:f15
	;info
	;the new environment is taken from the chain of empty ones the lisp
	;object keeps, :env_pop puts them there, so most calls of a lambda
	;need not create one.

	(entry :lisp :env_push '(:r0))

	(assign '((:r0 +lisp_env_pool)) '(:r1))
	(vpif '(:r1 = 0))
		(vp-push :r0)
		(call :hmap :create '(1) '(:r1))
		(vp-pop :r0)
	(else)
		(assign '((:r1 +hmap_parent)) '(:r2))
		(assign '(:r2) '((:r0 +lisp_env_pool)))
	(endif)
	;the ref the lisp object had, to the old one, is now the new one's
	(assign '((:r0 +lisp_environment)) '(:r2))
	(assign '(:r2 :r1) '((:r1 +hmap_parent) (:r0 +lisp_environment)))

	(exit :lisp :env_push '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_pop)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = hmap object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;if no other has a ref to the environment, and it is as it was made,
	;a single bucket that has not grown, its keys and values are dropped,
	;in line where they live on, and it goes on the chain of empty ones,
	;the link held as its parent. If not it is given a deref, as before.

	(vp-rdef (this env parent value iter_begin iter_end tmp))

	(entry :lisp :env_pop `(,this))

	(assign `((,this +lisp_environment)) `(,env))
	(assign `((,env +hmap_parent) (,env +obj_count) (,env +array_begin) (& ,env +hmap_elems))
		`(,parent ,value ,iter_begin ,iter_end))
	(assign `(,parent (,env +array_num_buckets)) `((,this +lisp_environment) ,tmp))
	(gotoif `(,value /= 1) 'slow)
	(gotoif `(,iter_begin /= ,iter_end) 'slow)
	(gotoif `(,tmp /= 1) 'slow)
	(assign `((,env +array_length)) `(,iter_end))
	(vpif `(,iter_end /= 0))
		(vp-shl-cr (log2 +ptr_size) iter_end)
		(vp-add-rr iter_begin iter_end)
		(loop-start)
			(assign `((,iter_begin 0)) `(,value))
			(class/obj/deref-live value tmp 'last_ref)
		(vp-label 'derefed)
			(vp-add-cr +ptr_size iter_begin)
		(loop-until `(,iter_begin = ,iter_end))
		(vp-xor-rr value value)
		(assign `(,value) `((,env +array_length)))
	(endif)
	;the ref it had, to its parent, is now the lisp object's
	(assign `((,this +lisp_env_pool)) `(,value))
	(assign `(,value ,env) `((,env +hmap_parent) (,this +lisp_env_pool)))

	(exit :lisp :env_pop `(,this ,parent))
	(vp-ret)

(vp-label 'last_ref)
	;the last ref of a key or value, so a call, and all is trashed
	(vp-push this env parent iter_begin iter_end)
	(call :obj :deref `(,value))
	(vp-pop this env parent iter_begin iter_end)
	(goto 'derefed)

(vp-label 'slow)
	(vp-push this parent)
	(class/obj/ref parent tmp)
	(call :obj :deref `(,env))
	(vp-pop this parent)

	(exit :lisp :env_pop `(,this ,parent))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_bind)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = vars list object (ptr)
	;:r2 = vals seq object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr vars vals value sym)
		(long index_vars index_vals len_vars len_vals state))

	(enums +state 0
		(enum normal optional rest ignore most))

	(entry :lisp :env_bind '(:r0 :r1 :r2))

	;the fresh path, the call of a lambda, see (lisp-bind-fresh)
	(lisp-bind-fresh :nil 'fresh_bail 'not_fresh)
	(exit :lisp :env_bind '(:r0 :r1))
	(vp-ret)
	(lisp-bind-fresh-bail :nil 'fresh_bail 'not_fresh)

(vp-label 'not_fresh)
	;the general code. The lisp object is not in the frame, it stays in
	;:r0 where it can, and is fetched again after a call that trashes it.
	(vp-rdef (this vars state sym index_vars index_vals len tmp tmp2 optn rst ign mst blk))

	(vp-alloc local_size)
	(assign `(,vars ,state) '((:rsp local_vars) (:rsp local_vals)))

(errorcase
	(assign `((,vars +obj_vtable) (@ ,(f-path :list :vtable))) `(,tmp ,tmp2))
	(gotoif `(,tmp /= ,tmp2) 'error1)
	(call :obj :inst_of `(,state (@ ,(f-path :seq :vtable))) `(_ ,tmp))
	(gotoif `(,tmp = 0) 'error2)
	(lisp-this this))

	(assign `((,this +lisp_sym_nil)) `(,tmp))
	(class/obj/ref tmp tmp2)
	(vp-xor-rr tmp2 tmp2)
	(assign `(,tmp ,tmp2 ,tmp2 ,tmp2)
		'((:rsp local_value) (:rsp local_index_vars) (:rsp local_index_vals) (:rsp local_state)))
	(call :seq :get_length '((:rsp local_vals)) `(_ ,tmp))
	(assign '((:rsp local_vars)) `(,vars))
	(assign `((,vars +array_length)) `(,len))
	(assign `(,tmp ,len) '((:rsp local_len_vals) (:rsp local_len_vars)))
	(lisp-this this)

	(loop-start 'next_bind)
		(assign '((:rsp local_index_vars) (:rsp local_len_vars)) `(,index_vars ,len))
		(breakif `(,index_vars = ,len))
		;next symbol and state
		(assign '((:rsp local_vars) (:rsp local_state)) `(,vars ,state))
		(load-fields this
			'(+lisp_sym_optional +lisp_sym_rest +lisp_sym_ignore +lisp_sym_most +lisp_sym_ampersand)
			`(,optn ,rst ,ign ,mst ,blk))
		(assign `((,vars +array_begin)) `(,vars))
		(vp-cpy-rr index_vars sym)
		(vp-shl-cr (log2 +ptr_size) sym)
		(vp-cpy-dr vars sym sym)
		(switch)
		(gotoif `(,sym = ,ign) 'funcexit)
		(vpcase `(,sym = ,blk))
			;skip a value
			(assign '((:rsp local_index_vals)) `(,index_vals))
			(vp-add-cr 1 index_vars)
			(vp-add-cr 1 index_vals)
			(assign `(,index_vars ,index_vals) '((:rsp local_index_vars) (:rsp local_index_vals)))
			(continue 'next_bind)
		(vpcase `(,sym = ,optn))
			(assign `(,+state_optional) `(,state))
			(goto 'moveon)
		(vpcase `(,sym = ,rst))
			(assign `(,+state_rest) `(,state))
			(goto 'moveon)
		(vpcase `(,sym = ,mst))
			(assign `(,+state_most) `(,state))
		(vp-label 'moveon)
			;the var is the one after
			(vp-add-cr 1 index_vars)
			(breakif `(,index_vars = ,len) 'next_bind)
			(vp-cpy-rr index_vars sym)
			(vp-shl-cr (log2 +ptr_size) sym)
			(vp-cpy-dr vars sym sym)
		(endswitch)
		(vp-add-cr 1 index_vars)
		(assign `(,index_vars ,state ,sym)
			'((:rsp local_index_vars) (:rsp local_state) (:rsp local_sym)))

		;drop the last value bound, the environment has it, so in line
		(assign '((:rsp local_value)) `(,tmp))
		(class/obj/deref-live tmp tmp2 'last_ref)
	(vp-label 'derefed)

		(vp-rdef (this vals state sym tmp index_vals len tmp2 tmp3))
		(assign '((:rsp local_vals) (:rsp local_index_vals) (:rsp local_len_vals))
			`(,vals ,index_vals ,len))
		(assign `((,sym +obj_vtable) (@ ,(f-path :sym :vtable))) `(,tmp ,tmp2))
		(vpif `(,tmp = ,tmp2))
			;standard symbol
			(switch)
			(vpcase `(,state = ,+state_optional))
				(gotoif `(,index_vals /= ,len) 'normal)
				(assign `((,this +lisp_sym_nil)) `(,tmp))
				(class/obj/ref tmp tmp2)
				(break)
			(vpcase `(,state = ,+state_rest))
				(assign `(,len) '((:rsp local_index_vals)))
				(call :seq :slice `(,vals ,index_vals ,len) `(,tmp))
				(lisp-this this)
				(break)
			(vpcase `(,state = ,+state_most))
				(vp-xor-rr tmp tmp)
				(assign `(,tmp) '((:rsp local_state)))
				(vp-sub-cr 1 len)
				(vpif `(,index_vals < ,len))
					(assign `(,len) '((:rsp local_index_vals)))
					(call :seq :slice `(,vals ,index_vals ,len) `(,tmp))
				(else)
					(call :seq :slice `(,vals 0 0) `(,tmp))
				(endif)
				(lisp-this this)
				(break)
			(default)
			(vp-label 'normal)
				(errorif `(,index_vals = ,len) 'error)
				(vp-add-cr 1 index_vals)
				(assign `(,index_vals) '((:rsp local_index_vals)))
				(vp-sub-cr 1 index_vals)
				(assign `((,vals +obj_vtable) (@ ,(f-path :list :vtable))) `(,tmp ,tmp2))
				(vpif `(,tmp = ,tmp2))
					;a list, so in line
					(assign `((,vals +array_begin)) `(,tmp))
					(vp-shl-cr (log2 +ptr_size) index_vals)
					(vp-cpy-dr tmp index_vals tmp)
					(class/obj/ref tmp tmp2)
				(else)
					(call :seq :ref_elem `(,vals ,index_vals) `(_ ,tmp))
					(lisp-this this)
				(endif)
			(endswitch)
			(assign `(,tmp) '((:rsp local_value)))
			(call :hmap :pinsert `((,this +lisp_environment) (:rsp local_sym) ,tmp))
			(lisp-this this)
		(else)
			;destructureing ?
		(errorcase
			(f-bind :list :vtable tmp2)
			(gotoif `(,tmp /= ,tmp2) 'error1))
			(errorif `(,index_vals = ,len) 'error)
			(vp-add-cr 1 index_vals)
			(assign `(,index_vals) '((:rsp local_index_vals)))
			(vp-sub-cr 1 index_vals)
			(call :seq :ref_elem `(,vals ,index_vals) `(_ ,tmp))
			(lisp-this this)
			;the sym slot now holds the seq to destructure
			(assign '((:rsp local_sym)) `(,sym))
			(assign `(,tmp) '((:rsp local_sym)))
			(call :lisp :env_bind `(,this ,sym ,tmp) `(_ ,tmp))
			(assign `(,tmp) '((:rsp local_value)))
			(call :obj :deref '((:rsp local_sym)))
			(lisp-this this)
		(errorcase
			(assign '((:rsp local_value)) `(,tmp))
			(assign `((,tmp +obj_vtable) (,this +lisp_error)) `(,tmp ,tmp2))
			(gotoif `(,tmp = ,tmp2) 'funcexit))
		(endif)
	(loop-end)

(errorcase
	(assign '((:rsp local_index_vals) (:rsp local_len_vals)) '(:r1 :r2))
	(gotoif '(:r1 /= :r2) 'error4))

(vp-label 'funcexit)
	(assign '((:rsp local_value)) '(:r1))
	(exit :lisp :env_bind '(:r0 :r1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'last_ref)
	;the last ref of the last value, so a call, and all is trashed
	(call :obj :deref '(:r7))
	(lisp-this :r0)
	(assign '((:rsp local_sym) (:rsp local_state)) '(:r3 :r2))
	(goto 'derefed)

(errorcase
(vp-label 'error1)
	(assign '((:rsp local_vars)) '(:r1))
	(vp-free local_size)
	(jump :lisp :repl_error '(:r1 "(bind (param ...) seq)" +error_msg_not_a_list))
(vp-label 'error2)
	(assign '((:rsp local_vals)) '(:r1))
	(vp-free local_size)
	(jump :lisp :repl_error '(:r1 "(bind (param ...) seq)" +error_msg_not_a_sequence))
(vp-label 'error4)
	(call :obj :deref '((:rsp local_value)))
(vp-label 'error)
	(call :list :create :nil '(:r0))
	(assign '((:rsp local_vars) (:rsp local_vals)) '(:r1 :r2))
	(class/obj/ref :r1 :r3)
	(class/obj/ref :r2 :r3)
	(call :list :push_back2 '(:r0 :r1 :r2) '(:r0 _ _ _ _))
	(vp-free local_size)
	(jump :lisp :repl_error '(:r0 "(bind (param ...) seq)" +error_msg_wrong_num_of_args)))

(def-func-end)
