(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././hmap/class.inc")

(def-method :lisp :env_push)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = hmap object (ptr)
	;trashes
	;:r1-:r5, :r14, :f0-:f15
	;info
	;the new environment is taken from the chain of empty ones the lisp
	;object keeps, :env_pop puts them there, so most calls of a lambda
	;need not create one.

	(entry :lisp :env_push '(:r0))

	(assign '((:r0 +lisp_env_pool)) '(:r1))
	(vpif '(:r1 = 0))
		(vp-push :r0)
		(call :hmap :create '(1) '(:r1))
		(vp-pop :r0)
	(else)
		(assign '((:r1 +hmap_parent)) '(:r2))
		(assign '(:r2) '((:r0 +lisp_env_pool)))
	(endif)
	;the ref the lisp object had, to the old one, is now the new one's
	(assign '((:r0 +lisp_environment)) '(:r2))
	(assign '(:r2 :r1) '((:r1 +hmap_parent) (:r0 +lisp_environment)))

	(exit :lisp :env_push '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_pop)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = hmap object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;if no other has a ref to the environment, and it is as it was made,
	;a single bucket that has not grown, its keys and values are dropped,
	;in line where they live on, and it goes on the chain of empty ones,
	;the link held as its parent. If not it is given a deref, as before.

	(vp-rdef (this env parent value iter_begin iter_end tmp))

	(entry :lisp :env_pop `(,this))

	(assign `((,this +lisp_environment)) `(,env))
	(assign `((,env +hmap_parent) (,env +obj_count) (,env +array_begin) (& ,env +hmap_elems))
		`(,parent ,value ,iter_begin ,iter_end))
	(assign `(,parent (,env +array_num_buckets)) `((,this +lisp_environment) ,tmp))
	(gotoif `(,value /= 1) 'slow)
	(gotoif `(,iter_begin /= ,iter_end) 'slow)
	(gotoif `(,tmp /= 1) 'slow)
	(assign `((,env +array_length)) `(,iter_end))
	(vpif `(,iter_end /= 0))
		(vp-shl-cr (log2 +ptr_size) iter_end)
		(vp-add-rr iter_begin iter_end)
		(loop-start)
			(assign `((,iter_begin 0)) `(,value))
			(class/obj/deref-live value tmp 'last_ref)
		(vp-label 'derefed)
			(vp-add-cr +ptr_size iter_begin)
		(loop-until `(,iter_begin = ,iter_end))
		(vp-xor-rr value value)
		(assign `(,value) `((,env +array_length)))
	(endif)
	;the ref it had, to its parent, is now the lisp object's
	(assign `((,this +lisp_env_pool)) `(,value))
	(assign `(,value ,env) `((,env +hmap_parent) (,this +lisp_env_pool)))

	(exit :lisp :env_pop `(,this ,parent))
	(vp-ret)

(vp-label 'last_ref)
	;the last ref of a key or value, so a call, and all is trashed
	(vp-push this env parent iter_begin iter_end)
	(call :obj :deref `(,value))
	(vp-pop this env parent iter_begin iter_end)
	(goto 'derefed)

(vp-label 'slow)
	(vp-push this parent)
	(class/obj/ref parent tmp)
	(call :obj :deref `(,env))
	(vp-pop this parent)

	(exit :lisp :env_pop `(,this ,parent))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_bind)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = vars list object (ptr)
	;:r2 = vals seq object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this vars vals symbol value args)
		(uint index_vars index_vals len_vars len_vals state))

	(enums +state 0
		(enum normal optional rest ignore most))

	(entry :lisp :env_bind '(:r0 :r1 :r2))

	;the fresh path, the call of a lambda, see (lisp-bind-fresh)
	(lisp-bind-fresh :nil 'fresh_bail 'not_fresh)
	(exit :lisp :env_bind '(:r0 :r1))
	(vp-ret)
	(lisp-bind-fresh-bail :nil 'fresh_bail 'not_fresh)

(vp-label 'not_fresh)
	(push-scope)
	(assign '(:r0 :r1 :r2) {this, vars, vals})

(errorcase
	(gotoif (cat {vars->+obj_vtable /= @} (f-path :list :vtable)) 'error1)
	(call :obj :inst_of (cat {vals, @} (f-path :seq :vtable)) '(_ tmp))
	(gotoif `(,tmp = 0) 'error2))

	;the fast path, a list of plain symbols, bound to a list of as many
	;values, as nearly every call of a lambda is. Anything else, a & symbol,
	;a list to destructure, a count that differs, goes to the general code,
	;which starts again from the first var, to bind one twice does no harm.
	(assign {vars, vals} '(:r1 :r2))
	(assign `((:r2 +obj_vtable) (@ ,(f-path :list :vtable))) '(:r3 :r4))
	(gotoif '(:r3 /= :r4) 'general)
	(assign '((:r1 +array_length) (:r2 +array_length)) '(:r3 :r4))
	(gotoif '(:r3 /= :r4) 'general)
	(vpif '(:r3 /= 0))
		(vp-xor-rr :r5 :r5)
		(assign '(:r3 :r5) {len_vars, index_vars})
		(loop-start)
			(assign '((:r1 +array_begin) (:r2 +array_begin)) '(:r1 :r2))
			(vp-shl-cr (log2 +ptr_size) :r5)
			(vp-cpy-dr :r1 :r5 :r1)
			(vp-cpy-dr :r2 :r5 :r2)
			(assign `((:r1 +obj_vtable) (@ ,(f-path :sym :vtable))) '(:r3 :r4))
			(gotoif '(:r3 /= :r4) 'general)
			(assign '((:r1 +str_data ub)) '(:r3))
			(gotoif '(:r3 = +char_ampersand) 'general)
			(assign {this} '(:r0))
			(assign '(:r2) {value})
			(call :hmap :pinsert '((:r0 +lisp_environment) :r1 :r2))
			(assign {index_vars, len_vars, vars, vals} '(:r5 :r3 :r1 :r2))
			(vp-add-cr 1 :r5)
			(assign '(:r5) {index_vars})
		(loop-until '(:r5 = :r3))
		;the last value bound is what is given back
		(assign {this, value} '(:r0 :r1))
		(class/obj/ref :r1 :r2)
		(exit :lisp :env_bind '(:r0 :r1))
		(return)
	(endif)

(vp-label 'general)
	(assign {+state_normal => index_vars => index_vals} {state})
	(call :obj :ref {this->+lisp_sym_nil} {value})
	(d-call :array :get_length {vars} {_, len_vars})
	(call :seq :get_length {vals} {_, len_vals})
	(loop-start 'next_bind)
		(vp-rdef (this vars state symbol index_vars index_vals len_vars optn rst ign mst blk))
		(assign {index_vars, len_vars} (list index_vars len_vars))
		(breakif `(,index_vars = ,len_vars))

		;next symbol and state
		(assign {this, vars, state} `(,this ,vars ,state))
		(assign `(,index_vars) `(,symbol))
		(load-fields this
			'(+lisp_sym_optional +lisp_sym_rest +lisp_sym_ignore +lisp_sym_most +lisp_sym_ampersand)
			`(,optn ,rst ,ign ,mst ,blk))
		(class/array/get_elem vars symbol symbol this)
		(switch)
		(gotoif `(,symbol = ,ign) 'funcexit)
		(vpcase `(,symbol = ,blk))
			(assign {index_vals} `(,index_vals))
			(vp-simd vp-add-cr '(1) `(,index_vars ,index_vals))
			(assign `(,index_vars ,index_vals) {index_vars, index_vals})
			(breakif `(,index_vars = ,len_vars))
			(continue 'next_bind)
		(vpcase `(,symbol = ,optn))
			(assign `(,+state_optional) `(,state))
			(goto 'moveon)
		(vpcase `(,symbol = ,rst))
			(assign `(,+state_rest) `(,state))
			(goto 'moveon)
		(vpcase `(,symbol = ,mst))
			(assign `(,+state_most) `(,state))
		(vp-label 'moveon)
			(vp-add-cr 1 index_vars)
		(endswitch)
		(breakif `(,index_vars = ,len_vars))
		(assign `(,index_vars ,state) {index_vars, state})

		(call :obj :deref {value})
		(call :list :get_elem {vars, index_vars} {_, symbol})
		(vpif (cat {symbol->+obj_vtable = @} (f-path :sym :vtable)))
			;standard symbol
			(vp-rdef (vals index_vals len_vals value index_vars len_vars state))
			(assign {vals, index_vals, len_vals, state} (list vals index_vals len_vals state))
			(vpif `(,state = ,+state_optional))
				;optional
				(gotoif `(,index_vals /= ,len_vals) 'normal)
				(call :obj :ref {this->+lisp_sym_nil} (list value))
				(assign {index_vals} (list index_vals))
			(elseif `(,state = ,+state_rest))
				;rest
				(call :seq :slice (list vals index_vals len_vals) (list value))
				(assign {len_vals} (list index_vals))
			(elseif `(,state = ,+state_most))
				;most
				(vp-sub-cr 1 len_vals)
				(vpif `(,index_vals < ,len_vals))
					(call :seq :slice (list vals index_vals len_vals) (list value))
					(assign {len_vals - 1} (list index_vals))
				(else)
					(call :seq :slice (list vals 0 0) (list value))
					(assign {index_vals} (list index_vals))
				(endif)
				(assign {+state_normal} {state})
			(else)
				;normal
				(errorif `(,index_vals = ,len_vals) 'error)
			(vp-label 'normal)
				(call :seq :ref_elem (list vals index_vals) (list '_ value))
				(assign {index_vals + 1} (list index_vals))
			(endif)
			(assign {index_vars} (list index_vars))
			(vp-add-cr 1 index_vars)
			(assign (list index_vars index_vals value) {index_vars, index_vals, value})
			(call :hmap :pinsert {this->+lisp_environment, symbol, value})
		(else)
			;destructureing ?
			(errorif (cat {symbol->+obj_vtable /= @} (f-path :list :vtable)) 'error1)
			(errorif {index_vals = len_vals} 'error)
			(call :seq :ref_elem {vals, index_vals} {_, args})
			(assign {index_vars + 1, index_vals + 1} {index_vars, index_vals})
			(call :lisp :env_bind {this, symbol, args} {_, value})
			(call :obj :deref {args})
			(errorif {value->+obj_vtable = this->+lisp_error} 'funcexit)
		(endif)
	(loop-end)
	(errorif {index_vals /= len_vals} 'error4)

(vp-label 'funcexit)
	(exit :lisp :env_bind {this, value})
	(return)

(errorcase
(vp-label 'error1)
	(jump :lisp :repl_error {vars, "(bind (param ...) seq)", +error_msg_not_a_list})
(vp-label 'error2)
	(jump :lisp :repl_error {vals, "(bind (param ...) seq)", +error_msg_not_a_sequence})
(vp-label 'error3)
	(jump :lisp :repl_error {symbol, "(bind (param ...) seq)", +error_msg_not_a_symbol})
(vp-label 'error4)
	(call :obj :deref {value})
(vp-label 'error)
	(call :list :create :nil {value})
	(call :obj :ref {vars})
	(call :obj :ref {vals})
	(call :list :push_back2 {value, vars, vals})
	(jump :lisp :repl_error {value, "(bind (param ...) seq)", +error_msg_wrong_num_of_args}))

	(pop-scope-syms)

(def-func-end)
