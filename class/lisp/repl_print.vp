(include "lib/asm/func.inc")
(include "./class.inc")
(include "././stream/class.inc")

(def-method :lisp :repl_print)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = value (ptr)
	;:r3 = trunc flag (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	;info
	;this nests for each list in a list. Only a list has a frame, and the
	;lisp object is not in it. A quoted form, 'x say, is a jump to print
	;the x.

	(structure local 0
		(ptr stream)
		(pptr iter_begin iter_end)
		(long flag))

	(entry :lisp :repl_print '(:r0 :r1 :r2 :r3))

	(assign `((:r2 +obj_vtable) (@ ,(f-path :list :vtable))) '(:r4 :r5))
	(vpif '(:r4 /= :r5))
		;default to whatever the object does
		(call :obj :print '(:r2 :r1))
		(lisp-this :r0)
		(exit :lisp :repl_print '(:r0))
		(vp-ret)
	(endif)

	;lists
	(vp-alloc local_size)
	(assign '(:r1 :r3 (:r2 +array_length)) '((:rsp local_stream) (:rsp local_flag) :r4))
	(vpif '(:r4 /= 0) 'notquote)
		(array-bind-args :r2 '(:r4))
		(switch)
			(assign '((:r0 +lisp_sym_quote)) '(:r5))
			(nextcaseif '(:r4 /= :r5))
			(vp-cpy-cr +char_quote :r5)
		(else)
			(assign '((:r0 +lisp_func_quote)) '(:r5))
			(nextcaseif '(:r4 /= :r5))
			(vp-cpy-cr +char_quote :r5)
		(else)
			(assign '((:r0 +lisp_sym_qquote)) '(:r5))
			(nextcaseif '(:r4 /= :r5))
			(vp-cpy-cr +char_tick :r5)
		(else)
			(assign '((:r0 +lisp_func_qquote)) '(:r5))
			(nextcaseif '(:r4 /= :r5))
			(vp-cpy-cr +char_tick :r5)
		(else)
			(assign '((:r0 +lisp_sym_unquote)) '(:r5))
			(nextcaseif '(:r4 /= :r5))
			(vp-cpy-cr +char_comma :r5)
		(else)
			(assign '((:r0 +lisp_sym_splicing)) '(:r5))
			(breakif '(:r4 /= :r5) 'notquote)
			(vp-cpy-cr +char_tilde :r5)
		(endswitch)
		;the quote char, then the form quoted
		(vp-push :r2)
		(call :stream :write_char '(:r1 :r5))
		(vp-pop :r2)
		(assign '((:r2 +array_length)) '(:r1))
		(gotoif '(:r1 < 2) 'exit)
		(assign '((:r2 +array_begin)) '(:r2))
		(assign `((:r2 ,+ptr_size)) '(:r2))
		(lisp-this :r0)
		(assign '((:rsp local_stream) (:rsp local_flag)) '(:r1 :r3))
		(vp-free local_size)
		(jump :lisp :repl_print '(:r0 :r1 :r2 :r3))
	(endif)

	(vp-push :r2)
	(call :stream :write_char '(:r1 +char_lrb))
	(vp-pop :r2)
	(class/array/get_both :r2 :r1 :r3)
	(vpif '(:r1 /= :r3))
		(assign '(:r3) '((:rsp local_iter_end)))
		(loop-start)
			(assign '(:r1) '((:rsp local_iter_begin)))
			(lisp-this :r0)
			(assign '((:rsp local_flag)) '(:r2))
			(call 'trunc_func '(:r0 (:r1 0) :r2) '(:r0 :r2))
			(assign '((:rsp local_stream) (:rsp local_flag)) '(:r1 :r3))
			(call :lisp :repl_print '(:r0 :r1 :r2 :r3))
			(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) '(:r1 :r2))
			(vp-add-cr +long_size :r1)
			(breakif '(:r1 = :r2))
			(assign '(:r1) '((:rsp local_iter_begin)))
			(call :stream :write_char '((:rsp local_stream) +char_space))
			(assign '((:rsp local_iter_begin)) '(:r1))
		(loop-end)
	(endif)
	(call :stream :write_char '((:rsp local_stream) +char_rrb))

(vp-label 'exit)
	(lisp-this :r0)
	(exit :lisp :repl_print '(:r0))
	(vp-free local_size)
	(vp-ret)

(vp-label 'trunc_func)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = object (ptr)
	;:r2 = flag (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = object (ptr)
	;trashes
	;:r1-:r5
	(vp-rdef (this obj flag iter_begin iter_end func))
	(vpif `(,flag /= 0))
		(assign `((,obj +obj_vtable) (@ ,(f-path :list :vtable)))
			`(,iter_begin ,iter_end))
		(vpif `(,iter_begin = ,iter_end))
			(class/array/get_both obj iter_begin iter_end)
			(vpif `(,iter_begin /= ,iter_end))
				(array-get-args iter_begin `(,iter_end))
				(assign `((,this +lisp_func_lambda)) `(,func))
				(gotoif `(,iter_end = ,func) 'trunc)
				(assign `((,this +lisp_func_macro)) `(,func))
				(gotoif `(,iter_end = ,func) 'trunc)
				(assign `((,this +lisp_sym_lambda)) `(,func))
				(gotoif `(,iter_end = ,func) 'trunc)
				(assign `((,this +lisp_sym_macro)) `(,func))
				(breakif `(,iter_end /= ,func))
			(vp-label 'trunc)
				(assign `((,this +lisp_sym_trunc)) `(,obj))
			(endif)
		(endif)
	(endif)
	(vp-ret)

(def-func-end)
