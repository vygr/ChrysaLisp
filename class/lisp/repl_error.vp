(include "lib/asm/func.inc")
(include "./class.inc")
(include "././hmap/class.inc")

(def-method :lisp :repl_error)
	;inputs
	;:r1 = error payload object (ptr)
	;:r2 = description c string (pubyte)
	;:r3 = 0, else error msg number (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = error object (ptr)
	;trashes
	;:r1-:r8, :r14, :f0-:f15
	;info
	;the lisp object is the one the task holds, in its tcb. This is cold
	;code, and so a caller need not keep its lisp object to hand, on the
	;stack say, just in case it has an error.

	(entry :lisp :repl_error '(:r1 :r2 :r3))

	(vp-push :r1 :r2 :r3)
	(lisp-this :r0)
	(assign '((:r0 +lisp_sym_stack_frame) (:r0 +lisp_environment)) '(:r1 :r0))
	(call :hmap :search '(:r0 :r1) '(_ :r1 _))
	(vpif '(:r1 /= 0))
		(assign `((:r1 ,+ptr_size)) '(:r6))
		(class/obj/ref :r6 :r1)
	(else)
		(call :list :create :nil '(:r6))
	(endif)
	(lisp-this :r7)
	;payload, description and msg, to where :error :create wants them
	(vp-pop :r2 :r0 :r1)
	(assign '((:r7 +lisp_script_name) (:r7 +lisp_stream_name) (:r7 +lisp_stream_line)) '(:r3 :r4 :r5))
	(call :error :create '(:r0 :r1 :r2 :r3 :r4 :r5 :r6) '(:r1))
	(lisp-this :r0)

	(exit :lisp :repl_error '(:r0 :r1))
	(vp-ret)

(def-func-end)
