(include "lib/asm/func.inc")
(include "sys/task/class.inc")
(include "./class.inc")
(include "././hmap/class.inc")

(def-method :lisp :repl_error)
	;inputs
	;:r0 = any, not used (ptr)
	;:r1 = error payload object (ptr)
	;:r2 = description c string (pubyte)
	;:r3 = 0, else error msg number (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = error object (ptr)
	;trashes
	;:r1-:r9, :r14, :f0-:f15
	;info
	;the lisp object is the one the task holds, in its tcb, not the one
	;given. This is cold code, and so a caller need not keep its lisp
	;object to hand, on the stack say, just in case it has an error.

	(def-vars
		(ptr this payload desc)
		(pptr frame)
		(uint msg))

	(push-scope)
	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_sys_task_current_tcb)) '(:r0))
	(assign '((:r0 +tk_node_lisp)) '(:r0))
	(entry :lisp :repl_error {this, payload, desc, msg})

	(call :hmap :search {this->+lisp_environment, this->+lisp_sym_stack_frame} {_, frame, _})
	(vpif {frame})
		(assign {frame[+ptr_size]} {frame})
		(call :obj :ref {frame})
	(else)
		(call :list :create :nil {frame})
	(endif)

	(call :error :create {desc, msg, payload, this->+lisp_script_name,
		this->+lisp_stream_name, this->+lisp_stream_line, frame} {frame})

	(exit :lisp :repl_error {this, frame})
	(pop-scope)
	(return)

(def-func-end)
