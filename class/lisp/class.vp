(include "lib/asm/func.inc")
(include "./class.inc")
(include "././sstream/class.inc")
(include "././hmap/class.inc")
(include "././func/class.inc")
(include "././fstream/class.inc")

(gen-create :lisp)
	;inputs
	;:r0 = script string object (ptr)
	;:r1 = stdin stream object (ptr)
	;:r2 = stdout stream object (ptr)
	;:r3 = stderr stream object (ptr)
	;outputs
	;:r0 = 0 if error, else lisp object (ptr)
	;trashes
	;:r0-:r14, :d0-:d15
(gen-vtable :lisp)
(gen-type :lisp)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(structure built_in 0
	(ushort symbol)
	(ushort field))

(defun built-in (s f)
	;s = symbol
	;f = field
	(vp-short
		`(- ,(label-sym (string-sym (fn-add-string s))) *pc*) f))

(def-method :lisp :init)
	;inputs
	;:r0 = lisp object object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = script string object (ptr)
	;:r3 = stdin stream object (ptr)
	;:r4 = stdout stream object (ptr)
	;:r5 = stderr stream object (ptr)
	;outputs
	;:r0 = lisp object object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this script stdin stdout stderr)
		(long ok))

	(vp-alloc slot_size)
	(entry :lisp :init '(:r0 :r1 :r2 :r3 :r4 :r5))
	(save-fields :rsp '(slot_this slot_script slot_stdin slot_stdout slot_stderr) '(:r0 :r2 :r3 :r4 :r5))

	;init parent
	(s-call :lisp :init '(:r0 :r1) '(_ :r1))
	(assign '(:r1) '((:rsp slot_ok)))
	(vpif '(:r1 /= 0))
		;init myself
		(load-fields :rsp '(slot_this slot_script) '(:r1 :r2))
		(assign '(:r2) '((:r1 +lisp_script_name)))
		(call :obj :ref '((:rsp slot_stdin)) '(:r0))
		(assign '((:rsp slot_this)) '(:r1))
		(assign '(:r0) '((:r1 +lisp_stdin)))
		(call :obj :ref '((:rsp slot_stdout)) '(:r0))
		(assign '((:rsp slot_this)) '(:r1))
		(assign '(:r0) '((:r1 +lisp_stdout)))
		(call :obj :ref '((:rsp slot_stderr)) '(:r0))
		(assign '((:rsp slot_this)) '(:r1))
		(assign '(:r0) '((:r1 +lisp_stderr)))
		(vp-xor-rr :r0 :r0)
		(assign '(:r0 :r0 :r0 :r0 :r0)
			'((:r1 +lisp_args_pool) (:r1 +lisp_env_pool) (:r1 +lisp_seq_idx) (:r1 +lisp_stream_line) (:r1 +lisp_nextsym)))

		;tls stack, object tls, error vtable
		(fn-bind 'sys/statics/statics :r2)
		(assign '((:r2 statics_sys_task_current_tcb)) '(:r3))
		(assign '(:r1) '((:r3 +tk_node_lisp)))
		(fn-bind 'class/error/vtable :r3)
		(assign '(:r3) '((:r1 +lisp_error)))

		;spin lock if boot env busy
		(loop-start)
			(fn-bind 'sys/statics/statics :r0)
			(assign '((:r0 statics_lisp_root_env)) '(:r0))
			(breakif '(:r0 /= -1))
			(call :sys_task :sleep '(100))
		(loop-end)

		;do we have a shared boot env yet ?
		(vpif '(:r0 = 0))
			;mark as busy
			(fn-bind 'sys/statics/statics :r0)
			(vp-cpy-cr -1 :r1)
			(assign '(:r1) '((:r0 statics_lisp_root_env)))

			;intern standard built in symbols
			;slot caching kills it here, so 1 bucket, no div !
			(call :hmap :create '(1) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0) '((:r1 +lisp_environment)))

			;local defines and symbols
			(call 'create_env_info '((:rsp slot_this)))
			(call 'create_env_funcs '((:rsp slot_this)))

			;run any root.inc
			(call 'import '((:rsp slot_this) "class/lisp/root.inc") '(:r0))
			(assign '(:r0) '((:rsp slot_ok)))
			(vpif '(:r0 = 0))
				;mark as free
				(fn-bind 'sys/statics/statics :r0)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1) '((:r0 statics_lisp_root_env)))
			(vp-label 'error)
				;deinit myself and parent
				(call :lisp :deinit '((:rsp slot_this)))
			(else)
				;save shared boot env
				(assign '((:rsp slot_this)) '(:r0))
				(call :obj :ref '((:r0 +lisp_environment)) '(:r0))
				(fn-bind 'sys/statics/statics :r1)
				(assign '(:r0) '((:r1 statics_lisp_root_env)))
				(goto 'local_env)
			(endif)
		(else)
			;boot env is my parent env
			(fn-bind 'sys/statics/statics :r0)
			(call :obj :ref '((:r0 statics_lisp_root_env)) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0) '((:r1 +lisp_environment)))
		(vp-label 'local_env)
			(call :hmap :create '(19) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(call :hmap :set_parent '(:r0 (:r1 +lisp_environment)) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(assign '(:r0) '((:r1 +lisp_environment)))
			;local defines and symbols
			(call 'create_env_info '((:rsp slot_this)))
			(call 'lookup_env_funcs '((:rsp slot_this)))
			;run any task.inc
			(call 'import '((:rsp slot_this) "class/lisp/task.inc") '(:r0))
			(assign '(:r0) '((:rsp slot_ok)))
			(gotoif '(:r0 = 0) 'error)
			;run any script
			(load-fields :rsp '(slot_this slot_script) '(:r0 :r1))
			(vp-add-cr +str_data :r1)
			(call 'import '(:r0 :r1) '(:r0))
			(assign '(:r0) '((:rsp slot_ok)))
			(gotoif '(:r0 = 0) 'error)
		(endif)
	(endif)

	(exit :lisp :init '((:rsp slot_this) (:rsp slot_ok)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'import)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = file name, or inline text, c string (pubyte)
	;outputs
	;:r0 = 0 if error, else not 0

	(structure slot 0
		(ptr this stream args)
		(pubyte obj)
		(uint is_inline))

	(vp-alloc slot_size)
	(entry '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_obj) '(:r0 :r1))

	;import a file or inline string
	(vp-load-rcr-ub :r1 0 :r2)
	(vpif `(:r2 = ,+char_lrb))
		(vp-cpy-cr 1 :r2)
		(assign '(:r2) '((:rsp slot_is_inline)))
		(call :str :create_from_cstr '(:r1) '(:r0))
		(assign '(:r0) '((:rsp slot_stream)))
		(vpif '(:r0 /= 0))
			(call :sstream :create '(:r0) '(:r0))
			(vpif '(:r0 = 0))
				(call :obj :deref '((:rsp slot_stream)))
				(vp-xor-rr :r0 :r0)
			(endif)
			(assign '(:r0) '((:rsp slot_stream)))
		(endif)
	(else)
		(vp-xor-rr :r2 :r2)
		(assign '(:r2) '((:rsp slot_is_inline)))
		(call :fstream :create `(:r1 ,+file_open_read) '(:r0))
		(assign '(:r0) '((:rsp slot_stream)))
	(endif)
	(assign '((:rsp slot_stream)) '(:r0))
	(vpif '(:r0 /= 0))
		(call :list :create :nil '(:r0))
		(assign '(:r0) '((:rsp slot_args)))
		(load-fields :rsp '(slot_obj slot_is_inline) '(:r0 :r1))
		(vpif '(:r1 /= 0))
			(call :str :create_from_cstr '("(inline)") '(:r0))
		(else)
			(call :str :create_from_cstr '(:r0) '(:r0))
		(endif)
		(call :list :push_back2 '((:rsp slot_args) (:rsp slot_stream) :r0))
		(call :lisp :lisp_repl '((:rsp slot_this) (:rsp slot_args)) '(_ :r1))
		(assign '(:r1 (:rsp slot_this)) '((:rsp slot_obj) :r0))
		(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r2 :r3))
		(vpif '(:r2 = :r3))
			(call :lisp :repl_print '(:r0 (:r0 +lisp_stderr) :r1 1))
			(assign '((:rsp slot_this)) '(:r0))
			(call :stream :write_char `((:r0 +lisp_stderr) ,+char_lf))
			(assign '((:rsp slot_this)) '(:r0))
			(call :stream :flush '((:r0 +lisp_stderr)))
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:rsp slot_stream)))
		(endif)
		(call :obj :deref '((:rsp slot_args)))
		(call :obj :deref '((:rsp slot_obj)))
	(endif)

	(exit '((:rsp slot_stream)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'create_env_info)
	;inputs
	;:r0 = lisp object (ptr)

	(structure slot 0
		(ptr this table))

	(vp-alloc slot_size)
	(entry '(:r0))
	(assign '(($ built_ins)) '(:r1))
	(save-fields :rsp '(slot_this slot_table) '(:r0 :r1))

	;create standard built in symbols
	(loop-start)
		(assign '((:rsp slot_table)) '(:r1))
		(assign '((:r1 built_in_symbol)) '(:r0))
		(breakif '(:r0 = 0))
		(vp-add-rr :r1 :r0)
		(vp-add-cr built_in_symbol :r0)
		(call :sym :intern_cstr '(:r0) '(:r0))
		(load-fields :rsp '(slot_this slot_table) '(:r1 :r2))
		(assign '((:r2 built_in_field)) '(:r3))
		(vp-add-rr :r3 :r1)
		(assign '(:r0) '((:r1 0)))
		(vp-add-cr built_in_size :r2)
		(assign '(:r2) '((:rsp slot_table)))
	(loop-end)

	;defines
	(call :str :create_from_buffer '("ChrysaLisp" 10) '(:r0))
	(assign '((:rsp slot_this)) '(:r1))
	(assign '(:r0) '((:r1 +lisp_stream_name)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'create_env_funcs)
	;inputs
	;:r0 = lisp object (ptr)

	(defmacro env-func (fn func sym)
		;the func of fn, kept in func, and bound to sym in the environment
		`(progn
			(fn-bind (f-path :lisp ,fn) :r0)
			(vp-add-cr +func_type_args_raw :r0)
			(call :func :create '(:r0) '(:r0))
			(assign '((:rsp 0)) '(:r1))
			(assign '(:r0) '((:r1 ,func)))
			(call :hmap :pinsert '((:r1 +lisp_environment) (:r1 ,sym) :r0))))

	(entry '(:r0))
	(vp-push :r0)
	(env-func :lisp_ffi +lisp_func_ffi +lisp_sym_ffi)
	(env-func :lisp_lambda +lisp_func_lambda +lisp_sym_lambda)
	(env-func :lisp_macro +lisp_func_macro +lisp_sym_macro)
	(env-func :lisp_quote +lisp_func_quote +lisp_sym_quote)
	(env-func :lisp_qquote +lisp_func_qquote +lisp_sym_qquote)
	(vp-pop :r0)
	(vp-ret)

(vp-label 'lookup_env_funcs)
	;inputs
	;:r0 = lisp object (ptr)

	(defmacro env-lookup (func sym)
		;func, as sym is bound in the environment
		`(progn
			(assign '((:rsp 0)) '(:r0))
			(call :hmap :get '((:r0 +lisp_environment) (:r0 ,sym)) '(_ :r1))
			(assign '((:rsp 0)) '(:r0))
			(assign '(:r1) '((:r0 ,func)))))

	(entry '(:r0))
	(vp-push :r0)
	(env-lookup +lisp_func_ffi +lisp_sym_ffi)
	(env-lookup +lisp_func_lambda +lisp_sym_lambda)
	(env-lookup +lisp_func_macro +lisp_sym_macro)
	(env-lookup +lisp_func_quote +lisp_sym_quote)
	(env-lookup +lisp_func_qquote +lisp_sym_qquote)
	(vp-pop :r0)
	(vp-ret)

;;;;;;;;;;;
; built ins
;;;;;;;;;;;

	(vp-align +short_size)
(vp-label 'built_ins)
	(built-in "_" +lisp_sym_underscore)
	(built-in "&" +lisp_sym_ampersand)
	(built-in "&optional" +lisp_sym_optional)
	(built-in "&rest" +lisp_sym_rest)
	(built-in "&ignore" +lisp_sym_ignore)
	(built-in "&most" +lisp_sym_most)
	(built-in ":nil" +lisp_sym_nil)
	(built-in ":t" +lisp_sym_t)
	(built-in "lambda" +lisp_sym_lambda)
	(built-in "macro" +lisp_sym_macro)
	(built-in "(...)" +lisp_sym_trunc)
	(built-in "unquote" +lisp_sym_unquote)
	(built-in "unquote-splicing" +lisp_sym_splicing)
	(built-in "quote" +lisp_sym_quote)
	(built-in "quasi-quote" +lisp_sym_qquote)
	(built-in "ffi" +lisp_sym_ffi)
	(built-in "*stack_frame*" +lisp_sym_stack_frame)
	(vp-short 0)

(def-func-end)

(def-method :lisp :deinit)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

	(structure slot 0
		(ptr this)
		(pptr iter))

	(vp-alloc slot_size)
	(entry :lisp :deinit '((:rsp slot_this)))

	;free the chain of args lists, each is empty, and holds the next in
	;its first element
	(loop-start)
		(assign '((:r0 +lisp_args_pool)) '(:r1))
		(breakif '(:r1 = 0))
		(assign '((:r1 +array_begin)) '(:r2))
		(assign '((:r2 0)) '(:r2))
		(assign '(:r2) '((:r0 +lisp_args_pool)))
		(call :obj :deref '(:r1))
		(assign '((:rsp slot_this)) '(:r0))
	(loop-end)

	;and the chain of environments, each is empty, and holds the next as
	;its parent, with no ref
	(loop-start)
		(assign '((:r0 +lisp_env_pool)) '(:r1))
		(breakif '(:r1 = 0))
		(vp-xor-rr :r3 :r3)
		(assign '((:r1 +hmap_parent)) '(:r2))
		(assign '(:r2 :r3) '((:r0 +lisp_env_pool) (:r1 +hmap_parent)))
		(call :obj :deref '(:r1))
		(assign '((:rsp slot_this)) '(:r0))
	(loop-end)

	;deinit myself
	(vp-add-cr +lisp_stdin :r0)
	(assign '(:r0) '((:rsp slot_iter)))
	(loop-start)
		(call :obj :deref '((:r0 0)))
		(load-fields :rsp '(slot_iter slot_this) '(:r0 :r1))
		(vp-add-cr +ptr_size :r0)
		(vp-add-cr +lisp_error :r1)
		(assign '(:r0) '((:rsp slot_iter)))
	(loop-until '(:r0 = :r1))

	;deinit parent
	(assign '((:rsp slot_this)) '(:r0))
	(vp-free slot_size)
	(s-jump :lisp :deinit '(:r0))

(def-func-end)
