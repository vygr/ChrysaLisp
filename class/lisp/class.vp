(include "lib/asm/func.inc")
(include "./class.inc")
(include "././sstream/class.inc")
(include "././hmap/class.inc")
(include "././func/class.inc")
(include "././fstream/class.inc")

(gen-create :lisp)
	;inputs
	;:r0 = script string object (ptr)
	;:r1 = stdin stream object (ptr)
	;:r2 = stdout stream object (ptr)
	;:r3 = stderr stream object (ptr)
	;outputs
	;:r0 = 0 if error, else lisp object (ptr)
	;trashes
	;:r0-:r14, :f0-:f15
(gen-vtable :lisp)
(gen-type :lisp)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r5, :f0-:f15

(structure built_in 0
	(ushort symbol)
	(ushort field))

(defun built-in (s f)
	;s = symbol
	;f = field
	(vp-short
		`(- ,(label-sym (string-sym (fn-add-string s))) *pc*) f))

(def-method :lisp :init)
	;inputs
	;:r0 = lisp object object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = script string object (ptr)
	;:r3 = stdin stream object (ptr)
	;:r4 = stdout stream object (ptr)
	;:r5 = stderr stream object (ptr)
	;outputs
	;:r0 = lisp object object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this vtable script stdin stdout stderr func)
		(long ok))

	(push-scope)
	(entry :lisp :init (vpx this vtable script stdin stdout stderr))

	;init parent
	(s-call :lisp :init (vpx this vtable) (vpx _ ok))
	(vpif (vpx ok))
		;init myself
		(assign (vpx script) (vpx (.> this +lisp_script_name)))
		(call :obj :ref (vpx stdin) (vpx (.> this +lisp_stdin)))
		(call :obj :ref (vpx stdout) (vpx (.> this +lisp_stdout)))
		(call :obj :ref (vpx stderr) (vpx (.> this +lisp_stderr)))
		(assign (vpx 0) (vpx (.> this +lisp_seq_idx)))
		(assign (vpx 0) (vpx (.> this +lisp_stream_line)))
		(assign (vpx 0) (vpx (.> this +lisp_nextsym)))
		(assign (vpx 0) (vpx (.> this +lisp_args_pool)))
		(assign (vpx 0) (vpx (.> this +lisp_env_pool)))

		;tls stack, object tls, error vtable
		(assign (vpx (. (@ sys/statics/statics) statics_sys_task_current_tcb)) (vpx func))
		(assign (vpx this) (vpx (.> func +tk_node_lisp)))
		(assign (vpx (@ class/error/vtable)) (vpx (.> this +lisp_error)))

		;spin lock if boot env busy
		(loop-while (vpx (= (. (@ sys/statics/statics) statics_lisp_root_env) (- 1))))
			(call :sys_task :sleep (vpx 100))
		(loop-end)

		;do we have a shared boot env yet ?
		(vpifnot (vpx (. (@ sys/statics/statics) statics_lisp_root_env)))
			;mark as busy
			(assign (vpx (- 1)) (vpx (. (@ sys/statics/statics) statics_lisp_root_env)))

			;intern standard built in symbols
			;slot caching kills it here, so 1 bucket, no div !
			(call :hmap :create (vpx 1) (vpx (.> this +lisp_environment)))

			;local defines and symbols
			(call 'create_env_info (vpx this))
			(call 'create_env_funcs (vpx this))

			;run any root.inc
			(call 'import (vpx this "class/lisp/root.inc") (vpx ok))
			(vpifnot (vpx ok))
				;mark as free
				(assign (vpx 0) (vpx (. (@ sys/statics/statics) statics_lisp_root_env)))
			(vp-label 'error)
				;deinit myself and parent
				(call :lisp :deinit (vpx this))
			(else)
				;save shared boot env
				(call :obj :ref (vpx (.> this +lisp_environment)) (vpx (. (@ sys/statics/statics) statics_lisp_root_env)))
				(goto 'local_env)
			(endif)
		(else)
			;boot env is my parent env
			(call :obj :ref (vpx (. (@ sys/statics/statics) statics_lisp_root_env)) (vpx (.> this +lisp_environment)))
		(vp-label 'local_env)
			(call :hmap :create (vpx 19) (vpx func))
			(call :hmap :set_parent (vpx func (.> this +lisp_environment)) (vpx (.> this +lisp_environment)))
			;local defines and symbols
			(call 'create_env_info (vpx this))
			(call 'lookup_env_funcs (vpx this))
			;run any task.inc
			(call 'import (vpx this "class/lisp/task.inc") (vpx ok))
			(gotoifnot (vpx ok) 'error)
			;run any script
			(call 'import (vpx this (& (.> script +str_data))) (vpx ok))
			(gotoifnot (vpx ok) 'error)
		(endif)
	(endif)

	(exit :lisp :init (vpx this ok))
	(pop-scope)
	(return)

(vp-label 'import)
	(def-vars
		(ptr this stream args func)
		(pubyte obj)
		(uint is_inline))

	(push-scope)
	(entry (vpx this obj))

	;import a file or inline string
	(assign (vpx 0) (vpx is_inline))
	(vpif (vpx (= (elem obj 0) +char_lrb)))
		(assign (vpx 1) (vpx is_inline))
		(call :str :create_from_cstr (vpx obj) (vpx stream))
		(vpif (vpx stream))
			(call :sstream :create (vpx stream) (vpx func))
			(vpifnot (vpx func))
				(call :obj :deref (vpx stream))
			(endif)
			(assign (vpx func) (vpx stream))
		(endif)
	(else)
		(call :fstream :create (vpx obj +file_open_read) (vpx stream))
	(endif)
	(vpif (vpx stream))
		(call :list :create :nil (vpx args))
		(vpif (vpx is_inline))
			(call :str :create_from_cstr (vpx "(inline)") (vpx obj))
		(else)
			(call :str :create_from_cstr (vpx obj) (vpx obj))
		(endif)
		(call :list :push_back2 (vpx args stream obj))
		(call :lisp :lisp_repl (vpx this args) (vpx _ obj))
		(vpif (vpx (= (.> obj +obj_vtable) (.> this +lisp_error))))
			(call :lisp :repl_print (vpx this (.> this +lisp_stderr) obj 1))
			(call :stream :write_char (vpx (.> this +lisp_stderr) +char_lf))
			(call :stream :flush (vpx (.> this +lisp_stderr)))
			(assign (vpx 0) (vpx stream))
		(endif)
		(call :obj :deref (vpx args))
		(call :obj :deref (vpx obj))
	(endif)

	(exit (vpx stream))
	(pop-scope)
	(return)

(vp-label 'create_env_info)
	(def-vars
		(ptr this symbol table))

	(push-scope)
	(entry (vpx this))

	;create standard built in symbols
	(assign (vpx ($ built_ins)) (vpx table))
	(loop-while (vpx (.> table built_in_symbol)))
		(call :sym :intern_cstr (vpx (+ (& (.> table built_in_symbol)) (.> table built_in_symbol))) (vpx symbol))
		(assign (vpx symbol) (vpx (ptr (+ this (.> table built_in_field)))))
		(assign (vpx (+ table built_in_size)) (vpx table))
	(loop-end)

	;defines
	(call :str :create_from_buffer (vpx "ChrysaLisp" 10) (vpx (.> this +lisp_stream_name)))

	(pop-scope)
	(return)

(vp-label 'create_env_funcs)
	(def-vars
		(ptr this))

	(push-scope)
	(entry (vpx this))

	(call :func :create (vpx (+ (@ ,(f-path :lisp :lisp_ffi)) +func_type_args_raw)) (vpx (.> this +lisp_func_ffi)))
	(call :hmap :pinsert (vpx (.> this +lisp_environment) (.> this +lisp_sym_ffi) (.> this +lisp_func_ffi)))
	(call :func :create (vpx (+ (@ ,(f-path :lisp :lisp_lambda)) +func_type_args_raw)) (vpx (.> this +lisp_func_lambda)))
	(call :hmap :pinsert (vpx (.> this +lisp_environment) (.> this +lisp_sym_lambda) (.> this +lisp_func_lambda)))
	(call :func :create (vpx (+ (@ ,(f-path :lisp :lisp_macro)) +func_type_args_raw)) (vpx (.> this +lisp_func_macro)))
	(call :hmap :pinsert (vpx (.> this +lisp_environment) (.> this +lisp_sym_macro) (.> this +lisp_func_macro)))
	(call :func :create (vpx (+ (@ ,(f-path :lisp :lisp_quote)) +func_type_args_raw)) (vpx (.> this +lisp_func_quote)))
	(call :hmap :pinsert (vpx (.> this +lisp_environment) (.> this +lisp_sym_quote) (.> this +lisp_func_quote)))
	(call :func :create (vpx (+ (@ ,(f-path :lisp :lisp_qquote)) +func_type_args_raw)) (vpx (.> this +lisp_func_qquote)))
	(call :hmap :pinsert (vpx (.> this +lisp_environment) (.> this +lisp_sym_qquote) (.> this +lisp_func_qquote)))

	(pop-scope)
	(return)

(vp-label 'lookup_env_funcs)
	(def-vars
		(ptr this))

	(push-scope)
	(entry (vpx this))

	(call :hmap :get (vpx (.> this +lisp_environment) (.> this +lisp_sym_ffi)) (vpx _ (.> this +lisp_func_ffi)))
	(call :hmap :get (vpx (.> this +lisp_environment) (.> this +lisp_sym_lambda)) (vpx _ (.> this +lisp_func_lambda)))
	(call :hmap :get (vpx (.> this +lisp_environment) (.> this +lisp_sym_macro)) (vpx _ (.> this +lisp_func_macro)))
	(call :hmap :get (vpx (.> this +lisp_environment) (.> this +lisp_sym_quote)) (vpx _ (.> this +lisp_func_quote)))
	(call :hmap :get (vpx (.> this +lisp_environment) (.> this +lisp_sym_qquote)) (vpx _ (.> this +lisp_func_qquote)))

	(pop-scope)
	(return)

;;;;;;;;;;;
; built ins
;;;;;;;;;;;

	(vp-align +short_size)
(vp-label 'built_ins)
	(built-in "_" +lisp_sym_underscore)
	(built-in "&" +lisp_sym_ampersand)
	(built-in "&optional" +lisp_sym_optional)
	(built-in "&rest" +lisp_sym_rest)
	(built-in "&ignore" +lisp_sym_ignore)
	(built-in "&most" +lisp_sym_most)
	(built-in ":nil" +lisp_sym_nil)
	(built-in ":t" +lisp_sym_t)
	(built-in "lambda" +lisp_sym_lambda)
	(built-in "macro" +lisp_sym_macro)
	(built-in "(...)" +lisp_sym_trunc)
	(built-in "unquote" +lisp_sym_unquote)
	(built-in "unquote-splicing" +lisp_sym_splicing)
	(built-in "quote" +lisp_sym_quote)
	(built-in "quasi-quote" +lisp_sym_qquote)
	(built-in "ffi" +lisp_sym_ffi)
	(built-in "*stack_frame*" +lisp_sym_stack_frame)
	(vp-short 0)

(def-func-end)

(def-method :lisp :deinit)
	;inputs
	;:r0 = lisp object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;trashes
	;:r1-:r3, :f0-:f15

	(def-vars
		(ptr this)
		(pptr iter))

	(push-scope)
	(entry :lisp :deinit (vpx this))

	;free the chain of args lists, each is empty, and holds the next in
	;its first element
	(assign (vpx this) '(:r0))
	(loop-start)
		(assign '((:r0 +lisp_args_pool)) '(:r1))
		(breakif '(:r1 = 0))
		(assign '((:r1 +array_begin)) '(:r2))
		(assign '((:r2 0)) '(:r2))
		(assign '(:r2) '((:r0 +lisp_args_pool)))
		(call :obj :deref '(:r1))
		(assign (vpx this) '(:r0))
	(loop-end)

	;and the chain of environments, each is empty, and holds the next as
	;its parent, with no ref
	(loop-start)
		(assign '((:r0 +lisp_env_pool)) '(:r1))
		(breakif '(:r1 = 0))
		(vp-xor-rr :r3 :r3)
		(assign '((:r1 +hmap_parent)) '(:r2))
		(assign '(:r2 :r3) '((:r0 +lisp_env_pool) (:r1 +hmap_parent)))
		(call :obj :deref '(:r1))
		(assign (vpx this) '(:r0))
	(loop-end)

	;deinit myself
	(assign (vpx (& (.> this +lisp_stdin))) (vpx iter))
	(loop-start)
		(call :obj :deref (vpx (* iter)))
	(loop-until (vpx (= (=> (+ iter +ptr_size) iter) (& (.> this +lisp_error)))))

	;deinit parent
	(s-jump :lisp :deinit (vpx this))

	(pop-scope-syms)

(def-func-end)
