(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :lisp :lisp_if)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;only the args are kept, in one slot, over the eval of the test. What
	;follows the test is a jump, with nothing left on the stack.

	(entry :lisp :lisp_if '(:r0 :r1))

	(assign '((:r1 +array_length)) '(:r2))
	(errorif '(:r2 < 3) 'error)

	(vp-push :r1)
	(assign '((:r1 +array_begin)) '(:r1))
	(call :lisp :repl_eval '(:r0 (:r1 +ptr_size)) '(:r0 :r1))
	(vp-pop :r2)
	(assign '((:r0 +lisp_sym_nil)) '(:r3))
	(vpif '(:r1 /= :r3))
	(errorcase
		(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r4 :r5))
		(gotoif '(:r4 = :r5) 'error1))
		(class/obj/deref-live :r1 :r3 'last_ref)
	(vp-label 'derefed)
		(assign '((:r2 +array_begin)) '(:r2))
		(jump :lisp :repl_eval `(:r0 (:r2 ,(* 2 +ptr_size))))
	(endif)

	(class/array/get_both :r2 :r4 :r3)
	(vp-add-cr (* 3 +ptr_size) :r4)
	(jump :lisp :repl_progn '(:r0 :r1 :r4 :r3))

(vp-label 'last_ref)
	;the last ref of the test's value, so a call, and all is trashed
	(vp-push :r2)
	(call :obj :deref '(:r1))
	(vp-pop :r2)
	(lisp-this :r0)
	(goto 'derefed)

(errorcase
(vp-label 'error1)
	(exit :lisp :lisp_if '(:r0 :r1))
	(vp-ret)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(if tst form [else_form ...])" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :lisp :lisp_ifn)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;only the args are kept, in one slot, over the eval of the test. What
	;follows the test is a jump, with nothing left on the stack.

	(entry :lisp :lisp_ifn '(:r0 :r1))

	(assign '((:r1 +array_length)) '(:r2))
	(errorif '(:r2 < 3) 'error)

	(vp-push :r1)
	(assign '((:r1 +array_begin)) '(:r1))
	(call :lisp :repl_eval '(:r0 (:r1 +ptr_size)) '(:r0 :r1))
	(vp-pop :r2)
	(assign '((:r0 +lisp_sym_nil)) '(:r3))
	(vpif '(:r1 = :r3))
		(class/obj/ref :r1 :r3 -1)
		(assign '((:r2 +array_begin)) '(:r2))
		(jump :lisp :repl_eval `(:r0 (:r2 ,(* 2 +ptr_size))))
	(endif)

	(class/array/get_both :r2 :r4 :r3)
	(vp-add-cr (* 3 +ptr_size) :r4)
	(jump :lisp :repl_progn '(:r0 :r1 :r4 :r3))

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(ifn tst form [else_form ...])" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :lisp :lisp_while)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;only the args are kept, in one slot. The lisp object stays in :r0,
	;each eval gives it back.

	(vp-rdef (this args iter_begin iter_end tmp vtable))

	(entry :lisp :lisp_while `(,this ,args))

(errorcase
	(assign `((,args +array_length)) `(,tmp))
	(gotoif `(,tmp < 2) 'error))

	(vp-push args)
	(loop-start)
		(assign `((,args +array_begin)) `(,args))
		(call :lisp :repl_eval `(,this (,args ,+ptr_size)) `(,this ,args))
		(assign `((,this +lisp_sym_nil)) `(,tmp))
		(breakif `(,args = ,tmp))
		(assign '((:rsp 0)) `(,tmp))
		(class/array/get_both tmp iter_begin iter_end)
		(call :lisp :repl_progn `(,this ,args (& ,iter_begin ,(* 2 +ptr_size)) ,iter_end)
			`(,this ,args))
	(errorcase
		(assign `((,args +obj_vtable) (,this +lisp_error)) `(,vtable ,tmp))
		(breakif `(,vtable = ,tmp)))
		(class/obj/deref-live args tmp 'last_ref)
	(vp-label 'derefed)
		(assign '((:rsp 0)) `(,args))
	(loop-end)

	(exit :lisp :lisp_while `(,this ,args))
	(vp-free +ptr_size)
	(vp-ret)

(vp-label 'last_ref)
	;the last ref of the body's value, so a call, and all is trashed
	(call :obj :deref `(,args))
	(lisp-this this)
	(goto 'derefed)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(while tst [body])" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :lisp :lisp_until)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;only the args are kept, in one slot. The lisp object stays in :r0,
	;each eval gives it back.

	(vp-rdef (this args iter_begin iter_end tmp vtable))

	(entry :lisp :lisp_until `(,this ,args))

(errorcase
	(assign `((,args +array_length)) `(,tmp))
	(gotoif `(,tmp < 2) 'error))

	(vp-push args)
	(loop-start)
		(assign `((,args +array_begin)) `(,args))
		(call :lisp :repl_eval `(,this (,args ,+ptr_size)) `(,this ,args))
		(assign `((,this +lisp_sym_nil)) `(,tmp))
		(breakif `(,args /= ,tmp))
		(assign '((:rsp 0)) `(,tmp))
		(class/array/get_both tmp iter_begin iter_end)
		(call :lisp :repl_progn `(,this ,args (& ,iter_begin ,(* 2 +ptr_size)) ,iter_end)
			`(,this ,args))
	(errorcase
		(assign `((,args +obj_vtable) (,this +lisp_error)) `(,vtable ,tmp))
		(breakif `(,vtable = ,tmp)))
		(class/obj/deref-live args tmp 'last_ref)
	(vp-label 'derefed)
		(assign '((:rsp 0)) `(,args))
	(loop-end)

	(exit :lisp :lisp_until `(,this ,args))
	(vp-free +ptr_size)
	(vp-ret)

(vp-label 'last_ref)
	;the last ref of the body's value, so a call, and all is trashed
	(call :obj :deref `(,args))
	(lisp-this this)
	(goto 'derefed)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(until tst [body])" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :lisp :lisp_cond)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;the frame is the two iterators over the clauses, and in a build with
	;error checks the args, to report. The lisp object stays in :r0, each
	;eval gives it back. The body of the clause chosen is a jump, with
	;nothing left on the stack.

	(structure local 0
		(pptr iter_begin iter_end)
		(ptr args))

	(defq frame (if (>= *build_mode* 1) local_size local_args))

	(vp-rdef (this value iter_begin iter_end tmp vtable))

	(entry :lisp :lisp_cond `(,this ,value))

	(vp-alloc frame)
	(errorcase
		(assign `(,value) '((:rsp local_args))))
	(class/array/get_both value iter_begin iter_end)
	(assign `(,iter_end) '((:rsp local_iter_end)))
	(loop-start)
		(vp-add-cr +ptr_size iter_begin)
		(breakif `(,iter_begin = ,iter_end))
		(assign `(,iter_begin) '((:rsp local_iter_begin)))
		(vp-cpy-ir iter_begin 0 value)
	(errorcase
		(assign `((,value +obj_vtable) (@ ,(f-path :list :vtable))) `(,vtable ,tmp))
		(gotoif `(,vtable /= ,tmp) 'error2)
		(assign `((,value +array_length)) `(,tmp))
		(gotoif `(,tmp = 0) 'error1))
		(assign `((,value +array_begin)) `(,tmp))
		(call :lisp :repl_eval `(,this (,tmp 0)) `(,this ,value))
		(assign `((,this +lisp_sym_nil)) `(,tmp))
		(vpif `(,value /= ,tmp))
			(assign '((:rsp local_iter_begin)) `(,tmp))
			(assign `((,tmp 0)) `(,tmp))
			(class/array/get_both tmp iter_begin iter_end)
			(vp-free frame)
			(jump :lisp :repl_progn `(,this ,value (& ,iter_begin ,+ptr_size) ,iter_end))
		(endif)
		(class/obj/ref value tmp -1)
		(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) `(,iter_begin ,iter_end))
	(loop-end)
	(assign `((,this +lisp_sym_nil)) `(,value))
	(class/obj/ref value tmp)

	(exit :lisp :lisp_cond `(,this ,value))
	(vp-free frame)
	(vp-ret)

(errorcase
(vp-label 'error1)
	(assign '((:rsp local_args) +error_msg_wrong_num_of_args) '(:r1 :r3))
	(goto 'error)
(vp-label 'error2)
	(assign '((:rsp local_args) +error_msg_not_a_list) '(:r1 :r3))
(vp-label 'error)
	(vp-free frame)
	(jump :lisp :repl_error '(:r1 "(cond [(tst [body])] ...)" :r3)))

(def-func-end)

(def-method :lisp :lisp_condn)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;the frame is the two iterators over the clauses, and in a build with
	;error checks the args, to report. The lisp object stays in :r0, each
	;eval gives it back. The body of the clause chosen is a jump, with
	;nothing left on the stack.

	(structure local 0
		(pptr iter_begin iter_end)
		(ptr args))

	(defq frame (if (>= *build_mode* 1) local_size local_args))

	(vp-rdef (this value iter_begin iter_end tmp vtable))

	(entry :lisp :lisp_condn `(,this ,value))

	(vp-alloc frame)
	(errorcase
		(assign `(,value) '((:rsp local_args))))
	(class/array/get_both value iter_begin iter_end)
	(assign `(,iter_end) '((:rsp local_iter_end)))
	(assign `((,this +lisp_sym_t)) `(,value))
	(class/obj/ref value tmp)
	(loop-start)
		(vp-add-cr +ptr_size iter_begin)
		(breakif `(,iter_begin = ,iter_end))
		(assign `(,iter_begin) '((:rsp local_iter_begin)))
		(class/obj/deref-live value tmp 'last_ref)
	(vp-label 'derefed)
		(vp-cpy-ir iter_begin 0 value)
	(errorcase
		(assign `((,value +obj_vtable) (@ ,(f-path :list :vtable))) `(,vtable ,tmp))
		(gotoif `(,vtable /= ,tmp) 'error2)
		(assign `((,value +array_length)) `(,tmp))
		(gotoif `(,tmp = 0) 'error1))
		(assign `((,value +array_begin)) `(,tmp))
		(call :lisp :repl_eval `(,this (,tmp 0)) `(,this ,value))
		(assign `((,this +lisp_sym_nil)) `(,tmp))
		(vpif `(,value = ,tmp))
			(assign '((:rsp local_iter_begin)) `(,tmp))
			(assign `((,tmp 0)) `(,tmp))
			(class/array/get_both tmp iter_begin iter_end)
			(vp-free frame)
			(jump :lisp :repl_progn `(,this ,value (& ,iter_begin ,+ptr_size) ,iter_end))
		(endif)
	(errorcase
		(assign `((,value +obj_vtable) (,this +lisp_error)) `(,vtable ,tmp))
		(breakif `(,vtable = ,tmp)))
		(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) `(,iter_begin ,iter_end))
	(loop-end)

	(exit :lisp :lisp_condn `(,this ,value))
	(vp-free frame)
	(vp-ret)

(vp-label 'last_ref)
	;the last ref of the last test's value, so a call, and all is trashed
	(call :obj :deref `(,value))
	(lisp-this this)
	(assign '((:rsp local_iter_begin)) `(,iter_begin))
	(goto 'derefed)

(errorcase
(vp-label 'error1)
	(assign '((:rsp local_args) +error_msg_wrong_num_of_args) '(:r1 :r3))
	(goto 'error)
(vp-label 'error2)
	(assign '((:rsp local_args) +error_msg_not_a_list) '(:r1 :r3))
(vp-label 'error)
	(vp-free frame)
	(jump :lisp :repl_error '(:r1 "(condn [(tst [body])] ...)" :r3)))

(def-func-end)

(def-method :lisp :lisp_progn)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this args iter_begin iter_end tmp))

	(entry :lisp :lisp_progn `(,this ,args))

	(class/array/get_both args iter_begin iter_end)
	(assign `((,this +lisp_sym_nil)) `(,args))
	(class/obj/ref args tmp)
	(jump :lisp :repl_progn `(,this ,args (& ,iter_begin ,+ptr_size) ,iter_end))

(def-func-end)

(def-method :lisp :repl_progn)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = initial value object (ptr)
	;:r2 = list iter_begin (pptr)
	;:r3 = list iter_end (pptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;the last form is a jump to its eval, with nothing left on the stack.
	;The frame is only for the forms before it, and has no slot for the
	;lisp object, it stays in :r0, each eval gives it back.

	(structure local 0
		(pptr iter_begin iter_end))

	(vp-rdef (this value iter_begin iter_end tmp vtable))

	(entry :lisp :repl_progn `(,this ,value ,iter_begin ,iter_end))

	(gotoif `(,iter_begin = ,iter_end) 'prognexit)
(errorcase
	(assign `((,value +obj_vtable) (,this +lisp_error)) `(,vtable ,tmp))
	(gotoif `(,vtable = ,tmp) 'prognexit))
	(vp-sub-cr +ptr_size iter_end)
	(vpif `(,iter_begin /= ,iter_end))
		;the forms before the last
		(vp-alloc local_size)
		(assign `(,iter_end) '((:rsp local_iter_end)))
	(vp-label 'next_form)
		(assign `(,iter_begin) '((:rsp local_iter_begin)))
		(class/obj/deref-live value tmp 'last_ref1)
	(vp-label 'derefed1)
		(call :lisp :repl_eval `(,this (,iter_begin 0)) `(,this ,value))
	(errorcase
		(assign `((,value +obj_vtable) (,this +lisp_error)) `(,vtable ,tmp))
		(gotoif `(,vtable = ,tmp) 'prognexit1))
		(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) `(,iter_begin ,iter_end))
		(vp-add-cr +ptr_size iter_begin)
		(gotoif `(,iter_begin /= ,iter_end) 'next_form)
		(vp-free local_size)
	(endif)
	;the last form
	(class/obj/deref-live value tmp 'last_ref2)
(vp-label 'derefed2)
	(jump :lisp :repl_eval `(,this (,iter_end 0)))

(vp-label 'prognexit)
	(exit :lisp :repl_progn `(,this ,value))
	(vp-ret)

(errorcase
(vp-label 'prognexit1)
	(exit :lisp :repl_progn `(,this ,value))
	(vp-free local_size)
	(vp-ret))

(vp-label 'last_ref1)
	;the last ref of the old value, so a call, and all is trashed
	(call :obj :deref `(,value))
	(lisp-this this)
	(assign '((:rsp local_iter_begin)) `(,iter_begin))
	(goto 'derefed1)

(vp-label 'last_ref2)
	(vp-push iter_end)
	(call :obj :deref `(,value))
	(vp-pop iter_end)
	(lisp-this this)
	(goto 'derefed2)

(def-func-end)
