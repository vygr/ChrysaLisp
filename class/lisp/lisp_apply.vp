(include "lib/asm/func.inc")
(include "./class.inc")
(include "././hmap/class.inc")
(include "././func/class.inc")

(def-method :lisp :lisp_apply)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this func seq list)
		(long n i))

	(entry :lisp :lisp_apply '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 2)

	(array-bind-args :r1 '(:r2 :r1))
	;a native function takes its args as a list of objects: a list is
	;given it at once, as :repl_apply would, a seq of another kind, a nums
	;or a str, as a list of its elements, let go of after. A lambda binds
	;from any seq, by :repl_apply
	(assign `((:r2 +obj_vtable) (@ ,(f-path :func :vtable))) '(:r3 :r4))
	(vpif '(:r3 = :r4))
		(f-bind :list :vtable :r4)
		(assign '((:r1 +obj_vtable)) '(:r3))
		(vpif '(:r3 = :r4))
			(assign '((:r2 +num_value)) '(:r2))
			(vp-and-cr (neg +ptr_size) :r2)
			(r-jump :lisp :repl_eval '(:r0 :r1) :r2)
		(else)
			(vp-alloc local_size)
			(assign '(:r0 :r2 :r1) '((:rsp local_this) (:rsp local_func) (:rsp local_seq)))
			(call :list :create :nil '(:r0))
			(assign '(:r0) '((:rsp local_list)))
			(assign '((:rsp local_seq)) '(:r0))
			(call :seq :get_length '(:r0) '(_ :r1))
			(assign '(:r1) '((:rsp local_n)))
			(assign '((:rsp local_list)) '(:r0))
			(call :array :set_cap '(:r0 :r1))
			(vp-xor-rr :r1 :r1)
			(assign '(:r1) '((:rsp local_i)))
			(assign '((:rsp local_n)) '(:r2))
			(vpif '(:r1 < :r2))
			(loop-start)
				(assign '((:rsp local_seq)) '(:r0))
				(call :seq :ref_elem '(:r0 :r1) '(_ :r1))
				(assign '((:rsp local_list)) '(:r0))
				(call :array :push_back '(:r0 :r1))
				(assign '((:rsp local_i) (:rsp local_n)) '(:r1 :r2))
				(vp-add-cr 1 :r1)
				(assign '(:r1) '((:rsp local_i)))
			(loop-until '(:r1 = :r2))
			(endif)
			(assign '((:rsp local_this) (:rsp local_list) (:rsp local_func)) '(:r0 :r1 :r2))
			(call :lisp :repl_apply '(:r0 :r1 :r2) '(_ :r1))
			(assign '(:r1) '((:rsp local_seq)))
			(assign '((:rsp local_list)) '(:r0))
			(call :obj :deref '(:r0))
			(assign '((:rsp local_this) (:rsp local_seq)) '(:r0 :r1))
			(vp-free local_size)
			(exit :lisp :lisp_apply '(:r0 :r1))
			(vp-ret)
		(endif)
	(endif)
	(jump :lisp :repl_apply '(:r0 :r1 :r2))

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(apply lambda seq)" +error_msg_wrong_types))
	(signature '(:obj :seq)))

(def-func-end)

(def-method :lisp :lisp_mcall)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this args mth) '(:r8 :r9 :r10))
	(vp-rdef (obj vt1 vt2))

	(entry :lisp :lisp_mcall `(,this ,args))

	(errorif-lisp-args-len 'error :r1 < 2)
	(array-bind-args :r1 `(,obj ,mth))

(errorcase
	(call :obj :inst_of `(,obj (@ ,(f-path :hmap :vtable))) `(,obj tmp))
	(gotoif `(,tmp = 0) 'error)
	(assign `((,mth +obj_vtable) (@ ,(f-path :sym :vtable))) `(,vt1 ,vt2))
	(gotoif `(,vt1 /= ,vt2) 'error))

	(fn-bind 'sys/statics/statics vt1)
	(call :hmap :pfind `(,obj (,vt1 ,(+ statics_static_syms static_sym_vtable))) '(_ tmp _))
	(errorif `(,tmp = 0) 'error2)
	(call :hmap :pfind `((,tmp +ptr_size) ,mth) '(_ tmp _))
	(errorif `(,tmp = 0) 'error1)

	(jump :lisp :repl_apply `(,this ,args (,tmp +ptr_size)))

(errorcase
(vp-label 'error2)
	(fn-bind 'sys/statics/statics args)
	(assign `((,args ,(+ statics_static_syms static_sym_vtable))) `(,args))
	(jump :lisp :repl_error `(,args "(. env sym [...])" +error_msg_symbol_not_bound))
(vp-label 'error1)
	(jump :lisp :repl_error `(,mth "(. env sym [...])" +error_msg_symbol_not_bound))
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(. env sym [...])" +error_msg_wrong_types)))

(def-func-end)
