(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././sstream/class.inc")

(def-method :lisp :read_sym)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = stream object (ptr)
	;:r2 = next char (uint)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;:r2 = next char (uint)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this stm c buf bufp bufe first))

	(entry :lisp :read_sym `(,this ,stm ,c))

	;most symbols are whole in the stream's buffer
	(assign `((,stm +stream_bufp) (,stm +stream_bufe) ,c) `(,bufp ,bufe ,first))
	(assign `(,bufp) `(,buf))
	(loop-while (list c '> +char_space) (list c '/= +char_lrb) (list c '/= +char_rrb))
		(gotoif `(,bufp = ,bufe) 'slow_but_sure)
		(assign `((,bufp 0 ub)) `(,c))
		(vp-add-cr +byte_size bufp)
	(loop-end)
	(assign `(,bufp) `((,stm +stream_bufp)))
	(vp-sub-cr +byte_size buf)
	(vp-sub-cr +byte_size bufp)
	(vp-push this c)
	(call :sym :intern_pstr `(,buf ,bufp) '(:r1))
	(vp-pop :r0 :r2)

	(exit :lisp :read_sym '(:r0 :r1 :r2))
	(vp-ret)

(vp-label 'slow_but_sure)
	;it runs off the end of the buffer, so start again, a char at a time,
	;from the first, the stream has not been moved on
	(vp-push this stm first)
	(call :sym :create_from_buffer '(0 str_gap) '(:r0))
	(call :sstream :create '(:r0) '(:r0))
	(vp-push :r0)
	(loop-start)
		(assign `((:rsp ,+ptr_size)) '(:r1))
		(breakif '(:r1 <= +char_space) '(:r1 = +char_lrb) '(:r1 = +char_rrb))
		(call :stream :write_char '((:rsp 0) :r1))
		(call :stream :read_char `((:rsp ,(* 2 +ptr_size))) '(_ :r1))
		(assign '(:r1) `((:rsp ,+ptr_size)))
	(loop-end)
	(assign '((:rsp 0)) '(:r2))
	(assign '((:r2 +stream_object) (:r2 +stream_bufp)) '(:r0 :r1))
	(call :sym :intern_pstr '((& :r0 +str_data) :r1) '(:r1))
	(assign '((:rsp 0)) '(:r0))
	(assign '(:r1) '((:rsp 0)))
	(call :sstream :destroy '(:r0))
	(vp-pop :r1)
	(vp-pop :r0 :r3 :r2)

	(exit :lisp :read_sym '(:r0 :r1 :r2))
	(vp-ret)

(def-func-end)
