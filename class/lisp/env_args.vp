(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :lisp :env_args_sig)
	;inputs
	;:r1 = args list object (ptr)
	;:r2 = signature pointer (pshort)
	;:r3 = min number of args (int)
	;:r4 = max number of args (int)
	;outputs
	;:r1 = args list object (ptr)
	;:r2 = 0 if error, else ok
	;trashes
	;:r2-:r6

	(vp-rdef (_ args sig iter_begin iter_end vt1 vt2))

	(entry :lisp :env_args_sig `(,args ,sig ,iter_begin ,iter_end))

	(assign `((,args +array_length)) `(,vt2))
	(switch 'fail)
		;must be in range and match signature
		(breakif `(,vt2 < ,iter_begin) `(,vt2 > ,iter_end) 'fail)
		(vpif `(,vt2 /= 0))
			(assign `((,args +array_begin)) `(,iter_begin))
			(vp-shl-cr (log2 +ptr_size) vt2)
			(assign `((& ,iter_begin ,vt2)) `(,iter_end))
			(loop-start)
				(vp-cpy-ir-s sig 0 vt2)
				(assign `((,iter_begin 0)) `(,vt1))
				(vpif `(,vt2 >= 0))
					;any subclass
					(assign `((,sig ,vt2)) `(,vt2))
					(loop-start)
						(assign `((,vt1 +obj_vtable)) `(,vt1))
						(breakif `(,vt1 = 0) 'fail)
					(loop-until `(,vt1 = ,vt2))
				(else)
					;exact class
					(vp-mul-cr -1 vt2)
					(assign `((,vt1 +obj_vtable) (,sig ,vt2)) `(,vt1 ,vt2))
					(breakif `(,vt1 /= ,vt2) 'fail)
				(endif)
				(vp-add-cr +ptr_size iter_begin)
				(vp-add-cr +short_size sig)
			(loop-until `(,iter_begin = ,iter_end))
		(endif)

		(exit :lisp :env_args_sig `(,args -1))
		(vp-ret)
	(endswitch)

	(exit :lisp :env_args_sig `(,args 0))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_args_type)
	;inputs
	;:r1 = args list object (ptr)
	;:r2 = vtable pointer (ptr)
	;:r3 = min number of args (int)
	;outputs
	;:r1 = args list object (ptr)
	;:r2 = 0 if error, else ok
	;trashes
	;:r2-:r5

	(vp-rdef (_ args vt2 iter_begin iter_end vt1))

	(entry :lisp :env_args_type `(,args ,vt2 ,iter_begin))

	(assign `((,args +array_length)) `(,vt1))
	(switch 'fail)
		;must be in range and of this type
		(breakif `(,vt1 < ,iter_begin) 'fail)
		(vpif `(,vt1 /= 0))
			(assign `((,args +array_begin)) `(,iter_begin))
			(vp-shl-cr (log2 +ptr_size) vt1)
			(assign `((& ,iter_begin ,vt1)) `(,iter_end))
			(loop-start)
				;any subclass
				(assign `((,iter_begin 0)) `(,vt1))
				(loop-start)
					(assign `((,vt1 +obj_vtable)) `(,vt1))
					(breakif `(,vt1 = 0) 'fail)
				(loop-until `(,vt1 = ,vt2))
				(vp-add-cr +ptr_size iter_begin)
			(loop-until `(,iter_begin = ,iter_end))
		(endif)

		(exit :lisp :env_args_type `(,args -1))
		(vp-ret)
	(endswitch)

	(exit :lisp :env_args_type `(,args 0))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_args_match)
	;inputs
	;:r1 = args list object (ptr)
	;:r2 = vtable pointer (ptr)
	;:r3 = min number of args (int)
	;outputs
	;:r1 = args list object (ptr)
	;:r2 = 0 if error, else ok
	;trashes
	;:r2-:r5

	(vp-rdef (_ args vt2 iter_begin iter_end vt1))

	(entry :lisp :env_args_match `(,args ,vt2 ,iter_begin))

	(assign `((,args +array_length)) `(,vt1))
	(switch 'fail)
		;must be in range and of this type and all identical
		(breakif `(,vt1 < ,iter_begin) 'fail)
		(vpif `(,vt1 /= 0))
			(assign `((,args +array_begin)) `(,iter_begin))
			(vp-shl-cr (log2 +ptr_size) vt1)
			(assign `((& ,iter_begin ,vt1)) `(,iter_end))
			;any subclass
			(assign `((,iter_begin 0)) `(,vt1))
			(loop-start)
				(assign `((,vt1 +obj_vtable)) `(,vt1))
				(breakif `(,vt1 = 0) 'fail)
			(loop-until `(,vt1 = ,vt2))
			;then all exact type
			(vp-add-cr +ptr_size iter_begin)
			(breakif `(,iter_begin = ,iter_end))
			(assign `((,iter_begin ,(neg +ptr_size))) `(,vt2))
			(assign `((,vt2 +obj_vtable)) `(,vt2))
			(loop-start)
				(assign `((,iter_begin 0)) `(,vt1))
				(assign `((,vt1 +obj_vtable)) `(,vt1))
				(breakif `(,vt1 /= ,vt2) 'fail)
				(vp-add-cr +ptr_size iter_begin)
			(loop-until `(,iter_begin = ,iter_end))
		(endif)

		(exit :lisp :env_args_match `(,args -1))
		(vp-ret)
	(endswitch)

	(exit :lisp :env_args_match `(,args 0))
	(vp-ret)

(def-func-end)
