(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :lisp :env_args_sig)
	;inputs
	;:r1 = args list object (ptr)
	;:r2 = signature pointer (pshort)
	;:r3 = min number of args (int)
	;:r4 = max number of args (int)
	;outputs
	;:r1 = args list object (ptr)
	;:r2 = 0 if error, else ok
	;trashes
	;:r2-:r7

	(vp-rdef (_ args sig iter_begin iter_end len vt1 vt2))

	(entry :lisp :env_args_sig `(,args ,sig ,iter_begin ,iter_end))

	(assign `((,args +array_length)) `(,len))
	(switch 'fail)
		;must be in range and match signature
		(breakif `(,len < ,iter_begin) `(,len > ,iter_end) 'fail)
		(vpif `(,len /= 0))
			(assign `((,args +array_begin)) `(,iter_begin))
			(vp-shl-cr (log2 +ptr_size) len)
			(assign `((& ,iter_begin ,len)) `(,iter_end))
			(loop-start)
				(vp-cpy-ir-s sig 0 len)
				(assign `((,iter_begin 0)) `(,vt1))
				(vpif `(,len >= 0))
					;any subclass
					(assign `((,sig ,len)) `(,vt2))
					(loop-start)
						(assign `((,vt1 +obj_vtable)) `(,vt1))
						(breakif `(,vt1 = 0) 'fail)
					(loop-until `(,vt1 = ,vt2))
				(else)
					;exact class
					(vp-cpy-rr sig vt2)
					(vp-sub-rr len vt2)
					(assign `((,vt1 +obj_vtable) (,vt2 0)) `(,vt1 ,vt2))
					(breakif `(,vt1 /= ,vt2) 'fail)
				(endif)
				(vp-add-cr +ptr_size iter_begin)
				(vp-add-cr +short_size sig)
			(loop-until `(,iter_begin = ,iter_end))
		(endif)

		(exit :lisp :env_args_sig `(,args -1))
		(vp-ret)
	(endswitch)

	(exit :lisp :env_args_sig `(,args 0))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_args_type)
	;inputs
	;:r1 = args list object (ptr)
	;:r3 = vtable pointer (ptr)
	;:r4 = min number of args (int)
	;outputs
	;:r1 = args list object (ptr)
	;:r2 = 0 if error, else ok
	;trashes
	;:r2, :r4-:r7

	(entry :lisp :env_args_type '(:r1 :r3 :r4))

	(assign '(:r0 :r1 (:r1 +array_length)) '(:r6 :r7 :r2))
	(switch 'fail)
		;must be in range and of this type
		(breakif '(:r2 < :r4) 'fail)
		(class/array/get_both :r1 :r4 :r5)
		(vpif '(:r4 /= :r5))
			(loop-start)
				(call :obj :inst_of '((:r4 0) :r3) '(_ :r1))
				(breakif '(:r1 = 0) 'fail)
				(vp-add-cr +ptr_size :r4)
			(loop-until '(:r4 = :r5))
		(endif)
		(assign '(:r6 :r7 -1) '(:r0 :r1 :r2))

		(exit :lisp :env_args_type '(:r1 :r2))
		(vp-ret)
	(endswitch)
	(assign '(:r6 :r7 0) '(:r0 :r1 :r2))

	(exit :lisp :env_args_type '(:r1 :r2))
	(vp-ret)

(def-func-end)

(def-method :lisp :env_args_match)
	;inputs
	;:r1 = args list object (ptr)
	;:r3 = vtable pointer (ptr)
	;:r4 = min number of args (int)
	;outputs
	;:r1 = args list object (ptr)
	;:r2 = 0 if error, else ok
	;trashes
	;:r2, :r4-:r7

	(entry :lisp :env_args_match '(:r1 :r3 :r4))

	(assign '(:r0 :r1 (:r1 +array_length)) '(:r6 :r7 :r2))
	(switch 'fail)
		;must be in range and of this type and all identical
		(breakif '(:r2 < :r4) 'fail)
		(vpif '(:r2 /= 0))
			(class/array/get_both :r1 :r4 :r5)
			(call :obj :inst_of '((:r4 0) :r3) '(_ :r1))
			(breakif '(:r1 = 0) 'fail)
			(vp-add-cr +ptr_size :r4)
			(breakif '(:r4 = :r5))
			(loop-start)
				(assign '((:r4 0)) '(:r0))
				(assign '((:r0 +obj_vtable)) '(:r0))
				(breakif '(:r1 /= :r0) 'fail)
				(vp-add-cr +ptr_size :r4)
			(loop-until '(:r4 = :r5))
		(endif)
		(assign '(:r6 :r7 -1) '(:r0 :r1 :r2))

		(exit :lisp :env_args_match '(:r1 :r2))
		(vp-ret)
	(endswitch)
	(assign '(:r6 :r7 0) '(:r0 :r1 :r2))

	(exit :lisp :env_args_match '(:r1 :r2))
	(vp-ret)

(def-func-end)
