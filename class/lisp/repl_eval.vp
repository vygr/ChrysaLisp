(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././hmap/class.inc")
(include "././func/class.inc")

(defun eval-args (err)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = form object (ptr)
	;err = label to jump to if an arg evals to an error
	;outputs
	;:r0 = lisp object (ptr)
	;info
	;emit the eval of the args of a form, into a list, that takes each
	;value as it is given, with no ref. The frame, of the caller, holds the
	;form, in local_form, and the list, in local_args, and no more, the
	;place in the form is found from the length of the list so far.
	;
	;The list is taken from the chain of empty ones the lisp object keeps,
	;so most calls need not create one.
	(assign '((:r0 +lisp_args_pool) (:r1 +array_length)) '(:r2 :r3))
	(vp-sub-cr 1 :r3)
	(vpif '(:r2 = 0))
		(vp-cpy-rr :r0 :r10)
		(call :list :create :nil '(:r2))
		(vp-cpy-rr :r10 :r0)
		(assign '((:rsp local_form)) '(:r1))
		(assign '((:r1 +array_length)) '(:r3))
		(vp-sub-cr 1 :r3)
	(else)
		(assign '((:r2 +array_begin)) '(:r4))
		(assign '((:r4 0)) '(:r4))
		(assign '(:r4) '((:r0 +lisp_args_pool)))
	(endif)
	(assign '(:r2) '((:rsp local_args)))
	(vpif '(:r3 /= 0))
		(assign '((:r2 +array_capacity)) '(:r4))
		(vpif '(:r3 > :r4))
			(vp-cpy-rr :r0 :r10)
			(call :array :set_cap '(:r2 :r3))
			(vp-cpy-rr :r10 :r0)
			(assign '((:rsp local_form)) '(:r1))
		(endif)
		(assign '((:r1 +array_begin)) '(:r2))
		(vp-cpy-cr +ptr_size :r6)
		(loop-start)
			(call :lisp :repl_eval '(:r0 (:r2 :r6)) '(:r0 :r1))
		(errorcase
			(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r2 :r3))
			(gotoif '(:r2 = :r3) err))
			(assign '((:rsp local_args) (:rsp local_form)) '(:r7 :r2))
			(assign '((:r7 +array_length) (:r7 +array_begin)) '(:r4 :r5))
			(assign '((:r2 +array_length) (:r2 +array_begin)) '(:r3 :r2))
			(vp-cpy-rr :r4 :r6)
			(vp-shl-cr (log2 +ptr_size) :r6)
			(vp-add-cr 1 :r4)
			(vp-cpy-rd :r1 :r5 :r6)
			(assign '(:r4) '((:r7 +array_length)))
			(vp-add-cr 1 :r4)
			(breakif '(:r4 = :r3))
			(vp-add-cr (* 2 +ptr_size) :r6)
		(loop-end)
	(endif))

(defun drop-args (n)
	;inputs
	;:r0 = args list object (ptr)
	;n = number of this use, for its labels
	;outputs
	;:r0 = lisp object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;emit the end of an args list. If no other has a ref to it, and it has
	;not grown, its values are dropped, in line where they live on, and it
	;goes on the chain of empty lists, the link held in its first element.
	;If not it is given a deref, as any object. The code for the rare
	;cases is emitted by (drop-args-slow), out of the flow.
	(defq slow (sym (cat "drop_slow_" (str n))) last (sym (cat "drop_last_" (str n)))
		next (sym (cat "drop_next_" (str n))) done (sym (cat "drop_done_" (str n))))
	(assign '((:r0 +obj_count) (:r0 +array_begin) (& :r0 +array_elems)) '(:r1 :r2 :r3))
	(gotoif '(:r1 /= 1) slow)
	(gotoif '(:r2 /= :r3) slow)
	(assign '((:r0 +array_length)) '(:r3))
	(vpif '(:r3 /= 0))
		(vp-shl-cr (log2 +ptr_size) :r3)
		(vp-add-rr :r2 :r3)
		(loop-start)
			(assign '((:r2 0)) '(:r1))
			(class/obj/deref-live :r1 :r4 last)
		(vp-label next)
			(vp-add-cr +ptr_size :r2)
		(loop-until '(:r2 = :r3))
		(vp-xor-rr :r1 :r1)
		(assign '(:r1 (& :r0 +array_elems)) '((:r0 +array_length) :r2))
	(endif)
	(vp-cpy-rr :r0 :r1)
	(lisp-this :r0)
	(assign '((:r0 +lisp_args_pool)) '(:r3))
	(assign '(:r3 :r1) '((:r2 0) (:r0 +lisp_args_pool)))
(vp-label done))

(defun drop-args-slow (n)
	(defq slow (sym (cat "drop_slow_" (str n))) last (sym (cat "drop_last_" (str n)))
		next (sym (cat "drop_next_" (str n))) done (sym (cat "drop_done_" (str n))))
(vp-label last)
	;the last ref of a value, so a call, and all is trashed
	(vp-push :r0 :r2 :r3)
	(call :obj :deref '(:r1))
	(vp-pop :r0 :r2 :r3)
	(goto next)
(vp-label slow)
	(call :obj :deref '(:r0))
	(lisp-this :r0)
	(goto done))

(def-method :lisp :repl_eval)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = form object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;this is the heart of the recursion, so what it holds on the stack,
	;over each call it makes, is kept to the least. A symbol, or a form
	;that evals to itself, uses none. A special form is a jump, so none. A
	;built in function holds the form and the args while the args eval,
	;and only the args while it runs. The list for the args is taken from,
	;and given back to, a chain of empty ones. A lambda holds the form and the args
	;while the args eval, and nothing while its body runs.
	;
	;The function of a form is nearly always prebound, a func object or a
	;lambda list, held by the form. So it is not given a ref, and is found
	;from the form when wanted, with no slot of its own. Only a function
	;that has to be evaluated, the general case, has a slot, and a ref.

	(structure local 0
		(ptr form args func))

	(defq frame local_func frame_general local_size)

	(entry :lisp :repl_eval '(:r0 :r1))

	;evaluate based on type. Only a list, a call, needs a stack frame, so
	;it is not made till then, most forms are a symbol or eval to self.
	(assign `((:r1 +obj_vtable) (@ ,(f-path :sym :vtable)) (@ ,(f-path :list :vtable)))
		'(:r2 :r3 :r4))
	(switch)
	(vpcase '(:r2 = :r3))
		;eval to symbol binding ?
		(assign '((:r1 +str_data ub)) '(:r2))
		(gotoif '(:r2 = +char_colon) 'toself)
		;:hmap :get keeps to :r0-:r9, so the lisp object, and the form if
		;there is an error to report, wait in higher registers, not on
		;the stack
		(vp-cpy-rr :r0 :r10)
	(errorcase
		(vp-cpy-rr :r1 :r11))
		(call :hmap :get '((:r0 +lisp_environment) :r1) '(_ :r1))
		(vp-cpy-rr :r10 :r0)
	(errorcase
		(gotoif '(:r1 = 0) 'error2))
		(exit :lisp :repl_eval '(:r0 :r1))
		(vp-ret)
	(errorcase
	(vp-label 'error1)
		(jump :lisp :repl_error '(:r1 "(eval form [env])" +error_msg_not_a_function))
	(vp-label 'error2)
		(jump :lisp :repl_error '(:r11 "(eval form [env])" +error_msg_symbol_not_bound)))
	(vpcase '(:r2 = :r4))
		;apply function, don't eval args if special form
	(errorcase
		(assign '((:r1 +array_length)) '(:r2))
		(gotoif '(:r2 = 0) 'error1))
		(array-bind-args :r1 '(:r2))
		(assign '((:r2 +obj_vtable)) '(:r3))
		(f-bind :func :vtable :r5)
		(vpif '(:r3 = :r5))
			;a prebound func object
			(assign '((:r2 +num_value)) '(:r2))
			(vp-cpy-rr :r2 :r3)
			(vp-and-cr (neg +ptr_size) :r2)
			(vp-and-cr 7 :r3)
			(vpif '(:r3 /= 0))
				;special form, it is given the form, and its value is ours
				(r-jump :lisp :repl_eval '(:r0 :r1) :r2)
			(endif)
			;built in function
			(vp-alloc frame)
			(assign '(:r1) '((:rsp local_form)))
			(eval-args 'error_args)
			(assign '((:rsp local_form) (:rsp local_args)) '(:r2 :r1))
			(assign '((:r2 +array_begin)) '(:r2))
			(assign '((:r2 0)) '(:r2))
			(assign '((:r2 +num_value)) '(:r2))
			(vp-and-cr (neg +ptr_size) :r2)
			;only the args are held while it runs
			(vp-free local_args)
			(r-call :lisp :repl_eval '(:r0 :r1 :r2) '(_ :r1) :r2)
			(assign '((:rsp 0)) '(:r0))
		(vp-label 'drop_args)
			(assign '(:r1) '((:rsp 0)))
			(drop-args 0)
			(vp-pop :r1)
			(exit :lisp :repl_eval '(:r0 :r1))
			(vp-ret)
			(drop-args-slow 0)
		(errorcase
		(vp-label 'error_args)
			;an arg gave an error, it is the value
			(assign '((:rsp local_args)) '(:r0))
			(vp-free local_args)
			(goto 'drop_args))
		(endif)
		(vpif '(:r3 = :r4))
			(assign '((:r2 +array_length)) '(:r3))
			(breakif '(:r3 < 2))
			(array-bind-args :r2 '(:r3))
			(assign '((:r0 +lisp_func_lambda)) '(:r5))
			(breakif '(:r3 /= :r5))
			;a prebound lambda
			(vp-alloc frame)
			(assign '(:r1) '((:rsp local_form)))
			(eval-args 'error_args)
			(call :lisp :env_push '(:r0) '(:r0 _))
			(assign '((:rsp local_form)) '(:r1))
			(assign '((:r1 +array_begin)) '(:r1))
			(assign '((:r1 0)) '(:r1))
			(assign '((:r1 +array_begin)) '(:r1))
			(call :lisp :env_bind `(:r0 (:r1 ,+ptr_size) (:rsp local_args)) '(_ :r1))
			;the values are bound, so the args can go, before the body runs
			(assign '((:rsp local_args)) '(:r0))
			(assign '(:r1) '((:rsp local_args)))
			(drop-args 1)
			(assign '((:rsp local_form) (:rsp local_args)) '(:r2 :r1))
			(vp-free frame)
			(assign '((:r2 +array_begin)) '(:r2))
			(assign '((:r2 0)) '(:r2))
			(class/array/get_both :r2 :r2 :r3)
			(vp-add-cr (* 2 +ptr_size) :r2)
			(call :lisp :repl_progn '(:r0 :r1 :r2 :r3) '(:r0 :r1))
			(vp-push :r1)
			(call :lisp :env_pop '(:r0) '(:r0 _))
			(vp-pop :r1)
			(exit :lisp :repl_eval '(:r0 :r1))
			(vp-ret)
			(drop-args-slow 1)
		(endif)
		;the general case, the function has to be evaluated
		(vp-alloc frame_general)
		(assign '(:r1) '((:rsp local_form)))
		(call :lisp :repl_eval '(:r0 :r2) '(:r0 :r1))
		(assign '((:r1 +obj_vtable)) '(:r2))
	(errorcase
		(assign '((:r0 +lisp_error)) '(:r3))
		(gotoif '(:r2 = :r3) 'funcall_exit))
		(assign '(:r1) '((:rsp local_func)))
		(f-bind :func :vtable :r3)
		(vpif '(:r2 = :r3))
			(assign '((:r1 +num_value)) '(:r2))
			(vp-and-cr 7 :r2)
			(vpif '(:r2 /= 0))
				;special form
				(vp-cpy-rr :r1 :r2)
				(call :lisp :repl_apply '(:r0 (:rsp local_form) :r2) '(_ :r1))
				(assign '(:r1) '((:rsp local_form)))
				(goto 'drop_func)
			(endif)
		(endif)
		(assign '((:rsp local_form)) '(:r1))
		(eval-args 'error_general)
		(assign '((:rsp local_args) (:rsp local_func)) '(:r1 :r2))
		(call :lisp :repl_apply '(:r0 :r1 :r2) '(_ :r1))
	(vp-label 'error_general)
		(assign '(:r1) '((:rsp local_form)))
		(call :obj :deref '((:rsp local_args)))
	(vp-label 'drop_func)
		(call :obj :deref '((:rsp local_func)))
		(lisp-this :r0)
		(assign '((:rsp local_form)) '(:r1))
	(vp-label 'funcall_exit)
		(exit :lisp :repl_eval '(:r0 :r1))
		(vp-free frame_general)
		(vp-ret)
	(default)
	(vp-label 'toself)
		;eval to self
		(class/obj/ref :r1 :r2)
	(endswitch)

	(exit :lisp :repl_eval '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lisp :repl_eval_list)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this)
		(pptr iter_begin iter_end))

	(push-scope)
	(entry :lisp :repl_eval_list '(:r0 :r1))

	(assign '((:r1 +array_begin) (:r1 +array_length) (:r0 +lisp_sym_nil)) '(:r3 :r2 :r1))
	(switch 'exit)
	(vpcase '(:r2 /= 0))
		(vp-shl-cr (log2 +long_size) :r2)
		(vp-add-rr :r3 :r2)
		(assign '(:r0 :r2) {this, iter_end})
		(loop-start)
			(assign '(:r3) {iter_begin})
			(call :lisp :repl_eval '(:r0 (:r3 0)) '(:r0 :r1))
		(errorcase
			(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r3 :r2))
			(breakif '(:r2 = :r3) 'exit))
			(assign {iter_begin} '(:r3))
			(assign '((:r3 0) :r1) '(:r0 (:r3 0)))
			(call :obj :deref '(:r0))
			(assign {iter_begin, iter_end, this} '(:r3 :r2 :r0))
			(vp-add-cr +ptr_size :r3)
		(loop-until '(:r3 = :r2))
		(vp-cpy-ir :r3 (neg +ptr_size) :r1)
	(default)
		(class/obj/ref :r1 :r2)
	(endswitch)

	(exit :lisp :repl_eval_list '(:r0 :r1))
	(pop-scope)
	(return)

(def-func-end)
