(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././hmap/class.inc")
(include "././func/class.inc")

(def-method :lisp :repl_eval)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = form object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr form value func args))

	(entry :lisp :repl_eval '(:r0 :r1))

	;evaluate based on type. Only a list, a call, needs the stack frame, so
	;it is not made till then, most forms are a symbol or eval to self.
	(assign `((:r1 +obj_vtable) (@ ,(f-path :sym :vtable)) (@ ,(f-path :list :vtable)))
		'(:r2 :r3 :r4))
	(switch)
	(vpcase '(:r2 = :r3))
		;eval to symbol binding ?
		(assign '((:r1 +str_data ub)) '(:r2))
		(gotoif '(:r2 = +char_colon) 'toself)
		;:hmap :get keeps to :r0-:r9, so the lisp object, and the form if
		;there is an error to report, wait in higher registers, not on
		;the stack
		(vp-cpy-rr :r0 :r10)
	(errorcase
		(vp-cpy-rr :r1 :r11))
		(call :hmap :get '((:r0 +lisp_environment) :r1) '(_ :r1))
		(vp-cpy-rr :r10 :r0)
	(errorcase
		(gotoif '(:r1 = 0) 'error2))
		(exit :lisp :repl_eval '(:r0 :r1))
		(vp-ret)
	(errorcase
		;these jump with no stack frame to unwind, so are here, before it
	(vp-label 'error1)
		(jump :lisp :repl_error '(:r0 :r1 "(eval form [env])" +error_msg_not_a_function))
	(vp-label 'error2)
		(jump :lisp :repl_error '(:r0 :r11 "(eval form [env])" +error_msg_symbol_not_bound)))
	(vpcase '(:r2 = :r4))
		;apply function, don't eval args if special form
	(errorcase
		(assign '((:r1 +array_length)) '(:r2))
		(gotoif '(:r2 = 0) 'error1))
		;the lisp object has no slot in the frame. It stays in :r0 where it
		;can, every eval gives it back, and is fetched from the tcb to
		;give back at the end.
		(push-scope)
		(assign '(:r1) {form})
		(array-bind-args :r1 '(:r1))
		;the function is nearly always prebound, a func object, that evals
		;to itself, so no need to call to find that out
		(assign '((:r1 +obj_vtable)) '(:r2))
		(f-bind :func :vtable :r3)
		(vpif '(:r2 = :r3))
			(class/obj/ref :r1 :r4)
		(else)
			(call :lisp :repl_eval '(:r0 :r1) '(:r0 :r1))
			(assign '((:r1 +obj_vtable)) '(:r2))
		(errorcase
			(assign '((:r0 +lisp_error)) '(:r3))
			(gotoif '(:r2 = :r3) 'funcall_exit))
			(f-bind :func :vtable :r3)
		(endif)
		(assign '(:r1) {func})
		(vpif '(:r2 = :r3))
			;special form ?
			(assign '((:r1 +num_value)) '(:r2))
			(vp-and-cr 7 :r2)
			(breakif '(:r2 = 0))
			;special form
			(assign '(:r1) '(:r2))
			(assign {form} '(:r1))
			(call :lisp :repl_apply '(:r0 :r1 :r2) {_, value})
			(call :obj :deref {func})
			(lisp-this :r0)
			(assign {value} '(:r1))
			(exit :lisp :repl_eval '(:r0 :r1))
			(return)
		(endif)
		;none special form, so evaluate the args into a new list, that
		;takes each value as it is given, with no ref. The form's slot
		;holds the iterator over the form, the value's slot its end, they
		;are not needed till after.
		(vp-cpy-rr :r0 :r10)
		(call :list :create :nil '(:r0))
		(assign {form} '(:r1))
		(assign '(:r0) {args})
		(assign '((:r1 +array_length)) '(:r1))
		(vp-sub-cr 1 :r1)
		(vpif '(:r1 = 0))
			(vp-cpy-rr :r10 :r0)
		(else)
			(call :array :set_cap '(:r0 :r1))
			(assign {form} '(:r1))
			(class/array/get_both :r1 :r2 :r3)
			(vp-add-cr +ptr_size :r2)
			(assign '(:r3) {value})
			(vp-cpy-rr :r10 :r0)
			(loop-start)
				(assign '(:r2) {form})
				(call :lisp :repl_eval '(:r0 (:r2 0)) '(:r0 :r1))
			(errorcase
				(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r2 :r3))
				(vpif '(:r2 = :r3))
					(assign '(:r1) {value})
					(goto 'error)
				(endif))
				(assign {args, form, value} '(:r7 :r2 :r3))
				(assign '((:r7 +array_length) (:r7 +array_begin)) '(:r4 :r5))
				(vp-cpy-rr :r4 :r6)
				(vp-shl-cr (log2 +ptr_size) :r6)
				(vp-add-cr 1 :r4)
				(vp-add-rr :r5 :r6)
				(assign '(:r4 :r1) '((:r7 +array_length) (:r6 0)))
				(vp-add-cr +ptr_size :r2)
			(loop-until '(:r2 = :r3))
		(endif)
		(assign {args, func} '(:r1 :r2))
		(call :lisp :repl_apply '(:r0 :r1 :r2) {_, value})
	(vp-label 'error)
		(call :obj :deref {args})
		(call :obj :deref {func})
		(lisp-this :r0)
		(assign {value} '(:r1))
		(exit :lisp :repl_eval '(:r0 :r1))
		(return)
	(errorcase
	(vp-label 'funcall_exit)
		;the function position gave an error, it is the value
		(exit :lisp :repl_eval '(:r0 :r1))
		(return))
	(default)
	(vp-label 'toself)
		;eval to self
		(class/obj/ref :r1 :r2)
	(endswitch)

	(exit :lisp :repl_eval '(:r0 :r1))
	(vp-ret)

	(pop-scope-syms)

(def-func-end)

(def-method :lisp :repl_eval_list)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this)
		(pptr iter_begin iter_end))

	(push-scope)
	(entry :lisp :repl_eval_list '(:r0 :r1))

	(assign '((:r1 +array_begin) (:r1 +array_length) (:r0 +lisp_sym_nil)) '(:r3 :r2 :r1))
	(switch 'exit)
	(vpcase '(:r2 /= 0))
		(vp-shl-cr (log2 +long_size) :r2)
		(vp-add-rr :r3 :r2)
		(assign '(:r0 :r2) {this, iter_end})
		(loop-start)
			(assign '(:r3) {iter_begin})
			(call :lisp :repl_eval '(:r0 (:r3 0)) '(:r0 :r1))
		(errorcase
			(assign '((:r1 +obj_vtable) (:r0 +lisp_error)) '(:r3 :r2))
			(breakif '(:r2 = :r3) 'exit))
			(assign {iter_begin} '(:r3))
			(assign '((:r3 0) :r1) '(:r0 (:r3 0)))
			(call :obj :deref '(:r0))
			(assign {iter_begin, iter_end, this} '(:r3 :r2 :r0))
			(vp-add-cr +ptr_size :r3)
		(loop-until '(:r3 = :r2))
		(vp-cpy-ir :r3 (neg +ptr_size) :r1)
	(default)
		(class/obj/ref :r1 :r2)
	(endswitch)

	(exit :lisp :repl_eval_list '(:r0 :r1))
	(pop-scope)
	(return)

(def-func-end)
