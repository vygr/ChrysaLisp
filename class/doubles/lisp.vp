(include "lib/asm/func.inc")
(include "./class.inc")
(include "././double/class.inc")
(include "././lisp/class.inc")

(def-method :doubles :lisp_quant)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	(vp-rdef (dst iter_begin doubles1 tol this args argc len1 len2)
		'(:r0 :r1 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry :doubles :lisp_quant '(:r0 :r1))
	(assign '(:r0 :r1) `(,this ,args))

	(gotoif-lisp-args-sig 'error args 2 3)

	(assign `((,args +array_length) (,args +array_begin)) `(,argc ,iter_begin))
	(array-get-args iter_begin `(,doubles1 ,tol))
	(assign `((,doubles1 +array_length)) `(,len1))
	(gotoif `(,len1 = 0) 'error)
	(vpif `(,argc = 2))
		(call :doubles :create :nil `(,dst))
		(call :doubles :set_cap `(,dst ,len1) `(,dst) :r2)
		(assign `(,len1) `((,dst +array_length)))
	(else)
		(vp-load-rcr iter_begin (* +ptr_size 2) dst)
		(assign `((,dst +array_length)) `(,len2))
		(gotoif `(,len1 > ,len2) 'error)
		(call :obj :ref `(,dst) `(,dst))
	(endif)
	(call :doubles :quant `(,dst ,doubles1 (,tol +num_value)) `(,dst))

	(exit :doubles :lisp_quant `(,this ,dst))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(quant doubles tol [out])" +error_msg_wrong_types))
	(signature '(:DOUBLES :DOUBLE :DOUBLES))

(def-func-end)

(def-method :doubles :lisp_mat4x4_mul)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :r11-:r12, :d0-:d15

	(vp-rdef (dst iter_begin doubles1 doubles2 this args argc len)
		'(:r0 :r6 :r7 :r8 :r9 :r1 :r11 :r12))

	(entry :doubles :lisp_mat4x4_mul `(,this ,args))

	(gotoif-lisp-args-sig 'error args 2 3)

	(assign `((,args +array_length) (,args +array_begin)) `(,argc ,iter_begin))
	(array-get-args iter_begin `(,doubles1 ,doubles2))

	(assign `((,doubles1 +array_length)) `(,len))
	(gotoif `(,len /= 16) 'error)
	(assign `((,doubles2 +array_length)) `(,len))
	(gotoif `(,len /= 16) 'error)

	(vpif `(,argc = 2))
		(call :doubles :create :nil `(,dst))
		(call :doubles :set_cap `(,dst 16) `(,dst) :r2)
		(call :doubles :set_length `(,dst 16) `(,dst _))
	(else)
		(vp-load-rcr iter_begin (* +ptr_size 2) dst)
		(assign `((,dst +array_length)) `(,len))
		(gotoif `(,len < 16) 'error)
		(call :obj :ref `(,dst) `(,dst))
	(endif)
	(call :doubles :mat4x4_mul `(,dst ,doubles1 ,doubles2) `(,dst))

	(exit :doubles :lisp_mat4x4_mul `(,this ,dst))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(mat4x4-mul ma mb [out])" +error_msg_wrong_types))
	(signature '(:DOUBLES :DOUBLES :DOUBLES))

(def-func-end)

(def-method :doubles :lisp_mat4x4_v4_mul)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :r11-:r12, :d0-:d15

	(vp-rdef (dst iter_begin doubles1 doubles2 this args argc len)
		'(:r0 :r6 :r7 :r8 :r9 :r1 :r11 :r12))

	(entry :doubles :lisp_mat4x4_v4_mul `(,this ,args))

	(gotoif-lisp-args-sig 'error args 2 3)

	(assign `((,args +array_length) (,args +array_begin)) `(,argc ,iter_begin))
	(array-get-args iter_begin `(,doubles1 ,doubles2))

	(assign `((,doubles1 +array_length)) `(,len))
	(gotoif `(,len /= 16) 'error)

	(assign `((,doubles2 +array_length)) `(,len))
	(gotoif `(,len < 4) 'error)

	(vpif `(,argc = 2))
		(call :doubles :create :nil `(,dst))
		(call :doubles :set_cap `(,dst ,len) `(,dst) :r2)
		(assign `(,len) `((,dst +array_length)))
	(else)
		(vp-load-rcr iter_begin (* +ptr_size 2) dst)
		(assign `((,dst +array_length)) `(,len))
		(gotoif `(,len < 4) 'error)
		(call :obj :ref `(,dst) `(,dst))
	(endif)
	(call :doubles :mat4x4_v4_mul `(,dst ,doubles1 ,doubles2) `(,dst))

	(exit :doubles :lisp_mat4x4_v4_mul `(,this ,dst))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(mat4x4-v4-mul ma v [out])" +error_msg_wrong_types))
	(signature '(:DOUBLES :DOUBLES :DOUBLES))

(def-func-end)

