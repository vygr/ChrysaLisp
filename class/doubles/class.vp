(def-method :doubles :scale)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source doubles object, can be same (ptr)
	;:r2 = scale (double)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r1-:r4, :d0-:d1

	(vp-rdef (dst src1 dst1 idx1 idx2))
	(vp-ddef (e0 scale))

	(entry :doubles :scale `(,dst ,src1 ,scale))

	(vec-map-idx (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-mul-dd scale %0) %0))

