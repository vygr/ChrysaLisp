(def-method :doubles :div)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source1 doubles object, can be same (ptr)
	;:r2 = source2 doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-ddef (e0 e1 zero))

	(entry :doubles :div `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = ,zero) 'error)
			(vp-div-dd %1 %0) %0)
		(#	(vp-cvt-rd idx1 zero)))

	(exit :doubles :div `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :doubles :div `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :doubles :mod)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source1 doubles object, can be same (ptr)
	;:r2 = source2 doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r6, :d0-:d3

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 trunc))
	(vp-ddef (e0 e1 ftrunc zero))

	(entry :doubles :mod `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = ,zero) 'error)
			(vp-cpy-dd %0 ftrunc)
			(vp-div-dd %1 ftrunc)
			(vp-cvt-dr ftrunc trunc)
			(vp-cvt-rd trunc ftrunc)
			(vp-mul-dd %1 ftrunc)
			(vp-sub-dd ftrunc %0)
			%0)
		(#	(vp-cvt-rd idx1 zero)))

	(exit :doubles :mod `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :doubles :mod `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :doubles :frac)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r1-:r5, :d0-:d3

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-ddef (e0 ftrunc one zero))

	(entry :doubles :frac `(,dst ,src1))

	(vec-map-idx (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-dr %0 trunc)
			(vp-cvt-rd trunc ftrunc)
			(vp-sub-dd ftrunc %0)
			(vpif `(,%%0 < ,zero))
				(vp-add-dd one %0)
			(endif)
			%0)
		(# (vp-cvt-rd idx1 zero)
			(vp-cpy-cr 1 trunc)
			(vp-cvt-rd trunc one)))

	(exit :doubles :frac `(,dst))
	(vp-ret)

(def-func-end)

(def-method :doubles :floor)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-ddef (e0 ftrunc one))

	(entry :doubles :floor `(,dst ,src1))

	(vec-map-idx (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-dr %0 trunc)
			(vp-cvt-rd trunc ftrunc)
			(vpif `(,ftrunc > ,%%0))
				(vp-sub-dd one ftrunc)
			(endif)
			ftrunc)
		(#	(vp-cpy-cr 1 trunc)
			(vp-cvt-rd trunc one)))

	(exit :doubles :floor `(,dst))
	(vp-ret)

(def-func-end)

