	(vp-ret)

(def-func-end)

(def-method :doubles :add_scaled)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source1 doubles object, can be same (ptr)
	;:r2 = source2 doubles object, can be same (ptr)
	;:r3 = scale (double)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2
	;info
	;each of the first plus each of the second times the scale, in one
	;pass, a multiply then an add, so rounded twice as by scale then add

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-ddef (e0 e1 scale))

	(entry :doubles :add_scaled `(,dst ,src1 ,src2 ,scale))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-dd scale %1) (vp-add-dd %1 %0) %0))

	(exit :doubles :add_scaled `(,dst))
	(vp-ret)

(def-func-end)

(def-method :doubles :convert)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source nums object, of any kind (ptr)
	;:r3 = 1 to read a raw source signed, else 0 (uint)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r2-:r6, :d0-:d15
	;info
	;made the source's length, each element of it converted

	(nums-convert-method :doubles :doubles)

(def-func-end)

(def-method :doubles :sum)
	;inputs
	;:r0 = doubles object (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = sum (double)
	;trashes
	;:r1-:r3, :d0-:d4
	;info
	;four running sums over blocks of four, the rest into the first, then
	;the four added: no add waits on the one before it, so a long vector
	;goes as fast as it can be loaded

	(vp-rdef (this src end quad))
	(vp-ddef (sum s1 s2 s3 e0))

	(entry :doubles :sum `(,this))

	(assign `((,this +array_length) (,this +array_begin)) `(,end ,src))
	(vp-xor-rr quad quad)
	(vp-cvt-rd quad sum)
	(vp-cpy-dd sum s1)
	(vp-cpy-dd sum s2)
	(vp-cpy-dd sum s3)
	(vp-cpy-rr end quad)
	(vp-and-cr -4 quad)
	(vp-shl-cr (log2 +long_size) end)
	(vp-shl-cr (log2 +long_size) quad)
	(vp-add-rr src end)
	(vp-add-rr src quad)
	(vpif `(,src /= ,quad))
		(loop-start)
			(assign `((,src 0)) `(,e0))
			(vp-add-dd e0 sum)
			(assign `((,src ,+long_size)) `(,e0))
			(vp-add-dd e0 s1)
			(assign `((,src ,(* 2 +long_size))) `(,e0))
			(vp-add-dd e0 s2)
			(assign `((,src ,(* 3 +long_size))) `(,e0))
			(vp-add-dd e0 s3)
			(vp-add-cr (* 4 +long_size) src)
		(loop-until `(,src = ,quad))
	(endif)
	(vpif `(,src /= ,end))
		(loop-start)
			(assign `((,src 0)) `(,e0))
			(vp-add-dd e0 sum)
			(vp-add-cr +long_size src)
		(loop-until `(,src = ,end))
	(endif)
	(vp-add-dd s1 sum)
	(vp-add-dd s3 s2)
	(vp-add-dd s2 sum)

	(exit :doubles :sum `(,this ,sum))
	(vp-ret)

(def-func-end)

(def-method :doubles :dot)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = dot product (double)
	;trashes
	;:r1-:r4, :d0-:d5
	;info
	;four running sums over blocks of four, the rest into the first, then
	;the four added: no add waits on the one before it, so a long vector
	;goes as fast as it can be loaded

	(vp-rdef (this src2 src1 end quad))
	(vp-ddef (dot s1 s2 s3 e0 e1))

	(entry :doubles :dot `(,this ,src2))

	(assign `((,this +array_length) (,this +array_begin) (,src2 +array_begin)) `(,end ,src1 ,src2))
	(vp-xor-rr quad quad)
	(vp-cvt-rd quad dot)
	(vp-cpy-dd dot s1)
	(vp-cpy-dd dot s2)
	(vp-cpy-dd dot s3)
	(vp-cpy-rr end quad)
	(vp-and-cr -4 quad)
	(vp-shl-cr (log2 +long_size) end)
	(vp-shl-cr (log2 +long_size) quad)
	(vp-add-rr src1 end)
	(vp-add-rr src1 quad)
	(vpif `(,src1 /= ,quad))
		(loop-start)
			(assign `((,src1 0) (,src2 0)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 dot)
			(assign `((,src1 ,+long_size) (,src2 ,+long_size)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s1)
			(assign `((,src1 ,(* 2 +long_size)) (,src2 ,(* 2 +long_size))) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s2)
			(assign `((,src1 ,(* 3 +long_size)) (,src2 ,(* 3 +long_size))) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s3)
			(vp-add-cr (* 4 +long_size) src1)
			(vp-add-cr (* 4 +long_size) src2)
		(loop-until `(,src1 = ,quad))
	(endif)
	(vpif `(,src1 /= ,end))
		(loop-start)
			(assign `((,src1 0) (,src2 0)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 dot)
			(vp-add-cr +long_size src1)
			(vp-add-cr +long_size src2)
		(loop-until `(,src1 = ,end))
	(endif)
	(vp-add-dd s1 dot)
	(vp-add-dd s3 s2)
	(vp-add-dd s2 dot)

	(exit :doubles :dot `(,this ,dot))
	(vp-ret)

(def-func-end)

(def-method :doubles :quant)
	;inputs
	;:r0 = doubles object (dst)
	;:r1 = source doubles object (src)
	;:r2 = tolerance double (double)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r1-:r4, :d0-:d4

	(vp-rdef (dst src1 dst1 src_end trunc))
	(vp-ddef (e0 tol half one ftrunc))

	(entry :doubles :quant `(,dst ,src1 ,tol))

	; Load constants
	(vp-lea-pr 'fn_consts trunc)
	(load-fields trunc
		(fn-consts (n2d 0.5) (n2d 1.0))
		`(,half ,one))

	(assign `((,src1 +array_length)) `(,src_end))
	(vp-simd vp-load-rcr `(,src1 ,dst) `(,+array_begin) `(,src1 ,dst1))
	(vp-shl-cr (log2 +ptr_size) src_end)
	(vp-add-rr src1 src_end)

	(vec-loop-until `(,src1) `(,e0) src_end dst1
		(#	(vp-div-dd tol %0)
			(vp-add-dd half %0)
			(vp-cvt-dr %0 trunc)
			(vp-cvt-rd trunc ftrunc)
			(vpif `(,ftrunc > ,%%0))
				(vp-sub-dd one ftrunc)
			(endif)
			(vp-mul-dd tol ftrunc)
			ftrunc))

	(exit :doubles :quant `(,dst))
	(vp-ret)

(def-func-end)

(def-method :doubles :mat4x4_mul)
	;inputs
	;:r0 = output doubles object (ptr)
	;:r1 = ma doubles object (ptr)
	;:r2 = mb doubles object (ptr)
	;outputs
	;:r0 = output doubles object (ptr)
	;trashes
	;:r1-:r3, :d0-:d12

	(vp-rdef (this ptr_a ptr_b ptr_o))
	(vp-ddef (o0 o1 o2 o3 o4 o5 o6 o7 t0 t1 t2 t3 s0))

	(entry :doubles :mat4x4_mul `(,this ,ptr_a ,ptr_b))

	(vp-simd vp-load-rcr `(,ptr_a ,ptr_b ,this) `(,+array_begin) `(,ptr_a ,ptr_b ,ptr_o))
	; batch 1
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 0 +long_size) ,(* 1 +long_size) ,(* 2 +long_size) ,(* 3 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 0 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-cpy-dd `(,t0 ,t1 ,t2 ,t3) `(,o0 ,o1 ,o2 ,o3))
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 0 +long_size) ,(* 1 +long_size) ,(* 2 +long_size) ,(* 3 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 4 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-cpy-dd `(,t0 ,t1 ,t2 ,t3) `(,o4 ,o5 ,o6 ,o7))
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 4 +long_size) ,(* 5 +long_size) ,(* 6 +long_size) ,(* 7 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 1 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-add-dd `(,t0 ,t1 ,t2 ,t3) `(,o0 ,o1 ,o2 ,o3))
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 4 +long_size) ,(* 5 +long_size) ,(* 6 +long_size) ,(* 7 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 5 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-add-dd `(,t0 ,t1 ,t2 ,t3) `(,o4 ,o5 ,o6 ,o7))
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 8 +long_size) ,(* 9 +long_size) ,(* 10 +long_size) ,(* 11 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 2 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-add-dd `(,t0 ,t1 ,t2 ,t3) `(,o0 ,o1 ,o2 ,o3))
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 8 +long_size) ,(* 9 +long_size) ,(* 10 +long_size) ,(* 11 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 6 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-add-dd `(,t0 ,t1 ,t2 ,t3) `(,o4 ,o5 ,o6 ,o7))
	(vp-simd vp-load-rcd `(,ptr_b)
		`(,(* 12 +long_size) ,(* 13 +long_size) ,(* 14 +long_size) ,(* 15 +long_size))
		`(,t0 ,t1 ,t2 ,t3))
	(vp-load-rcd ptr_a (* 3 +long_size) s0)
	(vp-simd vp-mul-dd `(,s0) `(,t0 ,t1 ,t2 ,t3))
	(vp-simd vp-add-dd `(,t0 ,t1 ,t2 ,t3) `(,o0 ,o1 ,o2 ,o3))
	(vp-simd vp-load-rcd `(,ptr_b)
