(def-method :doubles :sum)
	;inputs
	;:r0 = doubles object (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = sum (double)
	;trashes
	;:r1-:r3, :d0-:d1

	(vp-rdef (this src1 src_end tmp))
	(vp-ddef (sum e0))

	(entry :doubles :sum `(,this))

	(vec-reduce (list this) (list e0) (list src1) src_end
		(# (vp-add-dd %0 sum))
		(# (vp-cpy-cr 0 tmp)
			(vp-cvt-rd tmp sum)))

	(exit :doubles :sum `(,this ,sum))
	(vp-ret)

(def-func-end)

(def-method :doubles :dot)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = dot product (double)
	;trashes
	;:r1-:r4, :d0-:d2

	(vp-rdef (this src2 src1 idx1 idx2))
	(vp-ddef (dot e0 e1))

	(entry :doubles :dot `(,this ,src2))

	(vec-reduce-idx (list this src2) (list e0 e1) (list src1 src2) (list idx1 idx2)
		(# (vp-mul-dd %0 %1) (vp-add-dd %1 dot))
		(# (vp-cvt-rd idx1 dot)))

	(exit :doubles :dot `(,this ,dot))
	(vp-ret)

(def-func-end)

(def-method :doubles :quant)
	;inputs
	;:r0 = doubles object (dst)
	;:r1 = source doubles object (src)
	;:r2 = tolerance double (double)
	;outputs
	;:r0 = doubles object (ptr)
	;trashes
	;:r1-:r4, :d0-:d4

	(vp-rdef (dst src1 dst1 src_end trunc))
	(vp-ddef (e0 tol half one ftrunc))

	(entry :doubles :quant `(,dst ,src1 ,tol))

	; Load constants
	(vp-lea-pr 'fn_consts trunc)
	(load-fields trunc
		(fn-consts (n2d 0.5) (n2d 1.0))
		`(,half ,one))

	(assign `((,src1 +array_length)) `(,src_end))
	(vp-simd vp-load-rcr `(,src1 ,dst) `(,+array_begin) `(,src1 ,dst1))
	(vp-shl-cr (log2 +ptr_size) src_end)
	(vp-add-rr src1 src_end)

	(vec-loop-until `(,src1) `(,e0) src_end dst1
		(#	(vp-div-dd tol %0)
			(vp-add-dd half %0)
			(vp-cvt-dr %0 trunc)
			(vp-cvt-rd trunc ftrunc)
			(vpif `(,ftrunc > ,%%0))
				(vp-sub-dd one ftrunc)
			(endif)
			(vp-mul-dd tol ftrunc)
			ftrunc))

	(exit :doubles :quant `(,dst))
	(vp-ret)

(def-func-end)

(def-method :doubles :mat4x4_mul)
