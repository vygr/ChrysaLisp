(include "lib/asm/func.inc")
(include "./class.inc")
(include "././list/class.inc")

(gen-create :doubles)
	;outputs
	;:r0 = 0 if error, else doubles object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :doubles)
(gen-type :doubles)
	;inputs
	;:r0 = doubles object (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :doubles :add)
	;inputs
	;:r0 = doubles object (ptr)
	;:r1 = source1 doubles object, can be same (ptr)
	;:r2 = source2 doubles object, can be same (ptr)
	;outputs
	;:r0 = doubles object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-ddef (e0 e1))

	(entry :doubles :add `(,dst ,src1 ,src2))

	(vec-map-idx (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-add-dd %1 %0) %0))

	(exit :doubles :add `(,dst -1))
	(vp-ret)

(def-func-end)

