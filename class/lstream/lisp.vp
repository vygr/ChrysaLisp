(include "lib/asm/func.inc")
(include "./class.inc")
(include "././lisp/class.inc")

(def-method :lstream :lisp_create)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15

	(entry :lstream :lisp_create '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1 3)

	;fill, and seek and write if they are given: a :nil is one that is not
	(assign '((:r1 +array_begin) (:r1 +array_length) (:r0 +lisp_sym_nil)) '(:r4 :r5 :r6))
	(vp-push :r0)
	(assign '((:r4 0)) '(:r0))
	(vp-xor-rr :r1 :r1)
	(vp-xor-rr :r3 :r3)
	(vpif '(:r5 >= 2))
		(assign '((:r4 +ptr_size)) '(:r1))
		(vpif '(:r1 = :r6))
			(vp-xor-rr :r1 :r1)
		(endif)
		(vpif '(:r5 >= 3))
			(assign '((:r4 (* 2 +ptr_size))) '(:r3))
			(vpif '(:r3 = :r6))
				(vp-xor-rr :r3 :r3)
			(endif)
		(endif)
	(endif)
	(class/obj/ref :r0 :r2)
	(vpif '(:r1 /= 0))
		(class/obj/ref :r1 :r2)
	(endif)
	(vpif '(:r3 /= 0))
		(class/obj/ref :r3 :r2)
	(endif)
	(assign '((:rsp 0)) '(:r2))
	(call :lstream :create '(:r0 :r1 :r2 :r3) '(:r1))
	(vp-pop :r0)

	(exit :lstream :lisp_create '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(lisp-stream fill [seek write])" +error_msg_wrong_types))
	(signature '(:obj :obj :obj))

(def-func-end)
