(include "lib/asm/func.inc")
(include "./class.inc")
(include "././num/class.inc")
(include "././lisp/class.inc")

;a stream that is read from Lisp functions. What is next of it is asked of
;one, which gives a str, of any length, or :nil at the end. Where it is
;read from is asked of the other, if there is one. It keeps the one str at
;a time, so what it is a stream of can be of any size, and can be anywhere
;a Lisp function can get it from.
;
;And one that is written to a Lisp function, if it is given one. What is
;written is kept till there is a buffer of it, and the function is given
;that, a str, and :nil. When the stream is flushed it is given what there
;is, which may be nothing, and :t: that is where it does what makes what
;was written so. A stream that is let go of is flushed first, as a file
;is, so the function is called from the :deinit, whatever let go of it.

(gen-create :lstream)
	;inputs
	;:r0 = fill function object (ptr)
	;:r1 = seek function object, 0 if none (ptr)
	;:r2 = lisp object (ptr)
	;:r3 = write function object, 0 if none (ptr)
	;outputs
	;:r0 = 0 if error, else lstream object (ptr)
	;trashes
	;:r0-:r5, :r14, :d0-:d15
(gen-vtable :lstream)
(gen-type :lstream)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :lstream :init)
	;inputs
	;:r0 = lstream object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = fill function object (ptr)
	;:r3 = seek function object, 0 if none (ptr)
	;:r4 = lisp object (ptr)
	;:r5 = write function object, 0 if none (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d15

	(entry :lstream :init '(:r0 :r1 :r2 :r3 :r4 :r5))

	;the functions are the stream's from now, the lisp is whose it is
	(save-fields :r0 '(+lstream_fill +lstream_seek +lstream_lisp +lstream_write) '(:r2 :r3 :r4 :r5))
	;and no fault yet
	(assign '(0) '(:r2))
	(assign '(:r2) '((:r0 +lstream_fault)))
	(vpif '(:r5 = 0))
		;init parent, with nothing read yet
		(s-jump :lstream :init '(:r0 :r1 0 0 0 0))
	(endif)

	;one that is written has a buffer, all of it to be written to
	(vp-push :r0 :r1)
	(call :sys_mem :alloc '(lstream_buf_size) '(:r3 :r2))
	(vp-pop :r0 :r1)
	(assign '(:r2) '((:r0 +lstream_buf_len)))
	(s-jump :lstream :init '(:r0 :r1 0 :r3 :r3 :r2))

(def-func-end)

(def-method :lstream :deinit)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(entry :lstream :deinit '(:r0))

	;one that is written is flushed as it goes, as a file is. What is
	;called is Lisp, which keeps nothing: these are kept so that to let
	;go of a stream trashes no more than it did
	(assign '((:r0 +lstream_write)) '(:r1))
	(vpif '(:r1 /= 0))
		(vp-push :r10 :r11 :r12 :r13 :r14)
		(call :lstream :put '(:r0 1) '(:r0))
		(vp-pop :r10 :r11 :r12 :r13 :r14)
	(endif)

	(vp-push :r0)
	(call :obj :deref '((:r0 +lstream_fill)))
	(assign '((:rsp 0)) '(:r0))
	(call :obj :deref_if '((:r0 +lstream_seek)))
	(assign '((:rsp 0)) '(:r0))
	(call :obj :deref_if '((:r0 +lstream_write)))
	(assign '((:rsp 0)) '(:r0))
	(call :obj :deref_if '((:r0 +lstream_fault)))
	(vp-pop :r0)

	;parent deinit
	(s-jump :lstream :deinit '(:r0))

(def-func-end)

(def-method :lstream :write_next)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(entry :lstream :write_next '(:r0))

	;the buffer is full, the write function is given it
	(vp-push :r10 :r11 :r12 :r13 :r14)
	(call :lstream :put '(:r0 0) '(:r0))
	(vp-pop :r10 :r11 :r12 :r13 :r14)

	(exit :lstream :write_next '(:r0))
	(vp-ret)

(def-func-end)

(def-method :lstream :flush)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15

	(entry :lstream :flush '(:r0))

	(assign '((:r0 +lstream_write)) '(:r1))
	(vpif '(:r1 = 0))
		;one that is only read, as any stream
		(s-call :lstream :flush '(:r0) '(:r0))
	(else)
		;the write function is given what there is, and told it is a flush
		(vp-push :r10 :r11 :r12 :r13 :r14)
		(call :lstream :put '(:r0 1) '(:r0))
		(vp-pop :r10 :r11 :r12 :r13 :r14)
	(endif)

	(exit :lstream :flush '(:r0))
	(vp-ret)

(def-func-end)

(def-method :lstream :put)
	;inputs
	;:r0 = lstream object (ptr)
	;:r1 = 0 if the buffer is full, else it is a flush (long)
	;outputs
	;:r0 = lstream object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	;the frame is what Lisp, which keeps nothing, is called over: the rest
	;is in registers the other calls leave
	(structure slot 0
		(ptr this args))

	(vp-rdef (this flush args len) '(:r6 :r7 :r8 :r9))

	(entry :lstream :put `(,this ,flush))

	(assign `((,this +lstream_write)) '(:r2))
	(vpif '(:r2 /= 0))
		;what has been written, a stream not written to yet has no bufp
		(load-fields this '(+stream_buffer +stream_bufp) `(:r3 ,len))
		(vpif `(,len /= 0))
			(vp-sub-rr :r3 len)
		(endif)

		;the function is given it, and if this is a flush
		(vp-alloc slot_size)
		(call :list :create :nil `(,args))
		(save-fields :rsp '(slot_this slot_args) `(,this ,args))
		(call :str :create_from_buffer `((,this +stream_buffer) ,len) '(:r1))
		(call :list :push_back `(,args :r1))
		(assign `((,this +lstream_lisp)) '(:r0))
		(vpif `(,flush = 0))
			(assign '((:r0 +lisp_sym_nil)) '(:r1))
		(else)
			(assign '((:r0 +lisp_sym_t)) '(:r1))
		(endif)
		(class/obj/ref :r1 :r2)
		(call :list :push_back `(,args :r1))
		;the value comes back where the flag was
		(call :lisp :repl_apply `((,this +lstream_lisp) ,args (,this +lstream_write)) `(_ ,flush))
		(call :obj :deref '((:rsp slot_args)))
		(call :obj :deref_if `(,flush))

		;and all the buffer is to be written to again
		(assign '((:rsp slot_this)) `(,this))
		(vp-free slot_size)
		(load-fields this '(+stream_buffer +lstream_buf_len) '(:r1 :r2))
		(vp-add-rr :r1 :r2)
		(save-fields this '(+stream_bufp +stream_bufe) '(:r1 :r2))
	(endif)

	(exit :lstream :put `(,this))
	(vp-ret)

(def-func-end)

(def-method :lstream :read_next)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = -1 for EOF, else more data
	;trashes
	;:r1-:r8, :r14, :d0-:d15

	(entry :lstream :read_next '(:r0))

	;what is called is Lisp, which keeps nothing. These are kept so that
	;to read a stream by its vtable trashes no more than the other kinds
	;of stream do: they trash the rest, so those are not kept here
	(vp-push :r9 :r10 :r11 :r12 :r13)
	(call :lstream :fill '(:r0) '(:r0 :r1))
	(vp-pop :r9 :r10 :r11 :r12 :r13)

	(exit :lstream :read_next '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lstream :fault)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = 0, else what the fill that ended it gave (ptr)
	;trashes
	;:r1

	(entry :lstream :fault '(:r0))
	(exit :lstream :fault '(:r0 (:r0 +lstream_fault)))
	(vp-ret)

(def-func-end)

(def-method :lstream :fill)
	;inputs
	;:r0 = lstream object (ptr)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = -1 for EOF, else more data
	;trashes
	;:r1-:r14, :d0-:d15

	;the frame is what Lisp, which keeps nothing, is called over: the rest
	;is in registers the other calls leave
	(structure slot 0
		(ptr this args))

	(vp-rdef (this value res) '(:r6 :r7 :r8))

	(vp-alloc slot_size)
	(entry :lstream :fill `(,this))

	;what was read is let go of, and any fault of the last fill
	(call :obj :deref_if `((,this +stream_object)))
	(vp-xor-rr :r1 :r1)
	(save-fields this '(+stream_object +stream_bufp +stream_bufe) '(:r1 :r1 :r1))
	(call :obj :deref_if `((,this +lstream_fault)))
	(vp-xor-rr :r1 :r1)
	(assign '(:r1) `((,this +lstream_fault)))

	;the next of it is asked for
	(call :list :create :nil '(:r1))
	(save-fields :rsp '(slot_this slot_args) `(,this :r1))
	(call :lisp :repl_apply `((,this +lstream_lisp) :r1 (,this +lstream_fill)) `(_ ,value))
	(call :obj :deref '((:rsp slot_args)))

	;a str with something in it is more, an empty one or :nil the end, and
	;anything else is the end of a fault, kept for (stream-fault) to give
	(assign '((:rsp slot_this) -1) `(,this ,res))
	(assign `((,value +obj_vtable) (@ ,(f-path :str :vtable))) '(:r3 :r4))
	(vpif '(:r3 = :r4))
		(assign `((,value +str_length)) '(:r3))
		(vpif '(:r3 /= 0))
			(vp-lea-rcr value +str_data :r4)
			(vp-add-rr :r4 :r3)
			(save-fields this '(+stream_object +stream_bufp +stream_bufe) `(,value :r4 :r3))
			(vp-xor-rr res res)
			(vp-xor-rr value value)
		(endif)
	(else)
		(assign `((,this +lstream_lisp)) '(:r3))
		(assign '((:r3 +lisp_sym_nil)) '(:r3))
		(vpif `(,value /= :r3))
			(assign `(,value) `((,this +lstream_fault)))
			(vp-xor-rr value value)
		(endif)
	(endif)
	(call :obj :deref_if `(,value))

	(exit :lstream :fill `(,this ,res))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :lstream :seek)
	;inputs
	;:r0 = lstream object (ptr)
	;:r1 = offset (long)
	;:r2 = whence (uint)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = -1 for error, else file position
	;trashes
	;:r1-:r11, :r14, :d0-:d15

	(entry :lstream :seek '(:r0 :r1 :r2))

	;what is called is Lisp, which keeps nothing. These are kept so that
	;to seek a stream by its vtable trashes no more than the other kinds
	;of stream do: they trash the rest, so those are not kept here
	(vp-push :r12 :r13)
	(call :lstream :seek_to '(:r0 :r1 :r2) '(:r0 :r1))
	(vp-pop :r12 :r13)

	(exit :lstream :seek '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :lstream :seek_to)
	;inputs
	;:r0 = lstream object (ptr)
	;:r1 = offset (long)
	;:r2 = whence (uint)
	;outputs
	;:r0 = lstream object (ptr)
	;:r1 = -1 for error, else file position
	;trashes
	;:r1-:r14, :d0-:d15

	;the frame is what Lisp, which keeps nothing, is called over: the rest
	;is in registers the other calls leave
	(structure slot 0
		(ptr this args))

	(vp-rdef (this offset whence args pos) '(:r6 :r7 :r8 :r9 :r10))

	(entry :lstream :seek_to `(,this ,offset ,whence))
	(assign '(-1) `(,pos))

	(assign `((,this +lstream_seek)) '(:r3))
	(vpif '(:r3 /= 0))
		;from where it is: that is what has been read of it, which is less
		;than what has been asked for by what is left of the last str
		(vpif `(,whence = 1))
			(load-fields this '(+stream_bufp +stream_bufe) '(:r3 :r4))
			(vp-sub-rr :r3 :r4)
			(vp-sub-rr :r4 offset)
		(endif)

		(vp-alloc slot_size)
		(call :list :create :nil `(,args))
		(save-fields :rsp '(slot_this slot_args) `(,this ,args))
		(call :num :create `(,offset) '(:r1))
		(call :list :push_back `(,args :r1))
		(call :num :create `(,whence) '(:r1))
		(call :list :push_back `(,args :r1))
		;the value comes back where the offset was
		(call :lisp :repl_apply `((,this +lstream_lisp) ,args (,this +lstream_seek)) `(_ ,offset))
		(call :obj :deref '((:rsp slot_args)))
		(assign '((:rsp slot_this) -1) `(,this ,pos))
		(vp-free slot_size)

		;a number is where it is now, anything else and it did not
		(assign `((,offset +obj_vtable) (@ ,(f-path :num :vtable))) '(:r2 :r3))
		(vpif '(:r2 = :r3))
			(assign `((,offset +num_value)) `(,pos))
			;what was read is let go of, the next read is from there
			(call :obj :deref_if `((,this +stream_object)))
			(vp-xor-rr :r1 :r1)
			(save-fields this '(+stream_object +stream_bufp +stream_bufe) '(:r1 :r1 :r1))
		(endif)
		(call :obj :deref `(,offset))
	(endif)

	(exit :lstream :seek_to `(,this ,pos))
	(vp-ret)

(def-func-end)
