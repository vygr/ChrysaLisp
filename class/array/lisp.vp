(include "lib/asm/func.inc")
(include "gui/path/class.inc")
(include "././doubles/class.inc")
(include "././num/class.inc")
(include "././lisp/class.inc")

(defun to-array (%0)
	(entry :array (sym (cat :lisp_ (rest %0))) '(:r0 :r1))
	(gotoif-lisp-args-match 'error :r1 :num (:r1 +array_length))
	(assign '(:r0 :r1) '(:r6 :r8))
	(call %0 :create :nil '(:r7))
	(assign '((:r8 +array_length)) '(:r1))
	(assign '(:r1) '((:r7 +array_length)))
	(call %0 :set_cap '(:r7 :r1) :nil :r2)
	(assign '((:r7 +array_begin)) '(:r5))
	(class/array/get_both :r8 :r3 :r4)
	(vpif '(:r3 /= :r4))
		(loop-start)
			(assign '((:r3 0)) '(:r0))
			(vp-simd vp-add-cr `(,+ptr_size) '(:r3 :r5))
			(assign '((:r0 +num_value)) '(:r0))
			(assign '(:r0) `((:r5 ,(neg +ptr_size))))
		(loop-until '(:r3 = :r4))
	(endif)
	(exit :array (sym (cat :lisp_ (rest %0))) '(:r6 :r7))
	(vp-ret))

(def-method :array :lisp_nums)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r8, :d0-:d15

	(to-array :nums)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(nums [num ...])" +error_msg_wrong_types))

(def-func-end)

