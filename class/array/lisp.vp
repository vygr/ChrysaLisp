(def-method :array :lisp_clear)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15
	;info
	;each array emptied, or with an index first, cut there: what is after
	;it let go of, the capacity as it was, nothing copied. The index is as
	;a slice's, -1 the end, so -4 lets the last 3 go, or as many as there
	;are: one before the start is 0, all of it, one past the end is none

	;a clear and a truncate leave these, so no frame
	(vp-rdef (this iter iter_end num args) '(:r3 :r4 :r5 :r6 :r7))

	(entry :array :lisp_clear `(:r0 ,args))

	(vp-cpy-rr :r0 this)
	(class/array/get_both args iter iter_end)
	(gotoif `(,iter = ,iter_end) 'error)
	;a num first is the index each is cut at, none is all of it
	(vp-xor-rr num num)
	(assign `((,iter 0)) '(:r0))
	(f-bind :num :vtable :r1)
	(assign '((:r0 +obj_vtable)) '(:r2))
	(vpif '(:r1 = :r2))
		(vp-cpy-rr :r0 num)
		(vp-add-cr +ptr_size iter)
		(gotoif `(,iter = ,iter_end) 'error)
	(endif)
	;all of them looked at before any is changed: each an array
	(vp-push iter)
	(loop-start)
		(assign `((,iter 0)) '(:r0))
		(call :obj :inst_of `(:r0 (@ ,(f-path :array :vtable))) '(:r0 :r1))
		(gotoif '(:r1 = 0) 'error_pop)
		(vp-add-cr +ptr_size iter)
	(loop-until `(,iter = ,iter_end))
	(vp-pop iter)
	(loop-start)
		(assign `((,iter 0)) '(:r0))
		(vpif `(,num = 0))
			(call :array :clear '(:r0) '(:r0) :r1)
		(else)
			(assign `((:r0 +array_length) (,num +num_value)) '(:r2 :r1))
			(seq-elem-index :r1 :r2)
			(vpif '(:r1 < 0))
				(vp-xor-rr :r1 :r1)
			(endif)
			(vpif '(:r1 < :r2))
				(call :array :truncate '(:r0 :r1) '(:r0) :r2)
			(endif)
		(endif)
		(vp-add-cr +ptr_size iter)
	(loop-until `(,iter = ,iter_end))
	(class/obj/ref :r0 :r1)

	(exit :array :lisp_clear `(,this :r0))
	(vp-ret)

(vp-label 'error_pop)
	(vp-pop iter)
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(clear [idx] array ...)" +error_msg_wrong_types))

(def-func-end)

(def-method :array :lisp_pop)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :d0-:d15

	(entry :array :lisp_pop '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(array-bind-args :r1 '(:r0))
	(assign '((:r0 +array_length)) '(:r1))
	(vpif '(:r1 /= 0))
		(call :array :ref_back '(:r0) '(& :r1) :r1)
	(else)
		(assign '((:rsp 0)) '(:r1))
		(assign '((:r1 +lisp_sym_nil)) '(:r1))
		(class/obj/ref :r1 :r2)
	(endif)
	(vp-pop :r0)

	(exit :array :lisp_pop '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(pop array)" +error_msg_wrong_types))
	(signature '(:array))

(def-func-end)

(def-method :array :lisp_push)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r4, :r6-:r9, :r11-:r13, :d0-:d15
	;info
	;the args onto the end of the first. What each is, is found by a walk
	;back along its classes, which is the check of it too: none of them
	;met, an error. A list, or what is built on one, takes anything, a
	;reference each, (:list :push). An array of numbers or a raw array
	;takes a number, the low bytes of its value, as many as an element of
	;it is, and what has raw data, a str or another of them, its bytes in
	;whole elements, (:get_raw) of it to (:push_raw) of the array. It takes
	;no list, nor any other thing: what was before that is pushed

	(vp-rdef (dst iter iter_end) '(:r11 :r12 :r13))

	(entry :array :lisp_push '(:r0 :r1))

	(vp-push :r0 :r1)
	(assign '((:r1 +array_length)) '(:r2))
	(gotoif '(:r2 < 2) 'error)
	(assign '((:r1 +array_begin)) `(,iter))
	(assign `((,iter 0)) `(,dst))
	;a list first, most of what is pushed to
	(f-bind :list :vtable :r3)
	(f-bind :array :vtable :r4)
	(vp-cpy-rr dst :r0)
	(loop-start)
		(assign '((:r0 +obj_vtable)) '(:r0))
		(gotoif '(:r0 = :r3) 'lists)
		(gotoif '(:r0 = 0) 'error)
	(loop-until '(:r0 = :r4))
	;an array of numbers or a raw array, how wide an element of it is kept
	(vp-shl-cr (log2 +ptr_size) :r2)
	(assign `((& ,iter :r2)) `(,iter_end))
	(vp-add-cr +ptr_size iter)
	(call :seq :get_raw `(,dst) '(& & & :r3) :r1)
	(vp-push :r3)
	(loop-start)
		(assign `((,iter 0)) '(:r0))
		(vp-add-cr +ptr_size iter)
		(f-bind :num :vtable :r2)
		(f-bind :seq :vtable :r3)
		(f-bind :list :vtable :r4)
		(vp-cpy-rr :r0 :r1)
		(loop-start)
			(assign '((:r1 +obj_vtable)) '(:r1))
			(breakif '(:r1 = :r2))
			(gotoif '(:r1 = :r3) 'raw)
			(gotoif '(:r1 = :r4) 'error1)
			(gotoif '(:r1 = 0) 'error1)
		(loop-end)
		;a number
		(assign `((:r0 +num_value) (,dst +array_length)) '(:r2 :r1))
		(vp-push :r2)
		(vp-add-cr 1 :r1)
		(assign '(:r1) `((,dst +array_length)))
		(call :array :set_cap `(,dst :r1) '(:r0) :r2)
		(vp-pop :r2)
		(assign '((:r0 +array_length) (:r0 +array_begin) (:rsp 0)) '(:r1 :r3 :r4))
		(vp-sub-cr 1 :r1)
		(vp-mul-rr :r4 :r1)
		(switch)
		(vpcase '(:r4 = +long_size))
			(assign '(:r2) (list (array-to +long_size :r3 :r1)))
			(break)
		(vpcase '(:r4 = +int_size))
			(assign '(:r2) (list (array-to +int_size :r3 :r1)))
			(break)
		(vpcase '(:r4 = +short_size))
			(assign '(:r2) (list (array-to +short_size :r3 :r1)))
			(break)
		(default)
			(assign '(:r2) (list (array-to 1 :r3 :r1)))
		(endswitch)
	(vp-label 'pushed)
	(loop-until `(,iter = ,iter_end))
	(vp-pop :r3)
	(vp-cpy-rr dst :r1)
	(class/obj/ref :r1 :r2)
	(vp-pop :r0 :r2)

	(exit :array :lisp_push '(:r0 :r1))
	(vp-ret)

(vp-label 'lists)
	(call :list :push `(,dst :r1) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-pop :r0 :r2)

	(exit :array :lisp_push '(:r0 :r1))
	(vp-ret)

(vp-label 'raw)
	(call :seq :get_raw '(:r0) '(& :r1 :r2 :r3) :r4)
	(call :array :push_raw `(,dst :r1 :r2 :r3) :nil :r4)
	(goto 'pushed)

(vp-label 'error1)
	(vp-pop :r3)
(vp-label 'error)
	(vp-pop :r0 :r1)
	(jump :lisp :repl_error '(:r1 "(push array elem ...)" +error_msg_wrong_types))

(def-func-end)

(def-method :array :lisp_cap)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3, :r9-:r13, :d0-:d15

	(vp-rdef (this args argc iter_begin iter_end obj res) '(:r9 :r10 :r11 :r12 :r13))

	(entry :array :lisp_cap `(,this ,args))

	(assign `((,args +array_length)) `(,argc))
	(gotoif `(,argc < 2) 'error)
	(class/array/get_both args iter_begin iter_end)
	(assign `((,iter_begin 0)) `(,args))
	(vp-add-cr +ptr_size iter_begin)
	(f-bind :num :vtable obj)
	(assign `((,args +obj_vtable)) `(,res))
	(gotoif `(,obj /= ,res) 'error)
	(assign `((,args +num_value)) `(,argc))
	(loop-start)
		(assign `((,iter_begin 0)) `(,obj))
		(vp-add-cr +ptr_size iter_begin)
		(call :obj :inst_of `(,obj (@ ,(f-path :array :vtable))) `(,obj ,res))
		(gotoif `(,res = 0) 'error)
		(call :array :set_cap `(,obj ,argc) `(,obj) :r2)
	(loop-until `(,iter_begin = ,iter_end))
	(class/obj/ref obj argc)

	(exit :array :lisp_cap `(,this ,obj))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(cap len array ...)" +error_msg_wrong_types))

(def-func-end)

(def-method :array :lisp_set)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :d0-:d15
	;info
	;the array is checked as it is dispatched on, one walk back along its
	;classes: a :list holds refs, any other :array raw, a number as its
	;value. The index is a :num exactly

	(vp-rdef (a args i len v this vt1 vt2 vt3 vt4))

	(entry :array :lisp_set '(:r0 :r1))

	(gotoif-lisp-args-len 'error1 args /= 3)

	(vp-cpy-rr :r0 this)
	(list-bind-args args `(,a ,i ,v) '(:obj :obj :obj))
	(f-bind :num :vtable vt2)
	(assign `((,i +obj_vtable) (,a +obj_vtable)) `(,vt1 ,vt3))
	(gotoif `(,vt1 /= ,vt2) 'error1)
	(f-bind :list :vtable vt1)
	(f-bind :array :vtable vt4)
	(loop-start)
		(gotoif `(,vt3 = ,vt1) 'walked)
		(gotoif `(,vt3 = ,vt4) 'walked)
		(assign `((,vt3 +obj_vtable)) `(,vt3))
	(loop-until `(,vt3 = 0))
	(goto 'error1)
(vp-label 'walked)
	(assign `((,i +num_value) (,a +array_length)) `(,i ,len))
	(seq-elem-index i len)
	(gotoif `(,i < 0) 'error2)
	(gotoif `(,i >= ,len) 'error2)
	(vpif `(,vt3 = ,vt1))
		;a list holds a ref of it
		(class/obj/ref v vt1)
	(else)
		;raw, a number its value, else what it is
		(assign `((,v +obj_vtable)) `(,vt1))
		(loop-start)
			(gotoif `(,vt1 = ,vt2) 'number)
			(assign `((,vt1 +obj_vtable)) `(,vt1))
		(loop-until `(,vt1 = 0))
		(goto 'set)
	(vp-label 'number)
		(assign `((,v +num_value)) `(,v))
	(endif)
(vp-label 'set)
	(call :array :set_elem `(,a ,v ,i) `(,a) len)
	(class/obj/ref a vt1)

	(exit :array :lisp_set `(,this ,a))
	(vp-ret)

(vp-label 'error1)
	(jump :lisp :repl_error `(,args "(elem-set array idx elem)" +error_msg_wrong_types))
(vp-label 'error2)
	(jump :lisp :repl_error `(,args "(elem-set array idx elem)" +error_msg_not_valid_index))

(def-func-end)

(def-method :array :lisp_fill)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d15
	;info
	;(fill array length value) -> array, made length long, each element
	;value: of a list the object, a reference to it for each, of the rest
	;the number, of the array's kind. A set or a map made of a list is
	;not filled, its elements are its own

	(structure slot 0
		(ptr this args))

	(vp-alloc slot_size)
	(entry :array :lisp_fill '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 3)

	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(list-bind-args :r1 '(:r0 :r3 :r4) '(:obj :num :obj))
	(gotoif '(:r3 < 0) 'error1)
	(assign `((:r0 +obj_vtable) (@ ,(f-path :list :vtable))) '(:r1 :r2))
	(vpif '(:r1 = :r2))
		(d-call :list :fill '(:r0 :r3 :r4) '(:r0))
	(else)
		;a set or a map is refused, a fill would break it, not just give a
		;wrong answer
		(vp-cpy-rr :r0 :r5)
		(call :obj :inst_of `(:r0 (@ ,(f-path :list :vtable))) '(& :r1))
		(gotoif '(:r1 /= 0) 'refused)
		(call :obj :inst_of `(:r4 (@ ,(f-path :num :vtable))) '(& :r1))
		(gotoif '(:r1 = 0) 'error1)
		(vp-cpy-rr :r5 :r0)
		(call :array :fill '(:r0 :r3 (:r4 +num_value)) '(:r0) :r3)
	(endif)
	(class/obj/ref :r0 :r1)
	(vp-cpy-rr :r0 :r1)
	(assign '((:rsp slot_this)) '(:r0))

	(exit :array :lisp_fill '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'refused)
	(load-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(vp-free slot_size)
	(jump :lisp :repl_error '(:r1 "(fill array length value)" +error_msg_wrong_types))

(vp-label 'error1)
	(load-fields :rsp '(slot_this slot_args) '(:r0 :r1))
(vp-label 'error)
	(vp-free slot_size)
	(jump :lisp :repl_error '(:r1 "(fill array length value)" +error_msg_wrong_types))
	(signature '(:array :NUM :obj))

(def-func-end)
