(def-func-end)

(def-method :array :ref_elem)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element index (uint)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = num object (ptr)
	;trashes
	;:r1-:r3, :r14, :d0-:d15

