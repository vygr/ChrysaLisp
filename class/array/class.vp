(def-func-end)

(def-method :array :copy_raw)
	;inputs
	;:r0 = source address (pubyte)
	;:r1 = destination address (pubyte)
	;:r2 = length (bytes)
	;:r3 = 0 forward, else the size of the elements to take last first
	;outputs
	;:r0 = source address end (ptr)
	;:r1 = destination address end (ptr)
	;trashes
	;:r0-:r3
	;info
	;raw data from one place to another, the one copy of it all, to trash
	;what :sys_mem :copy does and no more. Forward it is that copy, and
	;what is given the bytes sees that they make whole elements of its own.
	;Reversed, elements of 1, 2, 4 or 8 bytes from the last of them to the
	;first, each as it is, the length a whole number of them: a load and a
	;store of an element at its own alignment

	(vp-rdef (src dst end size) '(:r0 :r1 :r2 :r3))

	(entry :array :copy_raw `(,src ,dst ,end ,size))

	(vpif `(,size = 0))
		(jump :sys_mem :copy `(,src ,dst ,end))
	(endif)
	;from the end of the source down to its start, size then an element
	(vp-add-rr src end)
	(vpif `(,end /= ,src))
		(switch)
		(vpcase `(,size = ,+long_size))
			(loop-start)
				(vp-sub-cr +long_size end)
				(array-load +long_size end 0 size)
				(vp-add-cr +long_size dst)
				(array-store +long_size size dst (neg +long_size))
			(loop-until `(,end = ,src))
			(break)
		(vpcase `(,size = ,+int_size))
			(loop-start)
				(vp-sub-cr +int_size end)
				(array-load +int_size end 0 size)
				(vp-add-cr +int_size dst)
				(array-store +int_size size dst (neg +int_size))
			(loop-until `(,end = ,src))
			(break)
		(vpcase `(,size = ,+short_size))
			(loop-start)
				(vp-sub-cr +short_size end)
				(array-load +short_size end 0 size)
				(vp-add-cr +short_size dst)
				(array-store +short_size size dst (neg +short_size))
			(loop-until `(,end = ,src))
			(break)
		(default)
			(loop-start)
				(vp-sub-cr +byte_size end)
				(array-load +byte_size end 0 size)
				(vp-add-cr +byte_size dst)
				(array-store +byte_size size dst (neg +byte_size))
			(loop-until `(,end = ,src))
		(endswitch)
	(endif)

	(exit :array :copy_raw `(,src ,dst))
	(vp-ret)

(def-func-end)

