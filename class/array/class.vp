(gen-create :array)
	;outputs
	;:r0 = 0 if error, else array object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :array)
(gen-type :array)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :array :deinit)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r3

	(vp-rdef (this begin end saved_this))

	(entry :array :deinit `(,this))

	;free any dynamic array
	(assign `((,this +array_begin)) `(,begin))
	(gotoif `(,begin < ,this) 'external)
	(assign `((& ,this +array_size)) `(,end))
	(vpif `(,begin >= ,end))
	(vp-label 'external)
		(vp-cpy-rr this saved_this)
		(call :sys_mem :free `(,begin))
		(vp-cpy-rr saved_this this)
	(endif)
	(s-jump :array :deinit `(,this))

(def-func-end)

(def-method :array :clear)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1

	(entry :array :clear '(:r0))

	(class/array/clear)

	(exit :array :clear '(:r0))
	(vp-ret)

(def-func-end)

(def-method :array :truncate)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = length (uint)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;none
	;info
	;no longer than that, what is there kept, the capacity as it was.
	;The length is no more than it was

	(entry :array :truncate '(:r0 :r1))

	(class/array/set_length)

	(exit :array :truncate '(:r0))
	(vp-ret)

(def-func-end)

