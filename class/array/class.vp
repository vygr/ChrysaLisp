(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "././stream/class.inc")
(include "././num/class.inc")
(include "././list/class.inc")

(gen-create :array)
	;outputs
	;:r0 = 0 if error, else array object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :array)
(gen-type :array)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :array :deinit)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r3

	(vp-rdef (this begin end saved_this))

	(entry :array :deinit `(,this))

	;free any dynamic array
	(assign `((,this +array_begin)) `(,begin))
	(gotoif `(,begin < ,this) 'external)
	(assign `((& ,this +array_size)) `(,end))
	(vpif `(,begin >= ,end))
	(vp-label 'external)
		(vp-cpy-rr this saved_this)
		(call :sys_mem :free `(,begin))
		(vp-cpy-rr saved_this this)
	(endif)
	(s-jump :array :deinit `(,this))

(def-func-end)

(def-method :array :clear)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1

	(entry :array :clear '(:r0))

	(class/array/clear)

	(exit :array :clear '(:r0))
	(vp-ret)

(def-func-end)

(def-method :array :find)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element (long)
	;:r2 = start index (uint)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = element (long)
	;:r2 = -1, else index (int)
	;trashes
	;:r2-:r4

	(vp-rdef (this elm idx base tmp))

	(entry :array :find `(,this ,elm ,idx))

	(assign `((,this +array_length) (,this +array_begin)) `(,tmp ,base))
	(vp-simd vp-shl-cr `(,(log2 +long_size)) `(,idx ,tmp))
	(vp-add-rr base idx)
	(vp-add-rr tmp base)
	(vpif `(,idx /= ,base))
		(loop-start)
			(assign `((,idx 0)) `(,tmp))
			(vp-add-cr +long_size idx)
			(gotoif `(,elm = ,tmp) 'found)
		(loop-until `(,idx = ,base))
	(endif)

	(exit :array :find `(,this ,elm -1))
	(vp-ret)

(vp-label 'found)
	(assign `((,this +array_begin)) `(,base))
	(vp-sub-cr +long_size idx)
	(vp-sub-rr base idx)
	(vp-shr-cr (log2 +long_size) idx)

	(exit :array :find `(,this ,elm ,idx))
	(vp-ret)

(def-func-end)

(def-method :array :rfind)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element (long)
	;:r2 = start index (uint)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = element (long)
	;:r2 = 0, else index (int)
	;trashes
	;:r2-:r4

	(vp-rdef (this elm idx base tmp))

	(entry :array :rfind `(,this ,elm ,idx))

	(assign `((,this +array_begin)) `(,base))
	(vp-shl-cr (log2 +long_size) idx)
	(vp-add-rr base idx)
	(vpif `(,idx /= ,base))
		(loop-start)
			(assign `((,idx ,(neg +long_size))) `(,tmp))
			(breakif `(,elm = ,tmp))
			(vp-sub-cr +long_size idx)
		(loop-until `(,idx = ,base))
	(endif)
	(vp-sub-rr base idx)
	(vp-asr-cr (log2 +long_size) idx)

	(exit :array :rfind `(,this ,elm ,idx))
	(vp-ret)

(def-func-end)

(def-method :array :get_length)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = array length (uint)
	;trashes
	;:r1

	(entry :array :get_length '(:r0))

	(class/array/get_length)

	(exit :array :get_length '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :array :push_back)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element (long)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = element (long)
	;:r2 = begin element iter (plong)
	;:r3 = end element iter (plong)
	;trashes
	;:r2-:r3, :d0-:d15

	(vp-rdef (this elm begin end))

	(entry :array :push_back `(,this ,elm))

	;increase capacity ?
	(assign `((,this +array_length) (,this +array_capacity)) `(,end ,begin))
	(vp-add-cr 1 end)
	(assign `(,end) `((,this +array_length)))
	(vpif `(,end > ,begin))
		;double the capacity
		(vp-add-rr begin begin)
		(vp-push elm)
		(call :array :set_cap `(,this ,begin) `(,this))
		(assign `((,this +array_length)) `(,end))
		(vp-pop elm)
	(endif)

	;save object
	(class/array/get_iter this end begin)
	(assign `(,elm) `((,end ,(neg +long_size))))

	(exit :array :push_back `(,this ,elm ,begin ,end))
	(vp-ret)

(def-func-end)

(def-method :array :push_back2)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element1 (long)
	;:r2 = element2 (long)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = element1 (long)
	;:r2 = element2 (long)
	;:r3 = begin element iter (plong)
	;:r4 = end element iter (plong)
	;trashes
	;:r3-:r4, :d0-:d15

	(vp-rdef (this elm1 elm2 begin end))

	(entry :array :push_back2 `(,this ,elm1 ,elm2))

	;increase capacity ?
	(assign `((,this +array_length) (,this +array_capacity)) `(,end ,begin))
	(vp-add-cr 2 end)
	(assign `(,end) `((,this +array_length)))
	(vpif `(,end > ,begin))
		;double the capacity
		(vp-add-rr begin begin)
		(vp-push elm1 elm2)
		(call :array :set_cap `(,this ,begin) `(,this))
		(assign `((,this +array_length)) `(,end))
		(vp-pop elm1 elm2)
	(endif)

	;save object
	(class/array/get_iter this end begin)
	(assign `(,elm1 ,elm2) `((,end ,(* -2 +long_size)) (,end ,(neg +long_size))))

	(exit :array :push_back2 `(,this ,elm1 ,elm2 ,begin ,end))
	(vp-ret)

(def-func-end)

(def-method :array :ref_back)
	;inputs
	;:r0 = array object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = num object (ptr)
	;trashes
	;:r1-:r3, :r14, :d0-:d15

	(vp-rdef (this len begin saved_this))

	(entry :array :ref_back `(,this))

	(assign `((,this +array_length) (,this +array_begin)) `(,len ,begin))
	(vp-sub-cr 1 len)
	(assign `(,len) `((,this +array_length)))
	(vp-shl-cr (log2 +long_size) len)
	(vp-cpy-rr this saved_this)
	(v-call :array :velement `((,begin ,len)) `(,this) saved_this len)

	(exit :array :ref_back `(,saved_this ,this))
	(vp-ret)

(def-func-end)

(def-method :array :ref_elem)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element index (uint)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = num object (ptr)
	;trashes
	;:r1-:r3, :r14, :d0-:d15

	(vp-rdef (saved_this this idx) '(:r3))

	(entry :array :ref_elem `(,this ,idx))

	(vp-cpy-rr this saved_this)
	(class/array/get_elem this idx this this)
	(v-call :array :velement `(,this) `(,this) saved_this idx)

	(exit :array :ref_elem `(,saved_this ,this))
	(vp-ret)

(def-func-end)

(def-method :array :set_cap)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = capacity (uint)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r2, :d0-:d15

	(vp-rdef (begin end this new_cap cur_cap) '(:r4 :r5))

	(entry :array :set_cap `(,this ,new_cap))

	;do we already have room ?
	(assign `((,this +array_capacity)) `(,cur_cap))
	(vpif `(,new_cap > ,cur_cap))
		;realloc the elements with double capacity, the rare path, so all
		;it uses beyond what the path with room does is kept: a caller
		;may hold :r3 to :r5 over a push, room or no
		(vp-push :r3 :r4 :r5 this)
		(vp-swp-rr new_cap cur_cap)
		(vp-shl-cr (log2 +long_size) new_cap)
		(vp-shl-cr (inc (log2 +long_size)) cur_cap)
		(assign `((,this +array_begin)) `(,begin))
		(gotoif `(,begin < ,this) 'external)
		(assign `((& ,this +array_size)) `(,end))
		(vpif `(,begin >= ,end))
		(vp-label 'external)
			(call :sys_mem :realloc `(,begin ,new_cap ,cur_cap) `(,this ,new_cap))
		(else)
			(vp-cpy-rr new_cap end)
			(call :sys_mem :alloc `(,cur_cap) `(,this ,new_cap))
			(vp-push this new_cap)
			(call :sys_mem :copy `(,begin ,this ,end))
			(vp-pop this new_cap)
		(endif)
		(vp-cpy-rr this cur_cap)
		(vp-pop :r3 :r4 :r5 this)
		(vp-shr-cr (log2 +long_size) new_cap)
		(assign `(,new_cap ,cur_cap) `((,this +array_capacity) (,this +array_begin)))
	(endif)

	(exit :array :set_cap `(,this))
	(vp-ret)

(def-func-end)

(def-method :array :set_elem)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element object (ptr)
	;:r2 = element index (uint)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r2-:r3

	(entry :array :set_elem '(:r0 :r1 :r2))

	(class/array/set_elem)

	(exit :array :set_elem '(:r0))
	(vp-ret)

(def-func-end)

(def-method :array :pivot)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = lower partition iter (plong)
	;:r2 = upper partition iter (plong)
	;:r3 = sort callback (ptr)
	;:r4 = sort context (ptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = partition iter (plong)
	;trashes
	;:r1-:r14, :d0-:d15
	;sort callback
	;inputs
	;:r0 = sort context (ptr)
	;:r1 = iter1 (plong)
	;:r2 = iter2 (plong)
	;outputs
	;:r0 = +, 0, -
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this func ctx pivt iter lowr uppr))

	(vp-alloc slot_size)
	(entry :array :pivot '(:r0 :r1 :r2 :r3 :r4))
	(save-fields :rsp
		'(slot_this slot_lowr slot_uppr slot_func slot_ctx slot_pivt)
		'(:r0 :r1 :r2 :r3 :r4 :r1))

	;pivot selection: swap middle to first (lowr) to avoid O(n^2) on sorted data
	(vp-cpy-rr :r2 :r6)
	(vp-sub-rr :r1 :r6)
	(vp-shr-cr 1 :r6)
	(vp-and-cr -8 :r6)
	(vpif '(:r6 /= 0))
		(vp-add-rr :r1 :r6)
		(vp-simd vp-load-rcr '(:r1 :r6) '(0) '(:r8 :r9))
		(vp-simd vp-store-rrc '(:r8 :r9) '(:r6 :r1) '(0))
	(endif)

	(loop-start)
		(vp-add-cr +long_size :r1)
		(breakif '(:r1 >= :r2))
		(assign '((:rsp slot_ctx) (:rsp slot_lowr) :r1) '(:r0 :r2 (:rsp slot_iter)))
		(vp-call-rc :rsp slot_func)
		(load-fields :rsp '(slot_iter slot_uppr) '(:r1 :r2))
		(continueif '(:r0 >= 0))
		(assign '((:rsp slot_pivt)) '(:r0))
		(vp-add-cr +long_size :r0)
		(assign '(:r0) '((:rsp slot_pivt)))
		(continueif '(:r0 = :r1))
		(assign '((:r0 0) (:r1 0)) '(:r3 :r4))
		(assign '(:r3 :r4) '((:r1 0) (:r0 0)))
	(loop-end)
	(load-fields :rsp '(slot_pivt slot_lowr) '(:r1 :r0))
	(vpif '(:r1 /= :r0))
		(assign '((:r0 0) (:r1 0)) '(:r2 :r3))
		(assign '(:r2 :r3) '((:r1 0) (:r0 0)))
	(endif)

	(exit :array :pivot '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :array :sort)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = stack array object (ptr)
	;:r2 = lower iter (plong)
	;:r3 = upper iter (plong)
	;:r4 = compare callback (ptr)
	;:r5 = sort context (ptr)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;sort callback
	;inputs
	;:r0 = context (ptr)
	;:r1 = iter1 (plong)
	;:r2 = iter2 (plong)
	;outputs
	;:r0 = +, 0, -
	;trashes
	;:r1-:r14, :d0-:d15

	;the frame is what the compare, which keeps nothing, is called over
	(structure slot 0
		(ptr this func ctx stack)
		(pptr iter_begin)
		(union
			(uint low high)
			(long interval))
		(uint start))

	(vp-alloc slot_size)
	(entry :array :sort '(:r0 :r1 :r2 :r3 :r4 :r5))
	(save-fields :rsp '(slot_this slot_func slot_ctx slot_stack) '(:r0 :r4 :r5 :r1))

	;the interval as indexes, as the stack holds them
	(assign '((:r0 +array_begin) (:r1 +array_length)) '(:r4 :r1))
	(vp-sub-rr :r4 :r2)
	(vp-sub-rr :r4 :r3)
	(vp-shr-cr 3 :r2)
	(vp-shr-cr 3 :r3)
	(save-fields :rsp '(slot_iter_begin slot_low slot_high slot_start) '(:r4 :r2 :r3 :r1))
	(loop-start)
		(load-fields :rsp '(slot_low slot_high) '(:r1 :r2))
		(vpif '(:r1 < :r2))
			(assign '((:rsp slot_iter_begin)) '(:r5))
			(vp-shl-cr 3 :r1)
			(vp-shl-cr 3 :r2)
			(vp-add-rr :r5 :r1)
			(vp-add-rr :r5 :r2)
			(load-fields :rsp '(slot_this slot_func slot_ctx) '(:r0 :r3 :r4))
			(call :array :pivot '(:r0 :r1 :r2 :r3 :r4) '(_ :r1))
			;low to the pivot, then the pivot on to high: each interval
			;made in a register, low then high, as it is in its slot
			(load-fields :rsp '(slot_stack slot_iter_begin slot_low slot_high) '(:r0 :r5 :r4 :r6))
			(vp-sub-rr :r5 :r1)
			(vp-shr-cr 3 :r1)
			(vp-lea-rcr :r1 1 :r5)
			(vp-shl-cr 32 :r1)
			(vp-shl-cr 32 :r6)
			(vp-add-rr :r4 :r1)
			(vp-add-rr :r6 :r5)
			(call :array :push_back '(:r0 :r1) '(:r0 _ _ _))
			(call :array :push_back '(:r0 :r5))
		(endif)
		(assign '((:rsp slot_stack) (:rsp slot_start)) '(:r0 :r2))
		(assign '((:r0 +array_length)) '(:r1))
		(breakif '(:r1 = :r2))
		(call :array :pop_back '(:r0) '(_ (:rsp slot_interval)))
	(loop-end)

	(exit :array :sort '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :array :append)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = source array object (ptr)
	;:r2 = element start index (uint)
	;:r3 = element end index (uint)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r3, :r6-:r9, :d0-:d15

	(vp-rdef (saved_that saved_si saved_ei di this that si ei)
		'(:r6 :r7 :r8 :r9))

	(entry :array :append `(,this ,that ,si ,ei))

	(vpif `(,si /= ,ei))
		;save inputs
		(assign `(,that ,si ,ei) `(,saved_that ,saved_si ,saved_ei))

		;extend array
		(assign `((,this +array_length)) `(,di))
		(vp-sub-rr si ei)
		(assign `((& ,ei ,di)) `(,that))
		(assign `(,that) `((,this +array_length)))
		(call :array :set_cap `(,this ,that) `(,this))

		;append elements
		(class/array/get_iters saved_that saved_si saved_ei that)
		(class/array/get_iter this di that)
		(loop-start)
			(vp-load-rcr saved_si 0 that)
			(vp-simd vp-add-cr `(,+long_size) `(,saved_si ,di))
			(vp-store-rrc that di (neg +long_size))
		(loop-until `(,saved_si = ,saved_ei))
	(endif)

	(exit :array :append `(,this))
	(vp-ret)

(def-func-end)

(def-method :array :print)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = stream object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r5, :r14, :d0-:d15

	(structure slot 0
		(ptr this stream)
		(plong iter_begin iter_end))

	(vp-alloc slot_size)
	(entry :array :print '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_stream) '(:r0 :r1))

	(call :stream :write_char '(:r1 +char_lrb))
	(assign '((:rsp slot_this)) '(:r0))
	(class/array/get_both :r0 :r4 :r2)
	(vpif '(:r4 /= :r2))
		(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r4 :r2))
		;the place is in :r4, which the write of a char leaves
		(loop-start)
			(vp-load-rcr :r4 0 :r0)
			(assign '((:rsp slot_this)) '(:r1))
			(v-call :array :velement '(:r0) '(:r0) :r1 :r1)
			(call :num :print '(:r0 (:rsp slot_stream)) '(:r0))
			(call :num :deref '(:r0))
			(load-fields :rsp '(slot_iter_begin slot_iter_end) '(:r4 :r2))
			(vp-add-cr +long_size :r4)
			(breakif '(:r4 = :r2))
			(assign '(:r4) '((:rsp slot_iter_begin)))
			(call :stream :write_char '((:rsp slot_stream) +char_space))
		(loop-end)
	(endif)
	(call :stream :write_char '((:rsp slot_stream) +char_rrb))

	(exit :array :print '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :array :erase)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element iterator (pptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = element iterator (pptr)
	;trashes
	;:r2-:r3

	(vp-rdef (this iter len begin))

	(entry :array :erase `(,this ,iter))

	;swap last entry for erased entry
	(assign `((,this +array_length) (,this +array_begin)) `(,len ,begin))
	(vp-sub-cr 1 len)
	(assign `(,len) `((,this +array_length)))
	(vp-shl-cr (log2 +long_size) len)
	(vp-add-rr len begin)
	(vpif `(,begin /= ,iter))
		(assign `((,begin 0)) `(,len))
		(assign `(,len) `((,iter 0)))
	(endif)

	(exit :array :erase `(,this ,iter))
	(vp-ret)

(def-func-end)

(def-method :array :erase2)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element iterator (pptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = element iterator (pptr)
	;trashes
	;:r2-:r3

	(vp-rdef (this iter len begin))

	(entry :array :erase2 `(,this ,iter))

	;swap last entry for erased entry
	(assign `((,this +array_length) (,this +array_begin)) `(,len ,begin))
	(vp-sub-cr 2 len)
	(assign `(,len) `((,this +array_length)))
	(vp-shl-cr (log2 +long_size) len)
	(vp-add-rr len begin)
	(vpif `(,begin /= ,iter))
		(assign `((,begin 0) (,begin +long_size)) `(,begin ,len))
		(assign `(,begin ,len) `((,iter 0) (,iter +long_size)))
	(endif)

	(exit :array :erase2 `(,this ,iter))
	(vp-ret)

(def-func-end)

(def-method :array :eql)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = obj object (ptr)
	;outputs
	;:r0 = array object (ptr)
	;:r1 = 0 if same, else not
	;trashes
	;:r1-:r5

	(vp-rdef (this that len1 len2 itr1 itr2))

	(entry :array :eql `(,this ,that))

	(gotoif `(,this = ,that) 'same)
	(assign `((,this +obj_vtable) (,that +obj_vtable)) `(,len1 ,len2))
	(gotoif `(,len1 /= ,len2) 'not_same)
	(assign `((,this +array_length) (,that +array_length)) `(,len1 ,len2))
	(gotoif `(,len1 /= ,len2) 'not_same)
	(gotoif `(,len1 = 0) 'same)
	(assign `((,this +array_begin) (,that +array_begin)) `(,itr1 ,itr2))
	(vp-shl-cr (log2 +ptr_size) len1)
	(vp-add-rr itr1 len1)
	(loop-start)
		(vp-simd vp-load-rcr `(,itr1 ,itr2) '(0 0) `(,that ,len2))
		(gotoif `(,that /= ,len2) 'not_same)
		(vp-simd vp-add-cr `(,+ptr_size) `(,itr1 ,itr2))
	(loop-until `(,itr1 = ,len1))

(vp-label 'same)
	(exit :array :eql `(,this 0))
	(vp-ret)

(vp-label 'not_same)
	(exit :array :eql `(,this -1))
	(vp-ret)

(def-func-end)

(def-method :array :cat)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = list of array objects (ptr)
	;outputs
	;:r0 = new array object (ptr)
	;trashes
	;:r0-:r9, :d0-:d15

	(vp-rdef (this seqs_begin di src si ei
			len total seqs seqs_end))

	(entry :array :cat `(,this ,seqs))

	(call :array :vcreate `(,this) `(,this))
	(class/array/get_both seqs seqs_begin seqs_end)
	(vpif `(,seqs_begin /= ,seqs_end))
		;first set the capacity/length
		(vp-xor-rr total total)
		(loop-start)
			(assign `((,seqs_begin 0)) `(,src))
			(vp-add-cr +ptr_size seqs_begin)
			(assign `((,src +array_length)) `(,len))
			(vp-add-rr len total)
		(loop-until `(,seqs_begin = ,seqs_end))
		(assign `(,total) `((,this +array_length)))
		(call :array :set_cap `(,this ,total) `(,this))
		;now transfer the sequences
		(assign `((,this +array_begin) (,seqs +array_begin)) `(,di ,seqs_begin))
		(loop-start)
			(assign `((,seqs_begin 0)) `(,src))
			(vp-add-cr +ptr_size seqs_begin)
			(class/array/get_both src si ei)
			(vpif `(,si /= ,ei))
				;copy the sequence
				(loop-start)
					(vp-load-rcr si 0 len)
					(vp-simd vp-add-cr `(,+long_size) `(,si ,di))
					(vp-store-rrc len di (neg +long_size))
				(loop-until `(,si = ,ei))
			(endif)
		(loop-until `(,seqs_begin = ,seqs_end))
	(endif)

	(exit :array :cat `(,this))
	(vp-ret)

(def-func-end)

(def-method :array :slice)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = element start index (uint)
	;:r2 = element end index (uint)
	;outputs
	;:r0 = slice array object (ptr)
	;trashes
	;:r0-:r3, :r6-:r8, :d0-:d15

	(vp-rdef (src si ei this di total) '(:r6 :r7 :r8))

	(entry :array :slice `(,src ,si ,ei))

	(call :array :vcreate `(,src) `(,this))
	(vpif `(,si /= ,ei))
		;first set the capacity/length
		(vp-cpy-rr si total)
		(vp-sub-rr ei total)
		(vp-abs-rr total total)
		(assign `(,total) `((,this +array_length)))
		(call :array :set_cap `(,this ,total) `(,this))
		;now transfer the slice, reversed if needed
		(class/array/get_iters src si ei)
		(assign `((,this +array_begin)) `(,di))
		(vpif `(,si < ,ei))
			(loop-start)
				(vp-load-rcr si 0 total)
				(vp-simd vp-add-cr `(,+long_size) `(,si ,di))
				(vp-store-rrc total di (neg +long_size))
			(loop-until `(,si = ,ei))
		(else)
			(loop-start)
				(vp-load-rcr si (neg +long_size) total)
				(vp-simd vp-add-cr `(,(neg +long_size) ,+long_size) `(,si ,di))
				(vp-store-rrc total di (neg +long_size))
			(loop-until `(,si = ,ei))
		(endif)
	(endif)

	(exit :array :slice `(,this))
	(vp-ret)

(def-func-end)

(def-method :array :splice)
	;inputs
	;:r0 = src1 array object (ptr)
	;:r1 = src2 array object (ptr)
	;:r2 = nums object (ptr)
	;outputs
	;:r0 = new array object (ptr)
	;trashes
	;:r0-:r11, :d0-:d15

	(vp-rdef (this idx_begin di si ei swp_xor len total
			src1 src2 idxs idx_end))

	(entry :array :splice `(,src1 ,src2 ,idxs))

	(call :array :vcreate `(,src1) `(,this))
	(class/array/get_both idxs idx_begin idx_end)
	(vpif `(,idx_begin /= ,idx_end))
		;first set the capacity/length
		(assign `((,src1 +array_length) (,src2 +array_length)) `(,len ,ei))
		(vp-cpy-rr len swp_xor)
		(vp-xor-rr ei swp_xor)
		(vp-xor-rr total total)
		(loop-start)
			;indices
			(vp-simd vp-load-rcr `(,idx_begin) `(0 ,+long_size) `(,si ,ei))
			(vp-add-cr (* +long_size 2) idx_begin)
			;the length this time
			(seq-elem-index si len)
			(seq-elem-index ei len)
			(vp-xor-rr swp_xor len)
			;sum the absolute val of index diff
			(vp-sub-rr si ei)
			(vp-abs-rr ei ei)
			(vp-add-rr ei total)
		(loop-until `(,idx_begin = ,idx_end))
		(assign `(,total) `((,this +array_length)))
		(call :array :set_cap `(,this ,total) `(,this))
		;now transfer the slices
		(assign `((,this +array_begin) (,idxs +array_begin)) `(,di ,idx_begin))
		(vp-cpy-rr src1 swp_xor)
		(vp-xor-rr src2 swp_xor)
		(loop-start)
			;indices
			(vp-simd vp-load-rcr `(,idx_begin) `(0 ,+long_size) `(,si ,ei))
			(vp-add-cr (* +long_size 2) idx_begin)
			;the source this time
			(assign `((,src1 +array_length) (,src1 +array_begin)) `(,len ,src2))
			(seq-elem-index si len)
			(seq-elem-index ei len)
			(vp-xor-rr swp_xor src1)
			(vpif `(,si /= ,ei))
				(vp-simd vp-shl-cr `(,(log2 +long_size)) `(,si ,ei))
				(vp-simd vp-add-rr `(,src2) `(,si ,ei))
				;copy the slice, reverse if required
				(vpif `(,si < ,ei))
					(loop-start)
						(vp-load-rcr si 0 len)
						(vp-simd vp-add-cr `(,+long_size) `(,si ,di))
						(vp-store-rrc len di (neg +long_size))
					(loop-until `(,si = ,ei))
				(else)
					(loop-start)
						(vp-load-rcr si (neg +long_size) len)
						(vp-simd vp-add-cr `(,(neg +long_size) ,+long_size) `(,si ,di))
						(vp-store-rrc len di (neg +long_size))
					(loop-until `(,si = ,ei))
				(endif)
			(endif)
		(loop-until `(,idx_begin = ,idx_end))
	(endif)

	(exit :array :splice `(,this))
	(vp-ret)

(def-func-end)

(def-method :array :fill)
	;inputs
	;:r0 = array object (ptr)
	;:r1 = length (uint)
	;:r2 = element (long)
	;outputs
	;:r0 = array object (ptr)
	;trashes
	;:r1-:r4, :d0-:d15
	;info
	;the array made length long, every element the one given

	(entry :array :fill '(:r0 :r3 :r4))

	(call :array :set_cap '(:r0 :r3) '(:r0))
	(assign '(:r3) '((:r0 +array_length)))
	(class/array/get_both :r0 :r1 :r2)
	(vpif '(:r1 /= :r2))
		(loop-start)
			(vp-store-rrc :r4 :r1 0)
			(vp-add-cr +long_size :r1)
		(loop-until '(:r1 = :r2))
	(endif)

	(exit :array :fill '(:r0))
	(vp-ret)

(def-func-end)
