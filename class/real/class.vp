(include "lib/asm/func.inc")
(include "sys/math/class.inc")
(include "./class.inc")
(include "././stream/class.inc")
(include "././list/class.inc")

(gen-create :real)
	;inputs
	;:r0 = initial value (real)
	;outputs
	;:r0 = 0 if error, else real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15
(gen-vtable :real)
(gen-type :real)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = real object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :real :print)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = stream object (ptr)
	;outputs
	;:r0 = real object (ptr)
	;trashes
	;:r1-:r5, :d0-:d15

	(structure slot 0
		(ptr this stream tmp))

	(vp-alloc slot_size)
	(entry :real :print '(:r0 :r1))

	(assign '(:r0 :r1) '((:rsp slot_this) (:rsp slot_stream)))
	(call :stream :write_cstr '(:r1 "0x"))
	(assign '((:rsp slot_this)) '(:r0))
	(call :str :create_from_long '((:r0 +num_value) -16) '(:r0))
	(assign '(:r0) '((:rsp slot_tmp)))
	(call :stream :write '((:rsp slot_stream) (& :r0 +str_data) (:r0 +str_length)))
	(call :obj :deref '((:rsp slot_tmp)))

	(exit :real :print '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(redefun addop (%0)
	(entry :real %0 '(:r0 :r1))
	(class/array/get_both :r1 :r1 :r2)
	(vp-load-rcr :r1 0 :r0)
	(vp-add-cr +ptr_size :r1)
	(assign '((:r0 +num_value)) '(:d0))
	(loop-start)
		(vp-load-rcr :r1 0 :r4)
		(vp-add-cr +ptr_size :r1)
		(assign '((:r4 +num_value)) '(:d1))
		((eval (sym (cat "vp-" (rest %0) "-dd"))) :d1 :d0)
	(loop-until '(:r1 = :r2))
	(v-jump :num :vcreate '(:d0) :r4 :r1))

(def-method :real :add)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r4, :r14, :d0-:d15

	(addop :add)

(def-func-end)

(def-method :real :sub)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r4, :r14, :d0-:d15

	(addop :sub)

(def-func-end)

(def-method :real :mul)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r4, :r14, :d0-:d15

	(addop :mul)

(def-func-end)

(redefun minop (%0 p)
	(vp-rdef (this args obj iter_begin iter_end))
	(vp-ddef (val new_val))
	(entry :real %0 `(,this ,args))
	(class/array/get_both args iter_begin iter_end)
	(vp-load-rcr iter_begin 0 args)
	(vp-add-cr +ptr_size iter_begin)
	(assign `((,args +num_value)) `(,val))
	(loop-start)
		(vp-load-rcr iter_begin 0 obj)
		(vp-add-cr +ptr_size iter_begin)
		(assign `((,obj +num_value)) `(,new_val))
		(exec p)
	(loop-until `(,iter_begin = ,iter_end))
	(class/obj/ref args iter_begin)
	(exit :real %0 `(,args))
	(vp-ret))

(def-method :real :min)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r1 = result real object (ptr)
	;trashes
	;:r1-:r4, :d0-:d1

	(minop :min
		'(progn
			(vpif `(,new_val < ,val))
				(vp-cpy-dd new_val val)
				(vp-cpy-rr obj args)
			(endif)))

(def-func-end)

(def-method :real :max)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r1 = result real object (ptr)
	;trashes
	;:r1-:r4, :d0-:d1

	(minop :max
		'(progn
			(vpif `(,new_val > ,val))
				(vp-cpy-dd new_val val)
				(vp-cpy-rr obj args)
			(endif)))

(def-func-end)

(redefun divop (%0 p)
	(entry :real %0 '(:r0 :r1))
	(class/array/get_both :r1 :r1 :r4)
	(vp-load-rcr :r1 0 :r0)
	(vp-add-cr +ptr_size :r1)
	(assign '((:r0 +num_value) 0) '(:d0 :r3))
	(vp-cpy-rd :r3 :d3)
	(loop-start)
		(vp-load-rcr :r1 0 :r5)
		(vp-add-cr +ptr_size :r1)
		(assign '((:r5 +num_value)) '(:d1))
	(gotoif '(:d1 = :d3) 'error)
		(exec p)
	(loop-until '(:r1 = :r4))
	(v-jump :num :vcreate '(:d0) :r5 :r1)
(vp-label 'error)
	(exit :real %0 '(0))
	(vp-ret))

(def-method :real :div)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r0 = 0 if error, else result real object (ptr)
	;trashes
	;:r0-:r5, :r14, :d0-:d15

	(divop :div
		'(vp-div-dd :d1 :d0))

(def-func-end)

(def-method :real :mod)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r0 = 0 if error, else result real object (ptr)
	;trashes
	;:r0-:r5, :r14, :d0-:d15

	(divop :mod
		'(progn
			(vp-cpy-dd :d0 :d2)		; Copy dividend (x)
			(vp-div-dd :d1 :d2)		; f2 = x / y
			(vp-cvt-dr :d2 :r0)		; r0 = (int)(x / y) [Truncate]
			(vp-cvt-rd :r0 :d2)		; f2 = (double)(int)(x / y)
			(vp-mul-dd :d1 :d2)		; f2 = y * trunc(x / y)
			(vp-sub-dd :d2 :d0)))	; f0 = x - (y * trunc(x / y))

(def-func-end)

(redefun compareop (%0 p)
	(entry :real %0 '(:r0 :r1))
	(class/array/get_both :r1 :r1 :r2)
	(vp-load-rcr :r1 0 :r3)
	(vp-add-cr +ptr_size :r1)
	(assign '((:r3 +num_value)) '(:d0))
	(loop-start)
		(vp-load-rcr :r1 0 :r3)
		(vp-add-cr +ptr_size :r1)
		(assign '((:r3 +num_value)) '(:d1))
		(exec p)
	(loop-until '(:r1 = :r2))
	(exit :real %0 '(-1))
	(vp-ret)
(vp-label 'fail)
	(exit :real %0 '(0))
	(vp-ret))

(def-method :real :ge)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r1 = 0, -1 (int)
	;trashes
	;:r1-:r3, :d0-:d1

	(compareop :ge
		'(progn
			(gotoif '(:d0 < :d1) 'fail)
			(vp-cpy-dd :d1 :d0)))

(def-func-end)

(def-method :real :gt)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r1 = 0, -1 (int)
	;trashes
	;:r1-:r3, :d0-:d1

	(compareop :gt
		'(progn
			(gotoif '(:d0 <= :d1) 'fail)
			(vp-cpy-dd :d1 :d0)))

(def-func-end)

(def-method :real :le)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r1 = 0, -1 (int)
	;trashes
	;:r1-:r3, :d0-:d1

	(compareop :le
		'(progn
			(gotoif '(:d0 > :d1) 'fail)
			(vp-cpy-dd :d1 :d0)))

(def-func-end)

(def-method :real :lt)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = list of real objects (ptr)
	;outputs
	;:r1 = 0, -1 (int)
	;trashes
	;:r1-:r3, :d0-:d1

	(compareop :lt
		'(progn
			(gotoif '(:d0 >= :d1) 'fail)
			(vp-cpy-dd :d1 :d0)))

(def-func-end)

;generic real math ops
(redefun mathop (%0 p)
	(entry :real %0 '(:r0))
	(assign '((:r0 +num_value)) '(:d1))
	(exec p)
	(jump :real :create '(:d0)))

(def-method :real :sqrt)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :sqrt
		'(vp-sqrt-dd :d1 :d0))

(def-func-end)

(def-method :real :sin)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :sin
		'(call :sys_math :r_sin '(:d1) '(:d0)))

(def-func-end)

(def-method :real :cos)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :cos
		'(progn
			;pi/2
			(vp-lea-pr 'fn_consts :r0)
			(assign '((:r0 (fn-const 0x3ff921fb54442d18))) '(:d0))
			(vp-add-dd :d0 :d1)
			(call :sys_math :r_sin '(:d1) '(:d0))))

(def-func-end)

(def-method :real :frac)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :frac
		'(progn
			(vp-lea-pr 'fn_consts :r1)
			(vp-cpy-dd :d1 :d0)
			(vp-cvt-dr :d0 :r0)
			(vp-cvt-rd :r0 :d1)
			(vp-sub-dd :d1 :d0)
			(assign '((:r1 (fn-const (n2r 0)))) '(:d1))
			(vpif '(:d0 < :d1))
				(assign '((:r1 (fn-const (n2r 1)))) '(:d1))
				(vp-add-dd :d1 :d0)
			(endif)))

(def-func-end)

(def-method :real :floor)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :floor
		'(progn
			(vp-cvt-dr :d1 :r0)
			(vp-cvt-rd :r0 :d0)
			(vpif '(:d0 > :d1))
				(vp-lea-pr 'fn_consts :r1)
				(assign '((:r1 (fn-const (n2r 1)))) '(:d1))
				(vp-sub-dd :d1 :d0)
			(endif)))

(def-func-end)

(def-method :real :ceil)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :ceil
		'(progn
			(vp-cvt-dr :d1 :r0)
			(vp-cvt-rd :r0 :d0)
			(vpif '(:d0 < :d1))
				(vp-lea-pr 'fn_consts :r1)
				(assign '((:r1 (fn-const (n2r 1)))) '(:d1))
				(vp-add-dd :d1 :d0)
			(endif)))

(def-func-end)

(def-method :real :recip)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :recip
		'(progn
			(vp-lea-pr 'fn_consts :r1)
			(assign '((:r1 (fn-const (n2r 1)))) '(:d0))
			(vp-div-dd :d1 :d0)))

(def-func-end)

(def-method :real :abs)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :abs
		'(vp-abs-dd :d1 :d0))

(def-func-end)

(def-method :real :neg)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :neg
		'(vp-neg-dd :d1 :d0))

(def-func-end)

(def-method :real :sign)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :sign
		'(progn
			(vp-lea-pr 'fn_consts :r1)
			(assign '((:r1 (fn-const (n2r 0)))) '(:d0))
			(vpif '(:d1 > :d0))
				(assign '((:r1 (fn-const (n2r 1)))) '(:d0))
			(elseif '(:d1 < :d0))
				(assign '((:r1 (fn-const (n2r -1)))) '(:d0))
			(endif)))

(def-func-end)

(def-method :real :random)
	;inputs
	;:r0 = real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r4, :r14, :d0-:d15

	(mathop :random
		'(progn
			(vp-lea-pr 'fn_consts :r4)
			(assign '((:r4 (fn-const (n2r 1)))) '(:d0))
			(vp-mul-dd :d0 :d1)
			(vp-cvt-dr :d1 :r0)
			(call :sys_math :i_rand '(:r0) '(:r0))
			(vp-cvt-rd :r0 :d0)
			(assign '((:r4 (fn-const (recip (n2r 1))))) '(:d1))
			(vp-mul-dd :d1 :d0)))

(def-func-end)

(def-method :real :quant)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = tolerance real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(vp-rdef (this tol trunc))
	(vp-ddef (v tmp half one ftrunc))

	(entry :real :quant `(,this ,tol))

	(assign `((,this +num_value) (,tol +num_value)) `(,v ,tmp))

	; v = val / tol
	(vp-div-dd tmp v)
	; v = v + 0.5
	(vp-lea-pr 'fn_consts tol)
	(assign `((,tol (fn-const (n2r 0.5)))) `(,half))
	(vp-add-dd half v)
	; v = floor(v)
	(vp-cvt-dr v trunc)
	(vp-cvt-rd trunc ftrunc)
	(vpif `(,ftrunc > ,v))
		(assign `((,tol (fn-const (n2r 1.0)))) `(,one))
		(vp-sub-dd one ftrunc)
	(endif)
	(vp-cpy-dd ftrunc v)
	; v = v * tol
	(vp-mul-dd tmp v)
	(jump :real :create `(,v))

(def-func-end)

(def-method :real :pow)
	;inputs
	;:r0 = real object (ptr)
	;:r1 = power real object (ptr)
	;outputs
	;:r0 = result real object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15
	;info
	;0 if the real is not greater than 0, :sys_math :r_pow

	(entry :real :pow '(:r0 :r1))

	(assign '((:r0 +num_value) (:r1 +num_value)) '(:d0 :d1))
	(call :sys_math :r_pow '(:d0 :d1) '(:d0))
	(jump :real :create '(:d0))

(def-func-end)
