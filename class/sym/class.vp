(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "././stream/class.inc")
(include "././hset/class.inc")

(gen-vtable :sym)
(gen-type :sym)
	;inputs
	;:r0 = sym object (ptr)
	;outputs
	;:r0 = sym object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :sym :statics_init)
	;trashes
	;:r0-:r11, :r14, :d0-:d15

	(structure slot 0
		(pptr sym_ptr)
		(pubyte next))

	(vp-alloc slot_size)
	(entry :sym :statics_init '())

	;init symbol set
	(call :hset :create `(num_sym_buckets) '(:r0))
	(fn-bind 'sys/statics/statics :r1)
	(assign '(:r0) '((:r1 statics_sym_intern)))

	;add static symbols
	(assign '(($ props) (& :r1 statics_static_syms)) '(:r0 :r1))
	(save-fields :rsp '(slot_next slot_sym_ptr) '(:r0 :r1))
	(loop-start)
		(call :sym :intern_cstr '((:rsp slot_next)) '(:r0))
		(assign '((:rsp slot_sym_ptr)) '(:r1))
		(assign '(:r0) '((:r1 0)))
		(vp-add-cr +ptr_size :r1)
		(assign '(:r1) '((:rsp slot_sym_ptr)))
		(call :sys_str :length '((:rsp slot_next)) '(:r0 :r1))
		(vp-add-rr :r1 :r0)
		(vp-add-cr +byte_size :r0)
		(assign '(:r0 ($ props_end)) '((:rsp slot_next) :r1))
	(loop-until '(:r0 = :r1))

	(exit :sym :statics_init '())
	(vp-free slot_size)
	(vp-ret)

;;;;;;;;;;;;;;;;;;;;;;;;;
; interned static symbols
;;;;;;;;;;;;;;;;;;;;;;;;;

(vp-label 'props)
	(each (lambda (%0) (vp-cstr %0)) *static_syms*)
(vp-label 'props_end)

(def-func-end)

(def-method :sym :intern_str)
	;inputs
	;:r0 = str object (ptr)
	;outputs
	;:r0 = interned sym object (ptr)
	;trashes
	;:r0-:r12, :d0-:d15
	;info
	;input str IS NOT derefed

	(entry :sym :intern_str '(:r0))

	(vp-push :r0)
	(fn-bind 'sys/statics/statics :r2)
	(call :hset :cfind `((:r2 statics_sym_intern) :r0 (@ ,(f-path :sym :eql_str))) '(_ :r1 :r2))
	(vp-pop :r0)
	(vpif '(:r1 = 0))
		(vp-cpy-rr :r2 :r7)
		(call :sym :create_from_buffer '((& :r0 +str_data) (:r0 +str_length)) '(:r0))
		(assign `((@ ,(f-path :sym :vtable)) :r0 :r7) '(:r2 :r1 :r0))
		(assign '(:r2) '((:r1 +obj_vtable)))
		(call :list :push_back '(:r0 :r1) '(_ :r1 _ _))
	(else)
		(assign '((:r1 0)) '(:r1))
	(endif)
	(class/obj/ref :r1 :r0)

	(exit :sym :intern_str '(:r1))
	(vp-ret)

(def-func-end)

(def-method :sym :intern_cstr)
	;inputs
	;:r0 = c string pointer (pubyte)
	;outputs
	;:r0 = interned sym object (ptr)
	;trashes
	;:r0-:r11, :d0-:d15

	(entry :sym :intern_cstr '(:r0))
	(call :sys_str :length '(:r0) '(:r0 :r1))
	(jump :sym :intern_pstr '(:r0 (& :r0 :r1)))

(def-func-end)

(def-method :sym :intern_pstr)
	;inputs
	;:r0 = start (pubyte)
	;:r1 = end (pubyte)
	;outputs
	;:r0 = interned sym object (ptr)
	;trashes
	;:r0-:r11, :d0-:d15

	(structure slot 0
		(pubyte str_begin str_end)
		(uint hcode))

	(vp-rdef (iter_begin iter_end str_begin str_end str_size bucket symbol str_len)
		'(:r6 :r7 :r8 :r9 :r10 :r11))

	(vp-alloc slot_size)
	(entry :sym :intern_pstr '((:rsp slot_str_begin) (:rsp slot_str_end)))

	(call :str :hash_pstr '((:rsp slot_str_begin) (:rsp slot_str_end)) '(:r1))
	(assign '(:r1) '((:rsp slot_hcode)))
	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_sym_intern)) '(:r0))
	(assign '((:r0 +array_num_buckets)) '(:r2))
	(vp-rem-rr-u :r2 :r1)
	(call :hset :get_elem '(:r0 :r1) `(_ ,bucket))

	(load-fields :rsp '(slot_str_end slot_str_begin) `(,str_end ,str_begin))
	(class/array/get_both bucket iter_begin iter_end)
	(vp-cpy-rr str_end str_size)
	(vp-sub-rr str_begin str_size)
	(vpif `(,iter_begin /= ,iter_end))
		(loop-start)
			(assign `((,iter_begin 0)) `(,symbol))
			(vp-add-cr +ptr_size iter_begin)
			(assign `((,symbol +str_length)) `(,str_len))
			(vpif `(,str_len = ,str_size))
				(call :str :same_pstr `(,str_begin ,str_end (& ,symbol +str_data)) '(found))
				(gotoif `(,found = 0) 'exit)
			(endif)
		(loop-until `(,iter_begin = ,iter_end))
	(endif)

	(call :sym :create_from_buffer `(,str_begin ,str_size) `(,symbol))
	(assign `((@ ,(f-path :sym :vtable))) `(,str_len))
	(assign '((:rsp slot_hcode)) `(,str_size))
	(assign `(,str_len ,str_size) `((,symbol +obj_vtable) (,symbol +str_hashcode)))
	(call :list :push_back `(,bucket ,symbol) `(_ ,symbol _ _))

(vp-label 'exit)
	(class/obj/ref symbol str_len)
	(exit :sym :intern_pstr `(,symbol))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :sym :print)
	;inputs
	;:r0 = sym object (ptr)
	;:r1 = stream object (ptr)
	;outputs
	;:r0 = sym object (ptr)
	;trashes
	;:r1-:r5, :d0-:d15

	(entry :sym :print '(:r0 :r1))

	(vp-push :r0)
	(vp-cpy-rr :r1 :r3)
	(call :stream :write '(:r3 (& :r0 +str_data) (:r0 +str_length)))
	(vp-pop :r0)

	(exit :sym :print '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sym :eql_str)
	;inputs
	;:r0 = sym object (ptr)
	;:r1 = str object (ptr)
	;outputs
	;:r0 = sym object (ptr)
	;:r1 = 0 if same, else not
	;trashes
	;:r1-:r6

	(vp-rdef (this that len1 len2))

	(entry :sym :eql_str `(,this ,that))

	(gotoif `(,this = ,that) 'same)
	(assign `((,this +str_length) (,that +str_length)) `(,len1 ,len2))
	(gotoif `(,len1 /= ,len2) 'not_same)
	(jump :str :starts_with `(,this ,that))

(vp-label 'not_same)
	(exit :sym :eql_str `(,this -1))
	(vp-ret)

(vp-label 'same)
	(exit :sym :eql_str `(,this 0))
	(vp-ret)

(def-func-end)
