(include "lib/asm/func.inc")
(include "./class.inc")
(include "././list/class.inc")

(gen-vtable :nodeid)
(gen-type :nodeid)

(def-method :nodeid :create)
	;inputs
	;:r0 = buffer (pubyte)
	;outputs
	;:r0 = 0 if error, else nodeid object (ptr)
	;trashes
	;:r0-:r5, :f0-:f15

	(vp-rdef (saved_buf this ok) '(:r5))

	(entry :nodeid :create `(,saved_buf))

	;create new str object
	(call :sys_mem :alloc `(,+nodeid_size) `(,this _))
	(vpif `(,this /= 0))
		;init the object
		(call :nodeid :init `(,this (@ ,(f-path :nodeid :vtable)) ,saved_buf +node_id_size) `(,this ,ok))
		(vpif `(,ok = 0))
			;error with init
			(call :sys_mem :free `(,this))
			(vp-xor-rr this this)
		(endif)
	(endif)

	(exit :nodeid :create `(,this))
	(vp-ret)

(def-func-end)

(def-method :nodeid :hash)
	;inputs
	;:r0 = nodeid object (ptr)
	;outputs
	;:r0 = nodeid object (ptr)
	;:r1 = hash code (long)
	;trashes
	;:r1-:r2

	(vp-rdef (this hcode tmp))

	(entry :nodeid :hash `(,this))

	(assign `((,this ,(+ +nodeid_id +node_id_node1)) (,this ,(+ +nodeid_id +node_id_node2)))
		`(,hcode ,tmp))
	(vp-xor-rr tmp hcode)

	(exit :nodeid :hash `(,this ,hcode))
	(vp-ret)

(def-func-end)

(def-method :nodeid :eql)
	;inputs
	;:r0 = node1 object (ptr)
	;:r1 = node2 object (ptr)
	;outputs
	;:r0 = node1 object (ptr)
	;:r1 = 0 if same, else not
	;trashes
	;:r1-:r4

	(vp-rdef (this that n2_a n2_b n1_a))

	(entry :nodeid :eql `(,this ,that))

	(assign `((,this ,(+ +nodeid_id +node_id_node1)) (,this ,(+ +nodeid_id +node_id_node2))
		(,that ,(+ +nodeid_id +node_id_node1)) (,that ,(+ +nodeid_id +node_id_node2)))
		`(,n1_a ,that ,n2_a ,n2_b))
	(vp-sub-rr n2_a n1_a)
	(vp-sub-rr n2_b that)
	(vp-or-rr n1_a that)

	(exit :nodeid :eql `(,this ,that))
	(vp-ret)

(def-func-end)
