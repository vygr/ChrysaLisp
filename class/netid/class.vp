(include "lib/asm/func.inc")
(include "sys/kernel/class.inc")
(include "./class.inc")
(include "././list/class.inc")

(gen-create :netid)
(gen-vtable :netid)
(gen-type :netid)

(def-method :netid :init)
	;inputs
	;:r0 = netid object (ptr)
	;:r1 = vtable (pptr)
	;outputs
	;:r0 = netid object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r6, :f0-:f15

	(vp-rdef (saved_this this vtable) '(:r6))

	(entry :netid :init `(,this ,vtable))

	;init parent
	(s-call :netid :init `(,this ,vtable 0 ,+net_id_size) `(,this ,vtable))
	(vpif `(,vtable /= 0))
		;init myself
		(vp-cpy-rr this saved_this)
		(call :sys_mail :alloc_mbox :nil `((,saved_this ,(+ +netid_id +net_id_mbox_id)) _))
		(call :sys_kernel :id :nil
			`((,saved_this ,(+ +netid_id +net_id_node_id +node_id_node1))
			(,saved_this ,(+ +netid_id +net_id_node_id +node_id_node2))))
		(vp-cpy-rr saved_this this)
	(endif)

	(exit :netid :init `(,this ,vtable))
	(vp-ret)

(def-func-end)

(def-method :netid :deinit)
	;inputs
	;:r0 = netid object (ptr)
	;outputs
	;:r0 = netid object (ptr)
	;trashes
	;:r1-:r5

	(entry :netid :deinit '(:r5))

	(call :sys_mail :free_mbox `((:r5 ,(+ +netid_id +net_id_mbox_id))))
	(s-jump :netid :deinit '(:r5))

(def-func-end)
