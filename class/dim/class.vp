(include "lib/asm/func.inc")
(include "./class.inc")
(include "././list/class.inc")

(gen-create :dim)
(gen-vtable :dim)
(gen-type :dim)

(def-method :dim :init)
	;inputs
	;:r0 = dim object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = dims nums object (ptr)
	;:r3 = elements array object (ptr)
	;outputs
	;:r0 = dim object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1

	(vp-rdef (this vtable dims elems))

	(entry :dim :init `(,this ,vtable ,dims ,elems))

	;init parent
	(s-call :dim :init `(,this ,vtable) `(,this ,vtable))
	(vpif `(,vtable /= 0))
		;init self
		(class/obj/ref dims vtable)
		(class/obj/ref elems vtable)
		(assign `(,dims ,elems) `((,this +dim_dims) (,this +dim_elems)))
	(endif)

	(exit :dim :init `(,this ,vtable))
	(vp-ret)

(def-func-end)

(def-method :dim :deinit)
	;inputs
	;:r0 = dim object (ptr)
	;outputs
	;:r0 = dim object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this))

	(entry :dim :deinit `(,this))

	(vp-push this)
	(call :obj :deref `((,this +dim_dims)))
	(assign '((:rsp 0)) `(,this))
	(call :obj :deref `((,this +dim_elems)))
	(vp-pop this)
	(s-jump :dim :deinit `(,this))

(def-func-end)
