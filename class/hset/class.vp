(include "lib/asm/func.inc")
(include "./class.inc")

(gen-create :hset)
(gen-vtable :hset)
(gen-type :hset)

(def-method :hset :init)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = num buckets (uint)
	;outputs
	;:r0 = hset object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :f0-:f15

	;save inputs
	(entry :hset :init '(:r0 :r1 (:r0 +array_num_buckets)))

	;init parent
	(s-call :hset :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		;init myself
		(assign '((:r0 +array_num_buckets)) '(:r1))
		(vpif '(:r1 /= 1))
			(assign '(:r1) '((:r0 +array_length)))
			(call :hset :set_cap '(:r0 :r1) '(:r0))
			(class/array/get_both :r0 :r3 :r4)
			(vp-cpy-rr :r0 :r5)
			(loop-start)
				(call :list :create :nil '((:r3 0)))
				(vp-add-cr +ptr_size :r3)
			(loop-until '(:r3 = :r4))
			(vp-cpy-rr :r5 :r0)
		(endif)
	(endif)

	(exit :hset :init '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :hset :cfind)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = key object (ptr)
	;:r2 = key callback (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;:r1 = 0, else found iterator (pptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r12

	(vp-rdef (key1 key2))
	(vp-rdef (this key cmp_func buckets iter_begin iter_end)
		'(:r7 :r8 :r9 :r10 :r11 :r12))

	;save inputs
	(entry :hset :cfind `(,this ,key ,cmp_func))

	;search hash bucket
	(call :hset :bucket `(,this ,key) `(_ ,buckets))
	(class/array/get_both buckets iter_begin iter_end)
	(vpif `(,iter_begin /= ,iter_end))
		(loop-start)
			(assign `((,iter_begin 0) ,key) `(,key2 ,key1))
			;give some indication of the trashes
			;:sym :eql_str is the worst ATM
			(vp-call-r cmp_func :sym :eql_str)
			(gotoif `(,key2 = 0) 'cmp_hit)
			(vp-add-cr +ptr_size iter_begin)
		(loop-until `(,iter_begin = ,iter_end))
	(endif)
	(vp-xor-rr iter_begin iter_begin)
(vp-label 'cmp_hit)
	(exit :hset :cfind `(,this ,iter_begin ,buckets))
	(vp-ret)

(def-func-end)

(def-method :hset :cinsert)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = key object (ptr)
	;:r2 = key callback (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r12, :f0-:f15

	(structure local 0
		(ptr this key))

	;save inputs
	(vp-alloc local_size)
	(entry :hset :cinsert '(:r0 :r1 :r2))
	(assign '(:r1) '((:rsp local_key)))

	;search hash bucket
	(call :hset :cfind '(:r0 :r1 :r2) '(:r0 :r1 :r2))
	(vpif '(:r1 = 0))
		;new key
		(assign '((:rsp local_key) :r0 :r2) '(:r1 (:rsp local_this) :r0))
		(class/obj/ref :r1 :r2)
		(call :list :push_back '(:r0 :r1) '(:r0 _ _ :r3))
		(assign '((& :r3 (neg +ptr_size)) :r0 (:rsp local_this)) '(:r1 :r2 :r0))
	(endif)

	(exit :hset :cinsert '(:r0 :r1 :r2))
	(vp-free local_size)
	(vp-ret)

(def-func-end)

(def-method :hset :each)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = predicate function (ptr)
	;:r2 = predicate data (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
		;callback predicate
		;inputs
		;:r0 = predicate data (ptr)
		;:r1 = element iterator (pptr)
		;:r2 = bucket list pointer (ptr)
		;trashes
		;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this predicate predicate_data bucket)
		(pptr iter_begin iter_end iter_begin1 iter_end1))

	;save inputs
	(vp-alloc local_size)
	(entry :hset :each '(:r0 (:rsp local_predicate) (:rsp local_predicate_data)))
	(assign '(:r0) '((:rsp local_this)))

	;for all buckets
	(assign '((:r0 +array_num_buckets) :r0) '(:r1 :r2))
	(vpif '(:r1 = 1))
		(class/array/get_both :r2 :r1 :r0)
		(assign '(:r2) '((:rsp local_bucket)))
	(vp-label 'erased)
		(assign '(:r0) '((:rsp local_iter_end)))
		(loop-while '(:r1 < :r0))
			(assign '((:rsp local_predicate_data) :r1) '(:r0 (:rsp local_iter_begin)))
			(vp-call-i :rsp local_predicate)
			(assign '((:rsp local_bucket) (:rsp local_iter_begin) (:rsp local_iter_end)) '(:r2 :r1 :r4))
			(class/array/get_end :r2 :r0 :r3)
			(gotoif '(:r0 /= :r4) 'erased)
			(vp-add-cr +ptr_size :r1)
		(loop-end)
	(else)
		(class/array/get_both :r2 :r1 :r0)
		(assign '(:r0) '((:rsp local_iter_end1)))
		(loop-start)
			(assign '((:r1 0) :r1) '(:r2 (:rsp local_iter_begin1)))
			(class/array/get_both :r2 :r1 :r0)
			(assign '(:r2) '((:rsp local_bucket)))
		(vp-label 'erased1)
			(assign '(:r0) '((:rsp local_iter_end)))
			(loop-while '(:r1 < :r0))
				(assign '((:rsp local_predicate_data) :r1) '(:r0 (:rsp local_iter_begin)))
				(vp-call-i :rsp local_predicate)
				(assign '((:rsp local_bucket) (:rsp local_iter_begin) (:rsp local_iter_end)) '(:r2 :r1 :r4))
				(class/array/get_end :r2 :r0 :r3)
				(gotoif '(:r0 /= :r4) 'erased1)
				(vp-add-cr +ptr_size :r1)
			(loop-end)
			(assign '((:rsp local_iter_begin1) (:rsp local_iter_end1)) '(:r1 :r2))
			(vp-add-cr +ptr_size :r1)
		(loop-until '(:r1 = :r2))
	(endif)

	(exit :hset :each '((:rsp local_this)))
	(vp-free local_size)
	(vp-ret)

(def-func-end)

(def-method :hset :bucket)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = key object (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r6

	(entry :hset :bucket '(:r0 :r1))

	;search hash bucket
	(assign '((:r0 +array_num_buckets)) '(:r6))
	(vpif '(:r6 = 1))
		(exit :hset :bucket '(:r0 :r0))
		(vp-ret)
	(endif)
	(assign '(:r0) '(:r5))
	(call :obj :hash '(:r1) '(_ :r0) :r2)
	(vp-xor-rr :r2 :r2)
	(vp-div-rrr-u :r6 :r2 :r0)
	(vp-shl-cr (log2 +long_size) :r2)
	(assign `((:r5 +array_begin)) '(:r1))
	(assign `((:r1 :r2)) '(:r2))
	(exit :hset :bucket '(:r5 :r2))
	(vp-ret)

(def-func-end)

(def-method :hset :flush)
	;inputs
	;:r0 = hset object (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(jump :hset :each '(:r0 ($ flush_callback) 0))

(vp-label 'flush_callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0)) '(:r0))
	(assign '((:r0 +obj_count)) '(:r0))
	(vpif '(:r0 = 1))
		(jump :list :erase '(:r2 :r1))
	(endif)
	(vp-ret)

(def-func-end)
