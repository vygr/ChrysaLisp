(include "lib/asm/func.inc")
(include "./class.inc")

(gen-create :hset)
(gen-vtable :hset)
(gen-type :hset)

(def-method :hset :init)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = num buckets (uint)
	;outputs
	;:r0 = hset object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :f0-:f15

	(vp-rdef (this vtable num_buckets iter_begin iter_end saved_this))

	(entry :hset :init `(,this ,vtable (,this +array_num_buckets)))

	;init parent
	(s-call :hset :init `(,this ,vtable) `(,this ,vtable))
	(vpif `(,vtable /= 0))
		;init myself
		(assign `((,this +array_num_buckets)) `(,vtable))
		(vpif `(,vtable /= 1))
			(assign `(,vtable) `((,this +array_length)))
			(call :hset :set_cap `(,this ,vtable) `(,this))
			(class/array/get_both this iter_begin iter_end)
			(vp-cpy-rr this saved_this)
			(loop-start)
				(call :list :create :nil `((,iter_begin 0)))
				(vp-add-cr +ptr_size iter_begin)
			(loop-until `(,iter_begin = ,iter_end))
			(vp-cpy-rr saved_this this)
		(endif)
	(endif)

	(exit :hset :init `(,this ,vtable))
	(vp-ret)

(def-func-end)

(def-method :hset :cfind)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = key object (ptr)
	;:r2 = key callback (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;:r1 = 0, else found iterator (pptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r12

	(vp-rdef (key1 key2))
	(vp-rdef (this key cmp_func buckets iter_begin iter_end)
		'(:r7 :r8 :r9 :r10 :r11 :r12))

	;save inputs
	(entry :hset :cfind `(,this ,key ,cmp_func))

	;search hash bucket
	(call :hset :bucket `(,this ,key) `(_ ,buckets))
	(class/array/get_both buckets iter_begin iter_end)
	(vpif `(,iter_begin /= ,iter_end))
		(loop-start)
			(assign `((,iter_begin 0) ,key) `(,key2 ,key1))
			;give some indication of the trashes
			;:sym :eql_str is the worst ATM
			(vp-call-r cmp_func :sym :eql_str)
			(gotoif `(,key2 = 0) 'cmp_hit)
			(vp-add-cr +ptr_size iter_begin)
		(loop-until `(,iter_begin = ,iter_end))
	(endif)
	(vp-xor-rr iter_begin iter_begin)
(vp-label 'cmp_hit)
	(exit :hset :cfind `(,this ,iter_begin ,buckets))
	(vp-ret)

(def-func-end)

(def-method :hset :cinsert)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = key object (ptr)
	;:r2 = key callback (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r13, :f0-:f15

	;save inputs
	(entry :hset :cinsert '(:r0 :r1 :r2))

	;search hash bucket
	(assign '(:r1) '(:r13))
	(call :hset :cfind '(:r0 :r1 :r2) '(:r0 :r1 :r2))
	(vpif '(:r1 = 0))
		;new key
		(assign '(:r13 :r0 :r2) '(:r1 :r13 :r0))
		(class/obj/ref :r1 :r2)
		(call :list :push_back '(:r0 :r1) '(:r2 _ _ :r3))
		(assign '((& :r3 (neg +ptr_size)) :r13) '(:r1 :r0))
	(endif)

	(exit :hset :cinsert '(:r0 :r1 :r2))
	(vp-ret)

(def-func-end)

(def-method :hset :each)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = predicate function (ptr)
	;:r2 = predicate data (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
		;callback predicate
		;inputs
		;:r0 = predicate data (ptr)
		;:r1 = element iterator (pptr)
		;:r2 = bucket list pointer (ptr)
		;trashes
		;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this predicate predicate_data bucket)
		(pptr iter_begin iter_end iter_begin1 iter_end1))

	(vp-rdef (this predicate predicate_data scratch old_end))

	;save inputs
	(vp-alloc local_size)
	(entry :hset :each `(,this (:rsp local_predicate) (:rsp local_predicate_data)))
	(assign `(,this) '((:rsp local_this)))

	;for all buckets
	(assign `((,this +array_num_buckets) ,this) `(,predicate ,predicate_data))
	(vpif `(,predicate = 1))
		(class/array/get_both predicate_data predicate this)
		(assign `(,predicate_data) '((:rsp local_bucket)))
	(vp-label 'erased)
		(assign `(,this) '((:rsp local_iter_end)))
		(loop-while `(,predicate < ,this))
			(assign `((:rsp local_predicate_data) ,predicate) `(,this (:rsp local_iter_begin)))
			(vp-call-i :rsp local_predicate)
			(assign `((:rsp local_bucket) (:rsp local_iter_begin) (:rsp local_iter_end))
				`(,predicate_data ,predicate ,old_end))
			(class/array/get_end predicate_data this scratch)
			(gotoif `(,this /= ,old_end) 'erased)
			(vp-add-cr +ptr_size predicate)
		(loop-end)
	(else)
		(class/array/get_both predicate_data predicate this)
		(assign `(,this) '((:rsp local_iter_end1)))
		(loop-start)
			(assign `((,predicate 0) ,predicate) `(,predicate_data (:rsp local_iter_begin1)))
			(class/array/get_both predicate_data predicate this)
			(assign `(,predicate_data) '((:rsp local_bucket)))
		(vp-label 'erased1)
			(assign `(,this) '((:rsp local_iter_end)))
			(loop-while `(,predicate < ,this))
				(assign `((:rsp local_predicate_data) ,predicate) `(,this (:rsp local_iter_begin)))
				(vp-call-i :rsp local_predicate)
				(assign `((:rsp local_bucket) (:rsp local_iter_begin) (:rsp local_iter_end))
					`(,predicate_data ,predicate ,old_end))
				(class/array/get_end predicate_data this scratch)
				(gotoif `(,this /= ,old_end) 'erased1)
				(vp-add-cr +ptr_size predicate)
			(loop-end)
			(assign `((:rsp local_iter_begin1) (:rsp local_iter_end1)) `(,predicate ,predicate_data))
			(vp-add-cr +ptr_size predicate)
		(loop-until `(,predicate = ,predicate_data))
	(endif)

	(exit :hset :each '((:rsp local_this)))
	(vp-free local_size)
	(vp-ret)

(def-func-end)

(def-method :hset :bucket)
	;inputs
	;:r0 = hset object (ptr)
	;:r1 = key object (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;:r2 = bucket list object (ptr)
	;trashes
	;:r1-:r6

	(vp-rdef (saved_this num_buckets this key bucket) '(:r5 :r6))

	(entry :hset :bucket `(,this ,key))

	;search hash bucket
	(assign `((,this +array_num_buckets)) `(,num_buckets))
	(vpif `(,num_buckets = 1))
		(exit :hset :bucket `(,this ,this))
		(vp-ret)
	(endif)
	(assign `(,this) `(,saved_this))
	(call :obj :hash `(,key) `(_ ,this) bucket)
	(vp-xor-rr bucket bucket)
	(vp-div-rrr-u num_buckets bucket this)
	(vp-shl-cr (log2 +long_size) bucket)
	(assign `((,saved_this +array_begin)) `(,key))
	(assign `((,key ,bucket)) `(,bucket))

	(exit :hset :bucket `(,saved_this ,bucket))
	(vp-ret)

(def-func-end)

(def-method :hset :flush)
	;inputs
	;:r0 = hset object (ptr)
	;outputs
	;:r0 = hset object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(vp-rdef (this))

	(entry :hset :flush `(,this))
	(jump :hset :each `(,this ($ flush_callback) 0))

(vp-label 'flush_callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(vp-rdef (data iter bucket))

	(entry :hset :each_callback `(,data ,iter ,bucket))

	(assign `((,iter 0)) `(,data))
	(assign `((,data +obj_count)) `(,data))
	(vpif `(,data = 1))
		(jump :list :erase `(,bucket ,iter))
	(endif)
	(vp-ret)

(def-func-end)
