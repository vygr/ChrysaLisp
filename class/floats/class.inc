(include "././fixeds/class.inc")
(include "././float/class.inc")
(include "./struct.inc")

;a vector of floats of 32 bits, packed, 4 bytes an element, two to a slot
;of the array, each given out and taken in as a :float of the same bits
(def-class :floats :fixeds
	(dec-method :vtable class/floats/vtable)
	(dec-method :type class/floats/type :override :nil :nil (:r1-:r3 :d0-:d15) (:r1-:r3 :d0-:d15))
	(dec-method :create class/floats/create :static :nil :nil (:r0-:r2 :d0-:d15))
	(dec-method :vcreate class/floats/create :final :nil :nil (:r0-:r2 :d0-:d15) (:r0-:r2 :d0-:d15))
	(dec-method :velement class/float/create :final :nil :nil (:r0-:r2 :r14 :d0-:d15) (:r0-:r2 :r14 :d0-:d15))
	;the storage of 4 bytes an element
	(dec-method :set_cap class/floats/set_cap :final :nil :nil (:r1-:r2 :d0-:d15) (:r1-:r2 :d0-:d15))
	(dec-method :ref_elem class/floats/ref_elem :final :nil :nil (:r1-:r3 :r14 :d0-:d15) (:r1-:r3 :r14 :d0-:d15))
	(dec-method :ref_back class/floats/ref_back :final :nil :nil (:r1-:r3 :r14 :d0-:d15) (:r1-:r3 :r14 :d0-:d15))
	(dec-method :set_elem class/floats/set_elem :final :nil :nil (:r2-:r3) (:r2-:r3))
	(dec-method :fill class/floats/fill :final :nil :nil (:r1-:r4 :d0-:d15) (:r1-:r4 :d0-:d15))
	(dec-method :find class/floats/find :final :nil :nil (:r2-:r4) (:r2-:r4))
	(dec-method :rfind class/floats/rfind :final :nil :nil (:r2-:r4) (:r2-:r4))
	(dec-method :slice class/floats/slice :final :nil :nil (:r0-:r2 :r6-:r8 :d0-:d15) (:r0-:r2 :r6-:r8 :d0-:d15))
	(dec-method :cat class/floats/cat :final :nil :nil (:r0-:r9 :d0-:d15) (:r0-:r9 :d0-:d15))
	(dec-method :splice class/floats/splice :final :nil :nil (:r0-:r11 :d0-:d15) (:r0-:r11 :d0-:d15))
	(dec-method :append class/floats/append :final :nil :nil (:r1-:r3 :r6-:r9 :d0-:d15) (:r1-:r3 :r6-:r9 :d0-:d15))
	(dec-method :erase class/floats/erase :final :nil :nil (:r2-:r3) (:r2-:r3))
	(dec-method :erase2 class/floats/erase2 :final :nil :nil (:r2-:r3) (:r2-:r3))
	(dec-method :eql class/floats/eql :final :nil :nil (:r1-:r5) (:r1-:r5))
	(dec-method :hash class/floats/hash :final :nil :nil (:r1-:r4) (:r1-:r4))
	(dec-method :print class/floats/print :final :nil :nil (:r1-:r5 :r14 :d0-:d15) (:r1-:r5 :r14 :d0-:d15))
	;the vector ops in 32 bits, the sum and dot summed as doubles
	(dec-method :add class/floats/add :final :nil :nil (:r1-:r5 :d0-:d1) (:r1-:r5 :d0-:d1))
	(dec-method :sub class/floats/sub :final :nil :nil (:r1-:r5 :d0-:d1) (:r1-:r5 :d0-:d1))
	(dec-method :mul class/floats/mul :final :nil :nil (:r1-:r5 :d0-:d1) (:r1-:r5 :d0-:d1))
	(dec-method :dot class/floats/dot :final :nil :nil (:r1-:r4 :d0-:d5) (:r1-:r4 :d0-:d5))
	(dec-method :convert class/floats/convert :final :nil :nil (:r2-:r6 :d0-:d15) (:r2-:r6 :d0-:d15))
	(dec-method :add_scaled class/floats/add_scaled :final :nil :nil (:r1-:r5 :d0-:d2) (:r1-:r5 :d0-:d2))
	(dec-method :div class/floats/div :final :nil :nil (:r1-:r5 :d0-:d2) (:r1-:r5 :d0-:d2))
	(dec-method :mod class/floats/mod :final :nil :nil (:r1-:r6 :d0-:d3) (:r1-:r6 :d0-:d3))
	(dec-method :abs class/floats/abs :final :nil :nil (:r1-:r4 :d0) (:r1-:r4 :d0))
	(dec-method :sum class/floats/sum :final :nil :nil (:r1-:r3 :d0-:d4) (:r1-:r3 :d0-:d4))
	(dec-method :scale class/floats/scale :final :nil :nil (:r1-:r4 :d0-:d1) (:r1-:r4 :d0-:d1))
	(dec-method :min class/floats/min :final :nil :nil (:r1-:r5 :d0-:d1) (:r1-:r5 :d0-:d1))
	(dec-method :max class/floats/max :final :nil :nil (:r1-:r5 :d0-:d1) (:r1-:r5 :d0-:d1))
	(dec-method :frac class/floats/frac :final :nil :nil (:r1-:r5 :d0-:d3) (:r1-:r5 :d0-:d3))
	(dec-method :floor class/floats/floor :final :nil :nil (:r1-:r5 :d0-:d2) (:r1-:r5 :d0-:d2))
	(dec-method :ceil class/floats/ceil :final :nil :nil (:r1-:r5 :d0-:d2) (:r1-:r5 :d0-:d2))
	(dec-method :push class/floats/push :final :nil :nil (:r1-:r3 :r6-:r9 :r11-:r13 :d0-:d15) (:r1-:r3 :r6-:r9 :r11-:r13 :d0-:d15))
	(dec-method :lisp_floats class/floats/lisp_floats :static (:r0 :r1) (:r0 :r1) (:r1-:r8 :d0-:d15)))

(defun floats-map (sobs dobs elms sitrs ditrs idxs func &optional fpre)
	;vec-map-idx of floats, 4 bytes an element, each loaded as a single and
	;the result stored as one
	(assign `((,(first sobs) +array_length)) `(,(last idxs)))
	(vp-simd vp-load-rcr (cat sobs dobs) (list +array_begin) (cat sitrs ditrs))
	(vp-xor-rr (first idxs) (first idxs))
	(vp-shl-cr (log2 +int_size) (last idxs))
	(if fpre (fpre))
	(loop-start)
		(each (# (assign (list (list %0 (first idxs) 'i)) (list %1))) sitrs elms)
		(defq r (apply func elms))
		(assign (list r) (list (list (first ditrs) (first idxs) 'i)))
		(vp-add-cr +int_size (first idxs))
	(loop-until `(,(first idxs) = ,(last idxs))))
