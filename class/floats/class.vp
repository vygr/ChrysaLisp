(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././stream/class.inc")
(include "././list/class.inc")
(include "././bytes/class.inc")
(include "././shorts/class.inc")
(include "././ints/class.inc")

(gen-create :floats)
	;outputs
	;:r0 = 0 if error, else floats object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :floats)
(gen-type :floats)
	;inputs
	;:r0 = floats object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

;;;;;;;;;;;;;
; the storage
;;;;;;;;;;;;;

;;;;;;;;;;;;;;;;
; the vector ops
;;;;;;;;;;;;;;;;

(def-method :floats :add)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :add `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-add-ff %1 %0) %0))

	(exit :floats :add `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :sub)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :sub `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-sub-ff %1 %0) %0))

	(exit :floats :sub `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :min)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
