(include "lib/asm/func.inc")
(include "./class.inc")
(include "././list/class.inc")
(include "././stream/class.inc")

(gen-create :floats)
	;outputs
	;:r0 = 0 if error, else floats object (ptr)
	;trashes
	;:r0-:r2, :d0-:d15
(gen-vtable :floats)
(gen-type :floats)
	;inputs
	;:r0 = floats object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

;;;;;;;;;;;;;
; the storage
;;;;;;;;;;;;;

(def-method :floats :set_cap)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = capacity (uint)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r2, :d0-:d15
	;info
	;a capacity of floats, two to a slot of the array

	(entry :floats :set_cap '(:r0 :r1))

	(vp-add-cr 1 :r1)
	(vp-shr-cr 1 :r1)
	(s-jump :floats :set_cap '(:r0 :r1))

(def-func-end)

(def-method :floats :ref_elem)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element index (uint)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = float object (ptr)
	;trashes
	;:r1-:r3, :r14, :d0-:d15

	(vp-rdef (this idx base saved_this))

	(entry :floats :ref_elem `(,this ,idx))

	(vp-cpy-rr this saved_this)
	(assign `((,this +array_begin)) `(,base))
	(vp-shl-cr (log2 +int_size) idx)
	(assign `((,base ,idx ui)) `(,this))
	(v-call :floats :velement `(,this) `(,this) saved_this idx)

	(exit :floats :ref_elem `(,saved_this ,this))
	(vp-ret)

(def-func-end)

(def-method :floats :ref_back)
	;inputs
	;:r0 = floats object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = float object (ptr)
	;trashes
	;:r1-:r3, :r14, :d0-:d15

	(vp-rdef (this len begin saved_this))

	(entry :floats :ref_back `(,this))

	(assign `((,this +array_length) (,this +array_begin)) `(,len ,begin))
	(vp-sub-cr 1 len)
	(assign `(,len) `((,this +array_length)))
	(vp-shl-cr (log2 +int_size) len)
	(vp-cpy-rr this saved_this)
	(assign `((,begin ,len ui)) `(,this))
	(v-call :floats :velement `(,this) `(,this) saved_this len)

	(exit :floats :ref_back `(,saved_this ,this))
	(vp-ret)

(def-func-end)

(def-method :floats :set_elem)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element (the 32 bits of a float)
	;:r2 = element index (uint)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r2-:r3

	(entry :floats :set_elem '(:r0 :r1 :r2))

	(assign '((:r0 +array_begin)) '(:r3))
	(vp-shl-cr (log2 +int_size) :r2)
	(assign '(:r1) '((:r3 :r2 i)))

	(exit :floats :set_elem '(:r0))
	(vp-ret)

(def-func-end)

(def-method :floats :fill)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = length (uint)
	;:r2 = element (the 32 bits of a float)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r4, :d0-:d15
	;info
	;the floats made length long, every element the one given

	(entry :floats :fill '(:r0 :r3 :r4))

	(call :floats :set_cap '(:r0 :r3) '(:r0))
	(assign '(:r3) '((:r0 +array_length)))
	(assign '((:r0 +array_begin)) '(:r1))
	(vp-shl-cr (log2 +int_size) :r3)
	(vp-lea-rrr :r1 :r3 :r2)
	(vpif '(:r1 /= :r2))
		(loop-start)
			(assign '(:r4) '((:r1 0 i)))
			(vp-add-cr +int_size :r1)
		(loop-until '(:r1 = :r2))
	(endif)

	(exit :floats :fill '(:r0))
	(vp-ret)

(def-func-end)

(def-method :floats :find)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element (the 32 bits of a float)
	;:r2 = start index (uint)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = element (the 32 bits of a float)
	;:r2 = -1, else index (int)
	;trashes
	;:r2-:r4

	(vp-rdef (this elm idx base tmp))

	(entry :floats :find `(,this ,elm ,idx))

	(assign `((,this +array_length) (,this +array_begin)) `(,tmp ,base))
	(vp-simd vp-shl-cr `(,(log2 +int_size)) `(,idx ,tmp))
	(vp-add-rr base idx)
	(vp-add-rr tmp base)
	(vpif `(,idx /= ,base))
		(loop-start)
			(assign `((,idx 0 ui)) `(,tmp))
			(vp-add-cr +int_size idx)
			(gotoif `(,elm = ,tmp) 'found)
		(loop-until `(,idx = ,base))
	(endif)

	(exit :floats :find `(,this ,elm -1))
	(vp-ret)

(vp-label 'found)
	(assign `((,this +array_begin)) `(,base))
	(vp-sub-cr +int_size idx)
	(vp-sub-rr base idx)
	(vp-shr-cr (log2 +int_size) idx)

	(exit :floats :find `(,this ,elm ,idx))
	(vp-ret)

(def-func-end)

(def-method :floats :rfind)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element (the 32 bits of a float)
	;:r2 = start index (uint)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = element (the 32 bits of a float)
	;:r2 = 0, else index (int)
	;trashes
	;:r2-:r4

	(vp-rdef (this elm idx base tmp))

	(entry :floats :rfind `(,this ,elm ,idx))

	(assign `((,this +array_begin)) `(,base))
	(vp-shl-cr (log2 +int_size) idx)
	(vp-add-rr base idx)
	(vpif `(,idx /= ,base))
		(loop-start)
			(assign `((,idx ,(neg +int_size) ui)) `(,tmp))
			(breakif `(,elm = ,tmp))
			(vp-sub-cr +int_size idx)
		(loop-until `(,idx = ,base))
	(endif)
	(vp-sub-rr base idx)
	(vp-asr-cr (log2 +int_size) idx)

	(exit :floats :rfind `(,this ,elm ,idx))
	(vp-ret)

(def-func-end)

(def-method :floats :slice)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element start index (uint)
	;:r2 = element end index (uint)
	;outputs
	;:r0 = slice floats object (ptr)
	;trashes
	;:r0-:r2, :r6-:r8, :d0-:d15

	(vp-rdef (src si ei this di total) '(:r6 :r7 :r8))

	(entry :floats :slice `(,src ,si ,ei))

	(call :floats :vcreate `(,src) `(,this))
	(vpif `(,si /= ,ei))
		;first set the capacity/length
		(vp-cpy-rr si total)
		(vp-sub-rr ei total)
		(vp-abs-rr total total)
		(assign `(,total) `((,this +array_length)))
		(call :floats :set_cap `(,this ,total) `(,this))
		;now transfer the slice, reversed if needed
		(assign `((,src +array_begin)) `(,total))
		(vp-simd vp-shl-cr `(,(log2 +int_size)) `(,si ,ei))
		(vp-simd vp-add-rr `(,total) `(,si ,ei))
		(assign `((,this +array_begin)) `(,di))
		(vpif `(,si < ,ei))
			(loop-start)
				(assign `((,si 0 ui)) `(,total))
				(vp-simd vp-add-cr `(,+int_size) `(,si ,di))
				(assign `(,total) `((,di ,(neg +int_size) i)))
			(loop-until `(,si = ,ei))
		(else)
			(loop-start)
				(assign `((,si ,(neg +int_size) ui)) `(,total))
				(vp-simd vp-add-cr `(,(neg +int_size) ,+int_size) `(,si ,di))
				(assign `(,total) `((,di ,(neg +int_size) i)))
			(loop-until `(,si = ,ei))
		(endif)
	(endif)

	(exit :floats :slice `(,this))
	(vp-ret)

(def-func-end)

(def-method :floats :cat)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = list of floats objects (ptr)
	;outputs
	;:r0 = new floats object (ptr)
	;trashes
	;:r0-:r9, :d0-:d15

	(vp-rdef (this seqs_begin di src si ei
			len total seqs seqs_end))

	(entry :floats :cat `(,this ,seqs))

	(call :floats :vcreate `(,this) `(,this))
	(class/array/get_both seqs seqs_begin seqs_end)
	(vpif `(,seqs_begin /= ,seqs_end))
		;first set the capacity/length
		(vp-xor-rr total total)
		(loop-start)
			(assign `((,seqs_begin 0)) `(,src))
			(vp-add-cr +ptr_size seqs_begin)
			(assign `((,src +array_length)) `(,len))
			(vp-add-rr len total)
		(loop-until `(,seqs_begin = ,seqs_end))
		(assign `(,total) `((,this +array_length)))
		(call :floats :set_cap `(,this ,total) `(,this))
		;now transfer the sequences
		(assign `((,this +array_begin) (,seqs +array_begin)) `(,di ,seqs_begin))
		(loop-start)
			(assign `((,seqs_begin 0)) `(,src))
			(vp-add-cr +ptr_size seqs_begin)
			(assign `((,src +array_length) (,src +array_begin)) `(,ei ,si))
			(vp-shl-cr (log2 +int_size) ei)
			(vp-add-rr si ei)
			(vpif `(,si /= ,ei))
				;copy the sequence
				(loop-start)
					(assign `((,si 0 ui)) `(,len))
					(vp-simd vp-add-cr `(,+int_size) `(,si ,di))
					(assign `(,len) `((,di ,(neg +int_size) i)))
				(loop-until `(,si = ,ei))
			(endif)
		(loop-until `(,seqs_begin = ,seqs_end))
	(endif)

	(exit :floats :cat `(,this))
	(vp-ret)

(def-func-end)

(def-method :floats :splice)
	;inputs
	;:r0 = src1 floats object (ptr)
	;:r1 = src2 floats object (ptr)
	;:r2 = nums object (ptr)
	;outputs
	;:r0 = new floats object (ptr)
	;trashes
	;:r0-:r11, :d0-:d15

	(vp-rdef (this idx_begin di si ei swp_xor len total
			src1 src2 idxs idx_end))

	(entry :floats :splice `(,src1 ,src2 ,idxs))

	(call :floats :vcreate `(,src1) `(,this))
	(class/array/get_both idxs idx_begin idx_end)
	(vpif `(,idx_begin /= ,idx_end))
		;first set the capacity/length
		(assign `((,src1 +array_length) (,src2 +array_length)) `(,len ,ei))
		(vp-cpy-rr len swp_xor)
		(vp-xor-rr ei swp_xor)
		(vp-xor-rr total total)
		(loop-start)
			;indices
			(vp-simd vp-load-rcr `(,idx_begin) `(0 ,+long_size) `(,si ,ei))
			(vp-add-cr (* +long_size 2) idx_begin)
			;the length this time
			(seq-elem-index si len)
			(seq-elem-index ei len)
			(vp-xor-rr swp_xor len)
			;sum the absolute val of index diff
			(vp-sub-rr si ei)
			(vp-abs-rr ei ei)
			(vp-add-rr ei total)
		(loop-until `(,idx_begin = ,idx_end))
		(assign `(,total) `((,this +array_length)))
		(call :floats :set_cap `(,this ,total) `(,this))
		;now transfer the slices
		(assign `((,this +array_begin) (,idxs +array_begin)) `(,di ,idx_begin))
		(vp-cpy-rr src1 swp_xor)
		(vp-xor-rr src2 swp_xor)
		(loop-start)
			;indices
			(vp-simd vp-load-rcr `(,idx_begin) `(0 ,+long_size) `(,si ,ei))
			(vp-add-cr (* +long_size 2) idx_begin)
			;the source this time
			(assign `((,src1 +array_length) (,src1 +array_begin)) `(,len ,src2))
			(seq-elem-index si len)
			(seq-elem-index ei len)
			(vp-xor-rr swp_xor src1)
			(vpif `(,si /= ,ei))
				(vp-simd vp-shl-cr `(,(log2 +int_size)) `(,si ,ei))
				(vp-simd vp-add-rr `(,src2) `(,si ,ei))
				;copy the slice, reverse if required
				(vpif `(,si < ,ei))
					(loop-start)
						(assign `((,si 0 ui)) `(,len))
						(vp-simd vp-add-cr `(,+int_size) `(,si ,di))
						(assign `(,len) `((,di ,(neg +int_size) i)))
					(loop-until `(,si = ,ei))
				(else)
					(loop-start)
						(assign `((,si ,(neg +int_size) ui)) `(,len))
						(vp-simd vp-add-cr `(,(neg +int_size) ,+int_size) `(,si ,di))
						(assign `(,len) `((,di ,(neg +int_size) i)))
					(loop-until `(,si = ,ei))
				(endif)
			(endif)
		(loop-until `(,idx_begin = ,idx_end))
	(endif)

	(exit :floats :splice `(,this))
	(vp-ret)

(def-func-end)

(def-method :floats :append)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object (ptr)
	;:r2 = element start index (uint)
	;:r3 = element end index (uint)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r3, :r6-:r9, :d0-:d15

	(vp-rdef (saved_that saved_si saved_ei di this that si ei)
		'(:r6 :r7 :r8 :r9))

	(entry :floats :append `(,this ,that ,si ,ei))

	(vpif `(,si /= ,ei))
		;save inputs
		(assign `(,that ,si ,ei) `(,saved_that ,saved_si ,saved_ei))

		;extend floats
		(assign `((,this +array_length)) `(,di))
		(vp-sub-rr si ei)
		(assign `((& ,ei ,di)) `(,that))
		(assign `(,that) `((,this +array_length)))
		(call :floats :set_cap `(,this ,that) `(,this))

		;append elements
		(assign `((,saved_that +array_begin)) `(,that))
		(vp-simd vp-shl-cr `(,(log2 +int_size)) `(,saved_si ,saved_ei ,di))
		(vp-simd vp-add-rr `(,that) `(,saved_si ,saved_ei))
		(assign `((,this +array_begin)) `(,that))
		(vp-add-rr that di)
		(loop-start)
			(assign `((,saved_si 0 ui)) `(,that))
			(vp-simd vp-add-cr `(,+int_size) `(,saved_si ,di))
			(assign `(,that) `((,di ,(neg +int_size) i)))
		(loop-until `(,saved_si = ,saved_ei))
	(endif)

	(exit :floats :append `(,this))
	(vp-ret)

(def-func-end)

(def-method :floats :erase)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element iterator (pint)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = element iterator (pint)
	;trashes
	;:r2-:r3

	(vp-rdef (this iter len begin))

	(entry :floats :erase `(,this ,iter))

	;the last in place of the erased
	(assign `((,this +array_length) (,this +array_begin)) `(,len ,begin))
	(vp-sub-cr 1 len)
	(assign `(,len) `((,this +array_length)))
	(vp-shl-cr (log2 +int_size) len)
	(vp-add-rr len begin)
	(vpif `(,begin /= ,iter))
		(assign `((,begin 0 ui)) `(,len))
		(assign `(,len) `((,iter 0 i)))
	(endif)

	(exit :floats :erase `(,this ,iter))
	(vp-ret)

(def-func-end)

(def-method :floats :erase2)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = element iterator (pint)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = element iterator (pint)
	;trashes
	;:r2-:r3

	(vp-rdef (this iter len begin))

	(entry :floats :erase2 `(,this ,iter))

	;the last two in place of the erased
	(assign `((,this +array_length) (,this +array_begin)) `(,len ,begin))
	(vp-sub-cr 2 len)
	(assign `(,len) `((,this +array_length)))
	(vp-shl-cr (log2 +int_size) len)
	(vp-add-rr len begin)
	(vpif `(,begin /= ,iter))
		(assign `((,begin 0 ui) (,begin ,+int_size ui)) `(,begin ,len))
		(assign `(,begin ,len) `((,iter 0 i) (,iter ,+int_size i)))
	(endif)

	(exit :floats :erase2 `(,this ,iter))
	(vp-ret)

(def-func-end)

(def-method :floats :eql)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = obj object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if same, else not
	;trashes
	;:r1-:r5

	(vp-rdef (this that len1 len2 itr1 itr2))

	(entry :floats :eql `(,this ,that))

	(gotoif `(,this = ,that) 'same)
	(assign `((,this +obj_vtable) (,that +obj_vtable)) `(,len1 ,len2))
	(gotoif `(,len1 /= ,len2) 'not_same)
	(assign `((,this +array_length) (,that +array_length)) `(,len1 ,len2))
	(gotoif `(,len1 /= ,len2) 'not_same)
	(gotoif `(,len1 = 0) 'same)
	(assign `((,this +array_begin) (,that +array_begin)) `(,itr1 ,itr2))
	(vp-shl-cr (log2 +int_size) len1)
	(vp-add-rr itr1 len1)
	(loop-start)
		(assign `((,itr1 0 ui) (,itr2 0 ui)) `(,that ,len2))
		(gotoif `(,that /= ,len2) 'not_same)
		(vp-simd vp-add-cr `(,+int_size) `(,itr1 ,itr2))
	(loop-until `(,itr1 = ,len1))

(vp-label 'same)
	(exit :floats :eql `(,this 0))
	(vp-ret)

(vp-label 'not_same)
	(exit :floats :eql `(,this -1))
	(vp-ret)

(def-func-end)

(def-method :floats :hash)
	;inputs
	;:r0 = floats object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = hash code (long)
	;trashes
	;:r1-:r4

	(vp-rdef (src val src1 src_end e0))

	(entry :floats :hash `(,src))

	(vp-xor-rr val val)
	(assign `((,src +array_length) (,src +array_begin)) `(,src_end ,src1))
	(vp-shl-cr (log2 +int_size) src_end)
	(vp-add-rr src1 src_end)
	(vpif `(,src1 /= ,src_end))
		(loop-start)
			(assign `((,src1 0 ui)) `(,e0))
			(vp-add-cr +int_size src1)
			(vp-xor-rr e0 val)
		(loop-until `(,src1 = ,src_end))
	(endif)
	(vp-shr-cr 1 val)

	(exit :floats :hash `(,src ,val))
	(vp-ret)

(def-func-end)

(def-method :floats :print)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = stream object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :r14, :d0-:d15

	(structure slot 0
		(ptr this stream)
		(pint iter_begin iter_end))

	(vp-alloc slot_size)
	(entry :floats :print '(:r0 :r1))
	(save-fields :rsp '(slot_this slot_stream) '(:r0 :r1))

	(call :stream :write_char '(:r1 +char_lrb))
	(assign '((:rsp slot_this)) '(:r0))
	(assign '((:r0 +array_length) (:r0 +array_begin)) '(:r2 :r4))
	(vp-shl-cr (log2 +int_size) :r2)
	(vp-add-rr :r4 :r2)
	(vpif '(:r4 /= :r2))
		(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r4 :r2))
		;the place is in :r4, which the write of a char leaves
		(loop-start)
			(assign '((:r4 0 ui)) '(:r0))
			(assign '((:rsp slot_this)) '(:r1))
			(v-call :floats :velement '(:r0) '(:r0) :r1 :r1)
			(call :num :print '(:r0 (:rsp slot_stream)) '(:r0))
			(call :num :deref '(:r0))
			(load-fields :rsp '(slot_iter_begin slot_iter_end) '(:r4 :r2))
			(vp-add-cr +int_size :r4)
			(breakif '(:r4 = :r2))
			(assign '(:r4) '((:rsp slot_iter_begin)))
			(call :stream :write_char '((:rsp slot_stream) +char_space))
		(loop-end)
	(endif)
	(call :stream :write_char '((:rsp slot_stream) +char_rrb))

	(exit :floats :print '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :floats :push)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r3, :r6-:r9, :r11-:r13, :d0-:d15
	;info
	;each of the args after the first onto the end, raw as push has them
	;for the other arrays: a number the low 32 bits of its value, a floats
	;its elements, any other array or a str its bytes, 4 to an element

	(vp-rdef (this arg tmp len) '(:r0 :r1 :r2 :r3))
	;not :r10, which lisp_push keeps over this
	(vp-rdef (saved iter iter_end) '(:r11 :r12 :r13))

	(entry :floats :push `(,this ,arg))

	(vp-cpy-rr this saved)
	(class/array/get_both arg iter iter_end)
	(vp-add-cr +ptr_size iter)
	(loop-while `(,iter /= ,iter_end))
		(assign `((,iter 0)) `(,this))
		(vp-add-cr +ptr_size iter)
		(switch)
			(call :obj :inst_of `(,this (@ ,(f-path :num :vtable))) `(,arg ,tmp))
			(nextcaseif `(,tmp = 0))
			;a number, the low 32 bits of its value
			(assign `((,arg +num_value) (,saved +array_length)) `(,tmp ,len))
			(vp-push tmp len)
			(vp-cpy-rr len arg)
			(vp-add-cr 1 arg)
			(assign `(,arg) `((,saved +array_length)))
			(call :floats :set_cap `(,saved ,arg))
			(vp-pop tmp len)
			(assign `((,saved +array_begin)) `(,arg))
			(vp-shl-cr (log2 +int_size) len)
			(assign `(,tmp) `((,arg ,len i)))
			(break)
		(default)
			(call :obj :inst_of `(,arg (@ ,(f-path :floats :vtable))) `(,arg ,tmp))
			(nextcaseif `(,tmp = 0))
			;a floats, its elements
			(assign `((,arg +array_length)) `(,len))
			(call :floats :append `(,saved ,arg 0 ,len))
			(break)
		(default)
			(call :obj :inst_of `(,arg (@ ,(f-path :array :vtable))) `(,arg ,tmp))
			(nextcaseif `(,tmp = 0))
			;another array, its bytes
			(assign `((,arg +array_length) (,arg +array_begin)) `(,len ,tmp))
			(vp-shl-cr (log2 +long_size) len)
			(goto 'bytes)
		(default)
			(call :obj :inst_of `(,arg (@ ,(f-path :str :vtable))) `(,arg ,tmp))
			(nextcaseif `(,tmp = 0))
			;a str, its bytes
			(assign `((,arg +str_length)) `(,len))
			(vp-lea-rcr arg +str_data tmp)
		(vp-label 'bytes)
			;len bytes at tmp, the whole floats of them
			(vp-shr-cr (log2 +int_size) len)
			(assign `((,saved +array_length)) `(,arg))
			(vp-push tmp len arg)
			(vp-add-rr len arg)
			(assign `(,arg) `((,saved +array_length)))
			(call :floats :set_cap `(,saved ,arg))
			(vp-pop tmp len arg)
			(assign `((,saved +array_begin)) `(,this))
			(vp-shl-cr (log2 +int_size) arg)
			(vp-add-rr this arg)
			(vp-shl-cr (log2 +int_size) len)
			(call :sys_mem :copy `(,tmp ,arg ,len))
			(break)
		(default)
			(goto 'error)
		(endswitch)
	(loop-end)

	(exit :floats :push `(,saved -1))
	(vp-ret)

(vp-label 'error)
	(exit :floats :push `(,saved 0))
	(vp-ret)

(def-func-end)

;;;;;;;;;;;;;;;;
; the vector ops
;;;;;;;;;;;;;;;;

(def-method :floats :add)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :add `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-add-ff %1 %0) %0))

	(exit :floats :add `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :sub)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :sub `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-sub-ff %1 %0) %0))

	(exit :floats :sub `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :min)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :min `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-min-ff %1 %0) %0))

	(exit :floats :min `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :max)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :max `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-max-ff %1 %0) %0))

	(exit :floats :max `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :mul)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :mul `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-ff %1 %0) %0))

	(exit :floats :mul `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :div)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1 zero))

	(entry :floats :div `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = ,zero) 'error)
			(vp-div-ff %1 %0) %0)
		(#	(vp-cvt-rf idx1 zero)))

	(exit :floats :div `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :floats :div `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :floats :mod)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r6, :d0-:d3

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 e1 ftrunc zero))

	(entry :floats :mod `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = ,zero) 'error)
			(vp-cpy-ff %0 ftrunc)
			(vp-div-ff %1 ftrunc)
			(vp-cvt-fr ftrunc trunc)
			(vp-cvt-rf trunc ftrunc)
			(vp-mul-ff %1 ftrunc)
			(vp-sub-ff ftrunc %0)
			%0)
		(#	(vp-cvt-rf idx1 zero)))

	(exit :floats :mod `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :floats :mod `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :floats :frac)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d3

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 ftrunc one zero))

	(entry :floats :frac `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-fr %0 trunc)
			(vp-cvt-rf trunc ftrunc)
			(vp-sub-ff ftrunc %0)
			(vpif `(,%%0 < ,zero))
				(vp-add-ff one %0)
			(endif)
			%0)
		(#	(vp-cvt-rf idx1 zero)
			(vp-cpy-cr 1 trunc)
			(vp-cvt-rf trunc one)))

	(exit :floats :frac `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :floor)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 ftrunc one))

	(entry :floats :floor `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-fr %0 trunc)
			(vp-cvt-rf trunc ftrunc)
			(vpif `(,ftrunc > ,%%0))
				(vp-sub-ff one ftrunc)
			(endif)
			ftrunc)
		(#	(vp-cpy-cr 1 trunc)
			(vp-cvt-rf trunc one)))

	(exit :floats :floor `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :ceil)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 ftrunc one))

	(entry :floats :ceil `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-fr %0 trunc)
			(vp-cvt-rf trunc ftrunc)
			(vpif `(,ftrunc < ,%%0))
				(vp-add-ff one ftrunc)
			(endif)
			ftrunc)
		(#	(vp-cpy-cr 1 trunc)
			(vp-cvt-rf trunc one)))

	(exit :floats :ceil `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :abs)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r4, :d0

	(vp-rdef (dst src1 dst1 idx1 idx2))
	(vp-fdef (e0))

	(entry :floats :abs `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-abs-ff %0 %0) %0))

	(exit :floats :abs `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :scale)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;:r2 = scale (the 32 bits of a float)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r4, :d0-:d1

	(vp-rdef (dst src1 dst1 idx1 idx2))
	(vp-fdef (e0 scale))

	(entry :floats :scale `(,dst ,src1 ,scale))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-mul-ff scale %0) %0))

	(exit :floats :scale `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :add_scaled)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;:r3 = scale (the 32 bits of a float)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2
	;info
	;each of the first plus each of the second times the scale, in one pass

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1 scale))

	(entry :floats :add_scaled `(,dst ,src1 ,src2 ,scale))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-ff scale %1) (vp-add-ff %1 %0) %0))

	(exit :floats :add_scaled `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :convert)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source nums object, of any kind (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r2-:r6, :d0-:d15
	;info
	;made the source's length, each element of it converted

	(nums-convert-method :floats :floats)

(def-func-end)

(def-method :floats :sum)
	;inputs
	;:r0 = floats object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = sum (the 32 bits of a float)
	;trashes
	;:r1-:r3, :d0-:d4
	;info
	;four running sums, as doubles, over blocks of four, the rest into the
	;first, then the four added and rounded to the nearest float

	(vp-rdef (this src end quad))
	(vp-ddef (sum s1 s2 s3 e0))

	(entry :floats :sum `(,this))

	(assign `((,this +array_length) (,this +array_begin)) `(,end ,src))
	(vp-xor-rr quad quad)
	(vp-cvt-rd quad sum)
	(vp-cpy-dd sum s1)
	(vp-cpy-dd sum s2)
	(vp-cpy-dd sum s3)
	(vp-cpy-rr end quad)
	(vp-and-cr -4 quad)
	(vp-shl-cr (log2 +int_size) end)
	(vp-shl-cr (log2 +int_size) quad)
	(vp-add-rr src end)
	(vp-add-rr src quad)
	(vpif `(,src /= ,quad))
		(loop-start)
			(assign `((,src 0 i)) `(,e0))
			(vp-add-dd e0 sum)
			(assign `((,src ,+int_size i)) `(,e0))
			(vp-add-dd e0 s1)
			(assign `((,src ,(* 2 +int_size) i)) `(,e0))
			(vp-add-dd e0 s2)
			(assign `((,src ,(* 3 +int_size) i)) `(,e0))
			(vp-add-dd e0 s3)
			(vp-add-cr (* 4 +int_size) src)
		(loop-until `(,src = ,quad))
	(endif)
	(vpif `(,src /= ,end))
		(loop-start)
			(assign `((,src 0 i)) `(,e0))
			(vp-add-dd e0 sum)
			(vp-add-cr +int_size src)
		(loop-until `(,src = ,end))
	(endif)
	(vp-add-dd s1 sum)
	(vp-add-dd s3 s2)
	(vp-add-dd s2 sum)
	(vp-cvt-df sum :f0)
	(float-bits :f0 src)

	(exit :floats :sum `(,this ,src))
	(vp-ret)

(def-func-end)

(def-method :floats :dot)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = dot product (the 32 bits of a float)
	;trashes
	;:r1-:r4, :d0-:d5
	;info
	;four running sums, as doubles, over blocks of four, the rest into the
	;first, then the four added and rounded to the nearest float

	(vp-rdef (this src2 src1 end quad))
	(vp-ddef (dot s1 s2 s3 e0 e1))

	(entry :floats :dot `(,this ,src2))

	(assign `((,this +array_length) (,this +array_begin) (,src2 +array_begin)) `(,end ,src1 ,src2))
	(vp-xor-rr quad quad)
	(vp-cvt-rd quad dot)
	(vp-cpy-dd dot s1)
	(vp-cpy-dd dot s2)
	(vp-cpy-dd dot s3)
	(vp-cpy-rr end quad)
	(vp-and-cr -4 quad)
	(vp-shl-cr (log2 +int_size) end)
	(vp-shl-cr (log2 +int_size) quad)
	(vp-add-rr src1 end)
	(vp-add-rr src1 quad)
	(vpif `(,src1 /= ,quad))
		(loop-start)
			(assign `((,src1 0 i) (,src2 0 i)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 dot)
			(assign `((,src1 ,+int_size i) (,src2 ,+int_size i)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s1)
			(assign `((,src1 ,(* 2 +int_size) i) (,src2 ,(* 2 +int_size) i)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s2)
			(assign `((,src1 ,(* 3 +int_size) i) (,src2 ,(* 3 +int_size) i)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s3)
			(vp-add-cr (* 4 +int_size) src1)
			(vp-add-cr (* 4 +int_size) src2)
		(loop-until `(,src1 = ,quad))
	(endif)
	(vpif `(,src1 /= ,end))
		(loop-start)
			(assign `((,src1 0 i) (,src2 0 i)) `(,e0 ,e1))
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 dot)
			(vp-add-cr +int_size src1)
			(vp-add-cr +int_size src2)
		(loop-until `(,src1 = ,end))
	(endif)
	(vp-add-dd s1 dot)
	(vp-add-dd s3 s2)
	(vp-add-dd s2 dot)
	(vp-cvt-df dot :f0)
	(float-bits :f0 src2)

	(exit :floats :dot `(,this ,src2))
	(vp-ret)

(def-func-end)
