(def-func-end)

(def-method :floats :max)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :max `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-max-ff %1 %0) %0))

	(exit :floats :max `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :mul)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d1

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1))

	(entry :floats :mul `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-ff %1 %0) %0))

	(exit :floats :mul `(,dst -1))
	(vp-ret)

(def-func-end)

(def-method :floats :div)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1 zero))

	(entry :floats :div `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = ,zero) 'error)
			(vp-div-ff %1 %0) %0)
		(#	(vp-cvt-rf idx1 zero)))

	(exit :floats :div `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :floats :div `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :floats :mod)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r6, :d0-:d3

	(vp-rdef (dst src1 src2 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 e1 ftrunc zero))

	(entry :floats :mod `(,dst ,src1 ,src2))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(#	(gotoif `(,%%1 = ,zero) 'error)
			(vp-cpy-ff %0 ftrunc)
			(vp-div-ff %1 ftrunc)
			(vp-cvt-fr ftrunc trunc)
			(vp-cvt-rf trunc ftrunc)
			(vp-mul-ff %1 ftrunc)
			(vp-sub-ff ftrunc %0)
			%0)
		(#	(vp-cvt-rf idx1 zero)))

	(exit :floats :mod `(,dst -1))
	(vp-ret)
(vp-label 'error)
	(exit :floats :mod `(,dst 0))
	(vp-ret)

(def-func-end)

(def-method :floats :frac)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d3

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 ftrunc one zero))

	(entry :floats :frac `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-fr %0 trunc)
			(vp-cvt-rf trunc ftrunc)
			(vp-sub-ff ftrunc %0)
			(vpif `(,%%0 < ,zero))
				(vp-add-ff one %0)
			(endif)
			%0)
		(#	(vp-cvt-rf idx1 zero)
			(vp-cpy-cr 1 trunc)
			(vp-cvt-rf trunc one)))

	(exit :floats :frac `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :floor)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 ftrunc one))

	(entry :floats :floor `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-fr %0 trunc)
			(vp-cvt-rf trunc ftrunc)
			(vpif `(,ftrunc > ,%%0))
				(vp-sub-ff one ftrunc)
			(endif)
			ftrunc)
		(#	(vp-cpy-cr 1 trunc)
			(vp-cvt-rf trunc one)))

	(exit :floats :floor `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :ceil)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2

	(vp-rdef (dst src1 dst1 idx1 idx2 trunc))
	(vp-fdef (e0 ftrunc one))

	(entry :floats :ceil `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(#	(vp-cvt-fr %0 trunc)
			(vp-cvt-rf trunc ftrunc)
			(vpif `(,ftrunc < ,%%0))
				(vp-add-ff one ftrunc)
			(endif)
			ftrunc)
		(#	(vp-cpy-cr 1 trunc)
			(vp-cvt-rf trunc one)))

	(exit :floats :ceil `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :abs)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r4, :d0

	(vp-rdef (dst src1 dst1 idx1 idx2))
	(vp-fdef (e0))

	(entry :floats :abs `(,dst ,src1))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-abs-ff %0 %0) %0))

	(exit :floats :abs `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :scale)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source floats object, can be same (ptr)
	;:r2 = scale (the 32 bits of a float)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r4, :d0-:d1

	(vp-rdef (dst src1 dst1 idx1 idx2))
	(vp-fdef (e0 scale))

	(entry :floats :scale `(,dst ,src1 ,scale))

	(floats-map (list src1) (list dst) (list e0)
		(list src1) (list dst1) (list idx1 idx2)
		(# (vp-mul-ff scale %0) %0))

	(exit :floats :scale `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :add_scaled)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source1 floats object, can be same (ptr)
	;:r2 = source2 floats object, can be same (ptr)
	;:r3 = scale (the 32 bits of a float)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r1-:r5, :d0-:d2
	;info
	;each of the first plus each of the second times the scale, in one pass

	(vp-rdef (dst src1 src2 dst1 idx1 idx2))
	(vp-fdef (e0 e1 scale))

	(entry :floats :add_scaled `(,dst ,src1 ,src2 ,scale))

	(floats-map (list src1 src2) (list dst) (list e0 e1)
		(list src1 src2) (list dst1) (list idx1 idx2)
		(# (vp-mul-ff scale %1) (vp-add-ff %1 %0) %0))

	(exit :floats :add_scaled `(,dst))
	(vp-ret)

(def-func-end)

(def-method :floats :convert)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = source nums object, of any kind (ptr)
	;:r3 = 1 to read a raw source signed, else 0 (uint)
	;outputs
	;:r0 = floats object (ptr)
	;trashes
	;:r2-:r6, :d0-:d15
	;info
	;made the source's length, each element of it converted

	(nums-convert-method :floats :floats)

(def-func-end)

(def-method :floats :sum)
	;inputs
	;:r0 = floats object (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = sum (the 32 bits of a float)
	;trashes
	;:r1-:r3, :d0-:d4
	;info
	;four running sums, as doubles, over blocks of four, the rest into the
	;first, then the four added and rounded to the nearest float

	(vp-rdef (this src end quad))
	(vp-ddef (sum s1 s2 s3 e0))

	(entry :floats :sum `(,this))

	(assign `((,this +array_length) (,this +array_begin)) `(,end ,src))
	(vp-xor-rr quad quad)
	(vp-cvt-rd quad sum)
	(vp-cpy-dd sum s1)
	(vp-cpy-dd sum s2)
	(vp-cpy-dd sum s3)
	(vp-cpy-rr end quad)
	(vp-and-cr -4 quad)
	(vp-shl-cr (log2 +int_size) end)
	(vp-shl-cr (log2 +int_size) quad)
	(vp-add-rr src end)
	(vp-add-rr src quad)
	(vpif `(,src /= ,quad))
		(loop-start)
			(vp-load-rcf src 0 (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-add-dd e0 sum)
			(vp-load-rcf src +int_size (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-add-dd e0 s1)
			(vp-load-rcf src (* 2 +int_size) (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-add-dd e0 s2)
			(vp-load-rcf src (* 3 +int_size) (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-add-dd e0 s3)
			(vp-add-cr (* 4 +int_size) src)
		(loop-until `(,src = ,quad))
	(endif)
	(vpif `(,src /= ,end))
		(loop-start)
			(vp-load-rcf src 0 (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-add-dd e0 sum)
			(vp-add-cr +int_size src)
		(loop-until `(,src = ,end))
	(endif)
	(vp-add-dd s1 sum)
	(vp-add-dd s3 s2)
	(vp-add-dd s2 sum)
	(vp-cvt-df sum :f0)
	(float-bits :f0 src)

	(exit :floats :sum `(,this ,src))
	(vp-ret)

(def-func-end)

(def-method :floats :dot)
	;inputs
	;:r0 = floats object (ptr)
	;:r1 = floats object, can be same (ptr)
	;outputs
	;:r0 = floats object (ptr)
	;:r1 = dot product (the 32 bits of a float)
	;trashes
	;:r1-:r4, :d0-:d5
	;info
	;four running sums, as doubles, over blocks of four, the rest into the
	;first, then the four added and rounded to the nearest float

	(vp-rdef (this src2 src1 end quad))
	(vp-ddef (dot s1 s2 s3 e0 e1))

	(entry :floats :dot `(,this ,src2))

	(assign `((,this +array_length) (,this +array_begin) (,src2 +array_begin)) `(,end ,src1 ,src2))
	(vp-xor-rr quad quad)
	(vp-cvt-rd quad dot)
	(vp-cpy-dd dot s1)
	(vp-cpy-dd dot s2)
	(vp-cpy-dd dot s3)
	(vp-cpy-rr end quad)
	(vp-and-cr -4 quad)
	(vp-shl-cr (log2 +int_size) end)
	(vp-shl-cr (log2 +int_size) quad)
	(vp-add-rr src1 end)
	(vp-add-rr src1 quad)
	(vpif `(,src1 /= ,quad))
		(loop-start)
			(vp-load-rcf src1 0 (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-load-rcf src2 0 (vp-reg-single e1)) (vp-cvt-fd (vp-reg-single e1) e1)
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 dot)
			(vp-load-rcf src1 +int_size (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-load-rcf src2 +int_size (vp-reg-single e1)) (vp-cvt-fd (vp-reg-single e1) e1)
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s1)
			(vp-load-rcf src1 (* 2 +int_size) (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-load-rcf src2 (* 2 +int_size) (vp-reg-single e1)) (vp-cvt-fd (vp-reg-single e1) e1)
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s2)
			(vp-load-rcf src1 (* 3 +int_size) (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-load-rcf src2 (* 3 +int_size) (vp-reg-single e1)) (vp-cvt-fd (vp-reg-single e1) e1)
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 s3)
			(vp-add-cr (* 4 +int_size) src1)
			(vp-add-cr (* 4 +int_size) src2)
		(loop-until `(,src1 = ,quad))
	(endif)
	(vpif `(,src1 /= ,end))
		(loop-start)
			(vp-load-rcf src1 0 (vp-reg-single e0)) (vp-cvt-fd (vp-reg-single e0) e0)
			(vp-load-rcf src2 0 (vp-reg-single e1)) (vp-cvt-fd (vp-reg-single e1) e1)
			(vp-mul-dd e1 e0)
			(vp-add-dd e0 dot)
			(vp-add-cr +int_size src1)
			(vp-add-cr +int_size src2)
		(loop-until `(,src1 = ,end))
	(endif)
	(vp-add-dd s1 dot)
	(vp-add-dd s3 s2)
	(vp-add-dd s2 dot)
	(vp-cvt-df dot :f0)
	(float-bits :f0 src2)

	(exit :floats :dot `(,this ,src2))
	(vp-ret)

(def-func-end)
