(include "lib/asm/func.inc")
(include "sys/str/class.inc")
(include "lib/consts/chars.inc")
(include "./class.inc")
(include "././sstream/class.inc")
(include "././list/class.inc")

(gen-create :error)
	;inputs
	;:r0 = description c string (pubyte)
	;:r1 = 0, else error msg index (uint)
	;:r2 = error payload object (ptr)
	;:r3 = script string (ptr)
	;:r4 = stream string (ptr)
	;:r5 = stream line number (uint)
	;:r6 = stack frame (ptr)
	;outputs
	;:r0 = 0 if error, else error object (ptr)
	;trashes
	;:r0-:r8, :r14, :d0-:d15
(gen-vtable :error)
(gen-type :error)
	;inputs
	;:r0 = error object (ptr)
	;outputs
	;:r0 = error object (ptr)
	;:r1 = type list object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

(def-method :error :init)
	;inputs
	;:r0 = error object (ptr)
	;:r1 = vtable (pptr)
	;:r2 = description c string (pubyte)
	;:r3 = 0, else error msg index (uint)
	;:r4 = error payload object (ptr)
	;:r5 = script string (ptr)
	;:r6 = stream string (ptr)
	;:r7 = stream line number (uint)
	;:r8 = stack frame (ptr)
	;outputs
	;:r0 = error object (ptr)
	;:r1 = 0 if error, else ok
	;trashes
	;:r1-:r5, :d0-:d15

	(structure slot 0
		(ptr this))

	;save inputs
	(vp-alloc slot_size)
	(assign '(:r0 :r2 :r3 :r4 :r5 :r6 :r7 :r8)
		'((:rsp slot_this) (:r0 +error_description) (:r0 +error_msg i) (:r0 +error_object)
		(:r0 +error_script) (:r0 +error_file) (:r0 +error_line i) (:r0 +error_frame)))

	;init parent
	(s-call :error :init '(:r0 :r1) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		;init self
		(call :str :create_from_cstr '((:r0 +error_description)) '(:r0))
		(assign '((:rsp slot_this)) '(:r1))
		(assign '(:r0) '((:r1 +error_description)))
		(call :obj :ref '((:r1 +error_script)))
		(assign '((:rsp slot_this)) '(:r0))
		(call :obj :ref '((:r0 +error_file)))
		(assign '((:rsp slot_this)) '(:r0))
		(call :obj :ref '((:r0 +error_object)))
		(assign '((:rsp slot_this)) '(:r0))
	(endif)

	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :error :deinit)
	;inputs
	;:r0 = error object (ptr)
	;outputs
	;:r0 = error object (ptr)
	;trashes
	;:r1-:r2, :d0-:d15

	(structure slot 0
		(ptr this))

	(vp-alloc slot_size)
	(entry :error :deinit '((:rsp slot_this)))

	(call :obj :deref '((:r0 +error_description)))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :deref '((:r0 +error_script)))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :deref '((:r0 +error_file)))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :deref '((:r0 +error_object)))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :deref '((:r0 +error_frame)))
	(assign '((:rsp slot_this)) '(:r0))
	(vp-free slot_size)
	(s-jump :error :deinit '(:r0))

(def-func-end)

(def-method :error :get_msg)
	;inputs
	;:r0 = error object (ptr)
	;outputs
	;:r0 = error object (ptr)
	;:r1 = error c string (pubyte)
	;trashes
	;:r1-:r5

	(entry :error :get_msg '(:r0))

	(assign '(:r0 "" (:r0 +error_msg) ($ msgs)) '(:r3 :r4 :r5 :r0))
	(loop-while '(:r5 /= 0))
		(vp-load-rcr-ub :r0 0 :r1)
		(breakif '(:r1 = 0))
		(vp-cpy-rr :r0 :r4)
		(call :sys_str :length '(:r0) '(:r0 :r1))
		(vp-add-rr :r1 :r0)
		(vp-sub-cr 1 :r5)
		(vp-add-cr 1 :r0)
	(loop-end)

	(exit :error :get_msg '(:r3 :r4))
	(vp-ret)

(vp-label 'msgs)
	(each (const vp-cstr) *error_msgs*)
(vp-label 'unknown)
	(vp-cstr "unknown_error !")
	(vp-byte 0)

(def-func-end)

(def-method :error :print)
	;inputs
	;:r0 = error object (ptr)
	;:r1 = stream object (ptr)
	;outputs
	;:r0 = error object (ptr)
	;trashes
	;:r1-:r9, :r14, :d0-:d15

	(structure slot 0
		(ptr this stream string sstream))

	(vp-alloc slot_size)
	(entry :error :print '((:rsp slot_this) (:rsp slot_stream)))

	(call :stream :write_cstr '((:rsp slot_stream) "Error: "))
	(assign '((:rsp slot_this)) '(:r1))
	(assign '((:r1 +error_description)) '(:r1))
	(vp-add-cr +str_data :r1)
	(call :stream :write_cstr '((:rsp slot_stream) :r1) '(stream))
	(call :stream :write_char `(,stream +char_space))
	(call :error :get_msg '((:rsp slot_this)) '(_ (:rsp slot_string)))
	(call :stream :write_cstr '((:rsp slot_stream) (:rsp slot_string)))

	(call :stream :write_cstr '((:rsp slot_stream) " Repl: "))
	(assign '((:rsp slot_this)) '(:r1))
	(assign '((:r1 +error_script)) '(:r1))
	(vp-add-cr +str_data :r1)
	(call :stream :write_cstr '((:rsp slot_stream) :r1) '(stream))
	(call :stream :write_char `(,stream +char_space))
	(assign '((:rsp slot_this)) '(:r1))
	(assign '((:r1 +error_file)) '(:r1))
	(vp-add-cr +str_data :r1)
	(call :stream :write_cstr '((:rsp slot_stream) :r1) '(stream))
	(call :stream :write_char `(,stream +char_lrb))
	(assign '((:rsp slot_this)) '(:r0))
	(call :str :create_from_long '((:r0 +error_line) 10) '((:rsp slot_string)))
	(assign '((:rsp slot_string)) '(:r1))
	(vp-add-cr +str_data :r1)
	(call :stream :write_cstr '((:rsp slot_stream) :r1) '(stream))
	(call :stream :write_char `(,stream +char_rrb))
	(call :str :destroy '((:rsp slot_string)))

	(call :stream :write_cstr '((:rsp slot_stream) " Frame: "))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :print '((:r0 +error_frame) (:rsp slot_stream)))

	(call :stream :write_cstr '((:rsp slot_stream) " Obj: "))
	(call :str :create_from_buffer `(0 ,str_gap) '((:rsp slot_string)))
	(call :sstream :create '((:rsp slot_string)) '((:rsp slot_sstream)))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :print '((:r0 +error_object) (:rsp slot_sstream)))
	(call :sstream :ref_string '((:rsp slot_sstream)) '(_ (:rsp slot_string)))
	(call :obj :destroy '((:rsp slot_sstream)))
	;no more than 256 chars of it
	(assign '((:rsp slot_string)) '(:r1))
	(assign '((:r1 +str_length)) '(:r2))
	(vp-min-cr 256 :r2)
	(vp-add-cr +str_data :r1)
	(call :stream :write '((:rsp slot_stream) :r1 :r2))
	(call :str :destroy '((:rsp slot_string)))

	(exit :error :print '((:rsp slot_this)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
