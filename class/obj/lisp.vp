(include "lib/asm/func.inc")
(include "././num/class.inc")
(include "././lisp/class.inc")
(include "././buf/class.inc")

(def-method :obj :lisp_get)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r8-:r12, :r14, :d0-:d15
	;info
	;a field of an object, inside its own heap cell, by the raw access of
	;:buf, and an object reference here

	(vp-rdef (this args obj offset type tmp) '(:r8 :r9 :r10 :r11 :r12 :r13))

	(entry :obj :lisp_get `(,this ,args))

	(gotoif-lisp-args-sig 'error args 3)

	(list-bind-args args `(,obj ,offset ,type) '(:obj :num :num))
	(vp-load-rcr obj (- +sys_mem_header_heap +sys_mem_header_size) :r0)
	(assign '((:r0 +hp_heap_cellsize)) '(:r0))
	(vp-sub-cr +sys_mem_header_size :r0)
	(call :buf :check `(,this :r0 ,offset ,type) `(,this :r1))
	(gotoif '(:r1 = 1) 'error)
	(gotoif '(:r1 /= 0) 'error1)
	(vp-add-rr obj offset)
	(vpif `(,type = 0))
		;object reference
		(assign `((,offset 0)) '(:r1))
		(vpif '(:r1 = 0))
			(assign `((,this +lisp_sym_nil)) '(:r1))
		(endif)
		(class/obj/ref :r1 :r0)
	(else)
		(jump :buf :get `(,this ,offset ,type))
	(endif)

	(exit :obj :lisp_get `(,this :r1))
	(vp-ret)

(vp-label 'error1)
	(jump :lisp :repl_error `(,args "(obj-get obj offset type)" +error_msg_not_valid_index))
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(obj-get obj offset type)" +error_msg_wrong_types))
	(signature '(:obj :NUM :NUM))

(def-func-end)

(def-method :obj :lisp_set)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r8-:r13, :d0-:d15
	;info
	;a field of an object set, inside its own heap cell, by the raw access
	;of :buf, and an object reference here

	(structure slot 0
		(ptr this obj addr val))

	(vp-rdef (this args obj offset type val tmp) '(:r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(entry :obj :lisp_set `(,this ,args))

	(gotoif-lisp-args-sig 'error args 4)

	(list-bind-args args `(,obj ,offset ,type ,val) '(:obj :num :num :obj))
	(vp-load-rcr obj (- +sys_mem_header_heap +sys_mem_header_size) :r0)
	(assign '((:r0 +hp_heap_cellsize)) '(:r0))
	(vp-sub-cr +sys_mem_header_size :r0)
	(call :buf :check `(,this :r0 ,offset ,type) `(,this :r1))
	(gotoif '(:r1 = 1) 'error)
	(gotoif '(:r1 /= 0) 'error1)
	(vp-add-rr obj offset)
	(vpif `(,type = 0))
		;object reference, the one there let go of, :nil is none
		(vp-alloc slot_size)
		(save-fields :rsp '(slot_this slot_obj slot_addr slot_val) `(,this ,obj ,offset ,val))
		(call :obj :deref_if `((,offset 0)))
		(load-fields :rsp '(slot_this slot_obj slot_addr slot_val) `(,this ,obj ,offset ,val))
		(vp-free slot_size)
		(assign `((,this +lisp_sym_nil)) '(:r0))
		(vpif `(,val = :r0))
			(vp-xor-rr val val)
		(else)
			(class/obj/ref val :r0)
		(endif)
		(assign `(,val) `((,offset 0)))
	(else)
		(call :buf :set `(,this ,offset ,type ,val) `(,this))
	(endif)
	(class/obj/ref obj :r0)

	(exit :obj :lisp_set `(,this ,obj))
	(vp-ret)

(vp-label 'error1)
	(jump :lisp :repl_error `(,args "(obj-set obj offset type)" +error_msg_not_valid_index))
(vp-label 'error)
	(jump :lisp :repl_error `(,args "(obj-set obj offset type val)" +error_msg_wrong_types))
	(signature '(:obj :NUM :NUM :obj))

(def-func-end)

(def-method :obj :lisp_hash)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r4, :r14, :d0-:d15

	(entry :obj :lisp_hash '(:r0 :r1))

	(gotoif-lisp-args-len 'error :r1 /= 1)

	(vp-push :r0)
	(defq in (method-input :obj :hash))
	(array-bind-args :r1 in)
	(call :obj :hash in '(_ :r0))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :obj :lisp_hash '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(hash obj)" +error_msg_wrong_num_of_args))

(def-func-end)

(def-method :obj :lisp_type)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3, :d0-:d15

	(entry :obj :lisp_type '(:r0 :r1))

	(gotoif-lisp-args-len 'error :r1 /= 1)

	(vp-push :r0)
	(defq in (method-input :obj :type))
	(array-bind-args :r1 in)
	(call :obj :type in '(_ :r1) :r1)
	(vp-pop :r0)

	(exit :obj :lisp_type '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(type-of obj)" +error_msg_wrong_num_of_args))

(def-func-end)

(def-method :obj :lisp_weak_ref)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3, :r14, :d0-:d15

	(entry :obj :lisp_weak_ref '(:r0 :r1))

	(gotoif-lisp-args-len 'error :r1 /= 1)

	(list-bind-args :r1 '(:r2) '(:obj))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(vpif '(:r1 = :r2))
		(class/obj/ref :r1 :r2)
	(else)
		(vp-push :r0)
		(call :num :create '(:r2) '(:r1))
		(vp-pop :r0)
	(endif)

	(exit :obj :lisp_weak_ref '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(weak-ref obj)" +error_msg_wrong_num_of_args))
	(signature '(:obj))

(def-func-end)

(def-method :obj :lisp_obj_ref)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3

	(entry :obj :lisp_obj_ref '(:r0 :r1))

	(gotoif-lisp-args-len 'error :r1 /= 1)

	(list-bind-args :r1 '(:r2) '(:obj))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(vpif '(:r1 /= :r2))
		(assign `((@ ,(f-path :num :vtable)) (:r2 +obj_vtable)) '(:r3 :r1))
		(gotoif '(:r3 /= :r1) 'error1)
		(assign '((:r2 +num_value)) '(:r1))
	(endif)
	(class/obj/ref :r1 :r2)

	(exit :obj :lisp_obj_ref '(:r0 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-cpy-rr :r2 :r1)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(obj-ref num)" +error_msg_wrong_types))
	(signature '(:obj))

(def-func-end)

(def-method :obj :lisp_eql)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r9-:r10

	(vp-rdef (this args obj1 obj2) '(:r9 :r10))

	(entry :obj :lisp_eql `(,this ,args))

	(assign `((,args +array_length)) `(,obj1))
	(gotoif `(,obj1 /= 2) 'error)

	(array-bind-args args `(,obj1 ,obj2))
	(call :obj :eql `(,obj1 ,obj2) '(_ tmp))
	(vpif `(,tmp /= 0))
		(assign `((,this +lisp_sym_nil)) `(,args))
	(else)
		(assign `((,this +lisp_sym_t)) `(,args))
	(endif)
	(class/obj/ref args obj1)

	(exit :obj :lisp_eql `(,this ,args))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(eql obj obj)" +error_msg_wrong_num_of_args))

(def-func-end)

(def-method :obj :lisp_nql)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r9-:r10

	(vp-rdef (this args obj1 obj2) '(:r9 :r10))

	(entry :obj :lisp_nql `(,this ,args))

	(assign `((,args +array_length)) `(,obj1))
	(gotoif `(,obj1 /= 2) 'error)

	(array-bind-args args `(,obj1 ,obj2))
	(call :obj :eql `(,obj1 ,obj2) '(_ tmp))
	(vpif `(,tmp = 0))
		(assign `((,this +lisp_sym_nil)) `(,args))
	(else)
		(assign `((,this +lisp_sym_t)) `(,args))
	(endif)
	(class/obj/ref args obj1)

	(exit :obj :lisp_nql `(,this ,args))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(nql obj obj)" +error_msg_wrong_num_of_args))

(def-func-end)
