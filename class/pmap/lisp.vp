(include "lib/asm/func.inc")
(include "./class.inc")
(include "././lisp/class.inc")

(def-method :pmap :lisp_pmap)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r2-:r3

	(entry :pmap :lisp_pmap '(:r0 :r1))

(errorcase
	(assign '((:r1 +array_length)) '(:r2))
	(vp-and-cr 1 :r2)
	(gotoif '(:r2 /= 0) 'error))

	;mutate list to pmap
	(f-bind :pmap :vtable :r2)
	(assign '(:r2) '((:r1 +obj_vtable)))
	(class/obj/ref :r1 :r2)

	(exit :pmap :lisp_pmap '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(pmap [key val] ...)" +error_msg_wrong_num_of_args)))

(def-func-end)

(def-method :pmap :lisp_pfind)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11

	(vp-rdef (this args))
	(vp-rdef (lst key) (method-input :pmap :pfind))
	(vp-rdef (tmp saved_this) '(:r10 :r11))

	(entry :pmap :lisp_pfind `(,this ,args))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-cpy-rr this saved_this)
	(list-bind-args args `(,lst ,key) '(:pset :obj))
	(call :pset :pfind `(,lst ,key) `(,lst ,args vt1 vt2) tmp)
	(vpif `(,args = 0))
		(assign `((,saved_this +lisp_sym_nil)) `(,args))
	(else)
		(assign `((@ ,(f-path :pset :vtable)) (,lst +obj_vtable)) `(,vt1 ,vt2))
		(vpif `(,vt1 = ,vt2))
			(assign `((,args 0)) `(,args))
		(else)
			(assign `((,args +ptr_size)) `(,args))
		(endif)
	(endif)
	(class/obj/ref args lst)

	(exit :pmap :lisp_pfind `(,saved_this ,args))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error `(,this ,args "(pfind props key)" +error_msg_wrong_types))
	(signature '(:pset :obj)))

(def-func-end)

(def-method :pmap :lisp_pinsert)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this args lst)
		(pptr iter_begin iter_end))

	(vp-alloc local_size)
	(entry :pmap :lisp_pinsert '(:r0 :r1))
	(assign '(:r0 :r1) '((:rsp local_this) (:rsp local_args)))

	(errorif-lisp-args-len 'error1 :r1 < 2)

	(class/array/get_both :r1 :r3 :r2)
	(array-get-args :r3 '(:r0))
	(vp-add-cr +ptr_size :r3)
	(assign '(:r0 :r3 :r2) '((:rsp local_lst) (:rsp local_iter_begin) (:rsp local_iter_end)))
	(assign `((@ ,(f-path :pset :vtable)) (:r0 +obj_vtable)) '(:r1 :r2))
	(vpif '(:r1 = :r2))
		(loop-start)
			(assign '((:rsp local_iter_begin)) '(:r3))
			(assign '((:rsp local_lst)) '(:r0))
			(assign '((:r3 0)) '(:r1))
			(call :pset :pinsert '(:r0 :r1) '(:r0 _))
			(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) '(:r3 :r2))
			(vp-add-cr +ptr_size :r3)
			(assign '(:r3) '((:rsp local_iter_begin)))
		(loop-until '(:r3 = :r2))
	(else)
	(errorcase
		(assign '((:rsp local_lst)) '(:r0))
		(assign `((@ ,(f-path :pmap :vtable)) (:r0 +obj_vtable)) '(:r1 :r2))
		(gotoif '(:r1 /= :r2) 'error2)
		(assign '((:rsp local_args)) '(:r1))
		(assign '((:r1 +array_length)) '(:r2))
		(gotoif '(:r2 < 3) 'error1)
		(vp-and-cr 1 :r2)
		(gotoif '(:r2 = 0) 'error1))
		(loop-start)
			(assign '((:rsp local_iter_begin)) '(:r3))
			(assign '((:rsp local_lst)) '(:r0))
			(assign '((:r3 0) (:r3 +ptr_size)) '(:r1 :r2))
			(call :pmap :pinsert '(:r0 :r1 :r2) '(:r0 _))
			(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) '(:r3 :r2))
			(vp-add-cr (* +ptr_size 2) :r3)
			(assign '(:r3) '((:rsp local_iter_begin)))
		(loop-until '(:r3 = :r2))
	(endif)
	(assign '((:rsp local_this) (:rsp local_lst)) '(:r0 :r1))
	(class/obj/ref :r1 :r2)

	(exit :pmap :lisp_pinsert '(:r0 :r1))
	(vp-free local_size)
	(vp-ret)

(errorcase
(vp-label 'error1)
	(assign '(+error_msg_wrong_num_of_args) '(:r3))
	(goto 'error)
(vp-label 'error2)
	(assign '(+error_msg_wrong_types) '(:r3))
(vp-label 'error)
	(assign '((:rsp local_this) (:rsp local_args)) '(:r0 :r1))
	(vp-free local_size)
	(jump :lisp :repl_error '(:r0 :r1 "(pinsert props key [val] ...)" :r3)))

(def-func-end)

(def-method :pmap :lisp_perase)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this args lst)
		(pptr iter_begin iter_end))

	(vp-alloc local_size)
	(entry :pmap :lisp_perase '(:r0 :r1))
	(assign '(:r0 :r1) '((:rsp local_this) (:rsp local_args)))

	(errorif-lisp-args-len 'error1 :r1 < 2)

	(class/array/get_both :r1 :r3 :r2)
	(array-get-args :r3 '(:r0))
	(vp-add-cr +ptr_size :r3)
	(assign '(:r0 :r3 :r2) '((:rsp local_lst) (:rsp local_iter_begin) (:rsp local_iter_end)))
(errorcase
	(call :obj :inst_of `(:r0 (@ ,(f-path :pset :vtable))) '(:r0 :r1))
	(gotoif '(:r1 = 0) 'error2))
	(loop-start)
		(assign '((:rsp local_iter_begin)) '(:r3))
		(assign '((:rsp local_lst)) '(:r0))
		(assign '((:r3 0)) '(:r1))
		(call :pset :pfind '(:r0 :r1) '(:r0 :r1 _ _))
		(vpif '(:r1 /= 0))
			(assign `((@ ,(f-path :pset :vtable)) (:r0 +obj_vtable)) '(:r2 :r3))
			(vpif '(:r2 = :r3))
				(call :pset :erase '(:r0 :r1) '(:r0 _))
			(else)
				(call :pmap :erase2 '(:r0 :r1) '(:r0 _))
			(endif)
		(endif)
		(assign '((:rsp local_iter_begin) (:rsp local_iter_end)) '(:r3 :r2))
		(vp-add-cr +ptr_size :r3)
		(assign '(:r3) '((:rsp local_iter_begin)))
	(loop-until '(:r3 = :r2))
	(assign '((:rsp local_this) (:rsp local_lst)) '(:r0 :r1))
	(class/obj/ref :r1 :r2)

	(exit :pmap :lisp_perase '(:r0 :r1))
	(vp-free local_size)
	(vp-ret)

(errorcase
(vp-label 'error1)
	(assign '(+error_msg_wrong_num_of_args) '(:r3))
	(goto 'error)
(vp-label 'error2)
	(assign '(+error_msg_wrong_types) '(:r3))
(vp-label 'error)
	(assign '((:rsp local_this) (:rsp local_args)) '(:r0 :r1))
	(vp-free local_size)
	(jump :lisp :repl_error '(:r0 :r1 "(perase props key [key] ...)" :r3)))

(def-func-end)

