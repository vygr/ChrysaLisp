(include "lib/asm/func.inc")
(include "./class.inc")
(include "././lisp/class.inc")

(def-method :pmap :lisp_pmap)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r2-:r3

	(vp-rdef (this args))
	(vp-rdef (len vt) '(:r2 :r2))

	(entry :pmap :lisp_pmap `(,this ,args))

	(assign `((,args +array_length)) `(,len))
	(vp-and-cr 1 len)
	(gotoif `(,len /= 0) 'error)

	;mutate list to pmap
	(f-bind :pmap :vtable vt)
	(assign `(,vt) `((,args +obj_vtable)))
	(class/obj/ref args vt)

	(exit :pmap :lisp_pmap `(,this ,args))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(pmap [key val] ...)" +error_msg_wrong_num_of_args))

(def-func-end)

(def-method :pmap :lisp_pfind)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r11

	(vp-rdef (this args))
	(vp-rdef (lst key) (method-input :pmap :pfind))
	(vp-rdef (tmp saved_this) '(:r10 :r11))

	(entry :pmap :lisp_pfind `(,this ,args))

	(errorif-lisp-args-sig 'error :r1 2)

	(vp-cpy-rr this saved_this)
	(list-bind-args args `(,lst ,key) '(:pset :obj))
	(call :pset :pfind `(,lst ,key) `(,lst ,args vt1 vt2) tmp)
	(vpif `(,args = 0))
		(assign `((,saved_this +lisp_sym_nil)) `(,args))
	(else)
		(assign `((@ ,(f-path :pset :vtable)) (,lst +obj_vtable)) `(,vt1 ,vt2))
		(vpif `(,vt1 = ,vt2))
			(assign `((,args 0)) `(,args))
		(else)
			(assign `((,args +ptr_size)) `(,args))
		(endif)
	(endif)
	(class/obj/ref args lst)

	(exit :pmap :lisp_pfind `(,saved_this ,args))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,args "(pfind props key)" +error_msg_wrong_types))
	(signature '(:pset :obj))

(def-func-end)

(def-method :pmap :lisp_pinsert)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	;an insert keeps nothing, so the frame: it gives the props back, and
	;the place is read after it and is still there at the top
	(structure slot 0
		(ptr this args)
		(pptr iter_begin iter_end))

	(vp-rdef (this args vt1 vt2 iter iter_end))
	(defq lst this key args val vt1 argc vt1 msg vt2)

	(vp-alloc slot_size)
	(entry :pmap :lisp_pinsert `(,this ,args))
	(save-fields :rsp '(slot_this slot_args) `(,this ,args))

	(errorif-lisp-args-len 'error1 :r1 < 2)

	(class/array/get_both args iter iter_end)
	(array-get-args iter `(,lst))
	(vp-add-cr +ptr_size iter)
	(save-fields :rsp '(slot_iter_begin slot_iter_end) `(,iter ,iter_end))
	(assign `((@ ,(f-path :pset :vtable)) (,lst +obj_vtable)) `(,vt1 ,vt2))
	(vpif `(,vt1 = ,vt2))
		(loop-start)
			(assign `((,iter 0)) `(,key))
			(call :pset :pinsert `(,lst ,key) `(,lst _))
			(load-fields :rsp '(slot_iter_begin slot_iter_end) `(,iter ,iter_end))
			(vp-add-cr +ptr_size iter)
			(assign `(,iter) '((:rsp slot_iter_begin)))
		(loop-until `(,iter = ,iter_end))
	(else)
		(assign `((@ ,(f-path :pmap :vtable)) (,lst +obj_vtable)) `(,vt1 ,vt2))
		(gotoif `(,vt1 /= ,vt2) 'error2)
		(assign `((,args +array_length)) `(,argc))
		(gotoif `(,argc < 3) 'error1)
		(vp-and-cr 1 argc)
		(gotoif `(,argc = 0) 'error1)
		(loop-start)
			(assign `((,iter 0) (,iter +ptr_size)) `(,key ,val))
			(call :pmap :pinsert `(,lst ,key ,val) `(,lst _))
			(load-fields :rsp '(slot_iter_begin slot_iter_end) `(,iter ,iter_end))
			(vp-add-cr (* +ptr_size 2) iter)
			(assign `(,iter) '((:rsp slot_iter_begin)))
		(loop-until `(,iter = ,iter_end))
	(endif)
	(assign `(,lst (:rsp slot_this)) `(,args ,this))
	(class/obj/ref args val)

	(exit :pmap :lisp_pinsert `(,this ,args))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error1)
	(assign '(+error_msg_wrong_num_of_args) `(,msg))
	(goto 'error)
(vp-label 'error2)
	(assign '(+error_msg_wrong_types) `(,msg))
(vp-label 'error)
	(load-fields :rsp '(slot_this slot_args) `(,this ,args))
	(vp-free slot_size)
	(jump :lisp :repl_error `(,args "(pinsert props key [val] ...)" ,msg))

(def-func-end)

(def-method :pmap :lisp_perase)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15

	;all in registers the find and the erase leave, so no frame
	(vp-rdef (lst key vt1 vt2))
	(vp-rdef (this args iter iter_end) '(:r13 :r10 :r11 :r12))
	(defq found_iter key match key msg vt2)

	(entry :pmap :lisp_perase `(,this ,args))

	(errorif-lisp-args-len 'error1 :r1 < 2)

	(class/array/get_both args iter iter_end)
	(array-get-args iter `(,lst))
	(vp-add-cr +ptr_size iter)
	(call :obj :inst_of `(,lst (@ ,(f-path :pset :vtable))) `(,lst ,match))
	(gotoif `(,match = 0) 'error2)
	(loop-start)
		(assign `((,iter 0)) `(,key))
		(call :pset :pfind `(,lst ,key) `(,lst ,found_iter _ _))
		(vpif `(,found_iter /= 0))
			(assign `((@ ,(f-path :pset :vtable)) (,lst +obj_vtable)) `(,vt1 ,vt2))
			(vpif `(,vt1 = ,vt2))
				(call :pset :erase `(,lst ,found_iter) `(,lst _))
			(else)
				(call :pmap :erase2 `(,lst ,found_iter) `(,lst _))
			(endif)
		(endif)
		(vp-add-cr +ptr_size iter)
	(loop-until `(,iter = ,iter_end))
	(class/obj/ref lst vt1)

	(exit :pmap :lisp_perase `(,this ,lst))
	(vp-ret)

(vp-label 'error1)
	(assign '(+error_msg_wrong_num_of_args) `(,msg))
	(goto 'error)
(vp-label 'error2)
	(assign '(+error_msg_wrong_types) `(,msg))
(vp-label 'error)
	(vp-cpy-rr this :r0)
	(jump :lisp :repl_error `(,args "(perase props key [key] ...)" ,msg))

(def-func-end)
