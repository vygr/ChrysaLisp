(def-method :float :tanh)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(singleop :tanh
		'(call :sys_math :f_tanh '(:f1) '(:f0)))

(def-func-end)

(def-method :float :frac)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :frac
		'(progn
			(vp-lea-pr 'fn_consts :r1)
			(vp-cpy-dd :d1 :d0)
			(vp-cvt-dr :d0 :r0)
			(vp-cvt-rd :r0 :d1)
			(vp-sub-dd :d1 :d0)
			(assign '((:r1 (fn-const (n2d 0)))) '(:d1))
			(vpif '(:d0 < :d1))
				(assign '((:r1 (fn-const (n2d 1)))) '(:d1))
				(vp-add-dd :d1 :d0)
			(endif)))

(def-func-end)

(def-method :float :floor)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :floor
		'(progn
			(vp-cvt-dr :d1 :r0)
			(vp-cvt-rd :r0 :d0)
			(vpif '(:d0 > :d1))
				(vp-lea-pr 'fn_consts :r1)
				(assign '((:r1 (fn-const (n2d 1)))) '(:d1))
				(vp-sub-dd :d1 :d0)
			(endif)))

(def-func-end)

(def-method :float :ceil)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :ceil
		'(progn
			(vp-cvt-dr :d1 :r0)
			(vp-cvt-rd :r0 :d0)
			(vpif '(:d0 < :d1))
				(vp-lea-pr 'fn_consts :r1)
				(assign '((:r1 (fn-const (n2d 1)))) '(:d1))
				(vp-add-dd :d1 :d0)
			(endif)))

(def-func-end)

(def-method :float :recip)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :recip
		'(progn
			(vp-lea-pr 'fn_consts :r1)
			(assign '((:r1 (fn-const (n2d 1)))) '(:d0))
			(vp-div-dd :d1 :d0)))

(def-func-end)

(def-method :float :sign)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(mathop :sign
		'(progn
			(vp-lea-pr 'fn_consts :r1)
			(assign '((:r1 (fn-const (n2d 0)))) '(:d0))
			(vpif '(:d1 > :d0))
				(assign '((:r1 (fn-const (n2d 1)))) '(:d0))
			(elseif '(:d1 < :d0))
				(assign '((:r1 (fn-const (n2d -1)))) '(:d0))
			(endif)))

(def-func-end)

(def-method :float :random)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r4, :r14, :d0-:d15

	(mathop :random
		'(progn
			(vp-lea-pr 'fn_consts :r4)
			(assign '((:r4 (fn-const (n2d (<< 1 32))))) '(:d0))
			(vp-mul-dd :d0 :d1)
			(vp-cvt-dr :d1 :r0)
			(call :sys_math :i_rand '(:r0) '(:r0))
			(vp-cvt-rd :r0 :d0)
			(assign '((:r4 (fn-const (recip (n2d (<< 1 32)))))) '(:d1))
			(vp-mul-dd :d1 :d0)))

(def-func-end)

(def-method :float :pow)
	;inputs
	;:r0 = float object (ptr)
	;:r1 = power float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15
	;info
	;0 if the float is not greater than 0, :sys_math :d_pow

	(entry :float :pow '(:r0 :r1))

	(vp-load-rcf :r0 +num_value :f0)
	(vp-cvt-fd :f0 :d0)
	(vp-load-rcf :r1 +num_value :f1)
	(vp-cvt-fd :f1 :d1)
	(call :sys_math :d_pow '(:d0 :d1) '(:d0))
	(vp-cvt-df :d0 :f0)
	(float-bits :f0 :r0)
	(jump :float :create '(:r0))

(def-func-end)
