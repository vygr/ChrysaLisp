(def-method :float :log)
	;inputs
	;:r0 = float object (ptr)
	;outputs
	;:r0 = result float object (ptr)
	;trashes
	;:r0-:r2, :r14, :d0-:d15

	(singleop :log
		'(call :sys_math :f_log '(:f1) '(:f0)))

