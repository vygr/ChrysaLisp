(include "././fixed/class.inc")
(include "./struct.inc")

;a float of 32 bits, held in the low half of its value, the upper half
;clear, so the same float is always the same value
(def-class :float :fixed
	(dec-method :vtable class/float/vtable)
	(dec-method :type class/float/type :override)
	(dec-method :create class/float/create)
	(dec-method :print class/float/print :final)
	(dec-method :vcreate class/float/create :final)
	(dec-method :random class/float/random :final)
	(dec-method :add class/float/add :final)
	(dec-method :sub class/float/sub :final)
	(dec-method :mul class/float/mul :final)
	(dec-method :div class/float/div :final)
	(dec-method :mod class/float/mod :final)
	(dec-method :min class/float/min :final)
	(dec-method :max class/float/max :final)
	(dec-method :abs class/float/abs :final)
	(dec-method :sign class/float/sign :final)
	(dec-method :neg class/float/neg :final)
	(dec-method :sqrt class/float/sqrt :final)
	(dec-method :sin class/float/sin :final)
	(dec-method :cos class/float/cos :final)
	(dec-method :exp class/float/exp :final)
	(dec-method :log class/float/log :final)
	(dec-method :tanh class/float/tanh :final)
	(dec-method :frac class/float/frac :final)
	(dec-method :floor class/float/floor :final)
	(dec-method :ceil class/float/ceil :final)
	(dec-method :recip class/float/recip :final)
	(dec-method :lt class/float/lt :final)
	(dec-method :gt class/float/gt :final)
	(dec-method :le class/float/le :final)
	(dec-method :ge class/float/ge :final)
	(dec-method :pow class/float/pow :final))

(defun float-bits (f r)
	;a single's 32 bits into a register, the upper 32 cleared, as some
	;machines sign extend them on the move
	(vp-cpy-fr f r)
	(vp-shl-cr 32 r)
	(vp-shr-cr 32 r))
