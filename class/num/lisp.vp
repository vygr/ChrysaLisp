(def-method :num :lisp_pow)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r12-:r14, :d0-:d15
	;info
	;a number to a power of its own type, integer, fixed or double

	(entry :num :lisp_pow '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 2)

	(vp-cpy-rr :r0 :r13)
	(list-bind-args :r1 '(:r2 :r3) '(:obj :obj))
	(assign '((:r2 +obj_vtable) (:r3 +obj_vtable)) '(:r4 :r5))
	(gotoif '(:r4 /= :r5) 'error1)
	(call :num :pow '(:r2 :r3) '(:r1) :r2)

	(exit :num :lisp_pow '(:r13 :r1))
	(vp-ret)

(vp-label 'error1)
	(vp-cpy-rr :r13 :r0)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(pow num power)" +error_msg_wrong_types))
	(signature '(:num :num))

(def-func-end)

;the conversions check the arg's class as they dispatch on it: from the
;bottom of the ladder, :float, up through :double and :fixed to :num, a
;case a rung, each stepping the vtable to its parent and comparing; past
;:num it is not a number

(def-method :num :lisp_n2i)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :r14, :d0-:d15

	(vp-rdef (this argl vt1 vt2 saved_this args))
	(defq in (method-input :num :create))

	(entry :num :lisp_n2i `(,this ,argl))

	(gotoif-lisp-args-len 'error argl /= 1)

	(assign `(,this) `(,saved_this))
	(array-bind-args argl `(,args))
	(assign `((,args +obj_vtable)) `(,vt1))
	(f-bind :float :vtable vt2)
	(switch)
	(vpcase `(,vt1 = ,vt2))
		(vp-load-rcf args +num_value :f0)
		(vp-cvt-fd :f0 :d0)
		(vp-cvt-dr :d0 (first in))
		(goto 'new_num)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(assign `((,args +num_value)) '(:d0))
		(vp-cvt-dr :d0 (first in))
		(goto 'new_num)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(assign `((,args +num_value)) in)
		(vp-asr-cr +fp_shift (first in))
		(goto 'new_num)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(gotoif `(,vt1 /= ,vt2) 'error)
		(class/obj/ref args vt1)
		(exit :num :lisp_n2i `(,this ,args))
		(vp-ret)
	(vp-label 'new_num)
		(call :num :create in `(,argl))
	(endswitch)

	(exit :num :lisp_n2i `(,saved_this ,argl))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,argl "(n2i num)" +error_msg_wrong_types))

(def-func-end)

(def-method :num :lisp_n2q)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :r14, :d0-:d15

	(vp-rdef (this argl vt1 vt2 saved_this args))
	(defq in (method-input :fixed :create))

	(entry :num :lisp_n2q `(,this ,argl))

	(gotoif-lisp-args-len 'error argl /= 1)

	(assign `(,this) `(,saved_this))
	(array-bind-args argl `(,args))
	(assign `((,args +obj_vtable)) `(,vt1))
	(f-bind :float :vtable vt2)
	(switch)
	(vpcase `(,vt1 = ,vt2))
		(vp-load-rcf args +num_value :f0)
		(vp-cvt-fd :f0 :d0)
		(goto 'from_double)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(assign `((,args +num_value)) '(:d0))
	(vp-label 'from_double)
		(vp-lea-pr 'fn_consts args)
		(assign `((,args (fn-const (n2d (<< 1 +fp_shift))))) '(:d1))
		(vp-mul-dd :d1 :d0)
		(vp-cvt-dr :d0 (first in))
		(goto 'new_fixed)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(class/obj/ref args vt1)
		(exit :num :lisp_n2q `(,this ,args))
		(vp-ret)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(gotoif `(,vt1 /= ,vt2) 'error)
		(assign `((,args +num_value)) in)
		(vp-shl-cr +fp_shift (first in))
	(vp-label 'new_fixed)
		(call :fixed :create in `(,argl))
	(endswitch)

	(exit :num :lisp_n2q `(,saved_this ,argl))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,argl "(n2q num)" +error_msg_wrong_types))

(def-func-end)

(def-method :num :lisp_n2d)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :r14, :d0-:d15

	(vp-rdef (this argl vt1 vt2 saved_this args))

	(entry :num :lisp_n2d `(,this ,argl))

	(gotoif-lisp-args-len 'error argl /= 1)

	(array-bind-args argl `(,args))
	(assign `((,args +obj_vtable)) `(,vt1))
	(f-bind :float :vtable vt2)
	(switch)
	(vpcase `(,vt1 = ,vt2))
		(vp-load-rcf args +num_value :f0)
		(vp-cvt-fd :f0 :d0)
		(goto 'new_double)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(class/obj/ref args vt1)
		(exit :num :lisp_n2d `(,this ,args))
		(vp-ret)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(assign `((,args +num_value)) `(,vt1))
		(vp-lea-pr 'fn_consts args)
		(assign `((,args (fn-const (recip (n2d (<< 1 +fp_shift)))))) '(:d1))
		(vp-cvt-rd vt1 :d0)
		(vp-mul-dd :d1 :d0)
		(goto 'new_double)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(gotoif `(,vt1 /= ,vt2) 'error)
		(assign `((,args +num_value)) `(,args))
		(vp-cvt-rd args :d0)
	(vp-label 'new_double)
		(assign `(,this) `(,saved_this))
		(call :double :create '(:d0) `(,argl))
	(endswitch)

	(exit :num :lisp_n2d `(,saved_this ,argl))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,argl "(n2d num)" +error_msg_wrong_types))

(def-func-end)

(def-method :num :lisp_n2f)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :r14, :d0-:d15
	;info
	;(n2f num) -> float, the float nearest the number

	(vp-rdef (this argl vt1 vt2 saved_this args))
	(defq in (method-input :float :create))

	(entry :num :lisp_n2f `(,this ,argl))

	(gotoif-lisp-args-len 'error argl /= 1)

	(array-bind-args argl `(,args))
	(assign `((,args +obj_vtable)) `(,vt1))
	(f-bind :float :vtable vt2)
	(switch)
	(vpcase `(,vt1 = ,vt2))
		(class/obj/ref args vt1)
		(exit :num :lisp_n2f `(,this ,args))
		(vp-ret)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(assign `((,args +num_value)) '(:d0))
		(goto 'new_float)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(nextcaseif `(,vt1 /= ,vt2))
		(assign `((,args +num_value)) `(,vt1))
		(vp-lea-pr 'fn_consts args)
		(assign `((,args (fn-const (recip (n2d (<< 1 +fp_shift)))))) '(:d1))
		(vp-cvt-rd vt1 :d0)
		(vp-mul-dd :d1 :d0)
		(goto 'new_float)
	(default)
		(assign `((,vt2 +obj_vtable)) `(,vt2))
		(gotoif `(,vt1 /= ,vt2) 'error)
		(assign `((,args +num_value)) `(,args))
		(vp-cvt-rd args :d0)
	(vp-label 'new_float)
		(assign `(,this) `(,saved_this))
		(vp-cvt-df :d0 :f0)
		(float-bits :f0 (first in))
		(call :float :create in `(,argl))
	(endswitch)

	(exit :num :lisp_n2f `(,saved_this ,argl))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error `(,argl "(n2f num)" +error_msg_wrong_types))

(def-func-end)
