(redefun andop (%0 i)
	(entry :num (sym (cat :lisp_ (rest %0))) '(:r0 :r1))
	(gotoif-lisp-args-type 'error :r1 :num 0)
	(vp-cpy-rr :r0 :r13)
	(class/array/get_both :r1 :r1 :r2)
	(vp-cpy-cr i :r0)
	(vpif '(:r1 /= :r2))
		(loop-start)
			(vp-load-rcr :r1 0 :r3)
			(vp-add-cr +ptr_size :r1)
			(assign '((:r3 +num_value)) '(:r3))
			((eval (sym (cat "vp-" (rest %0) "-rr"))) :r3 :r0)
		(loop-until '(:r1 = :r2))
	(endif)
	(call :num :create '(:r0) '(:r1))
	(exit :num (sym (cat :lisp_ (rest %0))) '(:r13 :r1))
	(vp-ret))

