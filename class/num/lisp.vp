(def-method :num :lisp_num)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(entry :num :lisp_num '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(array-bind-args :r1 '(:r0))
	(class/obj/ref :r0 :r1)
	(call :num :intern '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :num :lisp_num '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(num num)" +error_msg_wrong_types))
	(signature '(:num))

(def-func-end)

(redefun addop (%0)
	(entry :num (sym (cat :lisp_ (rest %0))) '(:r0 :r1))
	(gotoif-lisp-args-match 'error :r1 :num 2)
	(vp-cpy-rr :r0 :r13)
	(assign '((:r1 +array_begin)) '(:r2))
	(call :num %0 '((:r2 0) :r1) '(:r1) :r2)
	(exit :num (sym (cat :lisp_ (rest %0))) '(:r13 :r1))
	(vp-ret))

