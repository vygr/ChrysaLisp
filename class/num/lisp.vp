(redefun compareop (%0)
	(entry :num (sym (cat :lisp_ (rest %0))) '(:r0 :r1))
	(gotoif-lisp-args-type 'error :r1 :num 2)
	(assign '((:r1 +array_begin)) '(:r2))
	(assign '((:r2 0)) '(:r2))
	(v-call :num %0 '(:r0 :r1) '(:r1) :r2 :r2)
	(vpif '(:r1 = 0))
		(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(else)
		(assign '((:r0 +lisp_sym_t)) '(:r1))
	(endif)
	(class/obj/ref :r1 :r2)
	(exit :num (sym (cat :lisp_ (rest %0))) '(:r0 :r1))
	(vp-ret))

