(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "gui/canvas/class.inc")
(include "gui/pixmap/class.inc")
(include "./app.inc")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; the screen
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-func (path-to-absolute "./zx_render"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :r9-:r14

	;the screen and its border onto the canvas, each pixel zoom square.
	;FLASH swaps ink and paper while flash is 0x80, never if 0. A canvas too small
	;for it, or a machine too small, is not drawn on
	(structure slot 0
		(ptr this args)
		(long row stride lines flash border))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5) '(:obj :obj :num :num))
	(assign '((:r3 +str_length)) '(:r0))
	(gotoif `(:r0 < ,+zx_machine_size) 'done)
	(gotoif '(:r5 < 1) 'done)
	(gotoif '(:r5 > 4) 'done)
	(assign '((:r2 +canvas_pixmap)) '(:r2))
	(gotoif '(:r2 = 0) 'done)
	(vp-load-rcr-ui :r2 +pixmap_width :r0)
	(vp-cpy-cr +zx_width :r1)
	(vp-mul-rr :r5 :r1)
	(gotoif '(:r0 < :r1) 'done)
	(vp-load-rcr-ui :r2 +pixmap_height :r0)
	(vp-cpy-cr +zx_height :r1)
	(vp-mul-rr :r5 :r1)
	(gotoif '(:r0 < :r1) 'done)

	(vp-load-rcr-ui :r2 +pixmap_stride :r0)
	(save-fields :rsp '(slot_stride slot_flash) '(:r0 :r4))
	(vp-load-rcr :r2 +pixmap_data :r0)
	(assign '(:r0) '((:rsp slot_row)))
	(vp-lea-pr 'palette :r13)
	(vp-load-rcr-ub :r3 (+ +str_data +zx_border) :r0)
	(vp-shl-cr 2 :r0)
	(vp-load-rrr-ui :r13 :r0 :r0)
	(assign '(:r0) '((:rsp slot_border)))
	(vp-lea-rcr :r3 (+ +str_data +zx_size) :r12)
	(vp-xor-rr :r7 :r7)

	;:r5 zoom, :r6 where a pixel goes, :r7 the line, :r12 memory, :r13
	;the palette
	(loop-start)
		(load-fields :rsp '(slot_row slot_border) '(:r6 :r2))
		(vpif `(:r7 >= ,+zx_edge) `(:r7 < ,(+ +zx_edge 192)))
			(vp-cpy-cr +zx_edge :r1)
			(vp-call 'fill)
			;where the line's pixels and colours are
			(vp-cpy-rr :r7 :r0)
			(vp-sub-cr +zx_edge :r0)
			(vp-cpy-rr :r0 :r3)
			(vp-and-cr 0xc0 :r3)
			(vp-shl-cr 5 :r3)
			(vp-cpy-rr :r0 :r1)
			(vp-and-cr 7 :r1)
			(vp-shl-cr 8 :r1)
			(vp-or-rr :r1 :r3)
			(vp-cpy-rr :r0 :r1)
			(vp-and-cr 0x38 :r1)
			(vp-shl-cr 2 :r1)
			(vp-or-rr :r1 :r3)
			(vp-or-cr 0x4000 :r3)
			(vp-cpy-rr :r0 :r4)
			(vp-shr-cr 3 :r4)
			(vp-shl-cr 5 :r4)
			(vp-add-cr 0x5800 :r4)
			(vp-cpy-cr 32 :r11)
			(loop-start)
				(vp-load-rrr-ub :r12 :r4 :r1)
				(vp-cpy-rr :r1 :r0)
				(vp-shr-cr 3 :r0)
				(vp-and-cr 8 :r0)
				(vp-cpy-rr :r1 :r2)
				(vp-and-cr 7 :r2)
				(vp-or-rr :r0 :r2)
				(vp-cpy-rr :r1 :r9)
				(vp-shr-cr 3 :r9)
				(vp-and-cr 7 :r9)
				(vp-or-rr :r0 :r9)
				(vp-shl-cr 2 :r2)
				(vp-shl-cr 2 :r9)
				(vp-load-rrr-ui :r13 :r2 :r2)
				(vp-load-rrr-ui :r13 :r9 :r9)
				(assign '((:rsp slot_flash)) '(:r0))
				(vp-and-rr :r0 :r1)
				(vpif '(:r1 /= 0))
					(vp-swp-rr :r2 :r9)
				(endif)
				;ink :r2, paper :r9, the byte :r10, its top bit the next pixel
				(vp-load-rrr-ub :r12 :r3 :r10)
				(vp-cpy-cr 8 :r14)
				(loop-start)
					(vp-cpy-rr :r10 :r0)
					(vp-and-cr 0x80 :r0)
					(vp-cpy-rr :r9 :r1)
					(vpif '(:r0 /= 0))
						(vp-cpy-rr :r2 :r1)
					(endif)
					(vp-cpy-rr :r5 :r0)
					(loop-start)
						(vp-store-rrc-i :r1 :r6 0)
						(vp-add-cr +int_size :r6)
						(vp-sub-cr 1 :r0)
					(loop-until '(:r0 = 0))
					(vp-shl-cr 1 :r10)
					(vp-sub-cr 1 :r14)
				(loop-until '(:r14 = 0))
				(vp-add-cr 1 :r3)
				(vp-add-cr 1 :r4)
				(vp-sub-cr 1 :r11)
			(loop-until '(:r11 = 0))
			(assign '((:rsp slot_border)) '(:r2))
			(vp-cpy-cr +zx_edge :r1)
			(vp-call 'fill)
		(else)
			(vp-cpy-cr +zx_width :r1)
			(vp-call 'fill)
		(endif)
		;the line again for the rest of its zoom
		(load-fields :rsp '(slot_row slot_stride) '(:r0 :r1))
		(vp-cpy-rr :r5 :r2)
		(loop-start)
			(vp-sub-cr 1 :r2)
			(breakif '(:r2 = 0))
			(vp-lea-rrr :r0 :r1 :r3)
			(vp-cpy-rr :r5 :r4)
			(vp-mul-cr (* +zx_width +int_size) :r4)
			(vp-add-rr :r0 :r4)
			(vp-cpy-rr :r0 :r9)
			(loop-start)
				(vp-load-rcr :r9 0 :r10)
				(vp-store-rrc :r10 :r3 0)
				(vp-add-cr +long_size :r9)
				(vp-add-cr +long_size :r3)
			(loop-until '(:r9 >= :r4))
			(vp-add-rr :r1 :r0)
		(loop-end)
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:rsp slot_row)))
		(vp-add-cr 1 :r7)
	(loop-until `(:r7 = ,+zx_height))

(vp-label 'done)
	(assign '((:rsp slot_this)) '(:r0))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free slot_size)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'fill)
	;:r1 pixels of :r2, zoom times each, at :r6 on, trashes :r0 :r1
	(vp-mul-rr :r5 :r1)
	(loop-start)
		(vp-store-rrc-i :r2 :r6 0)
		(vp-add-cr +int_size :r6)
		(vp-sub-cr 1 :r1)
	(loop-until '(:r1 = 0))
	(vp-ret)

	(vp-align +int_size)
(vp-label 'palette)
	(vp-int 0xff000000 0xff0000d7 0xffd70000 0xffd700d7 0xff00d700 0xff00d7d7 0xffd7d700 0xffd7d7d7
		0xff000000 0xff0000ff 0xffff0000 0xffff00ff 0xff00ff00 0xff00ffff 0xffffff00 0xffffffff)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(zx-render canvas machine flash zoom)" +error_msg_wrong_types))
	(signature '(:canvas :str :num :num))

(def-func-end)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; bytes into the memory
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-func (path-to-absolute "./zx_poke"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6

	;the bytes of data into the memory at addr on, the ROM too, as many
	;as fit below 64K
	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 '(:r2 :r3 :r4) '(:obj :num :obj))
	(assign '((:r2 +str_length)) '(:r0))
	(gotoif `(:r0 < ,+zx_machine_size) 'done)
	(gotoif '(:r3 < 0) 'done)
	(assign '((:r4 +str_length)) '(:r5))
	(vp-cpy-cr +zx_mem_size :r6)
	(vp-sub-rr :r3 :r6)
	(vp-min-rr :r6 :r5)
	(gotoif '(:r5 <= 0) 'done)
	(vp-lea-rcr :r2 (+ +str_data +zx_size) :r2)
	(vp-add-rr :r3 :r2)
	(vp-add-cr +str_data :r4)
	(loop-start)
		(vp-load-rcr-ub :r4 0 :r0)
		(vp-store-rrc-b :r0 :r2 0)
		(vp-add-cr 1 :r4)
		(vp-add-cr 1 :r2)
		(vp-sub-cr 1 :r5)
	(loop-until '(:r5 = 0))

(vp-label 'done)
	(vp-pop :r0)
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(zx-poke machine addr data)" +error_msg_wrong_types))
	(signature '(:str :NUM :str))

(def-func-end)
