(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "gui/canvas/class.inc")
(include "gui/pixmap/class.inc")
(include "./app.inc")

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; the Z80 of a frame, held in VP registers
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;:r14 the Z80's memory, the state below it, :r13 T states left of the
;frame, :r12 PC, :r11 SP, :r10 HL, :r9 DE, :r8 BC, :r7 A, :r6 F. Pairs
;and PC are 16 bits and A and F 8, always. :r0-:r5 are the handlers' own.
;Each opcode has a handler, called, and back to the loop. An index prefix
;puts IX or IY in :r10 and HL in the state for the one opcode after it,
;so only those that use (HL) need a handler of their own for (IX+d)

;below where writes go, and where the run stops for the loader
(defq zx_rom 0x4000 zx_traps (list +zx_ld_bytes +zx_ld_bytes2) zx_sound :t)

(defun zx-st (field)
	;a field of the state, from the memory
	(- field +zx_size))

(defun zx-lab (prefix op)
	;a label of its own, the structured forms have b_n and e_n
	(sym (cat prefix "_" (str op))))

(defun zx-fetch8 (d)
	(vp-cpy-dr-ub :r14 :r12 d)
	(vp-add-cr 1 :r12)
	(vp-and-cr 0xffff :r12))

(defun zx-fetchd (d)
	;a displacement, signed
	(vp-cpy-dr-b :r14 :r12 d)
	(vp-add-cr 1 :r12)
	(vp-and-cr 0xffff :r12))

(defun zx-fetch16 (d t)
	(zx-fetch8 d)
	(zx-fetch8 t)
	(vp-shl-cr 8 t)
	(vp-or-rr t d))

(defun zx-wr8 (s a)
	;the ROM, below zx_rom, is not written
	(cond
		((= zx_rom 0) (vp-cpy-rd-b s :r14 a))
		(:t (vpif `(,a >= ,zx_rom))
				(vp-cpy-rd-b s :r14 a)
			(endif))))

(defun zx-r-inc ()
	(vp-cpy-ir-ub :r14 (zx-st +zx_r) :r0)
	(vp-add-cr 1 :r0)
	(vp-cpy-ri-b :r0 :r14 (zx-st +zx_r)))

(defun zx-rp (p)
	(elem-get '(:r8 :r9 :r10 :r11) p))

(defun zx-get (r d)
	;register r, B C D E H L (HL) A, into d
	(case r
		(0 (vp-cpy-rr :r8 d) (vp-shr-cr 8 d))
		(1 (vp-cpy-rr :r8 d) (vp-and-cr 0xff d))
		(2 (vp-cpy-rr :r9 d) (vp-shr-cr 8 d))
		(3 (vp-cpy-rr :r9 d) (vp-and-cr 0xff d))
		(4 (vp-cpy-rr :r10 d) (vp-shr-cr 8 d))
		(5 (vp-cpy-rr :r10 d) (vp-and-cr 0xff d))
		(6 (vp-cpy-dr-ub :r14 :r10 d))
		(7 (vp-cpy-rr :r7 d))))

(defun zx-put-hi (pair s t)
	(vp-and-cr 0xff pair)
	(vp-cpy-rr s t)
	(vp-shl-cr 8 t)
	(vp-or-rr t pair))

(defun zx-put-lo (pair s)
	(vp-and-cr 0xff00 pair)
	(vp-or-rr s pair))

(defun zx-put (r s t)
	;s, 0 to 255, into register r, t trashed
	(case r
		(0 (zx-put-hi :r8 s t))
		(1 (zx-put-lo :r8 s))
		(2 (zx-put-hi :r9 s t))
		(3 (zx-put-lo :r9 s))
		(4 (zx-put-hi :r10 s t))
		(5 (zx-put-lo :r10 s))
		(6 (zx-wr8 s :r10))
		(7 (vp-cpy-rr s :r7))))

(defun zx-cc (y)
	;the test of condition y, NZ Z NC C PO PE P M, of :r0
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr (elem-get '(0x40 0x01 0x04 0x80) (>> y 1)) :r0)
	(if (= (logand y 1) 0) '(:r0 = 0) '(:r0 /= 0)))

(defun zx-a-flags ()
	;F of a rotate of A, its carry in :r0
	(vp-and-cr 0xc4 :r6)
	(vp-or-rr :r0 :r6)
	(vp-cpy-rr :r7 :r0)
	(vp-and-cr 0x28 :r0)
	(vp-or-rr :r0 :r6))

(defun zx-sz53p (s d)
	(vp-lea-p 'sz53p d)
	(vp-cpy-dr-ub d s d))

(defun zx-sz53 (s d)
	(vp-lea-p 'sz53 d)
	(vp-cpy-dr-ub d s d))

(defun zx-repeat ()
	;a block opcode again
	(vp-sub-cr 2 :r12)
	(vp-and-cr 0xffff :r12)
	(vp-sub-cr 5 :r13))

(defun zx-jump (base reg tmp)
	;to the handler reg of the table at base, by a call
	(vp-lea-p base tmp)
	(vp-shl-cr 3 reg)
	(vp-cpy-dr tmp reg reg)
	(vp-add-rr tmp reg))

;T states of the opcodes, conditions as not taken
(defq zx_t_x0 '(4 10 7 6 4 4 7 4 4 11 7 6 4 4 7 4
		8 10 7 6 4 4 7 4 12 11 7 6 4 4 7 4
		7 10 16 6 4 4 7 4 7 11 16 6 4 4 7 4
		7 10 13 6 11 11 10 4 7 11 13 6 4 4 7 4)
	zx_t_x3 '(5 10 10 10 10 11 7 11 5 10 10 4 10 17 7 11
		5 10 10 11 10 11 7 11 5 4 10 11 10 4 7 11
		5 10 10 19 10 11 7 11 5 4 10 4 10 4 7 11
		5 10 10 4 10 11 7 11 5 6 10 4 10 4 7 11))

(defun zx-t-main (op)
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7))
	(cond
		((= x 0) (elem-get zx_t_x0 op))
		((= x 3) (elem-get zx_t_x3 (- op 192)))
		((= op 0x76) 4)
		((= x 1) (if (or (= y 6) (= z 6)) 7 4))
		((= z 6) 7)
		(4)))

(defun zx-t-ed (op)
	;after the 4 of the ED
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7))
	(cond
		((= x 1) (elem-get (list 8 8 11 16 4 10 4 (elem-get '(5 5 5 5 14 14 4 4) y)) z))
		((and (= x 2) (>= y 4) (<= z 3)) 12)
		(4)))

(defun zx-main-label (op)
	(cond
		((= op 0xcb) 'h_cb)
		((= op 0xdd) 'h_dd)
		((= op 0xed) 'h_ed)
		((= op 0xfd) 'h_fd)
		((zx-lab "zm" op))))

(defun zx-idx-op? (op)
	;uses (HL), which an index prefix makes (IX+d)
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7))
	(or (= op 0x34) (= op 0x35) (= op 0x36)
		(and (= x 1) (/= op 0x76) (or (= y 6) (= z 6)))
		(and (= x 2) (= z 6))))

(defun zx-idx-label (op)
	(cond
		((= op 0xcb) 'h_ddcb)
		;another prefix, or what uses HL itself, as if no prefix
		((find op '(0xdd 0xed 0xfd 0xeb 0xd9)) 'pfx_skip)
		((zx-idx-op? op) (zx-lab "zi" op))
		((zx-main-label op))))

(defun zx-ed-label (op)
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7))
	(if (or (= x 1) (and (= x 2) (>= y 4) (<= z 3))) (zx-lab "ze" op) 'h_nop))

(defq zx_alu '(alu_add alu_adc alu_sub alu_sbc alu_and alu_xor alu_or alu_cp))

(defun zx-gen-main (op)
	;the handler of an opcode, no prefix
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7) p (>> y 1) q (logand y 1))
	(vp-label (zx-lab "zm" op))
	(cond
		((= op 0x76)
			;HALT, NOPs to the end of the frame
			(vp-cpy-cr 1 :r0)
			(vp-cpy-ri-b :r0 :r14 (zx-st +zx_halted))
			(vp-sub-cr 1 :r12)
			(vp-and-cr 0xffff :r12)
			(vpif '(:r13 > 0))
				(vp-cpy-rr :r13 :r0)
				(vp-add-cr 3 :r0)
				(vp-shr-cr 2 :r0)
				(vp-cpy-ir-ub :r14 (zx-st +zx_r) :r1)
				(vp-add-rr :r0 :r1)
				(vp-cpy-ri-b :r1 :r14 (zx-st +zx_r))
				(vp-shl-cr 2 :r0)
				(vp-sub-rr :r0 :r13)
			(endif))
		((= x 1)
			(zx-get z :r1)
			(zx-put y :r1 :r2))
		((= x 2)
			(zx-get z :r1)
			(vp-jmp (elem-get zx_alu y)))
		((= x 0)
			(case z
				(0 (case y
					(0)
					(1 ;EX AF,AF'
						(vp-cpy-ir-us :r14 (zx-st +zx_af2) :r0)
						(vp-cpy-rr :r7 :r1)
						(vp-shl-cr 8 :r1)
						(vp-or-rr :r6 :r1)
						(vp-cpy-ri-s :r1 :r14 (zx-st +zx_af2))
						(vp-cpy-rr :r0 :r7)
						(vp-shr-cr 8 :r7)
						(vp-and-cr 0xff :r0)
						(vp-cpy-rr :r0 :r6))
					(2 ;DJNZ
						(zx-fetchd :r1)
						(vp-sub-cr 0x100 :r8)
						(vp-and-cr 0xffff :r8)
						(vp-cpy-rr :r8 :r0)
						(vp-shr-cr 8 :r0)
						(vpif '(:r0 /= 0))
							(vp-add-rr :r1 :r12)
							(vp-and-cr 0xffff :r12)
							(vp-sub-cr 5 :r13)
						(endif))
					(3 ;JR
						(zx-fetchd :r1)
						(vp-add-rr :r1 :r12)
						(vp-and-cr 0xffff :r12))
					(:t ;JR cc
						(zx-fetchd :r1)
						(vpif (zx-cc (- y 4)))
							(vp-add-rr :r1 :r12)
							(vp-and-cr 0xffff :r12)
							(vp-sub-cr 5 :r13)
						(endif))))
				(1 (cond
					((= q 0) (zx-fetch16 (zx-rp p) :r0))
					(:t (vp-cpy-rr (zx-rp p) :r1)
						(vp-jmp 'add16))))
				(2 (case op
					(0x02 (zx-wr8 :r7 :r8))
					(0x12 (zx-wr8 :r7 :r9))
					(0x0a (vp-cpy-dr-ub :r14 :r8 :r7))
					(0x1a (vp-cpy-dr-ub :r14 :r9 :r7))
					(0x22 (zx-fetch16 :r3 :r0)
						(vp-cpy-rr :r10 :r1)
						(vp-jmp 'wr16))
					(0x2a (zx-fetch16 :r3 :r0)
						(vp-call 'rd16)
						(vp-cpy-rr :r1 :r10))
					(0x32 (zx-fetch16 :r3 :r0)
						(zx-wr8 :r7 :r3))
					(0x3a (zx-fetch16 :r3 :r0)
						(vp-cpy-dr-ub :r14 :r3 :r7))))
				(3 (if (= q 0)
						(vp-add-cr 1 (zx-rp p))
						(vp-sub-cr 1 (zx-rp p)))
					(vp-and-cr 0xffff (zx-rp p)))
				(4 (zx-get y :r1)
					(vp-call 'inc8)
					(zx-put y :r1 :r2))
				(5 (zx-get y :r1)
					(vp-call 'dec8)
					(zx-put y :r1 :r2))
				(6 (zx-fetch8 :r1)
					(zx-put y :r1 :r2))
				(7 (case y
					(0 ;RLCA
						(vp-cpy-rr :r7 :r0)
						(vp-shr-cr 7 :r0)
						(vp-shl-cr 1 :r7)
						(vp-or-rr :r0 :r7)
						(vp-and-cr 0xff :r7)
						(zx-a-flags))
					(1 ;RRCA
						(vp-cpy-rr :r7 :r0)
						(vp-and-cr 1 :r0)
						(vp-shr-cr 1 :r7)
						(vp-cpy-rr :r0 :r1)
						(vp-shl-cr 7 :r1)
						(vp-or-rr :r1 :r7)
						(zx-a-flags))
					(2 ;RLA
						(vp-cpy-rr :r7 :r0)
						(vp-shr-cr 7 :r0)
						(vp-shl-cr 1 :r7)
						(vp-cpy-rr :r6 :r1)
						(vp-and-cr 1 :r1)
						(vp-or-rr :r1 :r7)
						(vp-and-cr 0xff :r7)
						(zx-a-flags))
					(3 ;RRA
						(vp-cpy-rr :r7 :r0)
						(vp-and-cr 1 :r0)
						(vp-shr-cr 1 :r7)
						(vp-cpy-rr :r6 :r1)
						(vp-and-cr 1 :r1)
						(vp-shl-cr 7 :r1)
						(vp-or-rr :r1 :r7)
						(zx-a-flags))
					(4 (vp-jmp 'daa))
					(5 ;CPL
						(vp-xor-cr 0xff :r7)
						(vp-and-cr 0xc5 :r6)
						(vp-or-cr 0x12 :r6)
						(vp-cpy-rr :r7 :r0)
						(vp-and-cr 0x28 :r0)
						(vp-or-rr :r0 :r6))
					(6 ;SCF
						(vp-cpy-cr 1 :r0)
						(zx-a-flags))
					(7 ;CCF, H the old carry
						(vp-cpy-rr :r6 :r0)
						(vp-and-cr 1 :r0)
						(vp-cpy-rr :r0 :r1)
						(vp-shl-cr 4 :r1)
						(vp-xor-cr 1 :r0)
						(vp-or-rr :r1 :r0)
						(zx-a-flags))))))
		(:t (case z
			(0 ;RET cc
				(vpif (zx-cc y))
					(vp-call 'pop16)
					(vp-cpy-rr :r1 :r12)
					(vp-sub-cr 6 :r13)
				(endif))
			(1 (cond
				((= q 0)
					(vp-call 'pop16)
					(cond
						((= p 3)
							(vp-cpy-rr :r1 :r7)
							(vp-shr-cr 8 :r7)
							(vp-and-cr 0xff :r1)
							(vp-cpy-rr :r1 :r6))
						((vp-cpy-rr :r1 (zx-rp p)))))
				((= p 0) ;RET
					(vp-call 'pop16)
					(vp-cpy-rr :r1 :r12))
				((= p 1) ;EXX
					(each (lambda ((reg field))
							(vp-cpy-ir-us :r14 (zx-st field) :r0)
							(vp-cpy-ri-s reg :r14 (zx-st field))
							(vp-cpy-rr :r0 reg))
						(list (list :r8 +zx_bc2) (list :r9 +zx_de2) (list :r10 +zx_hl2))))
				((= p 2) (vp-cpy-rr :r10 :r12))
				(:t (vp-cpy-rr :r10 :r11))))
			(2 ;JP cc
				(zx-fetch16 :r1 :r2)
				(vpif (zx-cc y))
					(vp-cpy-rr :r1 :r12)
				(endif))
			(3 (case y
				(0 (zx-fetch16 :r1 :r2)
					(vp-cpy-rr :r1 :r12))
				(2 ;OUT (n),A
					(zx-fetch8 :r3)
					(vp-cpy-rr :r7 :r0)
					(vp-shl-cr 8 :r0)
					(vp-or-rr :r0 :r3)
					(vp-cpy-rr :r7 :r1)
					(vp-jmp 'port_out))
				(3 ;IN A,(n)
					(zx-fetch8 :r3)
					(vp-cpy-rr :r7 :r0)
					(vp-shl-cr 8 :r0)
					(vp-or-rr :r0 :r3)
					(vp-call 'port_in)
					(vp-cpy-rr :r1 :r7))
				(4 ;EX (SP),HL
					(vp-cpy-rr :r11 :r3)
					(vp-call 'rd16)
					(vp-cpy-rr :r1 :r4)
					(vp-cpy-rr :r10 :r1)
					(vp-cpy-rr :r11 :r3)
					(vp-call 'wr16)
					(vp-cpy-rr :r4 :r10))
				(5 ;EX DE,HL
					(vp-cpy-rr :r9 :r0)
					(vp-cpy-rr :r10 :r9)
					(vp-cpy-rr :r0 :r10))
				(6 (vp-xor-rr :r0 :r0)
					(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff1))
					(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff2)))
				(7 (vp-cpy-cr 1 :r0)
					(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff1))
					(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff2)))))
			(4 ;CALL cc
				(zx-fetch16 :r4 :r2)
				(vpif (zx-cc y))
					(vp-cpy-rr :r12 :r1)
					(vp-call 'push16)
					(vp-cpy-rr :r4 :r12)
					(vp-sub-cr 7 :r13)
				(endif))
			(5 (cond
				((= q 0)
					(cond
						((= p 3)
							(vp-cpy-rr :r7 :r1)
							(vp-shl-cr 8 :r1)
							(vp-or-rr :r6 :r1))
						((vp-cpy-rr (zx-rp p) :r1)))
					(vp-jmp 'push16))
				(:t ;CALL
					(zx-fetch16 :r4 :r2)
					(vp-cpy-rr :r12 :r1)
					(vp-call 'push16)
					(vp-cpy-rr :r4 :r12))))
			(6 (zx-fetch8 :r1)
				(vp-jmp (elem-get zx_alu y)))
			(7 ;RST
				(vp-cpy-rr :r12 :r1)
				(vp-call 'push16)
				(vp-cpy-cr (* y 8) :r12)))))
	(vp-ret))

(defun zx-idx-ea ()
	;:r3 = IX+d, IX in :r10
	(zx-fetchd :r3)
	(vp-add-rr :r10 :r3)
	(vp-and-cr 0xffff :r3)
	(vp-sub-cr 8 :r13))

(defun zx-gen-idx (op)
	;the handler of an opcode of (IX+d). H and L beside it are HL's own,
	;which is in the state
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7))
	(vp-label (zx-lab "zi" op))
	(cond
		((= op 0x34) (zx-idx-ea)
			(vp-cpy-dr-ub :r14 :r3 :r1)
			(vp-call 'inc8)
			(zx-wr8 :r1 :r3))
		((= op 0x35) (zx-idx-ea)
			(vp-cpy-dr-ub :r14 :r3 :r1)
			(vp-call 'dec8)
			(zx-wr8 :r1 :r3))
		((= op 0x36) (zx-idx-ea)
			(vp-add-cr 3 :r13)
			(zx-fetch8 :r1)
			(zx-wr8 :r1 :r3))
		((= x 2) (zx-idx-ea)
			(vp-cpy-dr-ub :r14 :r3 :r1)
			(vp-jmp (elem-get zx_alu y)))
		((= z 6) ;LD r,(IX+d)
			(zx-idx-ea)
			(vp-cpy-dr-ub :r14 :r3 :r1)
			(cond
				((or (= y 4) (= y 5))
					(vp-cpy-ir-us :r14 (zx-st +zx_hlx) :r2)
					(if (= y 4) (zx-put-hi :r2 :r1 :r0) (zx-put-lo :r2 :r1))
					(vp-cpy-ri-s :r2 :r14 (zx-st +zx_hlx)))
				((zx-put y :r1 :r2))))
		(:t ;LD (IX+d),r
			(zx-idx-ea)
			(cond
				((or (= z 4) (= z 5))
					(vp-cpy-ir-us :r14 (zx-st +zx_hlx) :r1)
					(if (= z 4) (vp-shr-cr 8 :r1) (vp-and-cr 0xff :r1)))
				((zx-get z :r1)))
			(zx-wr8 :r1 :r3)))
	(vp-ret))

(defun zx-blk-io-flags ()
	;F of a block in or out, the byte in :r1, k in :r0, B left in :r2
	(vp-cpy-rr :r8 :r2)
	(vp-shr-cr 8 :r2)
	(zx-sz53 :r2 :r6)
	(vp-cpy-rr :r1 :r3)
	(vp-shr-cr 6 :r3)
	(vp-and-cr 2 :r3)
	(vp-or-rr :r3 :r6)
	(vpif '(:r0 > 255))
		(vp-or-cr 0x11 :r6)
	(endif)
	(vp-and-cr 7 :r0)
	(vp-xor-rr :r2 :r0)
	(zx-sz53p :r0 :r3)
	(vp-and-cr 4 :r3)
	(vp-or-rr :r3 :r6))

(defun zx-gen-ed (op)
	;the handler of an ED opcode
	(defq x (>> op 6) y (logand (>> op 3) 7) z (logand op 7) p (>> y 1) q (logand y 1))
	(vp-label (zx-lab "ze" op))
	(cond
		((= x 2)
			;a block opcode, a step up or down, again till done or not
			(defq dir (if (= (logand y 1) 0) 1 -1) rep (>= y 6))
			(case z
				(0 ;LDI LDD LDIR LDDR
					(vp-cpy-dr-ub :r14 :r10 :r1)
					(zx-wr8 :r1 :r9)
					(vp-add-cr dir :r10)
					(vp-and-cr 0xffff :r10)
					(vp-add-cr dir :r9)
					(vp-and-cr 0xffff :r9)
					(vp-sub-cr 1 :r8)
					(vp-and-cr 0xffff :r8)
					(vp-add-rr :r7 :r1)
					(vp-and-cr 0xc1 :r6)
					(vp-cpy-rr :r1 :r0)
					(vp-and-cr 0x08 :r0)
					(vp-or-rr :r0 :r6)
					(vp-and-cr 0x02 :r1)
					(vp-shl-cr 4 :r1)
					(vp-or-rr :r1 :r6)
					(vpif '(:r8 /= 0))
						(vp-or-cr 4 :r6)
						(if rep (zx-repeat))
					(endif))
				(1 ;CPI CPD CPIR CPDR
					(vp-cpy-dr-ub :r14 :r10 :r1)
					(vp-cpy-rr :r7 :r3)
					(vp-sub-rr :r1 :r3)
					(vp-add-cr dir :r10)
					(vp-and-cr 0xffff :r10)
					(vp-sub-cr 1 :r8)
					(vp-and-cr 0xffff :r8)
					(vp-and-cr 1 :r6)
					(vp-or-cr 2 :r6)
					(vp-cpy-rr :r7 :r0)
					(vp-xor-rr :r1 :r0)
					(vp-xor-rr :r3 :r0)
					(vp-and-cr 0x10 :r0)
					(vp-or-rr :r0 :r6)
					(vp-and-cr 0xff :r3)
					(zx-sz53 :r3 :r2)
					(vp-and-cr 0xc0 :r2)
					(vp-or-rr :r2 :r6)
					;the result less H, for bits 3 and 5
					(vp-shr-cr 4 :r0)
					(vp-cpy-rr :r3 :r1)
					(vp-sub-rr :r0 :r1)
					(vp-cpy-rr :r1 :r0)
					(vp-and-cr 0x08 :r0)
					(vp-or-rr :r0 :r6)
					(vp-and-cr 0x02 :r1)
					(vp-shl-cr 4 :r1)
					(vp-or-rr :r1 :r6)
					(vpif '(:r8 /= 0))
						(vp-or-cr 4 :r6)
					(endif)
					(when rep
						(vpif '(:r8 /= 0) '(:r3 /= 0))
							(zx-repeat)
						(endif)))
				(2 ;INI IND INIR INDR
					(vp-cpy-rr :r8 :r3)
					(vp-call 'port_in)
					(zx-wr8 :r1 :r10)
					(vp-add-cr dir :r10)
					(vp-and-cr 0xffff :r10)
					(vp-sub-cr 0x100 :r8)
					(vp-and-cr 0xffff :r8)
					(vp-cpy-rr :r8 :r0)
					(vp-add-cr dir :r0)
					(vp-and-cr 0xff :r0)
					(vp-add-rr :r1 :r0)
					(zx-blk-io-flags)
					(when rep
						(vpif '(:r2 /= 0))
							(zx-repeat)
						(endif)))
				(3 ;OUTI OUTD OTIR OTDR
					(vp-cpy-dr-ub :r14 :r10 :r1)
					(vp-sub-cr 0x100 :r8)
					(vp-and-cr 0xffff :r8)
					(vp-cpy-rr :r8 :r3)
					(vp-call 'port_out)
					(vp-add-cr dir :r10)
					(vp-and-cr 0xffff :r10)
					(vp-cpy-rr :r10 :r0)
					(vp-and-cr 0xff :r0)
					(vp-add-rr :r1 :r0)
					(zx-blk-io-flags)
					(when rep
						(vpif '(:r2 /= 0))
							(zx-repeat)
						(endif)))))
		(:t (case z
			(0 ;IN r,(C)
				(vp-cpy-rr :r8 :r3)
				(vp-call 'port_in)
				(vp-and-cr 1 :r6)
				(zx-sz53p :r1 :r0)
				(vp-or-rr :r0 :r6)
				(if (/= y 6) (zx-put y :r1 :r0)))
			(1 ;OUT (C),r
				(if (= y 6) (vp-xor-rr :r1 :r1) (zx-get y :r1))
				(vp-cpy-rr :r8 :r3)
				(vp-jmp 'port_out))
			(2 (vp-cpy-rr (zx-rp p) :r1)
				(vp-jmp (if (= q 0) 'sbc16 'adc16)))
			(3 (zx-fetch16 :r3 :r0)
				(cond
					((= q 0)
						(vp-cpy-rr (zx-rp p) :r1)
						(vp-jmp 'wr16))
					(:t (vp-call 'rd16)
						(vp-cpy-rr :r1 (zx-rp p)))))
			(4 ;NEG
				(vp-cpy-rr :r7 :r1)
				(vp-xor-rr :r7 :r7)
				(vp-jmp 'alu_sub))
			(5 ;RETN RETI
				(vp-cpy-ir-ub :r14 (zx-st +zx_iff2) :r0)
				(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff1))
				(vp-call 'pop16)
				(vp-cpy-rr :r1 :r12))
			(6 ;IM
				(vp-cpy-cr (elem-get '(0 0 1 2) (logand y 3)) :r0)
				(vp-cpy-ri-b :r0 :r14 (zx-st +zx_im)))
			(7 (case y
				(0 (vp-cpy-ri-b :r7 :r14 (zx-st +zx_i)))
				(1 (vp-cpy-ri-b :r7 :r14 (zx-st +zx_r))
					(vp-cpy-rr :r7 :r0)
					(vp-and-cr 0x80 :r0)
					(vp-cpy-ri-b :r0 :r14 (zx-st +zx_r7)))
				(2 (vp-cpy-ir-ub :r14 (zx-st +zx_i) :r7)
					(vp-jmp 'flags_a_ir))
				(3 (vp-cpy-ir-ub :r14 (zx-st +zx_r) :r7)
					(vp-and-cr 0x7f :r7)
					(vp-cpy-ir-ub :r14 (zx-st +zx_r7) :r0)
					(vp-or-rr :r0 :r7)
					(vp-jmp 'flags_a_ir))
				(4 ;RRD
					(vp-cpy-dr-ub :r14 :r10 :r1)
					(vp-cpy-rr :r7 :r0)
					(vp-shl-cr 4 :r0)
					(vp-cpy-rr :r1 :r2)
					(vp-shr-cr 4 :r2)
					(vp-or-rr :r2 :r0)
					(vp-and-cr 0xff :r0)
					(vp-and-cr 0xf0 :r7)
					(vp-and-cr 0x0f :r1)
					(vp-or-rr :r1 :r7)
					(zx-wr8 :r0 :r10)
					(vp-jmp 'flags_rxd))
				(5 ;RLD
					(vp-cpy-dr-ub :r14 :r10 :r1)
					(vp-cpy-rr :r1 :r0)
					(vp-shl-cr 4 :r0)
					(vp-cpy-rr :r7 :r2)
					(vp-and-cr 0x0f :r2)
					(vp-or-rr :r2 :r0)
					(vp-and-cr 0xff :r0)
					(vp-and-cr 0xf0 :r7)
					(vp-shr-cr 4 :r1)
					(vp-or-rr :r1 :r7)
					(zx-wr8 :r0 :r10)
					(vp-jmp 'flags_rxd)))))))
	(vp-ret))

(defun zx-run-body (name)
	;the body of a run, a frame of the Z80, of zx_rom and zx_traps
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	;the machine, as big as it should be, it is written
	(list-bind-args :r1 '(:r2) '(:obj))
	(assign '((:r2 +str_length)) '(:r3))
	(gotoif `(:r3 < ,+zx_machine_size) 'error)
	(vp-push :r0)
	(vp-lea-i :r2 (+ +str_data +zx_size) :r14)

	(vp-cpy-ir-us :r14 (zx-st +zx_bc) :r8)
	(vp-cpy-ir-us :r14 (zx-st +zx_de) :r9)
	(vp-cpy-ir-us :r14 (zx-st +zx_hl) :r10)
	(vp-cpy-ir-us :r14 (zx-st +zx_sp) :r11)
	(vp-cpy-ir-us :r14 (zx-st +zx_pc) :r12)
	(vp-cpy-ir-us :r14 (zx-st +zx_af) :r7)
	(vp-cpy-rr :r7 :r6)
	(vp-shr-cr 8 :r7)
	(vp-and-cr 0xff :r6)
	(vp-cpy-ir :r14 (zx-st +zx_ts) :r13)

	;a new frame, and its interrupt if they are enabled. Not one after a
	;stop for the tape, part way through a frame
	(gotoif '(:r13 > 0) 'loop)
	(vp-add-cr +zx_frame :r13)
	(vp-cpy-ir-ub :r14 (zx-st +zx_iff1) :r0)
	(gotoif '(:r0 = 0) 'loop)
	(vp-cpy-ir-ub :r14 (zx-st +zx_halted) :r0)
	(vpif '(:r0 /= 0))
		(vp-xor-rr :r0 :r0)
		(vp-cpy-ri-b :r0 :r14 (zx-st +zx_halted))
		(vp-add-cr 1 :r12)
		(vp-and-cr 0xffff :r12)
	(endif)
	(vp-xor-rr :r0 :r0)
	(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff1))
	(vp-cpy-ri-b :r0 :r14 (zx-st +zx_iff2))
	(zx-r-inc)
	(vp-cpy-rr :r12 :r1)
	(vp-call 'push16)
	(vp-cpy-ir-ub :r14 (zx-st +zx_im) :r0)
	(vpif '(:r0 = 2))
		(vp-sub-cr 19 :r13)
		(vp-cpy-ir-ub :r14 (zx-st +zx_i) :r3)
		(vp-shl-cr 8 :r3)
		(vp-or-cr 0xff :r3)
		(vp-call 'rd16)
		(vp-cpy-rr :r1 :r12)
	(else)
		(vp-sub-cr 13 :r13)
		(vp-cpy-cr 0x38 :r12)
	(endif)

(vp-label 'loop)
	(gotoif '(:r13 <= 0) 'frame_end)
	(each (lambda (at)
			(vpif `(:r12 = ,at))
				(vp-cpy-ir-ub :r14 (zx-st +zx_trap) :r0)
				(gotoif '(:r0 /= 0) 'tape_stop)
			(endif))
		zx_traps)
	(zx-r-inc)
	(zx-fetch8 :r5)
	(vp-lea-p 't_main :r0)
	(vp-cpy-dr-ub :r0 :r5 :r0)
	(vp-sub-rr :r0 :r13)
	(vp-cpy-rr :r5 :r0)
	(zx-jump 'op_table :r0 :r1)
	(vp-call-r :r0)
	(vp-jmp 'loop)

(vp-label 'frame_end)
	(when zx_sound
		(vp-cpy-cr +zx_frame :r0)
		(vp-call 'beep_to)
		(vp-call 'beep_frame))
	(vp-cpy-cr +zx_stop_frame :r0)
	(vp-jmp 'stop)
(vp-label 'tape_stop)
	(vp-cpy-cr +zx_stop_tape :r0)
(vp-label 'stop)
	(vp-cpy-ri-s :r8 :r14 (zx-st +zx_bc))
	(vp-cpy-ri-s :r9 :r14 (zx-st +zx_de))
	(vp-cpy-ri-s :r10 :r14 (zx-st +zx_hl))
	(vp-cpy-ri-s :r11 :r14 (zx-st +zx_sp))
	(vp-cpy-ri-s :r12 :r14 (zx-st +zx_pc))
	(vp-shl-cr 8 :r7)
	(vp-or-rr :r6 :r7)
	(vp-cpy-ri-s :r7 :r14 (zx-st +zx_af))
	(vp-cpy-ri :r13 :r14 (zx-st +zx_ts))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)
	(exit '(:r0 :r1))
	(vp-ret)

;;;;;;;;;;;;;
; subroutines
;;;;;;;;;;;;;

(vp-label 'rd16)
	;:r3 = address -> :r1 = word, trashes :r2
	(vp-cpy-dr-ub :r14 :r3 :r1)
	(vp-cpy-rr :r3 :r2)
	(vp-add-cr 1 :r2)
	(vp-and-cr 0xffff :r2)
	(vp-cpy-dr-ub :r14 :r2 :r2)
	(vp-shl-cr 8 :r2)
	(vp-or-rr :r2 :r1)
	(vp-ret)

(vp-label 'wr16)
	;:r1 = word, :r3 = address, trashes :r2 :r3
	(zx-wr8 :r1 :r3)
	(vp-add-cr 1 :r3)
	(vp-and-cr 0xffff :r3)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 8 :r2)
	(zx-wr8 :r2 :r3)
	(vp-ret)

(vp-label 'push16)
	;:r1 = word, trashes :r2 :r3
	(vp-sub-cr 2 :r11)
	(vp-and-cr 0xffff :r11)
	(vp-cpy-rr :r11 :r3)
	(vp-jmp 'wr16)

(vp-label 'pop16)
	;-> :r1 = word, trashes :r2 :r3
	(vp-cpy-rr :r11 :r3)
	(vp-add-cr 2 :r11)
	(vp-and-cr 0xffff :r11)
	(vp-jmp 'rd16)

(vp-label 'port_in)
	;:r3 = port -> :r1 = byte, trashes :r0 :r2 :r3
	(vp-cpy-rr :r3 :r0)
	(vp-and-cr 1 :r0)
	(vpif '(:r0 = 0))
		;the ULA: the half rows its high byte has a 0 for, the tape
		(vp-cpy-cr 0x1f :r1)
		(vp-shr-cr 8 :r3)
		(each (lambda (row)
				(vp-cpy-rr :r3 :r0)
				(vp-and-cr (<< 1 row) :r0)
				(vpif '(:r0 = 0))
					(vp-cpy-ir-ub :r14 (zx-st (+ +zx_keys row)) :r2)
					(vp-and-rr :r2 :r1)
				(endif))
			(range 0 8))
		(vp-cpy-ir-ub :r14 (zx-st +zx_ear) :r0)
		(vp-cpy-ir-ub :r14 (zx-st +zx_beep) :r2)
		(vp-or-rr :r2 :r0)
		(vp-and-cr 1 :r0)
		(vp-shl-cr 6 :r0)
		(vp-or-rr :r0 :r1)
		(vp-or-cr 0xa0 :r1)
		(vp-ret)
	(endif)
	(vp-and-cr 0xff :r3)
	(vpif '(:r3 = 0x1f))
		(vp-cpy-ir-ub :r14 (zx-st +zx_kemp) :r1)
		(vp-ret)
	(endif)
	(vp-cpy-cr 0xff :r1)
	(vp-ret)

(vp-label 'port_out)
	;:r1 = byte, :r3 = port, trashes :r0 :r2-:r5
	(vp-cpy-rr :r3 :r0)
	(vp-and-cr 1 :r0)
	(vpif '(:r0 = 0))
		(vp-cpy-rr :r1 :r0)
		(vp-and-cr 7 :r0)
		(vp-cpy-ri-b :r0 :r14 (zx-st +zx_border))
		(vp-cpy-rr :r1 :r0)
		(vp-shr-cr 4 :r0)
		(vp-and-cr 1 :r0)
		(when zx_sound
			;the speaker moves, what it was till now counted
			(vp-cpy-ir-ub :r14 (zx-st +zx_beep) :r2)
			(vpif '(:r0 /= :r2))
				(vp-push :r1)
				(vp-cpy-cr +zx_frame :r0)
				(vp-sub-rr :r13 :r0)
				(vp-max-cr 0 :r0)
				(vp-min-cr +zx_frame :r0)
				(vp-call 'beep_to)
				(vp-pop :r1)
				(vp-cpy-rr :r1 :r0)
				(vp-shr-cr 4 :r0)
				(vp-and-cr 1 :r0)
			(endif))
		(vp-cpy-ri-b :r0 :r14 (zx-st +zx_beep))
	(endif)
	(vp-ret)

(when zx_sound
(vp-label 'beep_to)
	;:r0 = T of the frame, the time the speaker was high till then added
	;to its samples, trashes :r0-:r5
	(vp-cpy-ir-ui :r14 (zx-st +zx_beep_at) :r1)
	(vpif '(:r0 > :r1))
		(vp-cpy-ri-i :r0 :r14 (zx-st +zx_beep_at))
		(vp-cpy-ir-ub :r14 (zx-st +zx_beep) :r2)
		(vpif '(:r2 /= 0))
			;:r5 the T left, :r2 into the sample, :r4 the sample
			(vp-cpy-rr :r0 :r5)
			(vp-sub-rr :r1 :r5)
			(vp-cpy-rr :r1 :r4)
			(vp-xor-rr :r2 :r2)
			(vp-cpy-cr +zx_t_sample :r3)
			(vp-div-rrr-u :r3 :r2 :r4)
			(vp-shl-cr 1 :r4)
			(vp-add-cr +zx_bins :r4)
			(loop-start)
				(vp-cpy-cr +zx_t_sample :r1)
				(vp-sub-rr :r2 :r1)
				(vp-min-rr :r5 :r1)
				(vp-cpy-dr-us :r14 :r4 :r0)
				(vp-add-rr :r1 :r0)
				(vp-cpy-rd-s :r0 :r14 :r4)
				(vp-sub-rr :r1 :r5)
				(vp-xor-rr :r2 :r2)
				(vp-add-cr +short_size :r4)
			(loop-until '(:r5 = 0))
		(endif)
	(endif)
	(vp-ret)

(vp-label 'beep_frame)
	;the frame's samples made of the counts, which are cleared, trashes
	;:r0-:r5
	(vp-cpy-ir-i :r14 (zx-st +zx_dc_x) :r2)
	(vp-cpy-ir-i :r14 (zx-st +zx_dc_y) :r3)
	(vp-cpy-cr +zx_bins :r4)
	(vp-xor-rr :r5 :r5)
	(loop-start)
		;x the count at full 128 a T, y = x less the last x, and the last
		;y less 1/256 of it, at least 1 of it, so it comes to 0 each way
		(vp-cpy-dr-us :r14 :r4 :r0)
		(vp-cpy-rd-s :r5 :r14 :r4)
		(vp-shl-cr 7 :r0)
		(vp-cpy-rr :r3 :r1)
		(vpif '(:r1 > 0))
			(vp-add-cr 255 :r1)
		(endif)
		(vp-asr-cr 8 :r1)
		(vp-sub-rr :r3 :r1)
		(vp-mul-cr -1 :r1)
		(vp-add-rr :r0 :r1)
		(vp-sub-rr :r2 :r1)
		(vp-cpy-rr :r0 :r2)
		(vp-cpy-rr :r1 :r3)
		(vp-add-cr (* +zx_samples +short_size) :r4)
		(vp-cpy-rd-s :r3 :r14 :r4)
		(vp-sub-cr (- (* +zx_samples +short_size) +short_size) :r4)
	(loop-until `(:r4 = ,+zx_pcm))
	(vp-cpy-ri-i :r2 :r14 (zx-st +zx_dc_x))
	(vp-cpy-ri-i :r3 :r14 (zx-st +zx_dc_y))
	(vp-cpy-ri-i :r5 :r14 (zx-st +zx_beep_at))
	(vp-ret))

;the ALU, :r1 the byte with A, trash :r0-:r4
(vp-label 'alu_adc)
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr 1 :r0)
	(vp-jmp 'alu_addc)
(vp-label 'alu_add)
	(vp-xor-rr :r0 :r0)
(vp-label 'alu_addc)
	(vp-add-rr :r7 :r0)
	(vp-add-rr :r1 :r0)
	(vp-cpy-rr :r7 :r2)
	(vp-xor-rr :r1 :r2)
	(vp-xor-rr :r0 :r2)
	(vp-and-cr 0x10 :r2)
	(vp-cpy-rr :r0 :r3)
	(vp-shr-cr 8 :r3)
	(vp-or-rr :r3 :r2)
	(vp-cpy-rr :r7 :r3)
	(vp-xor-rr :r0 :r3)
	(vp-xor-rr :r0 :r1)
	(vp-and-rr :r1 :r3)
	(vp-and-cr 0x80 :r3)
	(vp-shr-cr 5 :r3)
	(vp-or-rr :r3 :r2)
	(vp-and-cr 0xff :r0)
	(vp-cpy-rr :r0 :r7)
	(zx-sz53 :r0 :r3)
	(vp-or-rr :r3 :r2)
	(vp-cpy-rr :r2 :r6)
	(vp-ret)

(vp-label 'alu_sbc)
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr 1 :r0)
	(vp-jmp 'alu_subc)
(vp-label 'alu_sub)
	(vp-xor-rr :r0 :r0)
(vp-label 'alu_subc)
	(vp-call 'sub8)
	(vp-cpy-rr :r3 :r7)
	(vp-cpy-rr :r2 :r6)
	(vp-ret)

(vp-label 'alu_cp)
	;bits 3 and 5 are of the byte, not of the result
	(vp-xor-rr :r0 :r0)
	(vp-call 'sub8)
	(vp-and-cr 0xd7 :r2)
	(vp-and-cr 0x28 :r1)
	(vp-or-rr :r1 :r2)
	(vp-cpy-rr :r2 :r6)
	(vp-ret)

(vp-label 'sub8)
	;:r1 = byte, :r0 = carry -> :r3 = A less them, :r2 = F, trashes :r0 :r4
	(vp-cpy-rr :r7 :r3)
	(vp-sub-rr :r1 :r3)
	(vp-sub-rr :r0 :r3)
	(vp-cpy-rr :r7 :r4)
	(vp-xor-rr :r1 :r4)
	(vp-cpy-rr :r4 :r2)
	(vp-xor-rr :r3 :r2)
	(vp-and-cr 0x10 :r2)
	(vp-cpy-rr :r3 :r0)
	(vp-shr-cr 8 :r0)
	(vp-and-cr 1 :r0)
	(vp-or-rr :r0 :r2)
	(vp-cpy-rr :r7 :r0)
	(vp-xor-rr :r3 :r0)
	(vp-and-rr :r4 :r0)
	(vp-and-cr 0x80 :r0)
	(vp-shr-cr 5 :r0)
	(vp-or-rr :r0 :r2)
	(vp-or-cr 2 :r2)
	(vp-and-cr 0xff :r3)
	(zx-sz53 :r3 :r0)
	(vp-or-rr :r0 :r2)
	(vp-ret)

(vp-label 'alu_and)
	(vp-and-rr :r1 :r7)
	(zx-sz53p :r7 :r6)
	(vp-or-cr 0x10 :r6)
	(vp-ret)
(vp-label 'alu_xor)
	(vp-xor-rr :r1 :r7)
	(zx-sz53p :r7 :r6)
	(vp-ret)
(vp-label 'alu_or)
	(vp-or-rr :r1 :r7)
	(zx-sz53p :r7 :r6)
	(vp-ret)

(vp-label 'inc8)
	;:r1 = byte -> :r1 = one more, trashes :r0 :r2
	(vp-cpy-rr :r1 :r2)
	(vp-add-cr 1 :r1)
	(vp-and-cr 0xff :r1)
	(vp-and-cr 1 :r6)
	(zx-sz53 :r1 :r0)
	(vp-or-rr :r0 :r6)
	(vp-cpy-rr :r1 :r0)
	(vp-and-cr 0x0f :r0)
	(vpif '(:r0 = 0))
		(vp-or-cr 0x10 :r6)
	(endif)
	(vpif '(:r2 = 0x7f))
		(vp-or-cr 4 :r6)
	(endif)
	(vp-ret)

(vp-label 'dec8)
	;:r1 = byte -> :r1 = one less, trashes :r0 :r2
	(vp-cpy-rr :r1 :r2)
	(vp-sub-cr 1 :r1)
	(vp-and-cr 0xff :r1)
	(vp-and-cr 1 :r6)
	(vp-or-cr 2 :r6)
	(zx-sz53 :r1 :r0)
	(vp-or-rr :r0 :r6)
	(vp-cpy-rr :r2 :r0)
	(vp-and-cr 0x0f :r0)
	(vpif '(:r0 = 0))
		(vp-or-cr 0x10 :r6)
	(endif)
	(vpif '(:r2 = 0x80))
		(vp-or-cr 4 :r6)
	(endif)
	(vp-ret)

(vp-label 'add16)
	;:r1 = word, HL plus it, trashes :r0 :r2
	(vp-cpy-rr :r10 :r0)
	(vp-add-rr :r1 :r0)
	(vp-and-cr 0xc4 :r6)
	(vp-cpy-rr :r0 :r2)
	(vp-shr-cr 8 :r2)
	(vp-and-cr 0x28 :r2)
	(vp-or-rr :r2 :r6)
	(vp-cpy-rr :r10 :r2)
	(vp-xor-rr :r1 :r2)
	(vp-xor-rr :r0 :r2)
	(vp-shr-cr 8 :r2)
	(vp-and-cr 0x10 :r2)
	(vp-or-rr :r2 :r6)
	(vp-cpy-rr :r0 :r2)
	(vp-shr-cr 16 :r2)
	(vp-or-rr :r2 :r6)
	(vp-and-cr 0xffff :r0)
	(vp-cpy-rr :r0 :r10)
	(vp-ret)

(vp-label 'adc16)
	;:r1 = word, HL plus it and the carry, trashes :r0 :r2
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr 1 :r0)
	(vp-add-rr :r10 :r0)
	(vp-add-rr :r1 :r0)
	(vp-cpy-rr :r0 :r6)
	(vp-shr-cr 16 :r6)
	(vp-cpy-rr :r0 :r2)
	(vp-shr-cr 8 :r2)
	(vp-and-cr 0xa8 :r2)
	(vp-or-rr :r2 :r6)
	(vp-cpy-rr :r10 :r2)
	(vp-xor-rr :r1 :r2)
	(vp-xor-rr :r0 :r2)
	(vp-shr-cr 8 :r2)
	(vp-and-cr 0x10 :r2)
	(vp-or-rr :r2 :r6)
	(vp-cpy-rr :r10 :r2)
	(vp-xor-rr :r0 :r2)
	(vp-xor-rr :r0 :r1)
	(vp-and-rr :r1 :r2)
	(vp-and-cr 0x8000 :r2)
	(vp-shr-cr 13 :r2)
	(vp-or-rr :r2 :r6)
	(vp-and-cr 0xffff :r0)
	(vpif '(:r0 = 0))
		(vp-or-cr 0x40 :r6)
	(endif)
	(vp-cpy-rr :r0 :r10)
	(vp-ret)

(vp-label 'sbc16)
	;:r1 = word, HL less it and the carry, trashes :r0 :r2 :r3
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr 1 :r0)
	(vp-cpy-rr :r10 :r3)
	(vp-sub-rr :r1 :r3)
	(vp-sub-rr :r0 :r3)
	(vp-cpy-rr :r3 :r6)
	(vp-shr-cr 16 :r6)
	(vp-and-cr 1 :r6)
	(vp-or-cr 2 :r6)
	(vp-cpy-rr :r3 :r2)
	(vp-shr-cr 8 :r2)
	(vp-and-cr 0xa8 :r2)
	(vp-or-rr :r2 :r6)
	(vp-cpy-rr :r10 :r2)
	(vp-xor-rr :r1 :r2)
	(vp-xor-rr :r3 :r2)
	(vp-shr-cr 8 :r2)
	(vp-and-cr 0x10 :r2)
	(vp-or-rr :r2 :r6)
	(vp-xor-rr :r10 :r1)
	(vp-cpy-rr :r10 :r2)
	(vp-xor-rr :r3 :r2)
	(vp-and-rr :r1 :r2)
	(vp-and-cr 0x8000 :r2)
	(vp-shr-cr 13 :r2)
	(vp-or-rr :r2 :r6)
	(vp-and-cr 0xffff :r3)
	(vpif '(:r3 = 0))
		(vp-or-cr 0x40 :r6)
	(endif)
	(vp-cpy-rr :r3 :r10)
	(vp-ret)

(vp-label 'daa)
	;:r0 what is added or taken, :r1 the carry
	(vp-xor-rr :r0 :r0)
	(vp-cpy-rr :r6 :r1)
	(vp-and-cr 1 :r1)
	(vp-cpy-rr :r6 :r2)
	(vp-and-cr 0x10 :r2)
	(vpif '(:r2 /= 0))
		(vp-cpy-cr 6 :r0)
	(endif)
	(vp-cpy-rr :r7 :r2)
	(vp-and-cr 0x0f :r2)
	(vpif '(:r2 > 9))
		(vp-cpy-cr 6 :r0)
	(endif)
	(vpif '(:r7 > 0x99))
		(vp-cpy-cr 1 :r1)
	(endif)
	(vpif '(:r1 /= 0))
		(vp-or-cr 0x60 :r0)
	(endif)
	(vp-cpy-rr :r7 :r3)
	(vp-cpy-rr :r6 :r2)
	(vp-and-cr 2 :r2)
	(vpif '(:r2 = 0))
		(vp-add-rr :r0 :r7)
	(else)
		(vp-sub-rr :r0 :r7)
	(endif)
	(vp-and-cr 0xff :r7)
	(vp-xor-rr :r7 :r3)
	(vp-xor-rr :r0 :r3)
	(vp-and-cr 0x10 :r3)
	(vp-or-rr :r2 :r1)
	(vp-or-rr :r3 :r1)
	(zx-sz53p :r7 :r6)
	(vp-or-rr :r1 :r6)
	(vp-ret)

(vp-label 'flags_a_ir)
	;F of LD A,I and LD A,R, P/V is IFF2
	(vp-cpy-ir-ub :r14 (zx-st +zx_iff2) :r0)
	(vp-and-cr 1 :r6)
	(zx-sz53 :r7 :r1)
	(vp-or-rr :r1 :r6)
	(vpif '(:r0 /= 0))
		(vp-or-cr 4 :r6)
	(endif)
	(vp-ret)

(vp-label 'flags_rxd)
	;F of RRD and RLD
	(vp-and-cr 1 :r6)
	(zx-sz53p :r7 :r1)
	(vp-or-rr :r1 :r6)
(vp-label 'h_nop)
	(vp-ret)

;;;;;;;;;;
; prefixes
;;;;;;;;;;

(vp-label 'h_dd)
	(vp-cpy-ri-s :r10 :r14 (zx-st +zx_hlx))
	(vp-cpy-ir-us :r14 (zx-st +zx_ix) :r10)
	(vp-call 'idx_run)
	(vp-cpy-ri-s :r10 :r14 (zx-st +zx_ix))
	(vp-cpy-ir-us :r14 (zx-st +zx_hlx) :r10)
	(vp-ret)

(vp-label 'h_fd)
	(vp-cpy-ri-s :r10 :r14 (zx-st +zx_hlx))
	(vp-cpy-ir-us :r14 (zx-st +zx_iy) :r10)
	(vp-call 'idx_run)
	(vp-cpy-ri-s :r10 :r14 (zx-st +zx_iy))
	(vp-cpy-ir-us :r14 (zx-st +zx_hlx) :r10)
	(vp-ret)

(vp-label 'idx_run)
	;the opcode after the prefix, IX or IY in HL's place
	(zx-r-inc)
	(zx-fetch8 :r5)
	(vp-lea-p 't_main :r0)
	(vp-cpy-dr-ub :r0 :r5 :r0)
	(vp-sub-rr :r0 :r13)
	(vp-cpy-rr :r5 :r0)
	(zx-jump 'idx_table :r0 :r1)
	(vp-jmp-r :r0)

(vp-label 'pfx_skip)
	;the prefix is all that is done, the opcode is done next as itself
	(vp-sub-cr 1 :r12)
	(vp-and-cr 0xffff :r12)
	(vp-lea-p 't_main :r0)
	(vp-cpy-dr-ub :r0 :r5 :r0)
	(vp-add-rr :r0 :r13)
	(vp-cpy-ir-ub :r14 (zx-st +zx_r) :r0)
	(vp-sub-cr 1 :r0)
	(vp-cpy-ri-b :r0 :r14 (zx-st +zx_r))
	(vp-ret)

(vp-label 'h_ed)
	(zx-r-inc)
	(zx-fetch8 :r5)
	(vp-lea-p 't_ed :r0)
	(vp-cpy-dr-ub :r0 :r5 :r0)
	(vp-sub-rr :r0 :r13)
	(vp-cpy-rr :r5 :r0)
	(zx-jump 'ed_table :r0 :r1)
	(vp-jmp-r :r0)

(vp-label 'h_cb)
	;the byte of :r4, from its register, or (HL) of :r1, H in :r3 for BIT
	(zx-r-inc)
	(zx-fetch8 :r5)
	(vp-cpy-rr :r5 :r4)
	(vp-and-cr 7 :r4)
	(vp-cpy-rr :r4 :r0)
	(zx-jump 'get_table :r0 :r1)
	(vp-call-r :r0)
	(vpif '(:r4 /= 6))
		(vp-cpy-rr :r1 :r3)
		(vp-sub-cr 4 :r13)
	(else)
		(vp-cpy-rr :r10 :r3)
		(vp-shr-cr 8 :r3)
		(vp-cpy-rr :r5 :r0)
		(vp-shr-cr 6 :r0)
		(vpif '(:r0 = 1))
			(vp-sub-cr 8 :r13)
		(else)
			(vp-sub-cr 11 :r13)
		(endif)
	(endif)
	(vp-call 'cb_op)
	(vpif '(:r0 /= 0))
		(zx-jump 'put_table :r4 :r0)
		(vp-jmp-r :r4)
	(endif)
	(vp-ret)

(vp-label 'h_ddcb)
	;DD CB d op, IX in :r10, its address in :r4. What is not BIT goes to
	;memory and to the register it names too, H and L as HL's own
	(zx-fetchd :r4)
	(vp-add-rr :r10 :r4)
	(vp-and-cr 0xffff :r4)
	(zx-fetch8 :r5)
	(vp-cpy-dr-ub :r14 :r4 :r1)
	(vp-cpy-rr :r4 :r3)
	(vp-shr-cr 8 :r3)
	(vp-cpy-rr :r5 :r0)
	(vp-shr-cr 6 :r0)
	(vpif '(:r0 = 1))
		(vp-sub-cr 12 :r13)
	(else)
		(vp-sub-cr 15 :r13)
	(endif)
	(vp-call 'cb_op)
	(gotoif '(:r0 = 0) 'h_nop)
	(zx-wr8 :r1 :r4)
	(vp-cpy-rr :r5 :r2)
	(vp-and-cr 7 :r2)
	(gotoif '(:r2 = 6) 'h_nop)
	(vp-cpy-rr :r10 :r4)
	(vp-cpy-ir-us :r14 (zx-st +zx_hlx) :r10)
	(zx-jump 'put_table :r2 :r3)
	(vp-call-r :r2)
	(vp-cpy-ri-s :r10 :r14 (zx-st +zx_hlx))
	(vp-cpy-rr :r4 :r10)
	(vp-ret)

(vp-label 'cb_op)
	;:r1 = byte, :r5 = opcode, :r3 = what BIT's bits 3 and 5 are of
	;-> :r1 = the byte after, :r0 = 0 if it is not written, trashes :r2 :r3
	(vp-cpy-rr :r5 :r0)
	(vp-shr-cr 6 :r0)
	(vp-cpy-rr :r5 :r2)
	(vp-shr-cr 3 :r2)
	(vp-and-cr 7 :r2)
	(vpif '(:r0 = 0))
		(zx-jump 'rot_table :r2 :r3)
		(vp-jmp-r :r2)
	(endif)
	(vpif '(:r0 = 1))
		;BIT
		(vp-cpy-rr :r1 :r0)
		(vp-shr-rr :r2 :r0)
		(vp-and-cr 1 :r0)
		(vp-and-cr 1 :r6)
		(vp-or-cr 0x10 :r6)
		(vp-and-cr 0x28 :r3)
		(vp-or-rr :r3 :r6)
		(vpif '(:r0 = 0))
			(vp-or-cr 0x44 :r6)
		(elseif '(:r2 = 7))
			(vp-or-cr 0x80 :r6)
		(endif)
		(vp-xor-rr :r0 :r0)
		(vp-ret)
	(endif)
	(vp-cpy-cr 1 :r3)
	(vp-shl-rr :r2 :r3)
	(vpif '(:r0 = 2))
		(vp-xor-cr 0xff :r3)
		(vp-and-rr :r3 :r1)
	(else)
		(vp-or-rr :r3 :r1)
	(endif)
	(vp-cpy-cr 1 :r0)
	(vp-ret)

;the shifts and rotates, :r1 the byte after, :r2 the carry
(vp-label 'rot_rlc)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 7 :r2)
	(vp-shl-cr 1 :r1)
	(vp-or-rr :r2 :r1)
	(vp-and-cr 0xff :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_rrc)
	(vp-cpy-rr :r1 :r2)
	(vp-and-cr 1 :r2)
	(vp-shr-cr 1 :r1)
	(vp-cpy-rr :r2 :r0)
	(vp-shl-cr 7 :r0)
	(vp-or-rr :r0 :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_rl)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 7 :r2)
	(vp-shl-cr 1 :r1)
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr 1 :r0)
	(vp-or-rr :r0 :r1)
	(vp-and-cr 0xff :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_rr)
	(vp-cpy-rr :r1 :r2)
	(vp-and-cr 1 :r2)
	(vp-shr-cr 1 :r1)
	(vp-cpy-rr :r6 :r0)
	(vp-and-cr 1 :r0)
	(vp-shl-cr 7 :r0)
	(vp-or-rr :r0 :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_sla)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 7 :r2)
	(vp-shl-cr 1 :r1)
	(vp-and-cr 0xff :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_sra)
	(vp-cpy-rr :r1 :r2)
	(vp-and-cr 1 :r2)
	(vp-cpy-rr :r1 :r0)
	(vp-and-cr 0x80 :r0)
	(vp-shr-cr 1 :r1)
	(vp-or-rr :r0 :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_sll)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 7 :r2)
	(vp-shl-cr 1 :r1)
	(vp-or-cr 1 :r1)
	(vp-and-cr 0xff :r1)
	(vp-jmp 'rot_done)
(vp-label 'rot_srl)
	(vp-cpy-rr :r1 :r2)
	(vp-and-cr 1 :r2)
	(vp-shr-cr 1 :r1)
(vp-label 'rot_done)
	(zx-sz53p :r1 :r0)
	(vp-or-rr :r2 :r0)
	(vp-cpy-rr :r0 :r6)
	(vp-cpy-cr 1 :r0)
	(vp-ret)

;a register of CB opcodes, got into :r1, put from :r1, trash :r0
(each (lambda (r)
		(vp-label (zx-lab "zg" r))
		(zx-get r :r1)
		(vp-ret)
		(vp-label (zx-lab "zp" r))
		(zx-put r :r1 :r0)
		(vp-ret))
	(range 0 8))

;;;;;;;;;;;;;;;;;;
; opcode handlers
;;;;;;;;;;;;;;;;;;

	(each (lambda (op)
			(unless (find op '(0xcb 0xdd 0xed 0xfd))
				(zx-gen-main op)))
		(range 0 256))
	(each (lambda (op)
			(if (zx-idx-op? op) (zx-gen-idx op)))
		(range 0 256))
	(each (lambda (op)
			(unless (eql (zx-ed-label op) 'h_nop)
				(zx-gen-ed op)))
		(range 0 256))

;;;;;;;;
; tables
;;;;;;;;

	(vp-align +long_size)
(vp-label 'op_table)
	(each (lambda (op)
			(vp-long `(- ,(label-sym (zx-main-label op)) ,(label-sym 'op_table))))
		(range 0 256))
(vp-label 'idx_table)
	(each (lambda (op)
			(vp-long `(- ,(label-sym (zx-idx-label op)) ,(label-sym 'idx_table))))
		(range 0 256))
(vp-label 'ed_table)
	(each (lambda (op)
			(vp-long `(- ,(label-sym (zx-ed-label op)) ,(label-sym 'ed_table))))
		(range 0 256))
(vp-label 'get_table)
	(each (lambda (r)
			(vp-long `(- ,(label-sym (zx-lab "zg" r)) ,(label-sym 'get_table))))
		(range 0 8))
(vp-label 'put_table)
	(each (lambda (r)
			(vp-long `(- ,(label-sym (zx-lab "zp" r)) ,(label-sym 'put_table))))
		(range 0 8))
(vp-label 'rot_table)
	(each (lambda (l)
			(vp-long `(- ,(label-sym l) ,(label-sym 'rot_table))))
		'(rot_rlc rot_rrc rot_rl rot_rr rot_sla rot_sra rot_sll rot_srl))
(vp-label 't_main)
	(apply (const vp-byte) (map (const zx-t-main) (range 0 256)))
(vp-label 't_ed)
	(apply (const vp-byte) (map (const zx-t-ed) (range 0 256)))
;S Z and bits 5 and 3 of a byte, and its parity as P/V
(vp-label 'sz53)
	(apply (const vp-byte) (map (lambda (i)
		(logior (logand i 0xa8) (if (= i 0) 0x40 0))) (range 0 256)))
(vp-label 'sz53p)
	(apply (const vp-byte) (map (lambda (i)
		(defq bits 0)
		(each (lambda (b) (if (/= 0 (logand i (<< 1 b))) (setq bits (inc bits)))) (range 0 8))
		(logior (logand i 0xa8) (if (= i 0) 0x40 0) (if (= 0 (logand bits 1)) 4 0))) (range 0 256)))

(vp-label 'error)
	(jump :lisp :repl_error `(:r1 ,name +error_msg_wrong_types))
	(signature '(:str)))

(def-func (path-to-absolute "./zx_run"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	;the ROM below 0x4000 is not written, and the tape loader is LD-BYTES,
	;from its start or from after it sets the border, as some loaders call it
	(setq zx_rom 0x4000 zx_traps (list +zx_ld_bytes +zx_ld_bytes2) zx_sound :t)
	(zx-run-body "(zx-run machine)")

(def-func-end)

(def-func (path-to-absolute "./zx_test"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	;all the memory is written, and the stop is CP/M's BDOS call at 5,
	;for the test of the Z80
	(setq zx_rom 0 zx_traps '(5) zx_sound :nil)
	(zx-run-body "(zx-test machine)")

(def-func-end)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; the screen
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-func (path-to-absolute "./zx_render"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :r9-:r14

	;the screen and its border onto the canvas, each pixel zoom square.
	;FLASH swaps ink and paper while flash is 0x80, never if 0. A canvas too small
	;for it, or a machine too small, is not drawn on
	(structure local 0
		(ptr this args)
		(long row stride lines flash border))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc local_size)
	(assign '(:r0 :r1) '((:rsp local_this) (:rsp local_args)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5) '(:obj :obj :num :num))
	(assign '((:r3 +str_length)) '(:r0))
	(gotoif `(:r0 < ,+zx_machine_size) 'done)
	(gotoif '(:r5 < 1) 'done)
	(gotoif '(:r5 > 4) 'done)
	(assign '((:r2 +canvas_pixmap)) '(:r2))
	(gotoif '(:r2 = 0) 'done)
	(vp-cpy-ir-ui :r2 +pixmap_width :r0)
	(vp-cpy-cr +zx_width :r1)
	(vp-mul-rr :r5 :r1)
	(gotoif '(:r0 < :r1) 'done)
	(vp-cpy-ir-ui :r2 +pixmap_height :r0)
	(vp-cpy-cr +zx_height :r1)
	(vp-mul-rr :r5 :r1)
	(gotoif '(:r0 < :r1) 'done)

	(vp-cpy-ir-ui :r2 +pixmap_stride :r0)
	(assign '(:r0 :r4) '((:rsp local_stride) (:rsp local_flash)))
	(vp-cpy-ir :r2 +pixmap_data :r0)
	(assign '(:r0) '((:rsp local_row)))
	(vp-lea-p 'palette :r13)
	(vp-cpy-ir-ub :r3 (+ +str_data +zx_border) :r0)
	(vp-shl-cr 2 :r0)
	(vp-cpy-dr-ui :r13 :r0 :r0)
	(assign '(:r0) '((:rsp local_border)))
	(vp-lea-i :r3 (+ +str_data +zx_size) :r12)
	(vp-xor-rr :r7 :r7)

	;:r5 zoom, :r6 where a pixel goes, :r7 the line, :r12 memory, :r13
	;the palette
	(loop-start)
		(assign '((:rsp local_row)) '(:r6))
		(assign '((:rsp local_border)) '(:r2))
		(vpif '(:r7 >= 32) '(:r7 < 224))
			(vp-cpy-cr 32 :r1)
			(vp-call 'fill)
			;where the line's pixels and colours are
			(vp-cpy-rr :r7 :r0)
			(vp-sub-cr 32 :r0)
			(vp-cpy-rr :r0 :r3)
			(vp-and-cr 0xc0 :r3)
			(vp-shl-cr 5 :r3)
			(vp-cpy-rr :r0 :r1)
			(vp-and-cr 7 :r1)
			(vp-shl-cr 8 :r1)
			(vp-or-rr :r1 :r3)
			(vp-cpy-rr :r0 :r1)
			(vp-and-cr 0x38 :r1)
			(vp-shl-cr 2 :r1)
			(vp-or-rr :r1 :r3)
			(vp-or-cr 0x4000 :r3)
			(vp-cpy-rr :r0 :r4)
			(vp-shr-cr 3 :r4)
			(vp-shl-cr 5 :r4)
			(vp-add-cr 0x5800 :r4)
			(vp-cpy-cr 32 :r11)
			(loop-start)
				(vp-cpy-dr-ub :r12 :r4 :r1)
				(vp-cpy-rr :r1 :r0)
				(vp-shr-cr 3 :r0)
				(vp-and-cr 8 :r0)
				(vp-cpy-rr :r1 :r2)
				(vp-and-cr 7 :r2)
				(vp-or-rr :r0 :r2)
				(vp-cpy-rr :r1 :r9)
				(vp-shr-cr 3 :r9)
				(vp-and-cr 7 :r9)
				(vp-or-rr :r0 :r9)
				(vp-shl-cr 2 :r2)
				(vp-shl-cr 2 :r9)
				(vp-cpy-dr-ui :r13 :r2 :r2)
				(vp-cpy-dr-ui :r13 :r9 :r9)
				(assign '((:rsp local_flash)) '(:r0))
				(vp-and-rr :r0 :r1)
				(vpif '(:r1 /= 0))
					(vp-swp-rr :r2 :r9)
				(endif)
				;ink :r2, paper :r9, the byte :r10, its top bit the next pixel
				(vp-cpy-dr-ub :r12 :r3 :r10)
				(vp-cpy-cr 8 :r14)
				(loop-start)
					(vp-cpy-rr :r10 :r0)
					(vp-and-cr 0x80 :r0)
					(vp-cpy-rr :r9 :r1)
					(vpif '(:r0 /= 0))
						(vp-cpy-rr :r2 :r1)
					(endif)
					(vp-cpy-rr :r5 :r0)
					(loop-start)
						(vp-cpy-ri-i :r1 :r6 0)
						(vp-add-cr +int_size :r6)
						(vp-sub-cr 1 :r0)
					(loop-until '(:r0 = 0))
					(vp-shl-cr 1 :r10)
					(vp-sub-cr 1 :r14)
				(loop-until '(:r14 = 0))
				(vp-add-cr 1 :r3)
				(vp-add-cr 1 :r4)
				(vp-sub-cr 1 :r11)
			(loop-until '(:r11 = 0))
			(assign '((:rsp local_border)) '(:r2))
			(vp-cpy-cr 32 :r1)
			(vp-call 'fill)
		(else)
			(vp-cpy-cr +zx_width :r1)
			(vp-call 'fill)
		(endif)
		;the line again for the rest of its zoom
		(assign '((:rsp local_row) (:rsp local_stride)) '(:r0 :r1))
		(vp-cpy-rr :r5 :r2)
		(loop-start)
			(vp-sub-cr 1 :r2)
			(breakif '(:r2 = 0))
			(vp-lea-d :r0 :r1 :r3)
			(vp-cpy-rr :r5 :r4)
			(vp-mul-cr (* +zx_width +int_size) :r4)
			(vp-add-rr :r0 :r4)
			(vp-cpy-rr :r0 :r9)
			(loop-start)
				(vp-cpy-ir :r9 0 :r10)
				(vp-cpy-ri :r10 :r3 0)
				(vp-add-cr +long_size :r9)
				(vp-add-cr +long_size :r3)
			(loop-until '(:r9 >= :r4))
			(vp-add-rr :r1 :r0)
		(loop-end)
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:rsp local_row)))
		(vp-add-cr 1 :r7)
	(loop-until `(:r7 = ,+zx_height))

(vp-label 'done)
	(assign '((:rsp local_this)) '(:r0))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'fill)
	;:r1 pixels of :r2, zoom times each, at :r6 on, trashes :r0 :r1
	(vp-mul-rr :r5 :r1)
	(loop-start)
		(vp-cpy-ri-i :r2 :r6 0)
		(vp-add-cr +int_size :r6)
		(vp-sub-cr 1 :r1)
	(loop-until '(:r1 = 0))
	(vp-ret)

	(vp-align +int_size)
(vp-label 'palette)
	(vp-int 0xff000000 0xff0000d7 0xffd70000 0xffd700d7 0xff00d700 0xff00d7d7 0xffd7d700 0xffd7d7d7
		0xff000000 0xff0000ff 0xffff0000 0xffff00ff 0xff00ff00 0xff00ffff 0xffffff00 0xffffffff)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(zx-render canvas machine flash zoom)" +error_msg_wrong_types))
	(signature '(:canvas :str :num :num))

(def-func-end)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; bytes into the memory
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(def-func (path-to-absolute "./zx_poke"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6

	;the bytes of data into the memory at addr on, the ROM too, as many
	;as fit below 64K
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(vp-push :r0)
	(list-bind-args :r1 '(:r2 :r3 :r4) '(:obj :num :obj))
	(assign '((:r2 +str_length)) '(:r0))
	(gotoif `(:r0 < ,+zx_machine_size) 'done)
	(gotoif '(:r3 < 0) 'done)
	(assign '((:r4 +str_length)) '(:r5))
	(vp-cpy-cr +zx_mem_size :r6)
	(vp-sub-rr :r3 :r6)
	(vp-min-rr :r6 :r5)
	(gotoif '(:r5 <= 0) 'done)
	(vp-lea-i :r2 (+ +str_data +zx_size) :r2)
	(vp-add-rr :r3 :r2)
	(vp-add-cr +str_data :r4)
	(loop-start)
		(vp-cpy-ir-ub :r4 0 :r0)
		(vp-cpy-ri-b :r0 :r2 0)
		(vp-add-cr 1 :r4)
		(vp-add-cr 1 :r2)
		(vp-sub-cr 1 :r5)
	(loop-until '(:r5 = 0))

(vp-label 'done)
	(vp-pop :r0)
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)
	(exit '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(zx-poke machine addr data)" +error_msg_wrong_types))
	(signature '(:str :NUM :str))

(def-func-end)
