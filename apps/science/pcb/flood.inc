(include "./collide.inc")

;what the floods are made of, lisp_near.vp, lisp_cost.vp, lisp_back.vp
;and lisp_wave.vp: a file each, so a make assembles them side by side

(defun pcb-pad ()
	;the point of the node :r0 :r1 :r2, ints, as fixeds into :r0 :r1 :r2: a pad's
	;own point if the board has one for it, else the node's. Trashes :r3-:r5
	(load-fields :rsp '(slot_h slot_w) '(:r3 :r4))
	(vp-mul-rr :r2 :r3)
	(vp-add-rr :r1 :r3)
	(vp-mul-rr :r4 :r3)
	(vp-add-rr :r0 :r3)
	(assign '((:rsp slot_didx)) '(:r4))
	(vp-shl-cr (log2 +long_size) :r3)
	(vp-add-rr :r3 :r4)
	(assign '((:r4 0)) '(:r4))
	(vpif '(:r4 = 0))
		(vp-shl-cr +fp_shift :r0)
		(vp-shl-cr +fp_shift :r1)
		(vp-shl-cr +fp_shift :r2)
	(else)
		(vp-sub-cr 1 :r4)
		(vp-mul-cr (* 3 +long_size) :r4)
		(assign '((:rsp slot_dpts)) '(:r5))
		(vp-add-rr :r5 :r4)
		(assign `((:r4 0) (:r4 +long_size) (:r4 ,(* 2 +long_size))) '(:r0 :r1 :r2))
	(endif))

(defun pcb-hit-layers (blist hit)
	;does the line of slot_ldata short with any track of the layers zlo to
	;zhi of blist, a list of the bucket lists of each layer: jumps to hit
	;if so, as (. layers :hit_line) in layer.inc, (. layer :aabb) for the
	;buckets of each. With hit :count, how many it shorts with is added to
	;slot_count, and it goes on
	(assign '((:rsp slot_zlo)) '(:r0))
	(assign '(:r0) '((:rsp slot_z)))
	(loop-start)
		(load-fields :rsp '(slot_z slot_zhi) '(:r0 :r1))
		(breakif '(:r0 > :r1))
		(vp-asr-cr +fp_shift :r0)
		(vp-shl-cr (log2 +ptr_size) :r0)
		(assign `((:rsp ,blist)) '(:r1))
		(vp-add-rr :r0 :r1)
		(assign '((:r1 0)) '(:r1))
		(assign '((:r1 +array_begin)) '(:r1))
		(assign '(:r1) '((:rsp slot_bl)))
		;the cells the line and its radius and gap cover
		(assign '((:rsp slot_ldata)) '(:r0))
		(assign `((:r0 ,(* 4 +long_size)) (:r0 ,(* 5 +long_size))) '(:r6 :r7))
		(vp-add-rr :r7 :r6)
		(assign '((:rsp slot_scale)) '(:r7))
		(each (lambda ((a b lo hi size))
				(assign `((:r0 ,(* a +long_size)) (:r0 ,(* b +long_size))) '(:r1 :r2))
				(vpif '(:r1 > :r2))
					(vp-cpy-rr :r1 :r3) (vp-cpy-rr :r2 :r1) (vp-cpy-rr :r3 :r2)
				(endif)
				(vp-sub-rr :r6 :r1) (vp-add-rr :r6 :r2)
				(pcb-fmul :r1 :r7) (pcb-fmul :r2 :r7)
				(vp-asr-cr +fp_shift :r1) (vp-asr-cr +fp_shift :r2)
				(assign `((:rsp ,size)) '(:r3))
				(vp-sub-cr 1 :r3)
				(each (lambda (r)
						(vpif `(,r < 0))
							(vp-xor-rr r r)
						(endif)
						(vpif `(,r > :r3))
							(vp-cpy-rr :r3 r)
						(endif)) '(:r1 :r2))
				(assign '(:r1 :r2) `((:rsp ,lo) (:rsp ,hi))))
			'((0 2 slot_minx slot_maxx slot_cw) (1 3 slot_miny slot_maxy slot_ch)))
		(assign '((:rsp slot_miny)) '(:r0))
		(assign '(:r0) '((:rsp slot_row)))
		(loop-start)
			(load-fields :rsp '(slot_row slot_maxy) '(:r0 :r1))
			(breakif '(:r0 > :r1))
			(assign '((:rsp slot_minx)) '(:r0))
			(assign '(:r0) '((:rsp slot_col)))
			(loop-start)
				(load-fields :rsp '(slot_col slot_maxx) '(:r0 :r1))
				(breakif '(:r0 > :r1))
				(load-fields :rsp '(slot_row slot_cw slot_bl) '(:r1 :r2 :r3))
				(vp-mul-rr :r2 :r1)
				(vp-add-rr :r0 :r1)
				(vp-shl-cr (log2 +ptr_size) :r1)
				(vp-add-rr :r3 :r1)
				(assign '((:r1 0)) '(:r1))
				(class/array/get_both :r1 :r2 :r3)
				(save-fields :rsp '(slot_rec_iter slot_rec_end) '(:r2 :r3))
				(loop-start)
					(load-fields :rsp '(slot_rec_iter slot_rec_end) '(:r0 :r1))
					(breakif '(:r0 = :r1))
					(assign '((:r0 0) (:rsp slot_idnum)) '(:r1 :r2))
					(assign '((:r1 +array_begin)) '(:r3))
					(assign '((:r3 0)) '(:r3))
					(vpif '(:r3 /= :r2))
						(assign '(:r1) '((:rsp slot_rec)))
						(call :num :ref '(:r2))
						(load-fields :rsp '(slot_rec slot_idnum) '(:r0 :r1))
						(call :list :set_elem '(:r0 :r1 0))
						(load-fields :rsp '(slot_line slot_rec) '(:r13 :r1))
						(vp-call 'collide)
						(cond
							((eql hit :count)
								(vpif '(:r0 /= 0))
									(assign '((:rsp slot_count)) '(:r0))
									(vp-add-cr 1 :r0)
									(assign '(:r0) '((:rsp slot_count)))
								(endif))
							(:t (gotoif '(:r0 /= 0) hit)))
					(endif)
					(assign '((:rsp slot_rec_iter)) '(:r0))
					(vp-add-cr +ptr_size :r0)
					(assign '(:r0) '((:rsp slot_rec_iter)))
				(loop-end)
				(assign '((:rsp slot_col)) '(:r0))
				(vp-add-cr 1 :r0)
				(assign '(:r0) '((:rsp slot_col)))
			(loop-end)
			(assign '((:rsp slot_row)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:rsp slot_row)))
		(loop-end)
		(assign '((:rsp slot_z)) '(:r0))
		(vp-add-cr (<< 1 +fp_shift) :r0)
		(assign '(:r0) '((:rsp slot_z)))
	(loop-end))

(defun pcb-new-id ()
	;a num for this line's look, made new so no track is taken as looked at
	;already: its value one less than the last, as the Lisp's are above 0
	(assign '((:rsp slot_ctr)) '(:r1))
	(assign '((:r1 0)) '(:r0))
	(vp-sub-cr 1 :r0)
	(assign '(:r0) '((:r1 0)))
	(call :num :create '(:r0) '(:r0))
	(assign '(:r0) '((:rsp slot_idnum))))

(defun pcb-push-node (out)
	;a nums of slot_cx cy cz on the list out
	(call :nums :create :nil '(:r0))
	(each (lambda (v)
			(call :array :push_back `(:r0 (:rsp ,v)) '(:r0 _ _ _))) '(slot_cx slot_cy slot_cz))
	(vp-cpy-rr :r0 :r1)
	(call :list :push_back `((:rsp ,out) :r1) '(_ _ _ _)))

(defun pcb-candidate (vecs skip &optional marked)
	;the next of the vectors, the node it moves to as slot_cx cy cz, if it is
	;on the board and not marked, else on to skip. With marked, one marked
	;less than slot_cur, its mark in slot_mark, the backtrack's
	(assign '((:rsp slot_vec_iter)) '(:r0))
	(assign '((:r0 0)) '(:r0))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign `((:r0 0) (:r0 +long_size) (:r0 ,(* 2 +long_size))) '(:r1 :r2 :r3))
	(load-fields :rsp '(slot_nx slot_ny slot_nz) '(:r4 :r5 :r6))
	(vp-add-rr :r4 :r1) (vp-add-rr :r5 :r2) (vp-add-rr :r6 :r3)
	(load-fields :rsp '(slot_w slot_h slot_d) '(:r4 :r5 :r6))
	(gotoif '(:r1 < 0) skip) (gotoif '(:r1 >= :r4) skip)
	(gotoif '(:r2 < 0) skip) (gotoif '(:r2 >= :r5) skip)
	(gotoif '(:r3 < 0) skip) (gotoif '(:r3 >= :r6) skip)
	(save-fields :rsp '(slot_cx slot_cy slot_cz) '(:r1 :r2 :r3))
	(vp-mul-rr :r3 :r5)
	(vp-add-rr :r2 :r5)
	(vp-mul-rr :r4 :r5)
	(vp-add-rr :r1 :r5)
	(vp-shl-cr (log2 +long_size) :r5)
	(assign '((:rsp slot_grid)) '(:r0))
	(vp-add-rr :r5 :r0)
	(assign '((:r0 0)) '(:r0))
	(cond
		(marked
			(gotoif '(:r0 <= 0) skip)
			(assign '((:rsp slot_cur)) '(:r1))
			(gotoif '(:r0 >= :r1) skip)
			(assign '(:r0) '((:rsp slot_mark))))
		(:t (gotoif '(:r0 /= 0) skip)))
	(load-fields :rsp '(slot_cx slot_cy slot_cz) '(:r0 :r1 :r2))
	(pcb-pad))

(defun pcb-vec-list (vecs)
	;the vectors of vecs for the node's layer, (% z 2), as an iter and end
	(assign `((:rsp ,vecs) (:rsp slot_nz)) '(:r0 :r1))
	(vp-and-cr 1 :r1)
	(assign '((:r0 +array_begin)) '(:r0))
	(vp-shl-cr (log2 +ptr_size) :r1)
	(vp-add-rr :r1 :r0)
	(assign '((:r0 0)) '(:r0))
	(class/array/get_both :r0 :r1 :r2)
	(save-fields :rsp '(slot_vec_iter slot_vec_end) '(:r1 :r2)))

(defun pcb-delay-value (&optional at)
	;how many steps more than one a move to slot_cx cy cz, or the node of
	;the locals at, costs, into :r0: (1 + its history) * (1 + pf * the soft
	;tracks it shorts with), as the Lisp of router.inc, (. pcb :step_delay)
	(bind '(x y z) (ifn at '(slot_cx slot_cy slot_cz)))
	(load-fields :rsp '(slot_count slot_pf) '(:r0 :r1))
	(vp-shl-cr +fp_shift :r0)
	(pcb-fmul :r0 :r1)
	(vp-add-cr (<< 1 +fp_shift) :r0)
	(load-fields :rsp (list z 'slot_h y 'slot_w x) '(:r2 :r3 :r4 :r5 :r6))
	(vp-mul-rr :r2 :r3)
	(vp-add-rr :r4 :r3)
	(vp-mul-rr :r5 :r3)
	(vp-add-rr :r6 :r3)
	(vp-shl-cr (log2 +long_size) :r3)
	(assign '((:rsp slot_hist)) '(:r1))
	(vp-add-rr :r3 :r1)
	(assign '((:r1 0)) '(:r1))
	(vp-add-cr 1 :r1)
	(vp-mul-rr :r1 :r0)
	(vp-asr-cr +fp_shift :r0)
	(vp-sub-cr 1 :r0))

(defun pcb-delay (out)
	;the delay of the move, put on the nums out
	(pcb-delay-value)
	(vp-cpy-rr :r0 :r1)
	(call :array :push_back `((:rsp ,out) :r1) '(_ _ _ _)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; a step of the backtrack
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun pcb-back-cost (extra keep)
	;the cost of the step from slot_cx cy cz: its mark, one, the delay of
	;the step at the node, slot_nx ny nz, and extra, a local or :nil. The
	;least so far, the nearest of those as much, is the best, slot_best
	;its place on out_n. Else on to keep
	(pcb-delay-value '(slot_nx slot_ny slot_nz))
	(assign '((:rsp slot_mark)) '(:r1))
	(vp-add-rr :r1 :r0)
	(vp-add-cr 1 :r0)
	(when extra
		(assign `((:rsp ,extra)) '(:r1))
		(vp-add-rr :r1 :r0))
	(load-fields :rsp '(slot_cx slot_nx) '(:r1 :r2))
	(vp-sub-rr :r2 :r1)
	(vp-mul-rr :r1 :r1)
	(each (lambda ((c n))
			(assign `((:rsp ,c) (:rsp ,n)) '(:r2 :r3))
			(vp-sub-rr :r3 :r2)
			(vp-mul-rr :r2 :r2)
			(vp-add-rr :r2 :r1))
		'((slot_cy slot_ny) (slot_cz slot_nz)))
	(load-fields :rsp '(slot_best slot_bcost) '(:r2 :r3))
	(vpif '(:r2 >= 0))
		(gotoif '(:r0 > :r3) keep)
		(vpif '(:r0 = :r3))
			(assign '((:rsp slot_bdist)) '(:r3))
			(gotoif '(:r1 >= :r3) keep)
		(endif)
	(endif)
	(assign '((:rsp slot_idx)) '(:r2))
	(save-fields :rsp '(slot_best slot_bcost slot_bdist) '(:r2 :r0 :r1)))

(defun pcb-back-next ()
	;one more on out_n
	(assign '((:rsp slot_idx)) '(:r0))
	(vp-add-cr 1 :r0)
	(assign '(:r0) '((:rsp slot_idx))))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; the whole flood, one call
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun pcb-heap-routines ()
	;'heap_push :r0 heap nums, :r1 value, and 'heap_pop :r0 heap nums -> :r1
	;the least value, its length more than 0. A binary heap of keys, the
	;least first. Trash :r0-:r7
(vp-label 'heap_push)
	(vp-cpy-rr :r0 :r7)
	(call :array :push_back '(:r0 :r1) '(_ _ _ _))
	(load-fields :r7 '(+array_begin +array_length) '(:r2 :r3))
	(vp-sub-cr 1 :r3)
	(loop-start)
		(breakif '(:r3 = 0))
		(vp-cpy-rr :r3 :r4)
		(vp-sub-cr 1 :r4)
		(vp-shr-cr 1 :r4)
		(vp-cpy-rr :r3 :r5)
		(vp-shl-cr (log2 +long_size) :r5)
		(vp-add-rr :r2 :r5)
		(vp-cpy-rr :r4 :r6)
		(vp-shl-cr (log2 +long_size) :r6)
		(vp-add-rr :r2 :r6)
		(assign '((:r5 0) (:r6 0)) '(:r0 :r1))
		(breakif '(:r1 <= :r0))
		(assign '(:r1 :r0) '((:r5 0) (:r6 0)))
		(vp-cpy-rr :r4 :r3)
	(loop-end)
	(vp-ret)
(vp-label 'heap_pop)
	(vp-cpy-rr :r0 :r7)
	(assign '((:r7 +array_begin)) '(:r2))
	(assign '((:r2 0)) '(:r1))
	(vp-push :r1)
	(call :array :pop_back '(:r7) '(_ :r1))
	(load-fields :r7 '(+array_begin +array_length) '(:r2 :r3))
	(vpif '(:r3 /= 0))
		(assign '(:r1) '((:r2 0)))
		(vp-xor-rr :r4 :r4)
		(loop-start)
			;:r4 the place, :r5 its left, :r6 the least of it and its two
			(vp-cpy-rr :r4 :r5)
			(vp-shl-cr 1 :r5)
			(vp-add-cr 1 :r5)
			(breakif '(:r5 >= :r3))
			(assign '(:r5 :r5) '(:r6 :r0))
			(vp-add-cr 1 :r0)
			(vpif '(:r0 < :r3))
				(vp-cpy-rr :r0 :r1)
				(vp-shl-cr (log2 +long_size) :r1)
				(vp-add-rr :r2 :r1)
				(assign '((:r1 0)) '(:r1))
				(vp-push :r1)
				(vp-cpy-rr :r5 :r1)
				(vp-shl-cr (log2 +long_size) :r1)
				(vp-add-rr :r2 :r1)
				(assign '((:r1 0)) '(:r1))
				(vp-pop :r7)
				(vpif '(:r7 < :r1))
					(vp-cpy-rr :r0 :r6)
				(endif)
			(endif)
			(vp-cpy-rr :r4 :r0)
			(vp-shl-cr (log2 +long_size) :r0)
			(vp-add-rr :r2 :r0)
			(vp-cpy-rr :r6 :r1)
			(vp-shl-cr (log2 +long_size) :r1)
			(vp-add-rr :r2 :r1)
			(assign '((:r0 0) (:r1 0)) '(:r5 :r7))
			(breakif '(:r5 <= :r7))
			(assign '(:r7 :r5) '((:r0 0) (:r1 0)))
			(vp-cpy-rr :r6 :r4)
		(loop-end)
	(endif)
	(vp-pop :r1)
	(vp-ret))

(defun pcb-index ()
	;the index on the board of slot_cx cy cz, into :r0
	(load-fields :rsp '(slot_cz slot_h slot_cy slot_w slot_cx) '(:r0 :r1 :r2 :r3 :r4))
	(vp-mul-rr :r1 :r0)
	(vp-add-rr :r2 :r0)
	(vp-mul-rr :r3 :r0)
	(vp-add-rr :r4 :r0))

(defun pcb-to-front ()
	;the node of index :r0 on the next front, if it is not on it already
	(load-fields :rsp '(slot_stamp slot_gen) '(:r1 :r2))
	(vp-cpy-rr :r0 :r3)
	(vp-shl-cr (log2 +long_size) :r3)
	(vp-add-rr :r3 :r1)
	(assign '((:r1 0)) '(:r3))
	(vpif '(:r3 /= :r2))
		(assign '(:r2) '((:r1 0)))
		(vp-cpy-rr :r0 :r1)
		(call :array :push_back '((:rsp slot_next) :r1) '(_ _ _ _))
	(endif))

(defun pcb-wave-moves (vecs vias)
	;the moves round the node of the front, slot_n*: those that do not short
	;with a hard line, and their delay; a layer move with none to the next
	;front, once, any other on the heap for the distance it is due
	(pcb-vec-list vecs)
	(loop-start)
		(load-fields :rsp '(slot_vec_iter slot_vec_end) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate vecs (if vias 'wv_next 'wl_next))
		(load-fields :rsp (list 'slot_ldata 'slot_px 'slot_py (if vias 'slot_via 'slot_radius) 'slot_gap)
			'(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
				(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(cond
			(vias
				(assign '((:rsp slot_d)) '(:r0))
				(vp-sub-cr 1 :r0)
				(vp-shl-cr +fp_shift :r0)
				(vp-xor-rr :r1 :r1)
				(save-fields :rsp '(slot_zlo slot_zhi) '(:r1 :r0)))
			(:t (assign '((:rsp slot_pz)) '(:r0))
				(vpif '(:r0 > :r2))
					(vp-cpy-rr :r0 :r1) (vp-cpy-rr :r2 :r0) (vp-cpy-rr :r1 :r2)
				(endif)
				(save-fields :rsp '(slot_zlo slot_zhi) '(:r0 :r2))))
		(pcb-new-id)
		(when vias (pcb-hit-layers 'slot_vlayers (if vias 'wv_hit 'wl_hit)))
		(pcb-hit-layers 'slot_layers (if vias 'wv_hit 'wl_hit))
		;the delay, none for the flood of the stochastic router
		(vp-xor-rr :r0 :r0)
		(assign '(:r0 (:rsp slot_mode)) '((:rsp slot_delay) :r0))
		(vpif '(:r0 /= 0))
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:rsp slot_count)))
			(pcb-hit-layers 'slot_soft :count)
			(pcb-delay-value)
			(assign '(:r0) '((:rsp slot_delay)))
		(endif)
		(pcb-index)
		(assign '((:rsp slot_delay)) '(:r1))
		(cond
			(vias
				(assign '((:rsp slot_vs)) '(:r2))
				(vp-add-rr :r2 :r1)
				(vp-shl-cr 32 :r1)
				(vp-add-rr :r0 :r1)
				(assign '((:rsp slot_heap)) '(:r0))
				(vp-call 'heap_push))
			(:t (vpif '(:r1 = 0))
					(pcb-to-front)
				(else)
					(assign '((:rsp slot_dist)) '(:r2))
					(vp-add-rr :r2 :r1)
					(vp-shl-cr 32 :r1)
					(vp-add-rr :r0 :r1)
					(assign '((:rsp slot_heap)) '(:r0))
					(vp-call 'heap_push)
				(endif)))
	(vp-label (if vias 'wv_hit 'wl_hit))
		(call :obj :deref '((:rsp slot_idnum)))
	(vp-label (if vias 'wv_next 'wl_next))
		(assign '((:rsp slot_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp slot_vec_iter)))
	(loop-end))
