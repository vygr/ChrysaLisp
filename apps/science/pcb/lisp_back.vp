(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/fixeds/class.inc")
(include "class/fixed/class.inc")
(include "./flood.inc")

(def-func (path-to-absolute "./flood_back"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(flood-back ctx node path_vecs via_vecs radius gap via vias_cost mode out_n) -> num
	;a step of router.inc's (. net :backtrack_path): the nodes round a node
	;that are marked less than it and do not short with a hard track, a
	;layer away then a via away, onto out_n, as (. pcb :all_not_shorting)
	;of (. pcb :all_marked), and the same of vias. Mode 1, the negotiating
	;router's, it gives the place on out_n of the step the flood took, as
	;(. net :back_step): the least of a mark, one, the delay of the step at
	;the node and a via's cost, the nearest of those as much. Else, or with
	;none, -1

	(structure slot 0
		(ptr this out_n line ldata idnum blist bl rec rec_iter rec_end)
		(ptr vec_iter vec_end vecs vvecs grid didx dpts layers vlayers ctr soft hist)
		(long w h d cw ch scale radius gap via nx ny nz px py pz cx cy cz pf count)
		(long zlo zhi z minx maxx miny maxy row col)
		(long mode vcost cur mark idx best bcost bdist))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 10)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11)
		'(:list :nums :list :list :fixed :fixed :fixed :num :num :list))
	(save-fields :rsp '(slot_vecs slot_vvecs slot_radius slot_gap slot_via slot_vcost slot_mode slot_out_n) '(:r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11))
	(assign '((:r3 +array_begin)) '(:r3))
	(assign `((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size))) '(:r11 :r12 :r13))
	(save-fields :rsp '(slot_nx slot_ny slot_nz) '(:r11 :r12 :r13))
	;the board, (grid didx dpts layers vlayers w h d cw ch scale ctr soft hist pf)
	(assign '((:r2 +array_begin)) '(:r2))
	(each (lambda ((i field kind))
			(assign `((:r2 ,(* i +ptr_size))) '(:r0))
			(case kind
				(:data (assign '((:r0 +array_begin)) '(:r0)))
				(:val (assign '((:r0 +num_value)) '(:r0)))
				(:first (assign '((:r0 +array_begin)) '(:r0)) (assign '((:r0 0)) '(:r0))))
			(assign '(:r0) `((:rsp ,field))))
		'((0 slot_grid :data) (1 slot_didx :data) (2 slot_dpts :data)
			(3 slot_layers :data) (4 slot_vlayers :data) (5 slot_w :val) (6 slot_h :val)
			(7 slot_d :val) (8 slot_cw :val) (9 slot_ch :val) (10 slot_scale :val) (11 slot_ctr :data)
			(12 slot_soft :data) (13 slot_hist :data) (14 slot_pf :first)))
	;the node's own mark, none found yet
	(load-fields :rsp '(slot_nx slot_ny slot_nz slot_w slot_h) '(:r0 :r1 :r2 :r3 :r4))
	(vp-mul-rr :r4 :r2)
	(vp-add-rr :r1 :r2)
	(vp-mul-rr :r3 :r2)
	(vp-add-rr :r0 :r2)
	(vp-shl-cr (log2 +long_size) :r2)
	(assign '((:rsp slot_grid)) '(:r0))
	(vp-add-rr :r2 :r0)
	(assign '((:r0 0)) '(:r0))
	(vp-xor-rr :r1 :r1)
	(vp-cpy-cr -1 :r2)
	(save-fields :rsp '(slot_cur slot_idx slot_best) '(:r0 :r1 :r2))
	(load-fields :rsp '(slot_nx slot_ny slot_nz) '(:r0 :r1 :r2))
	(pcb-pad)
	(save-fields :rsp '(slot_px slot_py slot_pz) '(:r0 :r1 :r2))
	(call :fixeds :create :nil '(:r0))
	(assign '(:r0) '((:rsp slot_line)))
	(times 6 (call :array :push_back '(:r0 0) '(:r0 _ _ _)))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign '(:r0) '((:rsp slot_ldata)))

	;a layer away
	(pcb-vec-list 'slot_vecs)
	(loop-start)
		(load-fields :rsp '(slot_vec_iter slot_vec_end) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'slot_vecs 'back_next :t)
		(load-fields :rsp '(slot_ldata slot_px slot_py slot_radius slot_gap) '(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
				(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp slot_pz)) '(:r0))
		(vpif '(:r0 > :r2))
			(vp-cpy-rr :r0 :r1) (vp-cpy-rr :r2 :r0) (vp-cpy-rr :r1 :r2)
		(endif)
		(save-fields :rsp '(slot_zlo slot_zhi) '(:r0 :r2))
		(pcb-new-id)
		(pcb-hit-layers 'slot_layers 'back_hit)
		(pcb-push-node 'slot_out_n)
		(assign '((:rsp slot_mode)) '(:r0))
		(gotoif '(:r0 = 0) 'back_kept)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp slot_count)))
		(pcb-hit-layers 'slot_soft :count)
		(pcb-back-cost :nil 'back_kept)
	(vp-label 'back_kept)
		(pcb-back-next)
	(vp-label 'back_hit)
		(call :obj :deref '((:rsp slot_idnum)))
	(vp-label 'back_next)
		(assign '((:rsp slot_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp slot_vec_iter)))
	(loop-end)

	;a via away
	(pcb-vec-list 'slot_vvecs)
	(loop-start)
		(load-fields :rsp '(slot_vec_iter slot_vec_end) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'slot_vvecs 'via_next :t)
		(load-fields :rsp '(slot_ldata slot_px slot_py slot_via slot_gap) '(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
				(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp slot_d)) '(:r0))
		(vp-sub-cr 1 :r0)
		(vp-shl-cr +fp_shift :r0)
		(vp-xor-rr :r1 :r1)
		(save-fields :rsp '(slot_zlo slot_zhi) '(:r1 :r0))
		(pcb-new-id)
		(pcb-hit-layers 'slot_vlayers 'via_hit)
		(pcb-hit-layers 'slot_layers 'via_hit)
		(pcb-push-node 'slot_out_n)
		(assign '((:rsp slot_mode)) '(:r0))
		(gotoif '(:r0 = 0) 'via_kept)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp slot_count)))
		(pcb-hit-layers 'slot_soft :count)
		(pcb-back-cost 'slot_vcost 'via_kept)
	(vp-label 'via_kept)
		(pcb-back-next)
	(vp-label 'via_hit)
		(call :obj :deref '((:rsp slot_idnum)))
	(vp-label 'via_next)
		(assign '((:rsp slot_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp slot_vec_iter)))
	(loop-end)

	(call :obj :deref '((:rsp slot_line)))
	(call :num :create '((:rsp slot_best)) '(:r1))
	(assign '((:rsp slot_this)) '(:r0))
	(vp-free slot_size)
	(exit '(:r0 :r1))
	(vp-ret)

	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(flood-back ctx node path_vecs via_vecs radius gap via vias_cost mode out_n)" +error_msg_wrong_types))
	(signature '(:LIST :NUMS :LIST :LIST :FIXED :FIXED :FIXED :NUM :NUM :LIST))

(def-func-end)
