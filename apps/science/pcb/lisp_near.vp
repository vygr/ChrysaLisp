(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/fixeds/class.inc")
(include "class/fixed/class.inc")
(include "./flood.inc")

(def-func (path-to-absolute "./flood_near"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(flood-near ctx node flood_vecs via_vecs radius gap via out_n out_v) -> out_n
	;the nodes round a node of the flood that are on the board, not marked,
	;and do not short with a track: those a layer away onto out_n, those a
	;via away onto out_v, as the Lisp of router.inc, (. pcb :all_not_shorting)
	;of (. pcb :all_not_marked), and the same of vias. ctx is (. pcb :flood_ctx)

	(structure slot 0
		(ptr this out_n out_v line ldata idnum blist bl rec rec_iter rec_end)
		(ptr vec_iter vec_end vecs vvecs grid didx dpts layers vlayers ctr)
		(long w h d cw ch scale radius gap via nx ny nz px py pz cx cy cz)
		(long zlo zhi z minx maxx miny maxy row col))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 9)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10)
		'(:list :nums :list :list :fixed :fixed :fixed :list :list))
	(save-fields :rsp '(slot_vecs slot_vvecs slot_radius slot_gap slot_via slot_out_n slot_out_v) '(:r4 :r5 :r6 :r7 :r8 :r9 :r10))
	;the node, and its point
	(assign '((:r3 +array_begin)) '(:r3))
	(assign `((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size))) '(:r11 :r12 :r13))
	(save-fields :rsp '(slot_nx slot_ny slot_nz) '(:r11 :r12 :r13))
	;the board, (grid didx dpts layers vlayers w h d cw ch scale ctr)
	(assign '((:r2 +array_begin)) '(:r2))
	(each (lambda ((i field kind))
			(assign `((:r2 ,(* i +ptr_size))) '(:r0))
			(case kind
				(:data (assign '((:r0 +array_begin)) '(:r0)))
				(:val (assign '((:r0 +num_value)) '(:r0))))
			(assign '(:r0) `((:rsp ,field))))
		'((0 slot_grid :data) (1 slot_didx :data) (2 slot_dpts :data)
			(3 slot_layers :data) (4 slot_vlayers :data) (5 slot_w :val) (6 slot_h :val)
			(7 slot_d :val) (8 slot_cw :val) (9 slot_ch :val) (10 slot_scale :val) (11 slot_ctr :data)))
	(load-fields :rsp '(slot_nx slot_ny slot_nz) '(:r0 :r1 :r2))
	(pcb-pad)
	(save-fields :rsp '(slot_px slot_py slot_pz) '(:r0 :r1 :r2))
	;the line looked with, its points and radius and gap put in each time
	(call :fixeds :create :nil '(:r0))
	(assign '(:r0) '((:rsp slot_line)))
	(times 6 (call :array :push_back '(:r0 0) '(:r0 _ _ _)))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign '(:r0) '((:rsp slot_ldata)))

	;a layer away
	(pcb-vec-list 'slot_vecs)
	(loop-start)
		(load-fields :rsp '(slot_vec_iter slot_vec_end) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'slot_vecs 'flood_next)
		(load-fields :rsp '(slot_ldata slot_px slot_py slot_radius slot_gap) '(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
				(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp slot_pz)) '(:r0))
		(vpif '(:r0 > :r2))
			(vp-cpy-rr :r0 :r1) (vp-cpy-rr :r2 :r0) (vp-cpy-rr :r1 :r2)
		(endif)
		(save-fields :rsp '(slot_zlo slot_zhi) '(:r0 :r2))
		(pcb-new-id)
		(pcb-hit-layers 'slot_layers 'flood_hit)
		(pcb-push-node 'slot_out_n)
	(vp-label 'flood_hit)
		(call :obj :deref '((:rsp slot_idnum)))
	(vp-label 'flood_next)
		(assign '((:rsp slot_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp slot_vec_iter)))
	(loop-end)

	;a via away, from the top layer at this point to the bottom at that
	(pcb-vec-list 'slot_vvecs)
	(loop-start)
		(load-fields :rsp '(slot_vec_iter slot_vec_end) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'slot_vvecs 'via_next)
		(load-fields :rsp '(slot_ldata slot_px slot_py slot_via slot_gap) '(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
				(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp slot_d)) '(:r0))
		(vp-sub-cr 1 :r0)
		(vp-shl-cr +fp_shift :r0)
		(vp-xor-rr :r1 :r1)
		(save-fields :rsp '(slot_zlo slot_zhi) '(:r1 :r0))
		(pcb-new-id)
		(pcb-hit-layers 'slot_vlayers 'via_hit)
		(pcb-hit-layers 'slot_layers 'via_hit)
		(pcb-push-node 'slot_out_v)
	(vp-label 'via_hit)
		(call :obj :deref '((:rsp slot_idnum)))
	(vp-label 'via_next)
		(assign '((:rsp slot_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp slot_vec_iter)))
	(loop-end)

	(call :obj :deref '((:rsp slot_line)))
	(assign '((:rsp slot_out_n)) '(:r1))
	(class/obj/ref :r1 :r2)
	(assign '((:rsp slot_this)) '(:r0))
	(vp-free slot_size)
	(exit '(:r0 :r1))
	(vp-ret)

	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(flood-near ctx node flood_vecs via_vecs radius gap via out_n out_v)" +error_msg_wrong_types))
	(signature '(:LIST :NUMS :LIST :LIST :FIXED :FIXED :FIXED :LIST :LIST))

(def-func-end)
