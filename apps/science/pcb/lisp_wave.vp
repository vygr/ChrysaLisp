(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/fixeds/class.inc")
(include "class/fixed/class.inc")
(include "./flood.inc")

(def-func (path-to-absolute "./flood_wave"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(flood-wave ctx starts ends flood_vecs via_vecs radius gap via vias_cost mode) -> :t
	;the flood of router.inc's (. pcb :mark_distances), all of it: the
	;nodes of the board marked with how far they are from the starts, till
	;every end is, or no more can be. starts and ends are nums of indexes on
	;the board. mode 0, a move is refused if it shorts with a track and a
	;via waits its cost; mode 1, the negotiating router's, (flood-cost)
	;moves and their delays. A node is on a front once, by a stamp of that
	;front, and a move that waits is on a heap of its distance and index

	(structure slot 0
		(ptr this line ldata idnum blist bl rec rec_iter rec_end starts ends)
		(ptr vec_iter vec_end vecs vvecs grid didx dpts layers vlayers ctr soft hist)
		(ptr stamp heap front next fiter fend genp)
		(long w h d cw ch scale radius gap via nx ny nz px py pz cx cy cz pf count)
		(long zlo zhi z minx maxx miny maxy row col)
		(long mode vcost dist vs gen delay))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 10)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11)
		'(:list :nums :nums :list :list :fixed :fixed :fixed :num :num))
	(save-fields :rsp '(slot_starts slot_ends slot_vecs slot_vvecs slot_radius slot_gap slot_via slot_vcost slot_mode) '(:r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11))
	;the board, (grid didx dpts layers vlayers w h d cw ch scale ctr soft
	;hist pf stamp gen heap front next)
	(assign '((:r2 +array_begin)) '(:r2))
	(each (lambda ((i field kind))
			(assign `((:r2 ,(* i +ptr_size))) '(:r0))
			(case kind
				(:data (assign '((:r0 +array_begin)) '(:r0)))
				(:val (assign '((:r0 +num_value)) '(:r0)))
				(:first (assign '((:r0 +array_begin)) '(:r0)) (assign '((:r0 0)) '(:r0))))
			(assign '(:r0) `((:rsp ,field))))
		'((0 slot_grid :data) (1 slot_didx :data) (2 slot_dpts :data)
			(3 slot_layers :data) (4 slot_vlayers :data) (5 slot_w :val) (6 slot_h :val)
			(7 slot_d :val) (8 slot_cw :val) (9 slot_ch :val) (10 slot_scale :val) (11 slot_ctr :data)
			(12 slot_soft :data) (13 slot_hist :data) (14 slot_pf :first) (15 slot_stamp :data)
			(16 slot_genp :data) (17 slot_heap :obj) (18 slot_front :obj) (19 slot_next :obj)))
	(call :fixeds :create :nil '(:r0))
	(assign '(:r0) '((:rsp slot_line)))
	(times 6 (call :array :push_back '(:r0 0) '(:r0 _ _ _)))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign '(:r0) '((:rsp slot_ldata)))
	;the first front, the starts
	(each (lambda (f)
			(call :array :set_length `((:rsp ,f) 0) '(_ _)))
		'(slot_heap slot_front slot_next))
	(assign '((:rsp slot_starts)) '(:r0))
	(class/array/get_both :r0 :r1 :r2)
	(save-fields :rsp '(slot_fiter slot_fend) '(:r1 :r2))
	(loop-start)
		(load-fields :rsp '(slot_fiter slot_fend) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(assign '((:r0 0)) '(:r1))
		(vp-add-cr +long_size :r0)
		(assign '(:r0 (:rsp slot_front)) '((:rsp slot_fiter) :r0))
		(call :array :push_back '(:r0 :r1) '(_ _ _ _))
	(loop-end)
	(vp-cpy-cr 1 :r0)
	(assign '(:r0) '((:rsp slot_dist)))

	(loop-start 'wave)
		(call :sys_task :slice)
		;nothing at the front and nothing waiting, done
		(load-fields :rsp '(slot_front slot_heap) '(:r0 :r1))
		(assign '((:r0 +array_length) (:r1 +array_length)) '(:r0 :r1))
		(vp-or-rr :r1 :r0)
		(breakif '(:r0 = 0))
		;the front marked
		(assign '((:rsp slot_front)) '(:r0))
		(class/array/get_both :r0 :r1 :r2)
		(load-fields :rsp '(slot_grid slot_dist) '(:r3 :r4))
		(loop-start)
			(breakif '(:r1 = :r2))
			(assign '((:r1 0)) '(:r0))
			(vp-shl-cr (log2 +long_size) :r0)
			(vp-add-rr :r3 :r0)
			(assign '(:r4) '((:r0 0)))
			(vp-add-cr +long_size :r1)
		(loop-end)
		;every end marked, done
		(assign '((:rsp slot_ends)) '(:r0))
		(class/array/get_both :r0 :r1 :r2)
		(loop-start)
			(breakif '(:r1 = :r2) 'wave)
			(assign '((:r1 0)) '(:r0))
			(vp-shl-cr (log2 +long_size) :r0)
			(vp-add-rr :r3 :r0)
			(assign '((:r0 0)) '(:r0))
			(breakif '(:r0 = 0))
			(vp-add-cr +long_size :r1)
		(loop-end)
		;the next front, its stamp new
		(assign '((:rsp slot_genp)) '(:r0))
		(assign '((:r0 0)) '(:r1))
		(vp-add-cr 1 :r1)
		(assign '(:r1 :r1) '((:r0 0) (:rsp slot_gen)))
		(load-fields :rsp '(slot_dist slot_vcost) '(:r0 :r1))
		(vp-add-rr :r0 :r1)
		(assign '(:r1 (:rsp slot_front)) '((:rsp slot_vs) :r0))
		(class/array/get_both :r0 :r1 :r2)
		(save-fields :rsp '(slot_fiter slot_fend) '(:r1 :r2))
		(loop-start)
			(load-fields :rsp '(slot_fiter slot_fend) '(:r0 :r1))
			(breakif '(:r0 = :r1))
			;the node, and its point
			(assign '((:r0 0) (:rsp slot_w) (:rsp slot_h)) '(:r0 :r3 :r4))
			(vp-cpy-rr :r0 :r2)
			(vp-rem-rr-u :r3 :r2)
			(vp-div-rr-u :r3 :r0)
			(assign '(:r2) '((:rsp slot_nx)))
			(vp-cpy-rr :r0 :r2)
			(vp-rem-rr-u :r4 :r2)
			(vp-div-rr-u :r4 :r0)
			(save-fields :rsp '(slot_ny slot_nz) '(:r2 :r0))
			(load-fields :rsp '(slot_nx slot_ny slot_nz) '(:r0 :r1 :r2))
			(pcb-pad)
			(save-fields :rsp '(slot_px slot_py slot_pz) '(:r0 :r1 :r2))
			(pcb-wave-moves 'slot_vecs :nil)
			(pcb-wave-moves 'slot_vvecs :t)
			(assign '((:rsp slot_fiter)) '(:r0))
			(vp-add-cr +long_size :r0)
			(assign '(:r0) '((:rsp slot_fiter)))
		(loop-end)
		;those waiting that are due, to the next front if not marked
		(loop-start)
			(assign '((:rsp slot_heap)) '(:r0))
			(assign '((:r0 +array_length)) '(:r1))
			(breakif '(:r1 = 0))
			(assign '((:r0 +array_begin)) '(:r1))
			(assign '((:r1 0)) '(:r1))
			(vp-shr-cr 32 :r1)
			(assign '((:rsp slot_dist)) '(:r2))
			(breakif '(:r1 > :r2))
			(vp-call 'heap_pop)
			(vp-cpy-cr 0xffffffff :r0)
			(vp-and-rr :r1 :r0)
			(assign '((:rsp slot_grid)) '(:r1))
			(vp-cpy-rr :r0 :r2)
			(vp-shl-cr (log2 +long_size) :r2)
			(vp-add-rr :r2 :r1)
			(assign '((:r1 0)) '(:r1))
			(vpif '(:r1 = 0))
				(pcb-to-front)
			(endif)
		(loop-end)
		;the next front is the front, at the next distance
		(load-fields :rsp '(slot_front slot_next) '(:r0 :r1))
		(save-fields :rsp '(slot_front slot_next) '(:r1 :r0))
		(call :array :set_length '(:r0 0) '(_ _))
		(assign '((:rsp slot_dist)) '(:r0))
		(vp-add-cr 1 :r0)
		(assign '(:r0) '((:rsp slot_dist)))
		;nothing at the front, on to the next distance one waits for
		(load-fields :rsp '(slot_front slot_heap) '(:r0 :r1))
		(assign '((:r0 +array_length) (:r1 +array_length)) '(:r2 :r3))
		(vpif '(:r2 = 0) '(:r3 /= 0))
			(assign '((:r1 +array_begin)) '(:r1))
			(assign '((:r1 0)) '(:r1))
			(vp-shr-cr 32 :r1)
			(assign '((:rsp slot_dist)) '(:r0))
			(vpif '(:r1 > :r0))
				(assign '(:r1) '((:rsp slot_dist)))
			(endif)
		(endif)
	(loop-end)

	(call :obj :deref '((:rsp slot_line)))
	(assign '((:rsp slot_this)) '(:r0))
	(assign '((:r0 +lisp_sym_t)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free slot_size)
	(exit '(:r0 :r1))
	(vp-ret)

	(pcb-heap-routines)
	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(flood-wave ctx starts ends flood_vecs via_vecs radius gap via vias_cost mode)" +error_msg_wrong_types))
	(signature '(:LIST :NUMS :NUMS :LIST :LIST :FIXED :FIXED :FIXED :NUM :NUM))

(def-func-end)
