(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "class/fixeds/class.inc")
(include "class/nums/class.inc")
(include "class/fixed/class.inc")

;fixed point as the Lisp of layer.inc has it, (hit-line?): a product is
;shifted down after it is made, a dot is the sum of such, a quotient is of
;the dividend shifted up, so what this finds is what that finds
(defun pcb-fmul (a b)
	;a = a * b
	(vp-mul-rr b a)
	(vp-asr-cr +fp_shift a))

(defun pcb-fdot (x1 y1 x2 y2 t)
	;x1 = x1 * x2 + y1 * y2, t trashed
	(pcb-fmul x1 x2)
	(vp-cpy-rr y1 t)
	(pcb-fmul t y2)
	(vp-add-rr t x1))

(defun pcb-collide ()
	;the routines collide and sdist, into the function this is called in
	(vp-label 'collide)
		;inputs
		;:r13 = line fixeds (ptr)
		;:r1 = record list (ptr)
		;outputs
		;:r0 = 0 if clear, else hit
		;trashes
		;:r0-:r13
		;info
		;(hit-line?) of layer.inc: the record is (id layer_line p1 p2 norm dist)

		(assign '((:r13 +array_begin) (:r1 +array_begin)) '(:r13 :r1))
		(assign `((:r1 ,(* 1 +ptr_size)) (:r1 ,(* 4 +ptr_size)) (:r1 ,(* 5 +ptr_size))) '(:r12 :r10 :r9))
		(assign '((:r12 +array_begin) (:r10 +array_begin) (:r9 +num_value)) '(:r12 :r10 :r9))
		;d, both radii and the larger gap
		(assign `((:r13 ,(* 4 +long_size)) (:r12 ,(* 4 +long_size))
			(:r13 ,(* 5 +long_size)) (:r12 ,(* 5 +long_size))) '(:r11 :r0 :r1 :r2))
		(vp-add-rr :r0 :r11)
		(vpif '(:r2 > :r1))
			(vp-cpy-rr :r2 :r1)
		(endif)
		(vp-add-rr :r1 :r11)
		;how far each end of the line is across the record's
		(assign '((:r10 0) (:r10 +long_size)) '(:r0 :r1))
		(assign '((:r13 0) (:r13 +long_size)) '(:r2 :r3))
		(vp-cpy-rr :r0 :r4) (vp-cpy-rr :r1 :r5)
		(pcb-fdot :r4 :r5 :r2 :r3 :r6)
		(vp-sub-rr :r9 :r4)
		(assign `((:r13 ,(* 2 +long_size)) (:r13 ,(* 3 +long_size))) '(:r2 :r3))
		(pcb-fdot :r0 :r1 :r2 :r3 :r6)
		(vp-sub-rr :r9 :r0)
		;both beyond one side, clear
		(vpif '(:r4 > :r11) '(:r0 > :r11))
			(vp-xor-rr :r0 :r0)
			(vp-ret)
		(endif)
		(vp-cpy-rr :r11 :r6)
		(vp-mul-cr -1 :r6)
		(vpif '(:r4 < :r6) '(:r0 < :r6))
			(vp-xor-rr :r0 :r0)
			(vp-ret)
		(endif)
		;the lines cross, (vector-collide-lines-2d)
		(assign `((:r13 0) (:r13 +long_size) (:r13 ,(* 2 +long_size)) (:r13 ,(* 3 +long_size))) '(:r6 :r7 :r0 :r1))
		(vp-sub-rr :r6 :r0) (vp-sub-rr :r7 :r1)
		(assign `((:r12 0) (:r12 +long_size) (:r12 ,(* 2 +long_size)) (:r12 ,(* 3 +long_size))) '(:r2 :r3 :r4 :r5))
		(vp-sub-rr :r4 :r2) (vp-sub-rr :r5 :r3)
		(vp-mul-cr -1 :r2) (vp-mul-cr -1 :r3)
		(vp-sub-rr :r6 :r4) (vp-sub-rr :r7 :r5)
		;av :r0 :r1, bv :r2 :r3, cv :r4 :r5
		(vp-cpy-rr :r0 :r6) (pcb-fmul :r6 :r3) (vp-cpy-rr :r1 :r9) (pcb-fmul :r9 :r2) (vp-sub-rr :r9 :r6)
		(vp-cpy-rr :r0 :r7) (pcb-fmul :r7 :r5) (vp-cpy-rr :r1 :r9) (pcb-fmul :r9 :r4) (vp-sub-rr :r9 :r7)
		(vp-cpy-rr :r4 :r8) (pcb-fmul :r8 :r3) (vp-cpy-rr :r5 :r9) (pcb-fmul :r9 :r2) (vp-sub-rr :r9 :r8)
		;axb :r6, axc :r7, cxb :r8
		(vpif '(:r6 > 0) '(:r7 >= 0) '(:r7 <= :r6) '(:r8 >= 0) '(:r8 <= :r6))
			(vp-cpy-cr 1 :r0)
			(vp-ret)
		(elseif '(:r6 < 0) '(:r7 <= 0) '(:r7 >= :r6) '(:r8 <= 0) '(:r8 >= :r6))
			(vp-cpy-cr 1 :r0)
			(vp-ret)
		(endif)
		;then any end within d of the other line, (vector-sdist-to-line)
		(pcb-fmul :r11 :r11)
		(each (lambda ((p s))
			(assign `((,p 0) (,p +long_size) (,s 0) (,s +long_size) (,s ,(* 2 +long_size)) (,s ,(* 3 +long_size)))
				'(:r0 :r1 :r2 :r3 :r4 :r5))
			(vp-call 'sdist)
			(vpif '(:r0 <= :r11))
				(vp-cpy-cr 1 :r0)
				(vp-ret)
			(endif)
			(assign `((,p ,(* 2 +long_size)) (,p ,(* 3 +long_size)) (,s 0) (,s +long_size) (,s ,(* 2 +long_size)) (,s ,(* 3 +long_size)))
				'(:r0 :r1 :r2 :r3 :r4 :r5))
			(vp-call 'sdist)
			(vpif '(:r0 <= :r11))
				(vp-cpy-cr 1 :r0)
				(vp-ret)
			(endif)) '((:r12 :r13) (:r13 :r12)))
		(vp-xor-rr :r0 :r0)
		(vp-ret)

	(vp-label 'sdist)
		;inputs
		;:r0 :r1 = point
		;:r2 :r3 = line start, :r4 :r5 = line end
		;outputs
		;:r0 = the square of the distance from the point to the line, as a
		;fixed
		;trashes
		;:r0-:r10
		(vp-sub-rr :r2 :r4) (vp-sub-rr :r3 :r5)
		(vp-cpy-rr :r0 :r6) (vp-cpy-rr :r1 :r7)
		(vp-sub-rr :r2 :r6) (vp-sub-rr :r3 :r7)
		(pcb-fdot :r6 :r7 :r4 :r5 :r8)
		(vpif '(:r6 <= 0))
			(vp-sub-rr :r2 :r0) (vp-sub-rr :r3 :r1)
		(else)
			(vp-cpy-rr :r4 :r8) (vp-cpy-rr :r5 :r9)
			(pcb-fdot :r8 :r9 :r4 :r5 :r10)
			(vpif '(:r8 <= :r6))
				(vp-add-rr :r4 :r2) (vp-add-rr :r5 :r3)
				(vp-sub-rr :r2 :r0) (vp-sub-rr :r3 :r1)
			(else)
				(vp-shl-cr +fp_shift :r6)
				(vp-ext-rr :r6 :r9)
				(vp-div-rrr :r8 :r9 :r6)
				(pcb-fmul :r4 :r6) (pcb-fmul :r5 :r6)
				(vp-add-rr :r4 :r2) (vp-add-rr :r5 :r3)
				(vp-sub-rr :r2 :r0) (vp-sub-rr :r3 :r1)
			(endif)
		(endif)
		(vp-mul-cr -1 :r0) (vp-mul-cr -1 :r1)
		(vp-cpy-rr :r0 :r2) (vp-cpy-rr :r1 :r3)
		(pcb-fdot :r0 :r1 :r2 :r3 :r4)
		(vp-ret))

(def-func (path-to-absolute "./hit_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :f0-:f15
	;info
	;does the line, (x1 y1 x2 y2 radius gap) fixeds, come within the
	;radius and gap of a record in the buckets, not looked at yet for this
	;id. Each record looked at is marked with the id

	(def-vars
		(ptr this buckets line hit record rec_id num_id)
		(pptr record_iter record_iter_end)
		(pptr buckets_iter buckets_iter_end)
		(int minx miny maxx maxy width))

	(push-scope)
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 8)

	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8)
		'(:list :num :num :num :num :num :obj :fixeds))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8)
		(vpx this buckets minx miny maxx maxy width num_id line))

	(assign (vpx (* miny width) (* maxy width)) (vpx miny maxy))
	(loop-start)
		(call :list :get_iters (vpx buckets (+ minx miny) (+ maxx miny)) (vpx _ buckets_iter buckets_iter_end))
		(loop-start)
			(call :list :get_both (vpx (* buckets_iter)) (vpx _ record_iter record_iter_end))
			(loop-while (vpx (/= record_iter record_iter_end)))
				(assign (vpx (* record_iter)) (vpx record))
				(call :list :get_elem (vpx record 0) (vpx _ rec_id))
				(vpif (vpx (/= rec_id num_id)))
					(call :num :ref (vpx num_id))
					(call :list :set_elem (vpx record num_id 0))
					(assign (vpx line record) '(:r13 :r1))
					(vp-call 'collide)
					(gotoif '(:r0 /= 0) 'hit)
				(endif)
				(assign (vpx (+ record_iter +ptr_size)) (vpx record_iter))
			(loop-end)
		(loop-until (vpx (> (=> (+ buckets_iter +ptr_size) buckets_iter) buckets_iter_end)))
	(loop-until (vpx (> (=> (+ miny width) miny) maxy)))
	(call :obj :ref (vpx (.> this +lisp_sym_nil)) (vpx hit))
	(exit (vpx this hit))
	(return)

(vp-label 'hit)
	(call :obj :ref (vpx (.> this +lisp_sym_t)) (vpx hit))
	(exit (vpx this hit))
	(return)

	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(hit-line buckets minx miny maxx maxy width id line)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :NUM :FIXEDS))

	(pop-scope-syms)

(def-func-end)

(defun pcb-pad ()
	;the point of the node :r0 :r1 :r2, ints, as fixeds into :r0 :r1 :r2: a pad's
	;own point if the board has one for it, else the node's. Trashes :r3-:r5
	(assign '((:rsp local_h) (:rsp local_w)) '(:r3 :r4))
	(vp-mul-rr :r2 :r3)
	(vp-add-rr :r1 :r3)
	(vp-mul-rr :r4 :r3)
	(vp-add-rr :r0 :r3)
	(assign '((:rsp local_didx)) '(:r4))
	(vp-shl-cr (log2 +long_size) :r3)
	(vp-add-rr :r3 :r4)
	(assign '((:r4 0)) '(:r4))
	(vpif '(:r4 = 0))
		(vp-shl-cr +fp_shift :r0)
		(vp-shl-cr +fp_shift :r1)
		(vp-shl-cr +fp_shift :r2)
	(else)
		(vp-sub-cr 1 :r4)
		(vp-mul-cr (* 3 +long_size) :r4)
		(assign '((:rsp local_dpts)) '(:r5))
		(vp-add-rr :r5 :r4)
		(assign `((:r4 0) (:r4 +long_size) (:r4 ,(* 2 +long_size))) '(:r0 :r1 :r2))
	(endif))

(defun pcb-hit-layers (blist hit)
	;does the line of local_ldata short with any track of the layers zlo to
	;zhi of blist, a list of the bucket lists of each layer: jumps to hit
	;if so, as (. layers :hit_line) in layer.inc, (. layer :aabb) for the
	;buckets of each. With hit :count, how many it shorts with is added to
	;local_count, and it goes on
	(assign '((:rsp local_zlo)) '(:r0))
	(assign '(:r0) '((:rsp local_z)))
	(loop-start)
		(assign '((:rsp local_z) (:rsp local_zhi)) '(:r0 :r1))
		(breakif '(:r0 > :r1))
		(vp-asr-cr +fp_shift :r0)
		(vp-shl-cr (log2 +ptr_size) :r0)
		(assign `((:rsp ,blist)) '(:r1))
		(vp-add-rr :r0 :r1)
		(assign '((:r1 0)) '(:r1))
		(assign '((:r1 +array_begin)) '(:r1))
		(assign '(:r1) '((:rsp local_bl)))
		;the cells the line and its radius and gap cover
		(assign '((:rsp local_ldata)) '(:r0))
		(assign `((:r0 ,(* 4 +long_size)) (:r0 ,(* 5 +long_size))) '(:r6 :r7))
		(vp-add-rr :r7 :r6)
		(assign '((:rsp local_scale)) '(:r7))
		(each (lambda ((a b lo hi size))
			(assign `((:r0 ,(* a +long_size)) (:r0 ,(* b +long_size))) '(:r1 :r2))
			(vpif '(:r1 > :r2))
				(vp-cpy-rr :r1 :r3) (vp-cpy-rr :r2 :r1) (vp-cpy-rr :r3 :r2)
			(endif)
			(vp-sub-rr :r6 :r1) (vp-add-rr :r6 :r2)
			(pcb-fmul :r1 :r7) (pcb-fmul :r2 :r7)
			(vp-asr-cr +fp_shift :r1) (vp-asr-cr +fp_shift :r2)
			(assign `((:rsp ,size)) '(:r3))
			(vp-sub-cr 1 :r3)
			(each (lambda (r)
				(vpif `(,r < 0))
					(vp-xor-rr r r)
				(endif)
				(vpif `(,r > :r3))
					(vp-cpy-rr :r3 r)
				(endif)) '(:r1 :r2))
			(assign '(:r1 :r2) `((:rsp ,lo) (:rsp ,hi))))
			'((0 2 local_minx local_maxx local_cw) (1 3 local_miny local_maxy local_ch)))
		(assign '((:rsp local_miny)) '(:r0))
		(assign '(:r0) '((:rsp local_row)))
		(loop-start)
			(assign '((:rsp local_row) (:rsp local_maxy)) '(:r0 :r1))
			(breakif '(:r0 > :r1))
			(assign '((:rsp local_minx)) '(:r0))
			(assign '(:r0) '((:rsp local_col)))
			(loop-start)
				(assign '((:rsp local_col) (:rsp local_maxx)) '(:r0 :r1))
				(breakif '(:r0 > :r1))
				(assign '((:rsp local_row) (:rsp local_cw) (:rsp local_bl)) '(:r1 :r2 :r3))
				(vp-mul-rr :r2 :r1)
				(vp-add-rr :r0 :r1)
				(vp-shl-cr (log2 +ptr_size) :r1)
				(vp-add-rr :r3 :r1)
				(assign '((:r1 0)) '(:r1))
				(class/array/get_both :r1 :r2 :r3)
				(assign '(:r2 :r3) '((:rsp local_rec_iter) (:rsp local_rec_end)))
				(loop-start)
					(assign '((:rsp local_rec_iter) (:rsp local_rec_end)) '(:r0 :r1))
					(breakif '(:r0 = :r1))
					(assign '((:r0 0) (:rsp local_idnum)) '(:r1 :r2))
					(assign '((:r1 +array_begin)) '(:r3))
					(assign '((:r3 0)) '(:r3))
					(vpif '(:r3 /= :r2))
						(assign '(:r1) '((:rsp local_rec)))
						(call :num :ref '(:r2))
						(assign '((:rsp local_rec) (:rsp local_idnum)) '(:r0 :r1))
						(call :list :set_elem '(:r0 :r1 0))
						(assign '((:rsp local_line) (:rsp local_rec)) '(:r13 :r1))
						(vp-call 'collide)
						(cond
							((eql hit :count)
								(vpif '(:r0 /= 0))
									(assign '((:rsp local_count)) '(:r0))
									(vp-add-cr 1 :r0)
									(assign '(:r0) '((:rsp local_count)))
								(endif))
							(:t (gotoif '(:r0 /= 0) hit)))
					(endif)
					(assign '((:rsp local_rec_iter)) '(:r0))
					(vp-add-cr +ptr_size :r0)
					(assign '(:r0) '((:rsp local_rec_iter)))
				(loop-end)
				(assign '((:rsp local_col)) '(:r0))
				(vp-add-cr 1 :r0)
				(assign '(:r0) '((:rsp local_col)))
			(loop-end)
			(assign '((:rsp local_row)) '(:r0))
			(vp-add-cr 1 :r0)
			(assign '(:r0) '((:rsp local_row)))
		(loop-end)
		(assign '((:rsp local_z)) '(:r0))
		(vp-add-cr (<< 1 +fp_shift) :r0)
		(assign '(:r0) '((:rsp local_z)))
	(loop-end))

(defun pcb-new-id ()
	;a num for this line's look, made new so no track is taken as looked at
	;already: its value one less than the last, as the Lisp's are above 0
	(assign '((:rsp local_ctr)) '(:r1))
	(assign '((:r1 0)) '(:r0))
	(vp-sub-cr 1 :r0)
	(assign '(:r0) '((:r1 0)))
	(call :num :create '(:r0) '(:r0))
	(assign '(:r0) '((:rsp local_idnum))))

(defun pcb-push-node (out)
	;a nums of local_cx cy cz on the list out
	(call :nums :create :nil '(:r0))
	(each (lambda (v)
		(assign `((:rsp ,v)) '(:r1))
		(call :array :push_back '(:r0 :r1) '(:r0 _ _ _))) '(local_cx local_cy local_cz))
	(vp-cpy-rr :r0 :r1)
	(assign `((:rsp ,out)) '(:r0))
	(call :list :push_back '(:r0 :r1) '(_ _ _ _)))

(defun pcb-candidate (vecs skip)
	;the next of the vectors, the node it moves to as local_cx cy cz, if it is
	;on the board and not marked, else on to skip
	(assign '((:rsp local_vec_iter)) '(:r0))
	(assign '((:r0 0)) '(:r0))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign `((:r0 0) (:r0 +long_size) (:r0 ,(* 2 +long_size))) '(:r1 :r2 :r3))
	(assign '((:rsp local_nx) (:rsp local_ny) (:rsp local_nz)) '(:r4 :r5 :r6))
	(vp-add-rr :r4 :r1) (vp-add-rr :r5 :r2) (vp-add-rr :r6 :r3)
	(assign '((:rsp local_w) (:rsp local_h) (:rsp local_d)) '(:r4 :r5 :r6))
	(gotoif '(:r1 < 0) skip) (gotoif '(:r1 >= :r4) skip)
	(gotoif '(:r2 < 0) skip) (gotoif '(:r2 >= :r5) skip)
	(gotoif '(:r3 < 0) skip) (gotoif '(:r3 >= :r6) skip)
	(assign '(:r1 :r2 :r3) '((:rsp local_cx) (:rsp local_cy) (:rsp local_cz)))
	(vp-mul-rr :r3 :r5)
	(vp-add-rr :r2 :r5)
	(vp-mul-rr :r4 :r5)
	(vp-add-rr :r1 :r5)
	(vp-shl-cr (log2 +long_size) :r5)
	(assign '((:rsp local_grid)) '(:r0))
	(vp-add-rr :r5 :r0)
	(assign '((:r0 0)) '(:r0))
	(gotoif '(:r0 /= 0) skip)
	(assign '((:rsp local_cx) (:rsp local_cy) (:rsp local_cz)) '(:r0 :r1 :r2))
	(pcb-pad))

(defun pcb-vec-list (vecs)
	;the vectors of vecs for the node's layer, (% z 2), as an iter and end
	(assign `((:rsp ,vecs) (:rsp local_nz)) '(:r0 :r1))
	(vp-and-cr 1 :r1)
	(assign '((:r0 +array_begin)) '(:r0))
	(vp-shl-cr (log2 +ptr_size) :r1)
	(vp-add-rr :r1 :r0)
	(assign '((:r0 0)) '(:r0))
	(class/array/get_both :r0 :r1 :r2)
	(assign '(:r1 :r2) '((:rsp local_vec_iter) (:rsp local_vec_end))))

(def-func (path-to-absolute "./flood_near"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(flood-near ctx node flood_vecs via_vecs radius gap via out_n out_v) -> out_n
	;the nodes round a node of the flood that are on the board, not marked,
	;and do not short with a track: those a layer away onto out_n, those a
	;via away onto out_v, as the Lisp of router.inc, (. pcb :all_not_shorting)
	;of (. pcb :all_not_marked), and the same of vias. ctx is (. pcb :flood_ctx)

	(structure local 0
		(ptr this out_n out_v line ldata idnum blist bl rec rec_iter rec_end)
		(ptr vec_iter vec_end vecs vvecs grid didx dpts layers vlayers ctr)
		(long w h d cw ch scale radius gap via nx ny nz px py pz cx cy cz)
		(long zlo zhi z minx maxx miny maxy row col))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 9)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10)
		'(:list :nums :list :list :fixed :fixed :fixed :list :list))
	(assign '(:r4 :r5 :r6 :r7 :r8 :r9 :r10)
		'((:rsp local_vecs) (:rsp local_vvecs) (:rsp local_radius) (:rsp local_gap)
		(:rsp local_via) (:rsp local_out_n) (:rsp local_out_v)))
	;the node, and its point
	(assign '((:r3 +array_begin)) '(:r3))
	(assign `((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size))) '(:r11 :r12 :r13))
	(assign '(:r11 :r12 :r13) '((:rsp local_nx) (:rsp local_ny) (:rsp local_nz)))
	;the board, (grid didx dpts layers vlayers w h d cw ch scale ctr)
	(assign '((:r2 +array_begin)) '(:r2))
	(each (lambda ((i field kind))
			(assign `((:r2 ,(* i +ptr_size))) '(:r0))
			(case kind
				(:data (assign '((:r0 +array_begin)) '(:r0)))
				(:val (assign '((:r0 +num_value)) '(:r0))))
			(assign '(:r0) `((:rsp ,field))))
		'((0 local_grid :data) (1 local_didx :data) (2 local_dpts :data)
		(3 local_layers :data) (4 local_vlayers :data) (5 local_w :val) (6 local_h :val)
		(7 local_d :val) (8 local_cw :val) (9 local_ch :val) (10 local_scale :val) (11 local_ctr :data)))
	(assign '((:rsp local_nx) (:rsp local_ny) (:rsp local_nz)) '(:r0 :r1 :r2))
	(pcb-pad)
	(assign '(:r0 :r1 :r2) '((:rsp local_px) (:rsp local_py) (:rsp local_pz)))
	;the line looked with, its points and radius and gap put in each time
	(call :fixeds :create :nil '(:r0))
	(assign '(:r0) '((:rsp local_line)))
	(times 6 (call :array :push_back '(:r0 0) '(:r0 _ _ _)))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign '(:r0) '((:rsp local_ldata)))

	;a layer away
	(pcb-vec-list 'local_vecs)
	(loop-start)
		(assign '((:rsp local_vec_iter) (:rsp local_vec_end)) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'local_vecs 'flood_next)
		(assign '((:rsp local_ldata) (:rsp local_px) (:rsp local_py) (:rsp local_radius) (:rsp local_gap))
			'(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
			(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp local_pz)) '(:r0))
		(vpif '(:r0 > :r2))
			(vp-cpy-rr :r0 :r1) (vp-cpy-rr :r2 :r0) (vp-cpy-rr :r1 :r2)
		(endif)
		(assign '(:r0 :r2) '((:rsp local_zlo) (:rsp local_zhi)))
		(pcb-new-id)
		(pcb-hit-layers 'local_layers 'flood_hit)
		(pcb-push-node 'local_out_n)
	(vp-label 'flood_hit)
		(assign '((:rsp local_idnum)) '(:r0))
		(call :obj :deref '(:r0))
	(vp-label 'flood_next)
		(assign '((:rsp local_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp local_vec_iter)))
	(loop-end)

	;a via away, from the top layer at this point to the bottom at that
	(pcb-vec-list 'local_vvecs)
	(loop-start)
		(assign '((:rsp local_vec_iter) (:rsp local_vec_end)) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'local_vvecs 'via_next)
		(assign '((:rsp local_ldata) (:rsp local_px) (:rsp local_py) (:rsp local_via) (:rsp local_gap))
			'(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
			(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp local_d)) '(:r0))
		(vp-sub-cr 1 :r0)
		(vp-shl-cr +fp_shift :r0)
		(vp-xor-rr :r1 :r1)
		(assign '(:r1 :r0) '((:rsp local_zlo) (:rsp local_zhi)))
		(pcb-new-id)
		(pcb-hit-layers 'local_vlayers 'via_hit)
		(pcb-hit-layers 'local_layers 'via_hit)
		(pcb-push-node 'local_out_v)
	(vp-label 'via_hit)
		(assign '((:rsp local_idnum)) '(:r0))
		(call :obj :deref '(:r0))
	(vp-label 'via_next)
		(assign '((:rsp local_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp local_vec_iter)))
	(loop-end)

	(assign '((:rsp local_line)) '(:r0))
	(call :obj :deref '(:r0))
	(assign '((:rsp local_out_n)) '(:r1))
	(class/obj/ref :r1 :r2)
	(assign '((:rsp local_this)) '(:r0))
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(flood-near ctx node flood_vecs via_vecs radius gap via out_n out_v)" +error_msg_wrong_types))
	(signature '(:LIST :NUMS :LIST :LIST :FIXED :FIXED :FIXED :LIST :LIST))

(def-func-end)


(defun pcb-delay-value ()
	;how many steps more than one a move to local_cx cy cz costs, into :r0:
	;(1 + its history) * (1 + pf * the soft tracks it shorts with), as the
	;Lisp of router.inc, (. pcb :step_delay)
	(assign '((:rsp local_count) (:rsp local_pf)) '(:r0 :r1))
	(vp-shl-cr +fp_shift :r0)
	(pcb-fmul :r0 :r1)
	(vp-add-cr (<< 1 +fp_shift) :r0)
	(assign '((:rsp local_cz) (:rsp local_h) (:rsp local_cy) (:rsp local_w) (:rsp local_cx))
		'(:r2 :r3 :r4 :r5 :r6))
	(vp-mul-rr :r2 :r3)
	(vp-add-rr :r4 :r3)
	(vp-mul-rr :r5 :r3)
	(vp-add-rr :r6 :r3)
	(vp-shl-cr (log2 +long_size) :r3)
	(assign '((:rsp local_hist)) '(:r1))
	(vp-add-rr :r3 :r1)
	(assign '((:r1 0)) '(:r1))
	(vp-add-cr 1 :r1)
	(vp-mul-rr :r1 :r0)
	(vp-asr-cr +fp_shift :r0)
	(vp-sub-cr 1 :r0))

(defun pcb-delay (out)
	;the delay of the move, put on the nums out
	(pcb-delay-value)
	(vp-cpy-rr :r0 :r1)
	(assign `((:rsp ,out)) '(:r0))
	(call :array :push_back '(:r0 :r1) '(_ _ _ _)))

(def-func (path-to-absolute "./flood_cost"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(flood-cost ctx node flood_vecs via_vecs radius gap via out_n out_v out_nd out_vd) -> out_n
	;as (flood-near), for the negotiating router: a move is refused only if
	;it shorts with a hard line, a pad or a wire, of ctx's layers, and one
	;that shorts with routed tracks of ctx's soft layers is taken at a
	;cost, its delay in steps on out_nd, or out_vd for a via, as the Lisp
	;of router.inc, (. pcb :flood_cost_lisp)

	(structure local 0
		(ptr this out_n out_v out_nd out_vd line ldata idnum blist bl rec rec_iter rec_end)
		(ptr vec_iter vec_end vecs vvecs grid didx dpts layers vlayers ctr soft hist)
		(long w h d cw ch scale radius gap via nx ny nz px py pz cx cy cz pf count)
		(long zlo zhi z minx maxx miny maxy row col))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 11)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12)
		'(:list :nums :list :list :fixed :fixed :fixed :list :list :nums :nums))
	(assign '(:r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11 :r12)
		'((:rsp local_vecs) (:rsp local_vvecs) (:rsp local_radius) (:rsp local_gap)
		(:rsp local_via) (:rsp local_out_n) (:rsp local_out_v) (:rsp local_out_nd) (:rsp local_out_vd)))
	(assign '((:r3 +array_begin)) '(:r3))
	(assign `((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size))) '(:r11 :r12 :r13))
	(assign '(:r11 :r12 :r13) '((:rsp local_nx) (:rsp local_ny) (:rsp local_nz)))
	;the board, (grid didx dpts layers vlayers w h d cw ch scale ctr soft hist pf)
	(assign '((:r2 +array_begin)) '(:r2))
	(each (lambda ((i field kind))
			(assign `((:r2 ,(* i +ptr_size))) '(:r0))
			(case kind
				(:data (assign '((:r0 +array_begin)) '(:r0)))
				(:val (assign '((:r0 +num_value)) '(:r0)))
				(:first (assign '((:r0 +array_begin)) '(:r0)) (assign '((:r0 0)) '(:r0))))
			(assign '(:r0) `((:rsp ,field))))
		'((0 local_grid :data) (1 local_didx :data) (2 local_dpts :data)
		(3 local_layers :data) (4 local_vlayers :data) (5 local_w :val) (6 local_h :val)
		(7 local_d :val) (8 local_cw :val) (9 local_ch :val) (10 local_scale :val) (11 local_ctr :data)
		(12 local_soft :data) (13 local_hist :data) (14 local_pf :first)))
	(assign '((:rsp local_nx) (:rsp local_ny) (:rsp local_nz)) '(:r0 :r1 :r2))
	(pcb-pad)
	(assign '(:r0 :r1 :r2) '((:rsp local_px) (:rsp local_py) (:rsp local_pz)))
	(call :fixeds :create :nil '(:r0))
	(assign '(:r0) '((:rsp local_line)))
	(times 6 (call :array :push_back '(:r0 0) '(:r0 _ _ _)))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign '(:r0) '((:rsp local_ldata)))

	;a layer away
	(pcb-vec-list 'local_vecs)
	(loop-start)
		(assign '((:rsp local_vec_iter) (:rsp local_vec_end)) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'local_vecs 'flood_next)
		(assign '((:rsp local_ldata) (:rsp local_px) (:rsp local_py) (:rsp local_radius) (:rsp local_gap))
			'(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
			(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp local_pz)) '(:r0))
		(vpif '(:r0 > :r2))
			(vp-cpy-rr :r0 :r1) (vp-cpy-rr :r2 :r0) (vp-cpy-rr :r1 :r2)
		(endif)
		(assign '(:r0 :r2) '((:rsp local_zlo) (:rsp local_zhi)))
		(pcb-new-id)
		(pcb-hit-layers 'local_layers 'flood_hit)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp local_count)))
		(pcb-hit-layers 'local_soft :count)
		(pcb-push-node 'local_out_n)
		(pcb-delay 'local_out_nd)
	(vp-label 'flood_hit)
		(assign '((:rsp local_idnum)) '(:r0))
		(call :obj :deref '(:r0))
	(vp-label 'flood_next)
		(assign '((:rsp local_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp local_vec_iter)))
	(loop-end)

	;a via away
	(pcb-vec-list 'local_vvecs)
	(loop-start)
		(assign '((:rsp local_vec_iter) (:rsp local_vec_end)) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate 'local_vvecs 'via_next)
		(assign '((:rsp local_ldata) (:rsp local_px) (:rsp local_py) (:rsp local_via) (:rsp local_gap))
			'(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
			(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(assign '((:rsp local_d)) '(:r0))
		(vp-sub-cr 1 :r0)
		(vp-shl-cr +fp_shift :r0)
		(vp-xor-rr :r1 :r1)
		(assign '(:r1 :r0) '((:rsp local_zlo) (:rsp local_zhi)))
		(pcb-new-id)
		(pcb-hit-layers 'local_vlayers 'via_hit)
		(pcb-hit-layers 'local_layers 'via_hit)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp local_count)))
		(pcb-hit-layers 'local_soft :count)
		(pcb-push-node 'local_out_v)
		(pcb-delay 'local_out_vd)
	(vp-label 'via_hit)
		(assign '((:rsp local_idnum)) '(:r0))
		(call :obj :deref '(:r0))
	(vp-label 'via_next)
		(assign '((:rsp local_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp local_vec_iter)))
	(loop-end)

	(assign '((:rsp local_line)) '(:r0))
	(call :obj :deref '(:r0))
	(assign '((:rsp local_out_n)) '(:r1))
	(class/obj/ref :r1 :r2)
	(assign '((:rsp local_this)) '(:r0))
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(flood-cost ctx node flood_vecs via_vecs radius gap via out_n out_v out_nd out_vd)" +error_msg_wrong_types))
	(signature '(:LIST :NUMS :LIST :LIST :FIXED :FIXED :FIXED :LIST :LIST :NUMS :NUMS))

(def-func-end)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; the whole flood, one call
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun pcb-heap-routines ()
	;'heap_push :r0 heap nums, :r1 value, and 'heap_pop :r0 heap nums -> :r1
	;the least value, its length more than 0. A binary heap of keys, the
	;least first. Trash :r0-:r7
	(vp-label 'heap_push)
		(vp-cpy-rr :r0 :r7)
		(call :array :push_back '(:r0 :r1) '(_ _ _ _))
		(assign '((:r7 +array_begin) (:r7 +array_length)) '(:r2 :r3))
		(vp-sub-cr 1 :r3)
		(loop-start)
			(breakif '(:r3 = 0))
			(vp-cpy-rr :r3 :r4)
			(vp-sub-cr 1 :r4)
			(vp-shr-cr 1 :r4)
			(vp-cpy-rr :r3 :r5)
			(vp-shl-cr (log2 +long_size) :r5)
			(vp-add-rr :r2 :r5)
			(vp-cpy-rr :r4 :r6)
			(vp-shl-cr (log2 +long_size) :r6)
			(vp-add-rr :r2 :r6)
			(assign '((:r5 0) (:r6 0)) '(:r0 :r1))
			(breakif '(:r1 <= :r0))
			(assign '(:r1 :r0) '((:r5 0) (:r6 0)))
			(vp-cpy-rr :r4 :r3)
		(loop-end)
		(vp-ret)
	(vp-label 'heap_pop)
		(vp-cpy-rr :r0 :r7)
		(assign '((:r7 +array_begin)) '(:r2))
		(assign '((:r2 0)) '(:r1))
		(vp-push :r1)
		(call :array :pop_back '(:r7) '(_ :r1))
		(assign '((:r7 +array_begin) (:r7 +array_length)) '(:r2 :r3))
		(vpif '(:r3 /= 0))
			(assign '(:r1) '((:r2 0)))
			(vp-xor-rr :r4 :r4)
			(loop-start)
				;:r4 the place, :r5 its left, :r6 the least of it and its two
				(vp-cpy-rr :r4 :r5)
				(vp-shl-cr 1 :r5)
				(vp-add-cr 1 :r5)
				(breakif '(:r5 >= :r3))
				(vp-cpy-rr :r5 :r6)
				(vp-cpy-rr :r5 :r0)
				(vp-add-cr 1 :r0)
				(vpif '(:r0 < :r3))
					(vp-cpy-rr :r0 :r1)
					(vp-shl-cr (log2 +long_size) :r1)
					(vp-add-rr :r2 :r1)
					(assign '((:r1 0)) '(:r1))
					(vp-push :r1)
					(vp-cpy-rr :r5 :r1)
					(vp-shl-cr (log2 +long_size) :r1)
					(vp-add-rr :r2 :r1)
					(assign '((:r1 0)) '(:r1))
					(vp-pop :r7)
					(vpif '(:r7 < :r1))
						(vp-cpy-rr :r0 :r6)
					(endif)
				(endif)
				(vp-cpy-rr :r4 :r0)
				(vp-shl-cr (log2 +long_size) :r0)
				(vp-add-rr :r2 :r0)
				(vp-cpy-rr :r6 :r1)
				(vp-shl-cr (log2 +long_size) :r1)
				(vp-add-rr :r2 :r1)
				(assign '((:r0 0) (:r1 0)) '(:r5 :r7))
				(breakif '(:r5 <= :r7))
				(assign '(:r7 :r5) '((:r0 0) (:r1 0)))
				(vp-cpy-rr :r6 :r4)
			(loop-end)
		(endif)
		(vp-pop :r1)
		(vp-ret))

(defun pcb-index ()
	;the index on the board of local_cx cy cz, into :r0
	(assign '((:rsp local_cz) (:rsp local_h) (:rsp local_cy) (:rsp local_w) (:rsp local_cx))
		'(:r0 :r1 :r2 :r3 :r4))
	(vp-mul-rr :r1 :r0)
	(vp-add-rr :r2 :r0)
	(vp-mul-rr :r3 :r0)
	(vp-add-rr :r4 :r0))

(defun pcb-wave-moves (vecs vias)
	;the moves round the node of the front, local_n*: those that do not short
	;with a hard line, and their delay; a layer move with none to the next
	;front, once, any other on the heap for the distance it is due
	(pcb-vec-list vecs)
	(loop-start)
		(assign '((:rsp local_vec_iter) (:rsp local_vec_end)) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(pcb-candidate vecs (if vias 'wv_next 'wl_next))
		(assign `((:rsp local_ldata) (:rsp local_px) (:rsp local_py) (:rsp ,(if vias 'local_via 'local_radius)) (:rsp local_gap))
			'(:r3 :r4 :r5 :r6 :r7))
		(assign '(:r4 :r5 :r0 :r1 :r6 :r7)
			`((:r3 0) (:r3 +long_size) (:r3 ,(* 2 +long_size)) (:r3 ,(* 3 +long_size))
			(:r3 ,(* 4 +long_size)) (:r3 ,(* 5 +long_size))))
		(cond
			(vias
				(assign '((:rsp local_d)) '(:r0))
				(vp-sub-cr 1 :r0)
				(vp-shl-cr +fp_shift :r0)
				(vp-xor-rr :r1 :r1)
				(assign '(:r1 :r0) '((:rsp local_zlo) (:rsp local_zhi))))
			(:t (assign '((:rsp local_pz)) '(:r0))
				(vpif '(:r0 > :r2))
					(vp-cpy-rr :r0 :r1) (vp-cpy-rr :r2 :r0) (vp-cpy-rr :r1 :r2)
				(endif)
				(assign '(:r0 :r2) '((:rsp local_zlo) (:rsp local_zhi)))))
		(pcb-new-id)
		(when vias (pcb-hit-layers 'local_vlayers (if vias 'wv_hit 'wl_hit)))
		(pcb-hit-layers 'local_layers (if vias 'wv_hit 'wl_hit))
		;the delay, none for the flood of the stochastic router
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp local_delay)))
		(assign '((:rsp local_mode)) '(:r0))
		(vpif '(:r0 /= 0))
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:rsp local_count)))
			(pcb-hit-layers 'local_soft :count)
			(pcb-delay-value)
			(assign '(:r0) '((:rsp local_delay)))
		(endif)
		(pcb-index)
		(assign '((:rsp local_delay)) '(:r1))
		(cond
			(vias
				(assign '((:rsp local_vs)) '(:r2))
				(vp-add-rr :r2 :r1)
				(vp-shl-cr 32 :r1)
				(vp-add-rr :r0 :r1)
				(assign '((:rsp local_heap)) '(:r0))
				(vp-call 'heap_push))
			(:t (vpif '(:r1 = 0))
					(pcb-to-front)
				(else)
					(assign '((:rsp local_dist)) '(:r2))
					(vp-add-rr :r2 :r1)
					(vp-shl-cr 32 :r1)
					(vp-add-rr :r0 :r1)
					(assign '((:rsp local_heap)) '(:r0))
					(vp-call 'heap_push)
				(endif)))
	(vp-label (if vias 'wv_hit 'wl_hit))
		(assign '((:rsp local_idnum)) '(:r0))
		(call :obj :deref '(:r0))
	(vp-label (if vias 'wv_next 'wl_next))
		(assign '((:rsp local_vec_iter)) '(:r0))
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:rsp local_vec_iter)))
	(loop-end))

(defun pcb-to-front ()
	;the node of index :r0 on the next front, if it is not on it already
	(assign '((:rsp local_stamp) (:rsp local_gen)) '(:r1 :r2))
	(vp-cpy-rr :r0 :r3)
	(vp-shl-cr (log2 +long_size) :r3)
	(vp-add-rr :r3 :r1)
	(assign '((:r1 0)) '(:r3))
	(vpif '(:r3 /= :r2))
		(assign '(:r2) '((:r1 0)))
		(vp-cpy-rr :r0 :r1)
		(assign '((:rsp local_next)) '(:r0))
		(call :array :push_back '(:r0 :r1) '(_ _ _ _))
	(endif))

(def-func (path-to-absolute "./flood_wave"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15
	;info
	;(flood-wave ctx starts ends flood_vecs via_vecs radius gap via vias_cost mode) -> :t
	;the flood of router.inc's (. pcb :mark_distances), all of it: the
	;nodes of the board marked with how far they are from the starts, till
	;every end is, or no more can be. starts and ends are nums of indexes on
	;the board. mode 0, a move is refused if it shorts with a track and a
	;via waits its cost; mode 1, the negotiating router's, (flood-cost)
	;moves and their delays. A node is on a front once, by a stamp of that
	;front, and a move that waits is on a heap of its distance and index

	(structure local 0
		(ptr this line ldata idnum blist bl rec rec_iter rec_end starts ends)
		(ptr vec_iter vec_end vecs vvecs grid didx dpts layers vlayers ctr soft hist)
		(ptr stamp heap front next fiter fend genp)
		(long w h d cw ch scale radius gap via nx ny nz px py pz cx cy cz pf count)
		(long zlo zhi z minx maxx miny maxy row col)
		(long mode vcost dist vs gen delay))

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 10)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11)
		'(:list :nums :nums :list :list :fixed :fixed :fixed :num :num))
	(assign '(:r3 :r4 :r5 :r6 :r7 :r8 :r9 :r10 :r11)
		'((:rsp local_starts) (:rsp local_ends) (:rsp local_vecs) (:rsp local_vvecs)
		(:rsp local_radius) (:rsp local_gap) (:rsp local_via) (:rsp local_vcost) (:rsp local_mode)))
	;the board, (grid didx dpts layers vlayers w h d cw ch scale ctr soft
	;hist pf stamp gen heap front next)
	(assign '((:r2 +array_begin)) '(:r2))
	(each (lambda ((i field kind))
			(assign `((:r2 ,(* i +ptr_size))) '(:r0))
			(case kind
				(:data (assign '((:r0 +array_begin)) '(:r0)))
				(:val (assign '((:r0 +num_value)) '(:r0)))
				(:first (assign '((:r0 +array_begin)) '(:r0)) (assign '((:r0 0)) '(:r0))))
			(assign '(:r0) `((:rsp ,field))))
		'((0 local_grid :data) (1 local_didx :data) (2 local_dpts :data)
		(3 local_layers :data) (4 local_vlayers :data) (5 local_w :val) (6 local_h :val)
		(7 local_d :val) (8 local_cw :val) (9 local_ch :val) (10 local_scale :val) (11 local_ctr :data)
		(12 local_soft :data) (13 local_hist :data) (14 local_pf :first) (15 local_stamp :data)
		(16 local_genp :data) (17 local_heap :obj) (18 local_front :obj) (19 local_next :obj)))
	(call :fixeds :create :nil '(:r0))
	(assign '(:r0) '((:rsp local_line)))
	(times 6 (call :array :push_back '(:r0 0) '(:r0 _ _ _)))
	(assign '((:r0 +array_begin)) '(:r0))
	(assign '(:r0) '((:rsp local_ldata)))
	;the first front, the starts
	(each (lambda (f)
			(assign `((:rsp ,f)) '(:r0))
			(call :array :set_length '(:r0 0) '(_ _)))
		'(local_heap local_front local_next))
	(assign '((:rsp local_starts)) '(:r0))
	(class/array/get_both :r0 :r1 :r2)
	(assign '(:r1 :r2) '((:rsp local_fiter) (:rsp local_fend)))
	(loop-start)
		(assign '((:rsp local_fiter) (:rsp local_fend)) '(:r0 :r1))
		(breakif '(:r0 = :r1))
		(assign '((:r0 0)) '(:r1))
		(vp-add-cr +long_size :r0)
		(assign '(:r0) '((:rsp local_fiter)))
		(assign '((:rsp local_front)) '(:r0))
		(call :array :push_back '(:r0 :r1) '(_ _ _ _))
	(loop-end)
	(vp-cpy-cr 1 :r0)
	(assign '(:r0) '((:rsp local_dist)))

	(loop-start 'wave)
		(call :sys_task :slice)
		;nothing at the front and nothing waiting, done
		(assign '((:rsp local_front) (:rsp local_heap)) '(:r0 :r1))
		(assign '((:r0 +array_length) (:r1 +array_length)) '(:r0 :r1))
		(vp-or-rr :r1 :r0)
		(breakif '(:r0 = 0))
		;the front marked
		(assign '((:rsp local_front)) '(:r0))
		(class/array/get_both :r0 :r1 :r2)
		(assign '((:rsp local_grid) (:rsp local_dist)) '(:r3 :r4))
		(loop-start)
			(breakif '(:r1 = :r2))
			(assign '((:r1 0)) '(:r0))
			(vp-shl-cr (log2 +long_size) :r0)
			(vp-add-rr :r3 :r0)
			(assign '(:r4) '((:r0 0)))
			(vp-add-cr +long_size :r1)
		(loop-end)
		;every end marked, done
		(assign '((:rsp local_ends)) '(:r0))
		(class/array/get_both :r0 :r1 :r2)
		(loop-start)
			(breakif '(:r1 = :r2) 'wave)
			(assign '((:r1 0)) '(:r0))
			(vp-shl-cr (log2 +long_size) :r0)
			(vp-add-rr :r3 :r0)
			(assign '((:r0 0)) '(:r0))
			(breakif '(:r0 = 0))
			(vp-add-cr +long_size :r1)
		(loop-end)
		;the next front, its stamp new
		(assign '((:rsp local_genp)) '(:r0))
		(assign '((:r0 0)) '(:r1))
		(vp-add-cr 1 :r1)
		(assign '(:r1) '((:r0 0)))
		(assign '(:r1) '((:rsp local_gen)))
		(assign '((:rsp local_dist) (:rsp local_vcost)) '(:r0 :r1))
		(vp-add-rr :r0 :r1)
		(assign '(:r1) '((:rsp local_vs)))
		(assign '((:rsp local_front)) '(:r0))
		(class/array/get_both :r0 :r1 :r2)
		(assign '(:r1 :r2) '((:rsp local_fiter) (:rsp local_fend)))
		(loop-start)
			(assign '((:rsp local_fiter) (:rsp local_fend)) '(:r0 :r1))
			(breakif '(:r0 = :r1))
			;the node, and its point
			(assign '((:r0 0) (:rsp local_w) (:rsp local_h)) '(:r0 :r3 :r4))
			(vp-xor-rr :r2 :r2)
			(vp-div-rrr-u :r3 :r2 :r0)
			(assign '(:r2) '((:rsp local_nx)))
			(vp-xor-rr :r2 :r2)
			(vp-div-rrr-u :r4 :r2 :r0)
			(assign '(:r2 :r0) '((:rsp local_ny) (:rsp local_nz)))
			(assign '((:rsp local_nx) (:rsp local_ny) (:rsp local_nz)) '(:r0 :r1 :r2))
			(pcb-pad)
			(assign '(:r0 :r1 :r2) '((:rsp local_px) (:rsp local_py) (:rsp local_pz)))
			(pcb-wave-moves 'local_vecs :nil)
			(pcb-wave-moves 'local_vvecs :t)
			(assign '((:rsp local_fiter)) '(:r0))
			(vp-add-cr +long_size :r0)
			(assign '(:r0) '((:rsp local_fiter)))
		(loop-end)
		;those waiting that are due, to the next front if not marked
		(loop-start)
			(assign '((:rsp local_heap)) '(:r0))
			(assign '((:r0 +array_length)) '(:r1))
			(breakif '(:r1 = 0))
			(assign '((:r0 +array_begin)) '(:r1))
			(assign '((:r1 0)) '(:r1))
			(vp-shr-cr 32 :r1)
			(assign '((:rsp local_dist)) '(:r2))
			(breakif '(:r1 > :r2))
			(vp-call 'heap_pop)
			(vp-cpy-cr 0xffffffff :r0)
			(vp-and-rr :r1 :r0)
			(assign '((:rsp local_grid)) '(:r1))
			(vp-cpy-rr :r0 :r2)
			(vp-shl-cr (log2 +long_size) :r2)
			(vp-add-rr :r2 :r1)
			(assign '((:r1 0)) '(:r1))
			(vpif '(:r1 = 0))
				(pcb-to-front)
			(endif)
		(loop-end)
		;the next front is the front, at the next distance
		(assign '((:rsp local_front) (:rsp local_next)) '(:r0 :r1))
		(assign '(:r1 :r0) '((:rsp local_front) (:rsp local_next)))
		(call :array :set_length '(:r0 0) '(_ _))
		(assign '((:rsp local_dist)) '(:r0))
		(vp-add-cr 1 :r0)
		(assign '(:r0) '((:rsp local_dist)))
		;nothing at the front, on to the next distance one waits for
		(assign '((:rsp local_front) (:rsp local_heap)) '(:r0 :r1))
		(assign '((:r0 +array_length) (:r1 +array_length)) '(:r2 :r3))
		(vpif '(:r2 = 0) '(:r3 /= 0))
			(assign '((:r1 +array_begin)) '(:r1))
			(assign '((:r1 0)) '(:r1))
			(vp-shr-cr 32 :r1)
			(assign '((:rsp local_dist)) '(:r0))
			(vpif '(:r1 > :r0))
				(assign '(:r1) '((:rsp local_dist)))
			(endif)
		(endif)
	(loop-end)

	(assign '((:rsp local_line)) '(:r0))
	(call :obj :deref '(:r0))
	(assign '((:rsp local_this)) '(:r0))
	(assign '((:r0 +lisp_sym_t)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free local_size)
	(exit '(:r0 :r1))
	(vp-ret)

	(pcb-heap-routines)
	(pcb-collide)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(flood-wave ctx starts ends flood_vecs via_vecs radius gap via vias_cost mode)" +error_msg_wrong_types))
	(signature '(:LIST :NUMS :NUMS :LIST :LIST :FIXED :FIXED :FIXED :NUM :NUM))

(def-func-end)

(def-func (path-to-absolute "./add_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(vp-rdef (bucket record this buckets minx miny maxx maxy width buckets_iter buckets_iter_end)
		(cat (method-input :list :push_back) '(:r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14)))

	;the lisp object, to give back: it was never put here, and what was
	;given back was whatever was in the register
	(vp-cpy-rr :r0 this)

	(list-bind-args :r1 `(,buckets ,minx ,miny ,maxx ,maxy ,width ,record)
		'(:list :num :num :num :num :num :list))

	;bump record ref count for pushes and return
	(vp-simd vp-cpy-rr `(,maxx ,maxy) '(:r13 :r14))
	(vp-simd vp-sub-rr `(,minx ,miny) '(:r13 :r14))
	(vp-simd vp-add-cr '(1) '(:r13 :r14))
	(vp-mul-rr :r13 :r14)
	(vp-add-cr 1 :r14)
	(class/obj/ref record :r13 :r14)

	(vp-simd vp-mul-rr `(,width) `(,miny ,maxy))
	(loop-start)
		(vp-simd vp-cpy-rr `(,minx ,maxx) `(,buckets_iter ,buckets_iter_end))
		(vp-simd vp-add-rr `(,miny ,miny) `(,buckets_iter ,buckets_iter_end))
		(class/array/get_iters buckets buckets_iter buckets_iter_end :r0)
		(loop-start)
			(call :list :push_back `((,buckets_iter 0) ,record) `(_ ,record _ _))
			(vp-add-cr +ptr_size buckets_iter)
		(loop-until `(,buckets_iter > ,buckets_iter_end))
		(vp-add-rr width miny)
	(loop-until `(,miny > ,maxy))

	(exit `(,this ,record))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(add-line buckets minx miny maxx maxy width record)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :LIST))

(def-func-end)

(def-func (path-to-absolute "./sub_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :f0-:f15

	(def-vars
		(ptr this buckets line records rec_line)
		(pptr record_iter record_iter_end)
		(pptr buckets_iter buckets_iter_end)
		(int minx miny maxx maxy width))

	(push-scope)
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6 :r7)
		'(:list :num :num :num :num :num :fixeds))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7)
		(vpx this buckets minx miny maxx maxy width line))

	(assign (vpx (* miny width) (* maxy width)) (vpx miny maxy))
	(loop-start)
		(call :list :get_iters (vpx buckets (+ minx miny) (+ maxx miny)) (vpx _ buckets_iter buckets_iter_end))
		(loop-start)
			(assign (vpx (* buckets_iter)) (vpx records))
			(call :list :get_both (vpx records) (vpx _ record_iter record_iter_end))
			(loop-while (vpx (/= record_iter record_iter_end)) 'found_line)
				(call :list :get_elem (vpx (* record_iter) 1) (vpx _ rec_line))
				(call :array :eql (vpx line rec_line) '(_ tmp))
				(vpif `(,tmp = 0))
					(call :list :erase (vpx records record_iter))
					(break 'found_line)
				(endif)
				(assign (vpx (+ record_iter +ptr_size)) (vpx record_iter))
			(loop-end)
		(loop-until (vpx (> (=> (+ buckets_iter +ptr_size) buckets_iter) buckets_iter_end)))
	(loop-until (vpx (> (=> (+ miny width) miny) maxy)))

	(call :obj :ref (vpx buckets))
	(exit (vpx this buckets))
	(return)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(sub-line buckets minx miny maxx maxy width line)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :FIXEDS))

	(pop-scope-syms)

(def-func-end)
