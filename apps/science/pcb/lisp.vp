(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "class/fixeds/class.inc")

(def-func (path-to-absolute "./hit_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this buckets func line hit record rec_id num_id args)
		(pptr record_iter record_iter_end)
		(pptr buckets_iter buckets_iter_end)
		(int minx miny maxx maxy width))

	(push-scope)
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 9)

	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9)
		'(:list :num :num :num :num :num :obj :list :obj))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8 :r9)
		(vpx this buckets minx miny maxx maxy width num_id func line))

	(call :list :create :nil (vpx args))
	(call :obj :ref (vpx line))
	(call :obj :ref (vpx line))
	(call :list :push_back2 (vpx args line line))

	(assign (vpx (* miny width) (* maxy width)) (vpx miny maxy))
	(loop-start)
		(call :list :get_iters (vpx buckets (+ minx miny) (+ maxx miny)) (vpx _ buckets_iter buckets_iter_end))
		(loop-start)
			(call :list :get_both (vpx (* buckets_iter)) (vpx _ record_iter record_iter_end))
			(loop-while (vpx (/= record_iter record_iter_end)))
				(assign (vpx (* record_iter)) (vpx record))
				(call :list :get_elem (vpx record 0) (vpx _ rec_id))
				(vpif (vpx (/= rec_id num_id)))
					(call :num :ref (vpx num_id))
					(call :obj :ref (vpx record))
					(call :list :set_elem (vpx record num_id 0))
					(call :list :set_elem (vpx args record 0))
					(call :lisp :repl_apply (vpx this args func) (vpx _ hit))
					(gotoif (vpx (/= hit (.> this +lisp_sym_nil))) 'hit)
					(call :obj :deref (vpx hit))
				(endif)
				(assign (vpx (+ record_iter +ptr_size)) (vpx record_iter))
			(loop-end)
		(loop-until (vpx (> (=> (+ buckets_iter +ptr_size) buckets_iter) buckets_iter_end)))
	(loop-until (vpx (> (=> (+ miny width) miny) maxy)))
	(call :obj :ref (vpx (.> this +lisp_sym_nil)) (vpx hit))

(vp-label 'hit)
	(call :list :deref (vpx args))
	(exit (vpx this hit))
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(hit-line buckets minx miny maxx maxy width id func line)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :NUM :LIST :obj)))

	(pop-scope-syms)

(def-func-end)

(def-func (path-to-absolute "./add_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r0-:r14, :f0-:f15

	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(vp-rdef (bucket record this buckets minx miny maxx maxy width buckets_iter buckets_iter_end)
		(cat (method-input :list :push_back) '(:r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14)))

	(list-bind-args :r1 `(,buckets ,minx ,miny ,maxx ,maxy ,width ,record)
		'(:list :num :num :num :num :num :list))

	;bump record ref count for pushes and return
	(vp-simd vp-cpy-rr `(,maxx ,maxy) '(:r13 :r14))
	(vp-simd vp-sub-rr `(,minx ,miny) '(:r13 :r14))
	(vp-simd vp-add-cr '(1) '(:r13 :r14))
	(vp-mul-rr :r13 :r14)
	(vp-add-cr 1 :r14)
	(class/obj/ref record :r13 :r14)

	(vp-simd vp-mul-rr `(,width) `(,miny ,maxy))
	(loop-start)
		(vp-simd vp-cpy-rr `(,minx ,maxx) `(,buckets_iter ,buckets_iter_end))
		(vp-simd vp-add-rr `(,miny ,miny) `(,buckets_iter ,buckets_iter_end))
		(class/array/get_iters buckets buckets_iter buckets_iter_end :r0)
		(loop-start)
			(call :list :push_back `((,buckets_iter 0) ,record) `(_ ,record _ _))
			(vp-add-cr +ptr_size buckets_iter)
		(loop-until `(,buckets_iter > ,buckets_iter_end))
		(vp-add-rr width miny)
	(loop-until `(,miny > ,maxy))

	(exit `(,this ,record))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(add-line buckets minx miny maxx maxy width record)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :LIST)))

(def-func-end)

(def-func (path-to-absolute "./sub_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :r14, :f0-:f15

	(def-vars
		(ptr this buckets line records rec_line)
		(pptr record_iter record_iter_end)
		(pptr buckets_iter buckets_iter_end)
		(int minx miny maxx maxy width))

	(push-scope)
	(entry '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 7)

	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6 :r7)
		'(:list :num :num :num :num :num :fixeds))
	(assign '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7)
		(vpx this buckets minx miny maxx maxy width line))

	(assign (vpx (* miny width) (* maxy width)) (vpx miny maxy))
	(loop-start)
		(call :list :get_iters (vpx buckets (+ minx miny) (+ maxx miny)) (vpx _ buckets_iter buckets_iter_end))
		(loop-start)
			(assign (vpx (* buckets_iter)) (vpx records))
			(call :list :get_both (vpx records) (vpx _ record_iter record_iter_end))
			(loop-while (vpx (/= record_iter record_iter_end)) 'found_line)
				(call :list :get_elem (vpx (* record_iter) 1) (vpx _ rec_line))
				(call :array :eql (vpx line rec_line) '(_ tmp))
				(vpif `(,tmp = 0))
					(call :list :erase (vpx records record_iter))
					(break 'found_line)
				(endif)
				(assign (vpx (+ record_iter +ptr_size)) (vpx record_iter))
			(loop-end)
		(loop-until (vpx (> (=> (+ buckets_iter +ptr_size) buckets_iter) buckets_iter_end)))
	(loop-until (vpx (> (=> (+ miny width) miny) maxy)))

	(call :obj :ref (vpx buckets))
	(exit (vpx this buckets))
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(sub-line buckets minx miny maxx maxy width line)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :FIXEDS)))

	(pop-scope-syms)

(def-func-end)
