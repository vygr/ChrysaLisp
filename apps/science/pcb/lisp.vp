(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "class/fixeds/class.inc")
(include "class/fixed/class.inc")
(include "./collide.inc")

(def-func (path-to-absolute "./hit_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r13, :d0-:d15
	;info
	;does the line, (x1 y1 x2 y2 radius gap) fixeds, come within the
	;radius and gap of a record in the buckets, not looked at yet for this
	;id. Each record looked at is marked with the id

	(structure slot 0
		(ptr this buckets line record num_id)
		(pptr record_iter record_iter_end)
		(pptr buckets_iter buckets_iter_end)
		(int minx miny maxx maxy width))

	(vp-alloc slot_size)
	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 8)

	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8)
		'(:list :num :num :num :num :num :obj :fixeds))
	(save-fields :rsp '(slot_this slot_buckets slot_minx slot_miny slot_maxx slot_maxy slot_width slot_num_id slot_line) '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7 :r8))

	(vp-mul-rr :r6 :r3)
	(vp-mul-rr :r6 :r5)
	(save-fields :rsp '(slot_miny slot_maxy) '(:r3 :r5))
	(loop-start)
		(load-fields :rsp '(slot_buckets slot_minx slot_miny slot_maxx) '(:r0 :r1 :r3 :r2))
		(vp-add-rr :r3 :r1)
		(vp-add-rr :r3 :r2)
		(call :list :get_iters '(:r0 :r1 :r2) '(_ :r1 :r2))
		(save-fields :rsp '(slot_buckets_iter slot_buckets_iter_end) '(:r1 :r2))
		(loop-start)
			(call :list :get_both '((:r1 0)) '(_ :r1 :r2))
			(vpif '(:r1 /= :r2))
				(loop-start)
					(save-fields :rsp '(slot_record_iter slot_record_iter_end) '(:r1 :r2))
					(assign '((:r1 0)) '(:r0))
					(assign '(:r0) '((:rsp slot_record)))
					(call :list :get_elem '(:r0 0) '(_ :r1))
					(assign '((:rsp slot_num_id)) '(:r2))
					(vpif '(:r1 /= :r2))
						(call :num :ref '((:rsp slot_num_id)))
						(call :list :set_elem '((:rsp slot_record) (:rsp slot_num_id) 0))
						(load-fields :rsp '(slot_line slot_record) '(:r13 :r1))
						(vp-call 'collide)
						(gotoif '(:r0 /= 0) 'hit)
					(endif)
					(load-fields :rsp '(slot_record_iter slot_record_iter_end) '(:r1 :r2))
					(vp-add-cr +ptr_size :r1)
				(loop-until '(:r1 = :r2))
			(endif)
			(load-fields :rsp '(slot_buckets_iter slot_buckets_iter_end) '(:r1 :r2))
			(vp-add-cr +ptr_size :r1)
			(assign '(:r1) '((:rsp slot_buckets_iter)))
		(loop-until '(:r1 > :r2))
		(load-fields :rsp '(slot_miny slot_maxy slot_width) '(:r0 :r1 :r2))
		(vp-add-rr :r2 :r0)
		(assign '(:r0) '((:rsp slot_miny)))
	(loop-until '(:r0 > :r1))
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r1))
	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'hit)
	(assign '((:rsp slot_this)) '(:r0))
	(call :obj :ref '((:r0 +lisp_sym_t)) '(:r1))
	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

	(pcb-collide)

(vp-label 'error)
	(vp-free slot_size)
	(jump :lisp :repl_error '(:r1 "(hit-line buckets minx miny maxx maxy width id line)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :NUM :FIXEDS))

(def-func-end)

(def-func (path-to-absolute "./add_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 7)

	(vp-rdef (bucket record this buckets minx miny maxx maxy width buckets_iter buckets_iter_end)
		(cat (method-input :list :push_back) '(:r6 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14)))

	;the lisp object, to give back: it was never put here, and what was
	;given back was whatever was in the register
	(vp-cpy-rr :r0 this)

	(list-bind-args :r1 `(,buckets ,minx ,miny ,maxx ,maxy ,width ,record)
		'(:list :num :num :num :num :num :list))

	;bump record ref count for pushes and return
	(vp-simd vp-cpy-rr `(,maxx ,maxy) '(:r13 :r14))
	(vp-simd vp-sub-rr `(,minx ,miny) '(:r13 :r14))
	(vp-simd vp-add-cr '(1) '(:r13 :r14))
	(vp-mul-rr :r13 :r14)
	(vp-add-cr 1 :r14)
	(class/obj/ref record :r13 :r14)

	(vp-simd vp-mul-rr `(,width) `(,miny ,maxy))
	(loop-start)
		(vp-simd vp-cpy-rr `(,minx ,maxx) `(,buckets_iter ,buckets_iter_end))
		(vp-simd vp-add-rr `(,miny ,miny) `(,buckets_iter ,buckets_iter_end))
		(class/array/get_iters buckets buckets_iter buckets_iter_end :r0)
		(loop-start)
			(call :list :push_back `((,buckets_iter 0) ,record) `(_ ,record _ _))
			(vp-add-cr +ptr_size buckets_iter)
		(loop-until `(,buckets_iter > ,buckets_iter_end))
		(vp-add-rr width miny)
	(loop-until `(,miny > ,maxy))

	(exit `(,this ,record))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(add-line buckets minx miny maxx maxy width record)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :LIST))

(def-func-end)

(def-func (path-to-absolute "./sub_line"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r7, :d0-:d15

	(structure slot 0
		(ptr this buckets line records rec_line)
		(pptr record_iter record_iter_end)
		(pptr buckets_iter buckets_iter_end)
		(int minx miny maxx maxy width))

	(vp-alloc slot_size)
	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 7)

	(list-bind-args :r1 '(:r1 :r2 :r3 :r4 :r5 :r6 :r7)
		'(:list :num :num :num :num :num :fixeds))
	(save-fields :rsp '(slot_this slot_buckets slot_minx slot_miny slot_maxx slot_maxy slot_width slot_line) '(:r0 :r1 :r2 :r3 :r4 :r5 :r6 :r7))

	(vp-mul-rr :r6 :r3)
	(vp-mul-rr :r6 :r5)
	(save-fields :rsp '(slot_miny slot_maxy) '(:r3 :r5))
	(loop-start)
		(load-fields :rsp '(slot_buckets slot_minx slot_miny slot_maxx) '(:r0 :r1 :r3 :r2))
		(vp-add-rr :r3 :r1)
		(vp-add-rr :r3 :r2)
		(call :list :get_iters '(:r0 :r1 :r2) '(_ :r1 :r2))
		(save-fields :rsp '(slot_buckets_iter slot_buckets_iter_end) '(:r1 :r2))
		(loop-start)
			(assign '((:r1 0)) '(:r0))
			(assign '(:r0) '((:rsp slot_records)))
			(call :list :get_both '(:r0) '(_ :r1 :r2))
			(save-fields :rsp '(slot_record_iter slot_record_iter_end) '(:r1 :r2))
			(vpif '(:r1 /= :r2))
				(loop-start 'found_line)
					(call :list :get_elem '((:r1 0) 1) '(_ (:rsp slot_rec_line)))
					(call :array :eql '((:rsp slot_line) (:rsp slot_rec_line)) '(_ :r1))
					(vpif '(:r1 = 0))
						(call :list :erase '((:rsp slot_records) (:rsp slot_record_iter)))
						(break 'found_line)
					(endif)
					(load-fields :rsp '(slot_record_iter slot_record_iter_end) '(:r1 :r2))
					(vp-add-cr +ptr_size :r1)
					(assign '(:r1) '((:rsp slot_record_iter)))
				(loop-until '(:r1 = :r2))
			(endif)
			(load-fields :rsp '(slot_buckets_iter slot_buckets_iter_end) '(:r1 :r2))
			(vp-add-cr +ptr_size :r1)
			(assign '(:r1) '((:rsp slot_buckets_iter)))
		(loop-until '(:r1 > :r2))
		(load-fields :rsp '(slot_miny slot_maxy slot_width) '(:r0 :r1 :r2))
		(vp-add-rr :r2 :r0)
		(assign '(:r0) '((:rsp slot_miny)))
	(loop-until '(:r0 > :r1))

	(call :obj :ref '((:rsp slot_buckets)))
	(exit '((:rsp slot_this) (:rsp slot_buckets)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(vp-free slot_size)
	(jump :lisp :repl_error '(:r1 "(sub-line buckets minx miny maxx maxy width line)" +error_msg_wrong_types))
	(signature '(:LIST :NUM :NUM :NUM :NUM :NUM :FIXEDS))

(def-func-end)
