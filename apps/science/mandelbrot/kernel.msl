// the picture on the GPU, a pixel a thread, as lisp.vp works out a point:
// in float32, so no deeper than a float can tell one pixel from the next.
// kernel.comp is the same in GLSL, for a GPU that takes SPIR-V

#include <metal_stdlib>
using namespace metal;

struct block
{
	float cx; float cy; float step;
	uint w; uint h; uint top; uint base;
	float rate; float lbase; float lgain;
	uint light; uint ss;
};

// the colour of a point, black if it does not get out of the set
static uint shade(float x0, float y0, constant block &u, device const uint *pal)
{
	// a point of the heart, or of the disc to its left, is in the set
	float xq = x0 - 0.25, q = xq * xq + y0 * y0;
	if (q * (q + xq) <= 0.25 * y0 * y0 || (x0 + 1.0) * (x0 + 1.0) + y0 * y0 <= 0.0625) return 0xff000000;
	// z and its derivative, brought down with the one added to it before
	// it is too big for a float
	float xc = 0.0, yc = 0.0, x2 = 0.0, y2 = 0.0, dx = 0.0, dy = 0.0, one = 1.0;
	uint n = 0;
	for (; n < u.top && x2 + y2 < 65536.0; ++n)
	{
		float ndx = 2.0 * (xc * dx - yc * dy) + one;
		dy = 2.0 * (xc * dy + yc * dx);
		dx = ndx;
		yc = 2.0 * xc * yc + y0;
		xc = x2 - y2 + x0;
		x2 = xc * xc;
		y2 = yc * yc;
		if (fabs(dx) + fabs(dy) > 1e20) { dx *= 1e-20; dy *= 1e-20; one *= 1e-20; }
	}
	if (n >= u.top) return 0xff000000;
	// the depth with no steps, and its colour, the root of it as the depths
	// get closer together the deeper they are
	float depth = float(n) + 1.0 - log2(log2(x2 + y2) / 16.0);
	uint col = pal[(uint(sqrt(depth) * u.rate) + u.base) & 2047];
	// the light, z over its derivative points out of the set, up and to the
	// left is bright
	int light = 256;
	if (u.light)
	{
		float re = xc * dx + yc * dy, im = yc * dx - xc * dy, len = sqrt(re * re + im * im);
		light = int(len > 0.0 ? u.lbase - u.lgain * (re + im) / len : u.lbase);
	}
	uint r = min(255u, (((col >> 16) & 255u) * uint(light)) >> 8);
	uint g = min(255u, (((col >> 8) & 255u) * uint(light)) >> 8);
	uint b = min(255u, ((col & 255u) * uint(light)) >> 8);
	return 0xff000000 | (r << 16) | (g << 8) | b;
}

// a pixel, the mean of ss by ss points across it, so detail finer than a
// pixel does not shimmer as the picture moves
kernel void kernel_main(constant block &u [[buffer(0)]],
	device const uint *pal [[buffer(1)]], device uint *out [[buffer(2)]],
	uint2 gid [[thread_position_in_grid]])
{
	if (gid.x >= u.w || gid.y >= u.h) return;
	uint ss = max(1u, u.ss), r = 0, g = 0, b = 0;
	float sub = u.step / float(ss);
	float x0 = u.cx + (float(gid.x) - 0.5 * float(u.w)) * u.step + 0.5 * sub - 0.5 * u.step;
	float y0 = u.cy + (float(gid.y) - 0.5 * float(u.h)) * u.step + 0.5 * sub - 0.5 * u.step;
	for (uint j = 0; j < ss; ++j)
		for (uint i = 0; i < ss; ++i)
		{
			uint c = shade(x0 + float(i) * sub, y0 + float(j) * sub, u, pal);
			r += (c >> 16) & 255u; g += (c >> 8) & 255u; b += c & 255u;
		}
	uint n = ss * ss;
	out[gid.y * u.w + gid.x] = 0xff000000 | ((r / n) << 16) | ((g / n) << 8) | (b / n);
}
