(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-func (path-to-absolute "./vops"))
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r9, :r14, :d0-:d15

	(defmacro test-block (n &rest _)
		(while (< (length _) n) (setq _ (cat _ _)))
		`(progn ~(copy (slice _ 0 n))))

	(defmacro test-block-s (n &rest _)
		;shuffled by a generator of a seed that is always the same, the one
		;of lib/media/noise.inc, so each build gives the same mix
		(while (< (length _) n) (setq _ (cat _ _)))
		(defq _ (copy (slice _ 0 n)) seed 1)
		(each! (lambda (&) (swap _ (!) (% (>> (setq seed (logand (+ (* seed 1664525) 1013904223) 0xffffffff)) 8) (inc (!)))))
			(list _) n 0)
		`(progn ~_))

	(defmacro time-start ()
		;the time this test starts, and no ops yet
		'(progn
			(call :host_os :pii_time :nil '(:r0))
			(vp-xor-rr :r1 :r1)
			(save-fields :rsp '(slot_start slot_cnt) '(:r0 :r1))))

	(defmacro time-step (n)
		;n more ops, the time so far in :r0
		`(progn
			(call :host_os :pii_time :nil '(:r0))
			(load-fields :rsp '(slot_start slot_cnt) '(:r1 :r2))
			(vp-sub-rr :r1 :r0)
			(vp-add-cr ,n :r2)
			(assign '(:r2) '((:rsp slot_cnt)))))

	(defmacro time-end (slot)
		;the ops a second, of the count and the time in :r0
		`(progn
			(assign '((:rsp slot_cnt)) '(:r1))
			(vp-mul-cr 1000000 :r1)
			(vp-div-rr :r0 :r1)
			(call :num :create '(:r1) '((:rsp ,slot)))))

	(structure slot 0
		(ptr this args mem1 mem2)
		(long regs_vops memory_vops reals_vops start cnt))

	(entry '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 0)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))

	;reg ops test
	(time-start)
	(loop-start)

		;this mix allows up to oct issue opportunities !
		;we shuffle the mix to give some spice to life.
		(vp-rdef (loop r1 r2 r3 r4 r5 r6 r7 r8 r9))
		(vp-cpy-cr 0 loop)
		(loop-start)
			(vp-simd vp-cpy-cr '(1 2 3 4 5 6 7 8 9) `(,r1 ,r2 ,r3 ,r4 ,r5 ,r6 ,r7 ,r8 ,r9))
			(test-block-s 990
				(vp-add-cr 3 r2) (vp-add-cr 3 r3) (vp-add-cr 3 r4) (vp-add-cr 3 r5)
				(vp-add-cr 3 r6) (vp-add-cr 3 r7) (vp-add-cr 3 r8) (vp-add-cr 3 r9)
				(vp-sub-cr 4 r2) (vp-sub-cr 4 r3) (vp-sub-cr 4 r4) (vp-sub-cr 4 r5)
				(vp-sub-cr 4 r6) (vp-sub-cr 4 r7) (vp-sub-cr 4 r8) (vp-sub-cr 4 r9)
				(vp-and-cr 5 r2) (vp-and-cr 5 r3) (vp-and-cr 5 r4) (vp-and-cr 5 r5)
				(vp-and-cr 5 r6) (vp-and-cr 5 r7) (vp-and-cr 5 r8) (vp-and-cr 5 r9)
				(vp-or-cr 6 r2) (vp-or-cr 6 r3) (vp-or-cr 6 r4) (vp-or-cr 6 r5)
				(vp-or-cr 6 r6) (vp-or-cr 6 r7) (vp-or-cr 6 r8) (vp-or-cr 6 r9)
				(vp-xor-cr 7 r2) (vp-xor-cr 7 r3) (vp-xor-cr 7 r4) (vp-xor-cr 7 r5)
				(vp-xor-cr 7 r6) (vp-xor-cr 7 r7) (vp-xor-cr 7 r8) (vp-xor-cr 7 r9)
				(vp-add-rr r1 r2) (vp-add-rr r1 r3) (vp-add-rr r1 r4) (vp-add-rr r1 r5)
				(vp-add-rr r1 r6) (vp-add-rr r1 r7) (vp-add-rr r1 r8) (vp-add-rr r1 r9)
				(vp-sub-rr r1 r2) (vp-sub-rr r1 r3) (vp-sub-rr r1 r4) (vp-sub-rr r1 r5)
				(vp-sub-rr r1 r6) (vp-sub-rr r1 r7) (vp-sub-rr r1 r8) (vp-sub-rr r1 r9)
				(vp-and-rr r1 r2) (vp-and-rr r1 r3) (vp-and-rr r1 r4) (vp-and-rr r1 r5)
				(vp-and-rr r1 r6) (vp-and-rr r1 r7) (vp-and-rr r1 r8) (vp-and-rr r1 r9)
				(vp-or-rr r1 r2) (vp-or-rr r1 r3) (vp-or-rr r1 r4) (vp-or-rr r1 r5)
				(vp-or-rr r1 r6) (vp-or-rr r1 r7) (vp-or-rr r1 r8) (vp-or-rr r1 r9)
				(vp-xor-rr r1 r2) (vp-xor-rr r1 r3) (vp-xor-rr r1 r4) (vp-xor-rr r1 r5)
				(vp-xor-rr r1 r6) (vp-xor-rr r1 r7) (vp-xor-rr r1 r8) (vp-xor-rr r1 r9)
				(vp-shl-cr 3 r2) (vp-shl-cr 3 r3) (vp-shl-cr 3 r4) (vp-shl-cr 3 r5)
				(vp-shl-cr 3 r6) (vp-shl-cr 3 r7) (vp-shl-cr 3 r8) (vp-shl-cr 3 r9)
				(vp-shr-cr 2 r2) (vp-shr-cr 2 r3) (vp-shr-cr 2 r4) (vp-shr-cr 2 r5)
				(vp-shr-cr 2 r6) (vp-shr-cr 2 r7) (vp-shr-cr 2 r8) (vp-shr-cr 2 r9)
				(vp-asr-cr 1 r2) (vp-asr-cr 1 r3) (vp-asr-cr 1 r4) (vp-asr-cr 1 r5)
				(vp-asr-cr 1 r6) (vp-asr-cr 1 r7) (vp-asr-cr 1 r8) (vp-asr-cr 1 r9)
				(vp-shl-rr r1 r2) (vp-shl-rr r1 r3) (vp-shl-rr r1 r4) (vp-shl-rr r1 r5)
				(vp-shl-rr r1 r6) (vp-shl-rr r1 r7) (vp-shl-rr r1 r8) (vp-shl-rr r1 r9)
				(vp-shr-rr r1 r2) (vp-shr-rr r1 r3) (vp-shr-rr r1 r4) (vp-shr-rr r1 r5)
				(vp-shr-rr r1 r6) (vp-shr-rr r1 r7) (vp-shr-rr r1 r8) (vp-shr-rr r1 r9)
				(vp-asr-rr r1 r2) (vp-asr-rr r1 r3) (vp-asr-rr r1 r4) (vp-asr-rr r1 r5)
				(vp-asr-rr r1 r6) (vp-asr-rr r1 r7) (vp-asr-rr r1 r8) (vp-asr-rr r1 r9))
			(vp-add-cr 1 loop)
		(loop-until `(,loop = 1000))
		(call :sys_task :sleep '(0))

		(time-step (* 1000 1000))
	(loop-until '(:r0 >= 100000))
	(time-end slot_regs_vops)

	;memory ops test
	(time-start)
	(loop-start)

		(vp-rdef (loop r1 r2 r3 r4))
		(assign '((& :rsp slot_mem1) (& :rsp slot_mem2)) `(,r1 ,r2))
		(vp-cpy-cr 0 loop)
		(loop-start)
			(test-block 1000
				(vp-load-rcr r1 0 r3)
				(vp-load-rcr r2 0 r4)
				(vp-store-rrc r3 r2 0)
				(vp-store-rrc r4 r1 0)
				(vp-load-rcr-i r1 0 r3)
				(vp-load-rcr-i r2 0 r4)
				(vp-store-rrc-i r3 r2 0)
				(vp-store-rrc-i r4 r1 0)
				(vp-load-rcr-s r1 0 r3)
				(vp-load-rcr-s r2 0 r4)
				(vp-store-rrc-s r3 r2 0)
				(vp-store-rrc-s r4 r1 0)
				(vp-load-rcr-b r1 0 r3)
				(vp-load-rcr-b r2 0 r4)
				(vp-store-rrc-b r3 r2 0)
				(vp-store-rrc-b r4 r1 0))
			(vp-add-cr 1 loop)
		(loop-until `(,loop = 1000))
		(call :sys_task :sleep '(0))

		(time-step (* 1000 1000))
	(loop-until '(:r0 >= 100000))
	(time-end slot_memory_vops)

	;reals ops test
	(time-start)
	(loop-start)

		(vp-rdef (loop r1 r2 r3 r4))
		(vp-ddef (f1 f2 f3 f4 f5 f6 f7 f8))
		(vp-cpy-cr 0 loop)
		(vp-cpy-cr 1000 r1)
		(vp-cpy-cr -1000 r2)
		(vp-cpy-cr 10000 r3)
		(vp-cpy-cr -10000 r4)
		(loop-start)
			(test-block 24
				(vp-cvt-rd r1 f1) (vp-cvt-rd r2 f3) (vp-cvt-rd r3 f5) (vp-cvt-rd r4 f7)
				(vp-cpy-dd f1 f2) (vp-cpy-dd f3 f4) (vp-cpy-dd f5 f6) (vp-cpy-dd f7 f8)
				(vp-add-dd f1 f2) (vp-add-dd f3 f4) (vp-add-dd f5 f6) (vp-add-dd f7 f8)
				(vp-sub-dd f2 f1) (vp-sub-dd f4 f3) (vp-sub-dd f6 f5) (vp-sub-dd f8 f7)
				(vp-mul-dd f1 f2) (vp-mul-dd f3 f4) (vp-mul-dd f5 f6) (vp-mul-dd f7 f8)
				(vp-div-dd f1 f2) (vp-div-dd f3 f4) (vp-div-dd f5 f6) (vp-div-dd f7 f8))
			(vp-add-cr 1 loop)
		(loop-until `(,loop = 100))
		(call :sys_task :sleep '(0))

		(time-step (* 24 100))
	(loop-until '(:r0 >= 100000))
	(time-end slot_reals_vops)

	(call :list :create :nil '(:r0))
	(call :list :push_back2 '(:r0 (:rsp slot_regs_vops) (:rsp slot_memory_vops)) '(:r0 _ _ _ _))
	(call :list :push_back '(:r0 (:rsp slot_reals_vops)) '(:r1 _ _ _))

	(exit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(vops)" +error_msg_wrong_types))
	(signature '())

(def-func-end)
