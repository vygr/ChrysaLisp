(defun geo-to-canvas (lon_deg lat_deg w h)
	; Projects (lon, lat) degrees to canvas pixel coordinates
	(defq px (* (/ (+ lon_deg 180.0) 360.0) w)
		py (* (/ (- 90.0 lat_deg) 180.0) h))
	(list px py))

(defun create-continent-paths (w h)
	; Generates (list fill_polys outline_strokes)
	(defq fills (list)
		outlines (list))
	(each (lambda (poly)
		(defq p (path))
		(each (lambda ((lon lat))
			(bind '(px py) (geo-to-canvas lon lat w h))
			(push p px py))
			(partition poly 2))
		(push fills p)
		(push outlines (path-stroke-polyline p 1.2 +join_round +cap_round +cap_round)))
		*continents_data*)
	(list fills outlines))
