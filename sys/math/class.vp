(include "lib/asm/func.inc")
(include "./class.inc")

(def-method :sys_math :i_rand)
	;inputs
	;:r0 = random range (long)
	;outputs
	;:r0 = random number in range (long)
	;trashes
	;:r0-:r3, :d0-:d15

	(entry :sys_math :i_rand '(:r0))

	(vpif '(:r0 /= 0))
		(fn-bind 'sys/statics/statics :r3)
		(vp-cpy-rr :r0 :r1)
		(vp-load-rcr :r3 statics_sys_math_seed :r0)
		(vpif '(:r0 = 0))
			;total random at start up
			(vp-cpy-rr :r1 :r2)
			(call :host_os :pii_rand '((& :r3 statics_sys_math_seed) +long_size))
			(vp-load-rcr :r3 statics_sys_math_seed :r0)
			(vp-cpy-rr :r2 :r1)
		(endif)
		(vp-cpy-rr :r0 :r2)
		(vp-shl-cr 21 :r2)
		(vp-xor-rr :r2 :r0)
		(vp-cpy-rr :r0 :r2)
		(vp-asr-cr 35 :r2)
		(vp-xor-rr :r2 :r0)
		(vp-cpy-rr :r0 :r2)
		(vp-shl-cr 4 :r2)
		(vp-xor-rr :r2 :r0)
		(vp-store-rrc :r0 :r3 statics_sys_math_seed)
		(vp-rem-rr-u :r1 :r0)
	(endif)

	(exit :sys_math :i_rand '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :q_sqrt)
	;inputs
	;:r0 = number (fixed)
	;outputs
	;:r0 = sqrt (fixed)
	;trashes
	;:r0-:r1, :d0-:d1

	(entry :sys_math :q_sqrt '(:r0))

	(vp-lea-pr 'fn_consts :r1)
	(assign '((:r1 (fn-const (recip (n2d (<< 1 +fp_shift)))))) '(:d0))
	(vp-cvt-rd :r0 :d1)
	(vp-mul-dd :d0 :d1)
	(vp-sqrt-dd :d1 :d1)
	(assign '((:r1 (fn-const (n2d (<< 1 +fp_shift))))) '(:d0))
	(vp-mul-dd :d1 :d0)
	(vp-cvt-dr :d0 :r0)

	(exit :sys_math :q_sqrt '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :q_sin)
	;inputs
	;:r0 = angle in radians (fixed)
	;outputs
	;:r0 = sin (fixed)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;by f_sin: a single holds an angle of a drawing, to 256 radians, to all
	;16 bits of its fraction, and its answer to more than a fixed has

	(entry :sys_math :q_sin '(:r0))

	(vp-lea-pr 'fn_consts :r2)
	(vp-cvt-rf :r0 :f0)
	(vp-load-rcf :r2 (fn-const 0x37800000) :f1)
	(vp-mul-ff :f1 :f0)
	(call :sys_math :f_sin '(:f0) '(:f0))
	(vp-load-rcf :r2 (fn-const 0x47800000) :f1)
	(vp-mul-ff :f1 :f0)
	(vp-cvt-fr :f0 :r0)

	(exit :sys_math :q_sin '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :q_cos)
	;inputs
	;:r0 = angle in radians (fixed)
	;outputs
	;:r0 = cos (fixed)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;by f_cos: a single holds an angle of a drawing, to 256 radians, to all
	;16 bits of its fraction, and its answer to more than a fixed has

	(entry :sys_math :q_cos '(:r0))

	(vp-lea-pr 'fn_consts :r2)
	(vp-cvt-rf :r0 :f0)
	(vp-load-rcf :r2 (fn-const 0x37800000) :f1)
	(vp-mul-ff :f1 :f0)
	(call :sys_math :f_cos '(:f0) '(:f0))
	(vp-load-rcf :r2 (fn-const 0x47800000) :f1)
	(vp-mul-ff :f1 :f0)
	(vp-cvt-fr :f0 :r0)

	(exit :sys_math :q_cos '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :d_sin)
	;inputs
	;:d0 = double (double)
	;outputs
	;:d0 = double (double)
	;trashes
	;:r0-:r1, :d0-:d3

	(entry :sys_math :d_sin '(:d0))

	(vp-lea-pr 'constants :r0)

	; --- Range Reduction: fmod(x, 2pi) ---
	(vp-load-rcd :r0 0 :d2)		; Load 1/2pi
	(vp-cpy-dd :d0 :d1)			; f0 = x
	(vp-mul-dd :d2 :d0)			; f0 = x / 2pi
	(vp-cvt-dr :d0 :r1)			; r1 = (int)(x / 2pi)
	(vp-cvt-rd :r1 :d2)			; f2 = (double)k
	(vp-load-rcd :r0 8 :d3)		; Load 2pi
	(vp-mul-dd :d3 :d2)			; f2 = k * 2pi
	(vp-sub-dd :d2 :d1)			; f1 = x - k*2pi

	; --- Symmetry to [-pi, pi] ---
	(vp-load-rcd :r0 16 :d2)		; Load pi
	(vp-cpy-dd :d2 :d3)			; f3 = pi
	(vp-neg-dd :d2 :d2)			; f2 = -pi

	(vp-bgt-dd :d3 :d1 'sub_2pi)
	(vp-blt-dd :d2 :d1 'add_2pi)
	(vp-jmp 'check_hpi)

(vp-label 'sub_2pi)
	(vp-load-rcd :r0 8 :d2)		; Load 2pi
	(vp-sub-dd :d2 :d1)			; x -= 2pi
	(vp-jmp 'check_hpi)

(vp-label 'add_2pi)
	(vp-load-rcd :r0 8 :d2)		; Load 2pi
	(vp-add-dd :d2 :d1)			; x += 2pi

	; --- Symmetry to [-pi/2, pi/2] ---
(vp-label 'check_hpi)
	(vp-load-rcd :r0 24 :d2)		; Load pi/2
	(vp-cpy-dd :d2 :d3)			; f3 = pi/2
	(vp-neg-dd :d2 :d2)			; f2 = -pi/2

	(vp-bgt-dd :d3 :d1 'fold_pos)
	(vp-blt-dd :d2 :d1 'fold_neg)
	(vp-jmp 'poly)

(vp-label 'fold_pos)
	(vp-load-rcd :r0 16 :d2)		; Load pi
	(vp-sub-dd :d1 :d2)			; f2 = pi - x
	(vp-cpy-dd :d2 :d1)
	(vp-jmp 'poly)

(vp-label 'fold_neg)
	(vp-load-rcd :r0 16 :d2)		; Load pi
	(vp-neg-dd :d2 :d2)			; f2 = -pi
	(vp-sub-dd :d1 :d2)			; f2 = -pi - x
	(vp-cpy-dd :d2 :d1)

	; --- Polynomial Approximation (Taylor) ---
(vp-label 'poly)
	(vp-cpy-dd :d1 :d3)
	(vp-mul-dd :d1 :d3)			; f3 = x^2

	; Horner's Method
	(vp-load-rcd :r0 80 :d0)		; Load c7
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 72 :d2)		; Load c6
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 64 :d2)		; Load c5
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 56 :d2)		; Load c4
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 48 :d2)		; Load c3
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 40 :d2)		; Load c2
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 32 :d2)		; Load c1
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d3 :d0)
	(vp-load-rcd :r0 88 :d2)		; Load 1.0
	(vp-add-dd :d2 :d0)
	(vp-mul-dd :d1 :d0)

	(exit :sys_math :d_sin '(:d0))
	(vp-ret)

	(vp-align 8)
(vp-label 'constants)
	(vp-long 0x3fc45f306dc9c883) ;	0: 1 / 2pi
	(vp-long 0x401921fb54442d18) ;	8: 2pi
	(vp-long 0x400921fb54442d18) ; 16: pi
	(vp-long 0x3ff921fb54442d18) ; 24: pi / 2
	(vp-long 0xbfc5555555555555) ; 32: c1 (-1/6)
	(vp-long 0x3f81111111111111) ; 40: c2 (1/120)
	(vp-long 0xbf2a01a01a01a01a) ; 48: c3 (-1/5040)
	(vp-long 0x3ec71de3a556c734) ; 56: c4 (1/362880)
	(vp-long 0xbe5ae64567f544e4) ; 64: c5 (-1/39916800)
	(vp-long 0x3de6124613a86d09) ; 72: c6 (1/6227020800)
	(vp-long 0xbceae73673322e72) ; 80: c7 (-1/1.307e12)
	(vp-long 0x3ff0000000000000) ; 88: 1.0

(def-func-end)

(def-method :sys_math :q_intersect)
	;inputs
	;:r0 = p1x (fixed)
	;:r1 = p1y (fixed)
	;:r2 = p2x (fixed)
	;:r3 = p2y (fixed)
	;:r4 = v1x (fixed)
	;:r5 = v1y (fixed)
	;:r6 = v2x (fixed)
	;:r7 = v2y (fixed)
	;outputs
	;:r0 = ix (fixed)
	;:r1 = iy (fixed)
	;trashes
	;:r0-:r2, :r8-:r13

	(vec-set 8)
	(entry :sys_math :q_intersect (vec-top 8))

	(bind '(p1x p1y p2x p2y v1x v1y v2x v2y) (vec-top 8))
	(defq p1 (list p1x p1y) p2 (list p2x p2y)
		v1 (list v1x v1y) v2 (list v2x v2y))
	(bind '(v1x v1y) (map (const list) v1))
	(bind '(v2x v2y) (map (const list) v2))

	(vec-dup 2 v2)
	(vec-dup 2 p2)
	(vec-add 2)
	(vec-dup 2 p2)
	(vec-qdet 2)
	(defq db (vec-top 1))

	(vec-dup 2 v1)
	(vec-dup 2 p1)
	(vec-add 2)
	(vec-dup 2 p1)
	(vec-qdet 2)
	(defq da (vec-top 1))

	(vec-dup 2 v1)
	(vec-dup 2 v2)
	(vec-qdet 2)
	(defq axb (vec-top 1))

	(vpif (list (first axb) '/= 0))
		(vec-dup 2 (cat da v1x))
		(vec-qdet 2 (cat db v2x))
		(vec-dup 2 (cat da v1y))
		(vec-qdet 2 (cat db v2y))
		(vec-qdiv 2 (cat axb axb))
		(exit :sys_math :q_intersect (vec-pop 2))
	(else)
		(vec-set 4)
		(vec-add 2)
		(vec-load 1 (list (<< 1 (dec +fp_shift))))
		(vec-qscale 2)
		(exit :sys_math :q_intersect (vec-pop 2))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_math :q_dist_sqd)
	;inputs
	;:r0 = px (fixed)
	;:r1 = py (fixed)
	;:r2 = p1x (fixed)
	;:r3 = p1y (fixed)
	;:r4 = p2x (fixed)
	;:r5 = p2y (fixed)
	;outputs
	;:r0 = distance squared (fixed)
	;trashes
	;:r0-:r3, :r6-:r10

	;fixed point, whole words: they were held as ints, and the optimizer gave
	;the whole word back from a store of 4 bytes, which it no longer does
	(structure slot 0
		(long px py p1x p1y p2x p2y))

	(vp-alloc slot_size)
	(entry :sys_math :q_dist_sqd '((:rsp slot_px) (:rsp slot_py) (:rsp slot_p1x) (:rsp slot_p1y) (:rsp slot_p2x) (:rsp slot_p2y)))

	(vec-set 0)
	(vec-load 2 '((:rsp slot_px) (:rsp slot_py)))
	(defq p (vec-top 2))
	(vec-load 2 '((:rsp slot_p1x) (:rsp slot_p1y)))
	(defq p1 (vec-top 2))
	(vec-load 2 '((:rsp slot_p2x) (:rsp slot_p2y)))
	(defq p2 (vec-top 2))

	(vec-dup 2)
	(vec-sub 2 p1)
	(defq lv (vec-top 2))

	(vec-dup 2 p)
	(vec-sub 2 p1)
	(vec-qdot 2 lv)
	(bind '(c1) (vec-top 1))

	(vpif `(,c1 > 0))
		(vec-dup 2 lv)
		(vec-qdot 2 lv)
		(bind '(c2) (vec-top 1))

		(vpif `(,c2 <= ,c1))
			(vec-cpy 2 p2 p1)
		(else)
			(vec-qdiv 1)
			(vec-qscale 2)
			(vec-add 2 lv p1)
		(endif)
	(endif)
	(vec-set 4)
	(vec-qdistance-squared 2)

	(exit :sys_math :q_dist_sqd (vec-pop 1))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :sys_math :d_pow)
	;inputs
	;:d0 = double (double)
	;:d1 = power (double)
	;outputs
	;:d0 = double to the power (double)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;0 if the double is not greater than 0. The whole part of the power is
	;by squaring, the rest by repeated roots, to 31 bits of it. It is the
	;method of the shader language, every back end of which must agree.
	;The double waits in :d3 and the whole part in :r2, and the 1 of the
	;roots is kept in :d3 while they are taken, so none of it is memory

	(entry :sys_math :d_pow '(:d0 :d1))

	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const (n2d 0)) :d2)
	(vp-bgt-dd :d2 :d0 'positive)
	(vp-cpy-dd :d2 :d0)
	(vp-jmp 'exit)
(vp-label 'positive)
	;the whole part of the power, and what is left of it
	(vp-cpy-dd :d0 :d3)
	(vp-cvt-dr :d1 :r2)
	(vp-cvt-rd :r2 :d2)
	(vp-ble-dd :d1 :d2 'floored)
	(vp-load-rcd :r0 (fn-const (n2d 1)) :d0)
	(vp-sub-dd :d0 :d2)
	(vp-sub-cr 1 :r2)
(vp-label 'floored)
	(vp-sub-dd :d2 :d1)
	(vp-load-rcd :r0 (fn-const (n2d 1)) :d0)
	(vp-cpy-dd :d3 :d2)
	(vp-abs-rr :r2 :r1)
(vp-label 'whole)
	;the whole part, by squaring
	(vp-beq-cr 0 :r1 'recip)
	(vp-cpy-rr :r1 :r0)
	(vp-and-cr 1 :r0)
	(vp-beq-cr 0 :r0 'even)
	(vp-mul-dd :d2 :d0)
(vp-label 'even)
	(vp-mul-dd :d2 :d2)
	(vp-shr-cr 1 :r1)
	(vp-jmp 'whole)
(vp-label 'recip)
	;a power less than 0 is 1 over it
	(vp-bge-cr 0 :r2 'rest)
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const (n2d 1)) :d2)
	(vp-div-dd :d0 :d2)
	(vp-cpy-dd :d2 :d0)
(vp-label 'rest)
	(vp-cpy-dd :d3 :d2)
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const (n2d 1)) :d3)
	(vp-cpy-cr 31 :r1)
(vp-label 'root)
	;the rest, a bit of it at a time, by a root for each bit, till none
	;is left, 0 or -0, all its bits but the sign 0
	(vp-cpy-dr :d1 :r0)
	(vp-shl-cr 1 :r0)
	(vp-beq-cr 0 :r0 'exit)
	(vp-beq-cr 0 :r1 'exit)
	(vp-sub-cr 1 :r1)
	(vp-sqrt-dd :d2 :d2)
	(vp-add-dd :d1 :d1)
	(vp-blt-dd :d3 :d1 'root)
	(vp-mul-dd :d2 :d0)
	(vp-sub-dd :d3 :d1)
	(vp-jmp 'root)
(vp-label 'exit)

	(exit :sys_math :d_pow '(:d0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :d_exp)
	;inputs
	;:d0 = power (double)
	;outputs
	;:d0 = e to the power (double)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;0 below the least power that gives a whole double, infinity above
	;the greatest. The power is k ln2 + r, ln2 in two parts so r is exact,
	;no more than half ln2 either way. e to the r by its series to the 13th
	;power, and 2 to the k made from its bits, in two halves so neither is
	;out of range. It is the method of the shader language, every back end
	;of which must agree

	(entry :sys_math :d_exp '(:d0))

	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const 0x40862e42fefa39ef) :d1)
	(vp-bgt-dd :d1 :d0 'big)
	(vp-load-rcd :r0 (fn-const 0xc086232bdd7abcd2) :d1)
	(vp-blt-dd :d1 :d0 'small)
	;k, the whole number nearest the power over ln2
	(vp-load-rcd :r0 (fn-const 0x3ff71547652b82fe) :d1)
	(vp-mul-dd :d0 :d1)
	(vp-load-rcd :r0 (fn-const 0x3fe0000000000000) :d2)
	(vp-load-rcd :r0 (fn-const 0) :d3)
	(vp-bge-dd :d3 :d1 'up)
	(vp-sub-dd :d2 :d1)
	(vp-jmp 'nearest)
(vp-label 'up)
	(vp-add-dd :d2 :d1)
(vp-label 'nearest)
	(vp-cvt-dr :d1 :r1)
	;r, the power less k ln2
	(vp-cvt-rd :r1 :d1)
	(vp-load-rcd :r0 (fn-const 0x3fe62e42fee00000) :d2)
	(vp-mul-dd :d1 :d2)
	(vp-sub-dd :d2 :d0)
	(vp-load-rcd :r0 (fn-const 0x3dea39ef35793c76) :d2)
	(vp-mul-dd :d1 :d2)
	(vp-sub-dd :d2 :d0)
	;e to the r, 1/13! down to 1/2!, then 1 and 1
	(vp-load-rcd :r0 (fn-const 0x3de6124613a86d09) :d3)
	(each (lambda (c)
			(vp-mul-dd :d0 :d3)
			(vp-load-rcd :r0 (fn-const c) :d2)
			(vp-add-dd :d2 :d3))
		'(0x3e21eed8eff8d898 0x3e5ae64567f544e4 0x3e927e4fb7789f5c 0x3ec71de3a556c734
		0x3efa01a01a01a01a 0x3f2a01a01a01a01a 0x3f56c16c16c16c17 0x3f81111111111111
		0x3fa5555555555555 0x3fc5555555555555 0x3fe0000000000000
		0x3ff0000000000000 0x3ff0000000000000))
	;times 2 to the k, as 2 to half of it, and 2 to the rest
	(vp-cpy-rr :r1 :r2)
	(vp-asr-cr 1 :r2)
	(vp-sub-rr :r2 :r1)
	(each (lambda (r)
			(vp-add-cr 1023 r)
			(vp-shl-cr 52 r)
			(vp-cpy-rd r :d1)
			(vp-mul-dd :d1 :d3))
		'(:r1 :r2))
	(vp-cpy-dd :d3 :d0)
	(vp-jmp 'exit)
(vp-label 'big)
	(vp-load-rcd :r0 (fn-const 0x7ff0000000000000) :d0)
	(vp-jmp 'exit)
(vp-label 'small)
	(vp-load-rcd :r0 (fn-const 0) :d0)
(vp-label 'exit)

	(exit :sys_math :d_exp '(:d0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :d_log)
	;inputs
	;:d0 = double (double)
	;outputs
	;:d0 = natural log of the double (double)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;minus infinity of 0, not a number below 0, infinity and not a number
	;as they are. The double is 2 to the e times m, m from the root of a half
	;to the root of 2, and the log of m is 2 atanh of f, f (m - 1) / (m + 1),
	;by its series in f squared to the 10th power. It is the method of the
	;shader language, every back end of which must agree

	(entry :sys_math :d_log '(:d0))

	(vp-lea-pr 'fn_consts :r0)
	(vp-cpy-dr :d0 :r1)
	(vp-ble-cr 0 :r1 'not_positive)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 52 :r2)
	(vp-beq-cr 0x7ff :r2 'exit)
	;m, from 1 to 2, the double with its exponent taken out, e what was taken
	(defq mantissa (lambda ()
		(vp-sub-cr 1023 :r2)
		(vp-shl-cr 52 :r2)
		(vp-sub-rr :r2 :r1)
		(vp-asr-cr 52 :r2)
		(vp-cpy-rd :r1 :d0)))
	(vp-bne-cr 0 :r2 'normal)
	;a subnormal, made normal by 2 to the 54
	(vp-load-rcd :r0 (fn-const 0x4350000000000000) :d1)
	(vp-mul-dd :d1 :d0)
	(vp-cpy-dr :d0 :r1)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 52 :r2)
	(mantissa)
	(vp-sub-cr 54 :r2)
	(vp-jmp 'fold)
(vp-label 'normal)
	(mantissa)
(vp-label 'fold)
	;to the root of a half to the root of 2
	(vp-load-rcd :r0 (fn-const 0x3ff6a09e667f3bcd) :d1)
	(vp-ble-dd :d1 :d0 'folded)
	(vp-load-rcd :r0 (fn-const 0x3fe0000000000000) :d1)
	(vp-mul-dd :d1 :d0)
	(vp-add-cr 1 :r2)
(vp-label 'folded)
	;f and f squared
	(vp-load-rcd :r0 (fn-const 0x3ff0000000000000) :d1)
	(vp-cpy-dd :d0 :d2)
	(vp-sub-dd :d1 :d2)
	(vp-add-dd :d1 :d0)
	(vp-div-dd :d0 :d2)
	(vp-cpy-dd :d2 :d3)
	(vp-mul-dd :d2 :d3)
	;2 f times 1 + s/3 + s^2/5 ... + s^10/21
	(vp-load-rcd :r0 (fn-const 0x3fa8618618618618) :d0)
	(each (lambda (c)
			(vp-mul-dd :d3 :d0)
			(vp-load-rcd :r0 (fn-const c) :d1)
			(vp-add-dd :d1 :d0))
		'(0x3faaf286bca1af28 0x3fae1e1e1e1e1e1e 0x3fb1111111111111 0x3fb3b13b13b13b14
		0x3fb745d1745d1746 0x3fbc71c71c71c71c 0x3fc2492492492492 0x3fc999999999999a
		0x3fd5555555555555 0x3ff0000000000000))
	(vp-mul-dd :d2 :d0)
	(vp-add-dd :d0 :d0)
	;and e ln2, in its two parts, the small first
	(vp-cvt-rd :r2 :d1)
	(vp-load-rcd :r0 (fn-const 0x3dea39ef35793c76) :d2)
	(vp-mul-dd :d1 :d2)
	(vp-add-dd :d2 :d0)
	(vp-load-rcd :r0 (fn-const 0x3fe62e42fee00000) :d2)
	(vp-mul-dd :d1 :d2)
	(vp-add-dd :d2 :d0)
	(vp-jmp 'exit)
(vp-label 'not_positive)
	;0 and -0 give minus infinity, the rest not a number
	(vp-shl-cr 1 :r1)
	(vp-load-rcd :r0 (fn-const 0xfff0000000000000) :d0)
	(vp-beq-cr 0 :r1 'exit)
	(vp-load-rcd :r0 (fn-const 0x7ff8000000000000) :d0)
(vp-label 'exit)

	(exit :sys_math :d_log '(:d0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :d_tanh)
	;inputs
	;:d0 = double (double)
	;outputs
	;:d0 = tanh of the double (double)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;of the double without its sign, the sign put back after. 1 from 22 on,
	;where it is 1 to the last bit. Below 0.55, e to the twice of it less 1
	;by its series to the 19th power, t, nothing taken from what is near
	;it, and t / (t + 2). Between, 1 - 2 / (e to the twice of it + 1), by
	;d_exp, from 0.55 on the 1 is never much more than what it takes. Of
	;858 doubles from -25 to 25, 2 units of the last place from the true
	;tanh at the most, 680 of them the nearest double

	(entry :sys_math :d_tanh '(:d0))

	(vp-alloc +long_size)
	(vp-store-drc :d0 :rsp 0)
	(vp-abs-dd :d0 :d0)
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const 0x4036000000000000) :d1)
	(vp-bge-dd :d1 :d0 'one)
	(vp-load-rcd :r0 (fn-const 0x3fe199999999999a) :d1)
	(vp-blt-dd :d1 :d0 'small)
	;1 - 2 / (e to the 2x + 1)
	(vp-add-dd :d0 :d0)
	(call :sys_math :d_exp '(:d0) '(:d0))
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const 0x3ff0000000000000) :d1)
	(vp-add-dd :d1 :d0)
	(vp-load-rcd :r0 (fn-const 0x4000000000000000) :d2)
	(vp-div-dd :d0 :d2)
	(vp-sub-dd :d2 :d1)
	(vp-cpy-dd :d1 :d0)
	(vp-jmp 'sign)
(vp-label 'small)
	;e to the 2x less 1, 1/19! down to 1/2!, then 1, times 2x, and t / (t + 2)
	(vp-add-dd :d0 :d0)
	(vp-load-rcd :r0 (fn-const 0x3c62f49b46814157) :d3)
	(each (lambda (c)
			(vp-mul-dd :d0 :d3)
			(vp-load-rcd :r0 (fn-const c) :d2)
			(vp-add-dd :d2 :d3))
		'(0x3ca6827863b97d97 0x3ce952c77030ad4a 0x3d2ae7f3e733b81f 0x3d6ae7f3e733b81f
		0x3da93974a8c07c9d 0x3de6124613a86d09 0x3e21eed8eff8d898 0x3e5ae64567f544e4
		0x3e927e4fb7789f5c 0x3ec71de3a556c734 0x3efa01a01a01a01a 0x3f2a01a01a01a01a
		0x3f56c16c16c16c17 0x3f81111111111111 0x3fa5555555555555 0x3fc5555555555555
		0x3fe0000000000000 0x3ff0000000000000))
	(vp-mul-dd :d0 :d3)
	(vp-load-rcd :r0 (fn-const 0x4000000000000000) :d1)
	(vp-add-dd :d3 :d1)
	(vp-div-dd :d1 :d3)
	(vp-cpy-dd :d3 :d0)
	(vp-jmp 'sign)
(vp-label 'one)
	(vp-load-rcd :r0 (fn-const 0x3ff0000000000000) :d0)
(vp-label 'sign)
	(vp-load-rcd :rsp 0 :d1)
	(vp-load-rcd :r0 (fn-const 0) :d2)
	(vp-bge-dd :d2 :d1 'exit)
	(vp-neg-dd :d0 :d0)
(vp-label 'exit)
	(vp-free +long_size)

	(exit :sys_math :d_tanh '(:d0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :f_exp)
	;inputs
	;:f0 = power (single)
	;outputs
	;:f0 = e to the power (single)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;d_exp of singles: 0 below the least power that gives a whole single,
	;infinity above the greatest. The power is k ln2 + r, ln2 in two parts,
	;the first of few bits so k times it is exact, r no more than half ln2
	;either way. e to the r by its series to the 7th power, all a single
	;holds, and 2 to the k made from its bits, in two halves so neither is
	;out of range

	(entry :sys_math :f_exp '(:f0))

	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcf :r0 (fn-const 0x42b17218) :f1)
	(vp-bgt-ff :f1 :f0 'big)
	(vp-load-rcf :r0 (fn-const 0xc2cff1b4) :f1)
	(vp-blt-ff :f1 :f0 'small)
	;k, the whole number nearest the power over ln2
	(vp-load-rcf :r0 (fn-const 0x3fb8aa3b) :f1)
	(vp-mul-ff :f0 :f1)
	(vp-load-rcf :r0 (fn-const 0x3f000000) :f2)
	(vp-load-rcf :r0 (fn-const 0) :f3)
	(vp-bge-ff :f3 :f1 'up)
	(vp-sub-ff :f2 :f1)
	(vp-jmp 'nearest)
(vp-label 'up)
	(vp-add-ff :f2 :f1)
(vp-label 'nearest)
	(vp-cvt-fr :f1 :r1)
	;r, the power less k ln2
	(vp-cvt-rf :r1 :f1)
	(vp-load-rcf :r0 (fn-const 0x3f318000) :f2)
	(vp-mul-ff :f1 :f2)
	(vp-sub-ff :f2 :f0)
	(vp-load-rcf :r0 (fn-const 0xb95e8083) :f2)
	(vp-mul-ff :f1 :f2)
	(vp-sub-ff :f2 :f0)
	;e to the r, 1/7! down to 1/2!, then 1 and 1
	(vp-load-rcf :r0 (fn-const 0x39500d01) :f3)
	(each (lambda (c)
			(vp-mul-ff :f0 :f3)
			(vp-load-rcf :r0 (fn-const c) :f2)
			(vp-add-ff :f2 :f3))
		'(0x3ab60b61 0x3c088889 0x3d2aaaab 0x3e2aaaab 0x3f000000 0x3f800000 0x3f800000))
	;times 2 to the k, as 2 to half of it, and 2 to the rest
	(vp-cpy-rr :r1 :r2)
	(vp-asr-cr 1 :r2)
	(vp-sub-rr :r2 :r1)
	(each (lambda (r)
			(vp-add-cr 127 r)
			(vp-shl-cr 23 r)
			(vp-cpy-rf r :f1)
			(vp-mul-ff :f1 :f3))
		'(:r1 :r2))
	(vp-cpy-ff :f3 :f0)
	(vp-jmp 'exit)
(vp-label 'big)
	(vp-load-rcf :r0 (fn-const 0x7f800000) :f0)
	(vp-jmp 'exit)
(vp-label 'small)
	(vp-load-rcf :r0 (fn-const 0) :f0)
(vp-label 'exit)

	(exit :sys_math :f_exp '(:f0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :f_tanh)
	;inputs
	;:f0 = single (single)
	;outputs
	;:f0 = tanh of the single (single)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;d_tanh of singles: 1 from 10 on, below 0.55 the series of e to the
	;twice of it less 1 to the 11th power, t / (t + 2), between 1 - 2 / (e
	;to the twice of it + 1), by f_exp. 2 units of the last place from the
	;true tanh at the most, as d_tanh

	(entry :sys_math :f_tanh '(:f0))

	(vp-alloc +long_size)
	(vp-store-frc :f0 :rsp 0)
	(vp-abs-ff :f0 :f0)
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcf :r0 (fn-const 0x41200000) :f1)
	(vp-bge-ff :f1 :f0 'one)
	(vp-load-rcf :r0 (fn-const 0x3f0ccccd) :f1)
	(vp-blt-ff :f1 :f0 'small)
	;1 - 2 / (e to the 2x + 1)
	(vp-add-ff :f0 :f0)
	(call :sys_math :f_exp '(:f0) '(:f0))
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcf :r0 (fn-const 0x3f800000) :f1)
	(vp-add-ff :f1 :f0)
	(vp-load-rcf :r0 (fn-const 0x40000000) :f2)
	(vp-div-ff :f0 :f2)
	(vp-sub-ff :f2 :f1)
	(vp-cpy-ff :f1 :f0)
	(vp-jmp 'sign)
(vp-label 'small)
	;e to the 2x less 1, 1/11! down to 1/2!, then 1, times 2x, and t / (t + 2)
	(vp-add-ff :f0 :f0)
	(vp-load-rcf :r0 (fn-const 0x32d7322b) :f3)
	(each (lambda (c)
			(vp-mul-ff :f0 :f3)
			(vp-load-rcf :r0 (fn-const c) :f2)
			(vp-add-ff :f2 :f3))
		'(0x3493f27e 0x3638ef1d 0x37d00d01 0x39500d01 0x3ab60b61 0x3c088889 0x3d2aaaab
		0x3e2aaaab 0x3f000000 0x3f800000))
	(vp-mul-ff :f0 :f3)
	(vp-load-rcf :r0 (fn-const 0x40000000) :f1)
	(vp-add-ff :f3 :f1)
	(vp-div-ff :f1 :f3)
	(vp-cpy-ff :f3 :f0)
	(vp-jmp 'sign)
(vp-label 'one)
	(vp-load-rcf :r0 (fn-const 0x3f800000) :f0)
(vp-label 'sign)
	(vp-load-rcf :rsp 0 :f1)
	(vp-load-rcf :r0 (fn-const 0) :f2)
	(vp-bge-ff :f2 :f1 'exit)
	(vp-neg-ff :f0 :f0)
(vp-label 'exit)
	(vp-free +long_size)

	(exit :sys_math :f_tanh '(:f0))
	(vp-ret)

(def-func-end)

;the sine of the double in :d0, :r0 the function's constants, to the single
;in :f0. Brought to the turn in doubles, as d_sin is, so a single of any
;size keeps its bits, and the series to the 13th power, all a single holds
;over a half turn, in doubles too and rounded once: summed in singles it
;was 2 bits out where it comes to 1, cos 0 not 1
(defun f-sin-body ()
	(vp-load-rcd :r0 (fn-const 0x3fc45f306dc9c883) :d2)
	(vp-cpy-dd :d0 :d1)
	(vp-mul-dd :d2 :d0)
	(vp-cvt-dr :d0 :r1)
	(vp-cvt-rd :r1 :d2)
	(vp-load-rcd :r0 (fn-const 0x401921fb54442d18) :d3)
	(vp-mul-dd :d3 :d2)
	(vp-sub-dd :d2 :d1)
	;to -pi to pi
	(vp-load-rcd :r0 (fn-const 0x400921fb54442d18) :d3)
	(vp-cpy-dd :d3 :d2)
	(vp-neg-dd :d2 :d2)
	(vp-bgt-dd :d3 :d1 'sub_2pi)
	(vp-blt-dd :d2 :d1 'add_2pi)
	(vp-jmp 'check_hpi)
(vp-label 'sub_2pi)
	(vp-load-rcd :r0 (fn-const 0x401921fb54442d18) :d2)
	(vp-sub-dd :d2 :d1)
	(vp-jmp 'check_hpi)
(vp-label 'add_2pi)
	(vp-load-rcd :r0 (fn-const 0x401921fb54442d18) :d2)
	(vp-add-dd :d2 :d1)
	;to -pi/2 to pi/2
(vp-label 'check_hpi)
	(vp-load-rcd :r0 (fn-const 0x3ff921fb54442d18) :d3)
	(vp-cpy-dd :d3 :d2)
	(vp-neg-dd :d2 :d2)
	(vp-bgt-dd :d3 :d1 'fold_pos)
	(vp-blt-dd :d2 :d1 'fold_neg)
	(vp-jmp 'poly)
(vp-label 'fold_pos)
	(vp-load-rcd :r0 (fn-const 0x400921fb54442d18) :d2)
	(vp-sub-dd :d1 :d2)
	(vp-cpy-dd :d2 :d1)
	(vp-jmp 'poly)
(vp-label 'fold_neg)
	(vp-load-rcd :r0 (fn-const 0x400921fb54442d18) :d2)
	(vp-neg-dd :d2 :d2)
	(vp-sub-dd :d1 :d2)
	(vp-cpy-dd :d2 :d1)
	;x (1 + c1 x^2 + c2 x^4 ... + c6 x^12), and the nearest single
(vp-label 'poly)
	(vp-cpy-dd :d1 :d3)
	(vp-mul-dd :d1 :d3)
	(vp-load-rcd :r0 (fn-const 0x3de6124613a86d09) :d0)
	(each (lambda (c)
			(vp-mul-dd :d3 :d0)
			(vp-load-rcd :r0 (fn-const c) :d2)
			(vp-add-dd :d2 :d0))
		'(0xbe5ae64567f544e4 0x3ec71de3a556c734 0xbf2a01a01a01a01a 0x3f81111111111111
		0xbfc5555555555555 0x3ff0000000000000))
	(vp-mul-dd :d1 :d0)
	(vp-cvt-df :d0 :f0))

(def-method :sys_math :f_sin)
	;inputs
	;:f0 = single (single)
	;outputs
	;:f0 = sin of the single (single)
	;trashes
	;:r0-:r1, :d0-:d3
	;info
	;the single made a double and brought to the turn, and the series, in
	;doubles, as d_sin does, to the nearest single

	(entry :sys_math :f_sin '(:f0))

	(vp-cvt-fd :f0 :d0)
	(vp-lea-pr 'fn_consts :r0)
	(f-sin-body)

	(exit :sys_math :f_sin '(:f0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :f_cos)
	;inputs
	;:f0 = single (single)
	;outputs
	;:f0 = cos of the single (single)
	;trashes
	;:r0-:r1, :d0-:d3
	;info
	;the sine of a quarter turn on, the quarter turn added in doubles, so
	;near where it is 0 it has all the bits a single can

	(entry :sys_math :f_cos '(:f0))

	(vp-cvt-fd :f0 :d0)
	(vp-lea-pr 'fn_consts :r0)
	(vp-load-rcd :r0 (fn-const 0x3ff921fb54442d18) :d1)
	(vp-add-dd :d1 :d0)
	(f-sin-body)

	(exit :sys_math :f_cos '(:f0))
	(vp-ret)

(def-func-end)

(def-method :sys_math :f_log)
	;inputs
	;:f0 = single (single)
	;outputs
	;:f0 = natural log of the single (single)
	;trashes
	;:r0-:r2, :d0-:d3
	;info
	;d_log of singles: minus infinity of 0, not a number below 0, infinity
	;and not a number as they are. The single is 2 to the e times m, m from
	;the root of a half to the root of 2, and the log of m is 2 atanh of f,
	;f (m - 1) / (m + 1), by its series in f squared to the 5th power

	(entry :sys_math :f_log '(:f0))

	(vp-lea-pr 'fn_consts :r0)
	(vp-cpy-fr :f0 :r1)
	(vp-cpy-rr :r1 :r2)
	(vp-and-cr 0x7fffffff :r2)
	(vp-beq-cr 0 :r2 'zero)
	(vp-bge-cr 0x80000000 :r1 'negative)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 23 :r2)
	(vp-beq-cr 0xff :r2 'exit)
	;m, from 1 to 2, the single with its exponent taken out, e what was taken
	(defq mantissa (lambda ()
		(vp-sub-cr 127 :r2)
		(vp-shl-cr 23 :r2)
		(vp-sub-rr :r2 :r1)
		(vp-asr-cr 23 :r2)
		(vp-cpy-rf :r1 :f0)))
	(vp-bne-cr 0 :r2 'normal)
	;a subnormal, made normal by 2 to the 25
	(vp-load-rcf :r0 (fn-const 0x4c000000) :f1)
	(vp-mul-ff :f1 :f0)
	(vp-cpy-fr :f0 :r1)
	(vp-cpy-rr :r1 :r2)
	(vp-shr-cr 23 :r2)
	(mantissa)
	(vp-sub-cr 25 :r2)
	(vp-jmp 'fold)
(vp-label 'normal)
	(mantissa)
(vp-label 'fold)
	;to the root of a half to the root of 2
	(vp-load-rcf :r0 (fn-const 0x3fb504f3) :f1)
	(vp-ble-ff :f1 :f0 'folded)
	(vp-load-rcf :r0 (fn-const 0x3f000000) :f1)
	(vp-mul-ff :f1 :f0)
	(vp-add-cr 1 :r2)
(vp-label 'folded)
	;f and f squared
	(vp-load-rcf :r0 (fn-const 0x3f800000) :f1)
	(vp-cpy-ff :f0 :f2)
	(vp-sub-ff :f1 :f2)
	(vp-add-ff :f1 :f0)
	(vp-div-ff :f0 :f2)
	(vp-cpy-ff :f2 :f3)
	(vp-mul-ff :f2 :f3)
	;2 f times 1 + s/3 + s^2/5 ... + s^5/11
	(vp-load-rcf :r0 (fn-const 0x3dba2e8c) :f0)
	(each (lambda (c)
			(vp-mul-ff :f3 :f0)
			(vp-load-rcf :r0 (fn-const c) :f1)
			(vp-add-ff :f1 :f0))
		'(0x3de38e39 0x3e124925 0x3e4ccccd 0x3eaaaaab 0x3f800000))
	(vp-mul-ff :f2 :f0)
	(vp-add-ff :f0 :f0)
	;and e ln2, in its two parts, the small first
	(vp-cvt-rf :r2 :f1)
	(vp-load-rcf :r0 (fn-const 0xb95e8083) :f2)
	(vp-mul-ff :f1 :f2)
	(vp-add-ff :f2 :f0)
	(vp-load-rcf :r0 (fn-const 0x3f318000) :f2)
	(vp-mul-ff :f1 :f2)
	(vp-add-ff :f2 :f0)
	(vp-jmp 'exit)
(vp-label 'zero)
	;0 and -0 give minus infinity
	(vp-load-rcf :r0 (fn-const 0xff800000) :f0)
	(vp-jmp 'exit)
(vp-label 'negative)
	;below 0, not a number
	(vp-load-rcf :r0 (fn-const 0x7fc00000) :f0)
(vp-label 'exit)

	(exit :sys_math :f_log '(:f0))
	(vp-ret)

(def-func-end)

