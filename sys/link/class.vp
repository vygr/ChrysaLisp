(include "lib/asm/func.inc")
(include "class/nodeid/class.inc")
(include "class/hmap/class.inc")
(include "./class.inc")
(include "././kernel/class.inc")

(def-method :sys_link :link)
	;started by kernel for each link
	;trashes
	;:r0-:r7, :d0-:d15

	(structure slot 0
		(struct lk_node lk_node_size)
		(ptr statics params msg data mem)
		(pubyte pdata)
		(long handle is_owner live)
		(nodeid node_id))

	(defmacro link-start (task)
		;start the in or out link and send it its params: lk_node, the shared
		;memory, is_owner, and where to say it has gone
		`(progn
			(call :sys_mail :alloc '(32) '(:r0 :r1))
			(save-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
			(call :sys_task :start '((@ ,(f-path :sys_link task))) '(_ _ :r2 :r3 :r4))
			(load-fields :rsp '(slot_msg slot_data slot_mem slot_is_owner) '(:r0 :r1 :r6 :r7))
			(save-net-id :r0 +msg_dest)
			(vp-lea-rcr :rsp slot_lk_node :r5)
			(vp-lea-rcr :rsp slot_live :r2)
			(save-fields :r1 '(0 +ptr_size (* 2 +ptr_size) (* 3 +ptr_size)) '(:r5 :r6 :r7 :r2))
			(call :sys_mail :send '(:r0))))

	(vp-alloc slot_size)

	;decrement task count
	;don't count links in load balancing
	(call :sys_task :count '(-3))

	;init and add link node to link array
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp slot_node_id :r0 :r1)
	(vp-rdef (node zero))
	(assign '((& :rsp slot_lk_node) 0) `(,node ,zero))
	(save-fields node
			`(lk_node_task_count lk_node_peer_pid lk_node_sent lk_node_remote
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		`(,zero ,zero ,zero ,zero ,zero ,zero ,zero ,zero))
	(fn-bind 'sys/statics/statics :r0)
	(assign '(:r0) '((:rsp slot_statics)))
	(call :array :push_back '((:r0 statics_sys_mail_links_array) (& :rsp slot_lk_node)))

	;read params msg from kernel
	(call :sys_mail :mymail :nil '(:r0 :r1))
	(save-fields :rsp '(slot_params slot_pdata) '(:r0 :r1))

	;open shared memory file
	(call :host_os :pii_open_shared `(:r1 ,lk_shmem_size) '(:r0))
	(assign '(:r0) '((:rsp slot_handle)))

	;map shared object
	(call :host_os :pii_mmap `(,lk_shmem_size :r0 ,+mmap_shared) '(:r0))
	(assign '(:r0) '((:rsp slot_mem)))

	;no shared memory, no link. The host gives 0 or -1 for one it could
	;not make or map, and there is nothing at either to claim
	(vp-lea-rcr :r0 1 :r1)
	(vpif '(:r1 > 1))
		;try to claim host_a (embedded in chan_1 alignment padding)
		(assign `((:r0 ,(+ lk_shmem_host_a +node_id_node1))) '(:r1))
		(vpif '(:r1 = 0))
			(load-node-id :rsp slot_node_id :r1 :r2)
			(save-node-id :r0 lk_shmem_host_a :r1 :r2)
			;wait a fraction for bus propagation / simultaneous write collisions
			(call :sys_task :sleep '(100))
		(endif)

		;verify who won host_a
		(assign `((:rsp slot_mem) (:rsp ,(+ slot_node_id +node_id_node1))) '(:r0 :r1))
		(assign `((:r0 ,(+ lk_shmem_host_a +node_id_node1))) '(:r2))
		(vp-cpy-cr 1 :r3)
		(vpif '(:r2 /= :r1))
			(vp-xor-rr :r3 :r3)
			;register as guest in host_b
			(load-node-id :rsp slot_node_id :r1 :r2)
			(save-node-id :r0 lk_shmem_host_b :r1 :r2)
		(endif)

		;the in and out links have lk_node, here, and the shared memory till
		;each says it has gone, live, the last thing it does
		(vp-cpy-cr 2 :r4)
		(save-fields :rsp '(slot_is_owner slot_live) '(:r3 :r4))

		;start out link and in link
		(link-start :out)
		(link-start :in)

		;wait till link dies or told to quit...
		(loop-start)
			(call :sys_task :sleep '(100000))
			(assign `((:rsp ,(+ slot_lk_node lk_node_task_count) ui)) '(:r0))
			(breakif '(:r0 = -1))
		(loop-end)

		;wait for the in and out links to go before the memory is unmapped
		;and lk_node goes with this frame: a time is not enough, the out link
		;waits on its peer's process for some of it. The link is said to be
		;closed again each time, a ping read can undo it
		(loop-start)
			(vp-cpy-cr -1 :r0)
			(assign '(:r0) `((:rsp ,(+ slot_lk_node lk_node_task_count) ui)))
			(call :sys_task :sleep '(1000))
			(assign '((:rsp slot_live)) '(:r0))
		(loop-until '(:r0 = 0))

		;unmap object
		(call :host_os :pii_munmap `((:rsp slot_mem) ,lk_shmem_size ,+mmap_shared))
	(else)
		(call :host_os :pii_write_str '(2 "Link: no shared memory, or the other end's is another size, another build !\n"))
	(endif)

	;remove link node from link array, and once it is gone the walk is over:
	;the array is one shorter than its end says
	(assign '((:rsp slot_statics)) '(:r0))
	(call :array :get_both '((:r0 statics_sys_mail_links_array)) '(_ :r1 :r2))
	(vp-lea-rcr :rsp slot_lk_node :r3)
	(loop-while '(:r1 /= :r2))
		(assign '((:r1 0)) '(:r0))
		(vpif '(:r0 = :r3))
			(assign '((:rsp slot_statics)) '(:r0))
			(call :array :erase '((:r0 statics_sys_mail_links_array) :r1))
			(goto 'link_removed)
		(endif)
		(vp-add-cr +ptr_size :r1)
	(loop-end)
(vp-label 'link_removed)

	;close it
	(load-fields :rsp '(slot_pdata slot_handle) '(:r0 :r1))
	(vp-lea-rcr :r1 1 :r2)
	(vpif '(:r2 > 1))
		(call :host_os :pii_close_shared '(:r0 :r1))
	(endif)

	;free params msg
	(call :sys_mail :free '((:rsp slot_params)))

	;restore task count
	(call :sys_task :count '(3))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :sys_link :in)
	;trashes
	;:r0-:r10, :d0-:d15

	(structure slot 0
		(ptr lk_node msg data rx head live)
		(nodeid node_id)
		(long is_owner)
		(uint length sleep_time quiet))

	(vp-alloc slot_size)

	;read params msg
	(call :sys_mail :mymail :nil '(:r0 :r1))
	(assign '((:r1 0) (:r1 +ptr_size) (:r1 (* 2 +ptr_size)) (:r1 (* 3 +ptr_size))) '(:r2 :r3 :r4 :r5))
	(save-fields :rsp '(slot_lk_node slot_rx slot_is_owner slot_live) '(:r2 :r3 :r4 :r5))
	(call :sys_mail :free '(:r0))

	;switch to link priority
	(call :sys_task :set_priority '(tk_in_link_priority))

	;assign rx channel deterministically based on leadership
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp slot_node_id :r0 :r1)
	(load-fields :rsp '(slot_rx slot_is_owner) '(:r0 :r2))
	(vpif '(:r2 /= 0))
		(vp-add-cr lk_shmem_chan_2 :r0)
	(else)
		(vp-add-cr lk_shmem_chan_1 :r0)
	(endif)
	(vp-cpy-cr lk_sleep_min :r1)
	(vp-xor-rr :r2 :r2)
	(save-fields :rsp '(slot_rx slot_head slot_sleep_time slot_quiet) '(:r0 :r0 :r1 :r2))

	;read messages from the shared buffer
	(loop-start)
		;check for received message, head :r0, status :r1
		(loop-start)
			(assign '((:rsp slot_head)) '(:r0))
			(assign '((:r0 lk_buf_status)) '(:r1))
			(breakif `(:r1 = ,lk_chan_status_ready))
			;just a skip ?
			(vp-sync)
			(assign '((:r0 lk_buf_length)) '(:r2))
			(assign '(:r2) '((:rsp slot_length)))
			(gotoif `(:r1 = ,lk_chan_status_skip) 'skip)

			(vpif `(:r1 = ,lk_chan_status_ping))
				;read neighbor task count, process id, peer node id, and peer system id
				(vp-rdef (src dst t0 t1 t2 t3 t4 t5))
				(assign '((& :r0 lk_buf_size) (:rsp slot_lk_node)) `(,src ,dst))
				(assign-fields
					src
						`(,(+ lk_node_peer_node_id +node_id_node1) ,(+ lk_node_peer_node_id +node_id_node2)
						,(+ lk_node_peer_system_id +node_id_node1) ,(+ lk_node_peer_system_id +node_id_node2)
						lk_node_task_count lk_node_peer_pid)
					dst
						`(,(+ lk_node_peer_node_id +node_id_node1) ,(+ lk_node_peer_node_id +node_id_node2)
						,(+ lk_node_peer_system_id +node_id_node1) ,(+ lk_node_peer_system_id +node_id_node2)
						lk_node_task_count lk_node_peer_pid)
					`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5))
				;clear status
			(vp-label 'skip)
				(assign '((:rsp slot_head)) '(:r0))
				(vp-cpy-cr lk_chan_status_ready :r1)
				(assign '(:r1) '((:r0 lk_buf_status)))
			(elseif `(:r1 = ,lk_chan_status_frag))
				;reset to min poling
				(vp-cpy-cr lk_sleep_min :r1)
				(vp-xor-rr :r2 :r2)
				(save-fields :rsp '(slot_sleep_time slot_quiet) '(:r1 :r2))

				;is this msg part of a parcel for this node
				(assign `((:r0 ,(+ lk_buf_size lk_frag_total) ui)
						(:r0 ,(+ lk_buf_size lk_frag_dest +net_id_node_id +node_id_node1))
						(:r0 ,(+ lk_buf_size lk_frag_dest +net_id_node_id +node_id_node2)))
					'(:r1 :r2 :r3))
				(load-node-id :rsp slot_node_id :r4 :r5)
				(vpif '(:r1 /= 0) '(:r2 = :r4) '(:r3 = :r5))
					;copy direct from link buffer to parcel !
					(assign '((:rsp slot_rx)) '(:r2))
					(vp-cpy-rr :r0 :r1)
					(vp-add-cr lk_buf_size :r0)
					(call :sys_mail :in `(:r0 :r1 :r2 ,lk_chan_size))
				(else)
					;allocate msg, copy frag data
					(call :sys_mail :alloc `((:r0 ,(+ lk_buf_size lk_frag_length) ui)) '(:r0 :r1))
					(save-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
					(vp-rdef (msg rx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
					(assign '((:rsp slot_head)) `(,rx_frag))
					(vp-add-cr lk_buf_size rx_frag)
					(assign-fields
						rx_frag
							`(lk_frag_length lk_frag_offset lk_frag_total
							,(+ lk_frag_dest +net_id_mbox_id)
							,(+ lk_frag_dest +net_id_node_id +node_id_node1)
							,(+ lk_frag_dest +net_id_node_id +node_id_node2)
							,(+ lk_frag_src +net_id_mbox_id)
							,(+ lk_frag_src +net_id_node_id +node_id_node1)
							,(+ lk_frag_src +net_id_node_id +node_id_node2))
						msg
							`(+msg_length +msg_offset +msg_total
							,(+ +msg_dest +net_id_mbox_id)
							,(+ +msg_dest +net_id_node_id +node_id_node1)
							,(+ +msg_dest +net_id_node_id +node_id_node2)
							,(+ +msg_src +net_id_mbox_id)
							,(+ +msg_src +net_id_node_id +node_id_node1)
							,(+ +msg_src +net_id_node_id +node_id_node2))
						`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
					(load-fields :rsp '(slot_data slot_rx slot_head) '(:r1 :r4 :r0))
					(assign `((:r0 ,(+ lk_buf_size lk_frag_length) ui)) '(:r2))
					(vp-add-cr (+ lk_buf_size lk_frag_size) :r0)
					(call :sys_mem :copy_from_ring `(:r0 :r1 :r2 ,lk_chan_size :r4))

					;clear status
					;overlap the :send with new receive !
					(vp-sync)
					(assign '((:rsp slot_head)) '(:r0))
					(vp-cpy-cr lk_chan_status_ready :r1)
					(assign '(:r1) '((:r0 lk_buf_status)))

					;send onwards
					(call :sys_mail :send '((:rsp slot_msg)))
				(endif)
			(endif)

			;move on to next transfer
			(load-fields :rsp '(slot_rx slot_head slot_length) '(:r1 :r0 :r2))
			(vp-add-cr lk_chan_size :r1)
			(vp-add-rr :r2 :r0)
			(vpif '(:r0 >= :r1))
				(vp-sub-cr lk_chan_size :r0)
			(endif)
			(assign '(:r0) '((:rsp slot_head)))

			;let other links run
			(call :sys_task :sleep '(0))
		(loop-end)

		;small sleep as nothing to do
		;the sleep doubles, to lk_sleep_max, so mail goes through quickly
		;while there is some. A link that has had none for lk_quiet sleeps
		;goes on to lk_sleep_idle, an idle network should not be busy.
		(call :sys_task :sleep '((:rsp slot_sleep_time)))
		(load-fields :rsp '(slot_sleep_time slot_quiet) '(:r0 :r1))
		(vp-shl-cr 1 :r0)
		(vp-add-cr 1 :r1)
		(vpif `(:r1 > ,lk_quiet))
			(vp-cpy-cr (+ lk_quiet 1) :r1)
			(vpif `(:r0 > ,lk_sleep_idle))
				(vp-cpy-cr lk_sleep_idle :r0)
			(endif)
		(elseif `(:r0 > ,lk_sleep_max))
			(vp-cpy-cr lk_sleep_max :r0)
		(endif)
		(save-fields :rsp '(slot_sleep_time slot_quiet) '(:r0 :r1))

		;exit if link closed
		(assign '((:rsp slot_lk_node)) '(:r0))
		(assign '((:r0 lk_node_task_count)) '(:r0))
		(breakif '(:r0 = -1))
	(loop-end)

	;gone, the last thing done with lk_node's frame
	(assign '((:rsp slot_live)) '(:r0))
	(assign '((:r0 0)) '(:r1))
	(vp-sub-cr 1 :r1)
	(assign '(:r1) '((:r0 0)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(defun lk-forget-peer ()
	;emit the end of the peer's node, when its process is seen to be gone.
	;It is no longer a way to any node. Those it was the only way to, and
	;it is that to itself, can not be reached from here now. They are not
	;taken from the node map, they are left in it with no way to them, not
	;listed, till the kick the ping task gives as it sees the link change
	;runs their time out. See +node_hops_none in sys/mail/class.inc.
	(assign '((:rsp slot_statics) (:rsp slot_lk_node)) '(:r0 :r2))
	(call :hmap :each '((:r0 statics_sys_mail_node_map) ($ behind_callback) (& :r2 lk_node_peer_node_id))))

(def-method :sys_link :out)
	;trashes
	;:r0-:r14, :d0-:d15

	(structure slot 0
		(ptr statics lk_node key msg data tx head tail live)
		(nodeid node_id system_id)
		(long is_owner then now beat timeout pid checked)
		(ptr last_tail walk)
		(int free)
		(uint last_count sleep_time seen down alive quiet length))

	(vp-alloc slot_size)

	(fn-bind 'sys/statics/statics :r0)
	(assign '(:r0) '((:rsp slot_statics)))
	(call :nodeid :create '(0) '((:rsp slot_key)))

	;read params msg
	(call :sys_mail :mymail :nil '(:r0 :r1))
	(assign '((:r1 0) (:r1 +ptr_size) (:r1 (* 2 +ptr_size)) (:r1 (* 3 +ptr_size))) '(:r2 :r3 :r4 :r5))
	(save-fields :rsp '(slot_lk_node slot_tx slot_is_owner slot_live) '(:r2 :r3 :r4 :r5))
	(call :sys_mail :free '(:r0))

	;switch to link priority
	(call :sys_task :set_priority '(tk_out_link_priority))

	;assign tx channel deterministically based on leadership
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp slot_node_id :r0 :r1)
	(call :sys_kernel :system_id :nil '(:r0 :r1))
	(save-node-id :rsp slot_system_id :r0 :r1)
	(load-fields :rsp '(slot_tx slot_is_owner) '(:r0 :r1))
	(vpif '(:r1 /= 0))
		(vp-add-cr lk_shmem_chan_1 :r0)
	(else)
		(vp-add-cr lk_shmem_chan_2 :r0)
	(endif)
	(assign '(:r0) '((:rsp slot_tx)))
	(call :host_os :pii_time :nil '(:r0))
	(assign `((:rsp slot_tx) ,lk_sleep_min ,lk_timeout) '(:r1 :r2 :r4))
	(vp-xor-rr :r3 :r3)
	(save-fields :rsp '(slot_tx slot_head slot_tail slot_last_tail slot_sleep_time slot_last_count slot_quiet
			slot_then slot_now slot_beat slot_checked slot_seen slot_down slot_timeout)
		'(:r1 :r1 :r1 :r1 :r2 :r3 :r3 :r0 :r0 :r0 :r0 :r3 :r3 :r4))
	(call :host_os :pii_pid :nil '(:r0))
	(vp-cpy-cr 1 :r1)
	(save-fields :rsp '(slot_pid slot_alive) '(:r0 :r1))

	;write messages through the shared buffer
	(loop-start)
		(loop-start 'sleep)
			(assign '((:rsp slot_head)) '(:r0))
			(assign '((:r0 lk_buf_status)) '(:r1))
			(breakif `(:r1 /= ,lk_chan_status_ready) 'sleep)

			;reclaim space, calculate free
			(vp-rdef (head tail tx free status len))
			(load-fields :rsp '(slot_head slot_tail slot_tx) `(,head ,tail ,tx))
			(vp-add-cr lk_chan_size tx)
			(loop-while `(,tail /= ,head))
				(assign `((,tail lk_buf_status)) `(,status))
				(breakif `(,status /= lk_chan_status_ready))
				(vp-sync)
				(assign `((,tail lk_buf_length)) `(,len))
				(vp-add-rr len tail)
				(vpif `(,tail >= ,tx))
					(vp-sub-cr lk_chan_size tail)
				(endif)
			(loop-end)
			(assign `(,tail) '((:rsp slot_tail)))
			(vp-sub-rr head tail)
			(vpif `(,tail <= 0))
				(vp-add-cr lk_chan_size tail)
			(endif)
			(assign `(,tail) '((:rsp slot_free)))

			;the peer is alive if it has taken something from the buffer, or
			;there is nothing left in it to take. That resets the timeout,
			;room in the buffer does not, a dead peer leaves plenty. A peer
			;that has yet to take anything may not have started, so wait.
			;tail :r0, last_tail :r1, seen :r2
			(load-fields :rsp '(slot_tail slot_last_tail slot_seen) '(:r0 :r1 :r2))
			(vpif '(:r0 /= :r1))
				;it has, so if the link was down it is up again. And learn
				;from how long the peer left it, a busy node is not a dead
				;one, so allow this peer twice as long from now on.
				(vpif '(:r2 /= 0))
					(load-fields :rsp '(slot_then slot_now slot_timeout) '(:r3 :r4 :r5))
					(vp-sub-rr :r3 :r4)
					(vp-shl-cr 1 :r4)
					(vpif `(:r4 > ,lk_timeout_max))
						(assign `(,lk_timeout_max) '(:r4))
					(endif)
					(vpif '(:r4 > :r5))
						(assign '(:r4) '((:rsp slot_timeout)))
					(endif)
				(endif)
				(vp-cpy-cr 1 :r2)
				(vp-xor-rr :r3 :r3)
				(save-fields :rsp '(slot_seen slot_down) '(:r2 :r3))
			(endif)
			;taken from, or empty, or not yet seen
			(assign '((:rsp slot_head)) '(:r3))
			(gotoif '(:r0 /= :r1) 'peer_took)
			(gotoif '(:r0 = :r3) 'peer_took)
			(gotoif '(:r2 /= 0) 'peer_kept)
		(vp-label 'peer_took)
			(assign '((:rsp slot_now)) '(:r1))
			(save-fields :rsp '(slot_last_tail slot_then) '(:r0 :r1))
		(vp-label 'peer_kept)

			;need to send a ping ? If my task count has changed, or as a
			;heartbeat, so there is always something for a live peer to take
			(load-fields :rsp '(slot_statics slot_last_count) '(:r0 :r1))
			(assign '((:r0 statics_sys_task_task_count)) '(:r0))
			(gotoif '(:r0 /= :r1) 'ping)
			(load-fields :rsp '(slot_seen slot_down slot_now slot_beat) '(:r0 :r1 :r2 :r3))
			(gotoif '(:r0 = 0) 'no_ping)
			(gotoif '(:r1 /= 0) 'no_ping)
			(vp-sub-rr :r3 :r2)
			(gotoif `(:r2 <= ,lk_beat) 'no_ping)
		(vp-label 'ping)
			;wait for at least one lk_node, plus buf header as we
			;must write another lk_chan_status_ready to halt the :in !
			(assign '((:rsp slot_free)) '(:r0))
			(breakif `(:r0 < ,(+ lk_node_size lk_buf_size)) 'sleep)

			;what was learned of a busy peer fades, so one that then
			;dies is not waited on for long
			(load-fields :rsp '(slot_now slot_timeout) '(:r0 :r1))
			(assign '(:r0) '((:rsp slot_beat)))
			(vp-cpy-rr :r1 :r2)
			(vp-sub-cr lk_timeout :r2)
			(vp-shr-cr 4 :r2)
			(vp-sub-rr :r2 :r1)
			(assign '(:r1) '((:rsp slot_timeout)))

			;write my load, process id, node id, and system id
			(load-fields :rsp '(slot_statics slot_head slot_pid) '(:r1 :r0 :r6))
			(assign '((:r1 statics_sys_task_task_count) (:r1 statics_sys_task_lag)) '(:r2 :r1))
			(vp-add-rr :r2 :r1)
			(assign '(:r2) '((:rsp slot_last_count)))
			(vp-add-cr lk_buf_size :r0)
			(load-node-id :rsp slot_node_id :r2 :r3)
			(load-node-id :rsp slot_system_id :r4 :r5)
			(save-fields :r0
					`(lk_node_task_count
					,(+ lk_node_peer_node_id +node_id_node1) ,(+ lk_node_peer_node_id +node_id_node2)
					,(+ lk_node_peer_system_id +node_id_node1) ,(+ lk_node_peer_system_id +node_id_node2)
					lk_node_peer_pid)
				'(:r1 :r2 :r3 :r4 :r5 :r6))

			;write buf ping, wrap head and trigger :in
			(load-fields :rsp '(slot_head slot_tx) '(:r0 :r1))
			(call 'write_buf `(:r0 :r1 ,lk_chan_status_ping ,(+ lk_buf_size lk_node_size)) '(:r0))
			(assign '(:r0) '((:rsp slot_head)))
			(goto 'yield)
		(vp-label 'no_ping)

			;wait for at least one max fragment, plus buf header as we
			;must write another lk_chan_status_ready to halt the :in !
			(assign '((:rsp slot_free)) '(:r0))
			(breakif `(:r0 < ,(+ lk_buf_size lk_frag_size lk_data_size lk_buf_size)))

			;see if any mail for this link
			(vp-rdef (node1 node2 key lk_node) (method-input :sys_mail :ready))
			(vp-rdef (msg) (method-output :sys_mail :ready))
			(load-fields :rsp '(slot_lk_node slot_key) `(,lk_node ,key))
			(load-node-id lk_node lk_node_peer_node_id node1 node2)
			(call :sys_mail :ready `(,node1 ,node2 ,key) `(,msg))
			(breakif `(,msg = 0))
			(assign `(,msg) '((:rsp slot_msg)))

			;how much this link has carried
			(assign `((:rsp slot_lk_node) (,msg +msg_length)) '(:r4 :r5))
			(assign '((:r4 lk_node_sent)) '(:r6))
			(vp-add-rr :r5 :r6)
			(assign '(:r6) '((:r4 lk_node_sent)))

			;reset to min poling
			(vp-cpy-cr lk_sleep_min :r4)
			(vp-xor-rr :r5 :r5)
			(save-fields :rsp '(slot_sleep_time slot_quiet) '(:r4 :r5))

			;copy frag data
			(vp-rdef (msg tx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
			(load-fields :rsp '(slot_msg slot_head) `(,msg ,tx_frag))
			(vp-add-cr lk_buf_size tx_frag)
			(assign-fields
				msg
					`(+msg_length +msg_offset +msg_total
					,(+ +msg_dest +net_id_mbox_id)
					,(+ +msg_dest +net_id_node_id +node_id_node1)
					,(+ +msg_dest +net_id_node_id +node_id_node2)
					,(+ +msg_src +net_id_mbox_id)
					,(+ +msg_src +net_id_node_id +node_id_node1)
					,(+ +msg_src +net_id_node_id +node_id_node2))
				tx_frag
					`(lk_frag_length lk_frag_offset lk_frag_total
					,(+ lk_frag_dest +net_id_mbox_id)
					,(+ lk_frag_dest +net_id_node_id +node_id_node1)
					,(+ lk_frag_dest +net_id_node_id +node_id_node2)
					,(+ lk_frag_src +net_id_mbox_id)
					,(+ lk_frag_src +net_id_node_id +node_id_node1)
					,(+ lk_frag_src +net_id_node_id +node_id_node2))
				`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
			;the pad, where the ring had what went before
			(vp-cpy-cr 0 t0)
			(assign `(,t0) `((,tx_frag lk_frag_pad)))
			(load-fields :rsp '(slot_msg slot_head slot_tx) '(:r0 :r1 :r4))
			(assign '((:r0 +msg_data) (:r0 +msg_length)) '(:r0 :r2))
			(vp-add-cr (+ lk_buf_size lk_frag_size) :r1)
			(call :sys_mem :copy_to_ring `(:r0 :r1 :r2 ,lk_chan_size :r4))

			;write buf frag, wrap head and trigger :in
			(load-fields :rsp '(slot_msg slot_head slot_tx) '(:r3 :r0 :r1))
			(assign '((:r3 +msg_length)) '(:r3))
			(vp-add-cr (- (+ lk_buf_size lk_frag_size +long_size) 1) :r3)
			(vp-and-cr (- 0 +long_size) :r3)
			(call 'write_buf `(:r0 :r1 ,lk_chan_status_frag :r3) '(:r0))
			(assign '(:r0) '((:rsp slot_head)))

			;free message
			(call :sys_mail :free '((:rsp slot_msg)))

		(vp-label 'yield)
			;do we have enough headroom, as only msg data can wrap ?
			(vp-rdef (head tx status tx_end head_end))
			(load-fields :rsp '(slot_head slot_tx) `(,head ,tx))
			(vp-lea-rcr tx lk_chan_size tx_end)
			(vp-lea-rcr head (+ lk_buf_size lk_frag_size) head_end)
			(vpif `(,head_end > ,tx_end))
				;write buf skip, wrap head and trigger :in
				(vp-sub-rr head tx_end)
				(call 'write_buf `(,head ,tx ,lk_chan_status_skip ,tx_end) '(:r0))
				(assign '(:r0) '((:rsp slot_head)))
			(endif)

			;let other links run
			(call :sys_task :sleep '(0))
		(loop-end)

		;small sleep if nothing to do
		;the sleep doubles, to lk_sleep_max, so mail goes through quickly
		;while there is some. A link that has had none for lk_quiet sleeps
		;goes on to lk_sleep_idle, an idle network should not be busy.
		(call :sys_task :sleep '((:rsp slot_sleep_time)))
		(load-fields :rsp '(slot_sleep_time slot_quiet) '(:r0 :r1))
		(vp-shl-cr 1 :r0)
		(vp-add-cr 1 :r1)
		(vpif `(:r1 > ,lk_quiet))
			(vp-cpy-cr (+ lk_quiet 1) :r1)
			(vpif `(:r0 > ,lk_sleep_idle))
				(vp-cpy-cr lk_sleep_idle :r0)
			(endif)
		(elseif `(:r0 > ,lk_sleep_max))
			(vp-cpy-cr lk_sleep_max :r0)
		(endif)
		(save-fields :rsp '(slot_sleep_time slot_quiet) '(:r0 :r1))

		;if I have not run for a while, this node was busy, or was
		;stopped, that time says nothing about the peer. The last now
		;in :r1, kept over the time call
		(assign '((:rsp slot_now)) '(:r1))
		(call :host_os :pii_time :nil '(:r0))
		(assign '(:r0) '((:rsp slot_now)))
		(vp-cpy-rr :r0 :r2)
		(vp-sub-rr :r1 :r2)
		(vpif `(:r2 > ,lk_stall))
			(assign '((:rsp slot_then)) '(:r3))
			(vp-add-rr :r2 :r3)
			(assign '(:r3) '((:rsp slot_then)))
		(endif)

		;a peer that is not taking from the link is busy, and can not say
		;so. So count the ms it has left the link as its load, till it
		;next says what its load is.
		(load-fields :rsp '(slot_then slot_seen slot_down) '(:r1 :r2 :r3))
		(vpif '(:r2 /= 0) '(:r3 = 0))
			(vp-sub-rr :r1 :r0)
			(vp-cpy-cr lag_per_task :r1)
			(vp-div-rr-u :r1 :r0)
			(assign '((:rsp slot_lk_node)) '(:r1))
			(assign '((:r1 lk_node_task_count)) '(:r2))
			(vpif '(:r0 > :r2))
				(assign '(:r0) '((:r1 lk_node_task_count)))
			(endif)
		(endif)

		;is the peer down ? If it has said what its process is, ask the
		;host each beat if that is still running. A busy peer takes nothing
		;from the link, but its process runs on, so it is not dropped, only
		;one that takes nothing for the max timeout, it is stuck. If its
		;process is not known, it is down if it has taken nothing for
		;longer than the timeout.
		(load-fields :rsp '(slot_lk_node slot_seen slot_down) '(:r0 :r1 :r2))
		(gotoif '(:r2 /= 0) 'no_drop)
		(gotoif '(:r1 = 0) 'no_drop)
		(assign '((:r0 lk_node_peer_pid)) '(:r0))
		(vpif '(:r0 /= 0))
			(load-fields :rsp '(slot_now slot_checked) '(:r1 :r2))
			(vp-cpy-rr :r1 :r3)
			(vp-sub-rr :r2 :r3)
			(vpif `(:r3 > ,lk_beat))
				(assign '(:r1) '((:rsp slot_checked)))
				(call :host_os :pii_alive '(:r0) '(:r0))
				(assign '(:r0) '((:rsp slot_alive)))
			(endif)
			(load-fields :rsp '(slot_alive slot_now slot_then) '(:r0 :r1 :r2))
			(gotoif '(:r0 = 0) 'drop)
			(vp-sub-rr :r2 :r1)
			(gotoif `(:r1 <= ,lk_timeout_max) 'no_drop)
		(else)
			(load-fields :rsp '(slot_now slot_then slot_timeout) '(:r0 :r1 :r2))
			(vp-sub-rr :r1 :r0)
			(gotoif '(:r0 <= :r2) 'no_drop)
		(endif)

	(vp-label 'drop)
		;mark the link down. The peer is forgotten, so nothing is sent this
		;way, and the ping task sees the change and kicks the network. If
		;the peer was just busy, the :in sets it again when it next hears
		;from it, and the link is up again.
		(assign '((:rsp slot_alive)) '(:r0))
		(vpif '(:r0 = 0))
			;its process is gone, that is certain
			(lk-forget-peer)
			;what was put on the link for it and it never took is not
			;lost with it. It is taken back off, and posted again, for
			;another link to take if there is another way there. Only
			;when the process has gone: one that is only busy may yet
			;take what is here, and then it would arrive twice
			(assign '((:rsp slot_tail)) '(:r0))
			(assign '(:r0) '((:rsp slot_walk)))
			(loop-start)
				(load-fields :rsp '(slot_walk slot_head) '(:r0 :r1))
				(breakif '(:r0 = :r1))
				(assign '((:r0 lk_buf_status) (:r0 lk_buf_length)) '(:r1 :r2))
				(assign '(:r2) '((:rsp slot_length)))
				(vpif `(:r1 = ,lk_chan_status_frag))
					(call :sys_mail :alloc `((:r0 ,(+ lk_buf_size lk_frag_length) ui)) '(:r0 :r1))
					(save-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
					(vp-rdef (msg rx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
					(assign '((:rsp slot_walk)) `(,rx_frag))
					(vp-add-cr lk_buf_size rx_frag)
					(assign-fields
						rx_frag
							`(lk_frag_length lk_frag_offset lk_frag_total
							,(+ lk_frag_dest +net_id_mbox_id)
							,(+ lk_frag_dest +net_id_node_id +node_id_node1)
							,(+ lk_frag_dest +net_id_node_id +node_id_node2)
							,(+ lk_frag_src +net_id_mbox_id)
							,(+ lk_frag_src +net_id_node_id +node_id_node1)
							,(+ lk_frag_src +net_id_node_id +node_id_node2))
						msg
							`(+msg_length +msg_offset +msg_total
							,(+ +msg_dest +net_id_mbox_id)
							,(+ +msg_dest +net_id_node_id +node_id_node1)
							,(+ +msg_dest +net_id_node_id +node_id_node2)
							,(+ +msg_src +net_id_mbox_id)
							,(+ +msg_src +net_id_node_id +node_id_node1)
							,(+ +msg_src +net_id_node_id +node_id_node2))
						`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
					(load-fields :rsp '(slot_walk slot_data slot_tx) '(:r0 :r1 :r4))
					(assign `((:r0 ,(+ lk_buf_size lk_frag_length) ui)) '(:r2))
					(vp-add-cr (+ lk_buf_size lk_frag_size) :r0)
					(call :sys_mem :copy_from_ring `(:r0 :r1 :r2 ,lk_chan_size :r4))
					(call :sys_mail :send '((:rsp slot_msg)))
				(endif)
				(load-fields :rsp '(slot_walk slot_length slot_tx) '(:r0 :r1 :r2))
				(vp-cpy-cr lk_chan_status_ready :r3)
				(assign '(:r3) '((:r0 lk_buf_status)))
				(vp-add-rr :r1 :r0)
				(vp-add-cr lk_chan_size :r2)
				(vpif '(:r0 >= :r2))
					(vp-sub-cr lk_chan_size :r0)
				(endif)
				(assign '(:r0) '((:rsp slot_walk)))
			(loop-end)
			(assign '((:rsp slot_head)) '(:r0))
			(save-fields :rsp '(slot_tail slot_last_tail) '(:r0 :r0))
		(endif)
		(vp-cpy-cr 1 :r0)
		(save-fields :rsp '(slot_down slot_alive) '(:r0 :r0))
		(vp-rdef (node zero))
		(assign '((:rsp slot_lk_node) 0) `(,node ,zero))
		(save-fields node
				`(lk_node_peer_pid
				,(+ lk_node_peer_node_id +node_id_node1)
				,(+ lk_node_peer_node_id +node_id_node2)
				,(+ lk_node_peer_system_id +node_id_node1)
				,(+ lk_node_peer_system_id +node_id_node2))
			`(,zero ,zero ,zero ,zero ,zero))
	(vp-label 'no_drop)

		;exit if link closed
		(assign '((:rsp slot_lk_node)) '(:r0))
		(assign '((:r0 lk_node_task_count)) '(:r0))
		(breakif '(:r0 = -1))
	(loop-end)

	;the link was closed. A peer that is exiting closes its links first,
	;so if its process is known, give it a moment to go, and if it has,
	;the node is gone too. If it runs on, it only closed the link.
	(assign '((:rsp slot_lk_node)) '(:r0))
	(assign '((:r0 lk_node_peer_pid)) '(:r0))
	(vpif '(:r0 /= 0))
		(vp-cpy-cr 20 :r0)
		(assign '(:r0) '((:rsp slot_quiet)))
		(loop-start)
			(assign '((:rsp slot_lk_node)) '(:r0))
			(call :host_os :pii_alive '((:r0 lk_node_peer_pid)) '(:r0))
			(assign '(:r0) '((:rsp slot_alive)))
			(breakif '(:r0 = 0))
			(assign '((:rsp slot_quiet)) '(:r0))
			(vp-sub-cr 1 :r0)
			(assign '(:r0) '((:rsp slot_quiet)))
			(breakif '(:r0 = 0))
			(call :sys_task :sleep '(10000))
		(loop-end)
		(assign '((:rsp slot_alive)) '(:r0))
		(vpif '(:r0 = 0))
			(lk-forget-peer)
		(endif)
	(endif)

	(call :nodeid :destroy '((:rsp slot_key)))

	;gone, the last thing done with lk_node's frame
	(assign '((:rsp slot_live)) '(:r0))
	(assign '((:r0 0)) '(:r1))
	(vp-sub-cr 1 :r1)
	(assign '(:r1) '((:r0 0)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'behind_callback)
	;inputs
	;:r0 = predicate data, the node id of the peer that has gone (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)
	;info
	;the peer is taken out of the ways to this node. If it was the only
	;one, the node has no way to it now

	(vp-rdef (data iter dst tuple vias end pid1 pid2 vid1 vid2 dif1 dif2))

	(entry :hmap :each_callback `(,data ,iter ,dst))

	(assign `((,iter ,+ptr_size)) `(,tuple))
	(load-node-id data 0 pid1 pid2)
	(class/array/get_both tuple vias end)
	(vp-add-cr (* +node_vias +long_size) vias)
	(vp-cpy-rr vias dst)
	(loop-while `(,vias < ,end))
		(assign `((,vias 0) (,vias ,+long_size)) `(,vid1 ,vid2))
		(vp-add-cr (* 2 +long_size) vias)
		(vp-cpy-rr vid1 dif1)
		(vp-cpy-rr vid2 dif2)
		(vp-sub-rr pid1 dif1)
		(vp-sub-rr pid2 dif2)
		(vp-or-rr dif2 dif1)
		(vpif `(,dif1 /= 0))
			(assign `(,vid1 ,vid2) `((,dst 0) (,dst ,+long_size)))
			(vp-add-cr (* 2 +long_size) dst)
		(endif)
	(loop-end)
	(vpif `(,dst < ,vias))
		;it was one of them
		(assign `((,tuple +array_begin)) `(,vias))
		(vp-sub-rr vias dst)
		(vp-shr-cr (log2 +long_size) dst)
		(assign `(,dst) `((,tuple +array_length)))
		(vpif `(,dst = ,+node_vias))
			;and the only one
			(vp-cpy-cr +node_hops_none vid1)
			(assign `(,vid1) `((,vias ,(* +node_hops +long_size))))
			;the peer itself will not be heard again
			(assign `((,iter 0)) `(,end))
			(load-node-id end +str_data vid1 vid2)
			(vp-sub-rr pid1 vid1)
			(vp-sub-rr pid2 vid2)
			(vp-or-rr vid2 vid1)
			(vpif `(,vid1 = 0))
				(vp-cpy-cr +node_session_gone vid1)
				(assign `(,vid1 ,vid1) `((,vias ,(* +node_session_cluster +long_size))
					(,vias ,(* +node_session_sys +long_size))))
			(endif)
		(endif)
	(endif)
	(vp-ret)

(vp-label 'write_buf)
	;inputs
	;r0 = head ptr
	;r1 = ring ptr
	;r2 = buf type
	;r3 = buf size
	;outputs
	;r0 = head ptr
	;trashes
	;:r0-:r4

	(vp-rdef (head ring type size old_head))

	;write size
	(assign `(,size ,head) `((,head lk_buf_length) ,old_head))
	;move on to next transfer, clear new status !
	(vp-add-rr size head)
	(vp-add-cr lk_chan_size ring)
	(vpif `(,head >= ,ring))
		(vp-sub-cr lk_chan_size head)
	(endif)
	(assign `(,lk_chan_status_ready) `(,size))
	(assign `(,size) `((,head lk_buf_status)))
	;allow read from :in
	(vp-sync)
	(assign `(,type) `((,old_head lk_buf_status)))
	(vp-ret)

(def-func-end)
