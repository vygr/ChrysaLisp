(include "lib/asm/func.inc")
(include "class/nodeid/class.inc")
(include "class/hmap/class.inc")
(include "./class.inc")
(include "././kernel/class.inc")

(def-method :sys_link :link)
	;started by kernel for each link
	;trashes
	;:r0-:r7, :f0-:f15

	(def-vars
		(struct lk_node lk_node_size)
		(ptr statics params msg data mem)
		(pptr iter_begin iter_end)
		(pubyte pdata)
		(long handle is_owner live)
		(nodeid node_id))

	(push-scope)

	;decrement task count
	;don't count links in load balancing
	(call :sys_task :count '(-3))

	;init and add link node to link array
	(assign (vpx (@ sys/statics/statics)) (vpx statics))
	(call :sys_kernel :id :nil (vpx (. node_id +node_id_node1) (. node_id +node_id_node2)))
	(vp-rdef (node zero))
	(assign (vpx (& lk_node) 0) `(,node ,zero))
	(save-fields node
			`(lk_node_task_count lk_node_peer_pid lk_node_sent lk_node_remote
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		`(,zero ,zero ,zero ,zero ,zero ,zero ,zero ,zero))
	(call :array :push_back (vpx (.> statics statics_sys_mail_links_array) (& lk_node)))

	;read params msg from kernel
	(call :sys_mail :mymail :nil (vpx params pdata))

	;open shared memory file
	(call :host_os :pii_open_shared (vpx pdata lk_shmem_size) (vpx handle))

	;map shared object
	(call :host_os :pii_mmap (vpx lk_shmem_size handle +mmap_shared) (vpx mem))

	;no shared memory, no link. The host gives 0 or -1 for one it could
	;not make or map, and there is nothing at either to claim
	(vpif (vpx (> (+ mem 1) 1)))
		;try to claim host_a (embedded in chan_1 alignment padding)
		(vpifnot (vpx (. (.> mem lk_shmem_host_a) +node_id_node1)))
			(assign (vpx (. node_id +node_id_node1) (. node_id +node_id_node2))
				(vpx (. (.> mem lk_shmem_host_a) +node_id_node1) (. (.> mem lk_shmem_host_a) +node_id_node2)))
			;wait a fraction for bus propagation / simultaneous write collisions
			(call :sys_task :sleep '(100))
		(endif)

		;verify who won host_a
		(assign (vpx 1) (vpx is_owner))
		(vpif (vpx (/= (. (.> mem lk_shmem_host_a) +node_id_node1) (. node_id +node_id_node1))))
			(assign (vpx 0) (vpx is_owner))
			;register as guest in host_b
			(assign (vpx (. node_id +node_id_node1) (. node_id +node_id_node2))
				(vpx (. (.> mem lk_shmem_host_b) +node_id_node1) (. (.> mem lk_shmem_host_b) +node_id_node2)))
		(endif)

		;the in and out links have lk_node, here, and the shared memory till
		;each says it has gone, live, the last thing it does
		(assign (vpx 2) (vpx live))

		;start out link and send params
		(call :sys_mail :alloc (vpx 32) (vpx msg data))
		(call :sys_task :start (vpx (@ ,(f-path :sys_link :out))) '(_ _ :r2 :r3 :r4))
		(assign (vpx msg data (& lk_node) mem is_owner) '(:r0 :r1 :r5 :r6 :r7))
		(save-net-id :r0 +msg_dest)
		(assign '(:r5 :r6 :r7) '((:r1 0) (:r1 +ptr_size) (:r1 (* 2 +ptr_size))))
		(assign (vpx (& live)) '(:r5))
		(assign '(:r5) '((:r1 (* 3 +ptr_size))))
		(call :sys_mail :send '(:r0))

		;start in link and send params
		(call :sys_mail :alloc (vpx 32) (vpx msg data))
		(call :sys_task :start (vpx (@ ,(f-path :sys_link :in))) '(_ _ :r2 :r3 :r4))
		(assign (vpx msg data (& lk_node) mem is_owner) '(:r0 :r1 :r5 :r6 :r7))
		(save-net-id :r0 +msg_dest)
		(assign '(:r5 :r6 :r7) '((:r1 0) (:r1 +ptr_size) (:r1 (* 2 +ptr_size))))
		(assign (vpx (& live)) '(:r5))
		(assign '(:r5) '((:r1 (* 3 +ptr_size))))
		(call :sys_mail :send '(:r0))

		;wait till link dies or told to quit...
		(loop-start)
			(call :sys_task :sleep '(100000))
			(breakif (vpx (= (. lk_node lk_node_task_count) (- 1))))
		(loop-end)

		;wait for the in and out links to go before the memory is unmapped
		;and lk_node goes with this frame: a time is not enough, the out link
		;waits on its peer's process for some of it. The link is said to be
		;closed again each time, a ping read can undo it
		(loop-start)
			(assign (vpx (- 1)) (vpx (. lk_node lk_node_task_count)))
			(call :sys_task :sleep '(1000))
		(loop-until (vpx (= live 0)))

		;unmap object
		(call :host_os :pii_munmap (vpx mem lk_shmem_size +mmap_shared))
	(else)
		(call :host_os :pii_write_str '(2 "Link: no shared memory, or the other end's is another size, another build !\n"))
	(endif)

	;remove link node from link array, and once it is gone the walk is over:
	;the array is one shorter than its end says
	(call :array :get_both (vpx (.> statics statics_sys_mail_links_array)) (vpx _ iter_begin iter_end))
	(loop-while (vpx (/= iter_begin iter_end)))
		(vpif (vpx (= (* iter_begin) (& lk_node))))
			(call :array :erase (vpx (.> statics statics_sys_mail_links_array) iter_begin))
			(goto 'link_removed)
		(endif)
		(assign (vpx (+ iter_begin +ptr_size)) (vpx iter_begin))
	(loop-end)
(vp-label 'link_removed)

	;close it
	(vpif (vpx (> (+ handle 1) 1)))
		(call :host_os :pii_close_shared (vpx pdata handle))
	(endif)

	;free params msg
	(call :sys_mail :free (vpx params))

	;restore task count
	(call :sys_task :count '(3))
	(pop-scope)
	(return)

(def-func-end)

(def-method :sys_link :in)
	;trashes
	;:r0-:r10, :f0-:f15

	(def-vars
		(ptr lk_node msg data rx head live)
		(nodeid node_id)
		(long is_owner)
		(uint length status sleep_time quiet))

	(push-scope)

	;read params msg
	(call :sys_mail :mymail :nil (vpx msg data))
	(assign (vpx (ptr (+ data 0))) (vpx lk_node))
	(assign (vpx (ptr (+ data +ptr_size))) (vpx rx))
	(assign (vpx (ptr (+ data (* 2 +ptr_size)))) (vpx is_owner))
	(assign (vpx (ptr (+ data (* 3 +ptr_size)))) (vpx live))
	(call :sys_mail :free (vpx msg))

	;switch to link priority
	(call :sys_task :set_priority '(tk_in_link_priority))

	;assign rx channel deterministically based on leadership
	(call :sys_kernel :id :nil (vpx (. node_id +node_id_node1) (. node_id +node_id_node2)))
	(vpif (vpx is_owner))
		(assign (vpx (+ rx lk_shmem_chan_2)) (vpx rx))
	(else)
		(assign (vpx (+ rx lk_shmem_chan_1)) (vpx rx))
	(endif)
	(assign (vpx rx lk_sleep_min 0) (vpx head sleep_time quiet))

	;read messages from the shared buffer
	(loop-start)
		;check for received message
		(loop-while (vpx (/= (=> (.> head lk_buf_status) status) lk_chan_status_ready)))
			;just a skip ?
			(vp-sync)
			(assign (vpx (.> head lk_buf_length)) (vpx length))
			(gotoif (vpx (= status lk_chan_status_skip)) 'skip)

			(vpif (vpx (= status lk_chan_status_ping)))
				;read neighbor task count, process id, peer node id, and peer system id
				(vp-rdef (src dst t0 t1 t2 t3 t4 t5))
				(assign (vpx (& (.> head lk_buf_size)) lk_node) `(,src ,dst))
				(assign-fields
					src
						`(,(+ lk_node_peer_node_id +node_id_node1) ,(+ lk_node_peer_node_id +node_id_node2)
						,(+ lk_node_peer_system_id +node_id_node1) ,(+ lk_node_peer_system_id +node_id_node2)
						lk_node_task_count lk_node_peer_pid)
					dst
						`(,(+ lk_node_peer_node_id +node_id_node1) ,(+ lk_node_peer_node_id +node_id_node2)
						,(+ lk_node_peer_system_id +node_id_node1) ,(+ lk_node_peer_system_id +node_id_node2)
						lk_node_task_count lk_node_peer_pid)
					`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5))
				;clear status
			(vp-label 'skip)
				(assign (vpx lk_chan_status_ready) (vpx (.> head lk_buf_status)))
			(elseif (vpx (= status lk_chan_status_frag)))
				;reset to min poling
				(assign (vpx lk_sleep_min 0) (vpx sleep_time quiet))

				;is this msg part of a parcel for this node
				(vpif (vpx (&& (. (.> head lk_buf_size) lk_frag_total) (= (. (.> head lk_buf_size) lk_frag_dest +net_id_node_id +node_id_node1) (. node_id +node_id_node1)) (= (. (.> head lk_buf_size) lk_frag_dest +net_id_node_id +node_id_node2) (. node_id +node_id_node2)))))
					;copy direct from link buffer to parcel !
					(call :sys_mail :in (vpx (& (.> head lk_buf_size)) head rx lk_chan_size))
				(else)
					;allocate msg, copy frag data
					(call :sys_mail :alloc (vpx (. (.> head lk_buf_size) lk_frag_length)) (vpx msg data))
					(vp-rdef (msg rx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
					(assign (vpx msg (& (.> head lk_buf_size))) `(,msg ,rx_frag))
					(assign-fields
						rx_frag
							`(lk_frag_length lk_frag_offset lk_frag_total
							,(+ lk_frag_dest +net_id_mbox_id)
							,(+ lk_frag_dest +net_id_node_id +node_id_node1)
							,(+ lk_frag_dest +net_id_node_id +node_id_node2)
							,(+ lk_frag_src +net_id_mbox_id)
							,(+ lk_frag_src +net_id_node_id +node_id_node1)
							,(+ lk_frag_src +net_id_node_id +node_id_node2))
						msg
							`(+msg_length +msg_offset +msg_total
							,(+ +msg_dest +net_id_mbox_id)
							,(+ +msg_dest +net_id_node_id +node_id_node1)
							,(+ +msg_dest +net_id_node_id +node_id_node2)
							,(+ +msg_src +net_id_mbox_id)
							,(+ +msg_src +net_id_node_id +node_id_node1)
							,(+ +msg_src +net_id_node_id +node_id_node2))
						`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
					(call :sys_mem :copy_from_ring (vpx (& (. (.> head lk_buf_size) lk_frag_size))
						data (. (.> head lk_buf_size) lk_frag_length) lk_chan_size rx))

					;clear status
					;overlap the :send with new receive !
					(vp-sync)
					(assign (vpx lk_chan_status_ready) (vpx (.> head lk_buf_status)))

					;send onwards
					(call :sys_mail :send (vpx msg))
				(endif)
			(endif)

			;move on to next transfer
			(vp-rdef (head rx len))
			(assign (vpx head rx length) `(,head ,rx ,len))
			(vp-add-cr lk_chan_size rx)
			(vp-add-rr len head)
			(vpif `(,head >= ,rx))
				(vp-sub-cr lk_chan_size head)
			(endif)
			(assign `(,head) (vpx head))

			;let other links run
			(call :sys_task :sleep '(0))
		(loop-end)

		;small sleep as nothing to do
		;the sleep doubles, to lk_sleep_max, so mail goes through quickly
		;while there is some. A link that has had none for lk_quiet sleeps
		;goes on to lk_sleep_idle, an idle network should not be busy.
		(call :sys_task :sleep (vpx sleep_time))
		(assign (vpx (<< sleep_time 1) (+ quiet 1)) (vpx sleep_time quiet))
		(vpif (vpx (> quiet lk_quiet)))
			(assign (vpx (+ lk_quiet 1)) (vpx quiet))
			(vpif (vpx (> sleep_time lk_sleep_idle)))
				(assign (vpx lk_sleep_idle) (vpx sleep_time))
			(endif)
		(elseif (vpx (> sleep_time lk_sleep_max)))
			(assign (vpx lk_sleep_max) (vpx sleep_time))
		(endif)

		;exit if link closed
		(breakif (vpx (= (.> lk_node lk_node_task_count) (- 1))))
	(loop-end)

	;gone, the last thing done with lk_node's frame
	(assign (vpx live) '(:r0))
	(assign '((:r0 0)) '(:r1))
	(vp-sub-cr 1 :r1)
	(assign '(:r1) '((:r0 0)))
	(pop-scope)
	(return)

(def-func-end)

(defun lk-forget-peer ()
	;emit the end of the peer's node, when its process is seen to be gone.
	;It is no longer a way to any node. Those it was the only way to, and
	;it is that to itself, can not be reached from here now. They are not
	;taken from the node map, they are left in it with no way to them, not
	;listed, till the kick the ping task gives as it sees the link change
	;runs their time out. See +node_hops_none in sys/mail/class.inc.
	(call :hmap :each (vpx (.> statics statics_sys_mail_node_map) ($ behind_callback)
		(& (.> lk_node lk_node_peer_node_id)))))

(def-method :sys_link :out)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(ptr statics lk_node key msg data tx head tail live)
		(nodeid node_id system_id)
		(long is_owner then now beat last gap timeout pid checked)
		(ptr last_tail walk)
		(int free)
		(uint last_count sleep_time seen down alive drop quiet status length))

	(push-scope)

	(assign (vpx (@ sys/statics/statics)) (vpx statics))
	(call :nodeid :create '(0) (vpx key))

	;read params msg
	(call :sys_mail :mymail :nil (vpx msg data))
	(assign (vpx (ptr (+ data 0))) (vpx lk_node))
	(assign (vpx (ptr (+ data +ptr_size))) (vpx tx))
	(assign (vpx (ptr (+ data (* 2 +ptr_size)))) (vpx is_owner))
	(assign (vpx (ptr (+ data (* 3 +ptr_size)))) (vpx live))
	(call :sys_mail :free (vpx msg))

	;switch to link priority
	(call :sys_task :set_priority '(tk_out_link_priority))

	;assign tx channel deterministically based on leadership
	(call :sys_kernel :id :nil (vpx (. node_id +node_id_node1) (. node_id +node_id_node2)))
	(call :sys_kernel :system_id :nil (vpx (. system_id +node_id_node1) (. system_id +node_id_node2)))
	(vpif (vpx is_owner))
		(assign (vpx (+ tx lk_shmem_chan_1)) (vpx tx))
	(else)
		(assign (vpx (+ tx lk_shmem_chan_2)) (vpx tx))
	(endif)
	(call :host_os :pii_time :nil (vpx then))
	(assign (vpx tx tx lk_sleep_min 0 0) (vpx head tail sleep_time last_count quiet))
	(assign (vpx tx then then 0 0 lk_timeout) (vpx last_tail now beat seen down timeout))
	(call :host_os :pii_pid :nil (vpx pid))
	(assign (vpx then 1) (vpx checked alive))

	;write messages through the shared buffer
	(loop-start)
		(loop-while (vpx (= (.> head lk_buf_status) lk_chan_status_ready)) 'sleep)
			;reclaim space, calculate free
			(vp-rdef (head tail tx free status len))
			(assign (vpx head tail tx) `(,head ,tail ,tx))
			(vp-add-cr lk_chan_size tx)
			(loop-while `(,tail /= ,head))
				(assign `((,tail lk_buf_status)) `(,status))
				(breakif `(,status /= lk_chan_status_ready))
				(vp-sync)
				(assign `((,tail lk_buf_length)) `(,len))
				(vp-add-rr len tail)
				(vpif `(,tail >= ,tx))
					(vp-sub-cr lk_chan_size tail)
				(endif)
			(loop-end)
			(assign `(,tail) (vpx tail))
			(vp-sub-rr head tail)
			(vpif `(,tail <= 0))
				(vp-add-cr lk_chan_size tail)
			(endif)
			(assign `(,tail) (vpx free))

			;the peer is alive if it has taken something from the buffer, or
			;there is nothing left in it to take. That resets the timeout,
			;room in the buffer does not, a dead peer leaves plenty. A peer
			;that has yet to take anything may not have started, so wait.
			(vpif (vpx (/= tail last_tail)))
				;it has, so if the link was down it is up again. And learn
				;from how long the peer left it, a busy node is not a dead
				;one, so allow this peer twice as long from now on.
				(vpif (vpx seen))
					(assign (vpx (* (- now then) 2)) (vpx gap))
					(vpif (vpx (> gap lk_timeout_max)))
						(assign (vpx lk_timeout_max) (vpx gap))
					(endif)
					(vpif (vpx (> gap timeout)))
						(assign (vpx gap) (vpx timeout))
					(endif)
				(endif)
				(assign (vpx 1 0) (vpx seen down))
			(endif)
			(vpif (vpx (|| (/= tail last_tail) (= tail head) (= seen 0))))
				(assign (vpx tail now) (vpx last_tail then))
			(endif)

			;need to send a ping ? If my task count has changed, or as a
			;heartbeat, so there is always something for a live peer to take
			(vpif (vpx (|| (/= (.> statics statics_sys_task_task_count) last_count) (&& seen (= down 0) (> (- now beat) lk_beat)))))
				;wait for at least one lk_node, plus buf header as we
				;must write another lk_chan_status_ready to halt the :in !
				(breakif (vpx (< free (+ lk_node_size lk_buf_size))) 'sleep)
				(assign (vpx now) (vpx beat))

				;what was learned of a busy peer fades, so one that then
				;dies is not waited on for long
				(assign (vpx (- timeout (>> (- timeout lk_timeout) 4))) (vpx timeout))

				;write my load, process id, node id, and system id
				(vp-rdef (dst cnt t0 t1 t2 t3 t4))
				(assign (vpx (& (.> head lk_buf_size)) (+ (.> statics statics_sys_task_task_count) (.> statics statics_sys_task_lag))
						(. node_id +node_id_node1) (. node_id +node_id_node2)
						(. system_id +node_id_node1) (. system_id +node_id_node2) pid)
					`(,dst ,cnt ,t0 ,t1 ,t2 ,t3 ,t4))
				(save-fields
					dst
						`(lk_node_task_count
						,(+ lk_node_peer_node_id +node_id_node1) ,(+ lk_node_peer_node_id +node_id_node2)
						,(+ lk_node_peer_system_id +node_id_node1) ,(+ lk_node_peer_system_id +node_id_node2)
						lk_node_peer_pid)
					`(,cnt ,t0 ,t1 ,t2 ,t3 ,t4))
				(assign (vpx (.> statics statics_sys_task_task_count)) (vpx last_count))

				;write buf ping, wrap head and trigger :in
				(call 'write_buf (vpx head tx lk_chan_status_ping (+ lk_buf_size lk_node_size)) (vpx head))
				(goto 'yield)
			(endif)

			;wait for at least one max fragment, plus buf header as we
			;must write another lk_chan_status_ready to halt the :in !
			(breakif (vpx (< free (+ lk_buf_size lk_frag_size lk_data_size lk_buf_size))))

			;see if any mail for this link
			(vp-rdef (node1 node2 key lk_node) (method-input :sys_mail :ready))
			(vp-rdef (msg) (method-output :sys_mail :ready))
			(assign (vpx lk_node key) `(,lk_node ,key))
			(load-node-id lk_node lk_node_peer_node_id node1 node2)
			(call :sys_mail :ready `(,node1 ,node2 ,key) `(,msg))
			(breakif `(,msg = 0))
			(assign `(,msg) (vpx msg))

			;how much this link has carried
			(assign (vpx (+ (.> lk_node lk_node_sent) (.> msg +msg_length))) (vpx (.> lk_node lk_node_sent)))

			;reset to min poling
			(assign (vpx lk_sleep_min 0) (vpx sleep_time quiet))

			;copy frag data
			(vp-rdef (msg tx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
			(assign (vpx msg (& (.> head lk_buf_size))) `(,msg ,tx_frag))
			(assign-fields
				msg
					`(+msg_length +msg_offset +msg_total
					,(+ +msg_dest +net_id_mbox_id)
					,(+ +msg_dest +net_id_node_id +node_id_node1)
					,(+ +msg_dest +net_id_node_id +node_id_node2)
					,(+ +msg_src +net_id_mbox_id)
					,(+ +msg_src +net_id_node_id +node_id_node1)
					,(+ +msg_src +net_id_node_id +node_id_node2))
				tx_frag
					`(lk_frag_length lk_frag_offset lk_frag_total
					,(+ lk_frag_dest +net_id_mbox_id)
					,(+ lk_frag_dest +net_id_node_id +node_id_node1)
					,(+ lk_frag_dest +net_id_node_id +node_id_node2)
					,(+ lk_frag_src +net_id_mbox_id)
					,(+ lk_frag_src +net_id_node_id +node_id_node1)
					,(+ lk_frag_src +net_id_node_id +node_id_node2))
				`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
			;the pad, where the ring had what went before
			(vp-cpy-cr 0 t0)
			(assign `(,t0) `((,tx_frag lk_frag_pad)))
			(call :sys_mem :copy_to_ring (vpx (.> msg +msg_data)
					(& (. (.> head lk_buf_size) lk_frag_size))
					(.> msg +msg_length) lk_chan_size tx))

			;write buf frag, wrap head and trigger :in
			(call 'write_buf (vpx head tx lk_chan_status_frag
				(& (- (+ (.> msg +msg_length) lk_buf_size lk_frag_size +long_size) 1) (- +long_size))) (vpx head))

			;free message
			(call :sys_mail :free (vpx msg))

		(vp-label 'yield)
			;do we have enough headroom, as only msg data can wrap ?
			(vp-rdef (head tx status tx_end head_end))
			(assign (vpx head tx) `(,head ,tx))
			(vp-lea-i tx lk_chan_size tx_end)
			(vp-lea-i head (+ lk_buf_size lk_frag_size) head_end)
			(vpif `(,head_end > ,tx_end))
				;write buf skip, wrap head and trigger :in
				(vp-sub-rr head tx_end)
				(call 'write_buf `(,head ,tx lk_chan_status_skip ,tx_end) (vpx head))
			(endif)

			;let other links run
			(call :sys_task :sleep '(0))
		(loop-end)

		;small sleep if nothing to do
		;the sleep doubles, to lk_sleep_max, so mail goes through quickly
		;while there is some. A link that has had none for lk_quiet sleeps
		;goes on to lk_sleep_idle, an idle network should not be busy.
		(call :sys_task :sleep (vpx sleep_time))
		(assign (vpx (<< sleep_time 1) (+ quiet 1)) (vpx sleep_time quiet))
		(vpif (vpx (> quiet lk_quiet)))
			(assign (vpx (+ lk_quiet 1)) (vpx quiet))
			(vpif (vpx (> sleep_time lk_sleep_idle)))
				(assign (vpx lk_sleep_idle) (vpx sleep_time))
			(endif)
		(elseif (vpx (> sleep_time lk_sleep_max)))
			(assign (vpx lk_sleep_max) (vpx sleep_time))
		(endif)

		;if I have not run for a while, this node was busy, or was
		;stopped, that time says nothing about the peer
		(assign (vpx now) (vpx last))
		(call :host_os :pii_time :nil (vpx now))
		(vpif (vpx (> (- now last) lk_stall)))
			(assign (vpx (+ then (- now last))) (vpx then))
		(endif)

		;a peer that is not taking from the link is busy, and can not say
		;so. So count the ms it has left the link as its load, till it
		;next says what its load is.
		(vpif (vpx (&& seen (= down 0))))
			(assign (vpx (/ (- now then) lag_per_task)) (vpx gap))
			(vpif (vpx (> gap (.> lk_node lk_node_task_count))))
				(assign (vpx gap) (vpx (.> lk_node lk_node_task_count)))
			(endif)
		(endif)

		;is the peer down ? If it has said what its process is, ask the
		;host each beat if that is still running. A busy peer takes nothing
		;from the link, but its process runs on, so it is not dropped, only
		;one that takes nothing for the max timeout, it is stuck. If its
		;process is not known, it is down if it has taken nothing for
		;longer than the timeout.
		(assign (vpx 0) (vpx drop))
		(vpif (vpx (&& (= down 0) seen)))
			(vpif (vpx (.> lk_node lk_node_peer_pid)))
				(vpif (vpx (> (- now checked) lk_beat)))
					(assign (vpx now) (vpx checked))
					(call :host_os :pii_alive (vpx (.> lk_node lk_node_peer_pid)) (vpx alive))
				(endif)
				(vpif (vpx (|| (= alive 0) (> (- now then) lk_timeout_max))))
					(assign (vpx 1) (vpx drop))
				(endif)
			(elseif (vpx (> (- now then) timeout)))
				(assign (vpx 1) (vpx drop))
			(endif)
		(endif)

		;mark the link down. The peer is forgotten, so nothing is sent this
		;way, and the ping task sees the change and kicks the network. If
		;the peer was just busy, the :in sets it again when it next hears
		;from it, and the link is up again.
		(vpif (vpx drop))
			(vpifnot (vpx alive))
				;its process is gone, that is certain
				(lk-forget-peer)
				;what was put on the link for it and it never took is not
				;lost with it. It is taken back off, and posted again, for
				;another link to take if there is another way there. Only
				;when the process has gone: one that is only busy may yet
				;take what is here, and then it would arrive twice
				(assign (vpx tail) (vpx walk))
				(loop-while (vpx (/= walk head)))
					(assign (vpx (.> walk lk_buf_status) (.> walk lk_buf_length)) (vpx status length))
					(vpif (vpx (= status lk_chan_status_frag)))
						(call :sys_mail :alloc (vpx (. (.> walk lk_buf_size) lk_frag_length)) (vpx msg data))
						(vp-rdef (msg rx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
						(assign (vpx msg (& (.> walk lk_buf_size))) `(,msg ,rx_frag))
						(assign-fields
							rx_frag
								`(lk_frag_length lk_frag_offset lk_frag_total
								,(+ lk_frag_dest +net_id_mbox_id)
								,(+ lk_frag_dest +net_id_node_id +node_id_node1)
								,(+ lk_frag_dest +net_id_node_id +node_id_node2)
								,(+ lk_frag_src +net_id_mbox_id)
								,(+ lk_frag_src +net_id_node_id +node_id_node1)
								,(+ lk_frag_src +net_id_node_id +node_id_node2))
							msg
								`(+msg_length +msg_offset +msg_total
								,(+ +msg_dest +net_id_mbox_id)
								,(+ +msg_dest +net_id_node_id +node_id_node1)
								,(+ +msg_dest +net_id_node_id +node_id_node2)
								,(+ +msg_src +net_id_mbox_id)
								,(+ +msg_src +net_id_node_id +node_id_node1)
								,(+ +msg_src +net_id_node_id +node_id_node2))
							`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
						(call :sys_mem :copy_from_ring (vpx (& (. (.> walk lk_buf_size) lk_frag_size))
							data (. (.> walk lk_buf_size) lk_frag_length) lk_chan_size tx))
						(call :sys_mail :send (vpx msg))
					(endif)
					(assign (vpx lk_chan_status_ready) (vpx (.> walk lk_buf_status)))
					(assign (vpx (+ walk length)) (vpx walk))
					(vpif (vpx (>= walk (+ tx lk_chan_size))))
						(assign (vpx (- walk lk_chan_size)) (vpx walk))
					(endif)
				(loop-end)
				(assign (vpx head head) (vpx tail last_tail))
			(endif)
			(assign (vpx 1 1) (vpx down alive))
			(vp-rdef (node zero))
			(assign (vpx lk_node 0) `(,node ,zero))
			(save-fields node
					`(lk_node_peer_pid
					,(+ lk_node_peer_node_id +node_id_node1)
					,(+ lk_node_peer_node_id +node_id_node2)
					,(+ lk_node_peer_system_id +node_id_node1)
					,(+ lk_node_peer_system_id +node_id_node2))
				`(,zero ,zero ,zero ,zero ,zero))
		(endif)

		;exit if link closed
		(breakif (vpx (= (.> lk_node lk_node_task_count) (- 1))))
	(loop-end)

	;the link was closed. A peer that is exiting closes its links first,
	;so if its process is known, give it a moment to go, and if it has,
	;the node is gone too. If it runs on, it only closed the link.
	(vpif (vpx (.> lk_node lk_node_peer_pid)))
		(assign (vpx 20) (vpx quiet))
		(loop-start)
			(call :host_os :pii_alive (vpx (.> lk_node lk_node_peer_pid)) (vpx alive))
			(breakifnot (vpx alive))
			(assign (vpx (- quiet 1)) (vpx quiet))
			(breakifnot (vpx quiet))
			(call :sys_task :sleep (vpx 10000))
		(loop-end)
		(vpifnot (vpx alive))
			(lk-forget-peer)
		(endif)
	(endif)

	(call :nodeid :destroy (vpx key))

	;gone, the last thing done with lk_node's frame
	(assign (vpx live) '(:r0))
	(assign '((:r0 0)) '(:r1))
	(vp-sub-cr 1 :r1)
	(assign '(:r1) '((:r0 0)))
	(pop-scope)
	(return)

(vp-label 'behind_callback)
	;inputs
	;:r0 = predicate data, the node id of the peer that has gone (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)
	;info
	;the peer is taken out of the ways to this node. If it was the only
	;one, the node has no way to it now

	(vp-rdef (data iter dst tuple vias end pid1 pid2 vid1 vid2 dif1 dif2))

	(entry :hmap :each_callback `(,data ,iter ,dst))

	(assign `((,iter ,+ptr_size)) `(,tuple))
	(load-node-id data 0 pid1 pid2)
	(class/array/get_both tuple vias end)
	(vp-add-cr (* +node_vias +long_size) vias)
	(vp-cpy-rr vias dst)
	(loop-while `(,vias < ,end))
		(assign `((,vias 0) (,vias ,+long_size)) `(,vid1 ,vid2))
		(vp-add-cr (* 2 +long_size) vias)
		(vp-cpy-rr vid1 dif1)
		(vp-cpy-rr vid2 dif2)
		(vp-sub-rr pid1 dif1)
		(vp-sub-rr pid2 dif2)
		(vp-or-rr dif2 dif1)
		(vpif `(,dif1 /= 0))
			(assign `(,vid1 ,vid2) `((,dst 0) (,dst ,+long_size)))
			(vp-add-cr (* 2 +long_size) dst)
		(endif)
	(loop-end)
	(vpif `(,dst < ,vias))
		;it was one of them
		(assign `((,tuple +array_begin)) `(,vias))
		(vp-sub-rr vias dst)
		(vp-shr-cr (log2 +long_size) dst)
		(assign `(,dst) `((,tuple +array_length)))
		(vpif `(,dst = ,+node_vias))
			;and the only one
			(vp-cpy-cr +node_hops_none vid1)
			(assign `(,vid1) `((,vias ,(* +node_hops +long_size))))
			;the peer itself will not be heard again
			(assign `((,iter 0)) `(,end))
			(load-node-id end +str_data vid1 vid2)
			(vp-sub-rr pid1 vid1)
			(vp-sub-rr pid2 vid2)
			(vp-or-rr vid2 vid1)
			(vpif `(,vid1 = 0))
				(vp-cpy-cr +node_session_gone vid1)
				(assign `(,vid1 ,vid1) `((,vias ,(* +node_session_cluster +long_size))
					(,vias ,(* +node_session_sys +long_size))))
			(endif)
		(endif)
	(endif)
	(vp-ret)

(vp-label 'write_buf)
	;inputs
	;r0 = head ptr
	;r1 = ring ptr
	;r2 = buf type
	;r3 = buf size
	;outputs
	;r0 = head ptr
	;trashes
	;:r0-:r4

	(vp-rdef (head ring type size old_head))

	;write size
	(assign `(,size ,head) `((,head lk_buf_length) ,old_head))
	;move on to next transfer, clear new status !
	(vp-add-rr size head)
	(vp-add-cr lk_chan_size ring)
	(vpif `(,head >= ,ring))
		(vp-sub-cr lk_chan_size head)
	(endif)
	(assign `(,lk_chan_status_ready) `(,size))
	(assign `(,size) `((,head lk_buf_status)))
	;allow read from :in
	(vp-sync)
	(assign `(,type) `((,old_head lk_buf_status)))
	(vp-ret)

(def-func-end)
