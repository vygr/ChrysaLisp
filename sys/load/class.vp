(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "class/array/class.inc")
(include "./class.inc")
(include "././str/class.inc")

(def-method :sys_load :init)
	;inputs
	;:r0 = argv of the host (pptr)
	;:r1 = the host's function tables, os gui audio net (pptr)
	;outputs
	;:r0 return code
	;trashes
	;:r0-:r14, :f0-:f15
	;info
	;called by the host, so its args are where the host's ABI puts them,
	;(vp-entry-abi) has them to :r0 :r1 as a host call would.
	;we need to keep the statics function on the front
	;of the tail block, even though it dosn't get used
	;because the boot image has relative link references
	;to the 'sys/statics/statics' string in its header !

	(structure local 0
		(ptr argv os gui audio net statics)
		(ptr boot_static_func boot_tail_func)
		(ptr new_static_func new_tail_func)
		(uint boot_static_len boot_tail_len))

	(vp-rdef (links paths func statics os) '(:r10 :r11 :r12 :r13 :r14))

	;called by the host, its args to :r0 :r1, the stack the VP's
	(vp-entry-abi 2)

	;save inputs
	(vp-alloc local_size)
	(entry :sys_load :init '((:rsp local_argv) :r3))
	(assign '((:r3 0) (:r3 8) (:r3 16) (:r3 24)) '(:r0 :r1 :r2 :r3))
	(assign '(:r0 :r1 :r2 :r3) '((:rsp local_os) (:rsp local_gui) (:rsp local_audio) (:rsp local_net)))

	;get boot block info
	(assign '(($ fn_start) ($ fn_end)) '(:r0 :r1))
	(assign '((:r0 0) (:r1 +fn_header_length)) '(:r2 :r3))
	(assign '(:r1 :r3) '((:rsp local_boot_static_func) (:rsp local_boot_static_len)))
	(assign '(:r1) '((:rsp local_boot_tail_func)))
	(vp-sub-rr :r0 :r1)
	(vp-sub-rr :r1 :r2)
	(assign '(:r2) '((:rsp local_boot_tail_len)))

	;relocate statics and tail to their own mmap regions
	(defq in (method-input :host_os :mmap))
	(assign '((:rsp local_os) (:rsp local_boot_static_len) -1 +mmap_data) `(,os ~in))
	(vp-add-cr statics_size (first in))
	(abi-call-table :host_os :mmap os in '(:r0))
	(assign '(:r0) '((:rsp local_new_static_func)))
	(assign '((:rsp local_os)) `(,os))
	(abi-call-table :host_os :mmap os '((:rsp local_boot_tail_len) -1 +mmap_data) '(:r0))
	(assign '(:r0) '((:rsp local_new_tail_func)))
	(call 'memcpy '((:rsp local_boot_static_func) (:rsp local_new_static_func) (:rsp local_boot_static_len)))
	(call 'memcpy '((:rsp local_boot_tail_func) (:rsp local_new_tail_func) (:rsp local_boot_tail_len)))

	;allocate relloc/stat/name buffer
	(assign '((:rsp local_os)) `(,os))
	(abi-call-table :host_os :mmap os '(ld_reloc_buf_size -1 +mmap_data) '(:r0))

	;init reloc buffer address etc
	(assign '((:rsp local_new_static_func)) `(,statics))
	(assign `((,statics +fn_header_entry)) '(:r1))
	(vp-add-rr :r1 statics)
	(assign `(,statics) '((:rsp local_statics)))
	(assign '(:r0 :r0) `((,statics statics_sys_load_reloc_stack) (,statics statics_sys_load_reloc_buffer)))
	(vp-add-cr ld_reloc_size :r0)
	(assign '(:r0) `((,statics statics_sys_load_name_buffer)))
	(vp-add-cr ld_name_size :r0)
	(assign '(:r0) `((,statics statics_sys_load_stat_buffer)))

	;save host abi tables
	(assign '((:rsp local_os) (:rsp local_gui) (:rsp local_audio) (:rsp local_net))
		'(:r0 :r1 :r2 :r3))
	(assign '(:r0) `((,statics statics_sys_load_host_os_funcs)))
	(assign '(:r1) `((,statics statics_sys_load_host_gui_funcs)))
	(assign '(:r2) `((,statics statics_sys_load_host_audio_funcs)))
	(assign '(:r3) `((,statics statics_sys_load_host_net_funcs)))

	;add statics function to function list
	(assign '((:rsp local_new_static_func)) `(,func))
	(ln-add-fnode statics statics_sys_load_function_flist func :r0)

	;add all tail functions to function list
	(assign '((:rsp local_new_tail_func)) `(,func))
	(assign `((,func +fn_header_length)) '(:r0))
	(vp-add-rr :r0 func)
	(loop-start)
		(assign `((,func +fn_header_length)) '(:r0))
		(breakif '(:r0 = 0))
		(ln-add-fnode statics statics_sys_load_function_flist func :r1)
		(vp-add-rr :r0 func)
	(loop-end)

	;bind all function intra references
	(assign '((:rsp local_new_tail_func)) `(,func))
	(assign `((,func +fn_header_length)) '(:r0))
	(vp-add-rr :r0 func)
	(loop-start)
		(assign `((,func +fn_header_length)) '(:r0))
		(breakif '(:r0 = 0))
		(assign `((,func +fn_header_links) (,func +fn_header_paths)) `(,links ,paths))
		(vp-add-rr func links)
		(vp-add-rr func paths)
		(vp-add-rr :r0 func)
		(loop-while `(,links /= ,paths))
			(vp-cpy-ir links 0 :r0)
			(vp-add-rr links :r0)
			(call 'bind `(:r0 ,statics) '(:r0))
			(vp-cpy-ri :r0 links 0)
			(vp-add-cr +ptr_size links)
		(loop-end)
	(loop-end)

	;set functions to RX
	(assign '((:rsp local_os)) `(,os))
	(abi-call-table :host_os :mprotect os '((:rsp local_new_tail_func) (:rsp local_boot_tail_len) +mmap_exec))
	(assign '((:rsp local_os)) `(,os))
	(abi-call-table :host_os :clear_icache os '((:rsp local_new_tail_func) (:rsp local_boot_tail_len)))

	;where the functions not in the image are, the folder the boot image
	;was read from, argv[1] up to and with the / before sys/boot_image,
	;obj/<cpu>/<abi>/. Put at the front of the name buffer, as much of it as
	;fits, and its length kept. Not a string of this build, the same VP
	;for every platform
	(assign '((:rsp local_argv) (:rsp local_statics)) `(:r0 ,statics))
	(assign `((:r0 +ptr_size) (,statics statics_sys_load_name_buffer)) '(:r0 :r1))
	(vp-cpy-rr :r1 :r5)
	(vp-add-cr (dec ld_name_size) :r5)
	(vp-cpy-rr :r1 :r2)
	(vp-cpy-rr :r1 :r3)
	(loop-start)
		(vp-cpy-ir-ub :r0 0 :r4)
		(breakif '(:r4 = 0) '(:r1 = :r5))
		(vp-cpy-ri-b :r4 :r1 0)
		(vp-add-cr 1 :r0)
		(vp-add-cr 1 :r1)
		(vpif `(:r4 = ,(ascii-code "/")))
			(vp-cpy-rr :r2 :r3)
			(vp-cpy-rr :r1 :r2)
		(endif)
	(loop-end)
	(assign `((,statics statics_sys_load_name_buffer)) '(:r1))
	(vp-sub-rr :r1 :r3)
	(assign '(:r3) `((,statics statics_sys_load_name_prefix)))

	;call the kernel
	(call 'bind '(($ bind_kernel) (:rsp local_statics)) '(:r1))
	(assign '((:rsp local_argv)) '(:r0))
	(vp-call-r :r1)

	;free new statics and tail regions etc
	(assign '((:rsp local_statics) (:rsp local_os)) `(,statics ,os))
	(abi-call-table :host_os :munmap os `((,statics statics_sys_load_reloc_buffer) ld_reloc_buf_size +mmap_data))
	(assign '((:rsp local_os)) `(,os))
	(abi-call-table :host_os :munmap os '((:rsp local_new_static_func) (:rsp local_boot_static_len) +mmap_exec))
	(assign '((:rsp local_os)) `(,os))
	(abi-call-table :host_os :munmap os '((:rsp local_new_tail_func) (:rsp local_boot_tail_len) +mmap_exec))

	;return with code 0
	(vp-free local_size)
	(vp-xor-rr :r0 :r0)
	(exit :sys_load :init '(:r0))
	(vp-ret)

(vp-label 'bind)
	;inputs
	;:r0 = name
	;:r1 = statics
	;outputs
	;:r0 = func entry point
	;trashes
	;:r1-:r6
	(vp-rdef (name stats node str1 str2 c1 c2))
	(entry `(,name ,stats))

	(loop-flist stats statics_sys_load_function_flist node node)
		(vp-cpy-rr name str1)
		(vp-lea-i node +fn_header_pathname str2)
		(loop-start)
			(vp-cpy-ir-ub str1 0 c1)
			(vp-cpy-ir-ub str2 0 c2)
			(vp-sub-rr c2 c1)
			(breakif `(,c1 /= 0) `(,c2 = 0))
			(vp-add-cr +byte_size str1)
			(vp-add-cr +byte_size str2)
		(loop-end)
	(loop-until `(,c1 = 0))
	(assign `((,node +fn_header_entry)) '(:r0))
	(vp-add-rr node :r0)

	(exit '(:r0))
	(vp-ret)

(vp-label 'memcpy)
	;inputs
	;:r0 = src
	;:r1 = dest
	;:r2 = length
	;trashes
	;:r0-:r3
	(vp-rdef (src dst len end))
	(entry `(,src ,dst ,len))

	(assign `((& ,src ,len)) `(,end))
	(loop-start)
		(vp-cpy-ir src 0 len)
		(vp-add-cr +long_size src)
		(vp-cpy-ri len dst 0)
		(vp-add-cr +long_size dst)
	(loop-until `(,src >= ,end))
	(vp-ret)

(vp-label 'bind_kernel)
	(vp-cstr "sys/kernel/kernel")

(def-func-end)

;a load goes on in the block the last one ended in, made writable for it,
;and in new blocks after that, and those are made runnable when it ends,
;from the head of their list down to the one past where it began. Only the
;newest block is ever made writable again, and nothing of it runs while it
;is: what runs during a load is the loader and what it calls, and those the
;boot image holds, lib/boot/image.inc. A function of it may be waiting on
;the stack, which is runnable again before it is returned to
(defun ld-open (block next)
	;the newest block writable, next the one after it, where the seal stops
	(vpif `(,block /= 0))
		(call :host_os :pii_mprotect `(,block ld_block_size +mmap_data) '(:r0))
		(assert '(:r0 = 0))
		(assign `((,block +ln_fnode_next)) `(,next))
	(else)
		(vp-xor-rr next next)
	(endif))

(defun ld-seal (block stop)
	(loop-while `(,block /= ,stop))
		(call :host_os :pii_mprotect `(,block ld_block_size +mmap_exec) '(:r0))
		(assert '(:r0 = 0))
		(assign `((,block +ln_fnode_next)) `(,block))
	(loop-end))

(def-method :sys_load :bind)
	;input
	;:r0 = c string function path name (pubyte)
	;output
	;:r0 = 0 else, function entry pointer (ptr)
	;trashes
	;:r0-:r7, :f0-:f15
	;info
	;of the task's function server first, if it has one, then the node's
	;own, loaded from the node's files if it has not been. Nothing is
	;loaded into a server by a bind, its functions are placed, (:place)

	(entry :sys_load :bind '(:r6))

	;the task's server is what this bind is for
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_task_current_tcb)) '(:r0))
	(assign '((:r0 +tk_node_server)) '(:r0))
	(assign '(:r0) '((:r7 statics_sys_load_server)))

	;check if function already present !
	(vp-push :r6)
	(call :sys_load :search '(:r6) '(:r0))
	(vp-pop :r6)
	(vpif '(:r0 /= 0))
		(exit :sys_load :bind '(:r0))
		(vp-ret)
	(endif)

	;load the function/s, the node's own, on in the newest block
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_block_flist)) '(:r3))
	(ld-open :r3 :r5)
	(vp-push :r5)
	(call :sys_load :load '(:r6) '(:r4))

	;the blocks it wrote made runnable
	(vp-pop :r5)
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_block_flist)) '(:r3))
	(ld-seal :r3 :r5)

	;return function address
	(exit :sys_load :bind '(:r4))
	(vp-ret)

(def-func-end)

(def-method :sys_load :search)
	;input
	;:r6 = c string function path name (pubyte)
	;output
	;:r0 = 0 else, function entry pointer (ptr)
	;trashes
	;:r0-:r5, :r7
	;info
	;a function loaded already, of the server of the bind, then of the node

	(entry :sys_load :search '(:r6))

	(fn-bind 'sys/statics/statics :r7)
	(vp-xor-rr :r5 :r5)
	(assign '((:r7 statics_sys_load_server)) '(:r4))
	(vpif '(:r4 /= 0))
		(loop-flist :r4 +ld_server_flist :r5 :r5)
			(call :sys_str :compare '(:r6 (& :r5 +fn_header_pathname)) '(:r0))
		(loop-until '(:r0 = 0))
	(endif)
	(vpif '(:r5 = 0))
		(loop-flist :r7 statics_sys_load_function_flist :r5 :r5)
			(call :sys_str :compare '(:r6 (& :r5 +fn_header_pathname)) '(:r0))
		(loop-until '(:r0 = 0))
	(endif)
	(vp-xor-rr :r0 :r0)
	(vpif '(:r5 /= 0))
		(assign '((:r5 +fn_header_entry)) '(:r0))
		(vp-add-rr :r5 :r0)
	(endif)

	(exit :sys_load :search '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sys_load :load)
	;input
	;:r0 = c string function path name (pubyte)
	;output
	;:r0 = 0 else, function entry pointer (ptr)
	;trashes
	;:r0-:r7, :f0-:f15

	(entry :sys_load :load '(:r6))

	;check if function already present !
	(fn-bind 'sys/statics/statics :r7)
	(loop-flist :r7 statics_sys_load_function_flist :r5 :r5)
		(call :sys_str :compare '(:r6 (& :r5 +fn_header_pathname)) '(:r0))
	(loop-until '(:r0 = 0))
	(vpif '(:r5 /= 0))
		;found function already loaded
		(assign '((:r5 +fn_header_entry)) '(:r0))
		(vp-add-rr :r5 :r0)
		(vp-ret)
	(endif)

	;create filename, after the folder of the image the buffer starts with
	(assign '((:r7 statics_sys_load_name_buffer) (:r7 statics_sys_load_name_prefix)) '(:r1 :r0))
	(vp-add-rr :r0 :r1)
	(call :sys_str :copy '(:r6 :r1))
	(assign '((:r7 statics_sys_load_name_buffer)) '(:r6))

	;get length of function on disk, none, or not a file, and it is made
	;from its VP
	(call :host_os :pii_stat '(:r6 (:r7 statics_sys_load_stat_buffer)) '(:r0))
	(gotoif '(:r0 /= 0) 'from_vp)
	(assign '((:r7 statics_sys_load_stat_buffer)) '(:r0))
	(assign '((:r0 +stat_mode)) '(:r0))
	(vp-and-cr s_ifmt :r0)
	(gotoif '(:r0 /= s_ifreg) 'from_vp)

	;ensure space for new function
	(vp-call 'space)

	;open function file
	(call :host_os :pii_open '(:r6 +file_open_read) '(:r6))

	;read into buffer
	(assign '((:r7 statics_sys_load_stat_buffer)) '(:r2))
	(call :host_os :pii_read '(:r6 (:r7 statics_sys_load_block_start) (:r2 +stat_fsize)))

	;close function file
	(call :host_os :pii_close '(:r6))

	;check loaded length equals file size, a file another node is writing
	;is not, and it is made from its VP here too
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_block_start) (:r7 statics_sys_load_stat_buffer)) '(:r3 :r2))
	(assign '((:r3 +fn_header_length) (:r2 +stat_fsize)) '(:r0 :r1))
	(gotoif '(:r0 /= :r1) 'from_vp)
	(call :host_os :pii_clear_icache '((:r7 statics_sys_load_block_start) (:r2 +stat_fsize)))
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_block_start)) '(:r3))

(vp-label 'loaded)
	;add to function list
	(ln-add-fnode :r7 statics_sys_load_function_flist :r3 :r0)

	;relocate vtable so we can discard paths
	(assign '((:r7 statics_sys_load_reloc_stack)) '(:r1))
	(vp-cpy-rr :r1 :r5)

	;copy paths to reloc buffer
	(assign '((:r3 +fn_header_paths) (:r3 +fn_header_length)) '(:r0 :r2))
	(vp-add-rr :r3 :r0)
	(vp-add-rr :r3 :r2)
	(loop-while '(:r0 /= :r2))
		(vp-cpy-ir-b :r0 0 :r4)
		(vp-cpy-ri-b :r4 :r1 0)
		(vp-add-cr +byte_size :r0)
		(vp-add-cr +byte_size :r1)
	(loop-end)

	;push reloc buffer entry
	(vp-add-cr (dec (* +ptr_size 2)) :r1)
	(vp-and-cr (neg +ptr_size) :r1)
	(assign '(:r5 :r1) `((:r1 ,(neg +ptr_size)) (:r7 statics_sys_load_reloc_stack)))

	;overflow check
	(assign '((:r7 statics_sys_load_name_buffer)) '(:r2))
	(vpif '(:r1 > :r2))
		(call :host_os :pii_write_str '(2 "Reloc buffer overflow !"))
		(call :host_os :pii_exit '(1))
	(endif)

	;bind links to paths in reloc buffer
	(assign '((:r3 +fn_header_links) (:r3 +fn_header_paths)) '(:r0 :r1))
	(vp-add-rr :r3 :r0)
	(vp-add-rr :r3 :r1)
	(vp-sub-rr :r1 :r5)
	(loop-while '(:r0 /= :r1))
		(vp-cpy-ir :r0 0 :r2)
		(vp-add-rr :r0 :r2)
		(vp-add-rr :r5 :r2)
		(vp-cpy-ri :r2 :r0 0)
		(vp-add-cr +ptr_size :r0)
	(loop-end)

	;adjust block start
	(assign '((:r3 +fn_header_paths)) '(:r0))
	(vp-add-rr :r3 :r0)
	(vp-add-cr (dec +ptr_size) :r0)
	(vp-and-cr (neg +ptr_size) :r0)
	(assign '(:r0) '((:r7 statics_sys_load_block_start)))

	;load and link function references
	;now actual addresses of strings in the reloc buffer
	(assign '((:r3 +fn_header_links)) '(:r0))
	(vp-add-rr :r3 :r0)
	(loop-start)
		(assign '((:r3 +fn_header_paths)) '(:r1))
		(vp-add-rr :r3 :r1)
		(breakif '(:r0 = :r1))
		(vp-push :r3 :r0)
		(call 'fn_entry '((:r0 0)))
		(vpif '(:r0 = 0))
			;no such file
			(call :host_os :pii_write_str '(2 "Bind error: "))
			(assign '((:rsp 0)) '(:r0))
			(call :host_os :pii_write_str '(2 (:r0 0)))
			(call :host_os :pii_write_char '(2 +char_lf))
			(call :host_os :pii_exit '(1))
		(endif)
		(vp-cpy-rr :r0 :r1)
		(vp-pop :r3 :r0)
		(vp-cpy-ri :r1 :r0 0)
		(vp-add-cr +ptr_size :r0)
	(loop-end)

	;pop reloc buffer
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_reloc_stack)) '(:r0))
	(vp-cpy-ir :r0 (neg +ptr_size) :r0)
	(assign '(:r0) '((:r7 statics_sys_load_reloc_stack)))

	;return function address
	(assign '((:r3 +fn_header_entry)) '(:r0))
	(vp-add-rr :r3 :r0)

	(exit :sys_load :load '(:r0))
	(vp-ret)

(vp-label 'from_vp)
	;the native made by this CPU's translator from the function's VP, in a
	;bundle of its folder in obj/vp/<mode>/, kept where the native would be
	;for the next to load, and loaded from that as from its file. No VP, or
	;no translation, and it is not there. The finding and the translator
	;trash more than a load may
	(vp-push :r8 :r9 :r10 :r11 :r12 :r13 :r14)
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_name_buffer) (:r7 statics_sys_load_name_prefix)) '(:r0 :r1))
	(vp-add-rr :r1 :r0)
	(call :sys_load :vp_find '(:r0) '(:r0 :r1 :r2))
	(vpif '(:r0 /= 0))
		;translated, the str of it or 0. lib/trans/vpb is the translator of
		;the CPU the image is made for, the image's maker links it: this VP
		;is made once for every CPU
		(vp-push :r0)
		(fn-bind 'lib/trans/vpb :r3)
		(vp-xor-rr :r0 :r0)
		(vp-call-r :r3)
		(vp-pop :r1)
		(vp-push :r0)
		(call :sys_mem :free '(:r1))
		(vp-pop :r0)
	(endif)
	(vp-pop :r8 :r9 :r10 :r11 :r12 :r13 :r14)
	(vpif '(:r0 = 0))
		(vp-ret)
	(endif)
	(vp-push :r0)
	;kept, the same bytes whoever makes it
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r0 +str_length)) '(:r2))
	(vp-lea-i :r0 +str_data :r1)
	(call :host_os :pii_save '((:r7 statics_sys_load_name_buffer) :r1 :r2) '(_))
	;into the block as from its file
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:rsp 0) (:r7 statics_sys_load_stat_buffer)) '(:r0 :r1))
	(assign '((:r0 +str_length)) '(:r0))
	(assign '(:r0) '((:r1 +stat_fsize)))
	(vp-call 'space)
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:rsp 0)) '(:r0))
	(call :sys_mem :copy '((& :r0 +str_data) (:r7 statics_sys_load_block_start) (:r0 +str_length)) '(_ _))
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_stat_buffer)) '(:r2))
	(call :host_os :pii_clear_icache '((:r7 statics_sys_load_block_start) (:r2 +stat_fsize)))
	(vp-pop :r0)
	(call :obj :deref '(:r0))
	(fn-bind 'sys/statics/statics :r7)
	(assign '((:r7 statics_sys_load_block_start)) '(:r3))
	(vp-jmp 'loaded)

(vp-label 'space)
	;room in the block for the length in the stat buffer, a new block if not,
	;:r7 the statics, trashes :r0-:r2
	(assign '((:r7 statics_sys_load_block_start) (:r7 statics_sys_load_block_end) (:r7 statics_sys_load_stat_buffer))
		'(:r1 :r2 :r0))
	(vp-sub-rr :r1 :r2)
	(assign '((:r0 +stat_fsize)) '(:r0))
	(vpif '(:r2 < :r0))
		;not enough so allocate new function buffer
		(call :host_os :pii_mmap '(ld_block_size -1 +mmap_data) '(:r0))
		(assert '(:r0 /= 0))

		;add to block list for freeing
		(ln-add-fnode :r7 statics_sys_load_block_flist :r0 :r1)

		;set block pointers for loading
		(vp-add-cr +ptr_size :r0)
		(assign '(:r0) '((:r7 statics_sys_load_block_start)))
		(vp-add-cr (- ld_block_size +ptr_size) :r0)
		(assign '(:r0) '((:r7 statics_sys_load_block_end)))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_load :vp_find)
	;inputs
	;:r0 = c string function name (pubyte)
	;outputs
	;:r0 = 0, else the bundle it is in, to free (ptr)
	;:r1 = its VP binary (pubyte)
	;:r2 = its VP binary length (uint)
	;trashes
	;:r0-:r14, :f0-:f15
	;info
	;the VP binary of a function, from the binary bundles of its folder in
	;obj/vp/<mode>/, of the mode the image is made in, as @Source finds
	;it. A build makes the VP once, for every CPU. Each bundle is its
	;functions' VP binary, each after its length, and each begins with the
	;length of its name and the name

	(def-vars
		(ptr data list stat)
		(pubyte name path dir at end bin p q r e)
		(long name_len len cap size n shift)
		(ubyte b))

	(push-scope)
	(entry :sys_load :vp_find (vpx name))

	(call :sys_str :length (vpx name) (vpx _ name_len))
	(call :sys_mem :alloc (vpx (* ld_name_size 4)) (vpx path _))
	;the folder, obj/vp/<mode>/ and the name up to its last /
	(assign (vpx path) '(:r1))
	(call :sys_str :copy `(,(cat "obj/vp/" (elem-get '("release" "debug" "validate") *build_mode*) "/") :r1) '(_ :r1))
	(vp-sub-cr +byte_size :r1)
	(assign '(:r1) (vpx dir))
	(call :sys_str :copy (vpx name dir) (vpx _ at))
	(loop-start)
		(assign (vpx (- at 1)) (vpx at))
	(loop-until (vpx (= (* at) +char_divide)))
	(assign (vpx (+ at 1)) (vpx dir))
	(assign (vpx 0) (vpx (* dir)))
	;what is in it
	(assign (vpx 0 0 4096) (vpx list cap size))
	(loop-start)
		(call :sys_mem :realloc (vpx list cap size) (vpx list cap))
		(call :host_os :pii_dirlist (vpx path list cap) (vpx len))
		(breakif (vpx (<= len cap)))
		(assign (vpx len) (vpx size))
	(loop-end)
	(assign (vpx (@ sys/statics/statics)) (vpx stat))
	(assign (vpx (.> stat statics_sys_load_stat_buffer) 0 list (+ list len))
		(vpx stat data at end))
	;each entry is its name, its type and a comma after each
	(loop-while (vpx (< at end)))
		(assign (vpx at) (vpx bin))
		(loop-while (vpx (/= (* at) +char_comma)))
			(assign (vpx (+ at 1)) (vpx at))
		(loop-end)
		(assign (vpx (- at bin) (elem at 1) (+ at 3)) (vpx n b at))
		(continueif (vpx (/= b ,(ascii-code "f"))))
		(continueif (vpx (< n 5)))
		(continueif (vpx (> n (* ld_name_size 2))))
		(call :sys_mem :copy (vpx bin dir n) (vpx _ q))
		(assign (vpx 0) (vpx (* q)))
		(assign (vpx (- q 4)) '(:r0))
		(call :sys_str :compare '(:r0 ".vpb") '(:r0))
		(continueif '(:r0 /= 0))
		;a bundle, read in
		(call :host_os :pii_stat (vpx path stat) (vpx n))
		(continueif (vpx (/= n 0)))
		(assign (vpx (.> stat +stat_fsize)) (vpx size))
		(call :sys_mem :alloc (vpx size) (vpx data _))
		(call :host_os :pii_open (vpx path +file_open_read) (vpx n))
		(call :host_os :pii_read (vpx n data size) (vpx _))
		(call :host_os :pii_close (vpx n) (vpx _))
		;each VP binary in it, by its name
		(assign (vpx data (+ data size)) (vpx bin q))
		(loop-while (vpx (< bin q)))
			(assign (vpx 0 0) (vpx n shift))
			(loop-start)
				(assign (vpx (* bin)) (vpx b))
				(assign (vpx (+ bin 1) (| n (<< (& b 0x7f) shift)) (+ shift 7)) (vpx bin n shift))
			(loop-until (vpx (= (& b 0x80) 0)))
			(assign (vpx bin 0 0) (vpx p len shift))
			(assign (vpx (+ bin n)) (vpx bin))
			(loop-start)
				(assign (vpx (* p)) (vpx b))
				(assign (vpx (+ p 1) (| len (<< (& b 0x7f) shift)) (+ shift 7)) (vpx p len shift))
			(loop-until (vpx (= (& b 0x80) 0)))
			(continueif (vpx (/= len name_len)))
			(assign (vpx name (+ p len)) (vpx r e))
			(loop-while (vpx (< p e)))
				(breakif (vpx (/= (* p) (* r))))
				(assign (vpx (+ p 1) (+ r 1)) (vpx p r))
			(loop-end)
			(gotoif (vpx (= p e)) 'found)
		(loop-end)
		(call :sys_mem :free (vpx data))
		(assign (vpx 0) (vpx data))
	(loop-end)
	(goto 'done)

(vp-label 'found)
	;its VP binary, the length before it went into n
	(assign (vpx (- bin n)) (vpx bin))

(vp-label 'done)
	(call :sys_mem :free (vpx list))
	(call :sys_mem :free (vpx path))
	(exit :sys_load :vp_find (vpx data bin n))
	(pop-scope)
	(return)

(def-func-end)

(def-method :sys_load :find)
	;inputs
	;:r0 = code pointer (ptr)
	;outputs
	;:r0 = 0, else function header pointer (ptr)
	;:r1 = function header offset (uint)
	;trashes
	;:r0-:r2
	;info
	;of the node's own functions, then of each server's

	(vp-rdef (cptr node_end node list) '(:r0 :r1 :r2 :r3))

	(entry :sys_load :find `(,cptr))

	(vp-push list)
	(fn-bind 'sys/statics/statics node)
	(vp-lea-i node statics_sys_load_server_flist list)
	(vp-add-cr statics_sys_load_function_flist node)
	(loop-start 'lists)
		(loop-flist node 0 node node)
			(assign `((,node +fn_header_entry)) `(,node_end))
			(vp-add-rr node node_end)
			(continueif `(,cptr < ,node_end))
			(assign `((,node +fn_header_links)) `(,node_end))
			(vp-add-rr node node_end)
		(loop-until `(,cptr < ,node_end))
		(breakif `(,node /= 0))
		;the next server's list
		(assign `((,list +ln_fnode_next)) `(,list))
		(breakif `(,list = 0))
		(vp-lea-i list +ld_server_flist node)
	(loop-end)
	(vp-sub-rr node cptr)
	(vp-pop list)

	(exit :sys_load :find `(,node ,cptr))
	(vp-ret)

(def-func-end)

(def-method :sys_load :place)
	;inputs
	;:r0 = list of str objects, native functions (ptr)
	;outputs
	;:r0 = 0 if one could not be placed or bound, else not 0
	;trashes
	;:r0-:r7, :f0-:f15
	;info
	;native functions put in the task's function server, none read from a
	;file: all of them copied in and on its list first, then each one's
	;Vtable bound, to them and the server's, then the node's, loading the
	;node's own as a bind would. So functions of the set that call each
	;other, in a ring too, bind. One that is not the length it says, or a
	;path there is none of, and the server's list is as it was

	(def-vars
		(ptr list statics server head func paths block nblocks sblocks)
		(pptr iter iter_end links)
		(long len))

	(push-scope)
	(entry :sys_load :place (vpx list))

	(assign (vpx (@ sys/statics/statics)) (vpx statics))
	(assign (vpx (.> (.> statics statics_sys_task_current_tcb) +tk_node_server)) (vpx server))
	(assign (vpx 0) (vpx func))
	(gotoif (vpx (= server 0)) 'exit)
	(assign (vpx server (.> server +ld_server_flist)) (vpx (.> statics statics_sys_load_server) head))
	;on in the newest block of the server, and of the node's own it loads
	(assign (vpx (.> server +ld_server_blocks)) '(:r3))
	(ld-open :r3 :r5)
	(assign '(:r5) (vpx sblocks))
	(assign (vpx (.> statics statics_sys_load_block_flist)) '(:r3))
	(ld-open :r3 :r5)
	(assign '(:r5) (vpx nblocks))

	;each copied in and put on the list
	(assign (vpx (.> list +array_begin) (.> list +array_length)) (vpx iter iter_end))
	(assign (vpx (+ iter (* iter_end +ptr_size))) (vpx iter_end))
	(loop-while (vpx (/= iter iter_end)))
		(assign (vpx (* iter)) (vpx func))
		(assign (vpx (.> func +str_length) (& (.> func +str_data))) (vpx len func))
		(gotoif (vpx (/= (.> func +fn_header_length) len)) 'fail)
		;room for it, in a new block if not
		(vpif (vpx (< (- (.> server +ld_server_end) (.> server +ld_server_start)) len)))
			(call :host_os :pii_mmap (vpx ld_block_size -1 +mmap_data) (vpx block))
			(assign (vpx (.> server +ld_server_blocks)) (vpx (.> block +ln_fnode_next)))
			(assign (vpx block) (vpx (.> server +ld_server_blocks)))
			(assign (vpx (+ block +ptr_size) (+ block ld_block_size)) (vpx (.> server +ld_server_start) (.> server +ld_server_end)))
		(endif)
		(assign (vpx (.> server +ld_server_start)) (vpx block))
		(call :sys_mem :copy (vpx func block len))
		(call :host_os :pii_clear_icache (vpx block len))
		(assign (vpx (.> server +ld_server_flist)) (vpx (.> block +ln_fnode_next)))
		(assign (vpx block) (vpx (.> server +ld_server_flist)))
		(assign (vpx (& (+ block len +ptr_size -1) (- 0 +ptr_size))) (vpx (.> server +ld_server_start)))
		(assign (vpx (+ iter +ptr_size)) (vpx iter))
	(loop-end)

	;then each one's Vtable bound, the newest first, down to the list as it was
	(assign (vpx (.> server +ld_server_flist)) (vpx func))
	(loop-while (vpx (/= func head)))
		(assign (vpx (+ func (.> func +fn_header_links)) (+ func (.> func +fn_header_paths)))
			(vpx links paths))
		(loop-while (vpx (/= links paths)))
			;the entry is the offset from itself to the path
			(assign (vpx (+ links (* links))) (vpx iter))
			(call :sys_load :search (vpx iter) (vpx block))
			(vpif (vpx (= block 0)))
				(call :sys_load :load (vpx iter) (vpx block))
				(gotoif (vpx (= block 0)) 'fail)
			(endif)
			(assign (vpx block) (vpx (* links)))
			(assign (vpx (+ links +ptr_size)) (vpx links))
		(loop-end)
		(assign (vpx (.> func +ln_fnode_next)) (vpx func))
	(loop-end)
	(assign (vpx 1) (vpx func))
	(goto 'done)

(vp-label 'fail)
	;the server's list as it was, what was copied in is let be till it goes
	(assign (vpx head) (vpx (.> server +ld_server_flist)))
	(assign (vpx 0) (vpx func))

(vp-label 'done)
	;the new blocks made runnable
	(assign (vpx (.> server +ld_server_blocks)) (vpx block))
	(loop-while (vpx (/= block sblocks)))
		(call :host_os :pii_mprotect (vpx block ld_block_size +mmap_exec) (vpx _))
		(assign (vpx (.> block +ln_fnode_next)) (vpx block))
	(loop-end)
	(assign (vpx (.> statics statics_sys_load_block_flist)) (vpx block))
	(loop-while (vpx (/= block nblocks)))
		(call :host_os :pii_mprotect (vpx block ld_block_size +mmap_exec) (vpx _))
		(assign (vpx (.> block +ln_fnode_next)) (vpx block))
	(loop-end)

(vp-label 'exit)
	(exit :sys_load :place (vpx func))
	(pop-scope)
	(return)

(def-func-end)

(def-method :sys_load :server)
	;inputs
	;:r0 = c string, the server's folder under the load path (pubyte)
	;outputs
	;:r0 = function server (ptr)
	;trashes
	;:r0-:r3, :r5-:r7, :f0-:f15
	;info
	;the node's server of that folder, made if it has none

	(entry :sys_load :server '(:r6))

	(fn-bind 'sys/statics/statics :r7)
	(loop-flist :r7 statics_sys_load_server_flist :r5 :r5)
		(call :sys_str :compare '(:r6 (& :r5 +ld_server_name)) '(:r0))
	(loop-until '(:r0 = 0))
	(vpif '(:r5 = 0))
		(call :sys_mem :alloc '(+ld_server_size) '(:r5 _))
		(vp-xor-rr :r0 :r0)
		(assign '(:r0 :r0 :r0 :r0 :r0)
			'((:r5 +ld_server_flist) (:r5 +ld_server_blocks) (:r5 +ld_server_start)
			(:r5 +ld_server_end) (:r5 +ld_server_mark)))
		(call :sys_str :copy '(:r6 (& :r5 +ld_server_name)))
		(fn-bind 'sys/statics/statics :r7)
		(ln-add-fnode :r7 statics_sys_load_server_flist :r5 :r0)
	(endif)

	(exit :sys_load :server '(:r5))
	(vp-ret)

(def-func-end)

(def-method :sys_load :sweep)
	;trashes
	;:r0-:r2, :r5-:r13, :f0-:f15
	;info
	;a server no task of the node has goes, its blocks and itself. Marked
	;by the tasks there are, not counted, so a task that went any way at
	;all, its server is let go of

	(vp-rdef (statics srv last tasks tasks_end node next) '(:r7 :r8 :r9 :r10 :r11 :r12 :r13))

	(fn-bind 'sys/statics/statics statics)

	;none marked
	(loop-flist statics statics_sys_load_server_flist srv srv)
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) `((,srv +ld_server_mark)))
	(loop-end)

	;each task's server marked
	(assign `((& ,statics statics_sys_task_suspend_list)) `(,tasks))
	(assign `((& ,tasks ,(* (+ tk_num_task_lists 2) +lh_list_size))) `(,tasks_end))
	(loop-start)
		(loop-list-forward tasks 0 node next)
			(assign `((,node +tk_node_server)) '(:r0))
			(vpif '(:r0 /= 0))
				(vp-cpy-cr 1 :r1)
				(assign '(:r1) '((:r0 +ld_server_mark)))
			(endif)
		(loop-end)
		(vp-add-cr +lh_list_size tasks)
	(loop-until `(,tasks = ,tasks_end))

	;the rest go
	(loop-flist statics statics_sys_load_server_flist srv last)
		(assign `((,srv +ld_server_mark)) '(:r0))
		(continueif '(:r0 /= 0))
		(assign `((,srv +ld_server_blocks)) '(:r6))
		(loop-while '(:r6 /= 0))
			(assign '((:r6 +ln_fnode_next)) '(:r5))
			(call :host_os :pii_munmap '(:r6 ld_block_size +mmap_data))
			(vp-cpy-rr :r5 :r6)
		(loop-end)
		(vp-cpy-rr srv :r0)
		(ln-remove-fnode srv last)
		(call :sys_mem :free '(:r0))
	(loop-end)

	(vp-ret)

(def-func-end)
