(include "lib/asm/func.inc")
(include "class/nodeid/class.inc")
(include "class/hset/class.inc")
(include "class/lisp/class.inc")
(include "gui/font/class.inc")
(include "./class.inc")

(def-method :sys_kernel :lisp_stats)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :sys_kernel :lisp_stats '(:r0 :r1))

	(vp-push :r0)
	;given anything, first what a task's end lets go of, class/lisp/run.vp:
	;the numbers and symbols no one holds, the words of the fonts kept as
	;textures, a cache that is let go of when it is full, and the free blocks
	;given back, so what is left is what is held
	(assign '((:r1 +array_length)) '(:r2))
	(vpif '(:r2 /= 0))
		(call :font :flush)
		(fn-bind 'sys/statics/statics :r0)
		(call :hset :flush '((:r0 statics_num_intern)))
		(fn-bind 'sys/statics/statics :r0)
		(call :hset :flush '((:r0 statics_sym_intern)))
		(call :sys_mem :collect)
	(endif)
	(call :sys_mem :avail :nil '(:r10))
	(call :sys_task :stacks :nil '(:r11))
	(call :sys_mem :inuse :nil '(:r12))
	(call :array :create :nil '(:r0))
	(fn-bind 'sys/statics/statics :r1)
	(call :array :push_back2
		'(:r0 (:r1 statics_sys_task_task_count) (:r1 statics_sys_mem_total))
		'(:r0 _ _ _ _))
	(call :array :push_back2 '(:r0 :r10 :r11) '(:r0 _ _ _ _))
	(fn-bind 'sys/statics/statics :r1)
	(call :array :push_back '(:r0 (:r1 statics_sys_task_idle)) '(:r1 _ _ _))
	(call :array :push_back '(:r1 :r12) '(:r1 _ _ _))
	(vp-pop :r0)

	(exit :sys_kernel :lisp_stats '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :sys_kernel :lisp_sysid)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = nodeid object (ptr)
	;trashes
	;:r1-:r5, :f0-:f15

	(entry :sys_kernel :lisp_sysid '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(fn-bind 'sys/statics/statics :r0)
	(call :nodeid :create `((& :r0 statics_sys_task_kernel_system_id)) '(:r1))
	(vp-pop :r0)

	(exit :sys_kernel :lisp_sysid '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(system-id)" +error_msg_wrong_num_of_args)))

(def-func-end)
