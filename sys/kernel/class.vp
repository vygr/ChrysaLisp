(include "lib/asm/func.inc")
(include "class/nodeid/class.inc")
(include "class/lisp/class.inc")
(include "class/hmap/class.inc")
(include "./class.inc")
(include "././str/class.inc")
(include "././math/class.inc")
(include "././load/class.inc")
(include "././link/class.inc")

;;;;;;;;;;;;;
; kernel task
;;;;;;;;;;;;;

(defun kn-held-hash (prefix)
	;emit the code to work out the hash of the services we hold for the
	;origin of a ping, those that start with the prefix char, to set against
	;the hash in the ping. As the sender does, the sum of the hashes of the
	;entries, with 0 for none. Each entry keeps its own hash, so nothing is
	;stored for this.
	(assign `(,prefix) '(:r0))
	(vp-xor-rr :r1 :r1)
	(save-fields :rsp `(,(+ slot_held held_prefix) ,(+ slot_held held_sum) ,(+ slot_held held_cnt))
		'(:r0 :r1 :r1))
	(call :array :get_first '((:rsp slot_tuple)) '(_ :r0))
	(assign '(:r0) '((:rsp slot_set)))
	(call :hset :each '(:r0 ($ hash_prefix) (& :rsp slot_held)))
	(assign `((:rsp ,(+ slot_held held_sum))) '(:r0))
	(assign '(:r0) '((:rsp slot_held_hash)))
	(assign `((:rsp slot_held_hash) (:rsp ,(+ slot_held held_cnt))) '(:r0 :r1))
	(vpif '(:r1 /= 0) '(:r0 = 0))
		(vp-cpy-cr 1 :r0)
		(assign '(:r0) '((:rsp slot_held_hash)))
	(endif))

(defun kn-send-want ()
	;emit the code to ask the origin of a ping for its services, it will
	;answer with a full ping to all
	(call :sys_mail :alloc `(,+kn_msg_size) '(:r0 :r1))
	(assign `(,+kn_call_want) '(:r2))
	(assign '(:r2) '((:r1 +kn_msg_func)))
	(vp-xor-rr :r2 :r2)
	(assign '(:r2) `((:r0 ,(+ +msg_dest +net_id_mbox_id))))
	(assign '((:rsp slot_data)) '(:r1))
	(assign-node-id :r1 +kn_msg_ping_origin :r0 (+ +msg_dest +net_id_node_id) :r2 :r3)
	(call :sys_mail :send '(:r0)))

(defun kn-services (prefix)
	;emit the code to update the services we hold for the origin of a ping,
	;those that start with the prefix char: the ones a full ping has, else
	;none if it says it has none, else ask for them if they are not those
	;we hold
	(load-fields :rsp '(slot_msg slot_data) '(:r1 :r0))
	(assign '((:r0 +kn_msg_ping_full)) '(:r2))
	(vpif '(:r2 /= 0))
		;the services are here
		(assign '((:r1 +msg_length)) '(:r1))
		(vp-sub-cr +kn_msg_ping_services :r1)
		(vp-add-cr +kn_msg_ping_services :r0)
		(call :str :create_from_buffer '(:r0 :r1) '(:r0))
		(assign '(:r0) '((:rsp slot_services)))
		(call :str :split `(:r0 ,+char_lf) '(_ :r1))
		(assign '(:r1) '((:rsp slot_entries)))
		(call :str :destroy '((:rsp slot_services)))
		(call :list :get_both '((:rsp slot_entries)) '(_ :r1 :r2))
		(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r1 :r2))
		(call :array :get_first '((:rsp slot_tuple)) '(_ :r0))
		(assign '(:r0) '((:rsp slot_set)))
		(call :hset :each `(:r0 ($ erase_prefix) ,prefix))
		(loop-start)
			(load-fields :rsp '(slot_set slot_iter_begin slot_iter_end) '(:r0 :r1 :r2))
			(breakif '(:r1 = :r2))
			(vp-lea-rcr :r1 +ptr_size :r2)
			(assign '(:r2) '((:rsp slot_iter_begin)))
			(call :hset :cinsert '(:r0 (:r1 0) (@ class/sym/eql_str)))
		(loop-end)
		(call :list :destroy '((:rsp slot_entries)))
	(else)
		(kn-held-hash prefix)
		(assign '((:rsp slot_data) (:rsp slot_held_hash)) '(:r0 :r1))
		(assign '((:r0 +kn_msg_ping_hash)) '(:r0))
		(vpif '(:r0 /= :r1))
			(vpif '(:r0 = 0))
				;it has none now, so nor do we, and no need to ask
				(call :hset :each `((:rsp slot_set) ($ erase_prefix) ,prefix))
			(else)
				;not the services we hold for this node, so ask for them
				(kn-send-want)
			(endif)
		(endif)
	(endif))

(defun kn-not-me ()
	;emit the code to set :r0 to 0 if the origin of the ping is this node
	(assign '((:rsp slot_data)) '(:r2))
	(load-node-id :rsp slot_node_id :r0 :r1)
	(load-node-id :r2 +kn_msg_ping_origin :r2 :r3)
	(vp-sub-rr :r2 :r0)
	(vp-sub-rr :r3 :r1)
	(vp-or-rr :r1 :r0))

(defun kn-flood ()
	;emit the code to flood the ping onwards
	(load-fields :rsp `(slot_statics slot_msg slot_data ,(+ slot_node_id +node_id_node1) ,(+ slot_node_id +node_id_node2))
		'(:r0 :r1 :r2 :r3 :r4))
	(call 'flood_fill '(:r0 :r1 :r2 :r3 :r4)))

(defun kn-time ()
	;emit the code to set the time the origin of the ping is known till
	(load-fields :rsp '(slot_data slot_time) '(:r0 :r1))
	(assign '((:r0 +kn_msg_ping_interval)) '(:r0))
	(vp-shl-cr 1 :r0)
	(vp-add-rr :r0 :r1)
	(vp-add-cr ping_slack :r1)
	(call :array :set_elem `((:rsp slot_tuple) :r1 ,+node_time)))

(defun kn-via ()
	;emit the code to add the via of the ping to the ways to its origin
	(assign '((:rsp slot_data)) '(:r2))
	(load-node-id :r2 +kn_msg_ping_via :r1 :r2)
	(call :array :push_back2 '((:rsp slot_tuple) :r1 :r2)))

(def-method :sys_kernel :kernel)
	;inputs
	;:r0 = argv pointer (pptr)
	;info
	;loader is already initialized when we get here !
	;trashes
	;:r0-:r14, :d0-:d15

	(structure held 0
		(long prefix sum cnt))

	(structure slot 0
		(ptr argv link statics mbox_addr msg data tuple key best_nodes)
		(pptr iter_begin iter_end)
		(nodeid node_id)
		(long time)
		(uint best_cnt best_rand)
		;of a ping
		(ptr set bucket new_key services entries)
		(long session_cluster session_sys hops)
		(struct held held_size)
		(uint ping_func held_hash)
		;what the host says it is
		(struct host 64))

	(vp-alloc slot_size)
	(entry '(:r0))
	(assign '(:r0) '((:rsp slot_argv)))

	;init allocator
	(call :sys_mem :statics_init)

	;init symbols
	(call :sym :statics_init)

	;init tasks
	(call :sys_task :statics_init)

	;init mailer mailbox list
	(call :sys_mail :statics_init)

	;start kernel task (get's mailbox id of 0 !)
	(fn-bind 'sys/statics/statics :r0)
	(assign '(:r0) '((:rsp slot_statics)))
	(call :sys_task :start '(($ fn_entry)) '(:r0 :r1 _ _ _))
	(assign '((:rsp slot_statics)) '(:r2))
	(assign '(:r0 :r0 :r1)
		'((:r2 statics_sys_task_kernel_tcb) (:r2 statics_sys_task_current_tcb) (:rsp slot_mbox_addr)))

	;init mailer
	(call :sys_mail :statics_init1)

	;allocate best choice nodes array
	(call :array :create :nil '((:rsp slot_best_nodes)))

	;set random node ID
	(assign '((:rsp slot_statics)) '(:r0))
	(vp-add-cr statics_sys_task_kernel_node_id :r0)
	(call :host_os :pii_rand `(:r0 ,+node_id_size))
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp slot_node_id :r0 :r1)
	;obtain persistent system ID from host OS
	(assign '((:rsp slot_statics)) '(:r0))
	(vp-add-cr statics_sys_task_kernel_system_id :r0)
	(call :host_os :pii_sysid `(:r0 ,+node_id_size))

	;has the host the clock that is cheap to ask ? It says what it is in
	;four words, and the fourth is how new: 3 has :pii_tick. One of
	;fewer words is from before there was a fourth
	(call :host_os :pii_host '((& :rsp slot_host) 64) '(:r0))
	(vp-lea-rcr :rsp slot_host :r2)
	(vp-add-rr :r2 :r0)
	(vp-xor-rr :r1 :r1)
	(vp-xor-rr :r4 :r4)
	(vpif '(:r2 /= :r0))
		(loop-start)
			(vp-load-rcr-ub :r2 0 :r3)
			(vp-add-cr 1 :r2)
			(vpif `(:r3 = ,(ascii-code " ")))
				;the next word, and the number is of that
				(vp-add-cr 1 :r4)
				(vp-xor-rr :r1 :r1)
			(else)
				(vp-mul-cr 10 :r1)
				(vp-sub-cr (ascii-code "0") :r3)
				(vp-add-rr :r3 :r1)
			(endif)
		(loop-until '(:r2 = :r0))
	(endif)
	(vp-xor-rr :r0 :r0)
	(vpif '(:r4 = 3))
		(vpif '(:r1 >= 3))
			(vp-cpy-cr 1 :r0)
		(endif)
	(endif)
	(assign '((:rsp slot_statics)) '(:r2))
	(assign '(:r0) '((:r2 statics_sys_task_tick)))

	;process command options
	(call 'opts '((:rsp slot_argv)))

	;start routing pings
	(call :nodeid :create '(0) '((:rsp slot_key)))
	(call :sys_load :bind `(,(str (f-path :sys_kernel :ping))) '(:r0))
	(vpif '(:r0 /= 0))
		(call :sys_task :start '(:r0))
	(endif)

;;;;;;;;;;;;;;;;;;;;;;;
; main kernel task loop
;;;;;;;;;;;;;;;;;;;;;;;

	;loop till no other tasks running
	(call :sys_task :set_priority '(tk_kernel_priority))
	(loop-start 'exit)
		;service all kernel mail
		(loop-start 'kernel_loop)
			;check if any mail
			(assign '((:rsp slot_mbox_addr)) '(:r0))
			(lh-is-empty :r0 +mbox_list :r1)
			(breakif '(:r1 = 0))
			(call :sys_mail :read '(:r0) '(:r0 :r1))
			(save-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
			;which kernel call number
			(assign '((:r1 +kn_msg_func)) '(:r0))
			(switch)
			(vpcase '(:r0 = +kn_call_pin))
			(vp-label 'run_here)
				;fill in reply ID, user field is left alone !
				(assign '((:rsp slot_data)) '(:r0))
				(vp-add-cr +kn_msg_open_pathname :r0)
				(call 'opt_run '(:r0) '(:r0 :r1 :r2))
				;the answer is a message of its own: it says who answers
				;too, and what asked may be shorter than that
				(vp-simd vp-cpy-rr '(:r0 :r1 :r2) '(:r6 :r7 :r8))
				(call :sys_mail :alloc '(+kn_msg_reply_size) '(:r0 :r1))
				(assign '((:rsp slot_data)) '(:r4))
				(assign-net-id :r4 +kn_msg_reply_id :r0 +msg_dest :r2 :r3 :r5)
				(save-net-id :r1 +kn_msg_reply_id :r6 :r7 :r8)
				;the func and the user field are as they came
				(load-fields :r4 '(+kn_msg_func +kn_msg_key) '(:r2 :r3))
				(save-fields :r1 '(+kn_msg_func +kn_msg_key) '(:r2 :r3))
				(vp-simd vp-cpy-rr '(:r0 :r1) '(:r6 :r7))
				(call :sys_kernel :id :nil '(:r0 :r1))
				(assign '(:r0 :r1) `((:r7 ,(+ +kn_msg_reply_node +node_id_node1)) (:r7 ,(+ +kn_msg_reply_node +node_id_node2))))
				(call :sys_mail :send '(:r6))
				(call :sys_mail :free '((:rsp slot_msg)))
				(break)
			(vpcase '(:r0 = +kn_call_run))
				;find best cpu to run task on the same physical system, the
				;one with the least load, see sys/statics/class.inc
				(call :array :clear '((:rsp slot_best_nodes)))
				(assign '((:rsp slot_statics)) '(:r0))
				(load-fields :r0 '(statics_sys_task_task_count statics_sys_task_lag) '(:r1 :r2))
				(vp-add-rr :r2 :r1)
				(assign '(:r1) '((:rsp slot_best_cnt)))
				(call :array :get_both '((:r0 statics_sys_mail_links_array)) '(_ :r1 :r2))
				(save-fields :rsp '(slot_iter_begin slot_iter_end) '(:r1 :r2))
				(loop-start)
					(load-fields :rsp '(slot_iter_begin slot_iter_end) '(:r0 :r1))
					(breakif '(:r0 = :r1))
					(assign '((:r0 0)) '(:r1))
					(vp-add-cr +ptr_size :r0)
					(save-fields :rsp '(slot_link slot_iter_begin) '(:r1 :r0))

					;skip links that belong to a different physical machine
					(assign '((:rsp slot_statics)) '(:r0))
					(load-node-id :r1 lk_node_peer_system_id :r2 :r3)
					(load-node-id :r0 statics_sys_task_kernel_system_id :r4 :r5)
					(vp-xor-rr :r4 :r2)
					(vp-xor-rr :r5 :r3)
					(vp-or-rr :r3 :r2)
					(continueif '(:r2 /= 0))

					;the load of the link, :r2, none or more than the best is not
					;one, less is a new best
					(assign '((:r1 lk_node_task_count) (:rsp slot_best_cnt)) '(:r2 :r3))
					(continueif '(:r2 = 0) '(:r2 > :r3))
					(vpif '(:r2 < :r3))
						(assign '(:r2) '((:rsp slot_best_cnt)))
						(call :array :clear '((:rsp slot_best_nodes)))
					(endif)
					(call :array :push_back '((:rsp slot_best_nodes) (:rsp slot_link)))
				(loop-end)
				(assign '((:rsp slot_statics)) '(:r0))
				(assign '((:r0 statics_sys_task_task_count) (:r0 statics_sys_task_lag) (:rsp slot_best_cnt))
					'(:r1 :r2 :r3))
				(vp-add-rr :r2 :r1)
				(gotoif '(:r1 <= :r3) 'run_here)
				;send to random better kernel
				(call :array :get_length '((:rsp slot_best_nodes)) '(_ :r1))
				(assign '((:rsp slot_best_rand)) '(:r0))
				(vp-add-cr 1 :r0)
				(assign '(:r0) '((:rsp slot_best_rand)))
				(vp-rem-rr-u :r1 :r0)
				(call :array :get_elem '((:rsp slot_best_nodes) :r0) '(_ :r1))
				(assign '(:r1) '((:rsp slot_link)))
				;is the node that was chosen still there ? Its link knows of
				;a process that has gone only at its next beat, a second,
				;and a task sent to it till then is lost, with whoever
				;waits to hear of it. The host knows now, so it is asked,
				;for a link whose peer is a process of this machine, and
				;the task is run here if it has gone
				(assign '((:r1 lk_node_peer_pid)) '(:r0))
				(vpif '(:r0 /= 0))
					(call :host_os :pii_alive '(:r0) '(:r0))
					(gotoif '(:r0 = 0) 'run_here)
				(endif)
				(load-fields :rsp '(slot_link slot_msg) '(:r1 :r0))
				(assign-node-id :r1 lk_node_peer_node_id :r0 (+ +msg_dest +net_id_node_id) :r2 :r3)
				(call :sys_mail :send '(:r0))
				(break)
			(vpcase '(:r0 = +kn_call_want))
				;a node wants our services, so a full ping is due. Many may
				;ask at once, so no more than one a second.
				(assign '((:rsp slot_statics)) '(:r1))
				(assign '((:r1 statics_sys_mail_full_time)) '(:r0))
				(vp-add-cr 1000000 :r0)
				(vp-cpy-cr 1 :r2)
				(assign '(:r2) '((:r1 statics_sys_mail_ping_full)))
				(assign '((:r1 statics_sys_mail_ping_next)) '(:r2))
				(vpif '(:r0 < :r2))
					(assign '(:r0) '((:r1 statics_sys_mail_ping_next)))
				(endif)
				(call :sys_mail :free '((:rsp slot_msg)))
				(break)
			(vpcase '(:r0 >= +kn_call_ping))
				;new services/routing ping
				(assign '((:rsp slot_data)) '(:r0))
				(assign '((:r0 +kn_msg_func)) '(:r0))
				(assign '(:r0) '((:rsp slot_ping_func)))

				;timestamp
				(call :host_os :pii_time :nil '((:rsp slot_time)))

				;find/create the routing tuple for the origin
				(load-fields :rsp '(slot_data slot_key) '(:r0 :r1))
				(assign-node-id :r0 +kn_msg_ping_origin :r1 +str_data)
				(assign '((:rsp slot_statics)) '(:r0))
				(call :hmap :cfind '((:r0 statics_sys_mail_node_map) (:rsp slot_key) (@ class/nodeid/eql)) '(_ :r1 :r2))
				(save-fields :rsp '(slot_tuple slot_bucket) '(:r1 :r2))
				(vpif '(:r1 = 0))
					(assign '((:rsp slot_data)) '(:r0))
					(vp-add-cr +kn_msg_ping_origin :r0)
					(call :nodeid :create '(:r0) '((:rsp slot_new_key)))
					(call :array :create :nil '((:rsp slot_tuple)))
					;the slots of the tuple are named in sys/mail/class.inc
					(call :hset :create '(1) '((:rsp slot_set)))
					(call :array :push_back2 '((:rsp slot_tuple) (:rsp slot_set) 0))
					(call :array :push_back2 '((:rsp slot_tuple) -1 -1))
					(call :array :push_back2 '((:rsp slot_tuple) 0 0))
					(call :array :push_back '((:rsp slot_tuple) -1))
					(call :list :push_back2 '((:rsp slot_bucket) (:rsp slot_new_key) (:rsp slot_tuple)))
				(else)
					(assign '((:r1 +ptr_size)) '(:r1))
					(assign '(:r1) '((:rsp slot_tuple)))
				(endif)

				;load current sessions and hops
				(call :array :get_begin '((:rsp slot_tuple)) '(_ :r1))
				(assign `((:r1 ,(* +long_size +node_session_cluster)) (:r1 ,(* +long_size +node_session_sys))
					(:r1 ,(* +long_size +node_hops))) '(:r1 :r2 :r3))
				(save-fields :rsp '(slot_session_cluster slot_session_sys slot_hops) '(:r1 :r2 :r3))

				(assign '((:rsp slot_ping_func)) '(:r0))
				(vpif `(:r0 = ,+kn_call_ping_sys))
					;--- System Ping: Update @ services, flood only to same-system peers ---
					(switch 'exit_ping_sys)
					(load-fields :rsp '(slot_data slot_session_sys) '(:r0 :r1))
					(assign '((:r0 +kn_msg_ping_session)) '(:r0))
					(breakif '(:r0 <= :r1) 'exit_ping_sys)

					;update session_sys (index 3) and time (index 1)
					(call :array :set_elem `((:rsp slot_tuple) :r0 ,+node_session_sys))
					(kn-time)

					;flood onwards within the physical system
					(kn-flood)

					;skip service updates if I am the origin
					(kn-not-me)
					(breakif '(:r0 = 0) 'exit_ping_sys)

					;update @ services: purge existing @ entries, then insert new
					(kn-services +char_at)
					(endswitch)
				(else)
					;--- Cluster Ping: Manage cluster routing and * services ---
					;the session :r0 and hops :r2 of the ping, the session
					;:r1 and hops :r3 as they were
					(switch 'exit_ping_cluster)
					(load-fields :rsp '(slot_data slot_session_cluster slot_hops) '(:r0 :r1 :r3))
					(assign '((:r0 +kn_msg_ping_session) (:r0 +kn_msg_ping_hops)) '(:r0 :r2))
					(breakif '(:r0 < :r1) 'exit_ping_cluster)
					(vpcase '(:r0 > :r1))
						;new cluster session: truncate back to 4 elements (preserves set, time, session_cluster, session_sys)
						(call :array :set_length `((:rsp slot_tuple) ,+node_hops))
						(kn-time)
						(assign '((:rsp slot_data)) '(:r1))
						(call :array :set_elem `((:rsp slot_tuple) (:r1 +kn_msg_ping_session) ,+node_session_cluster))
						(assign '((:rsp slot_data)) '(:r1))
						(call :array :set_elem `((:rsp slot_tuple) (:r1 ,(+ +kn_msg_ping_system +node_id_node1)) ,+node_system1))
						(assign '((:rsp slot_data)) '(:r1))
						(call :array :set_elem `((:rsp slot_tuple) (:r1 ,(+ +kn_msg_ping_system +node_id_node2)) ,+node_system2))
						(assign '((:rsp slot_data)) '(:r1))
						(call :array :push_back '((:rsp slot_tuple) (:r1 +kn_msg_ping_hops)))
						;a kick from another node ?
						(assign '((:rsp slot_data)) '(:r0))
						(assign '((:r0 +kn_msg_ping_kick)) '(:r0))
						(vpif '(:r0 /= 0))
							(kn-not-me)
							(vpif '(:r0 /= 0))
								(call :sys_mail :kick)
							(endif)
						(endif)
						(goto 'flood_via)
					(vpcase '(:r2 < :r3))
						;better route: truncate back to the hops, push new hops
						(call :array :set_length `((:rsp slot_tuple) ,+node_hops))
						(assign '((:rsp slot_data)) '(:r1))
						(call :array :push_back '((:rsp slot_tuple) (:r1 +kn_msg_ping_hops)))
					(vp-label 'flood_via)
						(kn-via)
						(kn-flood)
						(break)
					(vpcase '(:r2 = :r3))
						;equal route: append via
						(kn-via)
					(endswitch)

					;update * services: purge existing * entries, then insert new
					(switch)
					(load-fields :rsp '(slot_data slot_session_cluster) '(:r0 :r1))
					(assign '((:r0 +kn_msg_ping_session)) '(:r0))
					(breakif '(:r0 <= :r1))
					(kn-not-me)
					(breakif '(:r0 = 0))
					(default)
						(kn-services +char_multiply)
					(endswitch)
				(endif)

				(call :sys_mail :free '((:rsp slot_msg)))
				(break)
			(vpcase '(:r0 = +kn_call_callback))
				;call callback with this thread/stack
				(assign '((:rsp slot_data)) '(:r1))
				(assign '((:r1 +kn_msg_key) (:r1 +kn_msg_callback_addr)) '(:r0 :r1))
				(vp-call-r :r1)
				;wake originator
				(assign '((:rsp slot_data)) '(:r0))
				(call :sys_task :resume `((:r0 ,(+ +kn_msg_reply_id +net_id_mbox_id))))
				(call :sys_mail :free '((:rsp slot_msg)))
				(break)
			(vpcase '(:r0 = +kn_call_signal))
				;signal a task
				(assign '((:rsp slot_data)) '(:r0))
				(call :sys_mail :validate '((:r0 +kn_msg_signal_mbox)) '(:r0))
				(vpif '(:r0 /= 0))
					(assign '((:rsp slot_data)) '(:r1))
					(assign '((:r1 +kn_msg_signal_flags)) '(:r1))
					(assign '((:r0 +mbox_owner_tcb)) '(:r0))
					(assign '((:r0 +tk_node_flags)) '(:r2))
					(vp-or-rr :r1 :r2)
					(assign '(:r2) '((:r0 +tk_node_flags)))
					;one that is asleep is woken, to find it has been
					;signalled, (task-sleep) does. It is on the timer list,
					;its time is when it is to wake. As is one that waits
					;for mail. It is by an error that a task is stopped
					(assign '((:r0 +tk_node_time)) '(:r1))
					(vpif '(:r1 > 0))
						(vp-cpy-cr -1 :r1)
						(assign '(:r1) '((:r0 +tk_node_time)))
					(endif)
					(call :sys_task :resume '(:r0))
				(endif)
				(call :sys_mail :free '((:rsp slot_msg)))
			(endswitch)
		(loop-end)

		;resume any ready tasks and timeouts on the timer lists
		(call :sys_task :timer :nil '(:r0))

		;find next task we could defer to
		(assign '((:rsp slot_statics)) '(:r3))
		(assign '((& :r3 (+ statics_sys_task_task_lists +lh_list_size))) '(:r1))
		(assign '((& :r3 (+ statics_sys_task_task_lists (* tk_num_task_lists +lh_list_size)))) '(:r2))
		(loop-start)
			(lh-get-head :r1 0 :r4)
			(ln-get-succ :r4 0 :r5)
			(breakif '(:r5 /= 0))
			(vp-add-cr +lh_list_size :r1)
		(loop-until '(:r1 = :r2))

		;defer to task if available
		(vpif '(:r5 /= 0))
			(call :sys_task :defer '(:r4))
			(continue 'kernel_loop)
		(endif)

		;no other task ready to run so
		;exit if no tasks waiting for timers
		(lh-get-head :r3 statics_sys_task_timer_list :r4)
		(lh-get-head :r3 statics_sys_mail_timeout_list :r5)
		(ln-get-succ :r4 0 :r1)
		(ln-get-succ :r5 0 :r2)
		(vpif '(:r1 = 0))
			(breakif '(:r2 = 0) 'exit)
		(endif)

		;go to sleep till next wake time then
		(vp-cpy-cr +max_long :r6)
		(vp-cpy-rr :r6 :r7)
		(vpif '(:r1 /= 0))
			(assign '((:r4 +tk_node_time)) '(:r6))
		(endif)
		(vpif '(:r2 /= 0))
			(assign '((:r5 +msg_data)) '(:r7))
			(assign '((:r7 0)) '(:r7))
		(endif)
		(vp-min-rr :r7 :r6)
		(vp-sub-rr :r0 :r6)
		(assign '(:r0) '((:rsp slot_time)))
		(host-os-call :host_os :sleep '(:r6))

		;how long that was is time the node was idle, (kernel-stats)
		(call :host_os :pii_time :nil '(:r0))
		(assign '((:rsp slot_time) (:rsp slot_statics)) '(:r1 :r2))
		(vp-sub-rr :r1 :r0)
		(assign '((:r2 statics_sys_task_idle)) '(:r1))
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:r2 statics_sys_task_idle)))
	(loop-end)

	;deinit best choice array
	(call :array :deref '((:rsp slot_best_nodes)))

	;deinit allocator
	(call :sys_mem :statics_deinit)

	;exit back to load init
	(vp-free slot_size)
	(vp-ret)

(vp-label 'flood_fill)
	;inputs
	;:r0 = mail statics
	;:r1 = flood msg
	;:r2 = flood data
	;:r3-:r4 = kernel node_id
	;trashes
	;:r0-:r14

	(structure slot 0
		(nodeid system_id))

	(vp-rdef (msg data knode1 knode2 vnode1 vnode2 iter_begin iter_end iter link_node statics)
		'(:r14 :r13 :r12 :r11 :r10 :r9 :r8 :r7 :r6 :r5 :r4))

	(vp-alloc slot_size)
	(entry `(,statics ,msg ,data ,knode1 ,knode2))

	;load system ID
	(load-node-id statics statics_sys_task_kernel_system_id :r0 :r1)
	(save-node-id :rsp slot_system_id :r0 :r1)

	;inc hops, a uint
	(assign `((,data ,+kn_msg_ping_hops ui)) '(:r0))
	(vp-add-cr 1 :r0)
	(assign '(:r0) `((,data ,+kn_msg_ping_hops i)))
	;old via
	(load-node-id data +kn_msg_ping_via vnode1 vnode2)
	;set new via
	(save-node-id data +kn_msg_ping_via knode1 knode2)
	;loop over the links
	(assign `((,statics statics_sys_mail_links_array)) '(:r0))
	(class/array/get_both :r0 iter iter_end)
	(vp-cpy-rr iter iter_begin)
	(loop-while `(,iter /= ,iter_end) 'next_link)
		(assign `((,iter 0)) `(,link_node))
		(vp-add-cr +ptr_size iter)

		;if system ping, skip links leading to a different physical machine
		(assign `((,data +kn_msg_ping_func)) '(:r0))
		(vpif '(:r0 = +kn_call_ping_sys))
			(load-node-id :rsp slot_system_id :r0 :r1)
			(load-node-id link_node lk_node_peer_system_id :r2 :r3)
			(vp-sub-rr :r2 :r0)
			(vp-sub-rr :r3 :r1)
			(vp-or-rr :r1 :r0)
			(continueif '(:r0 /= 0) 'next_link)
		(endif)

		;this links peer
		(load-node-id link_node lk_node_peer_node_id knode1 knode2)
		;not there yet ?
		(assign `(,knode1 ,knode2) '(:r0 :r1))
		(vp-or-rr :r1 :r0)
		(continueif '(:r0 = 0))
		;it's the old via ?
		(assign `(,knode1) '(:r0))
		(vp-sub-rr vnode1 :r0)
		(vp-sub-rr vnode2 :r1)
		(vp-or-rr :r1 :r0)
		(continueif '(:r0 = 0))
		;have we sent to this node already ?
		(vp-cpy-rr iter_begin :r2)
		(loop-start)
			(assign '((:r2 0)) `(,link_node))
			(vp-add-cr +ptr_size :r2)
			(breakif (list :r2 '= iter))
			(load-node-id link_node lk_node_peer_node_id :r0 :r1)
			(vp-sub-rr knode1 :r0)
			(vp-sub-rr knode2 :r1)
			(vp-or-rr :r1 :r0)
			(continueif '(:r0 = 0) 'next_link)
		(loop-end)
		;multi-cast the data
		(call :sys_mail :alloc_obj `((,msg +msg_obj) ,data (,msg +msg_length)) '(:r0))
		(vp-xor-rr :r1 :r1)
		(save-net-id :r0 +msg_dest :r1 knode1 knode2)
		(call :sys_mail :send '(:r0))
	(loop-end)
	(vp-free slot_size)
	(vp-ret)

(vp-label 'erase_prefix)
	;inputs
	;:r0 = prefix char (uint)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0)) '(:r3))
	(vp-load-rcr-ub :r3 +str_data :r3)
	(vpif '(:r3 = :r0))
		(jump :list :erase '(:r2 :r1))
	(endif)
	(vp-ret)

(vp-label 'hash_prefix)
	;inputs
	;:r0 = prefix char, sum and count (plong)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0) (:r0 0)) '(:r1 :r3))
	(vp-load-rcr-ub :r1 +str_data :r2)
	(vpif '(:r2 = :r3))
		(vp-push :r0)
		(call :str :hash '(:r1) '(_ :r1))
		(vp-pop :r0)
		(assign `((:r0 ,+long_size) (:r0 ,(* 2 +long_size))) '(:r2 :r3))
		(vp-add-rr :r1 :r2)
		(vp-add-cr 1 :r3)
		(assign '(:r2 :r3) `((:r0 ,+long_size) (:r0 ,(* 2 +long_size))))
	(endif)
	(vp-ret)

(vp-label 'opts)
	;inputs
	;:r0 = argv array (pptr)
	;trashes
	;:r0-:r14
	;info
	;process command options

	(structure slot 0
		(pptr argv)
		(ptr arg)
		(plong table)
		(long offset))

	(vp-alloc slot_size)
	(entry '(:r0))
	(assign '(:r0) '((:rsp slot_argv)))

	(loop-start)
		(assign '((:rsp slot_argv)) '(:r0))
		(assign '((:r0 0)) '(:r1))
		(breakif '(:r1 = 0))
		(vp-add-cr +ptr_size :r0)
		(assign '(($ options_table)) '(:r2))
		(save-fields :rsp '(slot_argv slot_arg slot_table) '(:r0 :r1 :r2))
		(loop-start 'next_arg)
			(assign '((:rsp slot_table)) '(:r0))
			(assign '((:r0 0)) '(:r1))
			(breakif '(:r1 = 0))
			(vp-add-cr +ptr_size :r0)
			(save-fields :rsp '(slot_table slot_offset) '(:r0 :r1))
			(call :sys_str :compare '(:r0 (:rsp slot_arg)) '(:r0))
			(vpif '(:r0 = 0))
				(assign '((:rsp slot_argv)) '(:r0))
				(assign '((:r0 0)) '(:r0))
				(breakif '(:r0 = 0) 'next_arg)
				(assign '((:rsp slot_offset) ($ options_table)) '(:r1 :r2))
				(vp-add-rr :r2 :r1)
				(vp-call-r :r1)
				(break 'next_arg)
			(endif)
			(call :sys_str :length '((:rsp slot_table)) '(_ :r1))
			(assign '((:rsp slot_table)) '(:r0))
			(vp-add-rr :r1 :r0)
			(vp-add-cr +ptr_size :r0)
			(vp-and-cr (- 0 +ptr_size) :r0)
			(assign '(:r0) '((:rsp slot_table)))
		(loop-end)
	(loop-end)

	(vp-free slot_size)
	(vp-ret)

(vp-label 'opt_run)
	;inputs
	;:r0 = argv pointer (pubyte)
	;outputs
	;:r0-:r2 = 0 if error, else ID (net_id)
	;trashes
	;:r0-:r14

	(structure slot 0
		(pubyte arg)
		(netid id)
		(uint is_lisp))

	(vp-alloc slot_size)
	(entry '(:r0))
	(assign '(:r0) '((:rsp slot_arg)))

	;is this a lisp task or raw task
	(vp-xor-rr :r2 :r2)
	(vp-xor-rr :r3 :r3)
	(vp-xor-rr :r4 :r4)
	(save-net-id :rsp slot_id)
	(assign '(:r2) '((:rsp slot_is_lisp)))
	(vp-load-rcr-ub :r0 0 :r1)
	(vpif `(:r1 = ,+char_lrb))
		(vp-cpy-cr 1 :r1)
		(assign '(:r1) '((:rsp slot_is_lisp)))
	(else)
		(call :sys_str :length '(:r0) '(_ :r1))
		(vpif '(:r1 >= 5))
			(assign '((:rsp slot_arg)) '(:r0))
			(vp-add-rr :r1 :r0)
			(vp-sub-cr 5 :r0)
			(call :sys_str :compare '(:r0 ".lisp") '(:r0))
			(vpif '(:r0 = 0))
				;a .lisp file, and it has to be there. One that is not is
				;no task, the id is 0, and whoever asked is told so. A pipe
				;with a command that does not exist waited on it for ever
				(fn-bind 'sys/statics/statics :r1)
				(call :host_os :pii_stat '((:rsp slot_arg) (:r1 statics_sys_load_stat_buffer)) '(:r0))
				(gotoif '(:r0 /= 0) 'opt_run_exit)
				(vp-cpy-cr 1 :r1)
				(assign '(:r1) '((:rsp slot_is_lisp)))
			(endif)
		(endif)
	(endif)

	(assign '((:rsp slot_is_lisp)) '(:r0))
	(vpif '(:r0 /= 0))
		;start lisp run task and send args
		(call :sys_load :bind `(,(str (f-path :lisp :run))) '(:r0))
		(vpif '(:r0 /= 0))
			(call :sys_task :start '(:r0) '(_ _ :r2 :r3 :r4))
			(save-net-id :rsp slot_id)
			(call :str :create_from_cstr '((:rsp slot_arg)) '(:r0))
			(assign '(:r0) '((:rsp slot_arg)))
			(call :sys_mail :alloc_obj '(:r0 (& :r0 +str_data) (:r0 +str_length)) '(:r0))
			(load-net-id :rsp slot_id)
			(save-net-id :r0 +msg_dest)
			(call :sys_mail :send '(:r0))
			(call :str :deref '((:rsp slot_arg)))
		(endif)
	(else)
		;open as raw task and return mailbox ID
		(call :sys_load :bind '((:rsp slot_arg)) '(:r0))
		(vpif '(:r0 /= 0))
			;start this function as task
			(call :sys_task :start '(:r0) '(_ _ :r2 :r3 :r4))
			(save-net-id :rsp slot_id)
		(endif)
	(endif)

(vp-label 'opt_run_exit)
	(load-net-id :rsp slot_id :r0 :r1 :r2)
	(exit '(:r0 :r1 :r2))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'opt_link)
	;inputs
	;:r0 = argv pointer (pubyte)
	;trashes
	;:r0-:r11

	(entry '(:r0))

	;start link
	(vp-push :r0)
	(assign `(,(str (f-path :sys_link :link))) '(:r0))
(vp-label 'opt_link_run)
	(call :sys_load :bind '(:r0) '(:r0))
	(vp-pop :r8)
	(vpif '(:r0 /= 0))
		(call :sys_task :start '(:r0) '(_ _ :r9 :r10 :r11))
		;params message
		(call :sys_str :length '(:r8) '(_ :r0))
		(call :sys_mail :alloc '(:r0) '(:r0 :r1))
		(save-net-id :r0 +msg_dest :r9 :r10 :r11)
		(vp-cpy-rr :r0 :r3)
		(call :sys_str :copy '(:r8 :r1))
		;send to link task
		(call :sys_mail :send '(:r3))
	(endif)
	(vp-ret)

(vp-label 'opt_sid)
	;inputs
	;:r0 = argv pointer (pubyte)
	;trashes
	;:r0-:r4
	;info
	;the system id of this node is what is given, up to its size, and not
	;the one the host has for the machine. Nodes given the same are a
	;system of their own, tasks are not spread to them or from them

	(entry '(:r0))

	(vp-cpy-rr :r0 :r4)
	(fn-bind 'sys/statics/statics :r0)
	(vp-add-cr statics_sys_task_kernel_system_id :r0)
	(call :sys_mem :fill '(:r0 +node_id_size 0))
	(call :sys_str :length '(:r4) '(:r0 :r2))
	(vpif '(:r2 > +node_id_size))
		(vp-cpy-cr +node_id_size :r2)
	(endif)
	(fn-bind 'sys/statics/statics :r1)
	(vp-add-cr statics_sys_task_kernel_system_id :r1)
	(call :sys_mem :copy '(:r0 :r1 :r2))
	(vp-ret)

	(vp-align +ptr_size)
(vp-label 'options_table)
	(vp-long `(- ,(label-sym 'opt_sid) ,(label-sym 'options_table)))
	(vp-cstr "-sid")
	(vp-align +ptr_size)
	(vp-long `(- ,(label-sym 'opt_run) ,(label-sym 'options_table)))
	(vp-cstr "-run")
	(vp-align +ptr_size)
	(vp-long `(- ,(label-sym 'opt_link) ,(label-sym 'options_table)))
	(vp-cstr "-l")
	(vp-align +ptr_size)
	(vp-long 0)

(def-func-end)

(def-method :sys_kernel :id)
	;outputs
	;:r0-:r1 = node id (node_id)
	;trashes
	;:r0-:r1

	(entry :sys_kernel :id '())
	(fn-bind 'sys/statics/statics :r1)
	(exit :sys_kernel :id
		`((:r1 ,(+ statics_sys_task_kernel_node_id +node_id_node1))
		(:r1 ,(+ statics_sys_task_kernel_node_id +node_id_node2))))
	(vp-ret)

(def-func-end)

(def-method :sys_kernel :ping)
	;started by kernel at boot
	;trashes
	;none

	(structure purge 0
		(nodeid node_id)
		(long now))

	(structure slot 0
		(ptr statics key)
		(struct purge purge_size)
		(long now gap purge_nodes purge_mail lag))

	(vp-alloc slot_size)

	;don't count ping or postman tasks in load balancing
	(call :sys_task :count '(-2))

	(fn-bind 'sys/statics/statics :r0)
	(vp-xor-rr :r1 :r1)
	(save-fields :rsp '(slot_statics slot_purge_nodes slot_purge_mail slot_lag) '(:r0 :r1 :r1 :r1))
	(assign '(:r1) '((:r0 statics_sys_task_lag)))
	(call :nodeid :create '(0) '((:rsp slot_key)))
	(call :host_os :pii_time :nil '((:rsp slot_now)))
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp (+ slot_purge purge_node_id) :r0 :r1)
	(loop-start)
		(call :sys_task :sleep '(ping_tick))
		;now :r0, the last now :r1, kept over the time call
		(assign '((:rsp slot_now)) '(:r1))
		(call :host_os :pii_time :nil '(:r0))
		(assign '(:r0) '((:rsp slot_now)))

		;if I have not run for a while, this node was busy, or was
		;stopped, and may have missed pings. So give every node that
		;time again before it is purged. The gap :r2
		(vp-cpy-rr :r0 :r2)
		(vp-sub-rr :r1 :r2)
		(assign '(:r2) '((:rsp slot_gap)))

		;how late am I ? I asked to sleep for a tick. A task that is ready
		;to run waits that long for this node, so it is the honest measure
		;of how busy the node is, a count of its tasks is not, most of them
		;are asleep. It rises at once, and falls away by a quarter a tick.
		(vp-cpy-rr :r2 :r3)
		(vp-sub-cr ping_tick :r3)
		(assign '((:rsp slot_lag)) '(:r4))
		(vpif '(:r3 > :r4))
			(vp-cpy-rr :r3 :r4)
		(else)
			(vp-cpy-rr :r4 :r5)
			(vp-shr-cr 2 :r5)
			(vp-sub-rr :r5 :r4)
		(endif)
		(assign '(:r4) '((:rsp slot_lag)))
		(vp-cpy-cr lag_per_task :r5)
		(vp-div-rr-u :r5 :r4)
		(assign '((:rsp slot_statics)) '(:r5))
		(assign '(:r4) '((:r5 statics_sys_task_lag)))

		(vpif `(:r2 > ,ping_stall))
			(assign '((:rsp slot_statics)) '(:r0))
			(call :hmap :each '((:r0 statics_sys_mail_node_map) ($ stall_callback) (& :rsp slot_gap)))
		(endif)

		;has a link come up or gone down ? If so kick the network, and
		;soon, but not at once, as more links may be about to change.
		;The sum of the peers :r3
		(assign '((:rsp slot_statics)) '(:r0))
		(call :array :get_both '((:r0 statics_sys_mail_links_array)) '(_ :r1 :r2))
		(vp-xor-rr :r3 :r3)
		(loop-while '(:r1 /= :r2))
			(assign '((:r1 0)) '(:r4))
			(vp-add-cr +ptr_size :r1)
			(load-node-id :r4 lk_node_peer_node_id :r5 :r6)
			(vp-add-rr :r5 :r3)
			(vp-add-rr :r6 :r3)
		(loop-end)
		(assign '((:rsp slot_statics)) '(:r0))
		(assign '((:r0 statics_sys_mail_links_sig)) '(:r1))
		(vpif '(:r3 /= :r1))
			(vp-cpy-cr 1 :r1)
			(save-fields :r0 '(statics_sys_mail_links_sig statics_sys_mail_ping_kick) '(:r3 :r1))
			(call :sys_mail :kick)
			;a link that went down as its peer's process is gone has set
			;that node's time up, so purge now, not within the second
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:rsp slot_purge_nodes)))
			(call :sys_math :i_rand '((* ping_tick 2)) '(:r0))
			(load-fields :rsp '(slot_statics slot_now) '(:r1 :r2))
			(vp-add-rr :r2 :r0)
			(assign '((:r1 statics_sys_mail_ping_next)) '(:r2))
			(vpif '(:r0 < :r2))
				(assign '(:r0) '((:r1 statics_sys_mail_ping_next)))
			(endif)
		(endif)

		;time to ping ? The ping says how long till the next, at most,
		;and then the period is backed off.
		(load-fields :rsp '(slot_statics slot_now) '(:r0 :r1))
		(assign '((:r0 statics_sys_mail_ping_next)) '(:r2))
		(vpif '(:r1 >= :r2))
			(assign '((:r0 statics_sys_mail_ping_full)) '(:r2))
			(vpif '(:r2 /= 0))
				(assign '(:r1) '((:r0 statics_sys_mail_full_time)))
			(endif)
			(call :sys_mail :ping '(:r2))
			(assign '((:rsp slot_statics)) '(:r0))
			(assign '((:r0 statics_sys_mail_ping_interval)) '(:r0))
			(assign '(:r0) '((:rsp slot_gap)))
			(vp-shr-cr 2 :r0)
			(call :sys_math :i_rand '(:r0) '(:r0))
			(load-fields :rsp '(slot_statics slot_now slot_gap) '(:r1 :r2 :r3))
			(vp-add-rr :r3 :r2)
			(vp-sub-rr :r0 :r2)
			(vp-xor-rr :r0 :r0)
			(assign '(:r2 :r0 :r0)
				'((:r1 statics_sys_mail_ping_next) (:r1 statics_sys_mail_ping_full) (:r1 statics_sys_mail_ping_kick)))
			(vp-shl-cr 1 :r3)
			(vpif `(:r3 > ,ping_period_max))
				(assign `(,ping_period_max) '(:r3))
			(endif)
			(assign '(:r3) '((:r1 statics_sys_mail_ping_interval)))
		(endif)

		;purge stale nodes
		(load-fields :rsp '(slot_now slot_purge_nodes) '(:r0 :r1))
		(vpif '(:r0 >= :r1))
			(vp-lea-rcr :r0 1000000 :r1)
			(save-fields :rsp `(slot_purge_nodes ,(+ slot_purge purge_now)) '(:r1 :r0))
			(assign '((:rsp slot_statics)) '(:r0))
			(call :hmap :each '((:r0 statics_sys_mail_node_map) ($ purge_callback) (& :rsp slot_purge)))
		(endif)

		;purge stale messages and parcels
		(load-fields :rsp '(slot_now slot_purge_mail) '(:r0 :r1))
		(vpif '(:r0 >= :r1))
			(vp-lea-rcr :r0 ping_period :r1)
			(assign '(:r1) '((:rsp slot_purge_mail)))
			(load-fields :rsp '(slot_statics slot_now slot_key) '(:r0 :r1 :r2))
			(vp-add-cr statics_sys_mail_outbound_list :r0)
			(vp-call 'purge_mail_out)
			(load-fields :rsp '(slot_statics slot_now slot_key) '(:r0 :r1 :r2))
			(vp-add-cr statics_sys_mail_parcel_list :r0)
			(vp-call 'purge_mail_in)
		(endif)
	(loop-end)

	(vp-free slot_size)
	(vp-ret)

(vp-label 'stall_callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hmap :each_callback '(:r0 :r1 :r2))

	(assign '((:r0 0) (:r1 +ptr_size)) '(:r0 :r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(assign `((:r1 ,(* +node_time +long_size))) '(:r2))
	(vp-add-rr :r0 :r2)
	(assign '(:r2) `((:r1 ,(* +node_time +long_size))))
	(vp-ret)

(vp-label 'purge_callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(structure slot 0
		(ptr bucket)
		(pptr iter))

	(vp-rdef (data iter bucket key tuple kid1 kid2 did1 did2))

	(vp-alloc slot_size)
	(entry :hmap :each_callback `(,data ,iter ,bucket))
	(save-fields :rsp '(slot_iter slot_bucket) `(,iter ,bucket))

	(assign `((,iter 0) (,iter ,+ptr_size)) `(,key ,tuple))
	(load-node-id key +str_data kid1 kid2)
	(load-node-id data (+ purge_node_id +node_id_node1) did1 did2)
	(vp-sub-rr did1 kid1)
	(vp-sub-rr did2 kid2)
	(vp-or-rr kid2 kid1)
	(switch 'keep)
	(breakif `(,kid1 = 0))
	(assign `((,tuple +array_begin) (,data purge_now)) `(,tuple ,kid1))
	(assign `((,tuple ,(* +node_time +ptr_size))) `(,kid2))
	(breakif `(,kid1 <= ,kid2))
	;its time has passed. But if it is the peer of one of my links, the
	;link says it is there, it is busy, and has not had time to ping.
	(load-node-id key +str_data did1 did2)
	(fn-bind 'sys/statics/statics bucket)
	(assign `((,bucket statics_sys_mail_links_array)) `(,bucket))
	(class/array/get_both bucket data iter)
	(loop-while `(,data /= ,iter))
		(assign `((,data 0)) `(,bucket))
		(vp-add-cr +ptr_size data)
		(load-node-id bucket lk_node_peer_node_id kid1 kid2)
		(vp-sub-rr did1 kid1)
		(vp-sub-rr did2 kid2)
		(vp-or-rr kid2 kid1)
		(breakif `(,kid1 = 0) 'keep)
	(loop-end)
	(default)
		(call :hset :deref `((,tuple ,(* +node_set +ptr_size))))
		(call :list :erase2 '((:rsp slot_bucket) (:rsp slot_iter)))
	(endif)

	(vp-free slot_size)
	(vp-ret)

	(defun kn-purge-mail (name id)
		;emit a routine to free the stale mail in a list. Mail is stale if it
		;has been in the list for 2 ping periods, and the node it is to, or
		;from, is no longer known. Mail for a node that is known stays, however
		;long, the node is busy, and will take it when it can.
		;inputs
		;:r0 = mail list (ptr)
		;:r1 = now (long)
		;:r2 = nodeid key object (ptr)
		(vp-label name)
		(vp-rdef (time now node next))
		(vp-alloc purge_mail_size)
		(entry `(,next ,now :r2))
		(assign `(,now :r2) '((:rsp purge_mail_now) (:rsp purge_mail_key)))
		(loop-list-forward next 0 node next)
			(assign `((,node +msg_timestamp)) `(,time))
			(vp-sub-rr now time)
			(continueif `(,time >= ,(* ping_period -2)))
			(assign `(,node ,next) '((:rsp purge_mail_node) (:rsp purge_mail_next)))
			(load-node-id node id :r3 :r4)
			(assign '((:rsp purge_mail_key)) '(:r1))
			(save-node-id :r1 +str_data :r3 :r4)
			(fn-bind 'sys/statics/statics :r0)
			(call :hmap :cfind `((:r0 statics_sys_mail_node_map) :r1 (@ ,(f-path :nodeid :eql))) '(_ :r1 _))
			(vpif '(:r1 = 0))
				(assign '((:rsp purge_mail_node)) '(:r0))
				(vp-cpy-rr :r0 :r2)
				(ln-remove-node :r2 :r1)
				(call :sys_mail :free '(:r0))
			(endif)
			(assign '((:rsp purge_mail_next) (:rsp purge_mail_now)) `(,next ,now))
		(loop-end)
		(vp-free purge_mail_size)
		(vp-ret))

	(structure purge_mail 0
		(ptr next node key)
		(long now))

	;mail waiting to go out is to a node, a parcel not yet whole is from one
	(kn-purge-mail 'purge_mail_out (+ +msg_dest +net_id_node_id))
	(kn-purge-mail 'purge_mail_in (+ +msg_src +net_id_node_id))

(def-func-end)

(def-method :sys_kernel :system_id)
	;outputs
	;:r0-:r1 = system id (node_id)
	;trashes
	;:r0-:r1

	(entry :sys_kernel :system_id '())
	(fn-bind 'sys/statics/statics :r1)
	(exit :sys_kernel :system_id
		`((:r1 ,(+ statics_sys_task_kernel_system_id +node_id_node1))
		(:r1 ,(+ statics_sys_task_kernel_system_id +node_id_node2))))
	(vp-ret)

(def-func-end)
