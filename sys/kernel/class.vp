(include "lib/asm/func.inc")
(include "class/nodeid/class.inc")
(include "class/lisp/class.inc")
(include "class/hmap/class.inc")
(include "./class.inc")
(include "././str/class.inc")
(include "././math/class.inc")
(include "././load/class.inc")
(include "././link/class.inc")

;;;;;;;;;;;;;
; kernel task
;;;;;;;;;;;;;

(defun kn-held-hash (prefix)
	;emit the code to work out the hash of the services we hold for the
	;origin of a ping, those that start with the prefix char, to set against
	;the hash in the ping. As the sender does, the sum of the hashes of the
	;entries, with 0 for none. Each entry keeps its own hash, so nothing is
	;stored for this.
	(assign (cat prefix ", 0, 0") {held.held_prefix, held.held_sum, held.held_cnt})
	(call :array :get_first {tuple} {_, set})
	(call :hset :each {set, $hash_prefix, &held})
	(assign {held.held_sum} {held_hash})
	(vpif {held.held_cnt && held_hash = 0})
		(assign {1} {held_hash})
	(endif))

(defun kn-send-want ()
	;emit the code to ask the origin of a ping for its services, it will
	;answer with a full ping to all
	(call :sys_mail :alloc {+kn_msg_size} {wmsg, wdata})
	(assign {+kn_call_want} {wdata->+kn_msg_func})
	(assign {0} {wmsg->+msg_dest.+net_id_mbox_id})
	(assign {data->+kn_msg_ping_origin.+node_id_node1, data->+kn_msg_ping_origin.+node_id_node2}
		{wmsg->+msg_dest.+net_id_node_id.+node_id_node1, wmsg->+msg_dest.+net_id_node_id.+node_id_node2})
	(call :sys_mail :send {wmsg}))

(def-method :sys_kernel :kernel)
	;inputs
	;:r0 = argv pointer (pptr)
	;info
	;loader is already initialized when we get here !
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(union
			(ptr argv)
			(ptr link))
		(ptr statics mbox_addr msg data tuple key best_nodes)
		(pptr iter_begin iter_end)
		(nodeid node_id)
		(long time)
		(uint link_cnt best_cnt best_rand))

	(push-scope)
	(entry {argv})

	;init allocator
	(call :sys_mem :statics_init)

	;init symbols
	(call :sym :statics_init)

	;init tasks
	(call :sys_task :statics_init)

	;init mailer mailbox list
	(call :sys_mail :statics_init)

	;start kernel task (get's mailbox id of 0 !)
	(assign {@sys/statics/statics} {statics})
	(call :sys_task :start {$fn_entry} {statics->statics_sys_task_kernel_tcb, mbox_addr, _, _, _})
	(assign {statics->statics_sys_task_kernel_tcb} {statics->statics_sys_task_current_tcb})

	;init mailer
	(call :sys_mail :statics_init1)

	;allocate best choice nodes array
	(call :array :create :nil {best_nodes})

	;set random node ID
	(call :host_os :pii_rand {&statics->statics_sys_task_kernel_node_id, +node_id_size})
	(call :sys_kernel :id :nil {node_id.+node_id_node1, node_id.+node_id_node2})
	;obtain persistent system ID from host OS
	(call :host_os :pii_sysid {&statics->statics_sys_task_kernel_system_id, +node_id_size})

	;process command options
	(call 'opts {argv})

	;start routing pings
	(call :nodeid :create {0} {key})
	(call :sys_load :bind `(,(str (f-path :sys_kernel :ping))) '(:r0))
	(vpif '(:r0 /= 0))
		(call :sys_task :start '(:r0))
	(endif)

;;;;;;;;;;;;;;;;;;;;;;;
; main kernel task loop
;;;;;;;;;;;;;;;;;;;;;;;

	;loop till no other tasks running
	(call :sys_task :set_priority '(tk_kernel_priority))
	(loop-start 'exit)
		;service all kernel mail
		(loop-start 'kernel_loop)
			;check if any mail
			(assign {mbox_addr} '(:r0))
			(lh-is-empty :r0 +mbox_list :r1)
			(breakif '(:r1 = 0))
			(call :sys_mail :read '(:r0) {msg, data})
			;which kernel call number
			(assign {data->+kn_msg_func} '(:r0))
			(switch)
			(vpcase '(:r0 = +kn_call_pin))
			(vp-label 'run_here)
				;fill in reply ID, user field is left alone !
				(call 'opt_run {&data->+kn_msg_open_pathname} '(:r0 :r1 :r2))
				(assign {msg, data, +kn_msg_size} '(:r3 :r4 :r5))
				(assign-net-id :r4 +kn_msg_reply_id :r3 +msg_dest :r6 :r7 :r8)
				(save-net-id :r4 +kn_msg_reply_id :r0 :r1 :r2)
				(assign '(:r5) '((:r3 +msg_length)))
				(call :sys_mail :send '(:r3))
				(break)
			(vpcase '(:r0 = +kn_call_run))
				;find best cpu to run task on the same physical system, the
				;one with the least load, see sys/statics/class.inc
				(call :array :clear {best_nodes})
				(assign {statics->statics_sys_task_task_count + statics->statics_sys_task_lag} {best_cnt})
				(call :array :get_both {statics->statics_sys_mail_links_array}
					{_, iter_begin, iter_end})
				(loop-while {iter_begin /= iter_end})
					(assign {*iter_begin} {link})
					(assign {iter_begin + +ptr_size} {iter_begin})

					;skip links that belong to a different physical machine
					(continueif {(link->lk_node_peer_system_id.+node_id_node1 ^ statics->statics_sys_task_kernel_system_id.+node_id_node1)
								| (link->lk_node_peer_system_id.+node_id_node2 ^ statics->statics_sys_task_kernel_system_id.+node_id_node2)})

					(assign {link->lk_node_task_count} {link_cnt})
					(continueifnot {link_cnt})
					(continueif {link_cnt > best_cnt})
					(vpif {link_cnt < best_cnt})
						(assign {link_cnt} {best_cnt})
						(call :array :clear {best_nodes})
					(endif)
					(call :array :push_back2 {best_nodes,
						link->lk_node_peer_node_id.+node_id_node1,
						link->lk_node_peer_node_id.+node_id_node2})
				(loop-end)
				(gotoif {statics->statics_sys_task_task_count + statics->statics_sys_task_lag <= best_cnt} 'run_here)
				;send to random better kernel
				(call :array :get_length {best_nodes} {_, best_cnt})
				(assign {(best_rand + 1 => best_rand) % (best_cnt >> 1)} {best_cnt})
				(call :array :get_elem2 {best_nodes, best_cnt << 1}
					{_, msg->+msg_dest.+net_id_node_id.+node_id_node1,
						msg->+msg_dest.+net_id_node_id.+node_id_node2})
				(call :sys_mail :send {msg})
				(break)
			(vpcase '(:r0 = +kn_call_want))
				;a node wants our services, so a full ping is due. Many may
				;ask at once, so no more than one a second.
				(call :host_os :pii_time :nil {time})
				(assign {1, statics->statics_sys_mail_full_time + 1000000}
					{statics->statics_sys_mail_ping_full, time})
				(vpif {time < statics->statics_sys_mail_ping_next})
					(assign {time} {statics->statics_sys_mail_ping_next})
				(endif)
				(call :sys_mail :free {msg})
				(break)
			(vpcase '(:r0 >= +kn_call_ping))
				;new services/routing ping
				(structure held 0
					(long prefix sum cnt))
				(def-vars
					(ptr session_cluster session_sys set wmsg wdata)
					(long hops)
					(struct held held_size)
					(uint ping_func held_hash)
					(union
						(ptr bucket new_key)
						(ptr services entries)))
				(push-scope)

				(assign {data->+kn_msg_func} {ping_func})

				;timestamp
				(call :host_os :pii_time :nil {time})

				;find/create the routing tuple for the origin
				(assign {data, key} '(:r0 :r1))
				(assign-node-id :r0 +kn_msg_ping_origin :r1 +str_data)
				(call :hmap :cfind {statics->statics_sys_mail_node_map, key, @class/nodeid/eql} {_, tuple, bucket})
				(vpifnot {tuple})
					(call :nodeid :create {&data->+kn_msg_ping_origin} {new_key})
					(call :array :create :nil {tuple})
					;the slots of the tuple are named in sys/mail/class.inc
					(call :hset :create {1} {set})
					(call :array :push_back2 {tuple, set, 0})
					(call :array :push_back2 {tuple, -1, -1})
					(call :array :push_back2 {tuple, 0, 0})
					(call :array :push_back {tuple, -1})
					(call :list :push_back2 {bucket, new_key, tuple})
				(else)
					(assign {(pptr tuple)[+ptr_size]} {tuple})
				(endif)

				;load current sessions and hops
				(call :array :get_begin {tuple} '(_ :r1))
				(assign `((:r1 ,(* +long_size +node_session_cluster)) (:r1 ,(* +long_size +node_session_sys))
					(:r1 ,(* +long_size +node_hops))) '(:r1 :r2 :r3))
				(assign '(:r1 :r2 :r3) {session_cluster, session_sys, hops})

				(vpif {ping_func = +kn_call_ping_sys})
					;--- System Ping: Update @ services, flood only to same-system peers ---
					(switch 'exit_ping_sys)
					(breakif {data->+kn_msg_ping_session <= session_sys} 'exit_ping_sys)

					;update session_sys (index 3) and time (index 1)
					(call :array :set_elem {tuple, data->+kn_msg_ping_session, +node_session_sys})
					(call :array :set_elem {tuple, time + (data->+kn_msg_ping_interval * 2) + ping_slack, +node_time})

					;flood onwards within the physical system
					(call 'flood_fill {statics, msg, data, node_id.+node_id_node1, node_id.+node_id_node2})

					;skip service updates if I am the origin
					(breakifnot {(node_id.+node_id_node1 - data->+kn_msg_ping_origin.+node_id_node1)
								| (node_id.+node_id_node2 - data->+kn_msg_ping_origin.+node_id_node2)} 'exit_ping_sys)

					;update @ services: purge existing @ entries, then insert new
					(vpif {data->+kn_msg_ping_full})
						;the services are here
						(call :str :create_from_buffer {&data->+kn_msg_ping_services, msg->+msg_length - +kn_msg_ping_services} {services})
						(call :str :split {services, +char_lf} {_, entries})
						(call :str :destroy {services})
						(call :list :get_both {entries} {_, iter_begin, iter_end})
						(call :array :get_first {tuple} {_, set})
						(call :hset :each {set, $erase_prefix, +char_at})
						(loop-while {iter_begin /= iter_end})
							(call :hset :cinsert {set, *iter_begin, @class/sym/eql_str})
							(assign {iter_begin + +ptr_size} {iter_begin})
						(loop-end)
						(call :list :destroy {entries})
					(else)
						(kn-held-hash "+char_at")
						(vpif {data->+kn_msg_ping_hash /= held_hash})
							;not the services we hold for this node, so ask for them
							(kn-send-want)
						(endif)
					(endif)
					(endswitch)
				(else)
					;--- Cluster Ping: Manage cluster routing and * services ---
					(switch 'exit_ping_cluster)
					(breakif {data->+kn_msg_ping_session < session_cluster} 'exit_ping_cluster)
					(vpcase {data->+kn_msg_ping_session > session_cluster})
						;new cluster session: truncate back to 4 elements (preserves set, time, session_cluster, session_sys)
						(call :array :set_length {tuple, +node_hops})
						(call :array :set_elem {tuple, time + (data->+kn_msg_ping_interval * 2) + ping_slack, +node_time})
						(call :array :set_elem {tuple, data->+kn_msg_ping_session, +node_session_cluster})
						(call :array :set_elem {tuple, data->+kn_msg_ping_system.+node_id_node1, +node_system1})
						(call :array :set_elem {tuple, data->+kn_msg_ping_system.+node_id_node2, +node_system2})
						(call :array :push_back {tuple, data->+kn_msg_ping_hops})
						;a kick from another node ?
						(vpif {data->+kn_msg_ping_kick})
							(vpif {(node_id.+node_id_node1 - data->+kn_msg_ping_origin.+node_id_node1)
									| (node_id.+node_id_node2 - data->+kn_msg_ping_origin.+node_id_node2)})
								(call :sys_mail :kick)
							(endif)
						(endif)
						(goto 'flood_via)
					(vpcase {data->+kn_msg_ping_hops < hops})
						;better route: truncate back to the hops, push new hops
						(call :array :set_length {tuple, +node_hops})
						(call :array :push_back {tuple, data->+kn_msg_ping_hops})
					(vp-label 'flood_via)
						(call :array :push_back2 {tuple,
							data->+kn_msg_ping_via.+node_id_node1,
							data->+kn_msg_ping_via.+node_id_node2})
						(call 'flood_fill {statics, msg, data, node_id.+node_id_node1, node_id.+node_id_node2})
						(break)
					(vpcase {data->+kn_msg_ping_hops = hops})
						;equal route: append via
						(call :array :push_back2 {tuple,
							data->+kn_msg_ping_via.+node_id_node1,
							data->+kn_msg_ping_via.+node_id_node2})
					(endswitch)

					;update * services: purge existing * entries, then insert new
					(switch)
					(breakif {data->+kn_msg_ping_session <= session_cluster})
					(breakifnot {(node_id.+node_id_node1 - data->+kn_msg_ping_origin.+node_id_node1)
								| (node_id.+node_id_node2 - data->+kn_msg_ping_origin.+node_id_node2)})
					(default)
						(vpif {data->+kn_msg_ping_full})
							;the services are here
							(call :str :create_from_buffer {&data->+kn_msg_ping_services, msg->+msg_length - +kn_msg_ping_services} {services})
							(call :str :split {services, +char_lf} {_, entries})
							(call :str :destroy {services})
							(call :list :get_both {entries} {_, iter_begin, iter_end})
							(call :array :get_first {tuple} {_, set})
							(call :hset :each {set, $erase_prefix, +char_multiply})
							(loop-while {iter_begin /= iter_end})
								(call :hset :cinsert {set, *iter_begin, @class/sym/eql_str})
								(assign {iter_begin + +ptr_size} {iter_begin})
							(loop-end)
							(call :list :destroy {entries})
						(else)
							(kn-held-hash "+char_multiply")
							(vpif {data->+kn_msg_ping_hash /= held_hash})
								(vpif {data->+kn_msg_ping_hash = 0})
									;it has none now, so nor do we, and no need to ask
									(call :hset :each {set, $erase_prefix, +char_multiply})
								(else)
									;not the services we hold for this node, so ask for them
									(kn-send-want)
								(endif)
							(endif)
						(endif)
					(endswitch)
				(endif)

				(pop-scope)
				(call :sys_mail :free {msg})
				(break)
			(vpcase '(:r0 = +kn_call_callback))
				;call callback with this thread/stack
				(assign {data->+kn_msg_key, data->+kn_msg_callback_addr} '(:r0 :r1))
				(vp-call-r :r1)
				;wake originator
				(call :sys_task :resume {data->+kn_msg_reply_id.+net_id_mbox_id})
				(call :sys_mail :free {msg})
				(break)
			(vpcase '(:r0 = +kn_call_signal))
				;signal a task
				(call :sys_mail :validate {data->+kn_msg_signal_mbox} '(:r0))
				(vpif '(:r0 /= 0))
					(assign {data->+kn_msg_signal_flags} '(:r1))
					(assign '((:r0 +mbox_owner_tcb)) '(:r0))
					(assign '((:r0 +tk_node_flags)) '(:r2))
					(vp-or-rr :r1 :r2)
					(assign '(:r2) '((:r0 +tk_node_flags)))
				(errorcase
					;one that is asleep is woken, to find it has been
					;signalled, (task-sleep) does. It is on the timer list,
					;its time is when it is to wake. As is one that waits
					;for mail. Only in a build with error checks, it is by an
					;error that a task is stopped, and a release build has
					;none, there a signal sets the flag and no more
					(assign '((:r0 +tk_node_time)) '(:r1))
					(vpif '(:r1 > 0))
						(vp-cpy-cr -1 :r1)
						(assign '(:r1) '((:r0 +tk_node_time)))
					(endif)
					(call :sys_task :resume '(:r0)))
				(endif)
				(call :sys_mail :free {msg})
			(endswitch)
		(loop-end)

		;resume any ready tasks and timeouts on the timer lists
		(call :sys_task :timer :nil '(:r0))

		;find next task we could defer to
		(assign {statics} '(:r3))
		(assign '((& :r3 (+ statics_sys_task_task_lists +lh_list_size))) '(:r1))
		(assign '((& :r3 (+ statics_sys_task_task_lists (* tk_num_task_lists +lh_list_size)))) '(:r2))
		(loop-start)
			(lh-get-head :r1 0 :r4)
			(ln-get-succ :r4 0 :r5)
			(breakif '(:r5 /= 0))
			(vp-add-cr +lh_list_size :r1)
		(loop-until '(:r1 = :r2))

		;defer to task if available
		(vpif '(:r5 /= 0))
			(call :sys_task :defer '(:r4))
			(continue 'kernel_loop)
		(endif)

		;no other task ready to run so
		;exit if no tasks waiting for timers
		(lh-get-head :r3 statics_sys_task_timer_list :r4)
		(lh-get-head :r3 statics_sys_mail_timeout_list :r5)
		(ln-get-succ :r4 0 :r1)
		(ln-get-succ :r5 0 :r2)
		(vpif '(:r1 = 0))
			(breakif '(:r2 = 0) 'exit)
		(endif)

		;go to sleep till next wake time then
		(vp-cpy-cr +max_long :r6)
		(vp-cpy-rr :r6 :r7)
		(vpif '(:r1 /= 0))
			(assign '((:r4 +tk_node_time)) '(:r6))
		(endif)
		(vpif '(:r2 /= 0))
			(assign '((:r5 +msg_data)) '(:r7))
			(assign '((:r7 0)) '(:r7))
		(endif)
		(vp-min-rr :r7 :r6)
		(vp-sub-rr :r0 :r6)
		(assign '(:r0) {time})
		(host-os-call :host_os :sleep '(:r6))

		;how long that was is time the node was idle, (kernel-stats)
		(call :host_os :pii_time :nil '(:r0))
		(assign {time, statics} '(:r1 :r2))
		(vp-sub-rr :r1 :r0)
		(assign '((:r2 statics_sys_task_idle)) '(:r1))
		(vp-add-rr :r1 :r0)
		(assign '(:r0) '((:r2 statics_sys_task_idle)))
	(loop-end)

	;deinit best choice array
	(call :array :deref {best_nodes})

	;deinit allocator
	(call :sys_mem :statics_deinit)

	;exit back to load init
	(pop-scope)
	(return)

(vp-label 'flood_fill)
	;inputs
	;:r0 = mail statics
	;:r1 = flood msg
	;:r2 = flood data
	;:r3-:r4 = kernel node_id
	;trashes
	;:r0-:r14

	(def-vars
		(nodeid system_id))

	(vp-rdef (msg data knode1 knode2 vnode1 vnode2 iter_begin iter_end iter link_node statics)
		'(:r14 :r13 :r12 :r11 :r10 :r9 :r8 :r7 :r6 :r5 :r4))

	(push-scope)
	(entry `(,statics ,msg ,data ,knode1 ,knode2))

	;load system ID
	(load-node-id statics statics_sys_task_kernel_system_id :r0 :r1)
	(assign {&system_id} '(:r2))
	(save-node-id :r2 0 :r0 :r1)

	;inc hops
	(assign `((,data ,+kn_msg_ping_hops)) '(:r0))
	(vp-add-cr 1 :r0)
	(assign '(:r0) `((,data ,+kn_msg_ping_hops)))
	;old via
	(load-node-id data +kn_msg_ping_via vnode1 vnode2)
	;set new via
	(save-node-id data +kn_msg_ping_via knode1 knode2)
	;loop over the links
	(assign `((,statics statics_sys_mail_links_array)) '(:r0))
	(class/array/get_both :r0 iter iter_end)
	(vp-cpy-rr iter iter_begin)
	(loop-while `(,iter /= ,iter_end) 'next_link)
		(assign `((,iter 0)) `(,link_node))
		(vp-add-cr +ptr_size iter)

		;if system ping, skip links leading to a different physical machine
		(assign `((,data +kn_msg_ping_func)) '(:r0))
		(vpif '(:r0 = +kn_call_ping_sys))
			(assign {&system_id} '(:r2))
			(load-node-id :r2 0 :r0 :r1)
			(load-node-id link_node lk_node_peer_system_id :r2 :r3)
			(vp-sub-rr :r2 :r0)
			(vp-sub-rr :r3 :r1)
			(vp-or-rr :r1 :r0)
			(continueif '(:r0 /= 0) 'next_link)
		(endif)

		;this links peer
		(load-node-id link_node lk_node_peer_node_id knode1 knode2)
		;not there yet ?
		(assign `(,knode1 ,knode2) '(:r0 :r1))
		(vp-or-rr :r1 :r0)
		(continueif '(:r0 = 0))
		;it's the old via ?
		(assign `(,knode1) '(:r0))
		(vp-sub-rr vnode1 :r0)
		(vp-sub-rr vnode2 :r1)
		(vp-or-rr :r1 :r0)
		(continueif '(:r0 = 0))
		;have we sent to this node already ?
		(vp-cpy-rr iter_begin :r2)
		(loop-start)
			(assign '((:r2 0)) `(,link_node))
			(vp-add-cr +ptr_size :r2)
			(breakif (list :r2 '= iter))
			(load-node-id link_node lk_node_peer_node_id :r0 :r1)
			(vp-sub-rr knode1 :r0)
			(vp-sub-rr knode2 :r1)
			(vp-or-rr :r1 :r0)
			(continueif '(:r0 = 0) 'next_link)
		(loop-end)
		;multi-cast the data
		(call :sys_mail :alloc_obj `((,msg +msg_obj) ,data (,msg +msg_length)) '(:r0))
		(vp-xor-rr :r1 :r1)
		(save-net-id :r0 +msg_dest :r1 knode1 knode2)
		(call :sys_mail :send '(:r0))
	(loop-end)
	(pop-scope)
	(return)

(vp-label 'erase_prefix)
	;inputs
	;:r0 = prefix char (uint)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0)) '(:r3))
	(vp-cpy-ir-ub :r3 +str_data :r3)
	(vpif '(:r3 = :r0))
		(jump :list :erase '(:r2 :r1))
	(endif)
	(vp-ret)

(vp-label 'hash_prefix)
	;inputs
	;:r0 = prefix char, sum and count (plong)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0) (:r0 0)) '(:r1 :r3))
	(vp-cpy-ir-ub :r1 +str_data :r2)
	(vpif '(:r2 = :r3))
		(vp-push :r0)
		(call :str :hash '(:r1) '(_ :r1))
		(vp-pop :r0)
		(assign `((:r0 ,+long_size) (:r0 ,(* 2 +long_size))) '(:r2 :r3))
		(vp-add-rr :r1 :r2)
		(vp-add-cr 1 :r3)
		(assign '(:r2 :r3) `((:r0 ,+long_size) (:r0 ,(* 2 +long_size))))
	(endif)
	(vp-ret)

(vp-label 'opts)
	;inputs
	;:r0 = argv array (pptr)
	;trashes
	;:r0-:r14
	;info
	;process command options

	(def-vars
		(pptr argv)
		(ptr arg)
		(plong table)
		(long offset)
		(int len))

	(push-scope)
	(entry {argv})

	(loop-start)
		(assign {*argv} {arg})
		(breakifnot {arg})
		(assign {argv + +ptr_size} {argv})
		(assign {$options_table} {table})
		(loop-start 'next_arg)
			(assign {*table} {offset})
			(breakifnot {offset})
			(assign {table + +ptr_size} {table})
			(call :sys_str :compare {table, arg} '(tmp))
			(vpif `(,tmp = 0))
				(assign {*argv} {arg})
				(breakifnot {arg} 'next_arg)
				(assign {arg, $options_table + offset} '(:r0 :r1))
				(vp-call-r :r1)
				(break 'next_arg)
			(endif)
			(call :sys_str :length {table} {_, len})
			(assign {(table + len + +ptr_size) & - +ptr_size} {table})
		(loop-end)
	(loop-end)

	(pop-scope)
	(return)

(vp-label 'opt_run)
	;inputs
	;:r0 = argv pointer (pubyte)
	;outputs
	;:r0-:r2 = 0 if error, else ID (net_id)
	;trashes
	;:r0-:r14

	(def-vars
		(pubyte arg)
		(ptr func msg)
		(netid id)
		(uint length is_lisp))

	(push-scope)
	(entry {arg})

	;is this a lisp task or raw task
	(assign {0 => id.+net_id_mbox_id => id.+net_id_node_id.+node_id_node1} {id.+net_id_node_id.+node_id_node2})
	(assign {0} {is_lisp})
	(vpif {arg[0] = +char_lrb})
		(assign {1} {is_lisp})
	(else)
		(call :sys_str :length {arg} {_, length})
		(vpif {length >= 5})
			(call :sys_str :compare {arg + length - 5, ".lisp"} {length})
			(vpifnot {length})
				;a .lisp file, and it has to be there. One that is not is
				;no task, the id is 0, and whoever asked is told so. A pipe
				;with a command that does not exist waited on it for ever
				(call :host_os :pii_stat {arg, @sys/statics/statics.statics_sys_load_stat_buffer} {func})
				(gotoif {func} 'opt_run_exit)
				(assign {1} {is_lisp})
			(endif)
		(endif)
	(endif)

	(vpif {is_lisp})
		;start lisp run task and send args
		(call :sys_load :bind `(,(str (f-path :lisp :run))) '(:r0))
		(vpif '(:r0 /= 0))
			(call :sys_task :start '(:r0)
				{_, _, id.+net_id_mbox_id, id.+net_id_node_id.+node_id_node1, id.+net_id_node_id.+node_id_node2})
			(call :str :create_from_cstr {arg} {arg})
			(call :sys_mail :alloc_obj {arg, &arg->+str_data, arg->+str_length} {msg})
			(assign {msg, id.+net_id_mbox_id, id.+net_id_node_id.+node_id_node1, id.+net_id_node_id.+node_id_node2}
				'(:r0 :r2 :r3 :r4))
			(save-net-id :r0 +msg_dest)
			(call :sys_mail :send '(:r0))
			(call :str :deref {arg})
		(endif)
	(else)
		;open as raw task and return mailbox ID
		(call :sys_load :bind {arg} {func})
		(vpif {func})
			;start this function as task
			(call :sys_task :start {func}
				{_, _, id.+net_id_mbox_id, id.+net_id_node_id.+node_id_node1, id.+net_id_node_id.+node_id_node2})
		(endif)
	(endif)

(vp-label 'opt_run_exit)
	(exit {id.+net_id_mbox_id, id.+net_id_node_id.+node_id_node1, id.+net_id_node_id.+node_id_node2})
	(pop-scope)
	(return)

(vp-label 'opt_link)
	;inputs
	;:r0 = argv pointer (pubyte)
	;trashes
	;:r0-:r11

	(entry '(:r0))

	;start link
	(vp-push :r0)
	(assign `(,(str (f-path :sys_link :link))) '(:r0))
(vp-label 'opt_link_run)
	(call :sys_load :bind '(:r0) '(:r0))
	(vp-pop :r8)
	(vpif '(:r0 /= 0))
		(call :sys_task :start '(:r0) '(_ _ :r9 :r10 :r11))
		;params message
		(call :sys_str :length '(:r8) '(_ :r0))
		(call :sys_mail :alloc '(:r0) '(:r0 :r1))
		(save-net-id :r0 +msg_dest :r9 :r10 :r11)
		(vp-cpy-rr :r0 :r3)
		(call :sys_str :copy '(:r8 :r1))
		;send to link task
		(call :sys_mail :send '(:r3))
	(endif)
	(vp-ret)

	(vp-align +ptr_size)
(vp-label 'options_table)
	(vp-long `(- ,(label-sym 'opt_run) ,(label-sym 'options_table)))
		(vp-cstr "-run")
		(vp-align +ptr_size)
	(vp-long `(- ,(label-sym 'opt_link) ,(label-sym 'options_table)))
		(vp-cstr "-l")
		(vp-align +ptr_size)
	(vp-long 0)

(def-func-end)

(def-method :sys_kernel :id)
	;outputs
	;:r0-:r1 = node id (node_id)
	;trashes
	;:r0-:r1

	(entry :sys_kernel :id '())
	(fn-bind 'sys/statics/statics :r1)
	(exit :sys_kernel :id
		`((:r1 ,(+ statics_sys_task_kernel_node_id +node_id_node1))
		(:r1 ,(+ statics_sys_task_kernel_node_id +node_id_node2))))
	(vp-ret)

(def-func-end)

(def-method :sys_kernel :ping)
	;started by kernel at boot
	;trashes
	;none

	(structure purge 0
		(nodeid node_id)
		(long now))

	(def-vars
		(ptr statics link key)
		(pptr iter_begin iter_end)
		(struct purge purge_size)
		(long now last sig gap rnd purge_nodes purge_mail late lag))

	(push-scope)

	;don't count ping or postman tasks in load balancing
	(call :sys_task :count '(-2))

	(assign {@sys/statics/statics, 0, 0} {statics, purge_nodes, purge_mail})
	(call :nodeid :create '(0) {key})
	(assign {0, 0} {lag, statics->statics_sys_task_lag})
	(call :host_os :pii_time :nil {now})
	(call :sys_kernel :id :nil {purge.purge_node_id.+node_id_node1, purge.purge_node_id.+node_id_node2})
	(loop-start)
		(call :sys_task :sleep '(ping_tick))
		(assign {now} {last})
		(call :host_os :pii_time :nil {now})

		;if I have not run for a while, this node was busy, or was
		;stopped, and may have missed pings. So give every node that
		;time again before it is purged.
		(assign {now - last} {gap})

		;how late am I ? I asked to sleep for a tick. A task that is ready
		;to run waits that long for this node, so it is the honest measure
		;of how busy the node is, a count of its tasks is not, most of them
		;are asleep. It rises at once, and falls away by a quarter a tick.
		(assign {gap - ping_tick} {late})
		(vpif {late > lag})
			(assign {late} {lag})
		(else)
			(assign {lag - (lag >> 2)} {lag})
		(endif)
		(assign {lag / lag_per_task} {statics->statics_sys_task_lag})

		(vpif {gap > ping_stall})
			(call :hmap :each {statics->statics_sys_mail_node_map, $stall_callback, &gap})
		(endif)

		;has a link come up or gone down ? If so kick the network, and
		;soon, but not at once, as more links may be about to change.
		(assign {0} {sig})
		(call :array :get_both {statics->statics_sys_mail_links_array} {_, iter_begin, iter_end})
		(loop-while {iter_begin /= iter_end})
			(assign {*iter_begin} {link})
			(assign {iter_begin + +ptr_size} {iter_begin})
			(assign {sig + link->lk_node_peer_node_id.+node_id_node1
				+ link->lk_node_peer_node_id.+node_id_node2} {sig})
		(loop-end)
		(vpif {sig /= statics->statics_sys_mail_links_sig})
			(assign {sig, 1} {statics->statics_sys_mail_links_sig, statics->statics_sys_mail_ping_kick})
			(call :sys_mail :kick)
			;a link that went down as its peer's process is gone has set
			;that node's time up, so purge now, not within the second
			(assign {0} {purge_nodes})
			(call :sys_math :i_rand '((* ping_tick 2)) {rnd})
			(assign {now + rnd} {rnd})
			(vpif {rnd < statics->statics_sys_mail_ping_next})
				(assign {rnd} {statics->statics_sys_mail_ping_next})
			(endif)
		(endif)

		;time to ping ? The ping says how long till the next, at most,
		;and then the period is backed off.
		(vpif {now >= statics->statics_sys_mail_ping_next})
			(vpif {statics->statics_sys_mail_ping_full})
				(assign {now} {statics->statics_sys_mail_full_time})
			(endif)
			(call :sys_mail :ping {statics->statics_sys_mail_ping_full})
			(assign {statics->statics_sys_mail_ping_interval} {gap})
			(call :sys_math :i_rand {gap >> 2} {rnd})
			(assign {now + gap - rnd, 0, 0} {statics->statics_sys_mail_ping_next,
				statics->statics_sys_mail_ping_full, statics->statics_sys_mail_ping_kick})
			(assign {gap << 1} {gap})
			(vpif {gap > ping_period_max})
				(assign {ping_period_max} {gap})
			(endif)
			(assign {gap} {statics->statics_sys_mail_ping_interval})
		(endif)

		;purge stale nodes
		(vpif {now >= purge_nodes})
			(assign {now + 1000000, now} {purge_nodes, purge.purge_now})
			(call :hmap :each {statics->statics_sys_mail_node_map, $purge_callback, &purge})
		(endif)

		;purge stale messages and parcels
		(vpif {now >= purge_mail})
			(assign {now + ping_period} {purge_mail})
			(assign {&statics->statics_sys_mail_outbound_list, now, key} '(:r0 :r1 :r2))
			(vp-call 'purge_mail_out)
			(assign {&statics->statics_sys_mail_parcel_list, now, key} '(:r0 :r1 :r2))
			(vp-call 'purge_mail_in)
		(endif)
	(loop-end)

	(pop-scope)
	(return)

(vp-label 'stall_callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hmap :each_callback '(:r0 :r1 :r2))

	(assign '((:r0 0) (:r1 +ptr_size)) '(:r0 :r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(assign `((:r1 ,(* +node_time +long_size))) '(:r2))
	(vp-add-rr :r0 :r2)
	(assign '(:r2) `((:r1 ,(* +node_time +long_size))))
	(vp-ret)

(vp-label 'purge_callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (pptr)
	;:r2 = bucket list pointer (ptr)

	(structure local 0
		(ptr bucket)
		(pptr iter))

	(vp-rdef (data iter bucket key tuple kid1 kid2 did1 did2))

	(vp-alloc local_size)
	(entry :hmap :each_callback `(,data ,iter ,bucket))
	(assign `(,iter ,bucket) '((:rsp local_iter) (:rsp local_bucket)))

	(assign `((,iter 0) (,iter ,+ptr_size)) `(,key ,tuple))
	(load-node-id key +str_data kid1 kid2)
	(load-node-id data (+ purge_node_id +node_id_node1) did1 did2)
	(vp-sub-rr did1 kid1)
	(vp-sub-rr did2 kid2)
	(vp-or-rr kid2 kid1)
	(switch 'keep)
	(breakif `(,kid1 = 0))
	(assign `((,tuple +array_begin) (,data purge_now)) `(,tuple ,kid1))
	(assign `((,tuple ,(* +node_time +ptr_size))) `(,kid2))
	(breakif `(,kid1 <= ,kid2))
	;its time has passed. But if it is the peer of one of my links, the
	;link says it is there, it is busy, and has not had time to ping.
	(load-node-id key +str_data did1 did2)
	(fn-bind 'sys/statics/statics bucket)
	(assign `((,bucket statics_sys_mail_links_array)) `(,bucket))
	(class/array/get_both bucket data iter)
	(loop-while `(,data /= ,iter))
		(assign `((,data 0)) `(,bucket))
		(vp-add-cr +ptr_size data)
		(load-node-id bucket lk_node_peer_node_id kid1 kid2)
		(vp-sub-rr did1 kid1)
		(vp-sub-rr did2 kid2)
		(vp-or-rr kid2 kid1)
		(breakif `(,kid1 = 0) 'keep)
	(loop-end)
	(default)
		(call :hset :deref `((,tuple ,(* +node_set +ptr_size))))
		(call :list :erase2 '((:rsp local_bucket) (:rsp local_iter)))
	(endif)

	(vp-free local_size)
	(vp-ret)

(defun kn-purge-mail (name id)
	;emit a routine to free the stale mail in a list. Mail is stale if it
	;has been in the list for 2 ping periods, and the node it is to, or
	;from, is no longer known. Mail for a node that is known stays, however
	;long, the node is busy, and will take it when it can.
	;inputs
	;:r0 = mail list (ptr)
	;:r1 = now (long)
	;:r2 = nodeid key object (ptr)
	(vp-label name)
	(vp-rdef (time now node next))
	(vp-alloc purge_mail_size)
	(entry `(,next ,now :r2))
	(assign `(,now :r2) '((:rsp purge_mail_now) (:rsp purge_mail_key)))
	(loop-list-forward next 0 node next)
		(assign `((,node +msg_timestamp)) `(,time))
		(vp-sub-rr now time)
		(continueif `(,time >= ,(* ping_period -2)))
		(assign `(,node ,next) '((:rsp purge_mail_node) (:rsp purge_mail_next)))
		(load-node-id node id :r3 :r4)
		(assign '((:rsp purge_mail_key)) '(:r1))
		(save-node-id :r1 +str_data :r3 :r4)
		(fn-bind 'sys/statics/statics :r0)
		(call :hmap :cfind `((:r0 statics_sys_mail_node_map) :r1 (@ ,(f-path :nodeid :eql))) '(_ :r1 _))
		(vpif '(:r1 = 0))
			(assign '((:rsp purge_mail_node)) '(:r0))
			(vp-cpy-rr :r0 :r2)
			(ln-remove-node :r2 :r1)
			(call :sys_mail :free '(:r0))
		(endif)
		(assign '((:rsp purge_mail_next) (:rsp purge_mail_now)) `(,next ,now))
	(loop-end)
	(vp-free purge_mail_size)
	(vp-ret))

	(structure purge_mail 0
		(ptr next node key)
		(long now))

	;mail waiting to go out is to a node, a parcel not yet whole is from one
	(kn-purge-mail 'purge_mail_out (+ +msg_dest +net_id_node_id))
	(kn-purge-mail 'purge_mail_in (+ +msg_src +net_id_node_id))

(def-func-end)

(def-method :sys_kernel :system_id)
	;outputs
	;:r0-:r1 = system id (node_id)
	;trashes
	;:r0-:r1

	(entry :sys_kernel :system_id '())
	(fn-bind 'sys/statics/statics :r1)
	(exit :sys_kernel :system_id
		`((:r1 ,(+ statics_sys_task_kernel_system_id +node_id_node1))
		(:r1 ,(+ statics_sys_task_kernel_system_id +node_id_node2))))
	(vp-ret)

(def-func-end)
