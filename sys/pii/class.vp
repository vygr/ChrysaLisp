(def-method :host_os :pii_write_num)
	;inputs
	;:r0 = fd (long)
	;:r1 = number (long)
	;:r2 = base (long)
	;outputs
	;:r0 = error code (long)
	;trashes
	;:r0, :f0-:f15

	(def-vars
		(struct buffer 64)
		(long fd))

	(entry :host_os :pii_write_num '(:r0 :r1 :r2))
	(vp-push :r1 :r2 :r3 :r4)
	(push-scope)
	(scope-used buffer)
	(assign '(:r0) (vpx fd))
	(vp-cpy-rr :r1 :r0)
	(vp-cpy-rr :r2 :r3)
	(vp-cpy-rr :rsp :r4)
	(loop-start)
		(vp-xor-rr :r2 :r2)
		(vp-div-rrr-u :r3 :r2 :r0)
		(vp-cpy-ri-b :r2 :r4 0)
		(vp-add-cr 1 :r4)
	(loop-until '(:r0 = 0))
	(loop-start)
		(vp-sub-cr 1 :r4)
		(vp-cpy-ir-ub :r4 0 :r1)
		(vp-add-cr (code "0") :r1)
		(vpif '(:r1 > (code "9")))
			(vp-add-cr (- (code "A") (code ":")) :r1)
		(endif)
		(assign (vpx fd) '(:r0))
		(call :host_os :pii_write_char '(:r0 :r1) '(_))
	(loop-until '(:r4 = :rsp))
	(pop-scope)
	(vp-pop :r1 :r2 :r3 :r4)
	(exit :host_os :pii_write_num '(:r0))
	(vp-ret)

(def-func-end)

(def-method :host_os :pii_write_char)
	;inputs
	;:r0 = fd (long)
	;:r1 = char (long)
	;outputs
	;:r0 = error code (long)
	;trashes
	;:r0, :f0-:f15

	(entry :host_os :pii_write_char '(:r0 :r1))
	(vp-push :r1 :r2 :r13 :r14)
	(vp-push :r1)
	(host-os-call :host_os :write '(:r0 :rsp 1) '(:r0))
	(vp-free +ptr_size)
	(vp-pop :r1 :r2 :r13 :r14)
	(exit :host_os :pii_write_char '(:r0))
	(vp-ret)

(def-func-end)

(gen-host-call :host_os :pii_write :write)
	;inputs
	;:r0 = fd (long)
	;:r1 = buffer (pubyte)
	;:r2 = len (long)
	;outputs
	;:r0 = error code (long)
	;trashes
