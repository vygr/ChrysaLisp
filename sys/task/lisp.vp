(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-method :sys_task :lisp_count)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r14, :f0-:f15

	(entry :sys_task :lisp_count '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(defq in (method-input :sys_task :count))
	(list-bind-args :r1 in '(:num))
	(call :sys_task :count in '(cnt))
	(call :num :create `(,cnt) '(:r1))
	(vp-pop :r0)

	(exit :sys_task :lisp_count '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(task-count bias)" +error_msg_wrong_types))
	(signature '(:NUM))

(def-func-end)

(def-method :sys_task :lisp_sleep)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :f0-:f15

	(entry :sys_task :lisp_sleep '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

;a task that was told to stop, before it sleeps or while it does, does
;not go on. A pipe that aborts a command signals it, and one that only
;ever sleeps would never see that any other way. It is stopped by an
;error
(fn-bind 'sys/statics/statics :r2)
(assign '((:r2 statics_sys_task_current_tcb)) '(:r2))
(assign '((:r2 +tk_node_flags)) '(:r2))
(gotoif '(:r2 /= 0) 'aborted)
	(vp-push :r0)
	(defq in (method-input :sys_task :sleep))
	(list-bind-args :r1 in '(:num))
	(call :sys_task :sleep in)
	(vp-pop :r0)
(fn-bind 'sys/statics/statics :r1)
(assign '((:r1 statics_sys_task_current_tcb)) '(:r1))
(assign '((:r1 +tk_node_flags)) '(:r1))
(gotoif '(:r1 /= 0) 'aborted)
	(assign '((:r0 +lisp_sym_t)) '(:r1))
	(class/obj/ref :r1 :r2)

	(exit :sys_task :lisp_sleep '(:r0 :r1))
	(vp-ret)

(vp-label 'aborted)
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(jump :lisp :repl_error '(:r1 "(task-sleep usec)" +error_msg_task_aborted))
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(task-sleep usec)" +error_msg_wrong_types))
	(signature '(:NUM))

(def-func-end)

(def-method :sys_task :lisp_timeslice)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3, :f0-:f15

	(entry :sys_task :lisp_timeslice '(:r0 :r1))

	(vp-push :r0 :r1)
	;is the slice up ? Asked every time this is called, and of the time
	;of day it was most of what a call cost, 10 to 50 ns. A host that is
	;new enough has a clock that is cheap to ask, a ns or a few
	(call :sys_task :slice)
	;has it been told to stop ? A command that works and never reads or
	;writes sees it here
	(fn-bind 'sys/statics/statics :r2)
	(assign '((:r2 statics_sys_task_current_tcb)) '(:r2))
	(assign '((:r2 +tk_node_flags)) '(:r2))
	(vpif '(:r2 /= 0))
		(vp-pop :r0 :r1)
		(assign '((:r0 +lisp_sym_nil)) '(:r1))
		(jump :lisp :repl_error '(:r1 "(task-slice)" +error_msg_task_aborted))
	(endif)
	(vp-pop :r0 :r1)
	(class/obj/ref :r1 :r2)

	(exit :sys_task :lisp_timeslice '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :sys_task :lisp_mailbox)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :f0-:f15

	(entry :sys_task :lisp_mailbox '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(call :str :create_from_buffer '(0 +net_id_size) '(:r3))
	(call :sys_task :mailbox :nil
		`((:r3 ,(+ +str_data +net_id_mbox_id))
		(:r3 ,(+ +str_data +net_id_node_id +node_id_node1))
		(:r3 ,(+ +str_data +net_id_node_id +node_id_node2))))
	(vp-pop :r0)

	(exit :sys_task :lisp_mailbox '(:r0 :r3))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(task-mbox)" +error_msg_wrong_types))

(def-func-end)

(def-method :sys_task :lisp_flags)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3, :r14, :f0-:f15

	(entry :sys_task :lisp_flags '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_sys_task_current_tcb)) '(:r0))
	(call :num :create '((:r0 +tk_node_flags)) '(:r1))
	(vp-pop :r0)

	(exit :sys_task :lisp_flags '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(task-flags)" +error_msg_wrong_types))

(def-func-end)

(def-method :sys_task :lisp_priority)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6
	;info
	;the band of the task, a number. One there is not is the band of an
	;application. Bound in sys/lisp.inc, (task-band), not in root.inc, so
	;a boot image of before it was written still starts

	(entry :sys_task :lisp_priority '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(defq in (method-input :sys_task :set_priority))
	(list-bind-args :r1 in '(:num))
	(vpif `(,(first in) < 0))
		(assign `(,tk_app_priority) in)
	(elseif `(,(first in) >= ,tk_num_task_lists))
		(assign `(,tk_app_priority) in)
	(endif)
	(call :sys_task :set_priority in)
	(vp-pop :r0)
	(assign '((:r0 +lisp_sym_t)) '(:r1))
	(class/obj/ref :r1 :r2)

	(exit :sys_task :lisp_priority '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(task-band band)" +error_msg_wrong_types))
	(signature '(:NUM))

(def-func-end)

(def-method :sys_task :lisp_apps)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r3
	;info
	;is there an application task of this node ready to run: a bot rests
	;only then, and not for nothing. Bound in sys/lisp.inc

	(entry :sys_task :lisp_apps '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(fn-bind 'sys/statics/statics :r2)
	(vp-add-cr (+ statics_sys_task_task_lists (* tk_app_priority +lh_list_size)) :r2)
	(lh-is-empty :r2 0 :r3)
	(vpif '(:r3 = 0))
		(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(else)
		(assign '((:r0 +lisp_sym_t)) '(:r1))
	(endif)
	(class/obj/ref :r1 :r2)

	(exit :sys_task :lisp_apps '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(task-apps?)" +error_msg_wrong_types))

(def-func-end)

