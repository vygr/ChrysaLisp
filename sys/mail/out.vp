(include "lib/asm/func.inc")
(include "././link/class.inc")
(include "././kernel/class.inc")

(def-method :sys_mail :out)
	;info
	;parcels going off chip or junk mail task
	;trashes
	;none
	;info
	;never breaks out

	(structure slot 0
		(ptr msg data statics)
		(align)
		(nodeid node_id))

	(vp-rdef (id0 id1 id2 heap msg offchip data obj frag time len off amount tot))

	(entry :sys_mail :out '())
	(vp-alloc slot_size)

	(call :sys_task :set_priority '(tk_out_link_priority))
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp slot_node_id :r0 :r1)
	(fn-bind 'sys/statics/statics :r0)
	(assign '(:r0) '((:rsp slot_statics)))

	(loop-start 'mail_loop)
		;read parcel or junk mail
		(call :sys_mail :mymail :nil '((:rsp slot_msg) (:rsp slot_data)))
		(assign '((:rsp slot_msg)) '(:r0))
		(load-node-id :r0 (+ +msg_dest +net_id_node_id) :r1 :r2)
		(load-node-id :rsp slot_node_id :r3 :r4)
		(vpif '(:r1 = :r3) '(:r2 = :r4))
			;we got some junk mail, just free it for now
			(call :sys_mail :free '((:rsp slot_msg)))
			(continue 'mail_loop)
		(endif)

		;create next parcel id
		(assign '((:rsp slot_statics)) '(:r0))
		(assign '((:r0 statics_sys_mail_session)) '(:r1))
		(vp-add-cr 1 :r1)
		(assign '(:r1) '((:r0 statics_sys_mail_session)))

		;for each fragment
		(call :host_os :pii_time :nil `(,time))
		(assign '((:rsp slot_statics)) `(,heap))
		(assign `((:rsp slot_msg) (& ,heap statics_sys_mail_outbound_list) 0 (:rsp slot_data))
			`(,msg ,offchip ,off ,data))
		(vp-add-cr statics_sys_mail_msg_heap heap)
		(load-fields msg '(+msg_obj +msg_length) `(,obj ,tot))
		(vp-cpy-rr tot amount)
		(loop-start)
			;create fragment
			(call :sys_heap :alloc `(,heap) `(_ ,frag))
			(class/obj/ref obj id0)

			;fill in fragment
			(vp-cpy-rr amount len)
			(vp-min-cr lk_data_size len)
			(assign '((:rsp slot_statics)) `(,id0))
			(assign `((,id0 statics_sys_mail_session)) `(,id0))
			(load-node-id :rsp slot_node_id id1 id2)
			(save-net-id frag +msg_src id0 id1 id2)
			(assign-net-id msg +msg_dest frag +msg_dest id0 id1 id2)
			(save-fields
				frag '(+msg_obj +msg_timestamp +msg_length +msg_offset +msg_total +msg_data)
				`(,obj ,time ,len ,off ,tot ,data))

			;move on
			(vp-add-rr len data)
			(vp-add-rr len off)
			(vp-sub-rr len amount)

			;queue it on the outgoing packet list
			(lh-add-at-tail offchip frag id0)
		(loop-until `(,amount = 0))

		;free parcel
		(call :sys_mail :free `(,msg))

		;wake any sleeping link task, as a packet that is not a parcel
		;does. A link that sleeps till it is woken, a TCP link, did not
		;send these till something else woke it, up to seconds later
		(call :sys_task :wake_links)

		;let other links get at some packets
		(call :sys_task :sleep '(0))
		;exit if signaled by kernel...
	(loop-end)

	(exit :sys_mail :out '())
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
