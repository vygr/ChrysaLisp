(include "lib/asm/func.inc")
(include "././link/class.inc")

(def-method :sys_mail :in)
	;inputs
	;:r0 = link input fragment (ptr)
	;:r1 = link input buffer status, 0 if none (ptr)
	;:r2 = link input ring buffer (ptr)
	;:r3 = link input ring buffer extent (uint)
	;trashes
	;:r0-:r10, :d0-:d15

	(structure slot 0
		(ptr rx_frag rx_buf rx_ring msg)
		(uint rx_extent))

	(vp-rdef (node next src1 src2 src3 psrc1 psrc2 psrc3 parcels rx_frag total))

	(vp-alloc slot_size)
	(entry :sys_mail :in '(:r0 :r1 :r2 :r3))
	(save-fields :rsp '(slot_rx_frag slot_rx_buf slot_rx_ring slot_rx_extent) '(:r0 :r1 :r2 :r3))

	;look up parcel in mailbox
	(vp-cpy-rr :r0 rx_frag)
	(fn-bind 'sys/statics/statics parcels)
	(vp-add-cr statics_sys_mail_parcel_list parcels)
	(load-net-id rx_frag lk_frag_src src1 src2 src3)
	(loop-list-forward parcels 0 node next)
		(load-net-id node +msg_src psrc1 psrc2 psrc3)
	(loop-until `(,src1 = ,psrc1) `(,src2 = ,psrc2) `(,src3 = ,psrc3))
	(vpif `(,next = 0))
		;new parcel
		(assign `((,rx_frag lk_frag_total)) `(,total))
		(call :sys_mail :alloc `(,total) `(,node _))
		(assign `(,total) `((,node +msg_total)))
		(assign-net-id rx_frag lk_frag_dest node +msg_dest src1 src2 src3)
		(assign-net-id rx_frag lk_frag_src node +msg_src src1 src2 src3)
		(lh-add-at-tail parcels node next)
	(endif)
	(assign `(,node) '((:rsp slot_msg)))

	;timestamp last change
	(call :host_os :pii_time :nil '(:r0))

	;copy fragment data
	(load-fields :rsp '(slot_rx_frag slot_msg) '(:r2 :r1))
	(assign '((:r2 lk_frag_length)) '(:r3))
	(load-fields :r1 '(+msg_offset +msg_total) '(:r4 :r5))
	(vp-add-rr :r3 :r4)
	(vp-sub-rr :r3 :r5)
	(save-fields :r1 '(+msg_timestamp +msg_offset +msg_total) '(:r0 :r4 :r5))
	(assign '((:r1 +msg_data) (:r2 lk_frag_offset)) '(:r1 :r5))
	(vp-add-rr :r5 :r1)
	(vp-lea-rcr :r2 lk_frag_size :r0)
	(vp-cpy-rr :r3 :r2)
	(load-fields :rsp '(slot_rx_ring slot_rx_extent) '(:r4 :r3))
	(call :sys_mem :copy_from_ring '(:r0 :r1 :r2 :r3 :r4))

	;clear status
	;overlap the :send with new receive !
	(assign '((:rsp slot_rx_buf)) '(:r0))
	(vpif '(:r0 /= 0))
		(vp-sync)
		(assign `(,lk_chan_status_ready) '(:r1))
		(assign '(:r1) '((:r0 lk_buf_status)))
	(endif)

	;got all needed ?
	(assign '((:rsp slot_msg)) `(,node))
	(assign `((,node +msg_total)) '(:r2))
	(vpif '(:r2 = 0))
		;yes, remove parcel and post it
		(ln-remove-node node next)
		(call :sys_mail :send '((:rsp slot_msg)))
	(endif)

	(vp-free slot_size)
	(vp-ret)

(def-func-end)
