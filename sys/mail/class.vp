(include "lib/asm/func.inc")
(include "lib/consts/chars.inc")
(include "class/nodeid/class.inc")
(include "class/hmap/class.inc")
(include "././math/class.inc")
(include "././link/class.inc")
(include "././kernel/class.inc")

(def-method :sys_mail :statics_init)
	;info
	;init the mailbox system, heap, buckets and id
	;trashes
	;:r0-:r3

	(fn-bind 'sys/statics/statics :r3)
	(vp-xor-rr :r0 :r0)
	(assign '(:r0 (& :r3 statics_sys_mail_timeout_list)) '((:r3 statics_sys_mail_next_mbox_id) :r0))
	(vp-lea-rcr :r0 (* (+ num_mbox_buckets 3) +lh_list_size) :r1)
	(loop-start)
		(lh-init :r0 :r2)
		(vp-add-cr +lh_list_size :r0)
	(loop-until '(:r0 = :r1))
	(jump :sys_heap :init '((& :r3 statics_sys_mail_mbox_heap) +mbox_size 32))

(def-func-end)

(def-method :sys_mail :statics_init1)
	;info
	;init the mail system
	;trashes
	;:r0-:r7, :r14, :d0-:d15

	;init postmen task
	(fn-bind 'sys/statics/statics :r7)
	(vp-xor-rr :r0 :r0)
	(vp-cpy-cr ping_period_min :r1)
	(assign '(:r0 :r0 :r0 :r0 :r0 :r0 :r0 :r1)
		'((:r7 statics_sys_mail_session) (:r7 statics_sys_mail_full_time)
			(:r7 statics_sys_mail_ping_next) (:r7 statics_sys_mail_ping_full)
			(:r7 statics_sys_mail_ping_kick) (:r7 statics_sys_mail_links_sig)
			(:r7 statics_sys_mail_ping_sys_tail)
			(:r7 statics_sys_mail_ping_interval)))
	(call :sys_task :start `((@ ,(f-path :sys_mail :out))) '(_ :r1 _ _ _))
	(fn-bind 'sys/statics/statics :r7)
	(assign '(:r1) '((:r7 statics_sys_mail_out_mbox_addr)))

	;services, links and routing
	(call :array :create :nil '((:r7 statics_sys_mail_links_array)))
	(call :hmap :create '(1) '((:r7 statics_sys_mail_node_map)))

	;init header heap
	(jump :sys_heap :init '((& :r7 statics_sys_mail_msg_heap) +msg_size 64))

(def-func-end)

(def-method :sys_mail :alloc_mbox)
	;outputs
	;:r0 = mailbox id (uint)
	;:r1 = mailbox address (ptr)
	;trashes
	;:r0-:r5, :d0-:d15

	;pick next id
	(fn-bind 'sys/statics/statics :r4)
	(assign '((:r4 statics_sys_mail_next_mbox_id)) '(:r3))
	(loop-start)
		(vp-cpy-rr :r3 :r5)
		(vp-and-cr (dec num_mbox_buckets) :r5)
		(vp-mul-cr +lh_list_size :r5)
		(vp-add-rr :r4 :r5)
		(loop-list-forward :r5 statics_sys_mail_mbox_buckets :r1 :r2)
			(assign '((:r1 +mbox_id)) '(:r0))
		(loop-until '(:r3 = :r0))
		(breakif '(:r2 = 0))
		(vp-cpy-cr 0xffffffff :r2)
		(vp-add-cr 1 :r3)
		(vp-and-rr :r2 :r3)
	(loop-end)
	(vp-lea-rcr :r3 1 :r0)
	(assign '(:r0) '((:r4 statics_sys_mail_next_mbox_id)))

	;allocate mailbox with this id
	(call :sys_heap :alloc '((& :r4 statics_sys_mail_mbox_heap)) '(_ :r1))
	(assign '((:r4 statics_sys_task_current_tcb)) '(:r4))
	(vp-xor-rr :r2 :r2)
	(save-fields :r1 '(+mbox_id +mbox_tcb +mbox_owner_tcb) '(:r3 :r2 :r4))
	(vp-lea-rcr :r1 +mbox_list :r0)
	(lh-init :r0 :r2)
	(vp-add-cr statics_sys_mail_mbox_buckets :r5)
	(lh-add-at-tail :r5 :r1 :r2)

	(exit :sys_mail :alloc_mbox '(:r3 :r1))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :free_mbox)
	;inputs
	;:r0 = mailbox id (uint)
	;trashes
	;:r0-:r4

	(entry :sys_mail :free_mbox '(:r0))

	(call :sys_mail :validate '(:r0) '(:r0))
	(vpif '(:r0 /= 0))
		;remove mailbox node
		(vp-cpy-rr :r0 :r1)
		(ln-remove-node :r1 :r2)

		;splice any dead mail to postman, while the node is still ours
		(call :sys_mail :junk_mail '((& :r0 +mbox_list)))

		;free mailbox node, :r3 is still its mail list
		(fn-bind 'sys/statics/statics :r1)
		(vp-lea-rcr :r3 (neg +mbox_list) :r0)
		(vp-add-cr statics_sys_mail_mbox_heap :r1)
		(hp-freecell :r1 :r0 :r2)
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :junk_mail)
	;inputs
	;:r3 = mail list pointer (ptr)
	;trashes
	;:r0-:r2, :r4

	(entry :sys_mail :junk_mail '(:r3))

	;splice any junk mail to postman
	(lh-is-empty :r3 0 :r1)
	(vpif '(:r1 /= 0))
		;resume postman if needed
		(fn-bind 'sys/statics/statics :r1)
		(assign '((:r1 statics_sys_mail_out_mbox_addr)) '(:r4))
		(assign '((:r4 +mbox_tcb)) '(:r0))
		(vpif '(:r0 /= 0))
			(vp-xor-rr :r1 :r1)
			(assign '(:r1) '((:r4 +mbox_tcb)))
			(call :sys_task :resume '(:r0))
		(endif)
		;splice junk mail
		(lh-get-head :r3 0 :r0)
		(lh-get-tail :r3 0 :r1)
		(lh-get-tail :r4 +mbox_list :r2)
		(vp-add-cr (+ +mbox_list +lh_list_tail) :r4)
		(ln-set-succ :r2 0 :r0)
		(ln-set-pred :r0 0 :r2)
		(ln-set-succ :r1 0 :r4)
		(ln-set-pred :r4 0 :r1)
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :validate)
	;inputs
	;:r0 = mailbox id (uint)
	;outputs
	;:r0 = 0, else mailbox address (ptr)
	;trashes
	;:r0-:r3

	(vp-rdef (node next mid id))

	(entry :sys_mail :validate `(,id))

	(vp-cpy-rr id next)
	(fn-bind 'sys/statics/statics node)
	(vp-and-cr (dec num_mbox_buckets) next)
	(vp-mul-cr +lh_list_size next)
	(vp-shl-cr 32 id)
	(vp-shr-cr 32 id)
	(vp-add-rr next node)
	(loop-list-forward node statics_sys_mail_mbox_buckets node next)
		(assign `((,node +mbox_id)) `(,mid))
	(loop-until `(,mid = ,id))
	(vpif `(,next = 0))
		;not found
		(vp-cpy-rr next node)
	(endif)

	(exit :sys_mail :validate `(,node))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :mymail)
	;outputs
	;:r0 = mail address (ptr)
	;:r1 = string data (pubyte)
	;trashes
	;:r0-:r2, :d0-:d15

	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_sys_task_current_tcb)) '(:r0))
	(jump :sys_mail :read '((:r0 +tk_node_mbox_addr)))

(def-func-end)

(def-method :sys_mail :alloc)
	;inputs
	;:r0 = mail size (bytes)
	;outputs
	;:r0 = mail message (ptr)
	;:r1 = string data (pubyte)
	;trashes
	;:r0-:r5, :d0-:d15

	(entry :sys_mail :alloc '(:r0))

	(call :str :create_from_buffer '(0 :r0) '(:r4))
	(fn-bind 'sys/statics/statics :r0)
	(call :sys_heap :alloc '((& :r0 statics_sys_mail_msg_heap)) '(_ :r0))
	(assign '((:r4 +str_length) (& :r4 +str_data)) '(:r3 :r1))
	(vp-xor-rr :r2 :r2)
	(assign '(:r3 :r2 :r2 :r4 :r1)
		'((:r0 +msg_length) (:r0 +msg_offset) (:r0 +msg_total) (:r0 +msg_obj) (:r0 +msg_data)))
	;a block of the heap has the last message's src under it, which a
	;link would put on the wire
	(save-net-id :r0 +msg_src :r2 :r2 :r2)

	(exit :sys_mail :alloc '(:r0 :r1))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :alloc_obj)
	;inputs
	;:r0 = object (ptr)
	;:r1 = data (pubyte)
	;:r2 = data length (bytes)
	;outputs
	;:r0 = mail message (ptr)
	;trashes
	;:r0-:r5, :d0-:d15

	(entry :sys_mail :alloc_obj '(:r0 :r4 :r5))

	(call :obj :ref '(:r0) '(:r3))
	(fn-bind 'sys/statics/statics :r0)
	(call :sys_heap :alloc '((& :r0 statics_sys_mail_msg_heap)) '(_ :r0))
	(vp-xor-rr :r1 :r1)
	(assign '(:r5 :r1 :r1 :r3 :r4)
		'((:r0 +msg_length) (:r0 +msg_offset) (:r0 +msg_total) (:r0 +msg_obj) (:r0 +msg_data)))
	(save-net-id :r0 +msg_src :r1 :r1 :r1)

	(exit :sys_mail :alloc_obj '(:r0))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :free)
	;inputs
	;:r0 = mail message (ptr)
	;trashes
	;:r0-:r14, :d0-:d15
	;info
	;only ever derefs a :str !
	;trashes
	;:r0-:r3

	(entry :sys_mail :free '(:r0))

	(vpif '(:r0 /= 0))
		(vp-cpy-rr :r0 :r3)
		;only ever :str payloads, so be nice to the tracer
		;and don't call :obj :destroy !
		(assign '((:r0 +msg_obj)) '(:r0))
		(class/obj/ref :r0 :r1 -1)
		(vpif '(:r1 = 0))
			(call :sys_mem :free '(:r0))
		(endif)
		(fn-bind 'sys/statics/statics :r0)
		(call :sys_heap :free '((& :r0 statics_sys_mail_msg_heap) :r3))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :free_obj)
	;inputs
	;:r0 = mail message (ptr)
	;outputs
	;:r0 = 0 if msg was 0, else object (ptr)
	;:r1 = data (pubyte)
	;:r2 = data length (bytes)
	;trashes
	;:r0-:r5

	(entry :sys_mail :free_obj '(:r0))

	(vpif '(:r0 /= 0))
		(load-fields :r0 '(+msg_obj +msg_data +msg_length) '(:r3 :r4 :r5))
		(fn-bind 'sys/statics/statics :r2)
		(call :sys_heap :free '((& :r2 statics_sys_mail_msg_heap) :r0))
		(vp-simd vp-cpy-rr '(:r3 :r4 :r5) '(:r0 :r1 :r2))
	(endif)

	(exit :sys_mail :free_obj '(:r0 :r1 :r2))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :read)
	;inputs
	;:r0 = mailbox address (ptr)
	;outputs
	;:r0 = mail address (ptr)
	;:r1 = string data (pubyte)
	;trashes
	;:r0-:r2, :d0-:d15
	;info
	;in *build_mode* > 0
	;a signal to a Lisp task can return 0 here !
	;:lisp_read method is aware and returns :nil.
	;a VP level task should never see this happen !

	(entry :sys_mail :read '(:r0))

	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_sys_task_current_tcb)) '(:r1))
	(assign '((:r1 +tk_node_flags)) '(:r2))
	(gotoif '(:r2 /= 0) 'abort)

	(lh-is-empty :r0 +mbox_list :r2)
	(vpif '(:r2 = 0))
		(assign '(:r1) '((:r0 +mbox_tcb)))
		(apply vp-push +vp_rregs_0_14)
		(call :sys_task :suspend)
		(apply vp-pop +vp_rregs_0_14)
		(assign '((:r1 +tk_node_flags)) '(:r2))
		(breakif '(:r2 = 0))
	(vp-label 'abort)
		;signal to Lisp task
		(exit :sys_mail :read '(0 0))
		(vp-ret)
	(endif)
	(lh-get-head :r0 +mbox_list :r0)
	(vp-cpy-rr :r0 :r1)
	(ln-remove-node :r1 :r2)

	(exit :sys_mail :read '(:r0 (:r0 +msg_data)))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :send)
	;inputs
	;:r0 = mail message (ptr)
	;trashes
	;:r0-:r14, :d0-:d15
	;info
	;only ever derefs a :str !
	;trashes
	;:r0-:r4, :d0-:d15

	(entry :sys_mail :send '(:r4))

	;on or off chip ?
	(call :sys_kernel :id '() '(:r0 :r1))
	(load-node-id :r4 (+ +msg_dest +net_id_node_id) :r2 :r3)
	(vpif '(:r0 = :r2) '(:r1 = :r3))
		;on this chip
		(call :sys_mail :validate `((:r4 ,(+ +msg_dest +net_id_mbox_id))) '(:r1))
		(vpif '(:r1 = 0))
			;free it as junk
			(jump :sys_mail :free '(:r4))
		(endif)
	(vp-label 'post_it)
		(vp-add-cr +mbox_list :r1)
		(lh-add-at-tail :r1 :r4 :r0)
		(assign `((:r1 ,(- +mbox_tcb +mbox_list))) '(:r0))
		(vpif '(:r0 /= 0))
			(vp-xor-rr :r4 :r4)
			(assign '(:r4) `((:r1 ,(- +mbox_tcb +mbox_list))))
			(call :sys_task :resume '(:r0))
		(endif)
	(else)
		;going off chip
		(fn-bind 'sys/statics/statics :r1)
		(assign '((:r4 +msg_length)) '(:r0))
		(switch)
		(vpcase '(:r0 > lk_data_size))
			;must use postman task for parcels
			(assign '((:r1 statics_sys_mail_out_mbox_addr)) '(:r1))
			(goto 'post_it)
		(default)
			;timestamp it and queue it on the outgoing packet list
			(call :host_os :pii_time :nil '(:r0))
			(vp-store-rrc :r0 :r4 +msg_timestamp)
			(vp-add-cr statics_sys_mail_outbound_list :r1)
			(lh-add-at-tail :r1 :r4 :r0)
			;wake any sleeping link task
			(call :sys_task :wake_links)
		(endif)
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :poll)
	;inputs
	;:r0 = mailbox list object (ptr)
	;outputs
	;:r0 = -1, else mailbox index (uint)
	;:r4 = mailbox list begin iter (pptr)
	;:r5 = mailbox list end iter (pptr)
	;trashes
	;:r0-:r6

	(vp-rdef (idx iter_begin iter_end iter) '(:r0 :r4 :r5 :r6))

	(entry :sys_mail :poll '(:r0))

	;check if any have mail
	(class/array/get_both :r0 iter iter_end)
	(vp-cpy-rr iter iter_begin)
	(loop-start)
		(switch)
		(assign `((,iter 0)) `(,idx))
		(assign `((,idx ,(+ +str_data +net_id_mbox_id) ui)) `(,idx))
		(breakif `(,idx = 0))
		(call :sys_mail :validate `(,idx) `(,idx))
		(breakif `(,idx = 0))
		(lh-is-empty idx +mbox_list idx)
		(breakif `(,idx = 0))
		;return mailbox index
		(vp-sub-rr iter_begin iter)
		(vp-shr-cr (log2 +long_size) iter)
		(exit :sys_mail :poll `(,iter ,iter_begin ,iter_end))
		(vp-ret)
		(endswitch)
		(vp-add-cr +long_size iter)
	(loop-until `(,iter = ,iter_end))

	(exit :sys_mail :poll `(-1 ,iter_begin ,iter_end))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :select)
	;inputs
	;:r0 = mailbox id array object (ptr)
	;outputs
	;:r0 = mailbox index (uint)
	;trashes
	;:r0-:r14, :d0-:d15

	(vp-rdef (idx iter_begin iter_end iter ids tcb) '(:r0 :r4 :r5 :r6 :r7 :r8))

	(entry :sys_mail :select `(,ids))

	(loop-start)
		;check if any have mail
		(call :sys_mail :poll `(,ids) `(,idx ,iter_begin ,iter_end))
		(vpif (list idx '/= -1))
			;return mailbox index
			(exit :sys_mail :select `(,idx))
			(vp-ret)
		(endif)

		;fill in all tcb's
		(fn-bind 'sys/statics/statics tcb)
		(assign `((,tcb statics_sys_task_current_tcb)) `(,tcb))
		(vp-call 'set_tcbs)

		;suspend till some mail arrives
		(vp-push ids iter_begin iter_end)
		(call :sys_task :suspend)
		(vp-pop ids iter_begin iter_end)

		;clear all tcb's !
		(vp-xor-rr tcb tcb)
		(vp-call 'set_tcbs)
	(loop-end)

(vp-label 'set_tcbs)
	(assign `(,iter_begin) `(,iter))
	(loop-start)
		(switch)
		(assign `((,iter 0)) `(,idx))
		(assign `((,idx ,(+ +str_data +net_id_mbox_id) ui)) `(,idx))
		(breakif `(,idx = 0))
		(call :sys_mail :validate `(,idx) `(,idx))
		(breakif `(,idx = 0))
		(assign `(,tcb) `((,idx +mbox_tcb)))
		(endswitch)
		(vp-add-cr +long_size iter)
	(loop-until `(,iter = ,iter_end))
	(vp-ret)

(def-func-end)

(def-method :sys_mail :service)
	;inputs
	;:r0 = service name str object (ptr)
	;:r1 = mailbox id str object (ptr)
	;:r2 = service info str object (ptr)
	;outputs
	;:r0 = service entry str object (ptr)
	;trashes
	;:r0-:r7, :d0-:d15

	(structure slot 0
		(ptr name id info cat tmp1 tmp2 sys_str sys_hex))

	(vp-alloc slot_size)
	(entry :sys_mail :service '((:rsp slot_name) (:rsp slot_id) (:rsp slot_info)))

	;create service entry: name,id,sys_id,info
	(call :obj :ref '((:rsp slot_name)))
	(call :obj :ref '((:rsp slot_info)))
	(call :list :create :nil '((:rsp slot_cat)))
	(call :list :push_back '((:rsp slot_cat) (:rsp slot_name)))
	(call :str :create_from_buffer '("," 1) '((:rsp slot_tmp1)))
	(call :list :push_back '((:rsp slot_cat) (:rsp slot_tmp1)))
	;1: hex-encoded net_id
	(call :str :encode '((:rsp slot_id)) '((:rsp slot_tmp2)))
	(call :list :push_back '((:rsp slot_cat) (:rsp slot_tmp2)))
	(call :str :ref '((:rsp slot_tmp1)))
	(call :list :push_back '((:rsp slot_cat) (:rsp slot_tmp1)))
	;2: hex-encoded system_id
	(fn-bind 'sys/statics/statics :r0)
	(vp-add-cr statics_sys_task_kernel_system_id :r0)
	(call :nodeid :create '(:r0) '((:rsp slot_sys_str)))
	(call :str :encode '((:rsp slot_sys_str)) '((:rsp slot_sys_hex)))
	(call :nodeid :destroy '((:rsp slot_sys_str)))
	(call :list :push_back '((:rsp slot_cat) (:rsp slot_sys_hex)))
	;3: info
	(call :str :ref '((:rsp slot_tmp1)))
	(call :list :push_back2 '((:rsp slot_cat) (:rsp slot_tmp1) (:rsp slot_info)))
	(call :str :cat '((:rsp slot_name) (:rsp slot_cat)) '((:rsp slot_name)))
	(call :list :destroy '((:rsp slot_cat)))

	(exit :sys_mail :service '((:rsp slot_name)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :declare)
	;inputs
	;:r0 = ID str object (net_id)
	;:r1 = service name str object (ptr)
	;:r2 = service info str object (ptr)
	;outputs
	;:r0 = service key str object (ptr)
	;trashes
	;:r0-:r14, :d0-:d15

	(structure slot 0
		(ptr name id info key bucket set)
		(pptr tuple)
		(long time))

	(vp-alloc slot_size)
	(entry :sys_mail :declare '(:r0 :r1 :r2))
	(save-fields :rsp '(slot_id slot_name slot_info) '(:r0 :r1 :r2))

	;insert into service map, the node id of the mailbox id
	(vp-add-cr (+ +str_data +net_id_node_id) :r0)
	(call :nodeid :create '(:r0) '(:r0))
	(assign '(:r0) '((:rsp slot_key)))
	(fn-bind 'sys/statics/statics :r0)
	(call :hmap :cfind '((:r0 statics_sys_mail_node_map) (:rsp slot_key) (@ class/nodeid/eql)) '(_ :r1 :r2))
	(save-fields :rsp '(slot_tuple slot_bucket) '(:r1 :r2))
	(vpif '(:r1 = 0))
		(call :array :create :nil '((:rsp slot_tuple)))
		(call :hset :create `(1) '((:rsp slot_set)))
		(call :array :push_back2 '((:rsp slot_tuple) (:rsp slot_set) 0))
		(call :array :push_back2 '((:rsp slot_tuple) -1 -1))
		(call :array :push_back2 '((:rsp slot_tuple) 0 0))
		(call :array :push_back '((:rsp slot_tuple) -1))
		(call :list :push_back2 '((:rsp slot_bucket) (:rsp slot_key) (:rsp slot_tuple)))
	(else)
		(assign '((:r1 +ptr_size)) '(:r1))
		(assign '(:r1) '((:rsp slot_tuple)))
		(call :nodeid :destroy '((:rsp slot_key)))
	(endif)
	(call :host_os :pii_time :nil '((:rsp slot_time)))
	(call :array :set_elem `((:rsp slot_tuple) (:rsp slot_time) ,+node_time))
	(call :array :get_first '((:rsp slot_tuple)) '(_ (:rsp slot_set)))
	(call :sys_mail :service '((:rsp slot_name) (:rsp slot_id) (:rsp slot_info)) '((:rsp slot_name)))
	(call :hset :cinsert '((:rsp slot_set) (:rsp slot_name) (@ class/sym/eql_str)))
	;a full ping is now due
	(fn-bind 'sys/statics/statics :r0)
	(vp-cpy-cr 1 :r1)
	(vp-xor-rr :r2 :r2)
	(save-fields :r0 '(statics_sys_mail_ping_full statics_sys_mail_ping_next) '(:r1 :r2))

	(exit :sys_mail :declare '((:rsp slot_name)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :enquire)
	;inputs
	;:r0 = service prefix str object (ptr)
	;outputs
	;:r0 = matching service entries list object (ptr)
	;trashes
	;:r0-:r14, :d0-:d15

	(structure slot 0
		(ptr prefix entries))

	(vp-alloc slot_size)
	(entry :sys_mail :enquire '((:rsp slot_prefix)))

	(call :list :create :nil '((:rsp slot_entries)))
	(fn-bind 'sys/statics/statics :r0)
	(call :hmap :each '((:r0 statics_sys_mail_node_map) ($ callback1) :rsp))

	(exit :sys_mail :enquire '((:rsp slot_entries)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback1)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hmap :each_callback '(:r0 :r1 :r2))

	;a node with no way to it has no services to find
	(assign '((:r1 +ptr_size)) '(:r3))
	(assign '((:r3 +array_begin)) '(:r3))
	(assign `((:r3 ,(* +node_hops +long_size))) '(:r3))
	(vpif '(:r3 = +node_hops_none))
		(vp-ret)
	(endif)

	(assign '((:r1 +ptr_size) 0) '(:r2 :r1))
	(class/array/get_elem :r2 :r1 :r1 :r2)
	(jump :hset :each '(:r1 ($ callback2) :r0))

(vp-label 'callback2)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0)) '(:r1))
	(vp-push :r0 :r1)
	(call :str :starts_with '((:r0 slot_prefix) :r1) '(_ :r2))
	(vp-pop :r0 :r1)
	(vpif '(:r2 = 0))
		(class/obj/ref :r1 :r2)
		(jump :list :push_back '((:r0 slot_entries) :r1))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :forget)
	;inputs
	;:r0 = service key str object (ptr)
	;trashes
	;:r0-:r14, :d0-:d15

	;find in service map and erase
	(fn-bind 'sys/statics/statics :r1)
	(call :hmap :each '((:r1 statics_sys_mail_node_map) ($ callback) :r0))
	;a full ping is now due
	(fn-bind 'sys/statics/statics :r0)
	(vp-cpy-cr 1 :r1)
	(vp-xor-rr :r2 :r2)
	(save-fields :r0 '(statics_sys_mail_ping_full statics_sys_mail_ping_next) '(:r1 :r2))
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hmap :each_callback '(:r0 :r1 :r2))

	(vp-swp-rr :r0 :r1)
	(assign '((:r0 +ptr_size) 0) '(:r2 :r0))
	(class/array/get_elem :r2 :r0 :r0 :r2)
	(call :hset :cfind `(:r0 :r1 (@ ,(f-path :sym :eql_str))) '(:r0 :r1 :r2))
	(vpif '(:r1 /= 0))
		(jump :list :erase '(:r2 :r1))
	(endif)
	(vp-ret)

(def-func-end)

(defun ping-send (field func)
	;emit the code to hash, build and send the ping for a list of services,
	;the field of the cat that is the list, and func, the name of the call.
	;The hash of the list is the sum of the hashes of its entries, so the
	;order they are held in does not matter, and 0 is kept for no services.
	;The list is entry, line feed, entry, line feed...
	(call :list :get_both `((:rsp (+ slot_cat ,field))) '(_ :r5 :r6))
	(vp-xor-rr :r7 :r7)
	(vpif '(:r5 /= :r6))
		(loop-start)
			(call :str :hash '((:r5 0)) '(_ :r1))
			(vp-add-rr :r1 :r7)
			(vp-add-cr (* +ptr_size 2) :r5)
		(loop-until '(:r5 = :r6))
		;a hash is 32 bits, one of 0 with services is 1
		(vp-cpy-rr :r7 :r1)
		(vp-shl-cr 32 :r1)
		(vpif '(:r1 = 0))
			(vp-cpy-cr 1 :r7)
		(endif)
	(endif)
	(assign '(:r7) '((:rsp slot_hash)))
	;the services follow the header only in a full ping
	(call :str :cat `((:rsp (+ slot_cat cat_lf)) (:rsp (+ slot_cat ,field))) '(:r0))
	(assign '((:rsp slot_full)) '(:r2))
	(vp-xor-rr :r1 :r1)
	(vpif '(:r2 /= 0))
		(assign '((:r0 +str_length)) '(:r1))
	(endif)
	(save-fields :rsp '(slot_services slot_body) '(:r0 :r1))
	(vp-add-cr +kn_msg_ping_services :r1)
	(call :sys_mail :alloc '(:r1) '(:r0 :r1))
	(save-fields :rsp '(slot_msg slot_data) '(:r0 :r1))
	(load-fields :rsp '(slot_key slot_full slot_hash) '(:r5 :r10 :r9))
	(assign `(,func) '(:r6))
	(fn-bind 'sys/statics/statics :r7)
	(vp-call 'ping_header)
	(assign '((:rsp slot_body)) '(:r2))
	(vpif '(:r2 /= 0))
		(load-fields :rsp '(slot_data slot_services) '(:r1 :r0))
		(vp-add-cr +str_data :r0)
		(vp-add-cr +kn_msg_ping_services :r1)
		(call :sys_mem :copy '(:r0 :r1 :r2))
	(endif)
	(call :sys_mail :send '((:rsp slot_msg)))
	(call :str :destroy '((:rsp slot_services))))

(def-method :sys_mail :ping)
	;inputs
	;:r0 = 0 for a routing ping, else a full ping with the services (uint)
	;trashes
	;:r0-:r14, :d0-:d15
	;info
	;ping out to network (cluster * and system @). A routing ping holds a
	;hash of the services, a node that does not have them will ask.

	(structure cat 0
		(ptr entries_global entries_sys lf))

	(structure slot 0
		(ptr key msg data services)
		(pptr tuple)
		(uint full hash body)
		(align)
		(struct cat cat_size))

	(vp-alloc slot_size)
	(entry :sys_mail :ping '((:rsp slot_full)))

	(fn-bind 'sys/statics/statics :r0)
	(vp-add-cr statics_sys_task_kernel_node_id :r0)
	(call :nodeid :create '(:r0) '(:r0))
	(assign '(:r0) '((:rsp slot_key)))
	(fn-bind 'sys/statics/statics :r2)
	(call :hmap :cfind '((:r2 statics_sys_mail_node_map) :r0 (@ class/nodeid/eql)) '(_ :r1 _))
	(vpif '(:r1 /= 0))
		(assign '((:r1 +ptr_size) +char_lf) '(:r1 :r0))
		(assign '(:r1 :r0) '((:rsp slot_tuple) (:rsp (+ slot_cat cat_lf))))
		(call :str :create_from_buffer '((& :rsp (+ slot_cat cat_lf)) 1) '(:r0))
		(assign '(:r0) '((:rsp (+ slot_cat cat_lf))))
		(call :list :create :nil '(:r0))
		(assign '(:r0) '((:rsp (+ slot_cat cat_entries_global))))
		(call :list :create :nil '(:r0))
		(assign '(:r0) '((:rsp (+ slot_cat cat_entries_sys))))
		(call :array :get_elem '((:rsp slot_tuple) +node_set) '(_ :r0))
		(call :hset :each '(:r0 ($ callback) (& :rsp slot_cat)))

		;1. Send cluster ping (*)
		(ping-send 'cat_entries_global '+kn_call_ping)

		;2. Send system ping (@) if any system-local services exist, and
		;for a few pings after the last of them has gone: a node that
		;stopped at once would never say it has none now, and the others
		;of its system would hold what it had for ever. A ping of none has
		;a hash of 0, and is taken as that
		(assign '((:rsp (+ slot_cat cat_entries_sys))) '(:r0))
		(assign '((:r0 +array_length)) '(:r0))
		(fn-bind 'sys/statics/statics :r1)
		(vpif '(:r0 /= 0))
			(assign `(,ping_sys_tail) '(:r0))
			(assign '(:r0) '((:r1 statics_sys_mail_ping_sys_tail)))
			(ping-send 'cat_entries_sys '+kn_call_ping_sys)
		(else)
			(assign '((:r1 statics_sys_mail_ping_sys_tail)) '(:r0))
			(vpif '(:r0 /= 0))
				(vp-sub-cr 1 :r0)
				(assign '(:r0) '((:r1 statics_sys_mail_ping_sys_tail)))
				(ping-send 'cat_entries_sys '+kn_call_ping_sys)
			(endif)
		(endif)

		(call :list :destroy '((:rsp (+ slot_cat cat_entries_global))))
		(call :list :destroy '((:rsp (+ slot_cat cat_entries_sys))))
		(call :str :destroy '((:rsp (+ slot_cat cat_lf))))
	(else)
		;no services at all
		(call :sys_mail :alloc `(,+kn_msg_ping_services) '(:r0 :r1))
		(load-fields :rsp '(slot_key slot_full) '(:r5 :r10))
		(assign `(,+kn_call_ping 0) '(:r6 :r9))
		(fn-bind 'sys/statics/statics :r7)
		(vp-call 'ping_header)
		(call :sys_mail :send '(:r0))
	(endif)
	(assign '((:rsp slot_key)) '(:r0))
	(vp-free slot_size)
	(jump :nodeid :destroy '(:r0))

(vp-label 'ping_header)
	(assign '((:r7 statics_sys_mail_session) 0) '(:r8 :r2))
	(vp-add-cr 1 :r8)
	(assign '(:r8 :r6) `((:r7 statics_sys_mail_session) (:r1 ,+kn_msg_ping_func)))
	(vp-store-rrc-i :r8 :r1 +kn_msg_ping_session)
	(vp-store-rrc-i :r2 :r1 +kn_msg_ping_hops)
	(vp-store-rrc-i :r9 :r1 +kn_msg_ping_hash)
	(vp-store-rrc-i :r10 :r1 +kn_msg_ping_full)
	(assign '((:r7 statics_sys_mail_ping_interval)) '(:r8))
	(vp-store-rrc-i :r8 :r1 +kn_msg_ping_interval)
	(assign '((:r7 statics_sys_mail_ping_kick)) '(:r8))
	(vp-store-rrc-i :r8 :r1 +kn_msg_ping_kick)
	(load-node-id :r5 +str_data)
	(save-net-id :r0 +msg_dest)
	(save-node-id :r1 +kn_msg_ping_origin)
	(save-node-id :r1 +kn_msg_ping_via)
	(load-node-id :r7 statics_sys_task_kernel_system_id)
	(save-node-id :r1 +kn_msg_ping_system)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hset :each_callback '(:r0 :r1 :r2))

	(assign '((:r1 0) (:r0 cat_lf)) '(:r1 :r2))
	(vp-load-rcr-ub :r1 +str_data :r3)
	(vpif '(:r3 = +char_multiply))
		(class/obj/ref :r1 :r3)
		(class/obj/ref :r2 :r3)
		(jump :list :push_back2 '((:r0 cat_entries_global) :r1 :r2))
	(elseif '(:r3 = +char_at))
		(class/obj/ref :r1 :r3)
		(class/obj/ref :r2 :r3)
		(jump :list :push_back2 '((:r0 cat_entries_sys) :r1 :r2))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :kick)
	;trashes
	;:r0-:r14, :d0-:d15
	;info
	;the network has changed. Ping soon, at a random time within the
	;spread, so that not all nodes do at once, start the back off again,
	;and expect to hear from every node within the spread plus the window,
	;those that are not heard from are purged. The spread grows with the
	;number of nodes known.

	(structure kick 0
		(long limit count))

	(structure slot 0
		(long now spread)
		(struct kick kick_size))

	(vp-alloc slot_size)

	;count the nodes, with a limit that changes none of them
	(call :host_os :pii_time :nil '(:r0))
	(assign '(2000000000) '(:r1))
	(vp-lea-rrr :r0 :r1 :r2)
	(vp-xor-rr :r3 :r3)
	(save-fields :rsp (list 'slot_now (+ slot_kick kick_limit) (+ slot_kick kick_count)) '(:r0 :r2 :r3))
	(fn-bind 'sys/statics/statics :r0)
	(call :hmap :each '((:r0 statics_sys_mail_node_map) ($ callback) (& :rsp slot_kick)))
	(assign '((:rsp (+ slot_kick kick_count))) '(:r0))
	(vp-mul-cr ping_stagger :r0)
	(vp-max-cr ping_stagger_min :r0)
	(assign '(:r0) '((:rsp slot_spread)))

	;my ping
	(call :sys_math :i_rand '(:r0) '(:r0))
	(load-fields :rsp '(slot_now slot_spread) '(:r1 :r2))
	(vp-add-rr :r1 :r0)
	(fn-bind 'sys/statics/statics :r3)
	(assign '((:r3 statics_sys_mail_ping_next)) '(:r4))
	(vpif '(:r0 < :r4))
		(assign '(:r0) '((:r3 statics_sys_mail_ping_next)))
	(endif)
	(assign `(,ping_period_min) '(:r4))
	(assign '(:r4) '((:r3 statics_sys_mail_ping_interval)))

	;and when theirs must be here by
	(vp-add-rr :r2 :r1)
	(vp-add-cr ping_window :r1)
	(assign '(:r1) '((:rsp (+ slot_kick kick_limit))))
	(call :hmap :each '((:r3 statics_sys_mail_node_map) ($ callback) (& :rsp slot_kick)))

	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hmap :each_callback '(:r0 :r1 :r2))

	(assign '((:r0 kick_count)) '(:r2))
	(vp-add-cr 1 :r2)
	(assign '(:r2 (:r0 kick_limit) (:r1 +ptr_size)) '((:r0 kick_count) :r0 :r1))
	(assign '((:r1 +array_begin)) '(:r1))
	(assign `((:r1 ,(* +node_time +long_size))) '(:r2))
	(vpif '(:r0 < :r2))
		(assign '(:r0) `((:r1 ,(* +node_time +long_size))))
	(endif)
	(vp-ret)

(def-func-end)

(def-method :sys_mail :devices)
	;outputs
	;:r0 = known network nodes list object (ptr)
	;trashes
	;:r0-:r14, :d0-:d15
	;info
	;each is a string, the node id and then the id of the machine it is on

	(call :list :create :nil '(:r0))
	(vp-push :r0)
	(fn-bind 'sys/statics/statics :r0)
	(call :hmap :each '((:r0 statics_sys_mail_node_map) ($ callback) (:rsp 0)))
	(vp-pop :r0)

	(exit :sys_mail :devices '(:r0))
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = predicate data (ptr)
	;:r1 = element iterator (ptr)
	;:r2 = bucket list pointer (ptr)

	(entry :hmap :each_callback '(:r0 :r1 :r2))

	;a node with no way to it is not listed
	(assign '((:r1 +ptr_size)) '(:r3))
	(assign '((:r3 +array_begin)) '(:r3))
	(assign `((:r3 ,(* +node_hops +long_size))) '(:r3))
	(vpif '(:r3 = +node_hops_none))
		(vp-ret)
	(endif)

	(vp-push :r0)
	(load-fields :r1 '(0 +ptr_size) '(:r2 :r3))
	(assign '((:r3 +array_begin)) '(:r3))
	(vp-alloc (* +node_id_size 2))
	(load-node-id :r2 +str_data :r4 :r5)
	(save-node-id :rsp 0 :r4 :r5)
	(assign `((:r3 ,(* +node_system1 +long_size)) (:r3 ,(* +node_system2 +long_size))) '(:r4 :r5))
	(save-node-id :rsp +node_id_size :r4 :r5)
	(call :str :create_from_buffer `((& :rsp 0) ,(* +node_id_size 2)) '(:r1))
	(vp-free (* +node_id_size 2))
	(vp-pop :r0)
	(jump :list :push_back '(:r0 :r1))

(def-func-end)

(def-method :sys_mail :ready)
	;inputs
	;:r0-:r1 = peer node id (node_id)
	;:r2 = key node object (ptr)
	;outputs
	;:r0 = 0 if none, else msg (ptr)
	;trashes
	;:r0-:r13

	(vp-rdef (tuple iter_begin iter_end via1 via2))
	(vp-rdef (peer1 peer2 next node key) '(:r9 :r10 :r11 :r12 :r13))

	(entry :sys_mail :ready `(,peer1 ,peer2 ,key))

	(fn-bind 'sys/statics/statics next)
	(loop-list-forward next statics_sys_mail_outbound_list node next 'exit)
		(load-node-id node (+ +msg_dest +net_id_node_id) via1 via2)
		(vpif `(,peer1 = ,via1))
			(breakif `(,peer2 = ,via2) 'exit)
		(endif)
		(save-node-id key +str_data via1 via2)
		(fn-bind 'sys/statics/statics tuple)
		(vp-push peer1 peer2)
		(call :hmap :cfind `((,tuple statics_sys_mail_node_map) ,key (@ ,(f-path :nodeid :eql))) `(_ ,iter_begin _))
		(vp-pop peer1 peer2)
		(continueif `(,iter_begin = 0))
		(call :array :get_both `((,iter_begin +ptr_size)) `(_ ,iter_begin ,iter_end))
		(vp-add-cr (* +node_vias +long_size) iter_begin)
		(continueif `(,iter_begin = ,iter_end))
		(loop-start)
			(load-node-id iter_begin 0 via1 via2)
			(vp-add-cr +node_id_size iter_begin)
			(vpif `(,via1 = ,peer1))
				(breakif `(,via2 = ,peer2) 'exit)
			(endif)
		(loop-until `(,iter_begin = ,iter_end))
	(loop-end)
	(vpif `(,next /= 0))
		(vp-cpy-rr node next)
		(ln-remove-node node key)
	(endif)

	(exit :sys_mail :ready `(,next))
	(vp-ret)

(def-func-end)
