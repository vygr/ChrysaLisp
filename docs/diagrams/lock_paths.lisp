;docs/ai_digest/lock_service.md: which paths a lock on a path is in the way of
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7)
(dia-put s 'root (dia-box '("\q\q or /" "everything") 110 40 red 11 :first) 190 0)
(dia-put s 'a (dia-box '("a" "over it: in the way") 150 40 red 11 :first) 60 80)
(dia-put s 'x (dia-box '("x" "free") 90 40 green 11 :first) 320 80)
(dia-put s 'ab (dia-box '("a/b" "write locked") 130 40 gold 11 :first) 0 160)
(dia-put s 'ac (dia-box '("a/c" "free") 90 40 green 11 :first) 160 160)
(dia-put s 'abd (dia-box '("a/b/d" "under it: in the way") 150 40 red 11 :first) 0 240)
(dia-join s 'root 'a "" :none)
(dia-join s 'root 'x "" :none)
(dia-join s 'a 'ab "" :none)
(dia-join s 'a 'ac "" :none)
(dia-join s 'ab 'abd "" :none)
(dia-say s "A lock on a/b is in the way of a/b, of all above it and all below it," 440 110 11)
(dia-say s "and of nothing beside it: a/c and x go on at once." 440 126 11)
(dia-say s "Two paths clash if one is the start of the other:" 440 158 11)
(dia-say s "(every (const eql) path_a path_b)" 440 174 11 :t 0xff202428)
(dia-say s "Readers share a path. A writer has it alone." 440 206 11)
(dia-say s "Who waits is served in the order they asked, path by path." 440 222 11)
(diagram "lock_paths" (dia-scene-doc s))
