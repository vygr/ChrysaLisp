;docs/ai_digest/slicing_and_dicing.md: (splice) gathers ranges from two sequences into a new one
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-say s "(splice {abcdef} {XYZ} (nums 0 2  0 3  4 6))" 0 -30 12 :t 0xff202428)
(dia-put s 'a (dia-box '("src1" "a b c d e f") 330 44 blue 11 :first) 0 0)
(dia-put s 'b (dia-box '("src2" "X Y Z") 330 44 gold 11 :first) 0 200)
(dia-put s 'r0 (dia-box "a b" 70 32 blue 11) 50 106)
(dia-put s 'r1 (dia-box "X Y Z" 90 32 gold 11) 120 106)
(dia-put s 'r2 (dia-box "e f" 70 32 blue 11) 210 106)
(dia-join s 'a 'r0 "0 2")
(dia-join s 'b 'r1 "0 3")
(dia-join s 'a 'r2 "4 6")
(dia-say s "the new sequence, {abXYZef}" 300 126 11 :t 0xff202428)
(dia-say s "The pairs are start and end, taken in turn from src1 and src2. The lengths are added up, the result is made that long," 0 276 11)
(dia-say s "and each range is copied into it, memory to memory. Neither source is changed. erase, insert, replace and rotate are this." 0 292 11)
(diagram "splice" (dia-scene-doc s))
