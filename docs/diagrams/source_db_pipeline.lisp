;docs/ai_digest/source_database.md: how the databases of the VP source are made
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'info (dia-box '("files-classes-info" "are the databases on disk stale ?") 250 44 grey 11 :first) 130 0)
(dia-put s 'build (dia-box "build-and-save-databases" 250 34 gold 11 :t) 130 84)
(dia-put s 'pass (dia-box "unified-pass" 190 34 blue 11) 0 160)
(dia-put s 'link (dia-box "link-databases" 190 34 blue 11) 0 226)
(dia-put s 'inherit (dia-box "inherit-signatures" 210 34 blue 11) 300 160)
(dia-put s 'over (dia-box "build-method-overrides" 210 34 blue 11) 300 226)
(dia-put s 'save (dia-box "tree-save" 250 34 green 11 :t) 130 300)
(dia-join s 'info 'build "if they are")
(dia-join s 'build 'pass "")
(dia-join s 'build 'inherit "")
(dia-join s 'pass 'link "")
(dia-join s 'inherit 'over "")
(dia-join s 'link 'save "")
(dia-join s 'over 'save "")
(diagram "source_db_pipeline" (dia-scene-doc s))
