;docs/ai_digest/vp_simd.md: one (vp-simd) is read all, do all, write all
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-say s "(vp-simd vp-add-rr '(:r0 :r1 :r2) '(:r3 :r4 :r5))" 0 -30 12 :t 0xff202428)
(each (lambda (i)
	(defq y (* i 46) n (str i) d (str (+ i 3)))
	(dia-put s (sym (cat "s" n)) (dia-box (cat ":r" n "  :r" d) 110 32 grey 11) 0 y)
	(dia-put s (sym (cat "o" n)) (dia-box "add" 80 32 gold 11 :t) 200 y)
	(dia-put s (sym (cat "d" n)) (dia-box (cat ":r" d) 80 32 green 11) 370 y)
	(dia-join s (sym (cat "s" n)) (sym (cat "o" n)) "")
	(dia-join s (sym (cat "o" n)) (sym (cat "d" n)) ""))
	'(0 1 2))
(dia-say s "1 read" 0 140 11 :t 0xff202428)
(dia-say s "every source, as it was" 0 156 11)
(dia-say s "before any of it began" 0 172 11)
(dia-say s "2 execute" 200 140 11 :t 0xff202428)
(dia-say s "each lane by itself, none" 200 156 11)
(dia-say s "sees another's result" 200 172 11)
(dia-say s "3 write" 370 140 11 :t 0xff202428)
(dia-say s "every result" 370 156 11)
(dia-say s "at once" 370 172 11)
(dia-say s "So a register is a destination in one lane only, and a destination of one lane is not a source of another." 0 204 11)
(diagram "simd_lanes" (dia-scene-doc s))
