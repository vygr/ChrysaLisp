;docs/ai_digest/polygon_sets.md: what an eraser covers as it is moved, and a line with that taken out of it
(import "lib/math/polygon.inc")
(defq s (dia-scene) blue 0xffd7e6f7 gold 0xffffe8a8 green 0xffbfe3b4 line 0xff3c4650
	cloth (path -14.0 -9.0 14.0 -9.0 14.0 9.0 -14.0 9.0)
	way (path 30.0 150.0 80.0 60.0 150.0 90.0 210.0 30.0)
	swept (poly-sweep cloth way)
	pen (path-stroke-polylines (list) 5.0 +join_round +cap_round +cap_round (list (path 10.0 40.0 120.0 120.0 240.0 70.0)))
	left (poly-difference pen swept 1 1))
;the eraser at each point of its way, and the hull of each two
(defq i 0 last_at :nil)
(while (< i (length way))
	(defq at (path) j 0)
	(while (< j (length cloth))
		(push at (+ (elem-get way i) (elem-get cloth j)) (+ (elem-get way (inc i)) (elem-get cloth (inc j))))
		(setq j (+ j 2)))
	(if last_at (dia-put s :nil (list (cwb-shape (cwb-d-points (poly-hull (list last_at at)) :t) :fill blue :stroke 0xff9aa4ae :width 0.8) 250 170) 0 0))
	(setq last_at at i (+ i 2)))
(setq i 0)
(while (< i (length way))
	(dia-put s :nil (list (cwb-shape (cwb-d-rect (- (elem-get way i) 14.0) (- (elem-get way (inc i)) 9.0) (+ (elem-get way i) 14.0) (+ (elem-get way (inc i)) 9.0) 0) :fill gold :stroke line :width 1.0) 250 170) 0 0)
	(setq i (+ i 2)))
(dia-say s "the eraser where it was felt, gold," 0 196 11)
(dia-say s "and the hull of each two, blue" 0 212 11)
(dia-put s :nil (list (cwb-shape (join (map (# (cwb-d-points %0 :t)) swept) " ") :fill blue :stroke line :width 1.4 :rule :evenodd) 250 170) 290 0)
(dia-put s :nil (list (cwb-shape (join (map (# (cwb-d-points %0 :t)) pen) " ") :fill 0xff202428 :rule :nonzero) 250 170) 290 0)
(dia-say s "(poly-sweep): the hulls made one," 290 196 11)
(dia-say s "and a line drawn with a pen under it" 290 212 11)
(dia-put s :nil (list (cwb-shape (join (map (# (cwb-d-points %0 :t)) swept) " ") :stroke 0xffc8ced4 :width 1.0) 250 170) 580 0)
(dia-put s :nil (list (cwb-shape (join (map (# (cwb-d-points %0 :t)) left) " ") :fill 0xff202428 :rule :evenodd) 250 170) 580 0)
(dia-say s (cat "(poly-difference): what is left of the line, " (str (length left)) " rings") 580 196 11)
(diagram "poly_sweep" (dia-scene-doc s))
