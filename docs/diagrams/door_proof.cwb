			60
			:kind
			:text
			:fill
			4284245616
			:stroke
			0
			:text
			"[The two ends say different things, D and L, so one's answer is no use sent back to it.]"
			:font_size
			11
			:pos
			((:list 2)
				13.00000
				316.00000
			)
		)
