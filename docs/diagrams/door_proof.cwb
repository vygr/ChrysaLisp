			:fill
			4284245616
			:stroke
			0
			:text
			"[The key is never sent. The nonces are new every time, so an answer heard once is no use again.]"
			:font_size
			11
			:pos
			((:list 2)
				13.00000
				300.00000
			)
		)
		((:list 15)
