;docs/gui/widgets.md: a UI tree, and a property looked for up it
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'window (dia-box '("Window" ":color  :font  :ink_color") 200 46 gold 11 :first) 170 0)
(dia-put s 'flow (dia-box '("Flow" ":flow_flags") 150 46 grey 11 :first) 195 86)
(dia-put s 'title (dia-box '("Title" ":text") 120 46 blue 11 :first) 90 172)
(dia-put s 'grid (dia-box '("Grid" ":grid_width") 120 46 grey 11 :first) 250 172)
(dia-put s 'b1 (dia-box '("Button" ":text") 110 46 blue 11 :first) 180 258)
(dia-put s 'b2 (dia-box '("Button" ":text  :color") 130 46 blue 11 :first) 310 258)
(dia-join s 'window 'flow "" :none)
(dia-join s 'flow 'title "" :none)
(dia-join s 'flow 'grid "" :none)
(dia-join s 'grid 'b1 "" :none)
(dia-join s 'grid 'b2 "" :none)
(dia-say s "(get :color this) in the first Button:" 440 196 12 :t 0xff202428)
(dia-say s "not on the Button, not on the Grid, not on the Flow," 440 212 11)
(dia-say s "found on the Window. One :color at the root" 440 228 11)
(dia-say s "colours the whole tree." 440 244 11)
(dia-say s "The second Button has its own, found at once." 440 268 11)
(dia-say s "(def? :min_width this) asks this widget only." 440 292 11)
(dia-say s "A widget is a Lisp environment, its parent in the tree is its parent environment." 0 336 12 :nil 0xff202428)
(diagram "widget_tree" (dia-scene-doc s))
