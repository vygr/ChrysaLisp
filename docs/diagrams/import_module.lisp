;docs/ai_digest/import_modules.md: what (import) does, and what a module leaves behind
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'imp (dia-box "(import \qlib/x.inc\q)" 210 34 grey 12 :t) 0 0)
(dia-put s 'seen (dia-box '("already read into this" "environment, or one above it ?") 210 44 gold 11 :first) 0 70)
(dia-put s 'no (dia-box "nothing is done" 150 34 grey 11) 280 75)
(dia-put s 'repl (dia-box '("(repl stream name)" "each form of the file, read and run here") 260 44 blue 11 :first) -25 160)
(dia-join s 'imp 'seen "")
(dia-join s 'seen 'no "yes")
(dia-join s 'seen 'repl "no")
(dia-say s "a module, in the file" 480 14 12 :t 0xff202428)
(dia-put s 'push (dia-box "(env-push)" 250 30 green 11) 480 24)
(dia-put s 'body (dia-box '("its functions and what it keeps" "seen only here") 250 44 0xffffffff 11) 480 62)
(dia-put s 'exp (dia-box "(export-symbols '(...))" 250 30 green 11) 480 114)
(dia-put s 'pop (dia-box "(env-pop)" 250 30 green 11) 480 152)
(dia-say s "Only what was exported is left in the environment" 480 206 11)
(dia-say s "it was read into. The rest has gone." 480 222 11)
(diagram "import_module" (dia-scene-doc s))
