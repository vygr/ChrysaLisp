;docs/ai_digest/mesh_net.md: what the Net service of a machine is made of, and what each part says to another machine
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 dark 0xff202428)
(dia-under s (dia-box "" 520 390 grey) 0 0)
(dia-under s (dia-box "" 200 390 grey) 640 0)
(dia-say s "one machine: the session that is its member of the mesh" 12 20 12 :t dark)
(dia-say s "another machine" 652 20 12 :t dark)
(dia-put s 'key (dia-box '("mesh_key" "a file, at the root of the tree") 200 44 blue 11 :first) 15 40)
(dia-put s 'net (dia-box '("the Net service, @Net" "every session starts one" "looks at the key every 2 seconds") 200 62 gold 11 :first) 15 150)
(dia-join s 'key 'net "the key, or none")
(dia-put s 'beacon (dia-box '("the beacon" "who I am, where I listen" "every 2 seconds") 165 58 green 11 :first) 340 62)
(dia-put s 'ears (dia-box '("discovery" "hears the others" "and dials those it must") 165 58 green 11 :first) 340 152)
(dia-put s 'gate (dia-box '("the gate" "listens for connections" "first come has the port") 165 58 green 11 :first) 340 242)
(dia-join s 'net 'beacon "")
(dia-join s 'net 'ears "")
(dia-join s 'net 'gate "")
(dia-put s 'door (dia-box '("a door" "one for each connection" "each end proves it has the key") 165 58 blue 11 :first) 340 322)
(dia-join s 'gate 'door "")
(dia-put s 'link (dia-box '("a link" "an in task and an out task" "mail both ways, a ping each 5s") 200 58 blue 11 :first) 15 322)
(dia-join s 'door 'link "proved")
(dia-put s 'oears (dia-box '("its discovery") 170 44 green 11 :first) 655 69)
(dia-put s 'obeacon (dia-box '("its beacon") 170 44 green 11 :first) 655 159)
(dia-put s 'odoor (dia-box '("a door" "that dials") 170 44 blue 11 :first) 655 249)
(dia-join s 'beacon 'oears "UDP 3334")
(dia-join s 'obeacon 'ears "UDP 3334")
(dia-join s 'odoor 'gate "TCP 3333")
(dia-say s "A machine with no key has none of the green and blue parts: no beacon, no listener, no link." 0 412 11)
(dia-say s "When the key file changes the service tells the gate to go, closes the two sockets, drops every link, and starts again with the new key." 0 428 11)
(diagram "net_parts" (dia-scene-doc s))
