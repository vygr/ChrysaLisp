;docs/ai_digest/mesh_net.md: how two ends of a sealed link come to a key each way
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7 dark 0xff202428)
(dia-say s "the end that dialled" 0 14 12 :t dark)
(dia-say s "the end that listened" 470 14 12 :t dark)
(dia-put s 'dh (dia-box '("CLDOOR3, the version, a nonce, a new" "X25519 share, and the seal byte: 1") 210 44 blue 11) 0 30)
(dia-put s 'lh (dia-box '("CLDOOR3, the version, a nonce, a new" "X25519 share, and the seal byte: 0") 210 44 blue 11) 470 30)
(dia-join s 'dh 'lh "60 bytes each way" :both)
(dia-put s 'dt (dia-box '("HMAC under the mesh key of the version," "D, both nonces, both shares, seal") 210 44 gold 11) 0 100)
(dia-put s 'lt (dia-box '("HMAC under the mesh key of the version," "L, both nonces, both shares, seal") 210 44 gold 11) 470 100)
(dia-join s 'dt 'lt "32 bytes each way, each checks the other's" :both)
(dia-put s 'ds (dia-box '("shared secret: its secret" "with their share, X25519") 210 44 green 11) 0 170)
(dia-put s 'ls (dia-box '("shared secret: its secret" "with their share, X25519") 210 44 green 11) 470 170)
(dia-put s 'hk (dia-box '("HKDF, salted with the two nonces," "of the secret and the mesh key") 230 44 green 11) 230 240)
(dia-join s 'ds 'hk "")
(dia-join s 'ls 'hk "")
(dia-put s 'kd (dia-box '("a key, dialler to listener") 210 30 red 11) 0 310)
(dia-put s 'kl (dia-box '("a key, listener to dialler") 210 30 red 11) 470 310)
(dia-join s 'hk 'kd "")
(dia-join s 'hk 'kl "")
(dia-say s "The seal byte is the dialler's: 1 for a host outside the private addresses, or link -s. It is in the proof, so it can not be changed." 0 360 11)
(dia-say s "The secrets are new each link and forgotten after: a mesh key found later does not open what went before." 0 376 11)
(diagram "sealed_keys" (dia-scene-doc s))
