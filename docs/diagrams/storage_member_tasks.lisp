;docs/ai_digest/storage_service.md: the tasks of a member, what each does, and who asks whom
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'app (dia-box '("an app" "storage-put, storage-get, a stream") 200 44 grey 11 :first) 0 20)
(dia-put s 'svc (dia-box '("the service" "a bot, it only answers") 180 44 blue 12 :first) 270 20)
(dia-put s 'store (dia-box '("the store" "an exFAT volume, a file or a disk") 190 44 green 11 :first) 265 120)
(dia-put s 'others (dia-box '("the other members" "their services") 180 44 grey 11 :first) 270 230)
(dia-put s 'tender (dia-box '("the tender" "a bot: compares notes, fetches, lets go") 245 44 blue 11 :first) 525 20)
(dia-put s 'runner (dia-box '("the gopher runner" "a bot: a step of each, 50ms") 245 44 blue 11 :first) 525 120)
(dia-put s 'lane (dia-box '("the slow lane" "what was not done in 50ms") 245 44 blue 11 :first) 525 230)
(dia-put s 'rec (dia-box '("a recorder" "storage -r, the Storage app") 200 44 grey 11 :first) 0 230)
(dia-join s 'app 'svc "asks")
(dia-join s 'svc 'store "keeps")
(dia-join s 'tender 'svc "asks")
(dia-join s 'tender 'others "asks")
(dia-join s 'svc 'runner "gophers")
(dia-join s 'runner 'lane "late")
(dia-join s 'runner 'others "sent on")
(dia-say s "each says what it does to a recorder that asks" 0 296 11)
(dia-say s "A service asks nothing of another member: two that did, each of the other," 0 330 12 :nil 0xff202428)
(dia-say s "would wait for ever. The tender does the asking." 0 348 12 :nil 0xff202428)
(diagram "storage_member_tasks" (dia-scene-doc s))
