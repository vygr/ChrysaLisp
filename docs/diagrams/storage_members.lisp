;docs/ai_digest/storage_service.md: every member has the path map, and a block is kept by three of them, by a rule
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'block (dia-box '("a block" "its name, a SHA-256") 170 44 gold 12 :first) 255 0)
(each (lambda (i)
		(defq name (elem-get '("m-a" "m-b" "m-c" "m-d" "m-e") i) keeps (find i '(1 2 3)))
		(dia-put s (sym name) (dia-box (list (cat "member " name) "the path map" (if keeps "keeps the block" "-"))
				120 60 (if keeps green grey) 11 :first)
			(* i 140) 140))
	(range 0 5))
(each (# (dia-join s 'block (sym %0) "")) '("m-b" "m-c" "m-d"))
(dia-say s "Each member is given a number from the block's name and its own id, SHA-256 again, and the three with the" 0 236 12 :nil 0xff202428)
(dia-say s "greatest keep it, or as many as its object asks. Nobody is asked and no table is kept: every member works it" 0 254 12 :nil 0xff202428)
(dia-say s "out the same, and when one comes or goes only its share moves." 0 272 12 :nil 0xff202428)
(diagram "storage_members" (dia-scene-doc s))
