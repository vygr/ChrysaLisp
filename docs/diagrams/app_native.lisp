;docs/ai_digest/app_acceleration.md: a native of an app, made by make apps, bound by ffi, and a call of it there and back
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-say s "Made once, by make apps, as make install does:" 0 12 12 :t 0xff202428)
(dia-put s 'vp (dia-box '("lisp.vp" {(def-func (path-to-absolute "./shade"))}) 200 48 gold 11 :first) 0 22)
(dia-put s 'make (dia-box '("make apps" "its VP, then this CPU's code") 200 48 grey 11 :first) 240 22)
(dia-put s 'obj (dia-box '("obj/<cpu>/<abi>/" "apps/science/mandelbrot/shade") 200 48 grey 11 :first) 480 22)
(dia-join s 'vp 'make)
(dia-join s 'make 'obj)
(dia-say s "And each call:" 0 116 12 :t 0xff202428)
(dia-put s 'lisp (dia-box '("Lisp" "(shade x0 y0 top pal)") 200 48 blue 11 :first) 0 126)
(dia-put s 'ffi (dia-box '("(ffi ... shade)" "the function bound to the name") 200 48 blue 11 :first) 240 126)
(dia-put s 'entry (dia-box '("entry" ":r0 this, :r1 the list of args") 200 48 green 11 :first) 480 126)
(dia-put s 'bind (dia-box '("errorif-lisp-args-sig, list-bind-args" "4 args of their types, to registers") 260 48 green 11 :first) 420 222)
(dia-put s 'work (dia-box '("the work" "in registers, vp-rdef, vp-fdef") 180 48 green 11 :first) 210 222)
(dia-put s 'back (dia-box '("(call :num :create)" "the answer, in :r1, back") 180 48 green 11 :first) 0 222)
(dia-join s 'lisp 'ffi)
(dia-join s 'ffi 'entry)
(dia-join s 'obj 'ffi "loaded the first time it is called")
(dia-join s 'entry 'bind)
(dia-join s 'bind 'work)
(dia-join s 'work 'back)
(dia-join s 'back 'lisp)
(dia-say s "The Lisp object, :r0, is pushed round the work and popped for the exit, with the answer in :r1." 0 300 11)
(diagram "app_native" (dia-scene-doc s))
