;docs/ai_digest/rack.md: the member's loop, as it updates itself
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7 dark 0xff202428)
(dia-put s 'run (dia-box '("the member runs" "rack.sh's loop waits on it") 190 44 blue 11) 0 0)
(dia-put s 'why (dia-box '("the herd gave a newer waypoint, or," "followed, -f, the branch moved on") 240 44 gold 11) 310 0)
(dia-join s 'run 'why "-f: each 10 min")
(dia-put s 'ff (dia-box '("the member stopped, and" "-f, the tree fast forwarded") 200 44 blue 11) 330 80)
(dia-join s 'why 'ff "")
(dia-put s 'mi (dia-box '("make install" "Windows: rack.bat, the snapshot") 200 44 green 11) 330 160)
(dia-join s 'ff 'mi "")
(dia-put s 'ok (dia-box '("built: started again on it," "notes the waypoint") 200 44 green 11) 0 160)
(dia-join s 'mi 'ok "built")
(dia-put s 'bad (dia-box '("failed: back to the commit it was at," "built again, that commit not tried again") 270 44 red 11) 300 240)
(dia-join s 'mi 'bad "failed")
(dia-join s 'ok 'run "")
(dia-join s 'bad 'ok "started again on it")
(dia-say s "A tree with a change of its own is not taken on. Each machine followed updates from git itself, not by the mesh," 0 304 11)
(dia-say s "so a change that old and new machines can not link over still reaches them all." 0 320 11)
(diagram "rack_update" (dia-scene-doc s))
