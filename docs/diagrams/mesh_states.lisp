;docs/ai_digest/mesh_net.md and docs/intro/mesh.md: the three states the Net service of a session can be in, and what moves it between them
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 dark 0xff202428)
(dia-put s 'off (dia-box '("off the network" "no key" "no listener, no beacon, no link") 200 62 grey 11 :first) 0 60)
(dia-put s 'wait (dia-box '("has a key, not the member" "another session has port 3333" "asks again every 10 seconds") 210 62 blue 11 :first) 300 60)
(dia-put s 'member (dia-box '("the member" "listens, beacons, hears" "has a link to each machine") 200 62 gold 11 :first) 610 60)
(dia-join s 'off 'wait "a key is put in")
(dia-join s 'wait 'member "the port is free")
(dia-put s 'leave (dia-box '("the key is another, or has gone" "the listener is told to go" "the sockets are closed, the links dropped") 250 62 green 11 :first) 280 190)
(dia-join s 'member 'leave "seen within 2 seconds")
(dia-join s 'leave 'off "gone")
(dia-join s 'leave 'wait "another")
(dia-say s "A session starts at the left with no key, in the middle with one." 0 20 12 :nil dark)
(dia-say s "First come, first served: of the sessions of one machine the first to ask has the port, and when it goes the next to ask has it." 0 286 11)
(dia-say s "A session started alone, -a, stays in the middle and does not ask. A subnet with a system id of its own has no key: it stays at the left." 0 302 11)
(diagram "mesh_states" (dia-scene-doc s))
