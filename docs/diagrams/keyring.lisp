;docs/ai_digest/mesh_net.md: the keyring, the key in use, and who looks at it
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7 dark 0xff202428)
(dia-under s (dia-box "" 170 150 grey) 0 0)
(dia-say s "keys/, the keyring" 10 16 12 :t dark)
(dia-put s 'k1 (dia-box '("own" "made by the install") 150 36 blue 11) 10 30)
(dia-put s 'k2 (dia-box '("rig" "4F7D-E9D5-CA7D-FC34") 150 36 blue 11) 10 72)
(dia-put s 'k3 (dia-box '("wan" "7339-EED1-C603-6817") 150 36 blue 11) 10 114)
(dia-put s 'mk (dia-box '("mesh_key" "the key in use") 150 44 gold 11) 270 72)
(dia-join s 'k2 'mk "key -u rig")
(dia-put s 'ns (dia-box '("the Net service" "looks each 2 seconds") 170 44 green 11) 500 72)
(dia-join s 'mk 'ns "changed")
(dia-put s 'ln (dia-box '("its links ended, and those" "with the new key made") 200 44 green 11) 485 150)
(dia-join s 'ns 'ln "")
(dia-put s 'sy (dia-box '("a sync, from whoever" "never writes either") 170 44 red 11) 270 150)
(dia-say s "key lists the keyring with fingerprints; -i takes in a key given, -x says one to give, -k keeps one put in mesh_key by hand." 0 214 11)
(dia-say s "Two machines with the same fingerprint have the same key. Say the fingerprint, never the key." 0 230 11)
(diagram "keyring" (dia-scene-doc s))
