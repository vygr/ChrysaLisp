;docs/vm/vp_assignment.md: (assign) sorts its copies so that nothing is lost before it is copied
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7)
(dia-say s "(assign '(:r0 :r1 42) '(:r1 :r2 :r3))" 0 14 13 :t 0xff202428)
(dia-put s 'r0 (dia-box ":r0" 70 34 blue 12 :t) 0 40)
(dia-put s 'r1 (dia-box ":r1" 70 34 blue 12 :t) 150 40)
(dia-put s 'r2 (dia-box ":r2" 70 34 blue 12 :t) 300 40)
(dia-put s 'c (dia-box "42" 70 34 grey 12 :t) 0 100)
(dia-put s 'r3 (dia-box ":r3" 70 34 blue 12 :t) 150 100)
(dia-join s 'r0 'r1 "2nd")
(dia-join s 'r1 'r2 "1st")
(dia-join s 'c 'r3 "")
(dia-say s ":r1 is copied out before it is copied over." 400 54 11)
(dia-say s "(vp-cpy-rr :r1 :r2)  (vp-cpy-rr :r0 :r1)  (vp-cpy-cr 42 :r3)" 400 72 11 :t 0xff202428)
(dia-say s "(assign '(:r0 :r1 :r2) '(:r1 :r2 :r0))" 0 174 13 :t 0xff202428)
(dia-put s 'a0 (dia-box ":r0" 70 34 red 12 :t) 0 200)
(dia-put s 'a1 (dia-box ":r1" 70 34 red 12 :t) 150 200)
(dia-put s 'a2 (dia-box ":r2" 70 34 red 12 :t) 300 200)
(dia-join s 'a0 'a1 "")
(dia-join s 'a1 'a2 "")
(dia-say s "and :r2 back to :r0: a ring, no order will do." 400 214 11)
(dia-say s "It throws. Break it with a register of your own." 400 232 11)
(dia-say s "A list on either side is VP registers and addressing modes. A string is a C-Script expression, compiled." 0 280 12 :nil 0xff202428)
(diagram "assign_order" (dia-scene-doc s))
