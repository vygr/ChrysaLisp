				((:list 15)
					:shape
					:id
					37
					:m
					((:path 6)
						1.00000 0.00000 13.00000 0.00000 1.00000 284.00000
					)
					:kind
					:text
					:fill
					4284245616
					:stroke
					0
					:text
					"[1  A and B both know where the other is, so the lower system id dials, A. B waits, 15 seconds, then dials itself.]"
					:font_size
					11
				)
				((:list 15)
					:shape
					:id
					38
					:m
					((:path 6)
						1.00000 0.00000 13.00000 0.00000 1.00000 300.00000
					)
					:kind
					:text
					:fill
					4284245616
					:stroke
					0
					:text
					"[2  Only one of a pair knows where the other is: it dials.]"
					:font_size
					11
				)
				((:list 15)
					:shape
					:id
					39
					:m
					((:path 6)
						1.00000 0.00000 13.00000 0.00000 1.00000 316.00000
					)
					:kind
					:text
					:fill
					4284245616
					:stroke
					0
					:text
					"[3  Every service tells every other who it has heard, a hello. So C, that hears no beacon, learns of A from B, and links to it.]"
					:font_size
					11
				)
				((:list 15)
					:shape
					:id
					40
					:m
					((:path 6)
						1.00000 0.00000 13.00000 0.00000 1.00000 332.00000
					)
					:kind
					:text
					:fill
					4284245616
					:stroke
					0
					:text
					"[4  A dial that brings no link is tried again after twice as long, 10 seconds, 20, 40, 80.]"
					:font_size
					11
				)
				((:list 15)
					:shape
					:id
					41
					:m
					((:path 6)
						1.00000 0.00000 13.00000 0.00000 1.00000 348.00000
					)
					:kind
					:text
					:fill
					4284245616
					:stroke
					0
					:text
					"[5  A peer not heard of for 30 seconds, by its beacon or in anyone's hello, is forgotten.]"
					:font_size
					11
				)
				((:list 15)
					:shape
					:id
					42
					:m
					((:path 6)
						1.00000 0.00000 13.00000 0.00000 1.00000 22.00000
					)
					:kind
					:text
					:fill
					4280296488
					:stroke
					0
					:text
					"[So each machine has one link to each other, and none is on the way between two.]"
					:font_size
					12
				)
			)
		)
	)
