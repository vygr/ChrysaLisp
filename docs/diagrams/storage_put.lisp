;docs/ai_digest/storage_service.md: a put, and the copies after it
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'cut (dia-box '("1. cut" "the object into blocks of 64KB") 230 44 grey 11 :first) 0 0)
(dia-put s 'blocks (dia-box '("2. the blocks" "to one member, those it has not") 230 44 gold 11 :first) 0 74)
(dia-put s 'manifest (dia-box '("3. the manifest" "the blocks' names, a block too") 230 44 gold 11 :first) 0 148)
(dia-put s 'commit (dia-box '("4. the path set" "if it is what the writer says it was") 230 44 green 11 :first) 0 222)
(dia-put s 'notes (dia-box '("5. notes compared" "the other members learn the path") 260 44 blue 11 :first) 330 74)
(dia-put s 'fetch (dia-box '("6. each fetches its share" "the blocks it is to keep") 260 44 blue 11 :first) 330 148)
(dia-put s 'drop (dia-box '("7. what is others' let go of" "once each of those has it") 260 44 blue 11 :first) 330 222)
(dia-join s 'cut 'blocks "")
(dia-join s 'blocks 'manifest "")
(dia-join s 'manifest 'commit "")
(dia-join s 'commit 'notes "the tender is kicked" :nil :elbow)
(dia-join s 'notes 'fetch "")
(dia-join s 'fetch 'drop "")
(dia-say s "The put is done at 4, at the one member. 5 to 7 are the tenders', by themselves:" 0 300 12 :nil 0xff202428)
(dia-say s "the tree, 2,014 files of 162MB, put in 3 s, every member has its copies 13 s after." 0 318 12 :nil 0xff202428)
(diagram "storage_put" (dia-scene-doc s))
