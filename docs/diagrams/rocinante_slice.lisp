;docs/ai_digest/rocinante.md: map! over three sequences takes a slice of all of them at each index
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(each (lambda (row name vals fill)
	(dia-put s :nil (dia-box name 150 30 grey 11 :t) 0 (* row 40))
	(each (lambda (v) (dia-put s (sym (cat "r" (str row) "c" (str (!)))) (dia-box v 70 30 fill 11) (+ 170 (* (!) 80)) (* row 40))) vals))
	'(0 1 2) '("{ABC}, a str" "(nums 10 20 30)" "(list :red :green :blue)")
	'(("A" "B" "C") ("10" "20" "30") (":red" ":green" ":blue")) (list blue blue blue))
(dia-under s (dia-box "" 86 122 gold) 242 -6)
(dia-say s "(!) is 1" 340 132 11 :t 0xff202428)
(dia-put s 'fn (dia-box '("the lambda, called with" "B  20  :green") 190 44 gold 11 :first) 190 160)
(dia-put s 'out (dia-box '("the result so far" "((A 10 :red) (B 20 :green)") 230 44 green 11 :first) 440 160)
(dia-join s 'r2c1 'fn "")
(dia-join s 'fn 'out "")
(dia-say s "(map! (lambda (name weight color) (list name weight color)) (list names weights colors))" 0 236 11 :t 0xff202428)
(dia-say s "The sequences are of three kinds and none is made into another. Each call gets the element of each at the index, as its arguments." 0 256 11)
(diagram "rocinante_slice" (dia-scene-doc s))
