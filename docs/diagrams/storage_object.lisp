;docs/ai_digest/storage_service.md: a path names a manifest, and a manifest names the blocks of an object
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'path (dia-box '("path" "docs/film.mp4") 150 44 blue 12 :first) 0 70)
(dia-put s 'man (dia-box '("manifest, a block too" "its length, and its blocks' names in order") 270 44 green 11 :first) 270 70)
(each (lambda (i)
		(dia-put s (sym (cat "b" (str i))) (dia-box (list (cat "block " (str (inc i))) "64KB, named by its SHA-256") 190 44 gold 11 :first)
			580 (* i 56)))
	'(0 1 2))
(dia-put s :nil (dia-box "... the last shorter" 190 30 grey 11) 580 174)
(dia-join s 'path 'man "the path map")
(each (# (dia-join s 'man (sym (cat "b" (str %0))) "")) '(0 1 2))
(dia-say s "A block never changes: a write makes new blocks and a new manifest, and the path is pointed at it." 0 236 12 :nil 0xff202428)
(dia-say s "Two blocks that are the same are kept once, and one gone bad does not match its name." 0 256 12 :nil 0xff202428)
(diagram "storage_object" (dia-scene-doc s))
