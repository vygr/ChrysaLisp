;docs/ai_digest/whiteboard.md: a board before and after an eraser that bites, made by the board itself
(import "lib/cwb/board.inc")
(defq wb-bite-doc (lambda ()
		;a box, a line, words, and a group that is turned
		(defq doc (cwb-doc 400 290))
		(cwb-add doc (cwb-shape (cwb-d-rect 50 40 250 140) :fill 0xffffd070 :stroke 0xff202428 :width 4))
		(cwb-add doc (cwb-shape (cwb-d "M" 20 190 "L" 380 210) :stroke 0xff3060c0 :width 6))
		(cwb-add doc (cwb-text {Hello board} 60 262 :font_size 30))
		(defq g (cwb-group (list
			(cwb-shape (cwb-d-ellipse 320 110 40 30) :fill 0xffff9090 :stroke 0xff202428 :width 3)
			(cwb-shape (cwb-d "M" 280 110 "L" 360 110) :stroke 0xff202428 :width 3))))
		(cwb-set g :m (Mat3x2-rot 0.5 320 110))
		(cwb-add doc g)
		doc)
	before (wb-bite-doc) after (wb-bite-doc) board (Board after)
	ways (list (list (path 150.0 10.0 150.0 230.0) 10.0) (list (path 30.0 250.0 390.0 70.0) 6.0) (list (path 100.0 90.0) 15.0))
	doc (cwb-doc 860 320))
(def board :rub_mode :bite)
(each (lambda ((way r)) (. board :bite way r)) ways)
(. doc :insert :style :plain)
;as it was, with where the eraser is to go, and as it is after
(defq left (cwb-group (cat (cwb-items before)
		(map (lambda ((way r)) (cwb-shape (join (map (# (cwb-d-points %0 :t))
			(poly-sweep (path-gen-arc 0.0 0.0 0.0 +fp_2pi r (path)) way)) " ") :stroke 0xffc03030 :width 1.0)) ways)))
	right (cwb-group (cwb-items after) :m (Mat3x2-translate 440 0)))
(cwb-add doc left)
(cwb-add doc right)
(cwb-add doc (cwb-text {three strokes of an eraser, in red, where they will go} 20 310 :font_size 12))
(cwb-add doc (cwb-text {and after them: (. board :bite points radius)} 460 310 :font_size 12))
(diagram "wb_bite" doc)
