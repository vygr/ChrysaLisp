;docs/ai_digest/trace_command.md: from the built functions to what each really trashes
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'obj (dia-box '("obj/vp/" "every function's VP, as it was built") 200 44 grey 11 :first) 0 0)
(dia-put s 'deps (dia-box '("get-dependencies" "what each calls: a static call by name," "a virtual call by every class that has it") 265 62 blue 11 :first) 225 -9)
(dia-put s 'sort (dia-box '("tsort" "leaves first, so what a function" "calls is known before it is") 215 62 blue 11 :first) 515 -9)
(dia-put s 'ana (dia-box '("analyze-function" "runs the instructions with names for values:" "copied, spilled to the stack and put back, changed") 300 62 gold 11 :first) 0 110)
(dia-put s 'prop (dia-box '("propagate-trashes" "what it trashes, and what" "all it calls trash") 215 62 gold 11 :first) 330 110)
(dia-put s 'lint (dia-box '("the lint, -l" "is that what its header says ?" "-w writes it there") 195 62 green 11 :first) 570 110)
(dia-join s 'obj 'deps "")
(dia-join s 'deps 'sort "")
(dia-join s 'sort 'prop "")
(dia-join s 'ana 'prop "")
(dia-join s 'prop 'lint "")
(dia-say s "A branch is two paths, each run to its end. Where paths meet at a label what each" 0 196 11)
(dia-say s "trashed is put together. A register saved and put back as it was is not trashed." 0 212 11)
(diagram "trace_flow" (dia-scene-doc s))
