;docs/ai_digest/case_for_pmap.md: a symbol remembers where it was last found, and that is tried first
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'sym (dia-box '("the symbol :paper" "str_hashslot: 4") 180 44 gold 11 :first) 421 90)
(each (lambda (i)
	(dia-put s (sym (cat "c" (str i))) (dia-box (elem-get '(":font" "a font" ":border" "1" ":paper" "0xff..." ":min_width" "32") i) 74 30 (if (= 0 (logand i 1)) blue grey) 11) (+ 160 (* i 74)) 0)
	(dia-say s (str i) (+ 194 (* i 74)) 48 10))
	'(0 1 2 3 4 5 6 7))
(dia-say s "a :pmap, one flat list: key, value, key, value" 160 -12 11 :t 0xff202428)
(dia-join s 'sym 'c4 "")
(dia-say s "1  go to place 4. Is the key there this symbol ? Yes: its value is the next. No search." 0 166 11)
(dia-say s "2  No, it was last found in some other map: search this one from the start, and" 0 186 11)
(dia-say s "    write where it was found into the symbol. The next time it is step 1." 0 202 11)
(dia-say s "3  A key that is not a symbol or a string is held to each key by :eql." 0 222 11)
(diagram "pmap_slot" (dia-scene-doc s))
