;docs/ai_digest/memory_architecture.md: from the host's memory to the cell an object is in
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'mem (dia-box '(":sys_mem :alloc" "adds a header, picks the heap" "of the smallest cell that fits") 190 62 gold 11 :first) 0 60)
(each (lambda (i)
	(dia-put s (sym (cat "h" (str i))) (dia-box (list ":sys_heap" (elem-get '("cells of 24 bytes" "cells of 48 bytes" "cells of 96 bytes" "... doubling, to 96MB") i)) 170 40 blue 11 :first) 250 (* i 48))
	(dia-join s 'mem (sym (cat "h" (str i))) ""))
	'(0 1 2 3))
(dia-put s 'block (dia-box '("hp_block" "one piece from the host" ":host_os :pii_mmap") 170 62 grey 11 :first) 480 24)
(each (# (dia-put s (if (= %0 0) 'cell :nil) (dia-box "cell" 40 30 (if (= %0 2) gold green) 11) (+ 480 (* %0 43)) 114)) '(0 1 2 3))
(dia-say s "carved into cells, the free ones on a list" 480 164 11)
(dia-join s 'h1 'block "")
(dia-say s "when it has no cell free" 480 12 11)
(dia-put s 'obj (dia-box '("sys_mem_header" "its heap") 130 40 grey 11 :first) 0 200)
(dia-put s :nil (dia-box '("vtable" "pptr") 80 40 blue 11 :first) 130 200)
(dia-put s :nil (dia-box '("count" "uint") 80 40 blue 11 :first) 210 200)
(dia-put s :nil (dia-box '("the fields of its class" "and of each class it comes of") 230 40 green 11 :first) 290 200)
(dia-say s "A cell that holds an object. :free finds the heap by the header, :deref frees it when the count is 0." 0 262 11)
(diagram "memory_heaps" (dia-scene-doc s))
