;docs/ai_digest/services.md: two copies of a service that is to be one, started at once, and how one gives way
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'start (dia-box '("two start at once" "each found none listed") 190 44 grey 11 :first) 0 0)
(dia-put s 'a (dia-box '("copy A declares @Source" "the lower mailbox") 210 44 green 11 :first) 250 -40)
(dia-put s 'b (dia-box '("copy B declares @Source" "the higher mailbox") 210 44 gold 11 :first) 250 40)
(dia-put s 'wake (dia-box '("B wakes, a task asks or a second" "goes by: (mail-single) says A") 250 44 gold 11 :first) 520 40)
(dia-put s 'forget (dia-box '("B forgets its name" "the list shows A alone") 210 44 gold 11 :first) 520 130)
(dia-put s 'late (dia-box '("a task sent to B before" "the names had come to it") 210 44 blue 11 :first) 250 210)
(dia-put s 'on (dia-box '("B sends it on to A," "the reply goes to the task") 210 44 gold 11 :first) 520 210)
(dia-put s 'end (dia-box '("B goes when nothing" "has come for 10 seconds") 210 44 grey 11 :first) 520 290)
(dia-put s 'new (dia-box '("every task that sees both" "picks A, (mail-lowest)") 210 44 blue 11 :first) 250 130)
(dia-join s 'start 'a "")
(dia-join s 'start 'b "")
(dia-join s 'b 'wake "")
(dia-join s 'wake 'forget "")
(dia-join s 'late 'on "")
(dia-join s 'on 'end "")
(dia-say s "Each copy works out which stays from the list alone, so they agree with no word between them." 0 360 11)
(dia-say s "A request is answered once, by A, whichever copy it was sent to." 0 376 11)
(diagram "service_give_way" (dia-scene-doc s))
