;docs/ai_digest/mesh_net.md: which services are a machine's own, an @ name, and which are seen from every machine of the mesh, a * name
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 dark 0xff202428)
(each (lambda (i)
	(defq x (* i 480))
	(dia-under s (dia-box "" 310 250 grey) x 0)
	(dia-say s (elem-get '("one machine" "another machine") i) (+ x 12) 20 12 :t dark)
	(each (lambda (j)
		(dia-put s :nil (dia-box (elem-get '(("@Net" "links, the key, the mesh") ("@Lock" "who may write a file") ("@Clipboard" "what was copied") ("@Audio" "sounds")) j)
			138 40 blue 11 :first) (+ x 12 (* (% j 2) 148)) (+ 34 (* (/ j 2) 48))))
		'(0 1 2 3))
	(dia-put s (sym (cat "mesh" (str i))) (dia-box '("*Mesh" "a Net service" "that makes the mesh") 138 54 gold 11 :first) (+ x 12) 150)
	(dia-put s (sym (cat "sync" (str i))) (dia-box '("*Sync" "takes a tree, if asked," "sync -a") 138 54 gold 11 :first) (+ x 160) 150))
	'(0 1))
(dia-join s 'sync0 'mesh1 "seen from each other" :both)
(dia-say s "An @ name is found only by tasks of the machine it is on: each machine has its own, and they do not meet." 0 272 11)
(dia-say s "A * name is told to every machine that is linked: (mail-enquire) on any of them finds them all." 0 288 11)
(dia-say s "The Net services use *Mesh to find each other for the hello. A sync finds every *Sync and sends each the tree." 0 304 11)
(diagram "services_scope" (dia-scene-doc s))
