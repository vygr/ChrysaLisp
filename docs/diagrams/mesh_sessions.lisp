;docs/intro/mesh.md and docs/ai_digest/mesh_net.md: the sessions of one machine, and which of them is its member of the mesh
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 dark 0xff202428)
(dia-under s (dia-box "" 330 330 grey) 0 0)
(dia-say s "one machine, one mesh_key" 12 20 12 :t dark)
(dia-put s 'first (dia-box '("a desktop, the first to start" "has port 3333: the member") 300 44 gold 11 :first) 15 36)
(dia-put s 'second (dia-box '("a terminal, started after it" "not the member, asks every 10 seconds") 300 44 blue 11 :first) 15 108)
(dia-put s 'alone (dia-box '("a run of the tests, started with -a" "keeps to itself, does not ask") 300 44 green 11 :first) 15 180)
(dia-put s 'subnet (dia-box '("a subnet, a system of its own, nodes -o" "has no key: off the network") 300 44 grey 11 :first) 15 252)
(dia-join s 'first 'second "when it goes, this one has the port" )
(dia-put s 'm1 (dia-box '("another machine" "the same mesh_key") 170 44 blue 11 :first) 470 10)
(dia-put s 'm2 (dia-box '("and another" "the same mesh_key") 170 44 blue 11 :first) 470 68)
(dia-join s 'first 'm1 "" :both)
(dia-join s 'first 'm2 "" :both)
(dia-put s 'm3 (dia-box '("a machine with another key" "or with none") 170 44 grey 11 :first) 470 180)
(dia-say s "does not link, to any of them" 470 244 11)
(dia-say s "The subnet is reached from the session that started it, by the one link between them, and from nowhere else." 0 352 11)
(diagram "mesh_sessions" (dia-scene-doc s))
