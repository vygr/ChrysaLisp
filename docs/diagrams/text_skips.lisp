;docs/ai_digest/text_parsing.md: where each skip of a space class stops in a string, on and back
(defq s (dia-scene) blue 0xffd7e6f7 grey 0xffd6dade dark 0xff202428)
(defun skip-post (i) (+ 100 (* i 50)))
(defun skip-arrow (a b y name)
	;an arrow from post a to post b at a height, its name over it
	(defq x (skip-post a) x1 (skip-post b) d (if (< a b) 3 -3))
	(push (first s) (dia-arrow (+ x d) y (- x1 d) y))
	(dia-say s name (+ (n2f (min x x1)) (* 0.5 (n2f (abs (- x1 x)))) (* -0.5 (dia-width name 11 :t))) (- y 8) 11 :t dark))
(dia-say s "on" 0 36 11)
(dia-say s "back" 0 130 11)
(each (lambda (i)
	(defq x (skip-post i) c (elem-get "  let x  " i))
	(dia-put s :nil (dia-box (if (eql c " ") "" c) 50 40 (if (eql c " ") grey blue) 14 :t) x 60)
	(dia-say s (str i) (- x 4) 56 11 :t dark))
	'(0 1 2 3 4 5 6 7 8))
(dia-say s "9" (- (skip-post 9) 4) 56 11 :t dark)
(each (lambda (i)
		(push (first s) (cwb-shape (cwb-d-line (skip-post i) 42 (skip-post i) 106) :stroke 0xff9aa4ae :width 1.0 :cap1 :butt :cap2 :butt)))
	'(0 2 5 6 7 9))
(skip-arrow 0 2 32 "bskip")
(skip-arrow 2 5 32 "bskipn")
(skip-arrow 5 6 32 "bskip")
(skip-arrow 9 7 124 "rbskip")
(skip-arrow 7 6 124 "rbskipn")
(dia-say s {The class is (char-class " "), the grey cells. Each skip gives a post, the gap between two characters,} 0 164 11)
(dia-say s {so (slice str 2 5) is "let", and (slice str 0 (rbskip cls str -1)) has the end's spaces trimmed.} 0 180 11)
(diagram "text_skips" (dia-scene-doc s))
