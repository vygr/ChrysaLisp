;docs/lisp/numerics.md: the arrays, what each is built on for what it is, and whose storage it has for its width
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'seq (dia-box '(":seq" "a sequence") 150 44 grey 11 :first) 230 0)
(dia-put s 'array (dia-box '(":array" "the base of storage," "never made itself") 150 62 grey 11 :first) 230 84)
(dia-put s 'list (dia-box '(":list" "counted references," "8 bytes") 150 62 blue 11 :first) 0 190)
(dia-put s 'nums (dia-box '(":nums" "64 bit integers," "the maths") 150 62 gold 11 :first) 230 190)
(dia-put s 'fixeds (dia-box '(":fixeds" "48.16 fixed point") 150 44 gold 11 :first) 230 290)
(dia-put s 'path (dia-box '(":path" "points, x y") 150 44 gold 11 :first) 0 290)
(dia-put s 'doubles (dia-box '(":doubles" "64 bit doubles") 150 44 gold 11 :first) 230 374)
(dia-put s 'floats (dia-box '(":floats" "32 bit floats,") 150 44 gold 11 :first) 230 458)
(dia-put s 'bytes (dia-box '(":bytes" "raw, 1 byte") 150 44 green 11 :first) 470 190)
(dia-put s 'shorts (dia-box '(":shorts" "raw, 2 bytes") 150 44 green 11 :first) 470 290)
(dia-put s 'ints (dia-box '(":ints" "raw, 4 bytes") 150 44 green 11 :first) 470 374)
(dia-join s 'array 'seq "")
(dia-join s 'list 'array "" :nil :elbow)
(dia-join s 'nums 'array "")
(dia-join s 'fixeds 'nums "")
(dia-join s 'path 'fixeds "")
(dia-join s 'doubles 'fixeds "")
(dia-join s 'floats 'doubles "")
(dia-join s 'bytes 'array "" :nil :elbow)
(dia-join s 'shorts 'array "" :nil :elbow)
(dia-join s 'ints 'array "" :nil :elbow)
(dia-join s 'floats 'ints "storage of" :nil :elbow)
(dia-say s "Each comes of the one above it, for what it is: the gold the numbers with the maths, the green raw" 0 530 11)
(dia-say s "storage of bits, an element read back as a :num, never sign extended. Storage is made by width from one" 0 546 11)
(dia-say s "source in class/array, so :floats, of :doubles for its maths, has the :ints' storage, the same code," 0 562 11)
(dia-say s "4 bytes an element." 0 578 11)
(diagram "array_kinds" (dia-scene-doc s))
