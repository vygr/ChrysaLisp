;docs/apps/template.md: the files of the Template app and an event's way round them
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'gui (dia-box '("the GUI" "mouse, keys, draws") 140 48 grey 11 :first) 0 70)
(dia-put s 'app (dia-box '("app.lisp" "main: the loop, *running*") 190 48 gold 11 :first) 190 70)
(dia-put s 'actions (dia-box '("actions.inc" "*event_map*, the *key_map*s") 190 48 blue 11 :first) 430 70)
(dia-put s 'ui (dia-box '("ui.inc" "the action- functions") 190 48 blue 11 :first) 430 180)
(dia-put s 'widgets (dia-box '("widgets.inc" "*window*, its bars, its views") 190 48 green 11 :first) 190 180)
(dia-put s 'helpers (dia-box '("utils.inc, undo.inc" "clipboard.inc") 150 48 grey 11 :first) 660 70)
(dia-join s 'gui 'app "an event")
(dia-join s 'app 'actions "its id")
(dia-join s 'actions 'ui "calls")
(dia-join s 'ui 'widgets "changes")
(dia-join s 'widgets 'gui "drawn")
(dia-join s 'actions 'helpers "imports")
(dia-say s "The model is what app.lisp keeps; the view is widgets.inc; the controller is actions.inc and ui.inc." 0 262 11)
(diagram "template_files" (dia-scene-doc s))
