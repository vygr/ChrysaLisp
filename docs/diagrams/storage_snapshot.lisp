;docs/ai_digest/storage_service.md: a snapshot is paths, set to the objects the paths are now
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'p1 (dia-box "docs/a.md" 190 34 blue 11) 0 0)
(dia-put s 'p2 (dia-box "docs/b.md" 190 34 blue 11) 0 60)
(dia-put s 's1 (dia-box "snapshots/monday/docs/a.md" 230 34 blue 11) 0 150)
(dia-put s 's2 (dia-box "snapshots/monday/docs/b.md" 230 34 blue 11) 0 210)
(dia-put s 'm1 (dia-box '("manifest" "of a.md as it was on Monday") 220 44 green 11 :first) 340 40)
(dia-put s 'm2 (dia-box '("manifest" "of b.md") 220 44 green 11 :first) 340 140)
(dia-join s 'p2 'm2 "")
(dia-join s 's1 'm1 "")
(dia-join s 's2 'm2 "")
(dia-put s 'm3 (dia-box '("manifest" "of a.md, written since") 220 44 green 11 :first) 340 -50)
(dia-join s 'p1 'm3 "")
(dia-say s "No block is copied: the snapshot's paths are set to the same manifests, so every member keeps, shares" 0 290 12 :nil 0xff202428)
(dia-say s "and sweeps round them as round any path. Restore sets the paths back to what the snapshot's are." 0 308 12 :nil 0xff202428)
(diagram "storage_snapshot" (dia-scene-doc s))
