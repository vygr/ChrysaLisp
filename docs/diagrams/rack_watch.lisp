;docs/ai_digest/rack.md: a session of a run, and what keeps it to its asker
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7 dark 0xff202428)
(dia-put s 'ask (dia-box '("rack -v, where it was asked" "prints the lines as they come") 210 44 blue 11) 0 0)
(dia-put s 'fr (dia-box '("rack-fresh, on that machine" "waits for the session") 210 44 blue 11) 0 90)
(dia-join s 'fr 'ask "LINE ... as they come")
(dia-put s 'se (dia-box '("the session, a process of its own" "runs the commands, writes as it goes") 250 44 green 11) 330 90)
(dia-join s 'fr 'se "starts")
(dia-put s 'al (dia-box '("the time, each second" "/tmp/chrysalisp_rack_alive_<run>") 230 44 gold 11) 0 180)
(dia-join s 'fr 'al "writes")
(dia-put s 'wa (dia-box '("its watch: the time 15s old," "the session, its nodes and files, gone") 250 44 red 11) 330 180)
(dia-join s 'wa 'al "reads" :none)
(dia-say s "rack-fresh stops writing when the asker's node has left the mesh, or it is stopped itself, so a session no one waits for" 0 246 11)
(dia-say s "stops itself, a hidden desktop too." 0 262 11)
(diagram "rack_watch" (dia-scene-doc s))
