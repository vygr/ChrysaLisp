;docs/ai_digest/mesh_net.md: a packet on a sealed link
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 red 0xfff7d7d7 dark 0xff202428)
(dia-say s "plain, on the LAN" 0 14 12 :t dark)
(dia-put s 'ph (dia-box '("wire header" "8 bytes") 110 44 blue 11) 0 30)
(dia-put s 'pp (dia-box '("ping or fragment, and its data" "as the wire header says") 260 44 blue 11) 110 30)
(dia-say s "sealed, over the internet" 0 104 12 :t dark)
(dia-put s 'sl (dia-box '("length" "8 bytes, clear") 90 44 grey 11) 0 120)
(dia-put s 'sc (dia-box '("the same packet, wire header and all," "encrypted, ChaCha20") 280 44 gold 11) 90 120)
(dia-put s 'st (dia-box '("tag" "16 bytes") 90 44 red 11) 370 120)
(dia-put s 'n (dia-box '("nonce: the count of records" "this way, from 0") 200 44 green 11) 500 120)
(dia-join s 'n 'st "")
(dia-say s "Poly1305 over what is encrypted gives the tag, RFC 8439 with no aad, a key each way. A record that does not open," 0 190 11)
(dia-say s "changed, sent again or out of its order, drops the link, and the mesh dials again." 0 206 11)
(diagram "sealed_record" (dia-scene-doc s))
