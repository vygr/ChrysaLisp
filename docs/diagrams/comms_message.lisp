;docs/gui/comms.md: a big message goes as packets, by several routes, and is one message again when it arrives
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'sender (dia-box '("sending task" ":sys_mail :send") 130 50 blue 12 :first) 0 70)
(dia-put s 'whole (dia-box '("message" "header + body, a String") 150 50 gold 11 :first) 0 0)
(dia-say s "a big one is cut into packets" 168 30 11)
(each (# (dia-put s (sym (cat "p" (str %0))) (dia-box (cat "packet " (str (inc %0))) 76 26 gold 11) 190 (+ 50 (* %0 34)))) '(0 1 2))
(each (# (dia-put s (sym (cat "n" (str %0))) (dia-box "node" 60 26 grey 11) 330 (+ 30 (* %0 54)))) '(0 1 2))
(dia-say s "routes in parallel," 312 196 11)
(dia-say s "in no promised order" 308 212 11)
(dia-put s 'build (dia-box '("put together" "at the node it is for") 140 50 green 11 :first) 450 64)
(dia-put s 'mbox (dia-box '("mailbox" "mailbox_id") 110 50 0xffffffff 12 :first) 640 64)
(dia-put s 'reader (dia-box '("receiving task" ":sys_mail :read") 130 50 blue 12 :first) 630 150)
(dia-join s 'sender 'p1 "")
(each (# (dia-join s (sym (cat "p" (str %0))) (sym (cat "n" (str %0))) "")) '(0 1 2))
(each (# (dia-join s (sym (cat "n" (str %0))) 'build "")) '(0 1 2))
(dia-join s 'build 'mbox "whole")
(dia-join s 'mbox 'reader "")
(dia-say s "The receiver sees the whole message or nothing, never a part of one." 0 250 12 :nil 0xff202428)
(diagram "comms_message" (dia-scene-doc s))
