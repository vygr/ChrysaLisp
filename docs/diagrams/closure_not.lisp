;docs/ai_digest/closure_or_not.md: a lambda holds no environment, an object holds what it is given
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-say s "a closure, as other Lisps have" 0 -14 12 :t 0xff202428)
(dia-put s 'fn1 (dia-box '("a function" "code, and a pointer to") 180 44 grey 11 :first) 0 0)
(dia-put s 'env1 (dia-box '("the environment it was made in" "x: 5, and all else that was there," "kept for as long as the function is") 250 62 grey 11 :first) 240 -9)
(dia-join s 'fn1 'env1 "")
(dia-say s "ChrysaLisp" 0 100 12 :t 0xff202428)
(dia-put s 'fn2 (dia-box '("a lambda" "a list: its arguments and its body") 230 44 blue 11 :first) 0 114)
(dia-put s 'lisp (dia-box '("the interpreter" "has the environment that is current," "when the lambda is called, not when made") 280 62 blue 11 :first) 290 105)
(dia-join s 'lisp 'fn2 "runs")
(dia-put s 'obj (dia-box '("(Adder 5), an object" ":x 5, what it was given and no more") 250 44 gold 11 :first) 0 204)
(dia-put s 'cls (dia-box '("the class Adder" "its methods, each given the object") 250 44 gold 11 :first) 320 204)
(dia-join s 'obj 'cls "")
(dia-say s "State that has to last is put in an object, by name. The environment it was made in goes when the call that made it returns." 0 276 11)
(diagram "closure_not" (dia-scene-doc s))
