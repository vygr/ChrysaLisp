;docs/lisp/numerics.md: the ladder of the four kinds of number and what converts between them
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(dia-put s 'num (dia-box '(":num" "64 bit signed integer" "read from 42, 0xff, 0b101") 200 62 blue 11 :first) 0 0)
(dia-put s 'fixed (dia-box '(":fixed" "48.16 fixed point" "read from 1.5") 200 62 gold 11 :first) 0 110)
(dia-put s 'double (dia-box '(":double" "64 bit IEEE double" "made by (n2d), +double_pi ...") 200 62 green 11 :first) 0 220)
(dia-put s 'float (dia-box '(":float" "32 bit IEEE single" "made by (n2f)") 200 62 grey 11 :first) 0 330)
(dia-join s 'fixed 'num "comes of")
(dia-join s 'double 'fixed "comes of")
(dia-join s 'float 'double "comes of")
(dia-say s "(n2i x) to here, the integers" 240 24 11)
(dia-say s "(n2q x) to here, adds the fractions drawing works in" 240 134 11)
(dia-say s "(n2d x) to here, adds the real numbers, exp, log, tanh" 240 244 11)
(dia-say s "(n2f x) to here, what a double does, at 32 bits" 240 354 11)
(dia-say s "Each does what the one it comes of does. All four keep their value in the one field, num_value." 0 420 11)
(dia-say s "Each of n2i, n2q, n2d, n2f takes any of the four, and gives back what it is given if that is" 0 436 11)
(dia-say s "exactly of its kind. Going to a fixed or an integer the fraction is cut off, it is not rounded." 0 452 11)
(diagram "numeric_types" (dia-scene-doc s))
