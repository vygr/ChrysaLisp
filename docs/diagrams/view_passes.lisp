;docs/ai_digest/gui_views.md: the two passes of layout over a tree of views
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6)
(each (lambda (ox title fill)
	(dia-say s title ox -30 12 :t 0xff202428)
	(dia-put s (sym (cat "w" (str ox))) (dia-box "Window" 90 30 fill 11 :t) (+ ox 75) 0)
	(dia-put s (sym (cat "f" (str ox))) (dia-box "Flow" 90 30 fill 11 :t) (+ ox 75) 70)
	(dia-put s (sym (cat "a" (str ox))) (dia-box "Label" 70 30 fill 11) ox 140)
	(dia-put s (sym (cat "b" (str ox))) (dia-box "Button" 70 30 fill 11) (+ ox 85) 140)
	(dia-put s (sym (cat "c" (str ox))) (dia-box "Button" 70 30 fill 11) (+ ox 170) 140))
	'(0 330) '("sizing: :pref_size, :constraints" "layout: :change, :constrain") (list gold green))
(each (# (dia-join s %0 'f0 "")) '(a0 b0 c0))
(dia-join s 'f0 'w0 "")
(dia-join s 'w330 'f330 "")
(each (# (dia-join s 'f330 %0 "")) '(a330 b330 c330))
(dia-say s "children before parents: each :constraint works" 0 190 11)
(dia-say s "out the size it would like from its children's," 0 206 11)
(dia-say s "and :set_constraint keeps it. Sizes go up." 0 222 11)
(dia-say s "parents before children: each :layout shares its" 330 190 11)
(dia-say s "space among its children and calls :set_bounds" 330 206 11)
(dia-say s "on each. Space comes down." 330 222 11)
(dia-say s "Both go over one list, the tree flattened by :flatten: forward for sizing, backward for layout. :constrain does the first, then the second." 0 256 11)
(diagram "view_passes" (dia-scene-doc s))
