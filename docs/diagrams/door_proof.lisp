;docs/ai_digest/mesh_net.md: what two ends of a connection say to prove each has the key
(defq s (dia-scene) blue 0xffd7e6f7 green 0xffdff0d8 gold 0xffffe8a8 grey 0xfff2f4f6 dark 0xff202428)
(dia-say s "the end that dialled" 0 14 12 :t dark)
(dia-say s "the end that listened" 470 14 12 :t dark)
(each (lambda ((y left right label way))
	(dia-put s (sym (cat "l" (str y))) (dia-box left 190 44 (if (eql way :check) gold blue) 11) 0 y)
	(dia-put s (sym (cat "r" (str y))) (dia-box right 190 44 (if (eql way :check) gold blue) 11) 470 y)
	(case way
		(:right (dia-join s (sym (cat "l" (str y))) (sym (cat "r" (str y))) label))
		(:left (dia-join s (sym (cat "r" (str y))) (sym (cat "l" (str y))) label))
		(:both (dia-join s (sym (cat "l" (str y))) (sym (cat "r" (str y))) label :both))
		(:t (dia-join s (sym (cat "l" (str y))) (sym (cat "r" (str y))) label :none))))
	'((26 ("makes up a nonce and an" "X25519 share, new each time") ("makes up a nonce and an" "X25519 share, new each time") "CLDOOR3, version, nonce, share, seal?" :both)
	(92 ("HMAC-SHA256 under the key of" "D and all that was said") ("checks it" "with its own copy of the key") "32 bytes" :right)
	(158 ("checks it" "with its own copy of the key") ("HMAC-SHA256 under the key of" "L and all that was said") "32 bytes" :left)
	(224 ("both right: a link" "wrong, or too slow: closed") ("both right: a link" "wrong, or too slow: closed") "5 seconds for all of it" :check)))
(dia-say s "The key is never sent. The nonces are new every time, so an answer heard once is no use again." 0 292 11)
(dia-say s "The two ends say different things, D and L, so one's answer is no use sent back to it." 0 308 11)
(dia-say s "Dialled outside the private addresses, the link is sealed: keys each way from the shares and the key." 0 324 11)
(dia-say s "On the LAN it is not, and costs nothing more. The seal byte is the dialler's, and in the proof." 0 340 11)
(diagram "door_proof" (dia-scene-doc s))
