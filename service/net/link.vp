(include "lib/asm/func.inc")
(include "sys/link/class.inc")
(include "sys/kernel/class.inc")
(include "class/nodeid/class.inc")
(include "class/array/class.inc")
(include "./class.inc")

(def-method :host_net :send_all)
	;inputs
	;:r0 = handle
	;:r1 = buffer ptr
	;:r2 = remaining bytes
	;outputs
	;:r0 = 0 if ok, -1 if error
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(ptr buf)
		(long handle remaining))

	(push-scope)
	(entry :host_net :send_all '(:r0 :r1 :r2))
	(gotoif '(:r2 <= 0) 'send_done)
	(assign '(:r0 :r1 :r2) {handle, buf, remaining})

(vp-label 'send_loop)
	(host-net-call :host_net :send {handle, buf, remaining} '(:r0))
	(vpif '(:r0 < 0))
		(assign '(-1) '(:r0))
		(goto 'send_exit)
	(endif)
	(vpif '(:r0 = 0))
		;socket send buffer full, sleep 100 µs
		(call :sys_task :sleep '(100))
		(goto 'send_loop)
	(endif)

	(vp-rdef (sent buf remaining))
	(assign {buf, remaining} `(,buf ,remaining))
	(vp-add-rr sent buf)
	(vp-sub-rr sent remaining)
	(assign `(,buf ,remaining) {buf, remaining})
	(gotoif `(,remaining > 0) 'send_loop)

(vp-label 'send_done)
	(assign '(0) '(:r0))

(vp-label 'send_exit)
	(exit :host_net :send_all '(:r0))
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_net :recv_all)
	;inputs
	;:r0 = handle
	;:r1 = buffer ptr
	;:r2 = remaining bytes
	;:r3 = lk_node ptr
	;outputs
	;:r0 = 0 if ok, -1 if error
	;trashes
	;:r0-:r14, :f0-:f15

	(structure cb_recv 0
		(ptr buf)
		(long handle remaining recvd))

	(def-vars
		(struct cb cb_recv_size)
		(ptr lk_node)
		(long sleep_time))

	(vp-rdef (cb func) (method-input :sys_task :callback))

	(push-scope)
	(entry :host_net :recv_all {cb.cb_recv_handle, cb.cb_recv_buf, cb.cb_recv_remaining, lk_node})
	(assign {100} {sleep_time})

(vp-label 'recv_loop)
	(assign {cb.cb_recv_remaining} '(:r2))
	(gotoif '(:r2 <= 0) 'recv_done)

	(assign {&cb} `(,cb))
	(call :sys_task :callback `(,cb ($ recv_callback)))

	(assign {cb.cb_recv_recvd} '(:r0))
	(gotoif '(:r0 < 0) 'recv_error)

	(vpif '(:r0 = 0))
		;check if link was closed while sleeping
		(assign {lk_node} '(:r1))
		(assign '((:r1 lk_node_task_count i)) '(:r2))
		(gotoif '(:r2 = -1) 'recv_error)

		;no data waiting, sleep with exponential backoff up to 2ms
		(call :sys_task :sleep {sleep_time})
		(assign {sleep_time} '(:r0))
		(vp-shl-cr 1 :r0)
		(vp-min-cr 2000 :r0)
		(assign '(:r0) {sleep_time})
		(goto 'recv_loop)
	(endif)

	;got data: reset sleep time to 100
	(assign '(100) '(:r1))
	(assign '(:r1) {sleep_time})

	;update buf and remaining with bytes received (:r0 = recvd)
	(assign {&cb} '(:r3))
	(assign '((:r3 cb_recv_buf) (:r3 cb_recv_remaining)) '(:r1 :r2))
	(vp-add-rr :r0 :r1)
	(vp-sub-rr :r0 :r2)
	(assign '(:r1 :r2) '((:r3 cb_recv_buf) (:r3 cb_recv_remaining)))
	(goto 'recv_loop)

(vp-label 'recv_done)
	(assign '(0) '(:r0))
	(goto 'recv_exit)

(vp-label 'recv_error)
	(assign '(-1) '(:r0))

(vp-label 'recv_exit)
	(exit :host_net :recv_all '(:r0))
	(pop-scope)
	(return)

(vp-label 'recv_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :recv
		'((:r0 cb_recv_handle) (:r0 cb_recv_buf) (:r0 cb_recv_remaining)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_recv_recvd)))
	(vp-ret)

(def-func-end)

(def-method :host_net :link)
	;started by kernel for each network link
	;trashes
	;:r0-:r14, :f0-:f15

	(structure cb_link 0
		(pubyte host)
		(long port handle))

	(def-vars
		(struct cb cb_link_size)
		(ptr params pdata msg data)
		(long listen_handle conn_handle port is_server retries))

	(vp-rdef (cb func tmp) (method-input :sys_task :callback))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))
	(vp-rdef (parse_port parse_server parse_ch) '(:r2 :r3 :r4))
	(vp-rdef (parse_scan) '(:r0))
	(vp-rdef (poll_res) (method-output :host_net :poll))

	(push-scope)

	;read params msg from kernel
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `(,params_msg ,params_data) {params, pdata})

	;default port = 3333, is_server = 0
	(vp-simd vp-cpy-cr '(3333 0) `(,parse_port ,parse_server))

	;check first char
	(vp-cpy-ir-ub params_data 0 parse_ch)
	(vpif `(,parse_ch = 58)) ; ':' -> listen mode
		(vp-cpy-cr 1 parse_server) ; is_server = 1
		(vp-add-cr 1 params_data) ; p++
		(vp-cpy-ir-ub params_data 0 parse_ch)
		(vpif `(,parse_ch >= 48) `(,parse_ch <= 57))
			(vp-cpy-cr 0 parse_port) ; port = 0
		(vp-label 'parse_server_port)
			(vp-sub-cr 48 parse_ch)
			(vp-mul-cr 10 parse_port)
			(vp-add-rr parse_ch parse_port)
			(vp-add-cr 1 params_data)
			(vp-cpy-ir-ub params_data 0 parse_ch)
			(gotoif `(,parse_ch < 48) 'parse_done)
			(gotoif `(,parse_ch <= 57) 'parse_server_port)
		(endif)
		(goto 'parse_done)
	(endif)

	;connect mode: scan for ':'
	(vp-cpy-rr params_data parse_scan) ; scan pointer
(vp-label 'scan_loop)
	(vp-cpy-ir-ub parse_scan 0 parse_ch)
	(gotoif `(,parse_ch = 0) 'parse_done)
	(vpif `(,parse_ch = 58)) ; ':'
		(vp-cpy-cr 0 parse_ch)
		(vp-cpy-ri-b parse_ch parse_scan 0) ; null-terminate host string at ':'
		(vp-add-cr 1 parse_scan)
		(vp-cpy-ir-ub parse_scan 0 parse_ch)
		(vpif `(,parse_ch >= 48) `(,parse_ch <= 57))
			(vp-cpy-cr 0 parse_port) ; port = 0
		(vp-label 'parse_client_port)
			(vp-sub-cr 48 parse_ch)
			(vp-mul-cr 10 parse_port)
			(vp-add-rr parse_ch parse_port)
			(vp-add-cr 1 parse_scan)
			(vp-cpy-ir-ub parse_scan 0 parse_ch)
			(gotoif `(,parse_ch < 48) 'parse_done)
			(gotoif `(,parse_ch <= 57) 'parse_client_port)
		(endif)
		(goto 'parse_done)
	(endif)
	(vp-add-cr 1 parse_scan)
	(goto 'scan_loop)

(vp-label 'parse_done)
	(assign `(,parse_port ,parse_server) {port, is_server})

	(vpif {is_server /= 0})
		;server mode
		;decrement task count for listener
		(call :sys_task :count '(-1))

		;listen on port
		(assign {&cb, port} `(,cb ,func))
		(assign `(,func) `((,cb cb_link_port)))
		(call :sys_task :callback `(,cb ($ listen_callback)))
		(assign {cb.cb_link_handle} {listen_handle})
		(gotoif {listen_handle <= 0} 'link_server_exit)

		;persistent accept loop
	(vp-label 'accept_loop)
		(assign {&cb, listen_handle} `(,cb ,func))
		(assign `(,func) `((,cb cb_link_handle)))
		(call :sys_task :callback `(,cb ($ accept_callback)))
		(assign {cb.cb_link_handle} {conn_handle})
		(vpif {conn_handle > 0})
			;spawn connection worker task
			(assign {conn_handle} '(:r0))
			(call :sys_mail :alloc '(16) {msg, data})
			(call :sys_task :start (cat {@} (f-path :host_net :conn)) '(_ _ :r2 :r3 :r4))
			(assign {msg, data, conn_handle} '(:r0 :r1 :r5))
			(save-net-id :r0 +msg_dest :r2 :r3 :r4)
			(assign '(:r5) '((:r1 0)))
			(call :sys_mail :send '(:r0))
		(endif)
		(call :sys_task :sleep '(10000)) ; 10ms
		(goto 'accept_loop)

		;close listening socket
		(host-net-call :host_net :close {listen_handle})
	(vp-label 'link_server_exit)
		(call :sys_task :count '(1))
	(else)
		;client mode: connect to host:port
		(assign {&cb, pdata, port} `(,cb ,func ,tmp))
		(assign `(,func ,tmp) `((,cb cb_link_host) (,cb cb_link_port)))
		(call :sys_task :callback `(,cb ($ connect_callback)))
		(assign {cb.cb_link_handle} {conn_handle})
		(gotoif {conn_handle <= 0} 'link_exit)

		;wait for connect to complete
		(assign {0} {retries})
	(vp-label 'poll_loop)
		(host-net-call :host_net :poll {conn_handle} `(,poll_res))
		;bit 1 (POLLOUT) = connected
		(vp-cpy-rr poll_res tmp)
		(vp-and-cr 2 tmp)
		(gotoif `(,tmp /= 0) 'poll_connected)
		;bit 2 (POLLERR) = error
		(vp-cpy-rr poll_res tmp)
		(vp-and-cr 4 tmp)
		(vpif `(,tmp /= 0))
			(host-net-call :host_net :close {conn_handle})
			(goto 'link_exit)
		(endif)
		(assign {retries} '(:r6))
		(vp-add-cr 1 :r6)
		(vpif '(:r6 > 500)) ; 5s timeout
			(host-net-call :host_net :close {conn_handle})
			(goto 'link_exit)
		(endif)
		(assign '(:r6) {retries})
		(call :sys_task :sleep '(10000)) ; 10ms
		(goto 'poll_loop)

	(vp-label 'poll_connected)
		;spawn connection worker task
		(call :sys_mail :alloc '(16) {msg, data})
		(call :sys_task :start (cat {@} (f-path :host_net :conn)) '(_ _ :r2 :r3 :r4))
		(assign {msg, data, conn_handle} '(:r0 :r1 :r5))
		(save-net-id :r0 +msg_dest :r2 :r3 :r4)
		(assign '(:r5) '((:r1 0)))
		(call :sys_mail :send '(:r0))
	(endif)

(vp-label 'link_exit)
	;free params msg
	(call :sys_mail :free {params})
	(pop-scope)
	(return)

(vp-label 'listen_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :listen '((:r0 cb_link_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(vp-label 'accept_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :accept '((:r0 cb_link_handle)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(vp-label 'connect_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :connect '((:r0 cb_link_host) (:r0 cb_link_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(def-func-end)

(def-method :host_net :conn)
	;started for each network connection
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(struct lk_node lk_node_size)
		(ptr msg data)
		(long conn_handle))

	(vp-rdef (tmp))
	(vp-rdef (_ iter_begin iter_end) (method-output :array :get_both))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))

	(push-scope)

	;decrement task count
	;don't count links in load balancing
	(call :sys_task :count '(-3))

	;init and add link node to link array
	(assign {&lk_node} '(:r4))
	(vp-simd vp-cpy-cr '(0 0x7fffffff) '(:r0 :r1))
	(assign '(:r0 :r0 :r1)
		'((:r4 (+ lk_node_peer_node_id +node_id_node1))
		  (:r4 (+ lk_node_peer_node_id +node_id_node2))
		  (:r4 lk_node_task_count)))
	(assign '((@ sys/statics/statics)) '(:r7))
	(assign '((:r7 statics_sys_mail_links_array)) '(:r0))
	(assign {&lk_node} '(:r1))
	(call :array :push_back '(:r0 :r1))

	;read params msg
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `((,params_data 0)) '(:r2))
	(assign '(:r2) {conn_handle})
	(call :sys_mail :free `(,params_msg))

	(gotoif '(:r2 <= 0) 'conn_exit)

	;start out link and send params
	(call :sys_mail :alloc '(16) {msg, data})
	(call :sys_task :start (cat {@} (f-path :host_net :out)) '(_ _ :r2 :r3 :r4))
	(assign {msg, data, &lk_node, conn_handle} '(:r0 :r1 :r5 :r6))
	(save-net-id :r0 +msg_dest :r2 :r3 :r4)
	(assign '(:r5 :r6) '((:r1 0) (:r1 +ptr_size)))
	(call :sys_mail :send '(:r0))

	;start in link and send params
	(call :sys_mail :alloc '(16) {msg, data})
	(call :sys_task :start (cat {@} (f-path :host_net :in)) '(_ _ :r2 :r3 :r4))
	(assign {msg, data, &lk_node, conn_handle} '(:r0 :r1 :r5 :r6))
	(save-net-id :r0 +msg_dest :r2 :r3 :r4)
	(assign '(:r5 :r6) '((:r1 0) (:r1 +ptr_size)))
	(call :sys_mail :send '(:r0))

	;wait till link dies
(vp-label 'conn_wait_loop)
	(call :sys_task :sleep '(100000))
	(assign {&lk_node} '(:r0))
	(assign '((:r0 lk_node_task_count i)) `(,tmp))
	(gotoif `(,tmp /= -1) 'conn_wait_loop)

	;wake outbound link if asleep so it exits before socket closes
	(call :sys_task :wake_links)

	;wait for in & out link to exit before closing socket
	(call :sys_task :sleep '(20000))

	;close socket
	(host-net-call :host_net :close {conn_handle})

(vp-label 'conn_exit)
	;remove link node from link array
	(assign '((@ sys/statics/statics)) '(:r7))
	(assign '((:r7 statics_sys_mail_links_array)) '(:r0))
	(call :array :get_both '(:r0) `(,_ ,iter_begin ,iter_end))
	(assign {&lk_node} '(:r3))
(vp-label 'find_link_loop)
	(gotoif `(,iter_begin = ,iter_end) 'conn_done)
	(assign `((,iter_begin 0)) '(:r4))
	(vpif '(:r4 = :r3))
		(assign '((@ sys/statics/statics)) '(:r7))
		(assign '((:r7 statics_sys_mail_links_array)) '(:r0))
		(call :array :erase `(:r0 ,iter_begin))
		(goto 'conn_done)
	(endif)
	(vp-add-cr +ptr_size iter_begin)
	(goto 'find_link_loop)

(vp-label 'conn_done)
	;restore task count
	(call :sys_task :count '(3))
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_net :out)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(struct ping_pkt +net_ping_pkt_size)
		(struct frag_pkt +net_frag_pkt_size)
		(ptr lk_node key msg)
		(long conn_handle then))

	(vp-rdef (send_handle send_buf send_rem) (method-input :host_net :send_all))
	(vp-rdef (send_status) (method-output :host_net :send_all))
	(vp-rdef (peer1 peer2 ready_key) (method-input :sys_mail :ready))
	(vp-rdef (ready_msg) (method-output :sys_mail :ready))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))

	(push-scope)

	(call :nodeid :create '(0) {key})

	;read params msg
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `((,params_data 0) (,params_data +ptr_size)) '(:r2 :r3))
	(assign '(:r2 :r3) {lk_node, conn_handle})
	(call :sys_mail :free `(,params_msg))

	;switch to link priority
	(call :sys_task :set_priority '(tk_out_link_priority))

	;prepare ping packet
	(assign {&ping_pkt} '(:r4))
	(vp-simd vp-cpy-cr '(lk_node_size +net_wire_type_ping) '(:r0 :r1))
	(assign '(:r0 :r1) '((:r4 +net_ping_pkt_wire_length) (:r4 +net_ping_pkt_wire_type)))
	(call :sys_kernel :id :nil '(:r0 :r1))
	(assign {&ping_pkt} '(:r4))
	(save-node-id :r4 +net_ping_pkt_peer_node_id :r0 :r1)
	(vp-cpy-cr 0x7fffffff :r0)
	(assign '(:r0) '((:r4 +net_ping_pkt_task_count)))

	;send initial ping
	(call :host_net :send_all {conn_handle, &ping_pkt, +net_ping_pkt_size} `(,send_status))
	(gotoif `(,send_status < 0) 'out_exit)
	(call :host_os :pii_time :nil '(:r0))
	(assign '(:r0) {then})

	;outbound loop
(vp-label 'out_loop)
	;load peer node id
	(assign {lk_node} '(:r3))
	(load-node-id :r3 lk_node_peer_node_id peer1 peer2)
	(vp-cpy-rr peer1 :r2)
	(vp-or-rr peer2 :r2)
	(vpif '(:r2 /= 0))
		(assign {key} `(,ready_key))
		(call :sys_mail :ready `(,peer1 ,peer2 ,ready_key) `(,ready_msg))
	(else)
		(vp-cpy-cr 0 ready_msg)
	(endif)

	(vpif `(,ready_msg /= 0))
		;we have mail to transmit
		(assign `(,ready_msg) {msg})
		(vp-cpy-rr ready_msg :r5) ;:r5 = msg
		(assign {&frag_pkt} '(:r4)) ;:r4 = frag_pkt

		;wire header: wire_length = len + lk_frag_size, wire_type = +net_wire_type_frag
		(assign '((:r5 +msg_length)) '(:r0))
		(vp-add-cr lk_frag_size :r0)
		(vp-cpy-cr +net_wire_type_frag :r1)
		(assign '(:r0 :r1) '((:r4 +net_frag_pkt_wire_length) (:r4 +net_frag_pkt_wire_type)))

		;dest and src net-ids
		(assign-net-id :r5 +msg_dest :r4 +net_frag_pkt_dest :r0 :r1 :r2)
		(assign-net-id :r5 +msg_src :r4 +net_frag_pkt_src :r0 :r1 :r2)

		;length, offset, total
		(assign '((:r5 +msg_length) (:r5 +msg_offset) (:r5 +msg_total)) '(:r0 :r1 :r2))
		(assign '(:r0 :r1 :r2)
		        '((:r4 +net_frag_pkt_length)
		          (:r4 +net_frag_pkt_offset)
		          (:r4 +net_frag_pkt_total)))

		;send frag header (72 bytes)
		(call :host_net :send_all {conn_handle, &frag_pkt, +net_frag_pkt_size} `(,send_status))
		(vpif `(,send_status < 0))
			(call :sys_mail :free {msg})
			(goto 'out_exit)
		(endif)

		;send payload data if len > 0
		(assign {conn_handle, msg} `(,send_handle :r5))
		(assign '((:r5 +msg_length) (:r5 +msg_data)) `(,send_rem ,send_buf))
		(vpif `(,send_rem > 0))
			(call :host_net :send_all `(,send_handle ,send_buf ,send_rem) `(,send_status))
			(vpif `(,send_status < 0))
				(call :sys_mail :free {msg})
				(goto 'out_exit)
			(endif)
		(endif)

		;free msg
		(call :sys_mail :free {msg})
		(goto 'out_loop)
	(endif)

	;no mail to send, sleep up to 5s or until woken by wake_links
	(call :sys_task :sleep '(5000000))

	;check if link closed
	(assign {lk_node} '(:r1))
	(assign '((:r1 lk_node_task_count i)) '(:r2))
	(gotoif '(:r2 = -1) 'out_exit)

	;send heartbeat ping only if 5s has elapsed
	(call :host_os :pii_time :nil '(:r0))
	(assign {then} '(:r1))
	(vp-cpy-rr :r0 :r2)
	(vp-sub-rr :r1 :r2)
	(vpif '(:r2 >= 5000000))
		(assign '(:r0) {then})
		(call :host_net :send_all {conn_handle, &ping_pkt, +net_ping_pkt_size} `(,send_status))
		(gotoif `(,send_status < 0) 'out_exit)
	(endif)
	(goto 'out_loop)

(vp-label 'out_exit)
	;mark link closed
	(assign {lk_node} '(:r2))
	(vp-simd vp-cpy-cr '(-1 0) '(:r0 :r1))
	(assign '(:r0 :r1 :r1)
		'((:r2 lk_node_task_count)
		  (:r2 (+ lk_node_peer_node_id +node_id_node1))
		  (:r2 (+ lk_node_peer_node_id +node_id_node2))))

	(call :nodeid :destroy {key})
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_net :in)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(struct wire_hdr +net_wire_hdr_size)
		(struct ping_payload lk_node_size)
		(struct frag_payload lk_frag_size)
		(ptr lk_node msg data)
		(nodeid node_id)
		(long conn_handle))

	(vp-rdef (recv_handle recv_buf recv_rem recv_node) (method-input :host_net :recv_all))
	(vp-rdef (recv_status) (method-output :host_net :recv_all))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))

	(push-scope)

	;read params msg
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `((,params_data 0) (,params_data +ptr_size)) '(:r2 :r3))
	(assign '(:r2 :r3) {lk_node, conn_handle})
	(call :sys_mail :free `(,params_msg))

	;switch to link priority
	(call :sys_task :set_priority '(tk_in_link_priority))

	;get local node id
	(call :sys_kernel :id :nil {node_id.+node_id_node1, node_id.+node_id_node2})

	;inbound packet loop
(vp-label 'in_loop)
	;read 8-byte wire header
	(call :host_net :recv_all {conn_handle, &wire_hdr, +net_wire_hdr_size, lk_node} `(,recv_status))
	(gotoif `(,recv_status < 0) 'in_exit)

	(assign {&wire_hdr} '(:r4))
	(assign '((:r4 +net_wire_hdr_type)) '(:r0))
	(gotoif '(:r0 = +net_wire_type_ping) 'in_ping)
	(gotoif '(:r0 = +net_wire_type_frag) 'in_frag)
	;unknown wire type, connection error
	(goto 'in_exit)

(vp-label 'in_ping)
	;read 24-byte ping payload
	(call :host_net :recv_all {conn_handle, &ping_payload, lk_node_size, lk_node} `(,recv_status))
	(gotoif `(,recv_status < 0) 'in_exit)

	;update peer node id on lk_node
	(assign {&ping_payload, lk_node} '(:r2 :r3))
	(load-node-id :r2 lk_node_peer_node_id :r0 :r1)
	(save-node-id :r3 lk_node_peer_node_id :r0 :r1)

	;always lock task count at 0x7fffffff!
	(vp-cpy-cr 0x7fffffff :r0)
	(assign '(:r0) '((:r3 lk_node_task_count)))

	;wake outbound link in case mail was waiting for this peer
	(call :sys_task :wake_links)
	(goto 'in_check_exit)

(vp-label 'in_frag)
	;read 64-byte frag payload header
	(call :host_net :recv_all {conn_handle, &frag_payload, lk_frag_size, lk_node} `(,recv_status))
	(gotoif `(,recv_status < 0) 'in_exit)

	;check if parcel for local node
	(assign {&frag_payload} '(:r4))
	(assign '((:r4 lk_frag_total)) '(:r0))
	(gotoif '(:r0 = 0) 'in_single_packet)

	(assign {node_id.+node_id_node1, node_id.+node_id_node2} '(:r1 :r2))
	(assign '((:r4 (+ lk_frag_dest +net_id_node_id +node_id_node1))
	          (:r4 (+ lk_frag_dest +net_id_node_id +node_id_node2))) '(:r5 :r6))
	(gotoif '(:r1 /= :r5) 'in_single_packet)
	(gotoif '(:r2 /= :r6) 'in_single_packet)

	;search parcel list for matching src net-id
	(assign '((:r4 (+ lk_frag_src +net_id_mbox_id))
	          (:r4 (+ lk_frag_src +net_id_node_id +node_id_node1))
	          (:r4 (+ lk_frag_src +net_id_node_id +node_id_node2))) '(:r7 :r8 :r9))

	;parcels list head in :r10
	(assign '((@ sys/statics/statics)) '(:r10))
	(vp-add-cr statics_sys_mail_parcel_list :r10)

	;iterate list: first node is parcels->+lh_list_head
	(assign '((:r10 +lh_list_head)) '(:r5))
(vp-label 'parcel_search_loop)
	(assign '((:r5 +ln_node_succ)) '(:r6))
	(gotoif '(:r6 = 0) 'parcel_not_found)
	(assign '((:r5 (+ +msg_src +net_id_mbox_id))
	          (:r5 (+ +msg_src +net_id_node_id +node_id_node1))
	          (:r5 (+ +msg_src +net_id_node_id +node_id_node2))) '(:r0 :r1 :r2))
	(vpif '(:r0 = :r7) '(:r1 = :r8) '(:r2 = :r9))
		(goto 'parcel_found)
	(endif)
	(vp-cpy-rr :r6 :r5)
	(goto 'parcel_search_loop)

(vp-label 'parcel_not_found)
	;new parcel: allocate msg for total size
	(assign {&frag_payload} '(:r4))
	(assign '((:r4 lk_frag_total)) '(:r0))
	(call :sys_mail :alloc '(:r0) '(:r5 _))
	(assign {&frag_payload} '(:r4))
	(assign '((:r4 lk_frag_total)) '(:r0))
	(assign '(:r0) '((:r5 +msg_total)))

	;copy dest and src net-ids to new msg
	(assign-net-id :r4 lk_frag_dest :r5 +msg_dest :r0 :r1 :r2)
	(assign-net-id :r4 lk_frag_src :r5 +msg_src :r0 :r1 :r2)

	;add node at tail of parcels list
	(assign '((@ sys/statics/statics)) '(:r10))
	(vp-add-cr statics_sys_mail_parcel_list :r10)
	(lh-add-at-tail :r10 :r5 :r6)

(vp-label 'parcel_found)
	;msg is in :r5!
	(assign '(:r5) {msg})

	;timestamp last change
	(call :host_os :pii_time :nil '(:r0))
	(assign {msg} '(:r5))
	(assign '(:r0) '((:r5 +msg_timestamp)))

	;read payload data directly into parcel msg buffer
	(assign {&frag_payload} '(:r4))
	(assign '((:r4 lk_frag_length) (:r4 lk_frag_offset)) '(:r1 :r2))

	(assign '((:r5 +msg_offset)) '(:r0))
	(vp-add-rr :r1 :r0)
	(assign '(:r0) '((:r5 +msg_offset)))

	(assign '((:r5 +msg_total)) '(:r0))
	(vp-sub-rr :r1 :r0)
	(assign '(:r0) '((:r5 +msg_total)))

	(vpif '(:r1 > 0))
		(assign '((:r5 +msg_data)) '(:r7))
		(vp-add-rr :r2 :r7)
		(assign {conn_handle, lk_node} `(,recv_handle ,recv_node))
		(vp-cpy-rr :r1 recv_rem)
		(vp-cpy-rr :r7 recv_buf)
		(call :host_net :recv_all `(,recv_handle ,recv_buf ,recv_rem ,recv_node) `(,recv_status))
		(gotoif `(,recv_status < 0) 'in_exit)
	(endif)

	;if parcel complete, remove and send
	(assign {msg} '(:r5))
	(assign '((:r5 +msg_total)) '(:r0))
	(vpif '(:r0 = 0))
		(vp-cpy-rr :r5 :r0)
		(ln-remove-node :r0 :r1)
		(call :sys_mail :send {msg})
	(endif)
	(goto 'in_check_exit)

(vp-label 'in_single_packet)
	;single packet or routed onward
	(assign {&frag_payload} '(:r4))
	(assign '((:r4 lk_frag_length)) '(:r0))
	(call :sys_mail :alloc '(:r0) '(:r5 :r6))
	(assign '(:r5 :r6) {msg, data})

	(assign {&frag_payload} '(:r4))
	(assign '((:r4 lk_frag_length) (:r4 lk_frag_offset) (:r4 lk_frag_total)) '(:r0 :r1 :r2))
	(assign '(:r0 :r1 :r2) '((:r5 +msg_length) (:r5 +msg_offset) (:r5 +msg_total)))

	(assign-net-id :r4 lk_frag_dest :r5 +msg_dest :r0 :r1 :r2)
	(assign-net-id :r4 lk_frag_src :r5 +msg_src :r0 :r1 :r2)

	;read payload data directly into msg buffer!
	(assign '((:r5 +msg_length)) `(,recv_rem))
	(vpif `(,recv_rem > 0))
		(assign {conn_handle, lk_node} `(,recv_handle ,recv_node))
		(assign '((:r5 +msg_data)) `(,recv_buf))
		(call :host_net :recv_all `(,recv_handle ,recv_buf ,recv_rem ,recv_node) `(,recv_status))
		(vpif `(,recv_status < 0))
			(call :sys_mail :free {msg})
			(goto 'in_exit)
		(endif)
	(endif)

	;send onwards
	(call :sys_mail :send {msg})

(vp-label 'in_check_exit)
	;check if link closed
	(assign {lk_node} '(:r1))
	(assign '((:r1 lk_node_task_count i)) '(:r0))
	(gotoif '(:r0 = -1) 'in_exit)
	(goto 'in_loop)

(vp-label 'in_exit)
	;mark link closed
	(assign {lk_node} '(:r2))
	(vp-simd vp-cpy-cr '(-1 0) '(:r0 :r1))
	(assign '(:r0 :r1 :r1)
		'((:r2 lk_node_task_count)
		  (:r2 (+ lk_node_peer_node_id +node_id_node1))
		  (:r2 (+ lk_node_peer_node_id +node_id_node2))))
	(call :sys_task :wake_links)
	(pop-scope)
	(return)

(def-func-end)
