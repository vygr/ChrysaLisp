(include "lib/asm/func.inc")
(include "class/nodeid/class.inc")
(include "class/array/class.inc")
(include "sys/link/class.inc")
(include "sys/kernel/class.inc")
(include "sys/mail/class.inc")
(include "./class.inc")

(def-method :host_net :send_all)
	;inputs
	;:r0 = handle
	;:r1 = buffer ptr
	;:r2 = remaining bytes
	;outputs
	;:r0 = 0 if ok, -1 if error
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(ptr buf)
		(long handle remaining))

	(push-scope)
	(entry :host_net :send_all '(:r0 :r1 :r2))
	(assign '(:r0 :r1 :r2) {handle, buf, remaining})

	(vp-rdef (handle buf remaining) (method-input :host_net :send))

(vp-label 'send_loop)
	(assign {handle, buf, remaining} `(,handle ,buf ,remaining))
	(host-net-call :host_net :send `(,handle ,buf ,remaining) '(:r0))
	(vpif '(:r0 < 0))
		(assign '(-1) '(:r0))
		(goto 'send_exit)
	(endif)
	(vpif '(:r0 = 0))
		;socket send buffer full, sleep 100 µs
		(call :sys_task :sleep '(100))
		(goto 'send_loop)
	(endif)

	(vp-rdef (sent buf remaining))
	(assign {buf, remaining} `(,buf ,remaining))
	(vp-add-rr sent buf)
	(vp-sub-rr sent remaining)
	(assign `(,buf ,remaining) {buf, remaining})
	(gotoif `(,remaining > 0) 'send_loop)

	(assign '(0) '(:r0))

(vp-label 'send_exit)
	(exit :host_net :send_all '(:r0))
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_net :recv_all)
	;inputs
	;:r0 = handle
	;:r1 = buffer ptr
	;:r2 = remaining bytes
	;:r3 = lk_node ptr
	;outputs
	;:r0 = 0 if ok, -1 if error
	;trashes
	;:r0-:r14, :f0-:f15

	(structure cb_recv 0
		(ptr buf)
		(long handle remaining recvd))

	(def-vars
		(struct cb cb_recv_size)
		(ptr lk_node)
		(long sleep_time))

	(push-scope)
	(entry :host_net :recv_all '(:r0 :r1 :r2 :r3))
	(assign '(:r0 :r1 :r2 :r3) {cb.cb_recv_handle, cb.cb_recv_buf, cb.cb_recv_remaining, lk_node})
	(assign {100} {sleep_time})

	(loop-start 'recv_loop)
		(vp-rdef (remaining) '(:r2))
		(assign {cb.cb_recv_remaining} `(,remaining))
		(breakifnot `(,remaining > 0) 'recv_loop)

		(call :sys_task :callback {&cb, $recv_callback})

		(vp-rdef (recvd))
		(assign {cb.cb_recv_recvd} `(,recvd))
		(vpif `(,recvd < 0))
			(assign '(-1) '(:r0))
			(goto 'recv_exit)
		(endif)

		(vpif `(,recvd = 0))
			;check if link was closed while sleeping
			(vp-rdef (lk_node task_count) '(:r1 :r2))
			(assign {lk_node} `(,lk_node))
			(assign `((,lk_node lk_node_task_count)) `(,task_count))
			(vpif `(,task_count < 0))
				(assign '(-1) '(:r0))
				(goto 'recv_exit)
			(endif)

			;sleep with exponential backoff up to 2ms
			(vp-rdef (sleep_time))
			(assign {sleep_time} `(,sleep_time))
			(call :sys_task :sleep `(,sleep_time))
			(assign {sleep_time} `(,sleep_time))
			(vp-shl-cr 1 sleep_time)
			(vp-min-cr 2000 sleep_time)
			(assign `(,sleep_time) {sleep_time})
			(continue 'recv_loop)
		(endif)

		;got data: reset sleep time, update buf and remaining
		(assign {100} {sleep_time})
		(vp-rdef (recvd buf remaining))
		(assign {cb.cb_recv_buf, cb.cb_recv_remaining} `(,buf ,remaining))
		(vp-add-rr recvd buf)
		(vp-sub-rr recvd remaining)
		(assign `(,buf ,remaining) {cb.cb_recv_buf, cb.cb_recv_remaining})
	(loop-end)

	(assign '(0) '(:r0))

(vp-label 'recv_exit)
	(exit :host_net :recv_all '(:r0))
	(pop-scope)
	(return)

(vp-label 'recv_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(vp-cpy-rr :r0 :r3)
	(host-net-call :host_net :recv
		'((:r3 cb_recv_handle) (:r3 cb_recv_buf) (:r3 cb_recv_remaining)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_recv_recvd)))
	(vp-ret)

(def-func-end)

(def-method :host_net :link)
	;started by kernel for each network link
	;trashes
	;:r0-:r14, :f0-:f15

	(structure cb_link 0
		(pubyte host)
		(long port handle))

	(def-vars
		(struct cb cb_link_size)
		(ptr params msg data)
		(pubyte pdata p)
		(long listen_handle conn_handle ch retries is_server port))

	(push-scope)

	;read params msg from kernel
	(call :sys_mail :mymail :nil {params, pdata})

	;default port = 3333
	(assign {3333, 0} {port, is_server})
	(assign {pdata} {p})
	(vpif {*p = 58}) ; ':' -> listen mode
		(assign {1} {is_server})
		(assign {p + 1} {p})
		(vpif {*p >= 48 && *p <= 57})
			(assign {0} {port})
			(loop-start)
				(breakif {*p < 48 || *p > 57})
				(assign {port * 10 + *p - 48} {port})
				(assign {p + 1} {p})
			(loop-end)
		(endif)
	(else)
		;connect mode: scan for ':'
		(loop-start 'scan_loop)
			(breakif {*p = 0})
			(vpif {*p = 58}) ; ':'
				(assign {0} {*p}) ; null-terminate host string
				(assign {p + 1} {p})
				(vpif {*p >= 48 && *p <= 57})
					(assign {0} {port})
					(loop-start)
						(breakif {*p < 48 || *p > 57})
						(assign {port * 10 + *p - 48} {port})
						(assign {p + 1} {p})
					(loop-end)
				(endif)
				(break 'scan_loop)
			(endif)
			(assign {p + 1} {p})
		(loop-end)
	(endif)

	(vpif {is_server})
		;decrement task count for listener
		(call :sys_task :count '(-1))

		;listen on port
		(assign {port} {cb.cb_link_port})
		(call :sys_task :callback {&cb, $listen_callback})
		(assign {cb.cb_link_handle} {listen_handle})
		(gotoif {listen_handle <= 0} 'link_server_exit)

		;persistent accept loop
		(loop-start)
			(assign {listen_handle} {cb.cb_link_handle})
			(call :sys_task :callback {&cb, $accept_callback})
			(assign {cb.cb_link_handle} {conn_handle})
			(vpif {conn_handle > 0})
				;spawn connection worker task
				(call :sys_mail :alloc '(16) {msg, data})
				(call :sys_task :start (cat {@} (f-path :host_net :conn)) '(_ _ :r2 :r3 :r4))
				(assign {msg, data, conn_handle} '(:r0 :r1 :r5))
				(save-net-id :r0 +msg_dest)
				(assign '(:r5) '((:r1 0)))
				(call :sys_mail :send '(:r0))
			(endif)
			(call :sys_task :sleep '(10000)) ; 10ms
		(loop-end)

		;close listening socket
		(host-net-call :host_net :close {listen_handle})
(vp-label 'link_server_exit)
		(call :sys_task :count '(1))
	(else)
		;connect to host:port
		(assign {pdata, port} {cb.cb_link_host, cb.cb_link_port})
		(call :sys_task :callback {&cb, $connect_callback})
		(assign {cb.cb_link_handle} {conn_handle})
		(gotoif {conn_handle <= 0} 'link_exit)

		;wait for connect to complete
		(assign {0} {retries})
		(loop-start)
			(host-net-call :host_net :poll {conn_handle} {ch})
			;bit 1 (POLLOUT) = connected
			(breakif {ch & 2})
			;bit 2 (POLLERR) = error
			(vpif {ch & 4})
				(host-net-call :host_net :close {conn_handle})
				(goto 'link_exit)
			(endif)
			(call :sys_task :sleep '(10000)) ; 10ms
			(assign {retries + 1} {retries})
			(vpif {retries > 500}) ; 5s timeout
				(host-net-call :host_net :close {conn_handle})
				(goto 'link_exit)
			(endif)
		(loop-end)

		;spawn connection worker task
		(call :sys_mail :alloc '(16) {msg, data})
		(call :sys_task :start (cat {@} (f-path :host_net :conn)) '(_ _ :r2 :r3 :r4))
		(assign {msg, data, conn_handle} '(:r0 :r1 :r5))
		(save-net-id :r0 +msg_dest)
		(assign '(:r5) '((:r1 0)))
		(call :sys_mail :send '(:r0))
	(endif)

(vp-label 'link_exit)
	;free params msg
	(call :sys_mail :free {params})
	(pop-scope)
	(return)

(vp-label 'listen_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(vp-cpy-rr :r0 :r3)
	(host-net-call :host_net :listen '((:r3 cb_link_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(vp-label 'accept_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(vp-cpy-rr :r0 :r3)
	(host-net-call :host_net :accept '((:r3 cb_link_handle)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(vp-label 'connect_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(vp-cpy-rr :r0 :r3)
	(host-net-call :host_net :connect '((:r3 cb_link_host) (:r3 cb_link_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(def-func-end)

(def-method :host_net :conn)
	;started for each network connection
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(struct lk_node lk_node_size)
		(ptr statics msg data iter_begin iter_end)
		(long conn_handle))

	(push-scope)

	;decrement task count
	;don't count links in load balancing
	(call :sys_task :count '(-3))

	;init and add link node to link array
	(assign {@sys/statics/statics} {statics})
	(assign {0, 0, 0x7fffffff}
		{lk_node.lk_node_peer_node_id.+node_id_node1,
		 lk_node.lk_node_peer_node_id.+node_id_node2,
		 lk_node.lk_node_task_count})
	(call :array :push_back {statics->statics_sys_mail_links_array, &lk_node})

	;read params msg
	(call :sys_mail :mymail :nil {msg, data})
	(assign {ptr(data + 0)} {conn_handle})
	(call :sys_mail :free {msg})

	(gotoif {conn_handle <= 0} 'conn_exit)

	;start out link and send params
	(call :sys_mail :alloc '(16) {msg, data})
	(call :sys_task :start (cat {@} (f-path :host_net :out)) '(_ _ :r2 :r3 :r4))
	(assign {msg, data, &lk_node, conn_handle} '(:r0 :r1 :r5 :r6))
	(save-net-id :r0 +msg_dest)
	(assign '(:r5 :r6) '((:r1 0) (:r1 +ptr_size)))
	(call :sys_mail :send '(:r0))

	;start in link and send params
	(call :sys_mail :alloc '(16) {msg, data})
	(call :sys_task :start (cat {@} (f-path :host_net :in)) '(_ _ :r2 :r3 :r4))
	(assign {msg, data, &lk_node, conn_handle} '(:r0 :r1 :r5 :r6))
	(save-net-id :r0 +msg_dest)
	(assign '(:r5 :r6) '((:r1 0) (:r1 +ptr_size)))
	(call :sys_mail :send '(:r0))

	;wait till link dies
	(loop-start)
		(call :sys_task :sleep '(100000))
		(breakif {lk_node.lk_node_task_count = -1})
	(loop-end)

	;wait for in & out link to exit before closing socket
	(call :sys_task :sleep '(20000))

	;close socket
	(host-net-call :host_net :close {conn_handle})

(vp-label 'conn_exit)
	;remove link node from link array
	(call :array :get_both {statics->statics_sys_mail_links_array} {_, iter_begin, iter_end})
	(loop-while {iter_begin /= iter_end})
		(vpif {*iter_begin = &lk_node})
			(call :array :erase {statics->statics_sys_mail_links_array, iter_begin})
			(break)
		(endif)
		(assign {iter_begin + +ptr_size} {iter_begin})
	(loop-end)

	;restore task count
	(call :sys_task :count '(3))
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_net :out)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(struct ping_pkt +net_ping_pkt_size)
		(struct frag_pkt +net_frag_pkt_size)
		(ptr lk_node key)
		(long conn_handle then))

	(push-scope)

	(call :nodeid :create '(0) {key})

	;read params msg
	(call :sys_mail :mymail :nil '(:r0 :r1))
	(assign '((:r1 0) (:r1 +ptr_size)) '(:r2 :r3))
	(assign '(:r2 :r3) {lk_node, conn_handle})
	(call :sys_mail :free '(:r0))

	;switch to link priority
	(call :sys_task :set_priority '(tk_out_link_priority))

	;prepare ping packet
	(assign {&ping_pkt} '(:r4))
	(vp-simd vp-cpy-cr `(,lk_node_size ,+net_wire_type_ping) '(:r1 :r2))
	(assign '(:r1 :r2)
		'((:r4 +net_ping_pkt_wire_length) (:r4 +net_ping_pkt_wire_type)))
	(call :sys_kernel :id :nil '(:r0 :r1))
	(vp-cpy-cr 0x7fffffff :r2)
	(assign '(:r0 :r1 :r2)
		'((:r4 (+ +net_ping_pkt_peer_node_id +node_id_node1))
		  (:r4 (+ +net_ping_pkt_peer_node_id +node_id_node2))
		  (:r4 +net_ping_pkt_task_count)))

	;send initial ping
	(assign {conn_handle} '(:r0))
	(call :host_net :send_all '(:r0 :r4 +net_ping_pkt_size) '(:r0))
	(gotoif '(:r0 < 0) 'out_exit)
	(call :host_os :pii_time :nil '(:r0))
	(assign '(:r0) {then})

	;outbound loop
	(loop-start 'out_loop)
		;load peer node id
		(assign {lk_node} '(:r3))
		(load-node-id :r3 lk_node_peer_node_id :r0 :r1)
		(vp-cpy-rr :r0 :r2)
		(vp-or-rr :r1 :r2)
		(vpif '(:r2 /= 0))
			(assign {key} '(:r2))
			(call :sys_mail :ready '(:r0 :r1 :r2) '(:r0))
		(else)
			(vp-cpy-cr 0 :r0)
		(endif)

		(vpif '(:r0 /= 0))
			(vp-rdef (msg frag len conn_handle) '(:r5 :r6 :r7 :r8))
			(vp-cpy-rr :r0 msg)
			(assign {&frag_pkt, conn_handle} `(,frag ,conn_handle))
			(assign `((,msg +msg_length)) `(,len))

			;wire header: wire_length = len + lk_frag_size, wire_type = +net_wire_type_frag
			(vp-cpy-cr +net_wire_type_frag :r1)
			(vp-cpy-rr len :r0)
			(vp-add-cr lk_frag_size :r0)
			(assign '(:r0 :r1)
				`((,frag +net_frag_pkt_wire_length) (,frag +net_frag_pkt_wire_type)))

			;dest and src net-ids
			(assign-net-id msg +msg_dest frag +net_frag_pkt_dest :r0 :r1 :r2)
			(assign-net-id msg +msg_src frag +net_frag_pkt_src :r0 :r1 :r2)

			;length, offset, total
			(assign `((,msg +msg_offset) (,msg +msg_total)) '(:r0 :r1))
			(assign `(,len :r0 :r1)
				`((,frag +net_frag_pkt_length) (,frag +net_frag_pkt_offset) (,frag +net_frag_pkt_total)))

			;send frag header (72 bytes)
			(call :host_net :send_all `(,conn_handle ,frag ,+net_frag_pkt_size) '(:r0))
			(vpif '(:r0 < 0))
				(call :sys_mail :free `(,msg))
				(goto 'out_exit)
			(endif)

			;send payload data if len > 0
			(vpif `(,len > 0))
				(vp-lea-i msg +msg_data :r1)
				(call :host_net :send_all `(,conn_handle :r1 ,len) '(:r0))
				(vpif '(:r0 < 0))
					(call :sys_mail :free `(,msg))
					(goto 'out_exit)
				(endif)
			(endif)

			;free msg
			(call :sys_mail :free `(,msg))
			(continue 'out_loop)
		(endif)

		;no mail to send, sleep up to 5s or until woken by wake_links
		(call :sys_task :sleep '(5000000))

		;check if link closed
		(assign {lk_node} '(:r1))
		(assign '((:r1 lk_node_task_count)) '(:r0))
		(breakif '(:r0 = -1) 'out_loop)

		;send heartbeat ping only if 5s has elapsed
		(call :host_os :pii_time :nil '(:r0))
		(vp-rdef (now then elapsed))
		(assign {then} `(,then))
		(vp-cpy-rr now elapsed)
		(vp-sub-rr then elapsed)
		(vpif `(,elapsed >= 5000000))
			(assign `(,now) {then})
			(assign {conn_handle, &ping_pkt} '(:r0 :r1))
			(call :host_net :send_all '(:r0 :r1 +net_ping_pkt_size) '(:r0))
			(breakif '(:r0 < 0) 'out_loop)
		(endif)
	(loop-end)

(vp-label 'out_exit)
	;mark link closed
	(assign {lk_node} '(:r2))
	(vp-simd vp-cpy-cr '(-1 0) '(:r0 :r1))
	(assign '(:r0 :r1 :r1)
		'((:r2 lk_node_task_count)
		  (:r2 (+ lk_node_peer_node_id +node_id_node1))
		  (:r2 (+ lk_node_peer_node_id +node_id_node2))))

	(call :nodeid :destroy {key})
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_net :in)
	;trashes
	;:r0-:r14, :f0-:f15

	(def-vars
		(struct wire_hdr +net_wire_hdr_size)
		(struct ping_payload lk_node_size)
		(struct frag_payload lk_frag_size)
		(nodeid node_id)
		(ptr lk_node msg data)
		(long conn_handle))

	(push-scope)

	;read params msg
	(call :sys_mail :mymail :nil '(:r0 :r1))
	(assign '((:r1 0) (:r1 +ptr_size)) '(:r2 :r3))
	(assign '(:r2 :r3) {lk_node, conn_handle})
	(call :sys_mail :free '(:r0))

	;switch to link priority
	(call :sys_task :set_priority '(tk_in_link_priority))

	;get local node id
	(call :sys_kernel :id :nil '(:r0 :r1))
	(assign '(:r0 :r1) {node_id.+node_id_node1, node_id.+node_id_node2})

	;inbound packet loop
	(loop-start 'in_loop)
		;read 8-byte wire header
		(assign {conn_handle, &wire_hdr, lk_node} '(:r0 :r1 :r3))
		(call :host_net :recv_all `(:r0 :r1 ,+net_wire_hdr_size :r3) '(:r0))
		(gotoif '(:r0 < 0) 'in_exit)

		(assign {&wire_hdr} '(:r1))
		(vp-cpy-ir-ui :r1 +net_wire_hdr_type :r0)
		(vpif '(:r0 = +net_wire_type_ping))
			;read 24-byte ping payload
			(assign {conn_handle, &ping_payload, lk_node} '(:r0 :r1 :r3))
			(call :host_net :recv_all `(:r0 :r1 ,lk_node_size :r3) '(:r0))
			(gotoif '(:r0 < 0) 'in_exit)

			;update peer node id on lk_node and set task_count to 0x7fffffff
			(assign {&ping_payload, lk_node} '(:r2 :r3))
			(load-node-id :r2 lk_node_peer_node_id :r0 :r1)
			(save-node-id :r3 lk_node_peer_node_id :r0 :r1)
			(vp-cpy-cr 0x7fffffff :r0)
			(assign '(:r0) '((:r3 lk_node_task_count)))

			;wake outbound link in case mail was waiting for this peer
			(call :sys_task :wake_links)

		(elseif '(:r0 = +net_wire_type_frag))
			;read 64-byte frag payload header
			(assign {conn_handle, &frag_payload, lk_node} '(:r0 :r1 :r3))
			(call :host_net :recv_all `(:r0 :r1 ,lk_frag_size :r3) '(:r0))
			(gotoif '(:r0 < 0) 'in_exit)

			;check if parcel for local node
			(assign {&frag_payload} '(:r4))
			(vp-cpy-ir-ui :r4 lk_frag_total :r0)
			(gotoif '(:r0 = 0) 'in_route)
			(assign {node_id.+node_id_node1, node_id.+node_id_node2} '(:r1 :r2))
			(assign '((:r4 (+ lk_frag_dest +net_id_node_id +node_id_node1))
			          (:r4 (+ lk_frag_dest +net_id_node_id +node_id_node2))) '(:r5 :r6))
			(gotoif '(:r1 /= :r5) 'in_route)
			(gotoif '(:r2 /= :r6) 'in_route)

			;search parcel list for matching src net-id
			(vp-rdef (node next src1 src2 src3 psrc1 psrc2 psrc3 parcels rx_frag total))
			(assign {@sys/statics/statics.statics_sys_mail_parcel_list} `(,parcels))
			(vp-cpy-rr :r4 rx_frag)
			(load-net-id rx_frag lk_frag_src src1 src2 src3)
			(loop-list-forward parcels 0 node next)
				(load-net-id node +msg_src psrc1 psrc2 psrc3)
			(loop-until `(,src1 = ,psrc1) `(,src2 = ,psrc2) `(,src3 = ,psrc3))
			(vpif `(,next = 0))
				;new parcel: allocate msg for total size
				(assign `((,rx_frag lk_frag_total)) `(,total))
				(call :sys_mail :alloc `(,total) `(,node _))
				(assign `(,total) `((,node +msg_total)))
				(assign-net-id rx_frag lk_frag_dest node +msg_dest src1 src2 src3)
				(assign-net-id rx_frag lk_frag_src node +msg_src src1 src2 src3)
				(lh-add-at-tail parcels node next)
			(endif)

			;timestamp last change
			(assign `(,node) {msg})
			(call :host_os :pii_time :nil '(:r0))
			(assign {msg} '(:r5))
			(assign '(:r0) '((:r5 +msg_timestamp)))

			;read payload data directly into parcel msg buffer
			(assign {&frag_payload} '(:r4))
			(assign '((:r4 lk_frag_length) (:r4 lk_frag_offset)) '(:r1 :r2))
			(assign '((:r5 +msg_offset)) '(:r0))
			(vp-add-rr :r1 :r0)
			(assign '(:r0) '((:r5 +msg_offset)))

			(assign '((:r5 +msg_total)) '(:r0))
			(vp-sub-rr :r1 :r0)
			(assign '(:r0) '((:r5 +msg_total)))

			(vpif '(:r1 > 0))
				(vp-lea-i :r5 +msg_data :r7)
				(vp-add-rr :r2 :r7)
				(vp-cpy-rr :r1 :r2)
				(vp-cpy-rr :r7 :r1)
				(assign {conn_handle, lk_node} '(:r0 :r3))
				(call :host_net :recv_all '(:r0 :r1 :r2 :r3) '(:r0))
				(gotoif '(:r0 < 0) 'in_exit)
			(endif)

			;if parcel complete, remove from list and send
			(assign {msg} '(:r5))
			(assign '((:r5 +msg_total)) '(:r0))
			(vpif '(:r0 = 0))
				(vp-cpy-rr :r5 :r0)
				(ln-remove-node :r0 :r1)
				(call :sys_mail :send {msg})
			(endif)
			(goto 'in_next)

(vp-label 'in_route)
			;single packet or routed onward
			(assign {&frag_payload} '(:r4))
			(assign '((:r4 lk_frag_length)) '(:r0))
			(call :sys_mail :alloc '(:r0) '(:r5 :r6))
			(assign '(:r5 :r6) {msg, data})
			(assign {&frag_payload} '(:r4))
			(assign '((:r4 lk_frag_length) (:r4 lk_frag_offset) (:r4 lk_frag_total)) '(:r0 :r1 :r2))
			(assign '(:r0 :r1 :r2) '((:r5 +msg_length) (:r5 +msg_offset) (:r5 +msg_total)))
			(assign-net-id :r4 lk_frag_dest :r5 +msg_dest :r0 :r1 :r2)
			(assign-net-id :r4 lk_frag_src :r5 +msg_src :r0 :r1 :r2)

			;read payload data directly into msg buffer
			(assign '((:r5 +msg_length)) '(:r2))
			(vpif '(:r2 > 0))
				(assign {conn_handle, data, lk_node} '(:r0 :r1 :r3))
				(call :host_net :recv_all '(:r0 :r1 :r2 :r3) '(:r0))
				(vpif '(:r0 < 0))
					(call :sys_mail :free {msg})
					(goto 'in_exit)
				(endif)
			(endif)

			;send onwards
			(call :sys_mail :send {msg})
			(goto 'in_next)

		(else)
			;unknown wire type, connection error
			(goto 'in_exit)
		(endif)

(vp-label 'in_next)
		;check if link closed
		(assign {lk_node} '(:r1))
		(assign '((:r1 lk_node_task_count)) '(:r0))
		(breakif '(:r0 = -1) 'in_loop)
	(loop-end)

(vp-label 'in_exit)
	;mark link closed
	(assign {lk_node} '(:r2))
	(vp-simd vp-cpy-cr '(-1 0) '(:r0 :r1))
	(assign '(:r0 :r1 :r1)
		'((:r2 lk_node_task_count)
		  (:r2 (+ lk_node_peer_node_id +node_id_node1))
		  (:r2 (+ lk_node_peer_node_id +node_id_node2))))

	(pop-scope)
	(return)

(def-func-end)
