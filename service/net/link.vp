(include "lib/asm/func.inc")
(include "sys/link/class.inc")
(include "sys/kernel/class.inc")
(include "class/nodeid/class.inc")
(include "class/array/class.inc")
(include "./class.inc")
(include "sys/crypto/class.inc")

(def-method :host_net :send_all)
	;inputs
	;:r0 = handle
	;:r1 = buffer ptr
	;:r2 = remaining bytes
	;:r3 = lk_node ptr
	;outputs
	;:r0 = 0 if ok, -1 if error
	;trashes
	;:r0-:r2, :r13-:r14, :d0-:d15

	(structure slot 0
		(ptr buf lk_node)
		(long handle remaining))

	(vp-alloc slot_size)
	(entry :host_net :send_all '(:r0 :r1 :r2 :r3))
	(gotoif '(:r2 <= 0) 'send_done)
	(save-fields :rsp '(slot_handle slot_buf slot_remaining slot_lk_node) '(:r0 :r1 :r2 :r3))

(vp-label 'send_loop)
	(host-net-call :host_net :send '((:rsp slot_handle) (:rsp slot_buf) (:rsp slot_remaining)) '(:r0))
	(vpif '(:r0 < 0))
		(assign '(-1) '(:r0))
		(goto 'send_exit)
	(endif)
	(vpif '(:r0 = 0))
		;socket send buffer full, sleep 100 µs, unless the link is closed:
		;a peer that reads no more would keep it full for ever
		(call :sys_task :sleep '(100))
		(assign '((:rsp slot_lk_node)) '(:r1))
		(assign '((:r1 lk_node_task_count i)) '(:r2))
		(gotoif '(:r2 /= -1) 'send_loop)
		(assign '(-1) '(:r0))
		(goto 'send_exit)
	(endif)

	(vp-rdef (sent buf remaining))
	(load-fields :rsp '(slot_buf slot_remaining) `(,buf ,remaining))
	(vp-add-rr sent buf)
	(vp-sub-rr sent remaining)
	(save-fields :rsp '(slot_buf slot_remaining) `(,buf ,remaining))
	(gotoif `(,remaining > 0) 'send_loop)

(vp-label 'send_done)
	(assign '(0) '(:r0))

(vp-label 'send_exit)
	(exit :host_net :send_all '(:r0))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :host_net :recv_all)
	;inputs
	;:r0 = handle
	;:r1 = buffer ptr
	;:r2 = remaining bytes
	;:r3 = lk_node ptr
	;outputs
	;:r0 = 0 if ok, -1 if error
	;trashes
	;:r0-:r14, :d0-:d15

	(structure cb_recv 0
		(ptr buf)
		(long handle remaining recvd))

	(structure slot 0
		(struct cb cb_recv_size)
		(ptr lk_node)
		(long sleep_time))

	(vp-rdef (cb func) (method-input :sys_task :callback))

	(vp-alloc slot_size)
	(entry :host_net :recv_all `((:rsp ,(+ slot_cb cb_recv_handle)) (:rsp ,(+ slot_cb cb_recv_buf))
			(:rsp ,(+ slot_cb cb_recv_remaining)) (:rsp slot_lk_node)))
	(assign '(100) '(:r0))
	(assign '(:r0) '((:rsp slot_sleep_time)))

(vp-label 'recv_loop)
	(assign `((:rsp ,(+ slot_cb cb_recv_remaining))) '(:r2))
	(gotoif '(:r2 <= 0) 'recv_done)

	(assign '((& :rsp slot_cb)) `(,cb))
	(call :sys_task :callback `(,cb ($ recv_callback)))

	(assign `((:rsp ,(+ slot_cb cb_recv_recvd))) '(:r0))
	(gotoif '(:r0 < 0) 'recv_error)

	(vpif '(:r0 = 0))
		;check if link was closed while sleeping
		(assign '((:rsp slot_lk_node)) '(:r1))
		(assign '((:r1 lk_node_task_count i)) '(:r2))
		(gotoif '(:r2 = -1) 'recv_error)

		;no data waiting, sleep with exponential backoff up to 2ms
		(call :sys_task :sleep '((:rsp slot_sleep_time)))
		(assign '((:rsp slot_sleep_time)) '(:r0))
		(vp-shl-cr 1 :r0)
		(vp-min-cr 2000 :r0)
		(assign '(:r0) '((:rsp slot_sleep_time)))
		(goto 'recv_loop)
	(endif)

	;got data: reset sleep time to 100
	(assign '(100) '(:r1))
	(assign '(:r1) '((:rsp slot_sleep_time)))

	;update buf and remaining with bytes received (:r0 = recvd)
	(assign '((& :rsp slot_cb)) '(:r3))
	(load-fields :r3 '(cb_recv_buf cb_recv_remaining) '(:r1 :r2))
	(vp-add-rr :r0 :r1)
	(vp-sub-rr :r0 :r2)
	(save-fields :r3 '(cb_recv_buf cb_recv_remaining) '(:r1 :r2))
	(goto 'recv_loop)

(vp-label 'recv_done)
	(assign '(0) '(:r0))
	(goto 'recv_exit)

(vp-label 'recv_error)
	(assign '(-1) '(:r0))

(vp-label 'recv_exit)
	(exit :host_net :recv_all '(:r0))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'recv_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :recv
		'((:r0 cb_recv_handle) (:r0 cb_recv_buf) (:r0 cb_recv_remaining)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_recv_recvd)))
	(vp-ret)

(def-func-end)

(def-method :host_net :link)
	;started by kernel for each network link
	;trashes
	;:r0-:r14, :d0-:d15

	(structure cb_link 0
		(pubyte host)
		(long port handle))

	(structure slot 0
		(struct cb cb_link_size)
		(ptr params pdata msg data)
		(long listen_handle conn_handle port is_server retries))

	(vp-rdef (cb func tmp) (method-input :sys_task :callback))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))
	(vp-rdef (parse_port parse_server parse_ch) '(:r2 :r3 :r4))
	(vp-rdef (parse_scan) '(:r0))
	(vp-rdef (poll_res) (method-output :host_net :poll))

	(vp-alloc slot_size)

	;read params msg from kernel
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(save-fields :rsp '(slot_params slot_pdata) `(,params_msg ,params_data))

	;default port = 3333, is_server = 0
	(vp-simd vp-cpy-cr '(3333 0) `(,parse_port ,parse_server))

	;check first char
	(vp-load-rcr-ub params_data 0 parse_ch)
	(vpif `(,parse_ch = 58)) ; ':' -> listen mode
		(vp-cpy-cr 1 parse_server) ; is_server = 1
		(vp-add-cr 1 params_data) ; p++
		(vp-load-rcr-ub params_data 0 parse_ch)
		(vpif `(,parse_ch >= 48) `(,parse_ch <= 57))
			(vp-cpy-cr 0 parse_port) ; port = 0
		(vp-label 'parse_server_port)
			(vp-sub-cr 48 parse_ch)
			(vp-mul-cr 10 parse_port)
			(vp-add-rr parse_ch parse_port)
			(vp-add-cr 1 params_data)
			(vp-load-rcr-ub params_data 0 parse_ch)
			(gotoif `(,parse_ch < 48) 'parse_done)
			(gotoif `(,parse_ch <= 57) 'parse_server_port)
		(endif)
		(goto 'parse_done)
	(endif)

	;connect mode: scan for ':'
	(vp-cpy-rr params_data parse_scan) ; scan pointer
(vp-label 'scan_loop)
	(vp-load-rcr-ub parse_scan 0 parse_ch)
	(gotoif `(,parse_ch = 0) 'parse_done)
	(vpif `(,parse_ch = 58)) ; ':'
		(vp-cpy-cr 0 parse_ch)
		(vp-store-rrc-b parse_ch parse_scan 0) ; null-terminate host string at ':'
		(vp-add-cr 1 parse_scan)
		(vp-load-rcr-ub parse_scan 0 parse_ch)
		(vpif `(,parse_ch >= 48) `(,parse_ch <= 57))
			(vp-cpy-cr 0 parse_port) ; port = 0
		(vp-label 'parse_client_port)
			(vp-sub-cr 48 parse_ch)
			(vp-mul-cr 10 parse_port)
			(vp-add-rr parse_ch parse_port)
			(vp-add-cr 1 parse_scan)
			(vp-load-rcr-ub parse_scan 0 parse_ch)
			(gotoif `(,parse_ch < 48) 'parse_done)
			(gotoif `(,parse_ch <= 57) 'parse_client_port)
		(endif)
		(goto 'parse_done)
	(endif)
	(vp-add-cr 1 parse_scan)
	(goto 'scan_loop)

(vp-label 'parse_done)
	(save-fields :rsp '(slot_port slot_is_server) `(,parse_port ,parse_server))

	(vpif `(,parse_server /= 0))
		;server mode
		;decrement task count for listener
		(call :sys_task :count '(-1))

		;listen on port
		(assign '((& :rsp slot_cb) (:rsp slot_port)) `(,cb ,func))
		(assign `(,func) `((,cb cb_link_port)))
		(call :sys_task :callback `(,cb ($ listen_callback)))
		(assign '((:rsp (+ slot_cb cb_link_handle))) '(:r0))
		(assign '(:r0) '((:rsp slot_listen_handle)))
		(gotoif '(:r0 <= 0) 'link_server_exit)

		;persistent accept loop
	(vp-label 'accept_loop)
		(assign '((& :rsp slot_cb) (:rsp slot_listen_handle)) `(,cb ,func))
		(assign `(,func) `((,cb cb_link_handle)))
		(call :sys_task :callback `(,cb ($ accept_callback)))
		(assign '((:rsp (+ slot_cb cb_link_handle))) '(:r0))
		(assign '(:r0) '((:rsp slot_conn_handle)))
		(vpif '(:r0 > 0))
			;spawn connection worker task
			;all :conn reads, the handle, the seal flag and two keys, 0 but
			;the handle: not sealed
			(call :sys_mail :alloc '(80) '((:rsp slot_msg) (:rsp slot_data)))
			(call :sys_mem :fill '((:rsp slot_data) 80 0))
			(call :sys_task :start `((@ ,(f-path :host_net :conn))) '(_ _ :r2 :r3 :r4))
			(load-fields :rsp '(slot_msg slot_data slot_conn_handle) '(:r0 :r1 :r5))
			(save-net-id :r0 +msg_dest :r2 :r3 :r4)
			(assign '(:r5) '((:r1 0)))
			(call :sys_mail :send '(:r0))
		(endif)
		(call :sys_task :sleep '(10000)) ; 10ms
		(goto 'accept_loop)

		;close listening socket
		(host-net-call :host_net :close '((:rsp slot_listen_handle)))
	(vp-label 'link_server_exit)
		(call :sys_task :count '(1))
	(else)
		;client mode: connect to host:port
		(assign '((& :rsp slot_cb) (:rsp slot_pdata) (:rsp slot_port)) `(,cb ,func ,tmp))
		(assign `(,func ,tmp) `((,cb cb_link_host) (,cb cb_link_port)))
		(call :sys_task :callback `(,cb ($ connect_callback)))
		(assign '((:rsp (+ slot_cb cb_link_handle))) '(:r0))
		(assign '(:r0) '((:rsp slot_conn_handle)))
		(gotoif '(:r0 <= 0) 'link_exit)

		;wait for connect to complete
		(vp-xor-rr :r0 :r0)
		(assign '(:r0) '((:rsp slot_retries)))
	(vp-label 'poll_loop)
		(host-net-call :host_net :poll '((:rsp slot_conn_handle)) `(,poll_res))
		;bit 1 (POLLOUT) = connected
		(vp-cpy-rr poll_res tmp)
		(vp-and-cr 2 tmp)
		(gotoif `(,tmp /= 0) 'poll_connected)
		;bit 2 (POLLERR) = error
		(vp-cpy-rr poll_res tmp)
		(vp-and-cr 4 tmp)
		(vpif `(,tmp /= 0))
			(host-net-call :host_net :close '((:rsp slot_conn_handle)))
			(goto 'link_exit)
		(endif)
		(assign '((:rsp slot_retries)) '(:r6))
		(vp-add-cr 1 :r6)
		(vpif '(:r6 > 500)) ; 5s timeout
			(host-net-call :host_net :close '((:rsp slot_conn_handle)))
			(goto 'link_exit)
		(endif)
		(assign '(:r6) '((:rsp slot_retries)))
		(call :sys_task :sleep '(10000)) ; 10ms
		(goto 'poll_loop)

	(vp-label 'poll_connected)
		;spawn connection worker task, not sealed, as above
		(call :sys_mail :alloc '(80) '((:rsp slot_msg) (:rsp slot_data)))
		(call :sys_mem :fill '((:rsp slot_data) 80 0))
		(call :sys_task :start `((@ ,(f-path :host_net :conn))) '(_ _ :r2 :r3 :r4))
		(load-fields :rsp '(slot_msg slot_data slot_conn_handle) '(:r0 :r1 :r5))
		(save-net-id :r0 +msg_dest :r2 :r3 :r4)
		(assign '(:r5) '((:r1 0)))
		(call :sys_mail :send '(:r0))
	(endif)

(vp-label 'link_exit)
	;free params msg
	(call :sys_mail :free '((:rsp slot_params)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'listen_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :listen '((:r0 cb_link_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(vp-label 'accept_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :accept '((:r0 cb_link_handle)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(vp-label 'connect_callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :connect '((:r0 cb_link_host) (:r0 cb_link_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 cb_link_handle)))
	(vp-ret)

(def-func-end)

(def-method :host_net :conn)
	;started for each network connection
	;trashes
	;:r0-:r7, :r13-:r14, :d0-:d15

	(structure slot 0
		(struct lk_node lk_node_size)
		(struct keys 64)
		(ptr msg data)
		(long conn_handle sealed live))

	(vp-rdef (tmp))
	(vp-rdef (lst iter_begin iter_end) (method-output :array :get_both))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))

	(vp-alloc slot_size)

	;decrement task count
	;don't count links in load balancing
	(call :sys_task :count '(-3))

	;init and add link node to link array
	(vp-rdef (node zero one))
	(assign '((& :rsp slot_lk_node) 0 1) `(,node ,zero ,one))
	(save-fields node
		`(lk_node_task_count lk_node_peer_pid lk_node_sent lk_node_remote
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		`(,zero ,zero ,zero ,one ,zero ,zero ,zero ,zero))
	(assign '((@ sys/statics/statics)) '(:r7))
	(assign '((:r7 statics_sys_mail_links_array) (& :rsp slot_lk_node)) '(:r0 :r1))
	(call :array :push_back '(:r0 :r1))

	;read params msg: the handle, whether it is sealed, and its two keys,
	;the one the out link seals with and the one the in link opens with
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `((,params_data 0)) '(:r2))
	(assign `(:r2 (,params_data +long_size)) '((:rsp slot_conn_handle) :r2))
	(assign `(:r2 (& :rsp slot_keys) (,params_data 16)) '((:rsp slot_sealed) :r3 :r2))
	(assign `(:r2 (,params_data 24)) '((:r3 0) :r2))
	(assign `(:r2 (,params_data 32)) '((:r3 8) :r2))
	(assign `(:r2 (,params_data 40)) '((:r3 16) :r2))
	(assign `(:r2 (,params_data 48)) '((:r3 24) :r2))
	(assign `(:r2 (,params_data 56)) '((:r3 32) :r2))
	(assign `(:r2 (,params_data 64)) '((:r3 40) :r2))
	(assign `(:r2 (,params_data 72)) '((:r3 48) :r2))
	(assign '(:r2) '((:r3 56)))
	(call :sys_mail :free `(,params_msg))

	;the handle again: the free is declared to trash where it was
	(assign '((:rsp slot_conn_handle)) '(:r2))
	(gotoif '(:r2 <= 0) 'conn_exit)

	;the in and out links have lk_node, here, and the socket till each says
	;it has gone, live, the last thing it does
	(assign '(2) '(:r0))
	(assign '(:r0) '((:rsp slot_live)))

	;start out link and send params, with the key it seals with
	(call :sys_mail :alloc '(64) '((:rsp slot_msg) (:rsp slot_data)))
	(call :sys_task :start `((@ ,(f-path :host_net :out))) '(_ _ :r2 :r3 :r4))
	(assign '((:rsp slot_msg) (:rsp slot_data) (& :rsp slot_lk_node) (:rsp slot_conn_handle)) '(:r0 :r1 :r5 :r6))
	(save-net-id :r0 +msg_dest :r2 :r3 :r4)
	(save-fields :r1 '(0 +ptr_size) '(:r5 :r6))
	(assign '((:rsp slot_sealed)) '(:r5))
	(assign '(:r5 (& :rsp slot_keys)) '((:r1 16) :r6))
	(assign '((:r6 0)) '(:r5))
	(assign '(:r5 (:r6 8)) '((:r1 24) :r5))
	(assign '(:r5 (:r6 16)) '((:r1 32) :r5))
	(assign '(:r5 (:r6 24)) '((:r1 40) :r5))
	(assign '(:r5 (& :rsp slot_live)) '((:r1 48) :r5))
	(assign '(:r5) '((:r1 56)))
	(call :sys_mail :send '(:r0))

	;start in link and send params, with the key it opens with
	(call :sys_mail :alloc '(64) '((:rsp slot_msg) (:rsp slot_data)))
	(call :sys_task :start `((@ ,(f-path :host_net :in))) '(_ _ :r2 :r3 :r4))
	(assign '((:rsp slot_msg) (:rsp slot_data) (& :rsp slot_lk_node) (:rsp slot_conn_handle)) '(:r0 :r1 :r5 :r6))
	(save-net-id :r0 +msg_dest :r2 :r3 :r4)
	(save-fields :r1 '(0 +ptr_size) '(:r5 :r6))
	(assign '((:rsp slot_sealed)) '(:r5))
	(assign '(:r5 (& :rsp slot_keys)) '((:r1 16) :r6))
	(assign '((:r6 32)) '(:r5))
	(assign '(:r5 (:r6 40)) '((:r1 24) :r5))
	(assign '(:r5 (:r6 48)) '((:r1 32) :r5))
	(assign '(:r5 (:r6 56)) '((:r1 40) :r5))
	(assign '(:r5 (& :rsp slot_live)) '((:r1 48) :r5))
	(assign '(:r5) '((:r1 56)))
	(call :sys_mail :send '(:r0))

	;wait till link dies
(vp-label 'conn_wait_loop)
	(call :sys_task :sleep '(100000))
	(assign '((& :rsp slot_lk_node)) '(:r0))
	(assign '((:r0 lk_node_task_count i)) `(,tmp))
	(gotoif `(,tmp /= -1) 'conn_wait_loop)

	;wait for the in and out links to go before the socket is closed and
	;lk_node with this frame: a time is not enough, one that is not run in
	;it reads what has gone. The out link is woken if asleep, and the link
	;is said to be closed again each time, a ping read can undo it
(vp-label 'conn_gone_loop)
	(assign '((& :rsp slot_lk_node) -1) '(:r0 :r1))
	(assign '(:r1) '((:r0 lk_node_task_count i)))
	(call :sys_task :wake_links)
	(call :sys_task :sleep '(1000))
	(assign '((:rsp slot_live)) '(:r0))
	(gotoif '(:r0 /= 0) 'conn_gone_loop)

	;close socket
	(host-net-call :host_net :close '((:rsp slot_conn_handle)))

(vp-label 'conn_exit)
	;remove link node from link array
	(assign '((@ sys/statics/statics)) '(:r7))
	(assign '((:r7 statics_sys_mail_links_array)) '(:r0))
	(call :array :get_both '(:r0) `(,lst ,iter_begin ,iter_end))
	(assign '((& :rsp slot_lk_node)) '(:r3))
(vp-label 'find_link_loop)
	(gotoif `(,iter_begin = ,iter_end) 'conn_done)
	(assign `((,iter_begin 0)) '(:r4))
	(vpif '(:r4 = :r3))
		(assign '((@ sys/statics/statics)) '(:r7))
		(assign '((:r7 statics_sys_mail_links_array)) '(:r0))
		(call :array :erase `(:r0 ,iter_begin))
		(goto 'conn_done)
	(endif)
	(vp-add-cr +ptr_size iter_begin)
	(goto 'find_link_loop)

(vp-label 'conn_done)
	;restore task count
	(call :sys_task :count '(3))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :host_net :out)
	;trashes
	;:r0-:r14, :d0-:d15

	(structure slot 0
		(struct ping_pkt +net_ping_pkt_size)
		(struct frag_pkt +net_frag_pkt_size)
		(struct skey 32)
		(struct nonce 16)
		(ptr lk_node key msg sbuf live)
		(long conn_handle then sealed count slen))

	(defun out-sealed (fail)
		;a sealed link: the packet in sbuf after its length, slen bytes,
		;sealed in place with the next count as its nonce, the length put in
		;front, and all of it sent
		(assign '((:rsp slot_count) (& :rsp slot_nonce)) '(:r0 :r1))
		(assign '(:r0) '((:r1 0)))
		(vp-add-cr 1 :r0)
		(assign '(:r0 (& :rsp slot_skey) (& :rsp slot_nonce) (:rsp slot_sbuf) (:rsp slot_slen))
			'((:rsp slot_count) :r0 :r1 :r2 :r4))
		(vp-add-cr +long_size :r2)
		(vp-cpy-rr :r2 :r3)
		(call :sys_crypto :aead_seal '(:r0 :r1 :r2 :r3 :r4))
		(load-fields :rsp '(slot_sbuf slot_slen) '(:r0 :r1))
		(vp-store-rrc :r1 :r0 0)
		(load-fields :rsp '(slot_conn_handle slot_sbuf slot_slen slot_lk_node) `(,send_handle ,send_buf ,send_rem ,send_node))
		(vp-add-cr (+ +long_size +aead_tag_size) send_rem)
		(call :host_net :send_all `(,send_handle ,send_buf ,send_rem ,send_node) `(,send_status))
		(gotoif `(,send_status < 0) fail))

	(defun out-ping (fail)
		;the ping, sealed or not
		(assign '((:rsp slot_sealed)) '(:r0))
		(vpif '(:r0 /= 0))
			(assign '((& :rsp slot_ping_pkt) (:rsp slot_sbuf)) '(:r0 :r1))
			(vp-add-cr +long_size :r1)
			(vp-cpy-cr +net_ping_pkt_size :r2)
			(assign '(:r2) '((:rsp slot_slen)))
			(call :sys_mem :copy '(:r0 :r1 :r2))
			(out-sealed fail)
		(else)
			(call :host_net :send_all `((:rsp slot_conn_handle) (& :rsp slot_ping_pkt) ,+net_ping_pkt_size (:rsp slot_lk_node)) `(,send_status))
			(gotoif `(,send_status < 0) fail)
		(endif))

	(vp-rdef (send_handle send_buf send_rem send_node) (method-input :host_net :send_all))
	(vp-rdef (send_status) (method-output :host_net :send_all))
	(vp-rdef (peer1 peer2 ready_key) (method-input :sys_mail :ready))
	(vp-rdef (ready_msg) (method-output :sys_mail :ready))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))

	(vp-alloc slot_size)

	(call :nodeid :create '(0) '((:rsp slot_key)))

	;read params msg, and of a sealed link its key, and a buffer to seal in
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `((,params_data 0) (,params_data +ptr_size)) '(:r2 :r3))
	(save-fields :rsp '(slot_lk_node slot_conn_handle) '(:r2 :r3))
	(assign `((,params_data 16)) '(:r2))
	(assign `(:r2 (& :rsp slot_skey) (,params_data 24)) '((:rsp slot_sealed) :r3 :r2))
	(assign `(:r2 (,params_data 32)) '((:r3 0) :r2))
	(assign `(:r2 (,params_data 40)) '((:r3 8) :r2))
	(assign `(:r2 (,params_data 48)) '((:r3 16) :r2))
	(assign `(:r2 (,params_data 56)) '((:r3 24) :r2))
	(assign '(:r2) '((:rsp slot_live)))
	(call :sys_mail :free `(,params_msg))
	(assign '(0) '(:r0))
	(save-fields :rsp '(slot_count slot_sbuf) '(:r0 :r0))
	(assign '((& :rsp slot_nonce)) '(:r1))
	(save-fields :r1 '(0 8) '(:r0 :r0))
	;the pads of the ping and the frag header, not written again
	(assign '((& :rsp slot_ping_pkt) (& :rsp slot_frag_pkt) 0) '(:r1 :r2 :r0))
	(assign '(:r0 :r0 (:rsp slot_sealed)) '((:r1 +net_ping_pkt_pad) (:r2 +net_frag_pkt_pad) :r0))
	(vpif '(:r0 /= 0))
		(call :sys_mem :alloc `(,(+ +long_size +net_frag_pkt_size lk_data_size +aead_tag_size)) '(:r0 _))
		(assign '(:r0) '((:rsp slot_sbuf)))
	(endif)

	;switch to link priority
	(call :sys_task :set_priority '(tk_out_link_priority))

	;prepare ping packet with node_id and system_id
	(vp-rdef (ping_pkt) '(:r4))
	(vp-rdef (wlen wtype) '(:r0 :r1))
	(vp-rdef (node1 node2) (method-output :sys_kernel :id))
	(assign `((& :rsp slot_ping_pkt) ,+net_ping_payload_size ,+net_wire_type_ping) `(,ping_pkt ,wlen ,wtype))
	(save-fields ping_pkt
		'(+net_ping_pkt_wire_length +net_ping_pkt_wire_type)
		`(,wlen ,wtype))
	(call :sys_kernel :id :nil `(,node1 ,node2))
	(save-node-id ping_pkt +net_ping_pkt_peer_node_id node1 node2)
	(call :sys_kernel :system_id :nil `(,node1 ,node2))
	(save-node-id ping_pkt +net_ping_pkt_peer_system_id node1 node2)
	(assign '((@ sys/statics/statics)) `(,node1))
	(assign `((,node1 statics_sys_task_task_count)) `(,node2))
	(assign `(,node2) `((,ping_pkt +net_ping_pkt_task_count)))

	;send initial ping
	(out-ping 'out_exit)
	(call :host_os :pii_time :nil '(:r0))
	(assign '(:r0) '((:rsp slot_then)))

	;outbound loop
(vp-label 'out_loop)
	;load peer node id
	(assign '((:rsp slot_lk_node)) '(:r3))
	(load-node-id :r3 lk_node_peer_node_id peer1 peer2)
	(vp-cpy-rr peer1 :r2)
	(vp-or-rr peer2 :r2)
	(vpif '(:r2 /= 0))
		(assign '((:rsp slot_key)) `(,ready_key))
		(call :sys_mail :ready `(,peer1 ,peer2 ,ready_key) `(,ready_msg))
	(else)
		(vp-cpy-cr 0 ready_msg)
	(endif)

	(vpif `(,ready_msg /= 0))
		;we have mail to transmit
		(assign `(,ready_msg) '((:rsp slot_msg)))
		;how much this link has carried
		(load-fields :rsp '(slot_lk_node slot_msg) '(:r0 :r1))
		(assign '((:r0 lk_node_sent) (:r1 +msg_length)) '(:r2 :r3))
		(vp-add-rr :r3 :r2)
		(assign '(:r2) '((:r0 lk_node_sent)))
		(vp-rdef (msg frag_pkt t0 t1 t2 t3 t4 t5 t6 t7 t8))
		(assign '((:rsp slot_msg) (& :rsp slot_frag_pkt)) `(,msg ,frag_pkt))
		(assign-fields
			msg
			`(+msg_length +msg_offset +msg_total
				,(+ +msg_dest +net_id_mbox_id)
				,(+ +msg_dest +net_id_node_id +node_id_node1)
				,(+ +msg_dest +net_id_node_id +node_id_node2)
				,(+ +msg_src +net_id_mbox_id)
				,(+ +msg_src +net_id_node_id +node_id_node1)
				,(+ +msg_src +net_id_node_id +node_id_node2))
			frag_pkt
			`(+net_frag_pkt_length +net_frag_pkt_offset +net_frag_pkt_total
				,(+ +net_frag_pkt_dest +net_id_mbox_id)
				,(+ +net_frag_pkt_dest +net_id_node_id +node_id_node1)
				,(+ +net_frag_pkt_dest +net_id_node_id +node_id_node2)
				,(+ +net_frag_pkt_src +net_id_mbox_id)
				,(+ +net_frag_pkt_src +net_id_node_id +node_id_node1)
				,(+ +net_frag_pkt_src +net_id_node_id +node_id_node2))
			`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))

		;wire header: wire_length = len + lk_frag_size, wire_type = +net_wire_type_frag
		(vp-add-cr lk_frag_size t0)
		(vp-cpy-cr +net_wire_type_frag t1)
		(save-fields frag_pkt
			'(+net_frag_pkt_wire_length +net_frag_pkt_wire_type)
			`(,t0 ,t1))

		(assign '((:rsp slot_sealed)) '(:r0))
		(vpif '(:r0 /= 0))
			;sealed: the frag header and its payload one packet, sealed
			(assign '((& :rsp slot_frag_pkt) (:rsp slot_sbuf)) '(:r0 :r1))
			(vp-add-cr +long_size :r1)
			(vp-cpy-cr +net_frag_pkt_size :r2)
			(call :sys_mem :copy '(:r0 :r1 :r2))
			(load-fields :rsp '(slot_msg slot_sbuf) '(:r5 :r1))
			(load-fields :r5 '(+msg_length +msg_data) '(:r2 :r0))
			(vp-add-cr (+ +long_size +net_frag_pkt_size) :r1)
			(vp-lea-rcr :r2 +net_frag_pkt_size :r3)
			(assign '(:r3) '((:rsp slot_slen)))
			(call :sys_mem :copy '(:r0 :r1 :r2))
			(out-sealed 'out_frag_fail)
		(else)
			;send frag header (72 bytes)
			(call :host_net :send_all `((:rsp slot_conn_handle) (& :rsp slot_frag_pkt) ,+net_frag_pkt_size (:rsp slot_lk_node)) `(,send_status))
			(gotoif `(,send_status < 0) 'out_frag_fail)

			;send payload data if len > 0
			(load-fields :rsp '(slot_conn_handle slot_msg slot_lk_node) `(,send_handle :r5 ,send_node))
			(assign '((:r5 +msg_length) (:r5 +msg_data)) `(,send_rem ,send_buf))
			(vpif `(,send_rem > 0))
				(call :host_net :send_all `(,send_handle ,send_buf ,send_rem ,send_node) `(,send_status))
				(gotoif `(,send_status < 0) 'out_frag_fail)
			(endif)
		(endif)

		;free msg
		(call :sys_mail :free '((:rsp slot_msg)))
		(goto 'out_loop)
	(vp-label 'out_frag_fail)
		(call :sys_mail :free '((:rsp slot_msg)))
		(goto 'out_exit)
	(endif)

	;no mail to send, sleep up to 5s or until woken by wake_links
	(call :sys_task :sleep '(5000000))

	;check if link closed
	(assign '((:rsp slot_lk_node)) '(:r1))
	(assign '((:r1 lk_node_task_count i)) '(:r2))
	(gotoif '(:r2 = -1) 'out_exit)

	;send heartbeat ping only if 5s has elapsed
	(call :host_os :pii_time :nil '(:r0))
	(assign '((:rsp slot_then)) '(:r1))
	(vp-cpy-rr :r0 :r2)
	(vp-sub-rr :r1 :r2)
	(vpif '(:r2 >= 5000000))
		(assign '(:r0 (@ sys/statics/statics) (& :rsp slot_ping_pkt)) '((:rsp slot_then) :r1 :r4))
		(assign '((:r1 statics_sys_task_task_count)) '(:r0))
		(assign '(:r0) '((:r4 +net_ping_pkt_task_count)))
		(out-ping 'out_exit)
	(endif)
	(goto 'out_loop)

(vp-label 'out_exit)
	;mark link closed
	(vp-rdef (node cnt zero))
	(assign '((:rsp slot_lk_node) -1 0) `(,node ,cnt ,zero))
	(save-fields node
		`(lk_node_task_count
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		`(,cnt ,zero ,zero ,zero ,zero))

	(call :nodeid :destroy '((:rsp slot_key)))
	(assign '((:rsp slot_sbuf)) '(:r0))
	(vpif '(:r0 /= 0))
		(call :sys_mem :free '(:r0))
	(endif)

	;gone, the last thing done with lk_node's frame
	(assign '((:rsp slot_live)) '(:r0))
	(assign '((:r0 0)) '(:r1))
	(vp-sub-cr 1 :r1)
	(assign '(:r1) '((:r0 0)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)

(def-method :host_net :in)
	;trashes
	;:r0-:r14, :d0-:d15

	(structure slot 0
		(struct ping_payload lk_node_size)
		(align)
		(nodeid node_id)
		(struct wire_hdr +net_wire_hdr_size)
		(struct rkey 32)
		(struct nonce 16)
		(ptr lk_node msg data frag_buf rbuf cursor live)
		(long conn_handle sealed count rlen)
		(uint frag_len))

	(defun in-take (dst len)
		;of a sealed link, len bytes of the record opened, to dst, each as
		;assign takes it
		(assign (list '(:rsp slot_cursor) dst len) '(:r0 :r1 :r2))
		(call :sys_mem :copy '(:r0 :r1 :r2) '(:r0 _))
		(assign '(:r0) '((:rsp slot_cursor))))

	(vp-rdef (recv_handle recv_buf recv_rem recv_node) (method-input :host_net :recv_all))
	(vp-rdef (recv_status) (method-output :host_net :recv_all))
	(vp-rdef (params_msg params_data) (method-output :sys_mail :mymail))

	(vp-alloc slot_size)

	;read params msg, and of a sealed link its key, and a buffer to open in
	(call :sys_mail :mymail :nil `(,params_msg ,params_data))
	(assign `((,params_data 0) (,params_data +ptr_size)) '(:r2 :r3))
	(save-fields :rsp '(slot_lk_node slot_conn_handle) '(:r2 :r3))
	(assign `((,params_data 16)) '(:r2))
	(assign `(:r2 (& :rsp slot_rkey) (,params_data 24)) '((:rsp slot_sealed) :r3 :r2))
	(assign `(:r2 (,params_data 32)) '((:r3 0) :r2))
	(assign `(:r2 (,params_data 40)) '((:r3 8) :r2))
	(assign `(:r2 (,params_data 48)) '((:r3 16) :r2))
	(assign `(:r2 (,params_data 56)) '((:r3 24) :r2))
	(assign '(:r2) '((:rsp slot_live)))
	(call :sys_mail :free `(,params_msg))
	(assign '(0) '(:r0))
	(save-fields :rsp '(slot_count slot_rbuf) '(:r0 :r0))
	(assign '((& :rsp slot_nonce)) '(:r1))
	(save-fields :r1 '(0 8) '(:r0 :r0))
	(assign '((:rsp slot_sealed)) '(:r0))
	(vpif '(:r0 /= 0))
		(call :sys_mem :alloc `(,(+ +net_frag_pkt_size lk_data_size +aead_tag_size)) '(:r0 _))
		(assign '(:r0) '((:rsp slot_rbuf)))
	(endif)

	;switch to link priority
	(call :sys_task :set_priority '(tk_in_link_priority))

	;get local node id
	(call :sys_kernel :id :nil '(:r0 :r1))
	(save-node-id :rsp slot_node_id :r0 :r1)

	;allocate private fragment buffer
	(call :sys_mem :alloc `(,(+ lk_frag_size lk_data_size)) '((:rsp slot_frag_buf) _))

	;inbound packet loop
(vp-label 'in_loop)
	(assign '((:rsp slot_sealed)) '(:r0))
	(vpif '(:r0 /= 0))
		;sealed: a record, its length, then the packet and its tag. Opened
		;with the next count as its nonce, or the link is dropped: one
		;changed, or sent again, or out of its order, is not taken
		(call :host_net :recv_all `((:rsp slot_conn_handle) (& :rsp slot_rlen) ,+long_size (:rsp slot_lk_node)) `(,recv_status))
		(gotoif `(,recv_status < 0) 'in_exit)
		(assign '((:rsp slot_rlen)) '(:r0))
		(gotoif `(:r0 < ,+net_wire_hdr_size) 'in_exit)
		(gotoif `(:r0 > ,(+ +net_frag_pkt_size lk_data_size)) 'in_exit)
		(load-fields :rsp '(slot_conn_handle slot_rbuf slot_rlen slot_lk_node) `(,recv_handle ,recv_buf ,recv_rem ,recv_node))
		(vp-add-cr +aead_tag_size recv_rem)
		(call :host_net :recv_all `(,recv_handle ,recv_buf ,recv_rem ,recv_node) `(,recv_status))
		(gotoif `(,recv_status < 0) 'in_exit)
		(assign '((:rsp slot_count) (& :rsp slot_nonce)) '(:r0 :r1))
		(assign '(:r0) '((:r1 0)))
		(vp-add-cr 1 :r0)
		(assign '(:r0) '((:rsp slot_count)))
		(assign '((& :rsp slot_rkey) (& :rsp slot_nonce) (:rsp slot_rbuf) (:rsp slot_rbuf) (:rsp slot_rlen)) '(:r0 :r1 :r2 :r3 :r4))
		(call :sys_crypto :aead_open '(:r0 :r1 :r2 :r3 :r4) '(:r0))
		(gotoif '(:r0 = 0) 'in_exit)
		(assign '((:rsp slot_rbuf)) '(:r0))
		(assign '(:r0) '((:rsp slot_cursor)))
		(in-take '(& :rsp slot_wire_hdr) +net_wire_hdr_size)
	(else)
		;read 8-byte wire header
		(call :host_net :recv_all `((:rsp slot_conn_handle) (& :rsp slot_wire_hdr) ,+net_wire_hdr_size (:rsp slot_lk_node)) `(,recv_status))
		(gotoif `(,recv_status < 0) 'in_exit)
	(endif)

	(assign '((& :rsp slot_wire_hdr)) '(:r4))
	(assign '((:r4 +net_wire_hdr_type)) '(:r0))
	(gotoif '(:r0 = +net_wire_type_ping) 'in_ping)
	(gotoif '(:r0 = +net_wire_type_frag) 'in_frag)
	;unknown wire type, connection error
	(goto 'in_exit)

(vp-label 'in_ping)
	;read the ping payload, 40 bytes, the start of a link's record
	(assign '((:rsp slot_sealed)) '(:r0))
	(vpif '(:r0 /= 0))
		(in-take '(& :rsp slot_ping_payload) +net_ping_payload_size)
	(else)
		(call :host_net :recv_all `((:rsp slot_conn_handle) (& :rsp slot_ping_payload) ,+net_ping_payload_size (:rsp slot_lk_node)) `(,recv_status))
		(gotoif `(,recv_status < 0) 'in_exit)
	(endif)

	;update peer node id, peer system id, and task count on lk_node
	(vp-rdef (src dst t0 t1 t2 t3 t4))
	(assign '((& :rsp slot_ping_payload) (:rsp slot_lk_node)) `(,src ,dst))
	(assign-fields
		src
		`(lk_node_task_count
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		dst
		`(lk_node_task_count
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		`(,t0 ,t1 ,t2 ,t3 ,t4))

	;wake outbound link in case mail was waiting for this peer
	(call :sys_task :wake_links)
	(goto 'in_check_exit)

(vp-label 'in_frag)
	;read 64-byte frag payload header into frag_buf
	(assign '((:rsp slot_sealed)) '(:r0))
	(vpif '(:r0 /= 0))
		(in-take '(:rsp slot_frag_buf) lk_frag_size)
	(else)
		(call :host_net :recv_all `((:rsp slot_conn_handle) (:rsp slot_frag_buf) ,lk_frag_size (:rsp slot_lk_node)) `(,recv_status))
		(gotoif `(,recv_status < 0) 'in_exit)
	(endif)

	;read payload data directly after header in frag_buf
	(assign '((:rsp slot_frag_buf)) '(:r0))
	(assign '((:r0 lk_frag_length)) '(:r1))
	(assign '(:r1) '((:rsp slot_frag_len)))
	(gotoif `(:r1 > ,lk_data_size) 'in_exit)
	(vpif '(:r1 > 0))
		(assign '((:rsp slot_sealed)) '(:r0))
		(vpif '(:r0 /= 0))
			;all of it inside the record that was opened
			(load-fields :rsp '(slot_rlen slot_frag_len) '(:r2 :r1))
			(vp-add-cr (+ lk_frag_size +net_wire_hdr_size) :r1)
			(gotoif '(:r1 > :r2) 'in_exit)
			(assign '((:rsp slot_frag_buf)) '(:r1))
			(vp-add-cr lk_frag_size :r1)
			(in-take :r1 '(:rsp slot_frag_len))
		(else)
			(load-fields :rsp '(slot_conn_handle slot_frag_buf slot_frag_len slot_lk_node) `(,recv_handle ,recv_buf ,recv_rem ,recv_node))
			(vp-add-cr lk_frag_size recv_buf)
			(call :host_net :recv_all `(,recv_handle ,recv_buf ,recv_rem ,recv_node) `(,recv_status))
			(gotoif `(,recv_status < 0) 'in_exit)
		(endif)
	(endif)

	;is this msg part of a parcel for this node
	(assign '((:rsp slot_frag_buf)) '(:r0))
	(assign '((:r0 lk_frag_total)) '(:r1))
	(load-node-id :r0 (+ lk_frag_dest +net_id_node_id) :r2 :r3)
	(load-node-id :rsp slot_node_id :r4 :r5)
	(vpif '(:r1 /= 0) '(:r2 = :r4) '(:r3 = :r5))
		;pass to sys_mail :in with status_buf = 0 (no status word, no sync)
		(call :sys_mail :in `(:r0 0 :r0 ,(+ lk_frag_size lk_data_size)))
	(else)
		;single packet or routed onward
		(call :sys_mail :alloc '((:rsp slot_frag_len)) '((:rsp slot_msg) (:rsp slot_data)))
		;copy frag data
		(vp-rdef (msg rx_frag t0 t1 t2 t3 t4 t5 t6 t7 t8))
		(load-fields :rsp '(slot_msg slot_frag_buf) `(,msg ,rx_frag))
		(assign-fields
			rx_frag
			`(lk_frag_length lk_frag_offset lk_frag_total
				,(+ lk_frag_dest +net_id_mbox_id)
				,(+ lk_frag_dest +net_id_node_id +node_id_node1)
				,(+ lk_frag_dest +net_id_node_id +node_id_node2)
				,(+ lk_frag_src +net_id_mbox_id)
				,(+ lk_frag_src +net_id_node_id +node_id_node1)
				,(+ lk_frag_src +net_id_node_id +node_id_node2))
			msg
			`(+msg_length +msg_offset +msg_total
				,(+ +msg_dest +net_id_mbox_id)
				,(+ +msg_dest +net_id_node_id +node_id_node1)
				,(+ +msg_dest +net_id_node_id +node_id_node2)
				,(+ +msg_src +net_id_mbox_id)
				,(+ +msg_src +net_id_node_id +node_id_node1)
				,(+ +msg_src +net_id_node_id +node_id_node2))
			`(,t0 ,t1 ,t2 ,t3 ,t4 ,t5 ,t6 ,t7 ,t8))
		(load-fields :rsp '(slot_data slot_frag_buf slot_frag_len) '(:r1 :r0 :r2))
		(vp-add-cr lk_frag_size :r0)
		(call :sys_mem :copy '(:r0 :r1 :r2))
		(call :sys_mail :send '((:rsp slot_msg)))
	(endif)
	(goto 'in_check_exit)

(vp-label 'in_check_exit)
	;check if link closed
	(assign '((:rsp slot_lk_node)) '(:r1))
	(assign '((:r1 lk_node_task_count i)) '(:r0))
	(gotoif '(:r0 = -1) 'in_exit)
	(goto 'in_loop)

(vp-label 'in_exit)
	;free private fragment buffer, and the buffer records are opened in
	(call :sys_mem :free '((:rsp slot_frag_buf)))
	(assign '((:rsp slot_rbuf)) '(:r0))
	(vpif '(:r0 /= 0))
		(call :sys_mem :free '(:r0))
	(endif)

	;mark link closed
	(vp-rdef (node cnt zero))
	(assign '((:rsp slot_lk_node) -1 0) `(,node ,cnt ,zero))
	(save-fields node
		`(lk_node_task_count
			,(+ lk_node_peer_node_id +node_id_node1)
			,(+ lk_node_peer_node_id +node_id_node2)
			,(+ lk_node_peer_system_id +node_id_node1)
			,(+ lk_node_peer_system_id +node_id_node2))
		`(,cnt ,zero ,zero ,zero ,zero))

	(call :sys_task :wake_links)

	;gone, the last thing done with lk_node's frame
	(assign '((:rsp slot_live)) '(:r0))
	(assign '((:r0 0)) '(:r1))
	(vp-sub-cr 1 :r1)
	(assign '(:r1) '((:r0 0)))
	(vp-free slot_size)
	(vp-ret)

(def-func-end)
