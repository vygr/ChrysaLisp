(def-method :host_net :lisp_send)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :host_net :lisp_send '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(list-bind-args :r1 '(:r0 :r1) '(:num :obj))
	(assign '((:r1 +str_length) (& :r1 +str_data)) '(:r2 :r1))
	(host-net-call :host_net :send '(:r0 :r1 :r2) '(:r0))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :host_net :lisp_send '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-send handle str)" +error_msg_wrong_types))
	(signature '(:NUM :str)))

(def-func-end)

(def-method :host_net :lisp_recv)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(def-vars
		(ptr this buf ret)
		(long handle max_len ret_bytes))

	(entry :host_net :lisp_recv '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(push-scope)
	(assign '(:r0) {this})

	(list-bind-args :r1 '(:r0 :r1) '(:num :num))
	(assign '(:r0 :r1) {handle, max_len})

	(call :str :create_from_buffer {0, max_len} {buf})
	(host-net-call :host_net :recv {handle, &buf->+str_data, max_len} {ret_bytes})

	(vpif {ret_bytes >= 0})
		(assign {ret_bytes} {buf->+str_length})
		(assign {buf} {ret})
	(else)
		(call :str :destroy {buf})
		(call :obj :ref {this->+lisp_sym_nil} {ret})
	(endif)

	(exit :host_net :lisp_recv {this, ret})
	(pop-scope)
	(return)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-recv handle max_len)" +error_msg_wrong_types))
	(signature '(:NUM :NUM)))

(def-func-end)

