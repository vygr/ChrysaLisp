(def-method :host_net :lisp_send)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :r13-:r14, :d0-:d15

	;send() is a thin syscall; keep it on the task stack so the
	;service hot path does not bounce through the kernel mailbox.
	(entry :host_net :lisp_send '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(list-bind-args :r1 '(:r0 :r1) '(:num :obj))
	(assign '((:r1 +str_length) (& :r1 +str_data)) '(:r2 :r1))
	(host-net-call :host_net :send '(:r0 :r1 :r2) '(:r0))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :host_net :lisp_send '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-send handle str)" +error_msg_wrong_types))
	(signature '(:NUM :str))

(def-func-end)

(def-method :host_net :lisp_recv)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this buf ret)
		(long handle max_len ret_bytes))

	(entry :host_net :lisp_recv '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:num :num))
	(save-fields :rsp '(slot_handle slot_max_len) '(:r0 :r1))

	(call :str :create_from_buffer '(0 (:rsp slot_max_len)) '(:r0))
	(assign '(:r0) '((:rsp slot_buf)))

	;recv into the pre-allocated str on the host stack
	(call :sys_task :callback '(:rsp ($ callback)))

	(assign '((:rsp slot_ret_bytes)) '(:r0))
	(vpif '(:r0 >= 0))
		(assign '((:rsp slot_buf)) '(:r1))
		(assign '(:r0 :r1) '((:r1 +str_length) (:rsp slot_ret)))
	(else)
		(call :str :destroy '((:rsp slot_buf)))
		(assign '((:rsp slot_this)) '(:r0))
		(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r0))
		(assign '(:r0) '((:rsp slot_ret)))
	(endif)

	(exit :host_net :lisp_recv '((:rsp slot_this) (:rsp slot_ret)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(assign '((:r0 slot_buf)) '(:r1))
	(host-net-call :host_net :recv
		'((:r0 slot_handle) (& :r1 +str_data) (:r0 slot_max_len)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_ret_bytes)))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-recv handle max_len)" +error_msg_wrong_types))
	(signature '(:NUM :NUM))

(def-func-end)

