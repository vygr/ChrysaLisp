(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "./class.inc")

(def-method :host_net :lisp_init)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(long c_result))

	(entry :host_net :lisp_init '(:r0 :r1))
	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))

	;WSAStartup / SIGPIPE on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp local_c_result)) '(:r1))

	(exit :host_net :lisp_init '((:rsp local_this) :r1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :init '() '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 local_c_result)))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-init)" +error_msg_wrong_types)))

(def-func-end)

(def-method :host_net :lisp_deinit)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(long c_result))

	(entry :host_net :lisp_deinit '(:r0 :r1))
	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))

	;WSACleanup / close all fds on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp local_c_result)) '(:r1))

	(exit :host_net :lisp_deinit '((:rsp local_this) :r1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :deinit '() '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 local_c_result)))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-deinit)" +error_msg_wrong_types)))

(def-func-end)

(def-method :host_net :lisp_connect)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(pubyte host)
		(long port c_handle))

	(entry :host_net :lisp_connect '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:str :num))
	(assign '(:r0 :r1) '((:rsp local_host) (:rsp local_port)))

	;getaddrinfo + connect on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp local_c_handle)) '(:r1))

	(exit :host_net :lisp_connect '((:rsp local_this) :r1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :connect '((:r0 local_host) (:r0 local_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 local_c_handle)))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-connect host port)" +error_msg_wrong_types))
	(signature '(:str :NUM)))

(def-func-end)

(def-method :host_net :lisp_listen)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(long port c_handle))

	(entry :host_net :lisp_listen '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r0) '(:num))
	(assign '(:r0) '((:rsp local_port)))

	;socket / bind / listen on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp local_c_handle)) '(:r1))

	(exit :host_net :lisp_listen '((:rsp local_this) :r1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :listen '((:r0 local_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 local_c_handle)))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-listen port)" +error_msg_wrong_types))
	(signature '(:NUM)))

(def-func-end)

(def-method :host_net :lisp_accept)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this)
		(long handle c_handle))

	(entry :host_net :lisp_accept '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r0) '(:num))
	(assign '(:r0) '((:rsp local_handle)))

	;accept on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp local_c_handle)) '(:r1))

	(exit :host_net :lisp_accept '((:rsp local_this) :r1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :accept '((:r0 local_handle)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 local_c_handle)))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-accept handle)" +error_msg_wrong_types))
	(signature '(:NUM)))

(def-func-end)

(def-method :host_net :lisp_send)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	;send() is a thin syscall; keep it on the task stack so the
	;service hot path does not bounce through the kernel mailbox.
	(entry :host_net :lisp_send '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-push :r0)
	(list-bind-args :r1 '(:r0 :r1) '(:num :obj))
	(assign '((:r1 +str_length) (& :r1 +str_data)) '(:r2 :r1))
	(host-net-call :host_net :send '(:r0 :r1 :r2) '(:r0))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :host_net :lisp_send '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-send handle str)" +error_msg_wrong_types))
	(signature '(:NUM :str)))

(def-func-end)

(def-method :host_net :lisp_recv)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(structure local 0
		(ptr this buf ret)
		(long handle max_len ret_bytes))

	(entry :host_net :lisp_recv '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc local_size)
	(assign '(:r0) '((:rsp local_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:num :num))
	(assign '(:r0 :r1) '((:rsp local_handle) (:rsp local_max_len)))

	(call :str :create_from_buffer '(0 (:rsp local_max_len)) '(:r0))
	(assign '(:r0) '((:rsp local_buf)))

	;recv into the pre-allocated str on the host stack
	(call :sys_task :callback '(:rsp ($ callback)))

	(assign '((:rsp local_ret_bytes)) '(:r0))
	(vpif '(:r0 >= 0))
		(assign '((:rsp local_buf)) '(:r1))
		(assign '(:r0) '((:r1 +str_length)))
		(assign '(:r1) '((:rsp local_ret)))
	(else)
		(call :str :destroy '((:rsp local_buf)))
		(assign '((:rsp local_this)) '(:r0))
		(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r0))
		(assign '(:r0) '((:rsp local_ret)))
	(endif)

	(exit :host_net :lisp_recv '((:rsp local_this) (:rsp local_ret)))
	(vp-free local_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(assign '((:r0 local_buf)) '(:r1))
	(host-net-call :host_net :recv
		'((:r0 local_handle) (& :r1 +str_data) (:r0 local_max_len)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 local_ret_bytes)))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-recv handle max_len)" +error_msg_wrong_types))
	(signature '(:NUM :NUM)))

(def-func-end)

(def-method :host_net :lisp_close)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	(entry :host_net :lisp_close '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(list-bind-args :r1 '(:r0) '(:num))
	(host-net-call :host_net :close '(:r0) '(:r0))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :host_net :lisp_close '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-close handle)" +error_msg_wrong_types))
	(signature '(:NUM)))

(def-func-end)

(def-method :host_net :lisp_poll)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :f0-:f15

	;poll() is timeout-0 and runs on the service timer. Do not
	;route it through :callback or every tick pays a kernel RPC.
	(entry :host_net :lisp_poll '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 1)

	(vp-push :r0)
	(list-bind-args :r1 '(:r0) '(:num))
	(host-net-call :host_net :poll '(:r0) '(:r0))
	(call :num :create '(:r0) '(:r1))
	(vp-pop :r0)

	(exit :host_net :lisp_poll '(:r0 :r1))
	(vp-ret)

(errorcase
(vp-label 'error)
	(jump :lisp :repl_error '(:r0 :r1 "(net-poll handle)" +error_msg_wrong_types))
	(signature '(:NUM)))

(def-func-end)
