(include "lib/asm/func.inc")
(include "sys/link/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "./class.inc")

(def-method :host_net :lisp_init)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(long c_result))

	(entry :host_net :lisp_init '(:r0 :r1))
	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))

	;WSAStartup / SIGPIPE on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp slot_c_result)) '(:r1))

	(exit :host_net :lisp_init '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :init '() '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_c_result)))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-init)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_net :lisp_deinit)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(long c_result))

	(entry :host_net :lisp_deinit '(:r0 :r1))
	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))

	;WSACleanup / close all fds on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp slot_c_result)) '(:r1))

	(exit :host_net :lisp_deinit '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :deinit '() '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_c_result)))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-deinit)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_net :lisp_connect)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(pubyte host)
		(long port c_handle))

	(entry :host_net :lisp_connect '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:str :num))
	(save-fields :rsp '(slot_host slot_port) '(:r0 :r1))

	;getaddrinfo + connect on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp slot_c_handle)) '(:r1))

	(exit :host_net :lisp_connect '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-net-call :host_net :connect '((:r0 slot_host) (:r0 slot_port)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_c_handle)))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-connect host port)" +error_msg_wrong_types))
	(signature '(:str :NUM))

(def-func-end)

