(def-method :host_net :lisp_udp_send)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(pubyte host buf)
		(long handle port len ret_bytes))

	(entry :host_net :lisp_udp_send '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3) '(:num :str :num :obj))
	(assign '((:r3 +str_length) (& :r3 +str_data)) '(:r4 :r3))
	(save-fields :rsp '(slot_handle slot_host slot_port slot_buf slot_len) '(:r0 :r1 :r2 :r3 :r4))

	;sendto on host stack
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp slot_ret_bytes)) '(:r1))

	(exit :host_net :lisp_udp_send '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(assign '((:r0 slot_host) (:r0 slot_buf) (:r0 slot_port) (:r0 slot_len) (:r0 slot_handle))
		'(:r1 :r3 :r2 :r4 :r0))
	(host-net-call :host_net :udp_send '(:r0 :r1 :r2 :r3 :r4) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_ret_bytes)))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-udp-send handle host port str)" +error_msg_wrong_types))
	(signature '(:NUM :str :NUM :str))

(def-func-end)

(def-method :host_net :lisp_udp_recv)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this buf ip_str port_num ret)
		(long handle max_len port ret_bytes)
		(struct ip_buf 64))

	(entry :host_net :lisp_udp_recv '(:r0 :r1))
	(errorif-lisp-args-sig 'error :r1 2)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0 :r1) '(:num :num))
	(save-fields :rsp '(slot_handle slot_max_len) '(:r0 :r1))

	(call :str :create_from_buffer '(0 (:rsp slot_max_len)) '(:r0))
	(assign '(:r0) '((:rsp slot_buf)))

	;recvfrom on host stack
	(call :sys_task :callback '(:rsp ($ callback)))

	(assign '((:rsp slot_ret_bytes)) '(:r0))
	(vpif '(:r0 > 0))
		(assign '((:rsp slot_buf)) '(:r1))
		(assign '(:r0) '((:r1 +str_length)))

		(call :str :create_from_cstr '((& :rsp slot_ip_buf)) '(:r0))
		(assign '(:r0) '((:rsp slot_ip_str)))

		(call :num :create '((:rsp slot_port)) '(:r0))
		(assign '(:r0) '((:rsp slot_port_num)))

		(call :list :create :nil '(:r0))
		(assign '(:r0) '((:rsp slot_ret)))

		(call :list :push_back '((:rsp slot_ret) (:rsp slot_buf)))
		(call :list :push_back '((:rsp slot_ret) (:rsp slot_ip_str)))
		(call :list :push_back '((:rsp slot_ret) (:rsp slot_port_num)))
	(else)
		(call :str :destroy '((:rsp slot_buf)))
		(assign '((:rsp slot_this)) '(:r0))
		(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r0))
		(assign '(:r0) '((:rsp slot_ret)))
	(endif)

	(exit :host_net :lisp_udp_recv '((:rsp slot_this) (:rsp slot_ret)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(assign '((:r0 slot_buf) (:r0 slot_max_len) (& :r0 slot_ip_buf) (& :r0 slot_port) (:r0 slot_handle))
		'(:r1 :r2 :r3 :r4 :r5))
	(assign '((& :r1 +str_data) :r5) '(:r1 :r0))
	(host-net-call :host_net :udp_recv '(:r0 :r1 :r2 :r3 :r4) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_ret_bytes)))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-udp-recv handle max_len)" +error_msg_wrong_types))
	(signature '(:NUM :NUM))

(def-func-end)

(def-method :host_net :lisp_links)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r5, :d0-:d15

	;what this node knows of each link it has, a str each, the fields of
	;lib/net/links.inc: the node id of its peer, the system id of its
	;peer, the peer's load, and the bytes of mail sent on it. A link whose
	;peer has yet to say who it is gives ids of zeros

	(structure slot 0
		(ptr this ret iter_begin iter_end))

	(entry :host_net :lisp_links '(:r0 :r1))
	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(call :list :create :nil '(:r0))
	(assign '(:r0) '((:rsp slot_ret)))
	(fn-bind 'sys/statics/statics :r0)
	(call :array :get_both '((:r0 statics_sys_mail_links_array)) '(_ :r1 :r2))
	(assign '(:r2) '((:rsp slot_iter_end)))
	(loop-start)
		(assign '((:rsp slot_iter_end)) '(:r2))
		(breakif '(:r1 = :r2))
		(assign '((:r1 0)) '(:r0))
		(vp-add-cr +ptr_size :r1)
		(assign '(:r1) '((:rsp slot_iter_begin)))
		(call :str :create_from_buffer `((& :r0 0) ,lk_node_size) '(:r0))
		(call :list :push_back '((:rsp slot_ret) :r0))
		(assign '((:rsp slot_iter_begin)) '(:r1))
	(loop-end)

	(exit :host_net :lisp_links '((:rsp slot_this) (:rsp slot_ret)))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-links)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_net :lisp_drop)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r4, :r14, :d0-:d15

	;every link of this node that is over the network, and not shared
	;memory to a node of this machine, is told it is closed. Its tasks see
	;that and go, and its connection is closed after them. Its record
	;says which it is, lk_node_remote. How many there were is given: a
	;ping that comes as this is done can undo it, so it is called till it
	;gives 0

	(entry :host_net :lisp_drop '(:r0 :r1))
	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(fn-bind 'sys/statics/statics :r0)
	(call :array :get_both '((:r0 statics_sys_mail_links_array)) '(_ :r1 :r2))
	(vp-xor-rr :r3 :r3)
	(loop-start)
		(breakif '(:r1 = :r2))
		(assign '((:r1 0)) '(:r0))
		(vp-add-cr +ptr_size :r1)
		(assign '((:r0 lk_node_remote)) '(:r4))
		(vpif '(:r4 /= 0))
			(vp-cpy-cr -1 :r4)
			(assign '(:r4) '((:r0 lk_node_task_count i)))
			(vp-add-cr 1 :r3)
		(endif)
	(loop-end)
	(call :num :create '(:r3) '(:r1))
	(vp-pop :r0)

	(exit :host_net :lisp_drop '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(net-drop)" +error_msg_wrong_types))

(def-func-end)
