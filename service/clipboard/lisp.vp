(include "lib/asm/func.inc")
(include "class/lisp/class.inc")
(include "./class.inc")

(def-method :host_clipboard :lisp_put)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this cstr))

	(entry :host_clipboard :lisp_put '(:r0 :r1))

	(gotoif-lisp-args-sig 'error :r1 1)

	;kernel callback for host call
	(vp-alloc slot_size)
	(list-bind-args :r1 '(:r1) '(:str))
	(save-fields :rsp '(slot_this slot_cstr) '(:r0 :r1))
	(call :sys_task :callback '(:rsp ($ put_callback)))
	(assign '((:rsp slot_this)) '(:r0))
	(assign '((:r0 +lisp_sym_t)) '(:r1))
	(class/obj/ref :r1 :r2)
	(vp-free slot_size)

	(exit :host_clipboard :lisp_put '(:r0 :r1))
	(vp-ret)

(vp-label 'put_callback)
	(entry :sys_task :task_callback '(:r0))
	(host-gui-call :host_gui :clip_put '((:r0 slot_cstr)))
	(exit :sys_task :task_callback '())
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(clip-put str)" +error_msg_wrong_types))
	(signature '(:str))

(def-func-end)

(def-method :host_clipboard :lisp_get)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this text))

	(entry :host_clipboard :lisp_get '(:r0 :r1))

	(gotoif-lisp-args-len 'error :r1 /= 0)

	;kernel callback for host call
	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(call :sys_task :callback '(:rsp ($ get_callback)))
	(load-fields :rsp '(slot_this slot_text) '(:r0 :r1))
	(vp-free slot_size)

	(exit :host_clipboard :lisp_get '(:r0 :r1))
	(vp-ret)

(vp-label 'get_callback)
	(entry :sys_task :task_callback '(:r0))

	(vp-push :r0)
	(host-gui-call :host_gui :clip_get :nil '(tmp))
	(vp-pop :r13)
	(vp-cpy-rr tmp :r12)
	(vpif `(,tmp = 0))
		(assign '((:r13 slot_this)) '(:r0))
		(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r1))
	(else)
		(call :str :create_from_cstr `(,tmp) '(:r1))
	(endif)
	(assign '(:r1) '((:r13 slot_text)))
	(host-gui-call :host_gui :clip_free '(:r12))
	(exit :sys_task :task_callback '())
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(clip-get)" +error_msg_wrong_types))

(def-func-end)
