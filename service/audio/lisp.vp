(def-method :host_audio :lisp_mic_read)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;what the microphone has heard written into the string, 16 bit mono,
	;as many samples as it holds at most, how many it wrote returned

	(structure slot 0
		(ptr this)
		(pubyte c_data)
		(long c_max c_ret))

	(entry :host_audio :lisp_mic_read '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(vp-alloc slot_size)
	(assign '(:r0) '((:rsp slot_this)))
	(list-bind-args :r1 '(:r0) '(:obj))
	(assign '((:r0 +str_length) (& :r0 +str_data)) '(:r1 :r0))
	(vp-shr-cr 1 :r1)
	(assign '(:r0 :r1) '((:rsp slot_c_data) (:rsp slot_c_max)))
	(call :sys_task :callback '(:rsp ($ callback)))
	(call :num :create '((:rsp slot_c_ret)) '(:r1))

	(exit :host_audio :lisp_mic_read '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = user data (ptr)

	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(host-audio-call :host_audio :mic_read '((:r0 slot_c_data) (:r0 slot_c_max)) '(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_c_ret)))
	(vp-ret)

(vp-label 'error)
(jump :lisp :repl_error '(:r1 "(audio-mic-read buf)" +error_msg_wrong_types))
(signature '(:str))

(def-func-end)

