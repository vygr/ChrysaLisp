(include "lib/asm/func.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")
(include "./class.inc")

(defun host-audio-call (%0 %1 &optional %2 %3 %4 %5)
	;%0 = class name
	;%1 = member name
	;%2 = in parameters
	;%3 = out parameters
	;%4 = dispatch reg
	;%5 = temp reg
	(setd %4 :r14 %5 :r13)
	(fn-bind 'sys/statics/statics %4)
	(vp-load-rcr %4 statics_sys_load_host_audio_funcs %4)
	(abi-call-table %0 %1 %4 %2 %3 %5))

(def-method :host_audio :lisp_init)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this)
		(long c_ret))

	(entry :host_audio :lisp_init '(:r0 :r1))

	;check 0 args
	(errorif-lisp-args-len 'error :r1 /= 0)

	;allocate stack for locals
	(vp-alloc slot_size)
	;save lisp `this`
	(assign '(:r0) '((:rsp slot_this)))

	;callback in kernel thread/stack
	(call :sys_task :callback '(:rsp ($ callback)))
	;convert C return value to number
	(call :num :create '((:rsp slot_c_ret)) '(:r1))

	;return lisp `this` and return value
	(exit :host_audio :lisp_init '((:rsp slot_this) :r1))
	;free local stack
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = user data (ptr)

	;kernel callback
	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	;a host with no audio driver has no table to call, the TUI host,
	;and a GUI host built for the frame buffer
	(fn-bind 'sys/statics/statics :r14)
	(vp-load-rcr :r14 statics_sys_load_host_audio_funcs :r14)
	(vpif '(:r14 /= 0))
		(host-audio-call :host_audio :init '() '(:r0))
	(else)
		(vp-cpy-cr -1 :r0)
	(endif)
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_c_ret)))
	(vp-ret)

(vp-label 'error)
(jump :lisp :repl_error '(:r1 "(audio-init)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_audio :lisp_deinit)
	;inputs
	;:r0 = lisp object (ptr)
