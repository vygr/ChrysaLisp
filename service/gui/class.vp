(include "lib/asm/func.inc")
(include "gui/view/class.inc")
(include "gui/texture/class.inc")
(include "gui/region/class.inc")
(include "gui/ctx/class.inc")

(def-method :host_gui :update 16)
	;inputs
	;:r0 = mouse x
	;:r1 = mouse y
	;:r2 = update flags
	;trashes
	;:r0-:r14, :f0-:f15
	;info
	;the whole frame is one callback, on the host's stack, so no task can
	;change a view while it is worked out: made or sized on the host, the
	;views to draw found, those that must draw again drawing into their
	;lists, Lisp or VP, the others' kept lists used, then the frame put on
	;the back buffer and the screen

	(def-vars
		(ptr statics old_stack)
		(struct rect host_gui_rect_size))

	(entry :host_gui :update '(:r0 :r1 :r2))

	;kernel callback for update
	(fn-bind 'sys/statics/statics :r3)
	(assign '(:r0 :r1 :r2) '((:r3 statics_gui_mouse_x) (:r3 statics_gui_mouse_y) (:r3 statics_gui_flags)))
	(jump :sys_task :callback '(0 ($ update_callback)))

(vp-label 'update_callback)
	(vp-cpy-rr :rsp :r0)
	(push-scope)
	(vp-and-cr -16 :rsp)
	(entry (vpx old_stack))

	;inited gui compositor ?
	(assign (vpx (@ sys/statics/statics)) (vpx statics))
	(vpifnot (vpx (.> statics statics_gui_screen)))
		(assign (vpx old_stack) '(:rsp))
		(return)
	(endif)

	(vpifnot (vpx (.> statics statics_gui_init)))
		;init
		(assign (vpx 0 0 (.> statics statics_gui_screen +view_w) (.> statics statics_gui_screen +view_h))
			(vpx (. rect host_gui_rect_x) (. rect host_gui_rect_y) (. rect host_gui_rect_w) (. rect host_gui_rect_h)))
		(host-gui-call :host_gui :init (vpx (& rect) 1))
		(assign (vpx 1 (. rect host_gui_rect_w) (. rect host_gui_rect_h))
			(vpx (.> statics statics_gui_init) (.> statics statics_gui_screen +view_w) (.> statics statics_gui_screen +view_h)))
	(endif)

	;resize back buffer etc ?
	(vpif (vpx (.> statics statics_gui_flags)))
		;resize back buffer and redraw in full
		(host-gui-call :host_gui :resize (vpx (.> statics statics_gui_screen +view_w) (.> statics statics_gui_screen +view_h)))
	(endif)

	;update screen
	(vpif (vpx (.> statics statics_gui_dirty_flag)))
		;the views to draw, each with its list, in the frame
		(call :array :create :nil (vpx (.> statics statics_gui_draws)))
		(call :host_gui :composite (vpx (.> statics statics_gui_screen))
			(vpx (. rect host_gui_rect_x) (. rect host_gui_rect_y) (. rect host_gui_rect_w) (. rect host_gui_rect_h)))

		;put it on the back buffer and the screen, let go of the views of the
		;frame, clear temps and dirty flag
		(call :host_gui :replay (vpx (& rect)))
		(call :host_gui :frame_free)
		(call :list :clear (vpx (.> statics statics_gui_temps)))
		(assign (vpx 0) (vpx (.> statics statics_gui_dirty_flag)))
	(endif)

	(assign (vpx old_stack) '(:rsp))
	(pop-scope-syms)
	(return)

(def-func-end)

(def-method :host_gui :replay)
	;inputs
	;:r0 = the frame's dirty bounds (ptr)
	;trashes
	;:r0-:r4, :r7-:r14, :f0-:f15
	;info
	;on the host's stack: each view of the frame, for each rect of its
	;dirty region, clipped to it, its list of draws played where it is

	(structure replay 0
		(ptr user old_stack)
		(ptr frame frame_end rect draws draws_end iter srect)
		(long ctx_x ctx_y handle)
		(struct clip host_gui_rect_size)
		(struct drect host_gui_rect_size))

	(vp-rdef (r g b a) (method-input :host_gui :set_color))

	(defun replay-rect (%0)
		;the rect at %0 from :r0, moved to where the view is, at drect
		(assign `((:r0 ,(+ %0 host_gui_rect_x) i) (:r0 ,(+ %0 host_gui_rect_y) i)
				(:r0 ,(+ %0 host_gui_rect_w) i) (:r0 ,(+ %0 host_gui_rect_h) i)
				(:rsp replay_ctx_x) (:rsp replay_ctx_y))
			'(:r7 :r8 :r9 :r10 :r11 :r12))
		(vp-simd vp-add-rr '(:r11 :r12) '(:r7 :r8))
		(assign '(:r7 :r8 :r9 :r10)
			'((:rsp (+ replay_drect host_gui_rect_x) i) (:rsp (+ replay_drect host_gui_rect_y) i)
			(:rsp (+ replay_drect host_gui_rect_w) i) (:rsp (+ replay_drect host_gui_rect_h) i))))

	(vp-cpy-rr :rsp :r1)
	(vp-alloc replay_size)
	(vp-and-cr -16 :rsp)
	(assign '(:r0 :r1) '((:rsp replay_user) (:rsp replay_old_stack)))

	;render to the backbuffer, each view of the frame: for each rect of its
	;dirty region, clipped to it, its list of draws where it is
	(host-gui-call :host_gui :begin_composite)
	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_gui_draws)) '(:r0))
	(class/array/get_both :r0 :r1 :r2)
	(assign '(:r1 :r2) '((:rsp replay_frame) (:rsp replay_frame_end)))
	(loop-start)
		;the view and its dirty region
		(assign '((:rsp replay_frame) (:rsp replay_frame_end)) '(:r0 :r1))
		(breakif '(:r0 >= :r1))
		(assign `((:r0 0) (:r0 ,+long_size)) '(:r1 :r2))
		(vp-add-cr (* 2 +long_size) :r0)
		(assign '(:r0 :r2) '((:rsp replay_frame) (:rsp replay_rect)))
		(assign '((:r1 +view_ctx_x) (:r1 +view_ctx_y) (:r1 +view_draws)) '(:r2 :r3 :r1))
		(assign '(:r2 :r3) '((:rsp replay_ctx_x) (:rsp replay_ctx_y)))
		(continueif '(:r1 = 0))
		(class/array/get_both :r1 :r2 :r3)
		(assign '(:r2 :r3) '((:rsp replay_draws) (:rsp replay_draws_end)))
		(loop-start)
			;clip to the next rect
			(assign '((:rsp replay_rect)) '(:r0))
			(breakif '(:r0 = 0))
			(assign '((:r0 0) (:r0 rect_x) (:r0 rect_y) (:r0 rect_x1) (:r0 rect_y1)) '(:r1 :r7 :r8 :r9 :r10))
			(assign '(:r1) '((:rsp replay_rect)))
			(vp-simd vp-sub-rr '(:r7 :r8) '(:r9 :r10))
			(assign '(:r7 :r8 :r9 :r10)
				'((:rsp (+ replay_clip host_gui_rect_x) i) (:rsp (+ replay_clip host_gui_rect_y) i)
				(:rsp (+ replay_clip host_gui_rect_w) i) (:rsp (+ replay_clip host_gui_rect_h) i)))
			(host-gui-call :host_gui :set_clip '((& :rsp replay_clip)))
			;each draw of the list
			(assign '((:rsp replay_draws)) '(:r0))
			(loop-start)
				(assign '((:rsp replay_draws_end)) '(:r1))
				(breakif '(:r0 >= :r1))
				(assign '((:r0 0)) '(:r2))
				(vpif '(:r2 = +ctx_op_color))
					(assign `((:r0 ,+long_size)) '(:r1))
					(vp-add-cr (* 2 +long_size) :r0)
					(assign '(:r0) '((:rsp replay_iter)))
					(assign '(:r1 :r1 :r1 :r1) `(,a ,r ,g ,b))
					(vp-simd vp-shr-cr '(24 16 8) `(,a ,r ,g))
					(vp-simd vp-and-cr '(0xff) `(,a ,r ,g ,b))
					(host-gui-call :host_gui :set_color `(,r ,g ,b ,a))
				(else)
					;box, filled box or blit, its rect where the view is
					(replay-rect +long_size)
					(vpif '(:r2 = +ctx_op_blit))
						(assign `((:r0 ,(* 3 +long_size)) (:r0 ,(* 4 +long_size))) '(:r1 :r2))
						(vp-lea-i :r0 (* 5 +long_size) :r3)
						(vp-add-cr (* 7 +long_size) :r0)
						(assign '((:r1 +texture_handle)) '(:r1))
						(assign '(:r0 :r3 :r1) '((:rsp replay_iter) (:rsp replay_srect) (:rsp replay_handle)))
						(vp-simd vp-cpy-rr '(:r2) '(:r3 :r4))
						(vp-simd vp-shr-cr '(16 8) '(:r3 :r2))
						(vp-simd vp-and-cr '(0xff) '(:r3 :r2 :r4))
						(host-gui-call :host_gui :set_texture_color '((:rsp replay_handle) :r3 :r2 :r4))
						(host-gui-call :host_gui :blit '((:rsp replay_handle) (:rsp replay_srect) (& :rsp replay_drect)))
					(else)
						(vp-add-cr (* 3 +long_size) :r0)
						(assign '(:r0) '((:rsp replay_iter)))
						(vpif '(:r2 = +ctx_op_box))
							(host-gui-call :host_gui :box '((& :rsp replay_drect)))
						(else)
							(host-gui-call :host_gui :filled_box '((& :rsp replay_drect)))
						(endif)
					(endif)
				(endif)
				(assign '((:rsp replay_iter)) '(:r0))
			(loop-end)
		(loop-end)
	(loop-end)
	(host-gui-call :host_gui :end_composite)

	;flush backbuffer
	(host-gui-call :host_gui :flush '((:rsp replay_user)))

	(assign '((:rsp replay_old_stack)) '(:rsp))
	(vp-ret)

(def-func-end)

(def-method :host_gui :frame_free)
	;trashes
	;:r0-:r5, :f0-:f15
	;info
	;the dirty regions of the frame freed, its views let go of, and its
	;list, here, not on the host, as a view let go of may be the last of it

	(def-vars
		(ptr iter iter_end))

	(push-scope)
	(fn-bind 'sys/statics/statics :r0)
	(assign '((:r0 statics_gui_draws)) '(:r0))
	(class/array/get_both :r0 :r1 :r2)
	(assign '(:r1 :r2) (vpx iter iter_end))
	(loop-start)
		(assign (vpx iter iter_end) '(:r0 :r1))
		(breakif '(:r0 >= :r1))
		(fn-bind 'sys/statics/statics :r1)
		(vp-add-cr statics_gui_rect_heap :r1)
		(vp-lea-i :r0 +long_size :r2)
		(call :region :free '(:r1 :r2))
		(assign (vpx iter) '(:r0))
		(vp-lea-i :r0 (* 2 +long_size) :r1)
		(assign '(:r1) (vpx iter))
		(call :view :deref '((:r0 0)))
	(loop-end)
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_gui_draws)) '(:r0))
	(vp-xor-rr :r2 :r2)
	(assign '(:r2) '((:r1 statics_gui_draws)))
	(call :array :deref '(:r0))
	(pop-scope)
	(return)

(def-func-end)

(def-method :host_gui :composite)
	;inputs
	;:r0 = root view object (ptr)
	;outputs
	;:r7 = x (pixels)
	;:r8 = y (pixels)
	;:r9 = width (pixels)
	;:r10 = height (pixels)
	;trashes
	;:r0-:r14, :f0-:f15
	;info
	;the dirty region bounds is returned for use by the :flush call !

	(vp-rdef (root heap region x y x1 y1 tmp)
		'(:r0 :r0 :r1 :r7 :r8 :r9 :r10 :r1))

	(structure local 0
		(ptr root ctx_flist ctx_next)
		(ptr damaged_region)
		(uint index)
		(int x y w h))

	;save inputs
	(vp-alloc local_size)
	(entry :host_gui :composite `(,root))
	(assign `(,root) '((:rsp local_root)))

	;iterate through views back to front
	;setting abs cords, plus
	;create visible region at root
	(vp-xor-rr x x)
	(vp-xor-rr y y)
	(call :view :backward_tree `(,root ,root ($ visible_down_callback) ($ visible_up_callback)))

	;save bounds for :flush
	(call :region :bounds `((& ,root +view_dirty_region)) `(,x ,y ,x1 ,y1))
	(vp-simd vp-sub-rr `(,x ,y) `(,x1 ,y1))
	(vp-simd vp-cpy-ri-i
		`(,x ,y ,x1 ,y1)
		`(:rsp)
		`(,local_x ,local_y ,local_w ,local_h))

	;iterate through views front to back
	;distribute visible region
	(vp-xor-rr tmp tmp)
	(assign `(,tmp) '((:rsp local_ctx_flist)))
	(call :view :forward_tree `(,root :rsp ($ distribute_down_callback) ($ distribute_up_callback)))

	;each view on the draw list draws, its kept list of draws, else its :draw
	;run into a new one, if it has not drawn or is a new size. Each goes in
	;the frame, given its dirty region, freed once the frame is on the host
	(loop-flist :rsp local_ctx_flist root root)
		(assign `(,root) '((:rsp local_ctx_next)))
		(vp-sub-cr +view_ctx_node root)
		(assign `((,root +view_flags) (,root +view_w) (,root +view_h) (,root +view_draws_w) (,root +view_draws_h))
			'(:r1 :r2 :r3 :r4 :r5))
		(vp-xor-rr :r4 :r2)
		(vp-xor-rr :r5 :r3)
		(vp-or-rr :r3 :r2)
		(vp-and-cr +view_flag_drawn :r1)
		(vpif '(:r1 = 0))
			(vp-cpy-cr 1 :r2)
		(endif)
		(vpif '(:r2 /= 0))
			(vp-push root)
			(call :view :forget_draws `(,root))
			(assign '((:rsp 0)) '(:r0))
			(assign '((:r0 +view_w) (:r0 +view_h)) '(:r1 :r2))
			(assign '(:r1 :r2) '((:r0 +view_draws_w) (:r0 +view_draws_h)))
			(assign '((:r0 +view_flags)) '(:r1))
			(vp-or-cr +view_flag_drawn :r1)
			(assign '(:r1) '((:r0 +view_flags)))
			(call :view :draw '(:r0))
			(vp-pop root)
		(endif)
		(class/obj/ref root :r1)
		(assign `((,root +view_dirty_region)) '(:r2))
		(vp-xor-rr :r3 :r3)
		(assign '(:r3) `((,root +view_dirty_region)))
		(vp-cpy-rr root :r1)
		(fn-bind 'sys/statics/statics :r0)
		(assign '((:r0 statics_gui_draws)) '(:r0))
		(call :array :push_back2 '(:r0 :r1 :r2))
		(assign '((:rsp local_ctx_next)) `(,root))
	(loop-end)

	(vp-simd vp-cpy-ir-i
		`(:rsp)
		`(,local_x ,local_y ,local_w ,local_h)
		`(,x ,y ,x1 ,y1))

	(exit :host_gui :composite `(,x ,y ,x1 ,y1))
	(vp-free local_size)
	(vp-ret)

(vp-label 'visible_down_callback)
	(vp-rdef (heap view1 view2 tmp x y x1 y1 vx vy vx1 vy1)
		'(:r0 :r1 :r2 :r3 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(structure vis 0
		(ptr this root next region))

	;save inputs
	(vp-alloc vis_size)
	(entry :view :forward_tree_callback `(,view1 ,view2))
	(assign `(,view1 ,view2) '((:rsp vis_this) (:rsp vis_root)))

	;abs of this view !
	(vp-simd vp-cpy-ir-i `(,view1) `(,+view_x ,+view_y) `(,x1 ,y1))
	(vp-simd vp-add-rr `(,x1 ,y1) `(,x ,y))
	(vp-simd vp-cpy-ri-i `(,x ,y) `(,view1) `(,+view_ctx_x ,+view_ctx_y))

	;if not root
	(vpif `(,view1 /= ,view2))
		;to run its :draw again if the view it is in is to
		(assign `((,view1 +hmap_parent)) `(,tmp))
		(assign `((,tmp +view_flags)) `(,tmp))
		(vp-and-cr +view_flag_redraw tmp)
		(vpif `(,tmp /= 0))
			(assign `((,view1 +view_flags)) `(,heap))
			(vp-or-cr +view_flag_redraw heap)
			(assign `(,heap) `((,view1 +view_flags)))
		(endif)

		;region heap
		(fn-bind 'sys/statics/statics heap)
		(vp-add-cr statics_gui_rect_heap heap)

		;remove my opaque region from ancestors
		(vp-xor-rr tmp tmp)
		(assign `(,tmp (,view1 +view_flags)) `((:rsp vis_region) ,tmp))
		(vp-and-cr +view_flag_opaque tmp)
		(vpif `(,tmp /= 0))
			;entire view is opaque
			(vp-simd vp-cpy-cr '(0) `(,x ,y))
			(vp-simd vp-cpy-ir-i `(,view1) `(,+view_w ,+view_h) `(,x1 ,y1))
			(loop-start)
				(assign `((,view1 +hmap_parent)) `(,view2))
				(assign `(,view2) '((:rsp vis_next)))

				;translate region
				(vp-simd vp-cpy-ir-i `(,view1) `(,+view_x ,+view_y) `(,vx ,vy))
				(vp-simd vp-cpy-ir-i `(,view2) `(,+view_w ,+view_h) `(,vx1 ,vy1))
				(vp-simd vp-add-rr `(,vx ,vy ,vx ,vy) `(,x ,y ,x1 ,y1))

				;clip to parent, exit if clipped away
				(breakif `(,x >= ,vx1) `(,y >= ,vy1) `(,x1 <= 0) `(,y1 <= 0))
				(vp-simd vp-max-cr '(0) `(,x ,y))
				(vp-simd vp-min-rr `(,vx1 ,vy1) `(,x1 ,y1))

				;remove opaque region
				(call :region :remove_rect `(,heap (& ,view2 +view_dirty_region)
					,x ,y ,x1 ,y1) `(,heap))

				(assign '((:rsp vis_next) (:rsp vis_root)) `(,view1 ,view2))
			(loop-until `(,view1 = ,view2))
		(else)
			;use views opaque region
			(assign `((,view1 +hmap_parent)) `(,view2))
			(vp-simd vp-cpy-ir-i `(,view1) `(,+view_x ,+view_y) `(,x ,y))
			(vp-simd vp-cpy-ir-i `(,view2) `(,+view_w ,+view_h) `(,x1 ,y1))
			(vp-simd vp-mul-cr '(-1) `(,x ,y))
			(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
			(call :region :copy_rect `(,heap (& ,view1 +view_opaque_region)
				(& :rsp vis_region) ,x ,y ,x1 ,y1) `(,heap))

			;remove from ancestors
			(assign '((:rsp vis_this)) `(,view1))
			(loop-start)
				(assign `((,view1 +hmap_parent)) `(,view2))
				(assign `(,view2) '((:rsp vis_next)))

				;exit if clipped away
				(assign '((:rsp vis_region)) `(,tmp))
				(breakif `(,tmp = 0))

				;translate temp opaque region
				(vp-simd vp-cpy-ir-i `(,view1) `(,+view_x ,+view_y) `(,x ,y))
				(call :region :translate `((& :rsp vis_region) ,x ,y))

				;clip temp opaque region
				(assign '((:rsp vis_next)) `(,view2))
				(call :region :clip_rect `(,heap (& :rsp vis_region)
					0 0 (,view2 +view_w) (,view2 +view_h)) `(,heap))

				;remove temp opaque region
				(assign '((:rsp vis_next)) `(,view2))
				(call :region :remove_region `(,heap (& :rsp vis_region)
					(& ,view2 +view_dirty_region) 0 0) `(,heap))

				(assign '((:rsp vis_next) (:rsp vis_root)) `(,view1 ,view2))
			(loop-until `(,view1 = ,view2))

			;free any temp region
			(call :region :free `(,heap (& :rsp vis_region)) `(,heap _))
		(endif)
	(endif)

	;abs of this view !
	(assign `((:rsp vis_this)) `(,view2))
	(vp-simd vp-cpy-ir-i `(,view2) `(,+view_ctx_x ,+view_ctx_y) `(,x ,y))

	(exit :view :forward_tree_callback `(,view2 ,heap))
	(vp-free vis_size)
	(vp-ret)

(vp-label 'visible_up_callback)
	(vp-rdef (heap view1 view2 tmp x y x1 y1 vx vy vx1 vy1)
		'(:r0 :r1 :r2 :r3 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	;save inputs
	(vp-alloc vis_size)
	(entry :view :forward_tree_callback '((:rsp vis_this) (:rsp vis_root)))

	;to run its :draw again, or one that keeps no list, let go of its list
	(assign '((:rsp vis_this)) `(,view1))
	(assign `((,view1 +view_flags)) `(,tmp))
	(vp-and-cr (+ +view_flag_redraw +view_flag_nocache) tmp)
	(vpif `(,tmp /= 0))
		(assign `((,view1 +view_flags)) `(,tmp))
		(vp-and-cr (lognot +view_flag_redraw) tmp)
		(assign `(,tmp) `((,view1 +view_flags)))
		(call :view :forget_draws `(,view1))
	(endif)

	;region heap
	(fn-bind 'sys/statics/statics heap)
	(vp-add-cr statics_gui_rect_heap heap)

	;if dirty all flag then dirty entire view
	(assign '((:rsp vis_this)) `(,view1))
	(assign `((,view1 +view_flags)) `(,tmp))
	(vp-and-cr +view_flag_dirty_all tmp)
	(vpif `(,tmp /= 0))
		;clear dirty all flag
		(assign `((,view1 +view_flags)) `(,tmp))
		(vp-and-cr (lognot +view_flag_dirty_all) tmp)
		(assign `(,tmp) `((,view1 +view_flags)))

		;add dirty
		(vp-simd vp-cpy-cr '(0) `(,x ,y))
		(vp-simd vp-cpy-ir-i `(,view1) `(,+view_w ,+view_h) `(,x1 ,y1))
		(call :region :paste_rect `(,heap (& ,view1 +view_dirty_region)
			,x ,y ,x1 ,y1) `(,heap))
	(endif)

	;clip local dirty region with parent bounds
	(assign '((:rsp vis_this) (:rsp vis_root)) `(,view1 ,tmp))
	(assign `((,view1 +hmap_parent)) `(,view2))
	(vpif `(,view1 = ,tmp))
		(vp-cpy-rr view1 view2)
	(endif)
	(vp-simd vp-cpy-ir-i `(,view1) `(,+view_x ,+view_y) `(,x ,y))
	(vp-simd vp-cpy-ir-i `(,view2) `(,+view_w ,+view_h) `(,x1 ,y1))
	(vp-simd vp-mul-cr '(-1) `(,x ,y))
	(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
	(call :region :clip_rect `(,heap (& ,view1 +view_dirty_region)
		,x ,y ,x1 ,y1) `(,heap))

	;paste local dirty region onto parent if not root
	(assign '((:rsp vis_this) (:rsp vis_root)) `(,view1 ,view2))
	(vpif `(,view1 /= ,view2))
		(vp-simd vp-cpy-ir-i `(,view1) `(,+view_x ,+view_y) `(,x ,y))
		(assign `((,view1 +hmap_parent)) `(,view2))
		(call :region :paste_region `(,heap (& ,view1 +view_dirty_region)
			(& ,view2 +view_dirty_region) ,x ,y) `(,heap))

		;free local dirty region
		(assign '((:rsp vis_this)) `(,view1))
		(call :region :free `(,heap (& ,view1 +view_dirty_region)) `(,heap _))
	(endif)

	;abs of parent view !
	(assign `((:rsp vis_this)) `(,view2))
	(vp-simd vp-cpy-ir-i `(,view2) `(,+view_ctx_x ,+view_ctx_y) `(,x ,y))
	(vp-simd vp-cpy-ir-i `(,view2) `(,+view_x ,+view_y) `(,x1 ,y1))
	(vp-simd vp-sub-rr `(,x1 ,y1) `(,x ,y))

	(exit :view :forward_tree_callback `(,view2 ,view1))
	(vp-free vis_size)
	(vp-ret)

(vp-label 'distribute_down_callback)
	(vp-rdef (heap view1 view2 tmp x y x1 y1 vx vy vx1 vy1)
		'(:r0 :r1 :r2 :r3 :r7 :r8 :r9 :r10 :r11 :r12 :r13 :r14))

	(structure dist 0
		(ptr this data next region))

	;save inputs
	(vp-alloc dist_size)
	(entry :view :forward_tree_callback `(,view2 ,view1))
	(assign `(,view2 ,view1) '((:rsp dist_this) (:rsp dist_data)))

	;if not root
	(assign `((,view1 local_root)) `(,tmp))
	(vpif `(,view2 /= ,tmp))
		;region heap
		(fn-bind 'sys/statics/statics heap)
		(vp-add-cr statics_gui_rect_heap heap)

		;copy my dirty region from parent
		(assign `((,view2 +hmap_parent)) `(,view1))
		(vp-simd vp-cpy-ir-i `(,view2)
			`(,+view_ctx_x ,+view_ctx_y ,+view_w ,+view_h)
			`(,x ,y ,x1 ,y1))
		(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
		(call :region :copy_rect `(,heap (& ,view1 +view_dirty_region)
			(& ,view2 +view_dirty_region) ,x ,y ,x1 ,y1) `(,heap))

		;did we find any dirty region ?
		(assign '((:rsp dist_this)) `(,view2))
		(assign `((,view2 +view_dirty_region)) `(,view1))
		(vpif `(,view1 /= 0))
			;remove my opaque areas from ancestors
			(vp-xor-rr tmp tmp)
			(assign `(,tmp (,view2 +view_flags)) `((:rsp dist_region) ,tmp))
			(vp-and-cr +view_flag_opaque tmp)
			(vpif `(,tmp /= 0))
				;entire view is opaque
				(loop-start)
					(assign `((,view2 +hmap_parent)) `(,view1))
					(assign `(,view1) '((:rsp dist_next)))

					;clip to parent, exit if clipped away
					(vp-simd vp-cpy-ir-i `(,view1)
						`(,+view_ctx_x ,+view_ctx_y ,+view_w ,+view_h)
						`(,vx ,vy ,vx1 ,vy1))
					(vp-simd vp-add-rr `(,vx ,vy) `(,vx1 ,vy1))
					(breakif `(,x >= ,vx1) `(,y >= ,vy1) `(,x1 <= ,vx) `(,y1 <= ,vy))
					(vp-simd vp-max-rr `(,vx ,vy) `(,x ,y))
					(vp-simd vp-min-rr `(,vx1 ,vy1) `(,x1 ,y1))

					;remove from parent
					(call :region :remove_rect `(,heap (& ,view1 +view_dirty_region)
						,x ,y ,x1 ,y1) `(,heap))

					(assign '((:rsp dist_data) (:rsp dist_next)) `(,view1 ,view2))
					(assign `((,view1 local_root)) `(,view1))
				(loop-until `(,view1 = ,view2))
			(else)
				;use views opaque region
				(assign `((,view2 +hmap_parent)) `(,view1))
				(vp-simd vp-cpy-ir-i `(,view2) `(,+view_x ,+view_y) `(,x ,y))
				(vp-simd vp-cpy-ir-i `(,view1) `(,+view_w ,+view_h) `(,x1 ,y1))
				(vp-simd vp-mul-cr '(-1) `(,x ,y))
				(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
				(call :region :copy_rect `(,heap (& ,view2 +view_opaque_region)
					(& :rsp dist_region) ,x ,y ,x1 ,y1) `(,heap))

				;translate temp opaque region
				(assign '((:rsp dist_this)) `(,view2))
				(vp-simd vp-cpy-ir-i `(,view2) `(,+view_ctx_x ,+view_ctx_y) `(,x ,y))
				(call :region :translate `((& :rsp dist_region) ,x ,y))

				;remove from ancestors
				(assign '((:rsp dist_this)) `(,view1))
				(loop-start)
					(assign `((,view1 +hmap_parent)) `(,view2))
					(assign `(,view2) '((:rsp dist_next)))

					;exit if clipped away
					(assign '((:rsp dist_region)) `(,tmp))
					(breakif `(,tmp = 0))

					;clip temp opaque region
					(vp-simd vp-cpy-ir-i `(,view2) `(,+view_ctx_x ,+view_ctx_y) `(,x ,y))
					(vp-simd vp-cpy-ir-i `(,view2) `(,+view_w ,+view_h) `(,x1 ,y1))
					(vp-simd vp-add-rr `(,x ,y) `(,x1 ,y1))
					(call :region :clip_rect `(,heap (& :rsp dist_region)
						,x ,y ,x1 ,y1) `(,heap))

					;remove temp opaque region
					(assign '((:rsp dist_next)) `(,view2))
					(call :region :remove_region `(,heap (& :rsp dist_region)
						(& ,view2 +view_dirty_region) 0 0) `(,heap))

					(assign '((:rsp dist_data) (:rsp dist_next)) `(,view2 ,view1))
					(assign `((,view2 local_root)) `(,view2))
				(loop-until `(,view1 = ,view2))

				;free any temp region
				(call :region :free `(,heap (& :rsp dist_region)) `(,heap _))
			(endif)

			;return flag for traversing into children
			(assign '((:rsp dist_this)) `(,view1))
			(assign `((,view1 +view_dirty_region)) `(,view1))
		(endif)
	(endif)

	;return value will be 0 or not depending on having any dirty region
	;we will not traverse into child views if no reason
	(exit :view :forward_tree_callback `((:rsp dist_this) ,view1))
	(vp-free dist_size)
	(vp-ret)

(vp-label 'distribute_up_callback)
	;add myself to draw list if any dirty region
	(vp-rdef (view user node tmp) '(:r0 :r1 :r2 :r3))

	(entry :view :forward_tree_callback `(,view ,user))

	(assign `((,view +view_dirty_region)) `(,node))
	(vpif `(,node /= 0))
		(vp-lea-i view +view_ctx_node node)
		(vp-add-cr local_ctx_flist user)
		(ln-add-fnode user 0 node tmp)
	(endif)

	(exit :view :forward_tree_callback `(,view ,user))
	(vp-ret)

(def-func-end)
