(include "lib/asm/func.inc")
(include "gui/view/class.inc")
(include "gui/region/class.inc")
(include "gui/pixmap/class.inc")
(include "class/num/class.inc")
(include "class/lisp/class.inc")

(def-method :host_gui :lisp_init)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r6, :d0-:d15

	(entry :host_gui :lisp_init '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 1)

	(list-bind-args :r1 '(:r1) '(:view))
	(vp-push :r0 :r1)

	;save background view for screen
	(fn-bind 'sys/statics/statics :r0)
	(class/obj/ref :r1 :r2)
	(assign '(:r1) '((:r0 statics_gui_screen)))
	;the region heap is made with the first view of a node, gui/view/class.vp,
	;which was before this. Were there none it is made here
	(assign `((:r0 ,(+ statics_gui_rect_heap +hp_heap_cellsize))) '(:r2))
	(vpif '(:r2 = 0))
		(call :sys_heap :init '((& :r0 statics_gui_rect_heap) rect_size 32))
	(endif)
	;temp objects
	(call :list :create :nil '(:r0))
	(fn-bind 'sys/statics/statics :r1)
	(assign '(:r0) '((:r1 statics_gui_temps)))
	;fill in lisp object tls for kernel :lisp_draw callbacks !!!
	(load-fields :r1 '(statics_sys_task_current_tcb statics_sys_task_kernel_tcb) '(:r2 :r3))
	(assign '((:r2 +tk_node_lisp)) '(:r2))
	(assign '(:r2) '((:r3 +tk_node_lisp)))
	;gui priority
	(call :sys_task :set_priority '(tk_gui_priority))

	(vp-pop :r0 :r1)
	(class/obj/ref :r1 :r2)

	(exit :host_gui :lisp_init '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-init screen)" +error_msg_wrong_types))
	(signature '(:VIEW))

(def-func-end)

(def-method :host_gui :lisp_deinit)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this))

	(entry :host_gui :lisp_deinit '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	;the frame after the check, an error goes with the stack as it came
	(vp-alloc slot_size)

	;kernel callback for deinit ?
	(assign '(:r0) '((:rsp slot_this)))
	(fn-bind 'sys/statics/statics :r1)
	(load-fields :r1 '(statics_gui_init statics_gui_screen) '(:r2 :r3))
	(vp-or-rr :r3 :r2)
	(vpif '(:r2 /= 0))
		(call :sys_task :callback '(:rsp ($ deinit_callback)))
	(endif)

	(assign '((:rsp slot_this)) '(:r0))
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)

	(exit :host_gui :lisp_deinit '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'deinit_callback)
	;free any screen
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_gui_screen)) '(:r0))
	(vpif '(:r0 /= 0))
		(vp-xor-rr :r2 :r2)
		(assign '(:r2) '((:r1 statics_gui_screen)))
		(call :view :deref '(:r0))
	(endif)

	;free any temps list
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_gui_temps)) '(:r0))
	(vpif '(:r0 /= 0))
		(vp-xor-rr :r2 :r2)
		(assign '(:r2) '((:r1 statics_gui_temps)))
		(call :list :deref '(:r0))
	(endif)

	;destroy any gui and clear init flag
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_gui_init)) '(:r0))
	(vpif '(:r0 /= 0))
		(vp-xor-rr :r2 :r2)
		(assign '(:r2) '((:r1 statics_gui_init)))
		(host-gui-call :host_gui :deinit)
	(endif)

	;deinit region heap, and it is one that has not been made, for the
	;next view of this node to make
	(fn-bind 'sys/statics/statics :r0)
	(call :sys_heap :deinit '((& :r0 statics_gui_rect_heap)) '(:r0))
	(vp-xor-rr :r1 :r1)
	(assign '(:r1) '((:r0 +hp_heap_cellsize)))

	;reset remaining gui statics
	(fn-bind 'sys/statics/statics :r1)
	(vp-xor-rr :r0 :r0)
	(assign '(:r0 :r0 :r0 :r0 :r0)
		'((:r1 statics_gui_dirty_flag)
		  (:r1 statics_gui_old_region_index)
		  (:r1 statics_gui_flags)
		  (:r1 statics_gui_mouse_x)
		  (:r1 statics_gui_mouse_y)))

	;clear lisp tls on kernel tcb
	(assign '((:r1 statics_sys_task_kernel_tcb)) '(:r1))
	(vpif '(:r1 /= 0))
		(assign '(:r0) '((:r1 +tk_node_lisp)))
	(endif)

	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-deinit)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_gui :lisp_update)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(entry :host_gui :lisp_update '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 3)

	(list-bind-args :r1 '(:r3 :r1 :r2) '(:num :num :num))
	(vp-push :r0)
	(call :host_gui :update '(:r3 :r1 :r2))
	(vp-pop :r0)
	(assign '((:r0 +lisp_sym_nil)) '(:r1))
	(class/obj/ref :r1 :r2)

	(exit :host_gui :lisp_update '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-update mx my flags)" +error_msg_wrong_types))
	(signature '(:NUM :NUM :NUM))

(def-func-end)

(def-method :host_gui :lisp_event)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15

	(structure slot 0
		(ptr this event))

	(entry :host_gui :lisp_event '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	;the frame after the check, an error goes with the stack as it came
	(vp-alloc slot_size)

	;kernel callback for event
	(assign '(:r0) '((:rsp slot_this)))
	(call :sys_task :callback '(:rsp ($ event_callback)))
	(load-fields :rsp '(slot_this slot_event) '(:r0 :r1))

	(exit :host_gui :lisp_event '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

	(structure local1 0
		(ptr user))

(vp-label 'event_callback)
	(vp-alloc local1_size)
	(assign '(:r0) '((:rsp local1_user)))

	(host-gui-call :host_gui :poll_event '(0) '(:r0))
	(vp-shl-cr 32 :r0)
	(vp-shr-cr 32 :r0)
	(vpif '(:r0 /= 0))
		(call :str :create_from_buffer '(0 256) '(:r0))
		(assign '((:rsp local1_user)) '(:r1))
		(assign '(:r0) '((:r1 slot_event)))
		(host-gui-call :host_gui :poll_event '((& :r0 +str_data)))
	(else)
		(assign '((:rsp local1_user)) '(:r0))
		(assign '((:r0 slot_this)) '(:r1))
		(assign '((:r1 +lisp_sym_nil)) '(:r1))
		(class/obj/ref :r1 :r2)
		(assign '(:r1) '((:r0 slot_event)))
	(endif)
	(vp-free local1_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-event)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_gui :lisp_info)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r4, :r7-:r11, :r14, :d0-:d15

	(entry :host_gui :lisp_info '(:r0 :r1))

	(errorif-lisp-args-len 'error :r1 /= 0)

	(vp-push :r0)
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_sys_load_host_gui_funcs)) '(:r1))
	(vpif '(:r1 /= 0))
		;we are GUI caperble
		(fn-bind 'sys/statics/statics :r1)
		(assign '((:r1 statics_gui_screen)) '(:r1))
		(assign '(0 0 0 0) '(:r7 :r8 :r9 :r10))
		(vpif '(:r1 /= 0))
			;have screen
			(fn-bind 'sys/statics/statics :r0)
			(load-fields :r1 '(+view_w +view_h) '(:r9 :r10))
			(load-fields :r0 '(statics_gui_mouse_x statics_gui_mouse_y) '(:r7 :r8))
		(endif)
		(call :list :create :nil '(:r11))
		(call :num :create '(:r7) '(:r7))
		(call :num :create '(:r8) '(:r8))
		(call :num :create '(:r9) '(:r9))
		(call :num :create '(:r10) '(:r10))
		(call :list :push_back2 '(:r11 :r7 :r8) '(:r0 _ _ _ _))
		(call :list :push_back2 '(:r0 :r9 :r10) '(:r1 _ _ _ _))
	(else)
		(call :obj :ref '((:r0 +lisp_sym_nil)) '(:r1))
	(endif)
	(vp-pop :r0)

	(exit :host_gui :lisp_info '(:r0 :r1))
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-info)" +error_msg_wrong_types))

(def-func-end)

(def-method :host_gui :lisp_read_screen)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(gui-read-screen x y w h) -> :nil | str, a rectangle of what the GUI
	;of this node last drew, its pixels of 32 bits, blue green red alpha,
	;opaque, read from the host's back buffer. :nil with no GUI here, or
	;if the host can not read it. As :canvas :read, it is read on the
	;stack of the host

	(structure rs 0
		(ptr data)
		(long x y w h ok))

	(structure slot 0
		(ptr this args out)
		(align)
		(struct frame rs_size))

	(entry :host_gui :lisp_read_screen '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3) '(:num :num :num :num))
	(save-fields :rsp (list (+ slot_frame rs_x) (+ slot_frame rs_y) (+ slot_frame rs_w) (+ slot_frame rs_h))
		'(:r0 :r1 :r2 :r3))
	(vp-xor-rr :r0 :r0)
	(assign '(:r0) '((:rsp slot_out)))
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_gui_init)) '(:r1))
	(vpif '(:r1 /= 0) '(:r2 > 0) '(:r3 > 0))
		(vp-mul-rr :r3 :r2)
		(vp-shl-cr 2 :r2)
		(call :str :create_from_buffer '(0 :r2) '(:r0))
		(assign '(:r0) '((:rsp slot_out)))
		(vp-add-cr +str_data :r0)
		(vp-xor-rr :r1 :r1)
		(save-fields :rsp (list (+ slot_frame rs_data) (+ slot_frame rs_ok)) '(:r0 :r1))
		(call :sys_task :callback '((& :rsp slot_frame) ($ callback)))
		(assign '((:rsp (+ slot_frame rs_ok))) '(:r0))
		(vpif '(:r0 = 0))
			(call :str :deref '((:rsp slot_out)))
			(vp-xor-rr :r0 :r0)
			(assign '(:r0) '((:rsp slot_out)))
		(endif)
	(endif)
	(load-fields :rsp '(slot_this slot_out) '(:r0 :r1))
	(vpif '(:r1 = 0))
		(assign '((:r0 +lisp_sym_nil)) '(:r1))
		(class/obj/ref :r1 :r2)
	(endif)

	(exit :host_gui :lisp_read_screen '(:r0 :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-read-screen x y w h)" +error_msg_wrong_types))
	(signature '(:NUM :NUM :NUM :NUM))

(vp-label 'callback)
	;inputs
	;:r0 = user data

	(entry '(:r0))
	(vp-push :r0)
	(assign '((:r0 rs_w)) '(:r6))
	(vp-shl-cr 2 :r6)
	(host-gui-call :host_gui :read_screen '((:r0 rs_data) (:r0 rs_x) (:r0 rs_y) (:r0 rs_w) (:r0 rs_h) :r6)
		'(:r0))
	(vp-pop :r1)
	(assign '(:r0) '((:r1 rs_ok)))
	(vp-ret)

(def-func-end)

(def-method :host_gui :lisp_video)
	;inputs
	;:r0 = lisp object (ptr)
	;:r1 = args list object (ptr)
	;outputs
	;:r0 = lisp object (ptr)
	;:r1 = return value object (ptr)
	;trashes
	;:r1-:r14, :d0-:d15
	;info
	;(gui-video op handle data n) -> num, the decoder of films of the host,
	;src/host/video.cpp, called on the stack of the host
	;op 0, open: handle the codec, its 4 letters as a num, data its setup,
	;	gives the decoder, 0 if the host has none for it or no GUI
	;op 1, decode: data a packet, n when it is shown, gives 0, -1 if not
	;op 2, frame: data a pixmap, given the picture shown at n, gives n, -1
	;	if that is not out yet
	;op 3, close: the decoder gone, data any, gives 0

	(structure slot 0
		(ptr this args data)
		(long op handle len n w h stride out))

	(entry :host_gui :lisp_video '(:r0 :r1))

	(errorif-lisp-args-sig 'error :r1 4)

	(vp-alloc slot_size)
	(save-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(list-bind-args :r1 '(:r0 :r1 :r2 :r3) '(:num :num :obj :num))
;a frame is put in a pixmap, the rest are given a str
	(vp-push :r0 :r1 :r2 :r3)
	(vpif '(:r0 = 2))
		(call :obj :inst_of `(:r2 (@ ,(f-path :pixmap :vtable))) '(_ :r4))
	(else)
		(call :obj :inst_of `(:r2 (@ ,(f-path :str :vtable))) '(_ :r4))
	(endif)
	(vp-pop :r0 :r1 :r2 :r3)
	(gotoif '(:r4 = 0) 'error1)
	(save-fields :rsp '(slot_op slot_handle slot_n) '(:r0 :r1 :r3))
	(vpif '(:r0 = 2))
		(assign '((:r2 +pixmap_data) (:r2 +pixmap_width ui) (:r2 +pixmap_height ui) (:r2 +pixmap_stride ui))
			'(:r0 :r1 :r3 :r4))
		(save-fields :rsp '(slot_data slot_w slot_h slot_stride) '(:r0 :r1 :r3 :r4))
	(else)
		(assign '((:r2 +str_length ui) (& :r2 +str_data)) '(:r1 :r0))
		(save-fields :rsp '(slot_data slot_len) '(:r0 :r1))
	(endif)
	(vp-cpy-cr -1 :r0)
	(assign '(:r0) '((:rsp slot_out)))
	(fn-bind 'sys/statics/statics :r1)
	(assign '((:r1 statics_sys_load_host_gui_funcs)) '(:r1))
	(vpif '(:r1 /= 0))
		(call :sys_task :callback '(:rsp ($ callback)))
	(endif)
	(load-fields :rsp '(slot_out slot_op) '(:r0 :r1))
	(vpif '(:r1 = 0))
		;no decoder is 0
		(vpif '(:r0 < 0))
			(vp-xor-rr :r0 :r0)
		(endif)
	(endif)
	(call :num :create '(:r0) '(:r1))

	(exit :host_gui :lisp_video '((:rsp slot_this) :r1))
	(vp-free slot_size)
	(vp-ret)

(vp-label 'callback)
	;inputs
	;:r0 = user data (ptr)

	(entry :sys_task :task_callback '(:r0))
	(vp-push :r0)
	(assign '((:r0 slot_op)) '(:r1))
	(vpif '(:r1 = 0))
		(host-gui-call :host_gui :video_open '((:r0 slot_handle) (:r0 slot_data) (:r0 slot_len)) '(:r0))
	(elseif '(:r1 = 1))
		(host-gui-call :host_gui :video_decode
			'((:r0 slot_handle) (:r0 slot_data) (:r0 slot_len) (:r0 slot_n)) '(:r0))
	(elseif '(:r1 = 2))
		(host-gui-call :host_gui :video_frame
			'((:r0 slot_handle) (:r0 slot_data) (:r0 slot_w) (:r0 slot_h) (:r0 slot_stride) (:r0 slot_n))
			'(:r0))
	(else)
		(host-gui-call :host_gui :video_close '((:r0 slot_handle)))
		(vp-xor-rr :r0 :r0)
	(endif)
	(vp-pop :r1)
	(assign '(:r0) '((:r1 slot_out)))
	(vp-ret)

(vp-label 'error1)
	(load-fields :rsp '(slot_this slot_args) '(:r0 :r1))
	(vp-free slot_size)
(vp-label 'error)
	(jump :lisp :repl_error '(:r1 "(gui-video op handle data n)" +error_msg_wrong_types))
	(signature '(:NUM :NUM :obj :NUM))

(def-func-end)
